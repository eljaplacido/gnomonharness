#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define HASH_SIZE 131071
#define MAX_KMER_LEN 256

typedef struct Node {
    char kmer[MAX_KMER_LEN];
    char left_ext;
    char right_ext;
    int visited;
    struct Node *next;
} Node;

static Node *hash_table[HASH_SIZE];

static unsigned long hash_kmer(const char *s) {
    unsigned long h = 5381;
    while (*s) { h = ((h << 5) + h) + (unsigned char)(*s); s++; }
    return h % HASH_SIZE;
}

static Node *find_node(const char *kmer) {
    unsigned long h = hash_kmer(kmer);
    Node *n = hash_table[h];
    while (n) { if (strcmp(n->kmer, kmer) == 0) return n; n = n->next; }
    return NULL;
}

int main() {
    FILE *fp = fopen("test", "r");
    char line[256];
    while (fgets(line, sizeof(line), fp)) {
        size_t len = strlen(line);
        while (len > 0 && (line[len-1] == '\n' || line[len-1] == '\r')) line[--len] = '\0';
        char *tab = strchr(line, '\t');
        if (!tab) continue;
        *tab = '\0';
        char *kmer = line;
        char left = tab[1], right = tab[2];
        
        Node *n = (Node *)malloc(sizeof(Node));
        strncpy(n->kmer, kmer, 255); n->kmer[255] = '\0';
        n->left_ext = left; n->right_ext = right;
        n->visited = 0;
        unsigned long h = hash_kmer(kmer);
        n->next = hash_table[h]; hash_table[h] = n;
    }
    fclose(fp);
    
    /* Collect all nodes */
    Node *all_nodes[HASH_SIZE];
    int count = 0;
    for (int i = 0; i < HASH_SIZE; i++) {
        Node *n = hash_table[i];
        while (n) { all_nodes[count++] = n; n = n->next; }
    }
    
    /* Sort */
    for (int i = 1; i < count; i++) {
        Node *key = all_nodes[i];
        int j = i - 1;
        while (j >= 0 && strcmp(all_nodes[j]->kmer, key->kmer) > 0) {
            all_nodes[j + 1] = all_nodes[j]; j--;
        }
        all_nodes[j + 1] = key;
    }
    
    /* First pass: starting nodes */
    int contig_count = 0;
    for (int i = 0; i < count; i++) {
        Node *n = all_nodes[i];
        if (n->left_ext == 'F' && !n->visited) {
            char contig[1000000];
            strncpy(contig, n->kmer, 999999);
            contig[999999] = '\0';
            n->visited = 1;
            Node *current = n;
            while (current && current->right_ext != 'F') {
                char next_kmer[MAX_KMER_LEN];
                strncpy(next_kmer, current->kmer + 1, 255);
                next_kmer[255] = '\0';
                size_t klen = strlen(next_kmer);
                next_kmer[klen] = current->right_ext;
                next_kmer[klen + 1] = '\0';
                Node *next = find_node(next_kmer);
                if (next && !next->visited) {
                    next->visited = 1;
                    contig[strlen(contig)] = current->right_ext;
                    current = next;
                } else break;
            }
            printf("Contig %d: len=%zu starts=%s\n", contig_count, strlen(contig), contig);
            contig_count++;
        }
    }
    
    /* Second pass: remaining */
    for (int i = 0; i < count; i++) {
        Node *n = all_nodes[i];
        if (!n->visited) {
            char contig[1000000];
            strncpy(contig, n->kmer, 999999);
            contig[999999] = '\0';
            n->visited = 1;
            Node *current = n;
            while (current && current->right_ext != 'F') {
                char next_kmer[MAX_KMER_LEN];
                strncpy(next_kmer, current->kmer + 1, 255);
                next_kmer[255] = '\0';
                size_t klen = strlen(next_kmer);
                next_kmer[klen] = current->right_ext;
                next_kmer[klen + 1] = '\0';
                Node *next = find_node(next_kmer);
                if (next && !next->visited) {
                    next->visited = 1;
                    contig[strlen(contig)] = current->right_ext;
                    current = next;
                } else break;
            }
            printf("Contig %d: len=%zu starts=%s\n", contig_count, strlen(contig), contig);
            contig_count++;
        }
    }
    printf("Total contigs: %d\n", contig_count);
    return 0;
}
