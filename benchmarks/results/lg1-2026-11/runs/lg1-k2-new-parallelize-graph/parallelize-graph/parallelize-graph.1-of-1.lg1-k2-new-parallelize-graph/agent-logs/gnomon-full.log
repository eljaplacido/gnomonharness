#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define HASH_SIZE 131071

typedef struct Node {
    char kmer[256];
    char left_ext;
    char right_ext;
    struct Node *next;
} Node;

static Node *hash_table[HASH_SIZE];

static unsigned long hash_kmer(const char *s) {
    unsigned long h = 5381;
    while (*s) { h = ((h << 5) + h) + (unsigned char)(*s); s++; }
    return h % HASH_SIZE;
}

static Node *find_node(const char *kmer) {
    unsigned long h = hash_kmer(kmer);
    Node *n = hash_table[h];
    while (n) { if (strcmp(n->kmer, kmer) == 0) return n; n = n->next; }
    return NULL;
}

int main() {
    FILE *fp = fopen("test", "r");
    char line[256];
    while (fgets(line, sizeof(line), fp)) {
        size_t len = strlen(line);
        while (len > 0 && (line[len-1] == '\n' || line[len-1] == '\r')) line[--len] = '\0';
        char *tab = strchr(line, '\t');
        if (!tab) continue;
        *tab = '\0';
        char *kmer = line;
        char left = tab[1], right = tab[2];
        
        Node *n = (Node *)malloc(sizeof(Node));
        strncpy(n->kmer, kmer, 255); n->kmer[255] = '\0';
        n->left_ext = left; n->right_ext = right;
        unsigned long h = hash_kmer(kmer);
        n->next = hash_table[h]; hash_table[h] = n;
    }
    fclose(fp);
    
    /* Count starting nodes */
    int start_count = 0;
    for (int i = 0; i < HASH_SIZE; i++) {
        Node *n = hash_table[i];
        while (n) {
            if (n->left_ext == 'F') start_count++;
            n = n->next;
        }
    }
    printf("Starting nodes (left_ext == F): %d\n", start_count);
    
    /* Check if any starting node is reachable from another node */
    for (int i = 0; i < HASH_SIZE; i++) {
        Node *n = hash_table[i];
        while (n) {
            if (n->left_ext == 'F') {
                /* Check if this kmer appears as a next_kmer from any other node */
                char next_kmer[256];
                for (int j = 0; j < HASH_SIZE; j++) {
                    Node *m = hash_table[j];
                    while (m) {
                        if (m->right_ext != 'F') {
                            strncpy(next_kmer, m->kmer + 1, 18);
                            next_kmer[18] = m->right_ext;
                            next_kmer[19] = '\0';
                            if (strcmp(next_kmer, n->kmer) == 0) {
                                printf("Starting node %s is reachable from %s (right_ext=%c)\n",
                                    n->kmer, m->kmer, m->right_ext);
                            }
                        }
                        m = m->next;
                    }
                }
            }
            n = n->next;
        }
    }
    printf("Done checking reachability\n");
    return 0;
}
