from mailman.core.initialize import initialize
from mailman.interfaces.listmanager import IListManager
from mailman.interfaces.languages import ILanguageManager
from mailman.database.transaction import transaction
from zope.component import getUtility

initialize('/etc/mailman3/mailman.cfg')

with transaction():
    list_manager = getUtility(IListManager)
    mlist = list_manager.get('reading-group@local.edu')
    print(f"Current preferred_language: {mlist._preferred_language}")
    
    lang_manager = getUtility(ILanguageManager)
    print(f"Available languages: {[l.code for l in lang_manager]}")
    
    # Set the list's preferred language to English
    mlist._preferred_language = 'en'
    print(f"Set preferred_language to: {mlist._preferred_language}")
