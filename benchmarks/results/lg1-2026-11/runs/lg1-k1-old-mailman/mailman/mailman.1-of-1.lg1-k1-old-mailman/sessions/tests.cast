[99.03844, "o", "            \u001b[94massert\u001b[39;49;00m user_member \u001b[95mis\u001b[39;49;00m \u001b[94mNone\u001b[39;49;00m, \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m{\u001b[39;49;00muser\u001b[33m}\u001b[39;49;00m\u001b[33m is a member: \u001b[39;49;00m\u001b[33m{\u001b[39;49;00muser_member\u001b[33m=}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92m_assert_member\u001b[39;49;00m():\u001b[90m\u001b[39;49;00m\r\n            mlist = get_mlist()\u001b[90m\u001b[39;49;00m\r\n            user_member = mlist.members.get_member(\u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m{\u001b[39;49;00muser\u001b[33m}\u001b[39;49;00m\u001b[33m@\u001b[39;49;00m\u001b[33m{\u001b[39;49;00mDOMAIN_NAME\u001b[33m}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n            \u001b[94massert\u001b[39;49;00m user_member, \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m{\u001b[39;49;00muser\u001b[33m}\u001b[39;49;00m\u001b[33m is not a member: \u001b[39;49;00m\u001b[33m{\u001b[39;49;00muser_member\u001b[33m=}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92m_assert_announcement\u001b[39;49;00m():\u001b[90m\u001b[39;49;00m\r\n            mbox = mailbox.mbox(mbox_path)\u001b[90m\u001b[39;49;00m\r\n            announce_msgs = [msg \u001b[94mfor\u001b[39;49;00m msg \u001b[95min\u001b[39;49;00m mbox \u001b[94mif\u001b[39;49;00m subject \u001b[95min\u001b[39;49;00m msg.get(\u001b[33m\"\u001b[39;49;00m\u001b[33mSubject\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)]\u001b[90m\u001b[39;49;00m\r\n            \u001b[94massert\u001b[39;49;00m \u001b[96mlen\u001b[39;49;00m(announce_msgs) == \u001b