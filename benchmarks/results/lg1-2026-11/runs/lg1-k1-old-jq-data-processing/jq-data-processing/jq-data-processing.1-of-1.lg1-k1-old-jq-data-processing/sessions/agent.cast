[25.692647, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[25.69266, "o", "\u001b[?2004h> "]
[25.692883, "o", "**Note on examples below**: In the following Data Schema sections, all content following the '\"'\"'#'\"'\"' symbol is just explanatory commentary and will NOT appear in the actual JSON files. These comments are only provided to clarify the structure and requirements.\r\n\u001b[?2004l\r"]
[25.692899, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[25.692911, "o", "> "]
[25.692929, "o", "**Input Data Schema**:\r\n\u001b[?2004l\r\u001b[?2004h"]
[25.692937, "o", "> "]
[25.69303, "o", "The input JSON file '\"'\"'/app/users.json'\"'\"' is an array of user objects with the following structure:\r\n\u001b[?2004l\r\u001b[?2004h"]
[25.693087, "o", "> [\r\n\u001b[?2004l\r\u001b[?2004h>   {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[25.693129, "o", "    \"id\": 1,                  # Unique numeric identifier for the user\r\n\u001b[?2004l\r\u001b[?2004h"]
[25.693152, "o", "> "]
[25.693199, "o", "    \"username\": \"john_doe\",   # User'\"'\"'s unique username (string)\r\n\u001b[?2004l\r\u001b[?2004h"]
[25.693225, "o", "> "]
[25.693271, "o", "    \"email\": \"john@example.com\",  # User'\"'\"'s email address (string)\r\n\u001b[?2004l\r"]
[25.693285, "o", "\u001b[?2004h> "]
[25.693356, "o", "    \"status\": \"active\",       # User status: '\"'\"'active'\"'\"' or '\"'\"'inactive'\"'\"'\r\n\u001b[?2004l\r"]
[25.69337, "o", "\u001b[?2004h> "]
[25.693448, "o", "    \"last_login\": \"2024-10-02T20:59:10.109812Z\",  # ISO 8601 timestamp (UTC) of the last login\r\n\u001b[?2004l\r"]
[25.693464, "o", "\u001b[?2004h> "]
[25.693538, "o", "    \"roles\": [\"admin\", \"editor\"]  # Array of roles assigned to the user (may be empty)\r\n\u001b[?2004l\r"]
[25.693551, "o", "\u001b[?2004h>   },\r\n\u001b[?2004l\r"]
[25.693566, "o", "\u001b[?2004h>   ...\r\n\u001b[?2004l\r"]
[25.693587, "o", "\u001b[?2004h> ]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[25.693617, "o", "\u001b[?2004l\r\u001b[?2004h"]
[25.693633, "o", "> **Output Data Schema**:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[25.693736, "o", "The output JSON file '\"'\"'/app/active_users_report.json'\"'\"' must be an array of objects with the following structure:\r\n\u001b[?2004l\r\u001b[?2004h"]
[25.693745, "o", "> [\r\n\u001b[?2004l\r"]
[25.693753, "o", "\u001b[?2004h"]
[25.693758, "o", ">   {\r\n\u001b[?2004l\r"]
[25.693765, "o", "\u001b[?2004h"]
[25.693771, "o", "> "]
[25.693837, "o", "    \"user_id\": 1,                 # Derived from '\"'\"'id'\"'\"' in input \r\n\u001b[?2004l\r"]
[25.69385, "o", "\u001b[?2004h> "]
[25.693936, "o", "    \"username\": \"john_doe\",       # Retained from input \r\n\u001b[?2004l\r\u001b[?2004h> "]
[25.693981, "o", "    \"email\": \"john@example.com\",  # Retained from input \r\n\u001b[?2004l\r\u001b[?2004h> "]
[25.694055, "o", "    \"last_login\": \"2024-10-02\",   # Formatted from '\"'\"'last_login'\"'\"' in input\r\n\u001b[?2004l\r\u001b[?2004h> "]
[25.694112, "o", "    \"role_count\": 2,              # Count of '\"'\"'roles'\"'\"' from input\r\n\u001b[?2004l\r"]
[25.694119, "o", "\u001b[?2004h> "]
[25.694216, "o", "    \"primary_role\": \"admin\"       # If '\"'\"'roles'\"'\"' is empty, this must be null (JSON null, not \"null\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[25.694223, "o", ">   },\r\n\u001b[?2004l\r"]
[25.694304, "o", "\u001b[?2004h>   ...\r\n\u001b[?2004l\r\u001b[?2004h> ]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[25.694325, "o", "**Requirements**:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[25.69442, "o", "- You must use jq to perform this transformation. Using other programming languages (e.g., Python, Ruby) is strictly prohibited.\r\n\u001b[?2004l\r\u001b[?2004h"]
[25.694433, "o", "> "]
