model = AutoModelForCausalLM.from_pretrained('openai-community/gpt2')
model.train()

# Batch of 1, max_length=64
text = 'Question: What is the function of hemoglobin?\nOptions:\n  A) Test\n  B) Test\n  C) Test\n  D) Test\nAnswer: A'
inputs = tokenizer(text, return_tensors='pt', padding='max_length', max_length=64)

# Warmup
model.zero_grad()
out = model(input_ids=inputs['input_ids'], labels=inputs['input_ids'])
out.loss.backward()

# Time it
start = time.time()
for _ in range(5):
    model.zero_grad()
    out = model(input_ids=inputs['input_ids'], labels=inputs['input_ids'])
    out.loss.backward()
elapsed = time.time() - start
print(f'Batch=1, max_len=64, Threads=1: {elapsed/5:.3f}s per step')
