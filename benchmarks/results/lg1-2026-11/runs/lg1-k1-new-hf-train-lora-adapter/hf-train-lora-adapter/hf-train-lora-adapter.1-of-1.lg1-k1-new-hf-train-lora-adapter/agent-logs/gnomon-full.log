import torch
# Test forward pass timing
from transformers import AutoModelForCausalLM, AutoTokenizer
import time

tokenizer = AutoTokenizer.from_pretrained('openai-community/gpt2')
model = AutoModelForCausalLM.from_pretrained('openai-community/gpt2')
model.eval()

text = 'Question: What is the function of hemoglobin?\nOptions:\n  A) Test\n  B) Test\n  C) Test\n  D) Test\nAnswer: A'
inputs = tokenizer(text, return_tensors='pt', padding='max_length', max_length=128)

# Warmup
with torch.no_grad():
    model(**inputs)

# Time it
start = time.time()
for _ in range(5):
    with torch.no_grad():
        model(**inputs)
elapsed = time.time() - start
print(f'Forward pass (no grad): {elapsed/5:.3f}s')

# Time backward
model.train()
inputs2 = inputs['input_ids'].clone()
start = time.time()
for _ in range(5):
    model.zero_grad()
    out = model(input_ids=inputs2, labels=inputs2)
    out.loss.backward()
elapsed = time.time() - start
print(f'Forward+backward: {elapsed/5:.3f}s')
