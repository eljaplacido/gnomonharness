[25.804099, "o", ">      - \"--tab\"\r\n\u001b[?2004l\r"]
[25.804127, "o", "\u001b[?2004h>    ```\r\n\u001b[?2004l\r\u001b[?2004h>    \r\n\u001b[?2004l\r"]
