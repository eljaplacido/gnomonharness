[25.803952, "o", "   '\"'\"'/app/jq_args.yaml'\"'\"' Example format:\r\n\u001b[?2004l\r\u001b[?2004h>    ```\r\n\u001b[?2004l\r\u001b[?2004h> "]
[25.803986, "o", "   filter: \"group_by(.address.city)\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
