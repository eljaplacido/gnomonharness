[25.805137, "o", "\u001b[?2004h> "]
[25.805182, "o", "   - Each argument should be a separate string in the list\r\n\u001b[?2004l\r\u001b[?2004h> "]
[25.80527, "o", "   - For flag-only arguments, include just the flag (e.g., '\"'\"'--unbuffered'\"'\"', '\"'\"'--tab'\"'\"')\r\n\u001b[?2004l\r"]
[25.8053, "o", "\u001b[?2004h> "]
[25.805384, "o", "   - For arguments with values, include both the flag and value as a single string (e.g., '\"'\"'--argjson min_count 5'\"'\"')\r\n\u001b[?2004l\r"]
