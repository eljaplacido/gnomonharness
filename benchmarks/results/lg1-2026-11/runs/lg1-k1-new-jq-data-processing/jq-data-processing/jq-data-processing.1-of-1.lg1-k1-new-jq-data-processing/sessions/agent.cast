[25.80593, "o", "**Note on examples below**: In the following Data Schema sections, all content following the '\"'\"'#'\"'\"' symbol is just explanatory commentary and will NOT appear in the actual JSON files. These comments are only provided to clarify the structure and requirements.\r\n\u001b[?2004l\r"]
[25.805939, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[25.805947, "o", "\u001b[?2004h> "]
[25.805972, "o", "**Input Data Schema**:\r\n\u001b[?2004l\r"]
[25.805987, "o", "\u001b[?2004h> "]
[25.80607, "o", "The input JSON file '\"'\"'/app/users.json'\"'\"' is an array of user objects with the following structure:\r\n\u001b[?2004l\r"]
[25.806077, "o", "\u001b[?2004h> "]
[25.806085, "o", "[\r\n\u001b[?2004l\r\u001b[?2004h"]
[25.806093, "o", ">   {\r\n"]
[25.8061, "o", "\u001b[?2004l\r\u001b[?2004h"]
[25.80611, "o", "> "]
[25.806204, "o", "    \"id\": 1,                  # Unique numeric identifier for the user\r\n\u001b[?2004l\r\u001b[?2004h> "]
[25.806238, "o", "    \"username\": \"john_doe\",   # User'\"'\"'s unique username (string)\r\n\u001b[?2004l\r\u001b[?2004h"]
[25.806261, "o", "> "]
[25.806308, "o", "    \"email\": \"john@example.com\",  # User'\"'\"'s email address (string)\r\n\u001b[?2004l\r"]
[25.806328, "o", "\u001b[?2004h> "]
[25.806388, "o", "    \"status\": \"active\",       # User status: '\"'\"'active'\"'\"' or '\"'\"'inactive'\"'\"'\r\n\u001b[?2004l\r"]
[25.806411, "o", "\u001b[?2004h> "]
[25.806479, "o", "    \"last_login\": \"2024-10-02T20:59:10.109812Z\",  # ISO 8601 timestamp (UTC) of the last login\r\n\u001b[?2004l\r"]
[25.806502, "o", "\u001b[?2004h> "]
[25.806565, "o", "    \"roles\": [\"admin\", \"editor\"]  # Array of roles assigned to the user (may be empty)\r\n\u001b[?2004l\r\u001b[?2004h"]
[25.806588, "o", ">   },\r\n\u001b[?2004l\r\u001b[?2004h"]
[25.806611, "o", ">   ...\r\n\u001b[?2004l\r\u001b[?2004h> ]\r\n\u001b[?2004l\r\u001b[?2004h"]
[25.806633, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[25.806653, "o", "**Output Data Schema**:\r\n\u001b[?2004l\r\u001b[?2004h"]
[25.806676, "o", "> "]
[25.806764, "o", "The output JSON file '\"'\"'/app/active_users_report.json'\"'\"' must be an array of objects with the following structure:\r\n\u001b[?2004l\r\u001b[?2004h"]
[25.806787, "o", "> [\r\n\u001b[?2004l\r"]
[25.806809, "o", "\u001b[?2004h>   {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[25.806871, "o", "    \"user_id\": 1,                 # Derived from '\"'\"'id'\"'\"' in input \r\n\u001b[?2004l\r"]
[25.806894, "o", "\u001b[?2004h> "]
[25.806937, "o", "    \"username\": \"john_doe\",       # Retained from input \r\n\u001b[?2004l\r\u001b[?2004h"]
[25.806977, "o", "> "]
[25.807009, "o", "    \"email\": \"john@example.com\",  # Retained from input \r\n\u001b[?2004l\r\u001b[?2004h> "]
[25.807088, "o", "    \"last_login\": \"2024-10-02\",   # Formatted from '\"'\"'last_login'\"'\"' in input\r\n\u001b[?2004l\r\u001b[?2004h> "]
[25.80715, "o", "    \"role_count\": 2,              # Count of '\"'\"'roles'\"'\"' from input\r\n\u001b[?2004l\r\u001b[?2004h"]
[25.807174, "o", "> "]
[25.80726, "o", "    \"primary_role\": \"admin\"       # If '\"'\"'roles'\"'\"' is empty, this must be null (JSON null, not \"null\")\r\n\u001b[?2004l\r\u001b[?2004h>   },\r\n\u001b[?2004l\r"]
[25.807311, "o", "\u001b[?2004h>   ...\r\n\u001b[?2004l\r\u001b[?2004h> ]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[25.807354, "o", "\u001b[?2004h> **Requirements**:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[25.807456, "o", "- You must use jq to perform this transformation. Using other programming languages (e.g., Python, Ruby) is strictly prohibited.\r\n\u001b[?2004l\r\u001b[?2004h"]
[25.807498, "o", "> "]
[25.807532, "o", "- Ensure that the output JSON is properly formatted with 2-space indentation.\r\n\u001b[?2004l\r\u001b[?2004h"]
[25.807557, "o", "> "]
[25.807621, "o", "- The output file must be created at the exact path '\"'\"'/app/active_users_report.json'\"'\"'.\r\n\u001b[?2004l\r"]
