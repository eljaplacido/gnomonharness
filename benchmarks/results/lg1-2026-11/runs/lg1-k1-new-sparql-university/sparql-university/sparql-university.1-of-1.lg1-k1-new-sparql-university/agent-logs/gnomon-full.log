        if enroll_date:
            ed = enroll_date.toPython() if isinstance(enroll_date, Literal) else enroll_date
            if ed <= today:
                if grad_date is None:
                    is_currently = True
                else:
                    gd = grad_date.toPython() if isinstance(grad_date, Literal) else grad_date
                    if gd > today:
                        is_currently = True
        
        if is_currently:
            for course in g.objects(s, uni.isEnrolledIn):
