uni = Namespace("http://university.org/ontology/")

# Get all students and their enrollments
print("=== Students and their enrollments ===")
today = date(2025, 8, 16)

for s in g.subjects(uni.a, uni.Person):
    name = g.value(s, uni.hasName)
    role = g.value(s, uni.role)
    if role and "Student" in str(role):
        enrollments = list(g.objects(s, uni.isEnrolledIn))
        enroll_date = g.value(s, uni.hasEnrollmentDate)
        grad_date = g.value(s, uni.hasGraduationDate)
        
        # Check if currently enrolled
        is_currently = False
        if enroll_date:
            ed = enroll_date.toPython() if isinstance(enroll_date, Literal) else enroll_date
            if ed <= today:
                if grad_date is None:
                    is_currently = True
                else:
                    gd = grad_date.toPython() if isinstance(grad_date, Literal) else grad_date
                    if gd > today:
                        is_currently = True
        
        print(f"  {name}: enrolled in {enrollments}, enroll_date={enroll_date}, grad_date={grad_date}, currently_enrolled={is_currently}")

# Now let's count students per course
print("\n=== Currently enrolled students per course ===")
course_students = {}
for s in g.subjects(uni.a, uni.Person):
    name = g.value(s, uni.hasName)
    role = g.value(s, uni.role)
    if role and "Student" in str(role):
        enroll_date = g.value(s, uni.hasEnrollmentDate)
        grad_date = g.value(s, uni.hasGraduationDate)
        
        is_currently = False
        if enroll_date:
            ed = enroll_date.toPython() if isinstance(enroll_date, Literal) else enroll_date
            if ed <= today:
                if grad_date is None:
                    is_currently = True
                else:
                    gd = grad_date.toPython() if isinstance(grad_date, Literal) else grad_date
                    if gd > today:
                        is_currently = True
        
        if is_currently:
            for course in g.objects(s, uni.isEnrolledIn):
                if course not in course_students:
                    course_students[course] = []
                course_students[course].append(name)

for course, students in sorted(course_students.items()):
    print(f"  {course}: {len(students)} students - {students}")
