from rdflib import Graph, Namespace, Literal
from datetime import date

g = Graph()
g.parse("/app/university_graph.ttl", format="turtle")
uni = Namespace("http://university.org/ontology/")

today = date(2025, 8, 16)

# Count unique students per course who are currently enrolled
course_students = {}
for s in g.subjects():
    role = g.value(s, uni.role)
    if role and str(role) == "Student":
        enroll_date = g.value(s, uni.hasEnrollmentDate)
        grad_date = g.value(s, uni.hasGraduationDate)
        
        is_currently = False
        if enroll_date:
            ed = enroll_date.toPython() if isinstance(enroll_date, Literal) else enroll_date
            if ed <= today:
                if grad_date is None:
                    is_currently = True
                else:
                    gd = grad_date.toPython() if isinstance(grad_date, Literal) else grad_date
                    if gd > today:
                        is_currently = True
        
        if is_currently:
            for course in g.objects(s, uni.isEnrolledIn):
                if course not in course_students:
                    course_students[course] = set()
                course_students[course].add(s)

print("=== Currently enrolled students per course (unique) ===")
for course, students in sorted(course_students.items(), key=lambda x: len(x[1]), reverse=True):
    dept = g.value(course, uni.isTaughtIn)
    print(f"  {course} (dept={dept}): {len(students)} students")

# Now let's check which departments have >10 students
print("\n=== Students per department ===")
dept_students = {}
for course, students in course_students.items():
    dept = g.value(course, uni.isTaughtIn)
    if dept not in dept_students:
        dept_students[dept] = set()
    dept_students[dept].update(students)

for dept, students in sorted(dept_students.items(), key=lambda x: len(x[1]), reverse=True):
    uni_obj = g.value(dept, uni.belongsTo)
    country = g.value(uni_obj, uni.locatedInCountry)
    print(f"  {dept} (uni={uni_obj}, country={country}): {len(students)} students")
