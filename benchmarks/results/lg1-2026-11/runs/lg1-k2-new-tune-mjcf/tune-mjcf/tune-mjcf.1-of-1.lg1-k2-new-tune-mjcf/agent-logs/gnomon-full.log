import mujoco
import numpy as np

def simulate(xml_str, seed=42):
    m = mujoco.MjModel.from_xml_string(xml_str)
    d = mujoco.MjData(m)
    nstep = int(2.0 / m.opt.timestep)
    rng = np.random.default_rng(seed)
    d.qpos += rng.normal(0, 0.01, size=d.qpos.shape)
    mujoco.mj_forward(m, d)
    for _ in range(nstep):
        mujoco.mj_step(m, d)
    full_physics = mujoco.mjtState.mjSTATE_FULLPHYSICS
    state = np.zeros(mujoco.mj_stateSize(m, full_physics))
    mujoco.mj_getState(m, d, state, full_physics)
    return state, m

ref_xml = open('model_ref.xml').read()
ref_state, ref_m = simulate(ref_xml)

# Test different solver types
# 0=PGS, 1=CG, 2=Newton
for solver in [0, 1, 2]:
    xml = ref_xml.replace('iterations=\"100\"', 'iterations=\"10\"')
    xml = xml.replace('ls_iterations=\"50\"', 'ls_iterations=\"5\"')
    xml = xml.replace('solver=\"2\"', f'solver=\"{solver}\"')
    state, m = simulate(xml)
    diff = np.linalg.norm(state - ref_state)
    print(f'solver={solver}: state_diff={diff:.8f}')

# Test with different integrators
# 0=Euler, 1=RK4, 2=implicit, 3=implicitfast
for integrator in [0, 1, 2, 3]:
    xml = ref_xml.replace('integrator=\"0\"', f'integrator=\"{integrator}\"')
    state, m = simulate(xml)
    diff = np.linalg.norm(state - ref_state)
    print(f'integrator={integrator}: state_diff={diff:.8f}')
