import mujoco
import numpy as np
import time

ref_xml = open('model_ref.xml').read()

# First, get reference state
def simulate_model(xml_str, seed=42):
    m = mujoco.MjModel.from_xml_string(xml_str)
    d = mujoco.MjData(m)
    nstep = int(2.0 / m.opt.timestep)
    rng = np.random.default_rng(seed)
    d.qpos += rng.normal(0, 0.01, size=d.qpos.shape)
    mujoco.mj_forward(m, d)
    for _ in range(nstep):
        mujoco.mj_step(m, d)
    full_physics = mujoco.mjtState.mjSTATE_FULLPHYSICS
    state = np.zeros(mujoco.mj_stateSize(m, full_physics))
    mujoco.mj_getState(m, d, state, full_physics)
    return state, m

ref_state, _ = simulate_model(ref_xml)

# Try disabling various things and check both speed and correctness
flags_to_try = [
    ('disable gravity', 1),
    ('disable equalities', 2),
    ('disable constraints', 4),
    ('disable friction', 8),
    ('disable limits', 16),
    ('disable passive', 32),
    ('disable clampctrl', 64),
    ('disable actuation', 128),
    ('disable eulerdamp', 256),
    ('disable ccd', 512),
]

for name, flag in flags_to_try:
    xml = ref_xml.replace('disableflags=\"0\"', f'disableflags=\"{flag}\"')
    try:
        state, m = simulate_model(xml)
        diff = np.linalg.norm(state - ref_state)
        
        # Time it
        times = []
        for _ in range(10):
            m2 = mujoco.MjModel.from_xml_string(xml)
            d = mujoco.MjData(m2)
            nstep = int(2.0 / m2.opt.timestep)
            rng = np.random.default_rng(42)
            d.qpos += rng.normal(0, 0.01, size=d.qpos.shape)
            mujoco.mj_forward(m2, d)
            t0 = time.perf_counter()
            for _ in range(nstep):
                mujoco.mj_step(m2, d)
            t1 = time.perf_counter()
            times.append(t1 - t0)
        
        print(f'{name}: diff={diff:.6f}, time={np.mean(times):.4f}s')
    except Exception as e:
        print(f'{name}: ERROR - {e}')
