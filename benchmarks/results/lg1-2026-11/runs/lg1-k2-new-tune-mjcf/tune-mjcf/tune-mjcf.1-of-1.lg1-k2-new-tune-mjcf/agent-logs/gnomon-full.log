    ('default', 'iterations=\"100\"', 'ls_iterations=\"50\"'),
    ('iter=10', 'iterations=\"10\"', 'ls_iterations=\"50\"'),
    ('iter=10,ls=5', 'iterations=\"10\"', 'ls_iterations=\"5\"'),
    ('iter=10,ls=5,solver=1', 'iterations=\"10\"', 'ls_iterations=\"5\"', 'solver=\"1\"'),
    ('iter=10,ls=5,solver=0', 'iterations=\"10\"', 'ls_iterations=\"5\"', 'solver=\"0\"'),
]

