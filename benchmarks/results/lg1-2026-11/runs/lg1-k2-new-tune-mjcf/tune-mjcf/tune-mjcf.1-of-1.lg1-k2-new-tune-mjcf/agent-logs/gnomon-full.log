import mujoco
import numpy as np
import time

ref_xml = open('model_ref.xml').read()

def simulate_model(xml_str, seed=42):
    m = mujoco.MjModel.from_xml_string(xml_str)
    d = mujoco.MjData(m)
    nstep = int(2.0 / m.opt.timestep)
    rng = np.random.default_rng(seed)
    d.qpos += rng.normal(0, 0.01, size=d.qpos.shape)
    mujoco.mj_forward(m, d)
    for _ in range(nstep):
        mujoco.mj_step(m, d)
    full_physics = mujoco.mjtState.mjSTATE_FULLPHYSICS
    state = np.zeros(mujoco.mj_stateSize(m, full_physics))
    mujoco.mj_getState(m, d, state, full_physics)
    return state, m

ref_state, _ = simulate_model(ref_xml)

# Let me try using the MJX approach
# Actually, let me try a different approach: what if I can use the
# mj_step1 and mj_step2 functions to skip some computation?

# Let me check the MuJoCo source for the cable plugin
# The cable plugin has a RegisterPlugin function
# Let me see if there's a way to configure it

# Actually, let me try a completely different approach:
# What if I can reduce the number of contact checks by changing the
# contact settings?

# Let me try changing the cone type
for cone in [0, 1, 2, 3]:
    xml = ref_xml.replace('cone=\"0\"', f'cone=\"{cone}\"')
    try:
        state, m = simulate_model(xml)
        diff = np.linalg.norm(state - ref_state)
        
        # Time it
        times = []
        for _ in range(10):
            m2 = mujoco.MjModel.from_xml_string(xml)
            d = mujoco.MjData(m2)
            nstep = int(2.0 / m2.opt.timestep)
            rng = np.random.default_rng(42)
            d.qpos += rng.normal(0, 0.01, size=d.qpos.shape)
            mujoco.mj_forward(m2, d)
            t0 = time.perf_counter()
            for _ in range(nstep):
                mujoco.mj_step(m2, d)
            t1 = time.perf_counter()
            times.append(t1 - t0)
        
        print(f'cone={cone}: diff={diff:.8f}, time={np.mean(times):.4f}s')
    except Exception as e:
        print(f'cone={cone}: ERROR - {e}')
