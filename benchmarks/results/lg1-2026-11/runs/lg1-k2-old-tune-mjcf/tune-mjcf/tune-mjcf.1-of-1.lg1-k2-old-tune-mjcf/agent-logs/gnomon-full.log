import mujoco, numpy as np, time

def run_model(timestep=None, iterations=None, ls_iterations=None, solver=None, tolerance=None, ls_tolerance=None):
    model = mujoco.MjModel.from_xml_path('model_ref.xml')
    if timestep is not None: model.opt.timestep = timestep
    if iterations is not None: model.opt.iterations = iterations
    if ls_iterations is not None: model.opt.ls_iterations = ls_iterations
    if solver is not None: model.opt.solver = solver
    if tolerance is not None: model.opt.tolerance = tolerance
    if ls_tolerance is not None: model.opt.ls_tolerance = ls_tolerance
    
    data = mujoco.MjData(model)
    seed = 42
    rng = np.random.default_rng(seed)
    data.qpos += rng.normal(0, 0.01, size=data.qpos.shape)
    mujoco.mj_forward(model, data)
    
    nstep = int(2.0 / model.opt.timestep)
    t0 = time.perf_counter()
    for _ in range(nstep):
        mujoco.mj_step(model, data)
    t1 = time.perf_counter()
    
    full_physics = mujoco.mjtState.mjSTATE_FULLPHYSICS
    state = np.zeros(mujoco.mj_stateSize(model, full_physics))
    mujoco.mj_getState(model, data, state, full_physics)
    return state, t1-t0

# Baseline
state0, t0 = run_model()
print(f'Baseline: {t0:.4f}s')

# Try reducing iterations
state1, t1 = run_model(iterations=50, ls_iterations=25)
print(f'iter=50,ls=25: {t1:.4f}s, diff={np.linalg.norm(state1-state0):.6f}')

state2, t2 = run_model(iterations=20, ls_iterations=10)
print(f'iter=20,ls=10: {t2:.4f}s, diff={np.linalg.norm(state2-state0):.6f}')

state3, t3 = run_model(iterations=10, ls_iterations=5)
print(f'iter=10,ls=5: {t3:.4f}s, diff={np.linalg.norm(state3-state0):.6f}')

state4, t4 = run_model(iterations=5, ls_iterations=3)
print(f'iter=5,ls=3: {t4:.4f}s, diff={np.linalg.norm(state4-state0):.6f}')
