[40.576988, "o", "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mtest_lora_adapter_saved\u001b[39;49;00m():\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"Test that LoRA adapter was saved correctly.\"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        adapter_path = \u001b[33m\"\u001b[39;49;00m\u001b[33m/app/experiments/lora_adapter\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n>       \u001b[94massert\u001b[39;49;00m os.path.exists(adapter_path), \u001b[33m\"\u001b[39;49;00m\u001b[33mLoRA adapter directory not found\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n\u001b[1m\u001b[31mE       AssertionError: LoRA adapter directory not found\u001b[0m\r\n\u001b[1m\u001b[31mE       assert False\u001b[0m\r\n\u001b[1m\u001b[31mE        +  where False = <function exists at 0xfa99fe5fea20>('/app/experiments/lora_adapter')\u001b[0m\r\n\u001b[1m\u001b[31mE        +    where <function exists at 0xfa99fe5fea20> = <module 'posixpath' (frozen)>.exists\u001b[0m\r\n\u001b[1m\u001b[31mE        +      where <module 'posixpath' (frozen)> = os.path\u001b[0m\r\n\r\n\u001b[1m\u001b[31m/tests/test_outputs.py\u001b[0m:26: AssertionError\r\n"]
