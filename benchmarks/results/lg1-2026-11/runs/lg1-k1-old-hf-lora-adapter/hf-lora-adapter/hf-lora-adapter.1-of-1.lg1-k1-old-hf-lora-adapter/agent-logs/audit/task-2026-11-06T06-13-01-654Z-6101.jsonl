{"seq":26,"ts":"2026-11-06T06:15:31.094Z","kind":"approval","prev":"95bfdba6bd0b14a07a2116e09a7334aaf70976ea1fcad5c8c10a90992612708c","tool":"bash","summary":"bash: python3 -c \"\nimport json, torch\nfrom transformers import AutoTokenizer, AutoModelForSequenceClassification\n\n# Verify merged model loads correctly\nmodel = AutoModelForSequenceClassification.from_pretrained('/app/merged_model')\ntokenizer = AutoTokenizer.from_pretrained('/app/merged_model')\nprint(f'num_labels: {model.config.num_labels}')\nprint(f'arch: {model.config.architectures}')\n\n# Re-run detection to confirm\nsamples = [\n    'Bonjour, comment allez-vous aujourd\\'hui?',\n    'Hola, ¿cómo estás hoy?',\n    'Guten Tag, wie geht es Ihnen?',\n    'Ciao, come stai oggi?',\n    'Olá, como você está?',\n    'Привет, как дела?',\n    'こんにちは、お元気ですか？',\n    '你好，你好吗？',\n    'مرحبا، كيف حالك؟',\n    'Hello, how are you?',\n]\nmodel.eval()\nwith torch.no_grad():\n    for t in samples:\n        inp = tokenizer(t, return_tensors='pt', truncation=True, max_length=512)\n        out = model(**inp)\n        pred = int(torch.argmax(out.logits[0]).item())\n        conf = float(torch.softmax(out.logits[0], dim=-1)[pred].item())\n        print(f'  [{pred}] {conf:.4f}  {t}')\nprint('Verification complete.')\n\" 2>&1","decision":"approved","by":"flag:--yes","interactive":false,"hash":"fc5308e5ba2aa330ec837f46bf61f3316bf7b29a1f071bf5cc2f27da9a34cd8b"}
