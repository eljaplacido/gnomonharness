import json, torch
from transformers import AutoTokenizer, AutoModelForSequenceClassification

# Verify merged model loads correctly
model = AutoModelForSequenceClassification.from_pretrained('/app/merged_model')
tokenizer = AutoTokenizer.from_pretrained('/app/merged_model')
print(f'num_labels: {model.config.num_labels}')
print(f'arch: {model.config.architectures}')

# Re-run detection to confirm
samples = [
    'Bonjour, comment allez-vous aujourd\'hui?',
    'Hola, ¿cómo estás hoy?',
    'Guten Tag, wie geht es Ihnen?',
    'Ciao, come stai oggi?',
    'Olá, como você está?',
    'Привет, как дела?',
    'こんにちは、お元気ですか？',
    '你好，你好吗？',
    'مرحبا، كيف حالك؟',
    'Hello, how are you?',
]
model.eval()
with torch.no_grad():
    for t in samples:
        inp = tokenizer(t, return_tensors='pt', truncation=True, max_length=512)
        out = model(**inp)
        pred = int(torch.argmax(out.logits[0]).item())
        conf = float(torch.softmax(out.logits[0], dim=-1)[pred].item())
        print(f'  [{pred}] {conf:.4f}  {t}')
print('Verification complete.')
