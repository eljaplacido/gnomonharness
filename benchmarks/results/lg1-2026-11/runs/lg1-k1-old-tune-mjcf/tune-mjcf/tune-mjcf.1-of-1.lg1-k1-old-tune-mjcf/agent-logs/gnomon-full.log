import mujoco
import numpy as np

def get_state(xml_str, seed):
    m = mujoco.MjModel.from_xml_string(xml_str)
    d = mujoco.MjData(m)
    rng = np.random.default_rng(seed)
    d.qpos += rng.normal(0, 0.01, size=d.qpos.shape)
    mujoco.mj_forward(m, d)
    nstep = int(2.0 / m.opt.timestep)
    for _ in range(nstep):
        mujoco.mj_step(m, d)
    full_physics = mujoco.mjtState.mjSTATE_FULLPHYSICS
    state = np.zeros(mujoco.mj_stateSize(m, full_physics))
    mujoco.mj_getState(m, d, state, full_physics)
    return state

ref_xml = open('model_ref.xml').read()
ref_state = get_state(ref_xml, 42)

# Test with different joint damping values
for damping in [0.015, 0.03, 0.1, 0.5, 1.0, 5.0, 10.0]:
    xml = ref_xml.replace('damping=\".015\"', f'damping=\"{damping}\"')
    try:
        state = get_state(xml, 42)
        diff = np.linalg.norm(state - ref_state)
        within = np.allclose(state, ref_state, atol=1e-5)
        print(f'damping={damping}: diff={diff:.6f}, within_atol={within}')
    except Exception as e:
        print(f'damping={damping}: ERROR: {e}')
