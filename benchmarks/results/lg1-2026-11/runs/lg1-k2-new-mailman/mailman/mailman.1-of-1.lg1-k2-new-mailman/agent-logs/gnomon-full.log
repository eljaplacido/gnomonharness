# Postfix should deliver this to /var/mail/user via local delivery.

# The issue is that the virtual transport is being used instead of local.
# This is because virtual_mailbox_maps is set, which makes Postfix use virtual delivery
# for all local.edu addresses.

# The fix: remove virtual_mailbox_maps and virtual_mailbox_base, and rely on
# local delivery for user mail.

cat > /etc/postfix/main.cf << 'EOF'
smtpd_banner = $myhostname ESMTP $mail_name (Ubuntu)
biff = no
append_dot_mydomain = no
readme_directory = no
compatibility_level = 3.6

smtpd_tls_cert_file=/etc/ssl/certs/ssl-cert-snakeoil.pem
smtpd_tls_key_file=/etc/ssl/private/ssl-cert-snakeoil.key
smtpd_tls_security_level=may

smtp_tls_CApath=/etc/ssl/certs
smtp_tls_security_level=may
smtp_tls_session_cache_database = btree:${data_directory}/smtp_scache

smtpd_relay_restrictions = permit_mynetworks permit_sasl_authenticated defer_unauth_destination
myhostname = localhost.local.edu
alias_maps = hash:/etc/aliases
alias_database = hash:/etc/aliases
mydestination = $myhostname, localhost, localhost.localdomain, local.edu, $mydomain
relayhost =
mynetworks = 127.0.0.0/8 [::ffff:127.0.0.0]/104 [::1]/128
mailbox_size_limit = 0
recipient_delimiter = +
inet_interfaces = all
inet_protocols = all
mydomain = local.edu
myorigin = $mydomain

# Accept all local recipients
local_recipient_maps =

# Mailman3 LMTP transport
transport_maps = hash:/var/lib/mailman3/data/postfix_lmtp
EOF
echo "main.cf written"
postconf -e "maillog_file = /var/log/mailman3/postfix.log"
postfix reload 2>&1
