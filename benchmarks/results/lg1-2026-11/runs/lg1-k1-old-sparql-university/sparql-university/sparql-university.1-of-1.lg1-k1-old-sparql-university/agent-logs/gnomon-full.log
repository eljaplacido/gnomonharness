from rdflib import Graph, Literal
from datetime import date

g = Graph()
g.parse("/app/university_graph.ttl", format="turtle")

# Check active students in Math201 with proper date comparison
query = """
PREFIX uni: <http://university.org/ontology/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema/>

SELECT ?student ?studentName ?gradDate
WHERE {
    ?student a uni:Person ;
             uni:isEnrolledIn uni:Math201 ;
             uni:hasEnrollmentDate ?enrollDate ;
             uni:hasName ?studentName .
    OPTIONAL { ?student uni:hasGraduationDate ?gradDate }
}
"""
results = list(g.query(query))
ref_date = date(2025, 8, 16)
active = 0
for r in results:
    if r.gradDate is None:
        active += 1
        print(f"  {r.studentName} - active (no grad date)")
    else:
        grad = r.gradDate.date() if hasattr(r.gradDate, 'date') else r.gradDate
        if grad >= ref_date:
            active += 1
            print(f"  {r.studentName} - active (grad {grad})")
        else:
            print(f"  {r.studentName} - NOT active (grad {grad})")
print(f"Active students: {active}")
