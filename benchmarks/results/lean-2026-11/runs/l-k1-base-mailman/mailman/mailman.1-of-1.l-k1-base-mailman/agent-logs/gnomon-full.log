#!/bin/sh
# Bring the reading-group@local.edu mailing list service to its intended state.
#
# Idempotent: safe to run at any time, including after a machine restart.
#   1. regenerate the Postfix transport maps from the Mailman database
#   2. (re)apply the list policy
#   3. start Postfix and Mailman if they are not already running
set -e

CFG=/etc/mailman3/mailman.cfg
LIST=reading-group@local.edu
ADMIN_PY=/usr/local/lib/reading-group
MASTER_PID=/run/mailman3/master.pid

# The Mailman runtime directories must belong to the `list` user: the initscript
# and every Mailman daemon run as list:list.
mkdir -p /run/mailman3 /var/log/mailman3 /var/lib/mailman3/data
chown list:list /run/mailman3 /var/log/mailman3
chown -R list:list /var/lib/mailman3

as_list() {
    su -s /bin/sh list -c "PYTHONPATH=$ADMIN_PY mailman -C $CFG $*"
}

# 1. The list itself, and the transport maps Postfix routes on.
if ! as_list lists | grep -qx "$LIST"; then
    as_list "create --notify --owner root@local.edu $LIST"
fi
as_list aliases

# 2. List policy: subscription_policy=open (no owner approval for joins or
#    posts), unsubscription confirm (leave must be confirmed by replying),
#    archiving off (no archiver is installed here).
as_list "shell -l $LIST --run configure_list.configure" >/dev/null

# 3. The daemons.
#    `mailman status` reports the right text but a misleading exit code, so the
#    master pid file is what decides whether Mailman is up.
postfix status >/dev/null 2>&1 || postfix start
if ! kill -0 "$(cat "$MASTER_PID" 2>/dev/null)" 2>/dev/null; then
    as_list start
fi

echo "reading-group: list ready; postfix and mailman running"
EOF
