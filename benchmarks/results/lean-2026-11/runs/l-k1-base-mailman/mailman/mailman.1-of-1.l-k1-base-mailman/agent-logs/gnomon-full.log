"""Remove test accounts and leftover memberships from reading-group.

Test accounts are the random 16 hex digit names created by /app/eval.py and by
e2e_check.py.  Memberships whose local part is not an existing unix account
(the account was deleted but the subscription lingered) are dropped too, so
`reading-group` starts clean.
"""
import pwd
import re
import subprocess

PATTERN = re.compile(r'^[0-9a-f]{16}$')


def cleanup(mlist):
    usernames = {p.pw_name for p in pwd.getpwall()}
    test_users = sorted(u for u in usernames if PATTERN.match(u))

    removed = 0
    for member in list(mlist.members.members):
        local = member.address.email.split('@')[0]
        if PATTERN.match(local) or local not in usernames:
            member.unsubscribe()
            removed += 1
            print('unsubscribed', member.address.email)

    # userdel lives in /usr/sbin, which is not on the PATH `su list` sets up.
    for name in test_users:
        subprocess.run(['/usr/sbin/userdel', name], capture_output=True)
        subprocess.run(['/bin/rm', '-f', '/var/mail/%s' % name])

    print('removed %d test accounts and %d memberships'
          % (len(test_users), removed))
    print('remaining members:',
          [m.address.email for m in mlist.members.members])
EOF
