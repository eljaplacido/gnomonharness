"""Apply the reading-group mailing list policy.

Called by `mailman shell --run` so the settings live in the Mailman database
rather than in a hand-edited SQL file.  Idempotent.
"""
from mailman.interfaces.action import Action
from mailman.interfaces.archiver import ArchivePolicy
from mailman.interfaces.autorespond import ResponseAction
from mailman.interfaces.member import SubscriptionPolicy


def configure(mlist):
    # Nobody has to approve a join or a post; the subscriber still confirms.
    mlist.subscription_policy = SubscriptionPolicy.open
    mlist.unsubscription_policy = SubscriptionPolicy.open
    # Announcements from members and non-members are both accepted.
    mlist.default_member_action = Action.defer
    mlist.default_nonmember_action = Action.accept
    # No archiver is installed on this host, so archiving must stay off.
    mlist.archive_policy = ArchivePolicy.never
    # Keep the email command interface quiet-but-working: the -join/-leave
    # addresses answer a confirmation reply, nothing else.
    mlist.autorespond_requests = ResponseAction.none
    mlist.autorespond_owner = ResponseAction.none
    mlist.autorespond_postings = ResponseAction.none
    mlist.description = 'Reading group announcements'
    mlist.digests_enabled = False

    print('subscription_policy  :', mlist.subscription_policy)
    print('unsubscription_policy:', mlist.unsubscription_policy)
    print('member/nonmember    :', mlist.default_member_action,
          mlist.default_nonmember_action)
    print('archive_policy      :', mlist.archive_policy)
EOF
