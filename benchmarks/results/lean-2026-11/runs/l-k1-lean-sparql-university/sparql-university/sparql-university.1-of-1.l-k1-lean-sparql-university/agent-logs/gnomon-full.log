import re, sys
from collections import defaultdict

src = open('/app/university_graph.ttl', encoding='utf-8').read()
lines = src.split('\n')
prefixes = {}
body = []
for ln in lines:
    s = ln.strip()
    if s.startswith('@prefix'):
        m = re.match(r'@prefix\s+([\w-]*):\s*<([^>]+)>', s)
        prefixes[m.group(1)] = m.group(2)
        continue
    if s.startswith('#') or not s:
        continue
    body.append(s)
text = ' '.join(body)

def expand(tok):
    tok = tok.strip()
    if tok == 'a':
        return 'rdf:type'
    m = re.match(r'^([\w-]*):(.*)$', tok)
    if m:
        return prefixes[m.group(1)] + m.group(2)
    if tok.startswith('<'):
        return tok[1:-1]
    return tok

# tokenize respecting quoted literals
toks = re.findall(r'"(?:[^"\\]|\\.)*"(?:\^\^[\w:]+)?|<[^>]*>|[;,.\[\]]|[^\s;,.]+', text)
i = 0
triples = []
def parse_obj():
    global i
    t = toks[i]
    i += 1
    if t in '[':
        raise SystemExit('blank nodes not handled')
    if t.startswith('"'):
        m = re.match(r'^"((?:[^"\\]|\\.)*)"(?:\^\^([\w:]+))?$', t)
        val, dt = m.group(1), m.group(2)
        return ('lit', val, expand(dt) if dt else None)
    return ('uri', expand(t), None)

cur = None
while i < len(toks):
    if cur is None:
        subj = toks[i]; i += 1
        cur = expand(subj)
    # predicate
    pred = toks[i]; i += 1
    pred = expand(pred)
    while True:
        o = parse_obj()
        triples.append((cur, pred, o))
        if i >= len(toks):
            break
        nxt = toks[i]
        if nxt == ',':
            i += 1; continue
        if nxt == ';':
            i += 1
            while i < len(toks) and toks[i] == ';':
                i += 1
            if i < len(toks) and toks[i] == '.':
                i += 1
                cur = None
            break
        if nxt == '.':
            i += 1; cur = None; break
        break

if __name__ == '__main__':
    print(len(triples), 'triples,', len(prefixes), 'prefixes')
