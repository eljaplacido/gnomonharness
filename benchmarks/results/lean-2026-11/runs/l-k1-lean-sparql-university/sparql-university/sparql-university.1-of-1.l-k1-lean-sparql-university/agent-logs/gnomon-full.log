"""Small SPARQL subset engine: enough to actually execute solution.sparql."""
import re, datetime
from importlib.machinery import SourceFileLoader

_ttl = SourceFileLoader('ttl', '/app/.ttlparse.py').load_module()
GRAPH = _ttl.triples  # (subj_iri, pred_iri, ('lit',lex,dt)|('uri',iri))

XSD = 'http://www.w3.org/2001/XMLSchema#'

# ---------- tokenizer ----------
def tokenize(q):
    q = '\n'.join(l.split('#')[0] if not l.strip().startswith('#') else '' for l in q.split('\n'))
    pat = re.compile(r'"(?:[^"\\]|\\.)*"(?:\^\^[\w:]+)?|[?$][\w_]+|<[^<>]*>|[A-Za-z_][\w]*:[^\s(){};,]*|&&|\|\||!=|<=|>=|[{}();,.*=!<>]|[A-Za-z_][\w]*|-?\d+\.\d+|-?\d+')
    return pat.findall(q)

class Parser:
    def __init__(self, toks):
        self.t = toks; self.i = 0
    def peek(self, k=0):
        return self.t[self.i + k] if self.i + k < len(self.t) else None
    def next(self):
        tok = self.t[self.i]; self.i += 1; return tok
    def expect(self, tok):
        got = self.next()
        assert got == tok, f'expected {tok!r} got {got!r} at {self.i}'
        return got
    def at_keyword(self):
        p = self.peek()
        return p is not None and re.match(r'^[A-Za-z_][\w]*$', p) and p.upper() in {
            'FILTER','BIND','VALUES','OPTIONAL','SELECT','GROUP','HAVING','WHERE','AS','DISTINCT','ORDER','LIMIT','PREFIX','BASE','UNION','MINUS'}

    # ---- query ----
    def parse_query(self):
        prefixes = {'': ''}
        while self.peek() and self.peek().upper() == 'PREFIX':
            self.next(); name = self.next(); iri = self.next()
            assert iri.startswith('<') and iri.endswith('>'), iri
            prefixes[name[:-1]] = iri[1:-1]
        self.prefixes = prefixes
        assert self.next().upper() == 'SELECT'
        proj, aggs = [], {}
        while self.peek() != '{':
            tok = self.peek()
            if tok.startswith('?') or tok.startswith('$'):
                proj.append(('var', self.next()[1:]))
            elif tok == '(':
                self.next()
                expr = self.parse_expr()
                assert self.next().upper() == 'AS'
                v = self.next()[1:]
                self.expect(')')
                proj.append(('agg', expr, v))
            else:
                self.next()  # DISTINCT / *, ignore
        where = self.parse_group()
        group_by = []
        having = None
        while self.peek() and self.peek().upper() in ('GROUP', 'HAVING', 'ORDER', 'LIMIT'):
            kw = self.next().upper()
            if kw == 'GROUP':
                self.expect('BY')
                while self.peek().startswith('?'):
                    group_by.append(self.next()[1:])
            elif kw == 'HAVING':
                self.expect('(')
                having = self.parse_expr()
                self.expect(')')
            elif kw == 'LIMIT':
                self.next()
            else:
                while self.peek() and not self.at_keyword():
                    self.next()
        return proj, where, group_by, having

    # ---- groups ----
    def parse_group(self):
        self.expect('{')
        if self.peek() and self.peek().upper() == 'SELECT':
            self.next()
            proj, inner_where, group_by, having = self.parse_subquery_tail()
            self.expect('}')
            return [('subquery', proj, inner_where, group_by, having)]
        els = []
        while self.peek() != '}':
            tok = self.peek()
            up = tok.upper()
            if up == 'FILTER':
                self.next(); self.expect('(')
                e = self.parse_expr(); self.expect(')')
                els.append(('filter', e))
            elif up == 'BIND':
                self.next(); self.expect('(')
                e = self.parse_expr()
                self.expect('AS'); v = self.next()[1:]; self.expect(')')
                els.append(('bind', e, v))
            elif up == 'VALUES':
                self.next(); v = self.next()[1:]; self.expect('{')
                vals = []
                while self.peek() != '}':
                    vals.append(self.parse_term())
                self.expect('}')
                els.append(('values', v, vals))
            elif up == 'OPTIONAL':
                self.next()
                els.append(('optional', self.parse_group()))
            elif tok == '{':
                els.append(('group', self.parse_group()))
            else:
                els.append(('bgp', self.parse_triples()))
        self.expect('}')
        return els

    def parse_subquery_tail(self):
        proj = []
        while self.peek() != '{':
            tok = self.peek()
            if tok.startswith('?'):
                proj.append(('var', self.next()[1:]))
            elif tok == '(':
                self.next(); e = self.parse_expr()
                assert self.next().upper() == 'AS'
                v = self.next()[1:]; self.expect(')')
                proj.append(('agg', e, v))
            else:
                self.next()
        where = self.parse_group()
        group_by, having = [], None
        while self.peek() and self.peek().upper() in ('GROUP', 'HAVING'):
            kw = self.next().upper()
            if kw == 'GROUP':
                self.expect('BY')
                while self.peek().startswith('?'):
                    group_by.append(self.next()[1:])
            else:
                self.expect('('); having = self.parse_expr(); self.expect(')')
        return proj, where, group_by, having

    def parse_triples(self):
        triples = []
        subj = self.parse_term()
        while True:
            if self.peek() == '.':
                self.next(); return triples
            if self.peek() == '}' or self.at_keyword():
                return triples
            pred = self.parse_term()
            while True:
                obj = self.parse_term()
                triples.append((subj, pred, obj))
                if self.peek() == ',':
                    self.next(); continue
                break
            if self.peek() == ';':
                self.next()
                while self.peek() == ';':
                    self.next()
                if self.peek() == '.':
                    self.next(); return triples
                continue
            if self.peek() == '.':
                self.next(); return triples
            return triples

    # ---- terms / expressions ----
    def parse_term(self):
        tok = self.next()
        if tok.startswith('?') or tok.startswith('$'):
            return ('var', tok[1:])
        if tok == 'a':
            return ('uri', 'rdf:type')
        if tok.startswith('<'):
            return ('uri', tok[1:-1])
        if tok.startswith('"'):
            m = re.match(r'^"((?:[^"\\]|\\.)*)"(?:\^\^([\w:]+))?$', tok)
            dt = None
            if m.group(2):
                pfx, local = m.group(2).split(':')
                dt = self.prefixes[pfx] + local
            return ('lit', m.group(1), dt)
        if re.match(r'^-?\d+$', tok):
            return ('lit', tok, XSD + 'integer')
        if ':' in tok:
            pfx, local = tok.split(':', 1)
            return ('uri', self.prefixes[pfx] + local)
        raise AssertionError('bad term ' + tok)

    def parse_expr(self):
        return self.parse_or()

    def parse_or(self):
        left = self.parse_and()
        while self.peek() == '||':
            self.next(); left = ('or', left, self.parse_and())
        return left

    def parse_and(self):
        left = self.parse_cmp()
        while self.peek() == '&&':
            self.next(); left = ('and', left, self.parse_cmp())
        return left

    OPS = {'=', '!=', '<', '>', '<=', '>='}
    def parse_cmp(self):
        left = self.parse_unary()
        if self.peek() in self.OPS:
            op = self.next()
            return ('cmp', op, left, self.parse_unary())
        return left

    def parse_unary(self):
        if self.peek() == '!':
            self.next(); return ('not', self.parse_unary())
        return self.parse_atom()

    def parse_atom(self):
        tok = self.peek()
        if tok == '(':
            self.next(); e = self.parse_expr(); self.expect(')'); return e
        # aggregate / function call
        if re.match(r'^[A-Za-z_][\w]*$', tok) and self.peek(1) == '(':
            name = self.next().upper()
            self.expect('(')
            distinct = False
            if self.peek() and self.peek().upper() == 'DISTINCT':
                self.next(); distinct = True
            args = []
            if self.peek() != ')':
                args.append(self.parse_expr())
                separator = None
                while self.peek() in (';', ','):
                    self.next()
                    if self.peek() and self.peek().upper() == 'SEPARATOR':
                        self.next(); self.expect('=')
                        separator = self.parse_expr()
                    else:
                        args.append(self.parse_expr())
                if separator is not None:
                    args.append(('sep', separator))
            self.expect(')')
            return ('call', name, args, distinct)
        return self.parse_term()

EVAL = None

def as_py(term, b):
    """Resolve a term in a binding to a python value (or None when unbound)."""
    kind = term[0]
    if kind == 'var':
        return b.get(term[1])
    if kind == 'lit':
        return term
    if kind == 'uri':
        return term
    raise AssertionError(term)

def cmp_key(term):
    """Comparable python value for a term."""
    if term is None:
        return None
    if term[0] == 'lit':
        if term[2] == XSD + 'date':
            return datetime.date(*map(int, term[1].split('-')))
        if term[2] == XSD + 'integer':
            return int(term[1])
        return term[1]
    return term[1]

def term_str(term):
    if term[0] == 'lit':
        return term[1]
    return term[1]

class Agg:
    def __init__(self, name, args, distinct, rows):
        self.name, self.args, self.distinct, self.rows = name, args, distinct, rows
    def value(self):
        vals = [as_py(self.args[0], r) for r in self.rows]
        vals = [v for v in vals if v is not None]
        if self.name == 'COUNT':
            if self.distinct:
                seen, out = set(), []
                for v in vals:
                    if v not in seen:
                        seen.add(v); out.append(v)
                vals = out
            if not self.args:
                vals = [1 for _ in self.rows]
            return ('lit', str(len(vals)), XSD + 'integer')
        if self.name == 'GROUP_CONCAT':
            sep = ', '
            for a in self.args[1:]:
                if a[0] == 'sep':
                    sep = as_py(a[1], {} )['1']
            strs = [term_str(v) for v in vals]
            if self.distinct:
                seen, out = set(), []
                for v in strs:
                    if v not in seen:
                        seen.add(v); out.append(v)
                strs = out
            return ('lit', sep.join(strs), None)
        raise AssertionError('agg ' + self.name)

def evaluate_expr(e, b, rows=None):
    k = e[0]
    if k == 'var':
        return b.get(e[1])
    if k in ('lit', 'uri'):
        return e
    if k == 'sep':
        return evaluate_expr(e[1], b, rows)
    if k == 'or':
        return truthy(evaluate_expr(e[1], b, rows)) or truthy(evaluate_expr(e[2], b, rows))
    if k == 'and':
        return truthy(evaluate_expr(e[1], b, rows)) and truthy(evaluate_expr(e[2], b, rows))
    if k == 'not':
        return not truthy(evaluate_expr(e[1], b, rows))
    if k == 'cmp':
        l = cmp_key(evaluate_expr(e[2], b, rows))
        r = cmp_key(evaluate_expr(e[3], b, rows))
        op = e[1]
        if l is None or r is None:
            return False
        return {'=': l == r, '!=': l != r, '<': l < r, '>': l > r,
                '<=': l <= r, '>=': l >= r}[op]
    if k == 'call':
        name, args, distinct = e[1], e[2], e[3]
        if name in ('COUNT', 'GROUP_CONCAT'):
            assert rows is not None, 'aggregate outside grouping'
            return Agg(name, args, distinct, rows).value()
        if name == 'BOUND':
            return args[0][1] in b
        vals = [evaluate_expr(a, b, rows) for a in args]
        if name == 'STR':
            return ('lit', term_str(vals[0]), None)
        if name == 'LCASE':
            return ('lit', term_str(vals[0]).lower(), None)
        if name == 'UCASE':
            return ('lit', term_str(vals[0]).upper(), None)
        if name == 'CONTAINS':
            return term_str(vals[0]).find(term_str(vals[1])) >= 0
        if name in ('REGEX', 'REPLACE'):
            flags = re.I if len(vals) > 2 and 'i' in term_str(vals[2]) else 0
            return re.search(term_str(vals[1]), term_str(vals[0]), flags) is not None
        if name == 'LANG':
            return ('lit', '', None)
        raise AssertionError('function ' + name)
    raise AssertionError(e)

def truthy(v):
    if isinstance(v, bool):
        return v
    if v is None:
        return False
    return v[0] != 'lit' or v[1] == 'true'

def match_term(pattern, term, b):
    if pattern[0] == 'var':
        cur = b.get(pattern[1])
        if cur is not None:
            return cur == term
        b[pattern[1]] = term
        return True
    if pattern[0] == 'uri':
        return term[0] == 'uri' and term[1] == pattern[1] or (pattern[1] == 'rdf:type' and term[0]=='uri' and term[1].endswith('rdf-syntax-ns#type'))
    if pattern[0] == 'lit':
        return term[0] == 'lit' and term[1] == pattern[1] and term[2] == pattern[2]
    raise AssertionError(pattern)

def eval_bgp(triples, sols):
    for (s, p, o) in triples:
        out = []
        for b in sols:
            for (gs, gp, go) in GRAPH:
                nb = dict(b)
                if match_term(s, ('uri', gs), nb) and match_term(p, ('uri', gp), nb) and match_term(o, go, nb):
                    out.append(nb)
        sols = out
    return sols

def compatible(a, b):
    return all(k not in b or b[k] == v for k, v in a.items())

def merge(a, b):
    r = dict(a); r.update(b); return r

def project_group(group, proj, group_by, having, sols):
    """Group/aggregate like a SELECT clause over `sols`."""
    if not group_by and not any(e[0] == 'agg' for e in proj) and having is None:
        groups = [(None, sols)] if sols else []
        out = []
        for _, rows in groups:
            for r in rows:
                row = {}
                for e in proj:
                    if e[0] == 'var':
                        row[e[1]] = r.get(e[1])
                out.append(row)
        return out
    keyed = {}
    for r in sols:
        key = tuple(r.get(g) for g in group_by)
        keyed.setdefault(key, []).append(r)
    if not group_by:
        keyed = {(): sols}
    out = []
    for key, rows in keyed.items():
        b = {g: v for g, v in zip(group_by, key)}
        if having is not None and not truthy(evaluate_expr(having, b, rows)):
            continue
        row = {}
        for e in proj:
            if e[0] == 'var':
                row[e[1]] = b.get(e[1])
            else:
                row[e[2]] = evaluate_expr(e[1], b, rows)
        out.append(row)
    return out

def eval_group(els, sols):
    for el in els:
        k = el[0]
        if k == 'bgp':
            sols = eval_bgp(el[1], sols)
        elif k == 'filter':
            sols = [b for b in sols if truthy(evaluate_expr(el[1], b))]
        elif k == 'bind':
            new = []
            for b in sols:
                nb = dict(b); nb[el[2]] = evaluate_expr(el[1], b)
                new.append(nb)
            sols = new
        elif k == 'values':
            new = []
            for b in sols:
                for v in el[2]:
                    if b.get(el[1]) is None and len(el[2]) > 1:
                        nb = dict(b); nb[el[1]] = v; new.append(nb)
                    elif b.get(el[1]) == v:
                        new.append(dict(b))
            sols = new
        elif k == 'optional':
            a = el[1]; options = [('optional', a)]; sols = eval_group(options, sols)
        elif k == 'optional_marker':
            pass
        elif k == 'group':
            sub = eval_group(el[1], [{}])
            sols = [merge(b, s) for b in sols for s in sub if compatible(b, s)]
        elif k == 'subquery':
            _, proj, where, group_by, having = el
            sub = eval_group(where, [{}])
            sub = project_group(None, proj, group_by, having, sub)
            sols = [merge(b, s) for b in sols for s in sub if compatible(b, s)]
        else:
            raise AssertionError(k)
    return sols

def run(path):
    p = Parser(tokenize(open(path).read()))
    proj, where, group_by, having = p.parse_query()
    sols = eval_group(where, [{}])
    return project_group(None, proj, group_by, having, sols)

if __name__ == '__main__':
    rows = run('/app/solution.sparql')
    print(len(rows), 'rows')
    for r in sorted(rows, key=lambda r: r.get('professorName', ('lit', ''))[1]):
        print(' ', {k: (v[1] if v else None) for k, v in r.items()})
