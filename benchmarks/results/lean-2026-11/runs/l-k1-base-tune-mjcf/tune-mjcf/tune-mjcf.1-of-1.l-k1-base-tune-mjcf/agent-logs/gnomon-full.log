import sys, time, json
import numpy as np
import mujoco

REF = '/app/model_ref.xml'
T = 2.0
FP = mujoco.mjtState.mjSTATE_FULLPHYSICS

def build(path_or_xml, is_string=False):
    return mujoco.MjModel.from_xml_string(path_or_xml) if is_string else mujoco.MjModel.from_xml_path(path_or_xml)

def final_state(model, seed):
    d = mujoco.MjData(model)
    rng = np.random.default_rng(seed)
    d.qpos += rng.normal(0, 0.01, size=d.qpos.shape)
    mujoco.mj_forward(model, d)
    n = int(T / model.opt.timestep)
    for _ in range(n):
        mujoco.mj_step(model, d)
    st = np.zeros(mujoco.mj_stateSize(model, FP))
    mujoco.mj_getState(model, d, st, FP)
    return st

def elapsed(model, seed):
    d = mujoco.MjData(model)
    rng = np.random.default_rng(seed)
    d.qpos += rng.normal(0, 0.01, size=d.qpos.shape)
    mujoco.mj_forward(model, d)
    n = int(T / model.opt.timestep)
    t0 = time.perf_counter()
    for _ in range(n):
        mujoco.mj_step(model, d)
    return time.perf_counter() - t0

def speed(model, n_runs=12):
    # best-of-block to reduce noise: interleave seeds
    ts = [elapsed(model, s) for s in range(n_runs)]
    return float(np.median(ts))

def check(mxml, label, is_string=True, seeds=(0, 1, 2, 3, 4), ref_states=None, ref_time=None):
    try:
        m = build(mxml, is_string)
    except Exception as e:
        print(f'{label:44s} COMPILE FAIL: {str(e)[:90]}')
        return None
    d = mujoco.MjData(m)
    rng = np.random.default_rng(0); d.qpos += rng.normal(0, 0.01, size=d.qpos.shape)
    mujoco.mj_forward(m, d)
    for _ in range(50):
        mujoco.mj_step(m, d)
    if not (np.isfinite(d.qpos).all() and np.isfinite(d.qvel).all()):
        print(f'{label:44s} NaN/Inf during sim')
        return None
    worst = 0.0; scales = 0.0
    for s in seeds:
        st = final_state(m, s)
        r = ref_states[s]
        assert st.shape == r.shape, (st.shape, r.shape)
        # elementwise margin used by np.allclose(atol=1e-5)
        tol = 1e-5 + 1e-5 * np.abs(r)
        ratio = (np.abs(st - r) / tol).max()
        worst = max(worst, float(np.abs(st - r).max()))
        scales = max(scales, float(ratio))
    tm = speed(m)
    pct = tm / ref_time
    print(f'{label:44s} {pct*100:6.1f}%  max|diff|={worst:.2e}  worst/tol={scales:7.3f}  {"OK" if scales<=1 and pct<=0.6 else "no"}')
    return dict(pct=pct, maxdiff=worst, ratio=scales)

if __name__ == '__main__':
    refm = build(REF)
    seeds = tuple(range(6))
    ref_states = {s: final_state(refm, s) for s in seeds}
    ref_time = speed(refm)
    print('ref step us', ref_time / 1000 * 1e6)
    json.dump({'ref_time': ref_time}, open('/app/scratch/ref_time.json', 'w'))
    ref_xml = open(REF).read()
    check(ref_xml, 'reference (sanity)', seeds=seeds, ref_states=ref_states, ref_time=ref_time)
