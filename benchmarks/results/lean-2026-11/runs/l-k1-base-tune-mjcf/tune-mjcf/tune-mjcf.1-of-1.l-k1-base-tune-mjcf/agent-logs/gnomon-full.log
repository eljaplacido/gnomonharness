ref_time = speed(refm)
print(f'ref {ref_time*1000:.1f} ms  ({ref_time/1000*1e6:.1f} us/step)')

base = open(REF).read()
INS = '<compiler autolimits="true"/>'

def variant(opts):
    return base.replace(INS, INS + '<option ' + opts + '/>')

def report(label, xml):
    try:
        m = build(xml, True)
    except Exception as e:
        print(f'{label:40s} COMPILE FAIL {str(e)[:70]}'); return
    worst_ratio = 0.0; worst = 0.0
    for s in seeds:
        st = final_state(m, s)
        r = ref_states[s]
        tol = 1e-5 + 1e-5*np.abs(r)
        worst_ratio = max(worst_ratio, float((np.abs(st-r)/tol).max()))
        worst = max(worst, float(np.abs(st-r).max()))
    tm = speed(m)
    pct = tm/ref_time
    flag = 'PASS' if (worst_ratio <= 1 and pct <= 0.6) else ''
    print(f'{label:40s} {pct*100:5.1f}%  |diff|={worst:.1e} ratio={worst_ratio:8.3f} {flag}')

for label, opts in [
    ('baseline', ''),
    ('solver=PGS', 'solver="PGS"'),
    ('solver=CG', 'solver="CG"'),
    ('iterations=1', 'iterations="1"'),
    ('iterations=2', 'iterations="2"'),
    ('iterations=5', 'iterations="5"'),
    ('tol=1e-6', 'tolerance="1e-6"'),
    ('tol=1e-4', 'tolerance="1e-4"'),
    ('jacobian=sparse', 'jacobian="sparse"'),
    ('PGS iter=10', 'solver="PGS" iterations="10"'),
    ('PGS iter=5', 'solver="PGS" iterations="5"'),
]:
    report(label, variant(opts))
