starts = [k for k, e in kmers.items() if e[0] == 'F']
print(f'Found {len(starts)} start nodes')

# Trace each path
for start in sorted(starts):
    path = [start]
    current = start
    visited = {current}
    while True:
        ext = kmers[current]
        right = ext[1]
        if right == 'F':
            break
        # Next kmer
        next_kmer = current[1:] + right
        if next_kmer not in kmers:
            break
        if next_kmer in visited:
            break
        path.append(next_kmer)
        visited.add(next_kmer)
        current = next_kmer
    contig = path[0]
    for kmer in path[1:]:
        contig += kmer[-1]
    print(f'Path length: {len(path)}, Contig length: {len(contig)}')
    print(f'Contig: {contig}')
    print()
