[20.149246, "o", "The input JSON file '\"'\"'/app/users.json'\"'\"' is an array of user objects with the following structure:\r\n\u001b[?2004l\r"]
[20.149277, "o", "\u001b[?2004h> [\r\n\u001b[?2004l\r\u001b[?2004h> "]
