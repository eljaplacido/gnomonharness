[20.149785, "o", "\u001b[?2004h> "]
[20.149931, "o", "    \"last_login\": \"2024-10-02T20:59:10.109812Z\",  # ISO 8601 timestamp (UTC) of the last login\r\n\u001b[?2004l\r\u001b[?2004h> "]
