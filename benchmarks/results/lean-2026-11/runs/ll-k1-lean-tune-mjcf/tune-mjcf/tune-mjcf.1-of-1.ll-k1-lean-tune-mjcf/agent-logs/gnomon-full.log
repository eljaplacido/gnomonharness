import mujoco
import numpy as np

model = mujoco.MjModel.from_xml_path('model_ref.xml')
data = mujoco.MjData(model)

seed = np.random.randint(0, 10000)
rng = np.random.default_rng(seed)
data.qpos += rng.normal(0, 0.01, size=data.qpos.shape)
mujoco.mj_forward(model, data)

# Check what's in the state
full_physics = mujoco.mjtState.mjSTATE_FULLPHYSICS
state_size = mujoco.mj_stateSize(model, full_physics)
print(f'State size: {state_size}')

# Step a few times and check
for i in range(10):
    mujoco.mj_step(model, data)

state = np.zeros(state_size)
mujoco.mj_getState(model, data, state, full_physics)
print(f'Final state norm: {np.linalg.norm(state)}')
print(f'Has NaN: {np.isnan(state).any()}')
print(f'Has Inf: {np.isinf(state).any()}')
