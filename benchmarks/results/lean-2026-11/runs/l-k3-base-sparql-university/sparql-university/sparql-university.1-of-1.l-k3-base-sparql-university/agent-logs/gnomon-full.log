new='''def parse_turtle(text):
    p = Parser(text)
    triples = []
    while p.peek()[0] is not None:
        kind, val = p.peek()
        if kind == 'lang' and val.lower() == '@prefix':
            p.next()
            pk, pv = p.next()
            assert pk == 'pname' and pv.endswith(':'), pv
            p.prefixes[pv[:-1]] = p.parse_term(allow_literal=False)[1]
            if p.at_punct('.'):
                p.next()
            continue
        if kind == 'word' and val.lower() == 'prefix':
            p.next()
            pk, pv = p.next()
            assert pk == 'pname' and pv.endswith(':'), pv
            p.prefixes[pv[:-1]] = p.parse_term(allow_literal=False)[1]
            continue
        subj = p.parse_term(allow_literal=False)
        while True:                                # predicate / object list
            pred = p.parse_term(allow_literal=False)
            assert pred[0] == 'iri', pred
            while True:
                obj = p.parse_term()
                triples.append((subj, pred, obj))
                if p.at_punct(','):
                    p.next()
                    continue
                break
            if p.at_punct(';'):
                p.next()
                if p.at_punct('.') or p.peek()[0] is None or p.at_punct('}'):
                    break
                continue
            break
        if p.at_punct('.'):
            p.next()
    return triples, p.prefixes


'''
