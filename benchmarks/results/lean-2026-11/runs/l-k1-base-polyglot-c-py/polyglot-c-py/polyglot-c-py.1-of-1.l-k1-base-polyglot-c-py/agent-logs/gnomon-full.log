#include <errno.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define BIG_BASE 1000000000u

typedef struct {
    uint32_t *d;
    size_t len;
    size_t cap;
} Big;

static int big_reserve(Big *x, size_t need)
{
    if (need <= x->cap)
        return 1;
    if (need > (size_t)-1 / sizeof(uint32_t))
        return 0;

    size_t cap = x->cap ? x->cap : 4;
    while (cap < need) {
        if (cap > (size_t)-1 / 2) {
            cap = need;
            break;
        }
        cap *= 2;
    }

    uint32_t *p = realloc(x->d, cap * sizeof(uint32_t));
    if (p == NULL)
        return 0;
    x->d = p;
    x->cap = cap;
    return 1;
}

static void big_free(Big *x)
{
    free(x->d);
    x->d = NULL;
    x->len = 0;
    x->cap = 0;
}

static void big_swap(Big *a, Big *b)
{
    Big t = *a;
    *a = *b;
    *b = t;
}

static int big_set_u64(Big *x, unsigned long long v)
{
    x->len = 0;
    if (v == 0)
        return 1;
    if (!big_reserve(x, 3))
        return 0;

    while (v != 0) {
        x->d[x->len++] = (uint32_t)(v % BIG_BASE);
        v /= BIG_BASE;
    }
    return 1;
}

static int big_add(const Big *a, const Big *b, Big *r)
{
    size_t max_len = a->len > b->len ? a->len : b->len;
    if (!big_reserve(r, max_len + 1))
        return 0;

    uint64_t carry = 0;
    for (size_t i = 0; i < max_len; ++i) {
        uint64_t sum = carry;
        if (i < a->len)
            sum += a->d[i];
        if (i < b->len)
            sum += b->d[i];
        r->d[i] = (uint32_t)(sum % BIG_BASE);
        carry = sum / BIG_BASE;
    }

    if (carry != 0)
        r->d[max_len++] = (uint32_t)carry;
    r->len = max_len;
    return 1;
}

/* Requires a >= b. */
static int big_sub(const Big *a, const Big *b, Big *r)
{
    if (!big_reserve(r, a->len))
        return 0;

    uint64_t borrow = 0;
    for (size_t i = 0; i < a->len; ++i) {
        uint64_t rhs = borrow;
        if (i < b->len)
            rhs += b->d[i];
        if (a->d[i] < rhs) {
            r->d[i] = (uint32_t)((uint64_t)a->d[i] + BIG_BASE - rhs);
            borrow = 1;
        } else {
            r->d[i] = (uint32_t)(a->d[i] - rhs);
            borrow = 0;
        }
    }

    size_t len = a->len;
    while (len > 0 && r->d[len - 1] == 0)
        --len;
    r->len = len;
    return 1;
}

static int big_mul(const Big *a, const Big *b, Big *r)
{
    if (a->len == 0 || b->len == 0) {
        r->len = 0;
        return 1;
    }

    size_t n = a->len + b->len;
    uint32_t *tmp = calloc(n, sizeof(uint32_t));
    if (tmp == NULL)
        return 0;

    for (size_t i = 0; i < a->len; ++i) {
        uint64_t carry = 0;
        for (size_t j = 0; j < b->len; ++j) {
            uint64_t cur = (uint64_t)tmp[i + j]
                         + (uint64_t)a->d[i] * b->d[j]
                         + carry;
            tmp[i + j] = (uint32_t)(cur % BIG_BASE);
            carry = cur / BIG_BASE;
        }

        size_t k = i + b->len;
        while (carry != 0) {
            uint64_t cur = (uint64_t)tmp[k] + carry;
            tmp[k] = (uint32_t)(cur % BIG_BASE);
            carry = cur / BIG_BASE;
            ++k;
        }
    }

    size_t len = n;
    while (len > 0 && tmp[len - 1] == 0)
        --len;

    free(r->d);
    r->d = tmp;
    r->len = len;
    r->cap = n;
    return 1;
}

static int fib_big(unsigned long long n, Big *out)
{
    Big a = {0}, b = {0};
    Big c = {0}, d = {0}, t = {0}, u = {0};
    int ok = big_set_u64(&a, 0) && big_set_u64(&b, 1);
    int started = 0;

    for (int i = 63; ok && i >= 0; --i) {
        int bit = (int)((n >> i) & 1u);
        if (!started) {
            if (!bit)
                continue;
            started = 1;
        }

        /* (c, d) = (F(2k), F(2k+1)) from (a, b) = (F(k), F(k+1)). */
        ok = big_add(&b, &b, &t)
          && big_sub(&t, &a, &u)
          && big_mul(&a, &u, &c)
          && big_mul(&a, &a, &t)
          && big_mul(&b, &b, &u)
          && big_add(&t, &u, &d);

        if (!ok)
            break;

        if (bit) {
            ok = big_add(&c, &d, &t);
            big_swap(&a, &d);
            big_swap(&b, &t);
        } else {
            big_swap(&a, &c);
            big_swap(&b, &d);
        }
    }

    if (ok) {
        big_free(out);
        *out = a;
        a.d = NULL;
        a.len = 0;
        a.cap = 0;
    }

    big_free(&a);
    big_free(&b);
    big_free(&c);
    big_free(&d);
    big_free(&t);
    big_free(&u);
    return ok;
}

static void print_big(const Big *x)
{
    if (x->len == 0) {
        putchar('0');
    } else {
        printf("%u", (unsigned)x->d[x->len - 1]);
        for (size_t i = x->len - 1; i > 0; --i)
            printf("%09u", (unsigned)x->d[i - 1]);
    }
    putchar('\n');
}

int main(int argc, char **argv)
{
    if (argc != 2)
        return 1;

    char *end = NULL;
    errno = 0;
    unsigned long long n = strtoull(argv[1], &end, 10);
    if (errno == ERANGE || end == argv[1] || *end != '\0' || argv[1][0] == '-')
        return 1;

    Big result = {0};
    if (!fib_big(n, &result)) {
        big_free(&result);
        return 1;
    }

    print_big(&result);
    big_free(&result);
    return 0;
}
