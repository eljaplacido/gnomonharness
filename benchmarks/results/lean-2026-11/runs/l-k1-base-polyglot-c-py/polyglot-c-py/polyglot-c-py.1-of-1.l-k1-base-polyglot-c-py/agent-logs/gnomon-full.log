#if 0
import sys


def fib(n):
    """Return the n-th Fibonacci number, with F(0) = 0 and F(1) = 1."""
    a, b = 0, 1
    for bit in bin(n)[2:]:
        c = a * (2 * b - a)
        d = a * a + b * b
        if bit == '1':
            a, b = d, c + d
        else:
            a, b = c, d
    return a


print(fib(int(sys.argv[1])))
