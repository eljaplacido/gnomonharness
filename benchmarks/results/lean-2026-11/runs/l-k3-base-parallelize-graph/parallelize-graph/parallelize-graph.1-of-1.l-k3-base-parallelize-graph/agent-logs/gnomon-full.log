[approval] bash: cd /app && cat > /tmp/ref.py <<'EOF'
K=19
lines=[l.rstrip('\n') for l in open('test') if l.strip()]
kms=[]; ext={}
for l in lines:
    k,e=l.split('\t')
    kms.append(k); ext[k]=e
print("n=",len(kms),"k=",len(kms[0]),"uniq=",len(set(kms)))
# verify overlapping structure
idx={k:i for i,k in enumerate(kms)}
left={}; right={}
for i,k in enumerate(kms):
    le,re=ext[k]
    if le!='F':
        prev=le+k[:-1]
        left[i]=idx.get(prev,-1)
    else: left[i]=-1
    if re!='F':
        nxt=k[1:]+re
        right[i]=idx.get(nxt,-1)
    else: right[i]=-1
# missing neighbours
ml=sum(1 for i in left if left[i]==-1 and ext[kms[i]][0]!='F')
mr=sum(1 for i in right if right[i]==-1 and ext[kms[i]][1]!='F')
print("left F:",sum(1 for i in range(len(kms)) if ext[kms[i]][0]=='F'),"right F:",sum(1 for i in range(len(kms)) if ext[kms[i]][1]=='F'))
print("dangling left(no node):",ml,"dangling right:",mr)
# consistency: right[left[i]] == i ?
bad=sum(1 for i in left if left[i]!=-1 and right[left[i]]!=i)
bad2=sum(1 for i in right if right[i]!=-1 and left[right[i]]!=i)
print("inconsistent back-links:",bad,bad2)
# heads
heads=[i for i in range(len(kms)) if left[i]==-1 or right[left[i]]!=i]
print("heads:",len(heads))
# traverse
vis=[False]*len(kms); contigs=[]
order=list(range(len(kms)))
for i in order:
    if vis[i]: continue
    j=i; steps=0
    while left[j]!=-1 and not vis[left[j]] and steps<len(kms):
        j=left[j]; steps+=1
        if j==i: break
    s=kms[j]; cur=j
    while True:
        vis[cur]=True
        if right[cur]==-1 or vis[right[cur]]: break
        s+=ext[kms[cur]][1]; cur=right[cur]
    contigs.append(s)
print("contigs:",len(contigs),"total len:",sum(len(c) for c in contigs))
print("lengths:",sorted(len(c) for c in contigs))
for c in contigs[:3]: print(c[:60],"...",len(c))
open('/tmp/ref.out','w').write("\n".join(contigs)+"\n")
EOF
