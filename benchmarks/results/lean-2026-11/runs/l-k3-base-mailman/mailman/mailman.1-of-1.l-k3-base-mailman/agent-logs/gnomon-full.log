import mailbox, os, smtplib, subprocess, sys
from email.mime.text import MIMEText
from functools import partial as bind
from time import sleep
sys.path.insert(0, '/app')
import eval as E

def mk():
    u = os.urandom(6).hex()
    subprocess.run(["useradd", u], check=True)
    return u

# --- subscribe two users, one via -join, one via -subscribe alias
alice, bob = mk(), mk()
E.send_email(body="", subject="", from_addr=f"{alice}@local.edu", to_addr=E.JOIN_LIST)
E.send_email(body="", subject="", from_addr=f"{bob}@local.edu", to_addr="reading-group-subscribe@local.edu")
for u in (alice, bob):
    E.retry(bind(E.confirm_last_reply, u, "join"))
mlist = E.get_mlist()
for u in (alice, bob):
    assert mlist.members.get_member(f"{u}@local.edu"), f"{u} not a member"
