#!/bin/sh
# Start/stop/status for the reading-group@local.edu mail stack.
# This container has no init system, so both daemons are started detached.
MAILMAN="mailman -C /etc/mailman3/mailman.cfg"

running_mailman() {
    # Match only the real daemon processes (owner `list`, and the python
    # interpreter path), never this script's own command line.
    pgrep -u list -f '^/usr/bin/python3 /usr/lib/mailman3/bin/master' >/dev/null 2>&1
}

case "$1" in
  start)
    service postfix start >/dev/null 2>&1 || true
    if ! running_mailman; then
        mkdir -p /run/mailman3 && chown list:list /run/mailman3
        setsid su -s /bin/sh -c "$MAILMAN start" list \
            </dev/null >/var/log/mailman3/master.out 2>&1 &
    fi
    # Wait for the LMTP listener and the runners to come up.
    i=0
    while [ $i -lt 30 ]; do
        running_mailman && break
        i=$((i + 1))
        sleep 1
    done
    sleep 4
    ;;
  stop)
    su -s /bin/sh -c "$MAILMAN stop" list >/dev/null 2>&1 || true
    service postfix stop >/dev/null 2>&1 || true
    ;;
  restart)
    "$0" stop; sleep 2; "$0" start
    ;;
  status)
    postfix status 2>&1
    su -s /bin/sh -c "$MAILMAN status" list 2>&1
    ;;
  *) echo "usage: $0 {start|stop|restart|status}" >&2; exit 2 ;;
esac
EOF
