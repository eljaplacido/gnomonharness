#!/bin/sh
# Provision the reading-group@local.edu mailing list server (postfix + mailman3).
#
# Idempotent: safe to re-run.  Reproduces:
#   * /etc/mailman3/mailman.cfg            (Mailman: LMTP in, SMTP out)
#   * /etc/postfix/main.cf additions       (local.edu -> Mailman over LMTP)
#   * /etc/postfix/mailman_transport.regexp
#   * the reading-group@local.edu list with open subscription policy
#   * /usr/local/bin/mail-services         (start/stop/status helper)
set -e

MMCFG=/etc/mailman3/mailman.cfg
MAILMAN="mailman -C $MMCFG"

# --- directories Mailman runs as user `list` --------------------------------
mkdir -p /run/mailman3
chown list:list /run/mailman3
chown -R list:list /var/lib/mailman3 /var/log/mailman3
chmod 0664 "$MMCFG"; chown root:list "$MMCFG"

# --- postfix: hand @local.edu to Mailman over LMTP, keep local mbox delivery -
postconf -e 'mydomain = local.edu'
postconf -e 'myhostname = local.edu'
postconf -e 'myorigin = $mydomain'
postconf -e 'mydestination = $myhostname, localhost, localhost.localdomain, local.edu'
postconf -e 'recipient_delimiter = +'
postconf -e 'transport_maps = hash:/var/lib/mailman3/data/postfix_lmtp, regexp:/etc/postfix/mailman_transport.regexp'
postconf -e 'local_recipient_maps = proxy:unix:passwd.byname $alias_maps hash:/var/lib/mailman3/data/postfix_lmtp'
postconf -e 'mail_spool_directory = /var/mail'
postconf -e 'maillog_file = /var/log/mail.log'

# Sub-addresses carrying an address extension, e.g. the VERP-style
# reading-group-confirm+<cookie>@local.edu reply address.
cat > /etc/postfix/mailman_transport.regexp <<'EOF'
/^reading-group(-[^@]*)?(\+[^@]*)?@local\.edu$/   lmtp:127.0.0.1:8024
EOF

service postfix start >/dev/null 2>&1 || true

# --- mailman: create the list and set its policies --------------------------
cd /tmp
if ! su -s /bin/sh -c "$MAILMAN lists" list 2>/dev/null | grep -q 'reading-group@local.edu'; then
    su -s /bin/sh -c "$MAILMAN create --owner root@local.edu --notify reading-group@local.edu" list
