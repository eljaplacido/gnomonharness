cat > /etc/mailman3/mailman.cfg <<'EOF'
# GNU Mailman 3 configuration for the reading-group@local.edu mailing list.
#
# Mail flow:
#
#   user --(SMTP :25)--> Postfix --(LMTP 127.0.0.1:8024)--> Mailman
#   Mailman --(SMTP :25)--> Postfix --> /var/mail/<username> (mbox)
#
# Postfix treats local.edu as a relay/virtual domain whose traffic is handed
# to Mailman over LMTP; Mailman hands everything back to Postfix for final
# local delivery.  See /etc/postfix/main.cf too.

[mailman]
# The site owner.  Must be a real, deliverable local address.
site_owner: root@local.edu

# Local part of the From: address used when there is no natural reply
# recipient.  Mailman appends '@' + the list's domain.
noreply_address: noreply

default_language: en

sender_headers: from from_ reply-to sender

email_commands_max_lines: 10

pending_request_life: 3d
moderator_request_life: 180d
cache_life: 7d
run_tasks_every: 1h

pre_hook:
post_hook:

# Debian layout: /var/lib/mailman3, /var/log/mailman3, runs as user `list`.
layout: debian

filtered_messages_are_preservable: no

html_to_plain_text_command: /usr/bin/lynx -dump $filename

listname_chars: [-_.0-9a-z]


[shell]
prompt: >>>
banner: Welcome to the GNU Mailman shell
use_ipython: no
history_file:


[paths.debian]
var_dir: /var/lib/mailman3
queue_dir: $var_dir/queue
bin_dir: /usr/lib/mailman3/bin
list_data_dir: $var_dir/lists
log_dir: /var/log/mailman3
lock_dir: $var_dir/locks
data_dir: $var_dir/data
cache_dir: $var_dir/cache
etc_dir: /etc/mailman3
ext_dir: $var_dir/ext
messages_dir: $var_dir/messages
archive_dir: $var_dir/archives
template_dir: $var_dir/templates
pid_file: /run/mailman3/master.pid
lock_file: $lock_dir/master.lck


[database]
class: mailman.database.sqlite.SQLiteDatabase
url: sqlite:///$DATA_DIR/mailman.db
debug: no


[logging.debian]
format: %(asctime)s (%(process)d) %(message)s
datefmt: %b %d %H:%M:%S %Y
propagate: no
level: info
path: mailman.log


[webservice]
hostname: localhost
port: 8001
use_https: no
show_tracebacks: yes
api_version: 3.1
admin_user: restadmin
admin_pass: restpass


[mta]
# Incoming mail arrives from Postfix over LMTP.
incoming: mailman.mta.postfix.LMTP
# Outgoing mail (posts, confirmations, welcomes) goes back to Postfix.
outgoing: mailman.mta.deliver.deliver
smtp_host: localhost
smtp_port: 25
smtp_user:
smtp_pass:

# LMTP listener.  Use 127.0.0.1, not localhost: Postfix resolves the LMTP
# host in transport_maps through DNS only.
lmtp_host: 127.0.0.1
lmtp_port: 8024

# Postfix-specific settings (postmap_command, transport_file_type).
configuration: python:mailman.config.postfix

# Friendly confirmations: the confirmation cookie is encoded in the From:
# address (reading-group-confirm+<cookie>@local.edu) and a plain reply to it
# confirms the subscription/unsubscription.
verp_confirmations: yes
verp_confirm_format: $address+$cookie
verp_confirm_regexp: ^(.*<)?(?P<addr>[^+]+?)\+(?P<cookie>[^@]+)@.*$
verp_delivery_interval: 0
verp_probes: no


[archiver.mail_archive]
# No archiver plugin is installed here; keep archiving from failing posts.
enable: no
EOF
