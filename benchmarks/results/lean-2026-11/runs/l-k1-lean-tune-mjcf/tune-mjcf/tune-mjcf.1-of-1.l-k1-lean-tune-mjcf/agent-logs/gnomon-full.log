import mujoco, numpy as np, time
FP = mujoco.mjtState.mjSTATE_FULLPHYSICS
T = 2.0
def simulate(m, seed, dt=None):
    dt = dt or m.opt.timestep
    d = mujoco.MjData(m)
    n = int(T/dt)
    rng = np.random.default_rng(seed)
    d.qpos += rng.normal(0,0.01,size=d.qpos.shape)
    mujoco.mj_forward(m,d)
    for _ in range(n): mujoco.mj_step(m,d)
    s = np.zeros(mujoco.mj_stateSize(m,FP)); mujoco.mj_getState(m,d,s,FP)
    return s
ref = mujoco.MjModel.from_xml_path("model_ref.xml")
SEEDS = list(range(1,41))
t0=time.perf_counter(); refs = {s: simulate(ref,s) for s in SEEDS}; tref=time.perf_counter()-t0
print(f"ref: {tref/len(SEEDS)*1e3:.1f} ms/run")
def report(m, label):
    # worst-case over seeds, and per-seed timing
    t0=time.perf_counter()
    worst=0; fails=0
    for s in SEEDS:
        st = simulate(m,s)
        if not np.all(np.isfinite(st)): fails+=1; continue
        if not np.allclose(st, refs[s], atol=1e-5):
            d = np.max(np.abs(st-refs[s])); fails+=1
            worst=max(worst,d)
        else:
            worst=max(worst,np.max(np.abs(st-refs[s])))
    pt=(time.perf_counter()-t0)/len(SEEDS)
    print(f"{label:48s} pct={pt/tref*100:5.1f}% worst={worst:.2e} fails={fails}/{len(SEEDS)}")
    return pt/tref

cfgs = {}
for sol,name in ((mujoco.mjtSolver.mjSOL_PGS,'PGS'),(mujoco.mjtSolver.mjSOL_CG,'CG'),(mujoco.mjtSolver.mjSOL_NEWTON,'NEWTON')):
    for it in (100,30,10,3):
        for tol in (1e-8,1e-6):
            cfgs[f"solver={name},it={it},tol={tol}"] = dict(solver=sol, iterations=it, tolerance=tol)
for key,kw in cfgs.items():
    m = mujoco.MjModel.from_xml_path("model_ref.xml")
    for k,v in kw.items(): setattr(m.opt,k,v)
    report(m,key)
