import mujoco, numpy as np, time
xml = open('model_ref.xml').read()
def build(ts):
    return mujoco.MjModel.from_xml_string(xml.replace('<size memory="2M"/>', f'<option timestep="{ts}"/><size memory="2M"/>'))
FULL = mujoco.mjtState.mjSTATE_FULLPHYSICS
def final(m, seed=12345):
    d = mujoco.MjData(m)
    rng = np.random.default_rng(seed)
    d.qpos += rng.normal(0,0.01,size=d.qpos.shape)
    mujoco.mj_forward(m,d)
    n = int(2.0/m.opt.timestep)
    for _ in range(n): mujoco.mj_step(m,d)
    s = np.zeros(mujoco.mj_stateSize(m,FULL)); mujoco.mj_getState(m,d,s,FULL)
    return s
ref = build(0.002)
s0 = final(ref)
for ts in [0.001,0.0005]:
    m = build(ts); s=final(m)
    print(ts, 'diff', np.linalg.norm(s-s0), 'maxabs', np.abs(s-s0).max())
print('state mag', np.abs(s0).max(), np.linalg.norm(s0))
print('qvel max', np.abs(s0[157:157+118]).max())
