import mujoco as mj, numpy as np, time
def b(fn,n=2000):
    for _ in range(200): fn()
    t=time.perf_counter()
    for _ in range(n): fn()
    return (time.perf_counter()-t)/n*1e6
def chain(n, joints='ball', geoms=True):
    bodies=''
    for i in range(n):
        g='<geom type="capsule" size=".005" fromto="0 0 0 .02 0 0" condim="1"/>' if geoms else ''
        j=f'<joint type="{joints}" damping=".015"/>' if i>0 else ''
        bodies+=f'<body pos="0.02 0 0">{j}{g}</body>'
    return f'<mujoco><compiler autolimits="true"/><worldbody><body pos="0 0 .6">{bodies}</body></worldbody></mujoco>'
for n in (10, 20, 41, 80):
    m=mj.MjModel.from_xml_string(chain(n)); d=mj.MjData(m); mj.mj_forward(m,d)
    print(f'n={n:3d} nv={m.nv:4d} nM={m.nM:6d} nefc={d.nefc} pos={b(lambda: mj.mj_fwdPosition(m,d)):7.1f} kin={b(lambda: mj.mj_kinematics(m,d)):5.1f} col={b(lambda: mj.mj_collision(m,d)):5.1f} crb={b(lambda: mj.mj_crb(m,d)):5.1f} fM={b(lambda: mj.mj_factorM(m,d)):6.1f} step={b(lambda: mj.mj_step(m,d),600):7.1f}')
