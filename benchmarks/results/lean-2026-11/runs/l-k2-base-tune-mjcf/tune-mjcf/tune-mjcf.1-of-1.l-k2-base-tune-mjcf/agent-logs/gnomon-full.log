import mujoco as mj, numpy as np, time, re
REF=open('model_ref.xml').read()
def b(fn,n=1500):
    for _ in range(200): fn()
    t=time.perf_counter()
    for _ in range(n): fn()
    return (time.perf_counter()-t)/n*1e6
def prof(label, xml):
    try: m=mj.MjModel.from_xml_string(xml)
    except Exception as e: print(label,'FAIL',e); return
    d=mj.MjData(m); mj.mj_forward(m,d)
    print(f'{label:30s} nv={m.nv:4d} nefc={d.nefc} ncon={d.ncon} pos={b(lambda: mj.mj_fwdPosition(m,d)):6.1f} kin={b(lambda: mj.mj_kinematics(m,d)):5.1f} col={b(lambda: mj.mj_collision(m,d)):5.1f} step={b(lambda: mj.mj_step(m,d),800):6.1f}')
prof('REF', REF)
# plain chain of 41 capsules with ball joints
bodies=''.join(f'<body pos="0.02 0 0"><joint type="ball" damping=".015"/><geom type="capsule" size=".005" fromto="0 0 0 .02 0 0" condim="1"/></body>' for _ in range(41))
prof('chain41 capsule ball', f'<mujoco><compiler autolimits="true"/><worldbody><body pos="0 0 .6">{bodies}</body></worldbody></mujoco>')
# chain with hinge joints
bodies=''.join(f'<body pos="0.02 0 0"><joint type="hinge" axis="0 0 1" damping=".015"/><geom type="capsule" size=".005" fromto="0 0 0 .02 0 0" condim="1"/></body>' for _ in range(41))
prof('chain41 capsule hinge', f'<mujoco><compiler autolimits="true"/><worldbody><body pos="0 0 .6">{bodies}</body></worldbody></mujoco>')
# chain41 freejoint bodies isolated (no joints between)
bodies=''.join(f'<body pos="0.02 {0.03*i} 0"><freejoint/><geom type="capsule" size=".005"/></body>' for i in range(41))
prof('41 free bodies', f'<mujoco><compiler autolimits="true"/><worldbody>{bodies}</worldbody></mujoco>')
