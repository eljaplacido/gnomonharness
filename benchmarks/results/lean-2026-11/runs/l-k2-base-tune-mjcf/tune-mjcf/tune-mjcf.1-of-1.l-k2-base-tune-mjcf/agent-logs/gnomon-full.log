import mujoco, numpy as np, time
REF=open('model_ref.xml').read()
def build(mod):
    return mujoco.MjModel.from_xml_string(mod)
def bench(m, n=None):
    if n is None: n=int(2.0/m.opt.timestep)
    d=mujoco.MjData(m)
    d.qpos += np.random.default_rng(1).normal(0,0.01,size=d.qpos.shape)
    mujoco.mj_forward(m,d)
    for _ in range(50): mujoco.mj_step(m,d)
    mujoco.mj_resetData(m,d); d.qpos += np.random.default_rng(1).normal(0,0.01,size=d.qpos.shape); mujoco.mj_forward(m,d)
    t=time.perf_counter()
    for _ in range(n): mujoco.mj_step(m,d)
    return time.perf_counter()-t
base = bench(build(REF))
print('base', base)
variants = {
 'dt .004': '<option timestep=".004"/>',
 'sparse jac': '<option jacobian="sparse"/>',
 'CG solver': '<option solver="CG"/>',
 'it=10': '<option iterations="10"/>',
 'noslip0/implicit': '<option integrator="implicitfast"/>',
 'cone pyramid': '<option cone="pyramid"/>',
}
for name,opt in variants.items():
    xml = REF.replace('<size memory="2M"/>', opt+'<size memory="2M"/>')
    try:
        t = bench(build(xml))
        print(f'{name:20s} {t:.4f} ratio {t/base:.3f}')
    except Exception as e:
        print(name,'FAIL',e)
