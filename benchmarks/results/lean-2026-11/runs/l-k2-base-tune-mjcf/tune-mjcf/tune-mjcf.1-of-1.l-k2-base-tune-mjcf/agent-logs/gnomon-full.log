import mujoco as mj, numpy as np
REF=open('model_ref.xml').read()
FULL=mj.mjtState.mjSTATE_FULLPHYSICS
def final(model, seed, pert=0.0):
    d=mj.MjData(model); rng=np.random.default_rng(seed)
    p=rng.normal(0,0.01,size=d.qpos.shape)
    if pert: p = p + np.random.default_rng(999).normal(0,pert,size=p.shape)
    d.qpos += p
    mj.mj_forward(model,d)
    for _ in range(int(2.0/model.opt.timestep)): mj.mj_step(model,d)
    s=np.zeros(mj.mj_stateSize(model,FULL)); mj.mj_getState(model,d,s,FULL); return s
mr=mj.MjModel.from_xml_string(REF)
base=final(mr,7)
for pert in [1e-6,1e-8,1e-10,1e-12]:
    print(f'perturb {pert:g} -> final maxdiff {np.abs(final(mr,7,pert)-base).max():.3e}')
