import mujoco as mj, numpy as np, time
REF=open('model_ref.xml').read()
def bench(fn,n=1000):
    for _ in range(100): fn()
    t=time.perf_counter()
    for _ in range(n): fn()
    return (time.perf_counter()-t)/n*1e6
def stages(m):
    d=mj.MjData(m); mj.mj_forward(m,d)
    print(f'  nefc={d.nefc} ncon={d.ncon} nv={m.nv}')
    for name,fn in [('step',lambda: mj.mj_step(m,d)),('position',lambda: mj.mj_fwdPosition(m,d)),
                    ('velocity',lambda: mj.mj_fwdVelocity(m,d)),('actuation',lambda: mj.mj_fwdActuation(m,d)),
                    ('acceleration',lambda: mj.mj_fwdAcceleration(m,d)),('constraint',lambda: mj.mj_fwdConstraint(m,d)),
                    ('Euler',lambda: mj.mj_Euler(m,d)),('factorM',lambda: mj.mj_factorM(m,d)),
                    ('solveM',lambda: mj.mj_solveM(m,d,np.zeros((1,d.nefc)),d.efc_force))]:
        try: print(f'  {name:14s} {bench(fn):8.1f} us')
        except Exception as e: print(f'  {name}: ERR {e}')
print('REF:'); stages(mj.MjModel.from_xml_string(REF))
