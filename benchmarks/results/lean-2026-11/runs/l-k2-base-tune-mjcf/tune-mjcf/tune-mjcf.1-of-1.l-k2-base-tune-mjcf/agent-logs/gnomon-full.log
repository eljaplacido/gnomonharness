import mujoco as mj, numpy as np, time
REF=open('model_ref.xml').read()
def b(fn,n=1200):
    for _ in range(200): fn()
    t=time.perf_counter()
    for _ in range(n): fn()
    return (time.perf_counter()-t)/n*1e6
def prof(label, xml):
    m=mj.MjModel.from_xml_string(xml); d=mj.MjData(m); mj.mj_forward(m,d)
    print(f'{label:26s} jac={m.opt.jacobian} slv={m.opt.solver} nM={m.nM} nC={m.nC} nefc={d.nefc} '
          f'step={b(lambda: mj.mj_step(m,d),600):6.1f} pos={b(lambda: mj.mj_fwdPosition(m,d)):5.1f} '
          f'con={b(lambda: mj.mj_fwdConstraint(m,d)):6.1f} eul={b(lambda: mj.mj_Euler(m,d)):5.1f} fM={b(lambda: mj.mj_factorM(m,d)):5.1f} '
          f'isl={b(lambda: mj.mj_island(m,d)):5.1f} mc={b(lambda: mj.mj_makeConstraint(m,d)):5.1f}', flush=True)
prof('REF', REF)
for o in ['jacobian="dense"','solver="CG"','jacobian="dense" solver="CG"','jacobian="sparse" solver="CG"',
          'iterations="1"','jacobian="dense" iterations="1"','solver="PGS"','jacobian="dense" solver="PGS"']:
    prof(o, REF.replace('<size memory="2M"/>',f'<option {o}/><size memory="2M"/>'))
