[24.142944, "o", "import pandas as pd\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> products = pd.read_csv(\"/app/products.csv\")\r\n\u001b[?2004l\r\u001b[?2004h> orders = pd.read_csv(\r\n\u001b[?2004l\r\u001b[?2004h>   \"/app/orders.csv\", \r\n\u001b[?2004l\r\u001b[?2004h>   parse_dates=[\"order_date\"]\r\n\u001b[?2004l\r\u001b[?2004h> )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> con = duckdb.connect()\r\n\u001b[?2004l\r\u001b[?2004h> "]
