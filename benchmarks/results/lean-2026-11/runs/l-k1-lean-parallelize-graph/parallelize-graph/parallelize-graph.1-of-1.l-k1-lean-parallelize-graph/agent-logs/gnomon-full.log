[approval] bash: cd /app && python3 - <<'EOF'
lines=open('test').read().split('\n')
lines=[l for l in lines if l.strip()]
k=len(lines[0].split('\t')[0])
rows=[]
for l in lines:
    f=l.split('\t')
    rows.append((f[0],f[1][0],f[1][1]))
print("lines",len(rows),"k",k)
km={}
for s,le,re_ in rows:
    km.setdefault(s,(le,re_))
print("unique kmers",len(km))
L=set(c for s,le,re_ in rows for c in (le,re_))
print("ext chars",L)
# in/out degree over unique kmers
succ={}
pred={}
for s,le,re_ in rows:
    succ.setdefault(s,set()); pred.setdefault(s,set())
for s,(le,re_) in km.items():
    if re_!='F':
        v=s[1:]+re_
        if v in km: succ[s].add(v); pred[v].add(s)
print("edges", sum(len(v) for v in succ.values()))
print("no out", sum(1 for s in km if not succ[s]))
print("no in", sum(1 for s in km if not pred[s]))
print("isolated", sum(1 for s in km if not succ[s] and not pred[s]))
print("indeg>1", sum(1 for s in km if len(pred[s])>1))
print("outdeg>1", sum(1 for s in km if len(succ[s])>1))
# count components / paths
seen=set(); ncontig=0; lens=[]
for s in km:
    if not pred[s] and s not in seen:
        ncontig+=1; L2=0; v=s
        while True:
            seen.add(v); L2+=1
            v2=None
            if len(succ[v])==1:
                v2=list(succ[v])[0]
                if len(pred[v2])!=1 or v2 in seen: v2=None
            if v2 is None: break
            v=v2
        lens.append(L2)
print("linear seeds contigs",ncontig,"lens",sorted(lens,reverse=True)[:10])
unv=[s for s in km if s not in seen]
print("unvisited after phase1",len(unv))
