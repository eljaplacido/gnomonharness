[26.87897, "o", "    \"primary_role\": \"admin\"       # If '\"'\"'roles'\"'\"' is empty, this must be null (JSON null, not \"null\")\r\n\u001b[?2004l\r"]
[26.879002, "o", "\u001b[?2004h> "]
[26.879047, "o", "  },\r\n\u001b[?2004l\r\u001b[?2004h>   ...\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.879092, "o", "]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
