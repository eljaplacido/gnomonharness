[26.870933, "o", "\u001b[?2004h>    - Extract '\"'\"'username'\"'\"'.\r\n\u001b[?2004l\r\u001b[?2004h>    - Extract '\"'\"'email'\"'\"'.\r\n\u001b[?2004l\r\u001b[?2004h> "]
