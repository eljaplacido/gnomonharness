[26.875458, "o", "   - The '\"'\"'args'\"'\"' list should contain complete jq arguments, with both flags and their values (if any)\r\n\u001b[?2004l\r"]
[26.875481, "o", "\u001b[?2004h> "]
[26.875548, "o", "   - Each argument should be a separate string in the list\r\n\u001b[?2004l\r"]
