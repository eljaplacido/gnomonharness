src=open('serial.c').read()
start=src.index('/* A node is "interior"')
end=src.index('int\nmain(')
new = r'''/* A node is "interior" when it is strictly inside a maximal non-branching
 * path: exactly one predecessor, and that predecessor has exactly one
 * successor.  This uses only the local edges of the node and of its unique
 * predecessor, so any thread can evaluate it independently and get the same
 * answer. */
static int
interior(int i)
{
    return indeg[i] == 1 && pred1[i] >= 0 && outdeg[pred1[i]] == 1;
}

/* Decide which nodes start a contig.  A node starts a contig when it is not
 * interior, plus one designated node per cycle (the cycle is cut at its
 * lowest-numbered node).  The cycle cut is what keeps a cycle from being
 * reported once per node -- and it is a property of the graph, not of the
 * order in which nodes are visited, so serial and parallel agree.
 *
 * Runs in O(N): each node is walked over at most once.
 */
static void
mark_starts(unsigned char *is_start)
{
    unsigned char *state = calloc((size_t)N, 1);   /* 0 new, 1 on path, 2 done */
    int *path = malloc((size_t)N * sizeof(int));
    int *pos  = malloc((size_t)N * sizeof(int));
    if (!state || !path || !pos) die("out of memory");

    for (int i = 0; i < N; i++)
        is_start[i] = (unsigned char)(!interior(i));

    for (int i = 0; i < N; i++) {
        if (state[i]) continue;
        int np = 0, cur = i;
        while (cur >= 0 && state[cur] == 0) {
            state[cur] = 1;
            pos[cur]  = np;
            path[np++] = cur;
            cur = (outdeg[cur] == 1) ? succ1[cur] : -1;
        }
        if (cur >= 0 && state[cur] == 1) {
            /* p[pos[cur] .. np-1] is a cycle: cut it at its minimum node. */
            int c0 = pos[cur], m = path[c0];
            for (int j = c0 + 1; j < np; j++)
                if (path[j] < m) m = path[j];
            is_start[m] = 1;
        }
        for (int j = 0; j < np; j++) state[path[j]] = 2;
    }

    free(state); free(path); free(pos);
}

/* Emit the contig that starts at `start`: extend while the next node is
 * interior and is not itself the start of another contig. */
static int
walk(int start, unsigned char *is_start, char *contig)
{
    int len = 0;
    for (int i = 0; i < K; i++) contig[len++] = keys[(size_t)start * K + i];

    int cur = start;
    for (int steps = 0; steps < N && outdeg[cur] == 1; steps++) {
        int s = succ1[cur];
        if (s < 0 || s == start || is_start[s] || !interior(s)) break;
        contig[len++] = keys[(size_t)s * K + K - 1];
        cur = s;
    }
    contig[len] = '\0';
    return len;
}

static void
traverse(FILE *out)
{
    char *contig = malloc((size_t)N + (size_t)K + 2);
    unsigned char *is_start = malloc((size_t)N);
    if (!contig || !is_start) die("out of memory");

    mark_starts(is_start);

    long ncontigs = 0, bases = 0;
    for (int i = 0; i < N; i++) {
        if (!is_start[i]) continue;
        int len = walk(i, is_start, contig);
        fputs(contig, out);
        fputc('\n', out);
        ncontigs++;
        bases += len;
    }

    fprintf(stderr, "serial: %ld contigs, %ld bases\n", ncontigs, bases);
    free(contig);
    free(is_start);
}

'''
