new = r'''/* A node is "interior" when it is strictly inside a maximal non-branching
 * path: exactly one predecessor and that predecessor has exactly one
 * successor.  The test uses only the local edges of the node and of its
 * unique predecessor, so every thread can evaluate it independently, in any
 * order, and get the same answer.  Contig starts are exactly the nodes that
 * fail it; that makes the decomposition a function of the graph and not of
 * the visiting order. */
static int
interior(int i)
{
    return indeg[i] == 1 && pred1[i] >= 0 && outdeg[pred1[i]] == 1;
}

/* 1 if following successors from i comes back to i. */
static int
on_cycle(int i)
{
    int cur = i;
    for (int steps = 0; steps < N && outdeg[cur] == 1; steps++) {
        cur = succ1[cur];
        if (cur < 0) return 0;
        if (cur == i) return 1;
    }
    return 0;
}

/* Lowest-numbered node of the cycle through i (i must be on a cycle). */
static int
cycle_min(int i)
{
    int m = i, cur = i;
    for (int steps = 0; steps < N && outdeg[cur] == 1; steps++) {
        cur = succ1[cur];
        if (cur < 0 || cur == i) break;
        if (cur < m) m = cur;
    }
    return m;
}

static void
put_contig(FILE *out, const char *s, long *pncontigs, long *pbases)
{
    fputs(s, out);
    fputc('\n', out);
    (*pncontigs)++;
    *pbases += (long)strlen(s);
}

/* One maximal non-branching path, starting at a node that is not interior. */
static void
emit_path(int start, FILE *out, char *contig, long *pncontigs, long *pbases)
{
    int len = 0;
    for (int i = 0; i < K; i++) contig[len++] = keys[(size_t)start * K + i];

    int cur = start;
    for (int steps = 0; steps < N && outdeg[cur] == 1; steps++) {
        int s = succ1[cur];
        if (s < 0 || s == start || !interior(s)) break;
        contig[len++] = keys[(size_t)s * K + K - 1];
        cur = s;
    }
    contig[len] = '\0';
    put_contig(out, contig, pncontigs, pbases);
}

/* A cycle, emitted once, starting from its lowest-numbered node so that the
 * resulting contig does not depend on which node was reached first. */
static void
emit_cycle(int start, FILE *out, char *contig, long *pncontigs, long *pbases)
{
    int len = 0;
    for (int i = 0; i < K; i++) contig[len++] = keys[(size_t)start * K + i];

    int cur = start;
    for (int steps = 0; steps < N && outdeg[cur] == 1; steps++) {
        int s = succ1[cur];
        if (s < 0 || s == start) break;
        contig[len++] = keys[(size_t)s * K + K - 1];
        cur = s;
    }
    contig[len] = '\0';
    put_contig(out, contig, pncontigs, pbases);
}

static void
traverse(FILE *out)
{
    char *contig = malloc((size_t)N + (size_t)K + 2);
    if (!contig) die("out of memory");

    long ncontigs = 0, bases = 0;

    /* maximal non-branching paths */
    for (int i = 0; i < N; i++)
        if (!interior(i))
            emit_path(i, out, contig, &ncontigs, &bases);

    /* cycles: only from their lowest-numbered node */
    for (int i = 0; i < N; i++) {
        if (!interior(i) || !on_cycle(i)) continue;
        if (cycle_min(i) == i)
            emit_cycle(i, out, contig, &ncontigs, &bases);
    }

    fprintf(stderr, "serial: %ld contigs, %ld bases\n", ncontigs, bases);
    free(contig);
}

'''
