[7.423055, "o", "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mtest_parallel_executable_exists\u001b[39;49;00m():\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"Check that the parallel UPC executable was compiled successfully.\"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        pgen_path = Path(\u001b[33m\"\u001b[39;49;00m\u001b[33m/app/pgen\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n>       \u001b[94massert\u001b[39;49;00m pgen_path.exists(), \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mParallel executable \u001b[39;49;00m\u001b[33m{\u001b[39;49;00mpgen_path\u001b[33m}\u001b[39;49;00m\u001b[33m does not exist\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n\u001b[1m\u001b[31mE       AssertionError: Parallel executable /app/pgen does not exist\u001b[0m\r\n\u001b[1m\u001b[31mE       assert False\u001b[0m\r\n\u001b[1m\u001b[31mE        +  where False = exists()\u001b[0m\r\n\u001b[1m\u001b[31mE        +    where exists = PosixPath('/app/pgen').exists\u001b[0m\r\n\r\n\u001b[1m\u001b[31m/tests/test_outputs.py\u001b[0m:23: AssertionError\r\n"]
[7.423125, "o", "\u001b[31m\u001b[1m_____________________________________________________________________ test_makefile_exists _____________________________________________________________________\u001b[0m\r\n\r\n"]
[7.423429, "o", "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mtest_makefile_exists\u001b[39;49;00m():\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"Check that a Makefile was created for compilation.\"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        makefile_path = Path(\u001b[33m\"\u001b[39;49;00m\u001b[33m/app/Makefile\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n>       \u001b[94massert\u001b[39;49;00m makefile_path.exists(), \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mMakefile \u001b[39;49;00m\u001b[33m{\u001b[39;49;00mmakefile_path\u001b[33m}\u001b[39;49;00m\u001b[33m does not exist\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n\u001b[1m\u001b[31mE       AssertionError: Makefile /app/Makefile does not exist\u001b[0m\r\n\u001b[1m\u001b[31mE       assert False\u001b[0m\r\n\u001b[1m\u001b[31mE        +  where False = exists()\u001b[0m\r\n\u001b[1m\u001b[31mE        +    where exists = PosixPath('/app/Makefile').exists\u001b[0m\r\n\r\n\u001b[1m\u001b[31m/tests/test_outputs.py\u001b[0m:32: AssertionError\r\n\u001b[31m\u001b[1m_________________________________________________________________ test_parallel_output_exists __________________________________________________________________\u001b[0m\r\n\r\n"]
[7.423631, "o", "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mtest_parallel_output_exists\u001b[39;49;00m():\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"Check that parallel version produced output files starting with pgen.\u001b[39;49;00m\r\n    \u001b[33m\u001b[39;49;00m\r\n    \u001b[33m    Output files should end with .out (e.g., pgen_0.out, pgen_1.out).\u001b[39;49;00m\r\n    \u001b[33m    \"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        \u001b[90m# Check for individual pgen_*.out files\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        pgen_files = \u001b[96mlist\u001b[39;49;00m(Path(\u001b[33m\"\u001b[39;49;00m\u001b[33m/app\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m).glob(\u001b[33m\"\u001b[39;49;00m\u001b[33mpgen*.out\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m))\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n>       \u001b[94massert\u001b[39;49;00m \u001b[96mlen\u001b[39;49;00m(pgen_files) > \u001b[94m0\u001b[39;49;00m, (\u001b[90m\u001b[39;49;00m\r\n            \u001b[33m\"\u001b[39;49;00m\u001b[33mNo parallel output files found matching pattern pgen*.out\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        )\u001b[90m\u001b[39;49;00m\r\n\u001b[1m\u001b[31mE       AssertionError: No parallel output files found matching pattern pgen*.out\u001b[0m\r\n\u001b[1m\u001b[31mE       assert 0 > 0\u001b[0m\r\n\u001b[1m\u001b[31mE        +  where 0 = len([])\u001b[0m\r\n\r\n\u001b[1m\u001b[31m/tests/test_outputs.py\u001b[0m:53: AssertionError\r\n\u001b[31m\u001b[1m______________________________________________________________ test_outputs_are_contigs_not_kmers ______________________________________________________________\u001b[0m\r\n\r\n"]
[7.424674, "o", "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mtest_outputs_are_contigs_not_kmers\u001b[39;49;00m():\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"Check that outputs are actual contigs, not just input k-mers.\u001b[39;49;00m\r\n    \u001b[33m\u001b[39;49;00m\r\n    \u001b[33m    Contigs should be extended sequences longer than k-mers.\u001b[39;49;00m\r\n    \u001b[33m    \"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        \u001b[90m# Load the test input to get k-mer length\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        test_file = Path(\u001b[33m\"\u001b[39;49;00m\u001b[33m/app/test\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n        kmer_length = \u001b[94mNone\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        \u001b[94mif\u001b[39;49;00m test_file.exists():\u001b[90m\u001b[39;49;00m\r\n            \u001b[94mwith\u001b[39;49;00m \u001b[96mopen\u001b[39;49;00m(test_file, \u001b[33m\"\u001b[39;49;00m\u001b[33mr\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m) \u001b[94mas\u001b[39;49;00m f:\u001b[90m\u001b[39;49;00m\r\n                first_line = f.readline().strip()\u001b[90m\u001b[39;49;00m\r\n                \u001b[94mif\u001b[39;49;00m first_line:\u001b[90m\u001b[39;49;00m\r\n                    kmer = first_line.split(\u001b[33m\"\u001b[39;49;00m\u001b[33m\\t\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)[\u001b[94m0\u001b[39;49;00m]\u001b[90m\u001b[39;49;00m\r\n                    kmer_length = \u001b[96mlen\u001b[39;49;00m(kmer)\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[94massert\u001b[39;49;00m kmer_length \u001b[95mis\u001b[39;49;00m \u001b[95mnot\u001b[39;49;00m \u001b[94mNone\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33mCould not determine k-mer length from test file\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[90m# Check serial output\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        serial_out = Path(\u001b[33m\"\u001b[39;49;00m\u001b[33m/app/serial.out\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n        \u001b[94mif\u001b[39;49;00m serial_out.exists():\u001b[90m\u001b[39;49;00m\r\n            content = serial_out.read_text()\u001b[90m\u001b[39;49;00m\r\n            lines = [line.strip() \u001b[94mfor\u001b[39;49;00m line \u001b[95min\u001b[39;49;00m content.strip().split(\u001b[33m\"\u001b[39;49;00m\u001b[33m\\n\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m) \u001b[94mif\u001b[39;49;00m line.strip()]\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n            \u001b[90m# Contigs should be longer than k-mers (except possibly very short ones)\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n            long_contigs = [line \u001b[94mfor\u001b[39;49;00m line \u001b[95min\u001b[39;49;00m lines \u001b[94mif\u001b[39;49;00m \u001b[96mlen\u001b[39;49;00m(line) > kmer_length]\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n            \u001b[94massert\u001b[39;49;00m \u001b[96mlen\u001b[39;49;00m(long_contigs) > \u001b[94m0\u001b[39;49;00m, (\u001b[90m\u001b[39;49;00m\r\n                \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mNo contigs longer than k-mer length (\u001b[39;49;00m\u001b[33m{\u001b[39;49;00mkmer_length\u001b[33m}\u001b[39;49;00m\u001b[33m) found. \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n                \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mOutput appears to contain k-mers instead of assembled contigs.\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n            )\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n            \u001b[90m# Most contigs should be significantly longer than k-mers\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n            avg_length = \u001b[96msum\u001b[39;49;00m(\u001b[96mlen\u001b[39;49;00m(line) \u001b[94mfor\u001b[39;49;00m line \u001b[95min\u001b[39;49;00m lines) / \u001b[96mlen\u001b[39;49;00m(lines) \u001b[94mif\u001b[39;49;00m lines \u001b[94melse\u001b[39;49;00m \u001b[94m0\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n>           \u001b[94massert\u001b[39;49;00m avg_length > kmer_length * \u001b[94m2\u001b[39;49;00m, (\u001b[90m\u001b[39;49;00m\r\n                \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mAverage contig length (\u001b[39;49;00m\u001b[33m{\u001b[39;49;00mavg_length\u001b[33m:\u001b[39;49;00m\u001b[33m.1f\u001b[39;49;00m\u001b[33m}\u001b[39;49;00m\u001b[33m) is too short. \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n                \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mExpected contigs to be much longer than k-mers (\u001b[39;49;00m\u001b[33m{\u001b[39;49;00mkmer_length\u001b[33m}\u001b[39;49;00m\u001b[33m).\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n            )\u001b[90m\u001b[39;49;00m\r\n\u001b[1m\u001b[31mE           AssertionError: Average contig length (19.3) is too short. Expected contigs to be much longer than k-mers (19).\u001b[0m\r\n\u001b[1m\u001b[31mE           assert 19.333866880085367 > (19 * 2)\u001b[0m\r\n\r\n\u001b[1m\u001b[31m/tests/test_outputs.py\u001b[0m:140: AssertionError\r\n\u001b[31m\u001b[1m_________________________________________________________________ test_contig_count_reasonable ________________"]
