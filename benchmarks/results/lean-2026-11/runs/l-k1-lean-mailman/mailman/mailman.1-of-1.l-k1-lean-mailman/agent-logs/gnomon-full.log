[approval] bash: cat > /tmp/test_full2.py <<'PY'
import mailbox, os, sys
sys.path.insert(0, '/app')
import eval as E

def members():
    m = E.get_mlist()
    return sorted(a.email for a in m.members.addresses)

def wait_mbox(u):
    def _():
        assert os.path.exists(f'/var/mail/{u}')
    E.retry(_)

def has_msg(u, subject, from_prefix=None):
    box = mailbox.mbox(f'/var/mail/{u}')
    for m in box:
        if m.get('Subject', '').find(subject) >= 0:
            if from_prefix is None or m.get('From', '').startswith(from_prefix):
                return True
    return False

a = os.urandom(8).hex(); b = os.urandom(8).hex()
E.add_user(a); E.add_user(b)
print('users', a, b, flush=True)

# --- join flow for both users ---
for u in (a, b):
    E.send_email(body='', subject='', from_addr=f'{u}@local.edu', to_addr=E.JOIN_LIST)
    wait_mbox(u)
    E.retry(lambda u=u: E.confirm_last_reply(u, 'join'), retries=8)
    E.retry(lambda u=u: (f'{u}@local.edu' in members()) or (_ for _ in ()).throw(AssertionError(members())), retries=8)
    print('joined', u, flush=True)

# --- announcement reaches every subscriber ---
E.send_email(body='Hello readers', subject='Reading Group Announcement',
             from_addr=f'{a}@local.edu', to_addr=E.MAILING_LIST)
for u in (a, b):
    E.retry(lambda u=u: has_msg(u, 'Reading Group Announcement') or (_ for _ in ()).throw(AssertionError(u)), retries=8)
print('announcement delivered to both', flush=True)

# --- leave flow for b ---
E.send_email(body='', subject='', from_addr=f'{b}@local.edu', to_addr=E.LEAVE_LIST)
E.retry(lambda: E.confirm_last_reply(b, 'leave'), retries=8)
E.retry(lambda: (f'{b}@local.edu' not in members()) or (_ for _ in ()).throw(AssertionError(members())), retries=8)
print('left', b, 'members now:', members(), flush=True)
print('ALL OK', flush=True)
