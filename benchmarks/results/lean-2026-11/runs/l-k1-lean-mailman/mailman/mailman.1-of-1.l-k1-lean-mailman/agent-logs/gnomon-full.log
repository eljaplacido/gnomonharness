cat > /etc/mailman3/mailman.cfg <<'EOF'
# GNU Mailman 3 configuration for the reading-group mailing list.
#
# Postfix accepts mail for the local.edu domain and routes the mailing list
# addresses (reading-group@, reading-group-join@, reading-group-leave@,
# reading-group-confirm@, ...) to Mailman over LMTP at 127.0.0.1:8024.
# Mailman sends its outgoing mail back to Postfix on localhost:25, which does
# the final local delivery into /var/mail/<username>.

[mailman]
# The address of the human responsible for this Mailman installation.
site_owner: root@local.edu

# Local part used in the From field when no natural reply address exists.
noreply_address: noreply

# The default language for this server.
default_language: en

# Mail command processor will ignore mail command lines after this max.
email_commands_max_lines: 10

# Default length of time a pending request is live before it is evicted.
pending_request_life: 3d

# How long should files be saved before they are evicted from the cache?
cache_life: 7d

# Headers checked to determine the envelope sender of a message.
sender_headers: from from_ reply-to sender

# Which paths.* file system layout to use.
layout: debian

# Can MIME filtered messages be preserved by list owners?
filtered_messages_are_preservable: no

# Command used to convert text/html parts to text/plain.
html_to_plain_text_command: /usr/bin/lynx -dump $filename

# Characters allowed in list names.
listname_chars: [-_.0-9a-z]


[shell]
prompt: >>>
banner: Welcome to the GNU Mailman shell
use_ipython: no
history_file:


[paths.debian]
# The root of the directory structure Mailman uses for run-time data.
var_dir: /var/lib/mailman3
queue_dir: $var_dir/queue
bin_dir: /usr/lib/mailman3/bin
list_data_dir: $var_dir/lists
log_dir: /var/log/mailman3
lock_dir: $var_dir/locks
data_dir: $var_dir/data
cache_dir: $var_dir/cache
etc_dir: /etc/mailman3
ext_dir: $var_dir/ext
messages_dir: $var_dir/messages
archive_dir: $var_dir/archives
template_dir: $var_dir/templates
pid_file: /run/mailman3/master.pid
lock_file: $lock_dir/master.lck


[database]
class: mailman.database.sqlite.SQLiteDatabase
url: sqlite:///$DATA_DIR/mailman.db
debug: no


[logging.debian]
format: %(asctime)s (%(process)d) %(message)s
datefmt: %b %d %H:%M:%S %Y
propagate: no
level: info
path: mailman.log


[webservice]
hostname: localhost
port: 8001
use_https: no
show_tracebacks: yes
api_version: 3.1
admin_user: restadmin
admin_pass: HtjrFZfKuq+XKKF6748Ay9BISs+63E8zkTuDVPKo35GibShq


[mta]
# Mailman receives mail from Postfix over LMTP and delivers to Postfix over
# SMTP, which is then responsible for local delivery.
incoming: mailman.mta.postfix.LMTP
outgoing: mailman.mta.deliver.deliver
smtp_host: localhost
smtp_port: 25
smtp_user:
smtp_pass:
smtp_secure_mode: smtp
lmtp_host: 127.0.0.1
lmtp_port: 8024
configuration: python:mailman.config.postfix
EOF
