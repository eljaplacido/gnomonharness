[approval] bash: cat > /usr/local/sbin/setup_reading_group.py <<'EOF'
#!/usr/bin/python3
"""Create and configure the reading-group@local.edu list."""
from mailman.core.initialize import initialize
from mailman.interfaces.action import Action
from mailman.interfaces.domain import IDomainManager
from mailman.interfaces.listmanager import IListManager
from mailman.interfaces.mailinglist import ArchivePolicy, SubscriptionPolicy
from zope.component import getUtility

initialize('/etc/mailman3/mailman.cfg')

FQDN = 'reading-group@local.edu'
DOMAIN = 'local.edu'

domain_manager = getUtility(IDomainManager)
if domain_manager.get(DOMAIN) is None:
    domain_manager.add(DOMAIN)

list_manager = getUtility(IListManager)
mlist = list_manager.get(FQDN)
if mlist is None:
    mlist = list_manager.create(FQDN)

mlist.display_name = 'Reading Group'
# Nobody has to approve a join request; the user still confirms by replying.
mlist.subscription_policy = SubscriptionPolicy.open
# Leaving requires the user to confirm by replying.
mlist.unsubscription_policy = SubscriptionPolicy.confirm
# Announcements are not held for moderator approval.
mlist.default_member_action = Action.accept
mlist.default_nonmember_action = Action.accept
mlist.archive_policy = ArchivePolicy.never
mlist.admin_immed_notify = False

print('list:', mlist.fqdn_listname)
print('subscription_policy:', mlist.subscription_policy)
print('unsubscription_policy:', mlist.unsubscription_policy)
EOF
