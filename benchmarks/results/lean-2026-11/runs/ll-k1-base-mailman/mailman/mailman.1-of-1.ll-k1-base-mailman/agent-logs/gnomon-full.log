from mailman.core.initialize import initialize
from mailman.interfaces.domain import IDomainManager
from mailman.interfaces.listmanager import IListManager
from mailman.interfaces.mailinglist import SubscriptionPolicy
from mailman.database.transaction import transaction
from zope.component import getUtility

initialize('/etc/mailman3/mailman.cfg')

with transaction():
    # Add the domain first
    domain_manager = getUtility(IDomainManager)
    domain_manager.add('local.edu')
    print(f'Domain added: local.edu')

    # Create the mailing list
    list_manager = getUtility(IListManager)
    mlist = list_manager.create('reading-group@local.edu')
    print(f'List created: {mlist.list_name}@{mlist.mail_host}')

    # Set subscription policy to open (no approval needed)
    mlist.subscription_policy = SubscriptionPolicy.open
    print(f'Subscription policy: {mlist.subscription_policy}')

    # Set preferred language
    mlist._preferred_language = 'en'
    print(f'Preferred language: {mlist.preferred_language}')

print('Done creating list')
