[approval] bash: cd /app && cat >> upc_shim.h <<'EOF'

/* Run `body` once per UPC thread on its own pthread, after reserving the shared
 * heap.  Thread-count and heap options are read from the command line with the
 * same spelling upcrun uses (-n, -shared-heap).  Returns body's exit status of
 * thread 0. */
int upc_shim_run(int argc, char **argv, int (*body)(int, char **));
EOF
python3 - <<'PY'
p='upc_shim.c'
s=open(p).read()
s=s.replace('#include <errno.h>','#include <errno.h>\n#include <ctype.h>')
s += '''
/* ---------------------------------------------------------------- launcher */
typedef struct {
    int (*body)(int, char **);
    int argc;
    char **argv;
} shim_job_t;

static shim_job_t g_job;

static void *shim_thread_main(void *arg)
{
    long t = (long) arg;
    upc_shim_set_thread((int) t);
    /* every thread runs the same body; the collective allocations inside it are
     * matched because all threads call them in the same order */
    g_job.body(g_job.argc, g_job.argv);
    return NULL;
}

/* Accepts "-n N", "-nN", "-shared-heap SIZE" the way upcrun does, and leaves
 * every other argument for the program. */
static void shim_parse(int argc, char **argv, int *nthreads, size_t *heap)
{
    int i;
    for (i = 1; i < argc; i++) {
        const char *a = argv[i];
        if (!strcmp(a, "-n") && i + 1 < argc) {
            *nthreads = atoi(argv[++i]);
        } else if (!strncmp(a, "-n", 2) && isdigit((unsigned char) a[2])) {
            *nthreads = atoi(a + 2);
        } else if (!strcmp(a, "-shared-heap") && i + 1 < argc) {
            const char *hs = argv[++i];
            char *endp = NULL;
            double v = strtod(hs, &endp);
            if (endp && (*endp == 'M' || *endp == 'm')) v *= 1024.0 * 1024.0;
            else if (endp && (*endp == 'G' || *endp == 'g')) v *= 1024.0 * 1024.0 * 1024.0;
            else if (endp && (*endp == 'K' || *endp == 'k')) v *= 1024.0;
            if (v > 0.0) *heap = (size_t) v;
        } else if (!strcmp(a, "-shared-heap") || !strcmp(a, "-n")) {
            if (i + 1 < argc) i++;
        }
    }
}

int upc_shim_run(int argc, char **argv, int (*body)(int, char **))
{
    int nthreads = 1, i;
    size_t heap = (size_t) 256 << 20;
    pthread_t *tids;
    const char *env;

    env = getenv("UPC_NTHREADS");
    if (env) nthreads = atoi(env);
    env = getenv("UPC_SHARED_HEAP");
    if (env) { char *e = NULL; double v = strtod(env, &e);
               if (e && (*e == 'M' || *e == 'm')) v *= 1024.0 * 1024.0;
               if (v > 0) heap = (size_t) v; }

    shim_parse(argc, argv, &nthreads, &heap);
    if (nthreads < 1) nthreads = 1;

    upc_shim_init(nthreads, heap);

    g_job.body = body;
    g_job.argc = argc;
    g_job.argv = argv;

    tids = (pthread_t *) calloc((size_t) nthreads, sizeof(pthread_t));
    if (!tids) shim_die("cannot allocate the thread table");

    for (i = 1; i < nthreads; i++) {   /* thread 0 is this thread */
        if (pthread_create(&tids[i], NULL, shim_thread_main, (void *) (long) i) != 0)
            shim_die("cannot create a UPC thread");
    }
    {
        upc_shim_set_thread(0);
        body(argc, argv);
    }
    for (i = 1; i < nthreads; i++) pthread_join(tids[i], NULL);
    free(tids);

    return EXIT_SUCCESS;
}
'''
open(p,'w').write(s)
