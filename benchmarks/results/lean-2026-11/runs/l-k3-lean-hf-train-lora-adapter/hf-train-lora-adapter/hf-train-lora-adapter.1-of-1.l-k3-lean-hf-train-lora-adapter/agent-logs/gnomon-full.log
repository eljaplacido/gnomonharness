import time, sys, json, torch
n=int(sys.argv[1]); torch.set_num_threads(n)
from transformers import AutoModelForCausalLM, AutoTokenizer
from peft import LoraConfig, get_peft_model
import train_lora as T
tok=AutoTokenizer.from_pretrained('openai-community/gpt2'); tok.pad_token=tok.eos_token
tr=json.load(open('data/train.json'))
aids={l:tok(f" {l}",add_special_tokens=False)["input_ids"][0] for l in "ABCD"}
ds=T.MCQDataset(tr,tok,aids); coll=T.make_collate(tok.pad_token_id)
from torch.utils.data import DataLoader
dl=DataLoader(ds,batch_size=8,shuffle=False,collate_fn=coll)
m=AutoModelForCausalLM.from_pretrained('openai-community/gpt2')
m=get_peft_model(m,LoraConfig(r=8,lora_alpha=16,target_modules=['c_attn'],task_type='CAUSAL_LM'))
m.train(); opt=torch.optim.AdamW([p for p in m.parameters() if p.requires_grad],lr=1e-3)
it=iter(dl); next(it)
bs=[b for _,b in zip(range(5),it)]
t=time.time()
for b in bs:
    m(**b).loss.backward(); opt.step(); opt.zero_grad()
d=time.time()-t
print(f"threads={n} {d/len(bs):.2f}s/batch  -> {d/len(bs)*38/60:.1f} min/epoch")
EOF
