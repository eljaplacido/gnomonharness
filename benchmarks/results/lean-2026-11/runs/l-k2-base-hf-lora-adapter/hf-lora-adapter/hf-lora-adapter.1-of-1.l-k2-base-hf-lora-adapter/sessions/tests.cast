[10.571936, "o", "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mvalidate_repo_id\u001b[39;49;00m(repo_id: \u001b[96mstr\u001b[39;49;00m) -> \u001b[94mNone\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"Validate `repo_id` is valid.\u001b[39;49;00m\r\n    \u001b[33m\u001b[39;49;00m\r\n"]
[10.571955, "o", "    \u001b[33m    This is not meant to replace the proper validation made on the Hub but rather to\u001b[39;49;00m\r\n    \u001b[33m    avoid local inconsistencies whenever possible (example: passing `repo_type` in the\u001b[39;49;00m\r\n    \u001b[33m    `repo_id` is forbidden).\u001b[39;49;00m\r\n    \u001b[33m\u001b[39;49;00m\r\n    \u001b[33m    Rules:\u001b[39;49;00m\r\n"]
[10.571974, "o", "    \u001b[33m    - Between 1 and 96 characters.\u001b[39;49;00m\r\n    \u001b[33m    - Either \"repo_name\" or \"namespace/repo_name\"\u001b[39;49;00m\r\n    \u001b[33m    - [a-zA-Z0-9] or \"-\", \"_\", \".\"\u001b[39;49;00m\r\n    \u001b[33m    - \"--\" and \"..\" are forbidden\u001b[39;49;00m\r\n    \u001b[33m\u001b[39;49;00m\r\n    \u001b[33m    Valid: `\"foo\"`, `\"foo/bar\"`, `\"123\"`, `\"Foo-BAR_foo.bar123\"`\u001b[39;49;00m\r\n    \u001b[33m\u001b[39;49;00m\r\n    \u001b[33m    Not valid: `\"datasets/foo/bar\"`, `\".repo_id\"`, `\"foo--bar\"`, `\"foo.git\"`\u001b[39;49;00m\r\n    \u001b[33m\u001b[39;49;00m\r\n    \u001b[33m    Example:\u001b[39;49;00m\r\n    \u001b[33m    ```py\u001b[39;49;00m\r\n"]
[10.572036, "o", "    \u001b[33m    >>> from huggingface_hub.utils import validate_repo_id\u001b[39;49;00m\r\n    \u001b[33m    >>> validate_repo_id(repo_id=\"valid_repo_id\")\u001b[39;49;00m\r\n    \u001b[33m    >>> validate_repo_id(repo_id=\"other..repo..id\")\u001b[39;49;00m\r\n"]
[10.572076, "o", "    \u001b[33m    huggingface_hub.utils._validators.HFValidationError: Cannot have -- or .. in repo_id: 'other..repo..id'.\u001b[39;49;00m\r\n    \u001b[33m    ```\u001b[39;49;00m\r\n    \u001b[33m\u001b[39;49;00m\r\n    \u001b[33m    Discussed in https://github.com/huggingface/huggingface_hub/issues/1008.\u001b[39;49;00m\r\n    \u001b[33m    In moon-landing (internal repository):\u001b[39;49;00m\r\n    \u001b[33m    - https://github.com/huggingface/moon-landing/blob/main/server/lib/Names.ts#L27\u001b[39;49;00m\r\n    \u001b[33m    - https://github.com/huggingface/moon-landing/blob/main/server/views/components/NewRepoForm/NewRepoForm.svelte#L138\u001b[39;49;00m\r\n    \u001b[33m    \"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        \u001b[94mif\u001b[39;49;00m \u001b[95mnot\u001b[39;49;00m \u001b[96misinstance\u001b[39;49;00m(repo_id, \u001b[96mstr\u001b[39;49;00m):\u001b[90m\u001b[39;49;00m\r\n            \u001b[90m# Typically, a Path is not a repo_id\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n            \u001b[94mraise\u001b[39;49;00m HFValidationError(\u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mRepo id must be a string, not \u001b[39;49;00m\u001b[33m{\u001b[39;49;00m\u001b[96mtype\u001b[39;49;00m(repo_id)\u001b[33m}\u001b["]
[10.572087, "o", "39;49;00m\u001b[33m: \u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33m{\u001b[39;49;00mrepo_id\u001b[33m}\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33m.\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[94mif\u001b[39;49;00m repo_id.count(\u001b[33m\"\u001b[39;49;00m\u001b[33m/\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m) > \u001b[94m1\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\r\n>           \u001b[94mraise\u001b[39;49;00m HFValidationError(\u001b[90m\u001b[39;49;00m\r\n                \u001b[33m\"\u001b[39;49;00m\u001b[33mRepo id must be in the form \u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33mrepo_name\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33m or \u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33mnamespace/repo_name\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33m:\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n                \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m \u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33m{\u001b[39;49;00mrepo_id\u001b[33m}\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33m. Use `repo_type` argument if needed.\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n            )\u001b[90m\u001b[39;49;00m\r\n\u001b[1m\u001b[31mE           huggingface_hub.errors.HFValidationError: Repo id must be in the form 'repo_name' or '"]
