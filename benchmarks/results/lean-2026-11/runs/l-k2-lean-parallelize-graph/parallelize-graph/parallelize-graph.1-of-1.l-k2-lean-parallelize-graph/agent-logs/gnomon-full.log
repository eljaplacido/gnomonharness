new='''/* Every thread executes the same sequence of collective allocations, so the
 * k-th call of a thread returns the k-th region.  Only thread 0 creates it;
 * the others wait for it, which is what makes it collective. */
void *upc_shim_alloc(size_t nelem, size_t elemsz)
{
	static __thread int call_idx;
	int idx = call_idx++;

	if (idx >= MAX_REGIONS) {
		fprintf(stderr, "upc_shim: too many shared allocations\\n");
		exit(1);
	}
	pthread_mutex_lock(&alloc_mu);
	if (upc_shim_mythread == 0) {
		void *p = calloc(nelem ? nelem : 1, elemsz);

		if (!p) {
			fprintf(stderr, "upc_shim: out of memory\\n");
			exit(1);
		}
		regions[idx].base = p;
		regions[idx].elemsz = elemsz;
		regions[idx].nelem = nelem;
		regions[idx].block = nelem ? (nelem + THREADS - 1) / THREADS : 1;
		if (idx + 1 > nregions)
			nregions = idx + 1;
		pthread_cond_broadcast(&alloc_cv);
	} else {
		while (idx >= nregions)
			pthread_cond_wait(&alloc_cv, &alloc_mu);
		if (regions[idx].elemsz != elemsz ||
		    regions[idx].nelem != nelem) {
			fprintf(stderr, "upc_shim: collective allocation mismatch\\n");
			exit(1);
		}
	}
	pthread_mutex_unlock(&alloc_mu);
	return regions[idx].base;
}

'''
s=s.replace(old,new)
open('upc_shim/upc_shim.c','w').write(s)
