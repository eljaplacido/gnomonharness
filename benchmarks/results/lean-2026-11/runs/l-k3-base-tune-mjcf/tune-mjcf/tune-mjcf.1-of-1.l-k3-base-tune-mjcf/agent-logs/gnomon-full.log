import mujoco, numpy as np, time
total=2.0
def state_of(m, d):
    fs = mujoco.mjtState.mjSTATE_FULLPHYSICS
    s = np.zeros(mujoco.mj_stateSize(m, fs)); mujoco.mj_getState(m,d,s,fs); return s
def simulate(m, seed, keep=False):
    d = mujoco.MjData(m)
    rng = np.random.default_rng(seed)
    d.qpos += rng.normal(0,0.01,size=d.qpos.shape)
    mujoco.mj_forward(m,d)
    n = int(total/m.opt.timestep)
    for _ in range(n): mujoco.mj_step(m,d)
    return state_of(m,d), d
def cfg(path, **opt):
    m = mujoco.MjModel.from_xml_path(path)
    for k,v in opt.items(): setattr(m.opt,k,v)
    return m
def check(mref, mtest, seeds):
    worst=0.0; nfail=0
    for s in seeds:
        a,_ = simulate(mref,s); b,d = simulate(mtest,s)
        diff=float(np.abs(a-b).max())
        ok = bool(np.allclose(a,b,atol=1e-5)) and not np.isnan(b).any() and not np.isinf(b).any()
        worst=max(worst,diff); nfail += (not ok)
        print("  seed %-5d maxdiff=%.3e %s" % (s,diff,"OK" if ok else "FAIL"))
    print("  worst=%.3e fails=%d" % (worst,nfail))
    return worst, nfail
def timing(m, n_runs=10):
    ts=[]
    for i in range(n_runs):
        t0=time.perf_counter(); simulate(m, 1000+i); ts.append(time.perf_counter()-t0)
    return float(np.mean(ts))
