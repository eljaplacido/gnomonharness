import sys; sys.path.insert(0,"/tmp/w")
from harness import *
import mujoco, numpy as np, time
mref = cfg("model_ref.xml")
refs = {s: simulate(mref,s)[0] for s in range(5)}
tr = timing(mref, 8)
print("ref %.4f s = %.1f us/step" % (tr, tr/1000*1e6))
def ev(lab, **kw):
    m = cfg("model_ref.xml", **kw)
    tt = timing(m, 8)
    worst=0.0
    for s in range(5):
        b = simulate(m,s)[0]
        worst=max(worst, float(np.abs(refs[s]-b).max()))
    # count solver sweeps on a fresh single step
    d = mujoco.MjData(m); mujoco.mj_forward(m,d)
    for _ in range(5): mujoco.mj_step(m,d)
    print("%-30s %.1f us/step ratio=%.3f worst=%.2e niter=%d" % (lab, tt/1000*1e6, tt/tr, worst, d.solver_niter[0]))
ev("Newton (ref opts)")
for tol in [1e-8,1e-10,1e-12,0.0]:
    ev("PGS tol=%g"%tol, solver=0, iterations=1000, tolerance=tol)
for tol in [1e-8,1e-10,1e-12]:
    ev("CG tol=%g"%tol, solver=1, iterations=1000, tolerance=tol)
EOF
