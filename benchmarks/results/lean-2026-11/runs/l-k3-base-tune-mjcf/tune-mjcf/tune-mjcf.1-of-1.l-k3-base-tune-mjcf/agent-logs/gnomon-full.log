[approval] bash: cd /app && cat > /tmp/w/one_step.py <<'EOF'
import mujoco, numpy as np
def mk(**opt):
    m = mujoco.MjModel.from_xml_path("model_ref.xml")
    for k,v in opt.items(): setattr(m.opt,k,v)
    return m
def step_once(m, seed, nsteps):
    d = mujoco.MjData(m)
    rng = np.random.default_rng(seed)
    d.qpos += rng.normal(0,0.01,size=d.qpos.shape)
    mujoco.mj_forward(m,d)
    for _ in range(nsteps): mujoco.mj_step(m,d)
    return d.qacc.copy(), d.qvel.copy(), d.qpos.copy(), d.efc_force.copy()
mN = mk(solver=2)
cands = [("PGS it=10",dict(solver=0,iterations=10)),("PGS it=100",dict(solver=0,iterations=100)),
         ("PGS it=1000",dict(solver=0,iterations=1000)),("CG it=100",dict(solver=1,iterations=100)),
         ("Newton tol1e-6",dict(solver=2,tolerance=1e-6))]
for n in [1,10,100]:
    a = step_once(mN, 3, n)
    print("nsteps",n)
    for lab,kw in cands:
        b = step_once(mk(**kw), 3, n)
        print("   %-16s dqacc=%.2e dqvel=%.2e dqpos=%.2e deforce=%.2e" % (lab,
            np.abs(a[0]-b[0]).max(), np.abs(a[1]-b[1]).max(), np.abs(a[2]-b[2]).max(), np.abs(a[3]-b[3]).max()))
EOF
