import time, mujoco
base = open("model_ref.xml").read()
def mk(solver, eq=True):
    xml = base.replace('<compiler autolimits="true"/>','<option solver="%s"/><compiler autolimits="true"/>'%solver)
    if not eq: xml = xml.replace('<equality>','<equality><!--').replace('</equality>','--></equality>')
    open("/tmp/w/t.xml","w").write(xml)
    m = mujoco.MjModel.from_xml_path("/tmp/w/t.xml"); return m
def bench(fn,m,d,n=600):
    fn(m,d)
    t0=time.perf_counter()
    for _ in range(n): fn(m,d)
    return (time.perf_counter()-t0)/n*1e6
for solver in ["Newton","CG","PGS"]:
    for eq in [True, False]:
        m=mk(solver,eq); d=mujoco.MjData(m); mujoco.mj_forward(m,d)
        for _ in range(60): mujoco.mj_step(m,d)
        print("solver=%-7s eq=%-5s nefc=%2d step=%7.1f  fwdPos=%5.1f fwdConstr=%6.1f factorM=%5.1f Euler=%5.1f niter=%d" % (
            solver, eq, d.nefc, bench(mujoco.mj_step,m,d), bench(mujoco.mj_fwdPosition,m,d),
            bench(mujoco.mj_fwdConstraint,m,d), bench(mujoco.mj_factorM,m,d), bench(mujoco.mj_Euler,m,d), d.solver_niter[0]))
EOF
