import time, mujoco
from mujoco import mjtDisableBit as D
def bench(path="model_ref.xml", setup=None, n=900, lab=""):
    m = mujoco.MjModel.from_xml_path(path); d = mujoco.MjData(m)
    if setup: setup(m)
    mujoco.mj_forward(m,d)
    for _ in range(60): mujoco.mj_step(m,d)
    t0=time.perf_counter()
    for _ in range(n): mujoco.mj_step(m,d)
    dt=(time.perf_counter()-t0)/n*1e6
    print("%-30s %7.1f us  nefc=%d" % (lab, dt, d.nefc)); return dt
bench(lab="baseline")
for nm in ["mjDSBL_EULERDAMP","mjDSBL_WARMSTART","mjDSBL_REFSAFE","mjDSBL_SENSOR","mjDSBL_MIDPHASE","mjDSBL_SPRING"]:
    if not hasattr(D,nm): print("skip",nm); continue
    def s(m,nm=nm): m.opt.disableflags |= getattr(D,nm).value
    bench(setup=s, lab="disable "+nm)
EOF
