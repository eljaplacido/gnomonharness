cat > /usr/local/sbin/start-mail-stack.sh <<'EOF'
#!/bin/sh
# Bring up the local mail stack: Postfix (MTA) + GNU Mailman 3 (LMTP + runners).
# Idempotent: safe to run when either is already up.
set -e

# Postfix: transport/local_recipient maps generated by Mailman.
if ! postfix status >/dev/null 2>&1; then
    postfix start
else
    postfix reload
fi

# Mailman: regenerate the Postfix transport maps, then start master/runners.
su list -s /bin/sh -c '/usr/bin/mailman -C /etc/mailman3/mailman.cfg aliases' 2>/dev/null || true
if su list -s /bin/sh -c '/usr/bin/mailman -C /etc/mailman3/mailman.cfg status' 2>/dev/null \
        | grep -q running; then
    su list -s /bin/sh -c '/usr/bin/mailman -C /etc/mailman3/mailman.cfg restart'
else
    su list -s /bin/sh -c '/usr/bin/mailman -C /etc/mailman3/mailman.cfg start'
fi
EOF
