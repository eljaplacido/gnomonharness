mlist.unsubscription_policy = SubscriptionPolicy.confirm
# Posts from members (and non-members) go straight through, no moderation.
mlist.default_member_action = Action.accept
mlist.default_nonmember_action = Action.accept
print('list created:', mlist.fqdn_listname, mlist.subscription_policy,
      mlist.unsubscription_policy, mlist.default_member_action,
      mlist.default_nonmember_action)
EOF
