import mailbox, os, smtplib, subprocess
from email.mime.text import MIMEText
from time import sleep

DOMAIN = "local.edu"
LIST = "reading-group@local.edu"
JOIN = "reading-group-join@local.edu"
LEAVE = "reading-group-leave@local.edu"


def add_user(u):
    subprocess.run(["useradd", u], check=True, capture_output=True)


def send(body, subject, from_addr, to_addr):
    m = MIMEText(body)
    m["Subject"] = subject
    m["From"] = from_addr
    m["To"] = to_addr
    with smtplib.SMTP("localhost", 25) as s:
        s.send_message(m)


def msgs(u):
    return list(mailbox.mbox(f"/var/mail/{u}"))


def confirm(u, word):
    for _ in range(20):
        cands = [m for m in msgs(u)
                 if (m.get("From") or "").startswith("reading-group-confirm")
                 and word in (m.get("Subject") or "")]
        if cands:
            send("", "", f"{u}@{DOMAIN}", cands[-1].get("From"))
            return
        sleep(1)
    raise AssertionError(f"no {word} confirmation for {u}: "
                         f"{[m.get('Subject') for m in msgs(u)]}")


def is_member(email):
    from mailman.core.initialize import initialize
    from mailman.interfaces.listmanager import IListManager
    from zope.component import getUtility
    initialize("/etc/mailman3/mailman.cfg")
    mlist = getUtility(IListManager).get(LIST)
    return mlist.members.get_member(email) is not None


u1 = os.urandom(6).hex()
u2 = os.urandom(6).hex()
for u in (u1, u2):
    add_user(u)

# join both users
for u in (u1, u2):
    send("", "", f"{u}@{DOMAIN}", JOIN)
    confirm(u, "join")
sleep(3)
assert is_member(f"{u1}@{DOMAIN}") and is_member(f"{u2}@{DOMAIN}"), "join failed"
print(f"join ok: {u1}, {u2}")

# post an announcement as u1
subject = f"Reading Group Announcement {os.urandom(4).hex()}"
send("We meet on Thursday.", subject, f"{u1}@{DOMAIN}", LIST)
found = False
for _ in range(20):
    if any((m.get("Subject") or "").strip() == subject for m in msgs(u2)):
        found = True
        break
    sleep(1)
assert found, f"announcement not delivered to {u2}: {[m.get('Subject') for m in msgs(u2)]}"
print(f"announcement delivered to {u2}")

# u2 leaves (with confirmation)
send("", "", f"{u2}@{DOMAIN}", LEAVE)
confirm(u2, "leave")
for _ in range(20):
    if not is_member(f"{u2}@{DOMAIN}"):
        break
    sleep(1)
assert not is_member(f"{u2}@{DOMAIN}"), "leave failed"
assert is_member(f"{u1}@{DOMAIN}"), "u1 lost membership"
print(f"leave ok: {u2} removed, {u1} still a member")
EOF
