import time, torch
from transformers import AutoModelForCausalLM
from peft import LoraConfig, TaskType, get_peft_model
import torch.nn.functional as F
torch.set_num_threads(8)
base=AutoModelForCausalLM.from_pretrained('openai-community/gpt2')
m=get_peft_model(base,LoraConfig(r=8,lora_alpha=16,target_modules=['c_attn'],task_type=TaskType.CAUSAL_LM))
b=m.get_base_model()
ids=torch.randint(0,1000,(8,120)); mask=torch.ones_like(ids)
def step():
    hs=b.transformer(input_ids=ids, attention_mask=mask).last_hidden_state
    last=hs[torch.arange(8), mask.sum(1)-1]
    logits=b.lm_head(last)
    loss=F.cross_entropy(logits, torch.randint(0,50257,(8,)))
    loss.backward()
step(); t=time.time()
for _ in range(3): step()
print('custom bs8 step', round((time.time()-t)/3,3))
