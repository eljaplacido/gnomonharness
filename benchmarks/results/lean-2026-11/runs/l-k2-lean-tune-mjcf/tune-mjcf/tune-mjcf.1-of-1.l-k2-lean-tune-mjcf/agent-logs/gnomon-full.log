import mujoco, numpy as np, time, itertools
REF="model_ref.xml"
FP=mujoco.mjtState.mjSTATE_FULLPHYSICS

def load(opt):
    m=mujoco.MjModel.from_xml_path(REF)
    for k,v in opt.items():
        setattr(m.opt,k,v)
    return m

def sim(m,seed,total=2.0):
    d=mujoco.MjData(m)
    rng=np.random.default_rng(seed)
    d.qpos+=rng.normal(0,0.01,size=d.qpos.shape)
    mujoco.mj_forward(m,d)
    n=int(total/m.opt.timestep)
    for _ in range(n): mujoco.mj_step(m,d)
    st=np.zeros(mujoco.mj_stateSize(m,FP)); mujoco.mj_getState(m,d,st,FP)
    return st

mref=load({})
