// Minimal structural YAML sanity check: indentation must be even-spaced,
// no tabs, no duplicate top-level keys, every `uses:` must have a version.
import { readFileSync } from 'node:fs';
import { readdirSync } from 'node:fs';
const dir = '/app/my_website/.github/workflows';
let bad = 0;
for (const f of readdirSync(dir)) {
  const text = readFileSync(`${dir}/${f}`, 'utf8');
  const lines = text.split('\n');
  const problems = [];
  lines.forEach((l, i) => {
    if (l.includes('\t')) problems.push(`line ${i+1}: tab character`);
    const indent = l.length - l.trimStart().length;
    if (l.trim() && indent % 2 !== 0) problems.push(`line ${i+1}: odd indent ${indent}: ${l}`);
  });
  for (const [i, l] of lines.entries()) {
    const m = /^\s*uses:\s*(\S+)/.exec(l);
    if (m && !m[1].startsWith('./') && !m[1].includes('@')) problems.push(`line ${i+1}: unpinned uses ${m[1]}`);
  }
  // top-level keys must be flush-left
  const top = lines.filter(l => l.trim() && !l.startsWith(' ') && !l.startsWith('#') && !l.startsWith('-'));
  console.log(`${f}: ${problems.length ? 'PROBLEMS' : 'ok'}  top-level keys: ${top.map(t=>t.split(':')[0]).join(', ')}`);
  problems.forEach(p => console.log('   ' + p));
  bad += problems.length;
}
process.exit(bad ? 1 : 0);
EOF
