reading-group-owner@local.edu lmtp:unix:private/mailman3-lmtp
reading-group-request@local.edu lmtp:unix:private/mailman3-lmtp
reading-group-subscribe@local.edu lmtp:unix:private/mailman3-lmtp
reading-group-unsubscribe@local.edu lmtp:unix:private/mailman3-lmtp
EOF
postmap /etc/postfix/virtual_alias
