# reading-group-unsubscribe@local.edu -> LMTP to mailman
# reading-group-join@local.edu and reading-group-leave@local.edu also need to deliver to user mailboxes for confirmation replies

# Actually, let's think about this more carefully.
# The eval.py sends email to reading-group-join@local.edu and expects it to be processed by mailman.
# Mailman listens on LMTP port 8024 for incoming mail.
# Postfix needs to route list addresses to mailman's LMTP.

# For the join/leave flow:
# 1. User sends email to reading-group-join@local.edu
# 2. Postfix routes it to mailman's LMTP (port 8024)
# 3. Mailman sends a confirmation email to the user's mailbox
# 4. User replies to the confirmation email
# 5. Mailman processes the reply and adds the user

# For posting:
# 1. User sends email to reading-group@local.edu
# 2. Postfix routes it to mailman's LMTP
# 3. Mailman delivers to all subscribers

# Let's set up virtual_alias_maps to route list addresses to LMTP
cat > /etc/postfix/virtual_alias << 'EOF'
# Route reading-group list addresses to LMTP
reading-group@local.edu      lmtp:unix:private/mailman3-lmtp
reading-group-admin@local.edu lmtp:unix:private/mailman3-lmtp
reading-group-bounces@local.edu lmtp:unix:private/mailman3-lmtp
reading-group-confirm@local.edu lmtp:unix:private/mailman3-lmtp
reading-group-join@local.edu  lmtp:unix:private/mailman3-lmtp
