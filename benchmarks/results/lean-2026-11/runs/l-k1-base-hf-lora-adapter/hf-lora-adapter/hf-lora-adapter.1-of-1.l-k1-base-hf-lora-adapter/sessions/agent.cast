[17.295367, "o", "Expected output format in detection_results.json:\r\n\u001b[?2004l\r\u001b[?2004h"]
[17.295388, "o", "> ```json\r\n\u001b[?2004l\r\u001b[?2004h> [\r\n\u001b[?2004l\r"]
[17.295407, "o", "\u001b[?2004h>   {\r\n\u001b[?2004l\r"]
