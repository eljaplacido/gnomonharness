import json, torch

def load_split(path):
    with open(path) as f:
        return json.load(f)

def strip_prefix(option, letter):
    body = option.strip()
    for pre in (letter + ".", letter + ")", letter + ":", letter + " -", letter):
        if body.startswith(pre):
            rest = body[len(pre):]
            if pre == letter and not rest.startswith((".", ")")):
                continue
            return rest.strip()
    return body

def render(sample, template="Question: {q}\n{opts}\nAnswer:", opt_style=". "):
    opts = []
    for i, o in enumerate(sample["options"]):
        letter = "ABCD"[i]
        opts.append(f"{letter}{opt_style} {strip_prefix(o, letter)}")
    return template.format(q=sample["question"], opts="\n".join(opts))

@torch.no_grad()
def last_logits(model, input_ids, attention_mask):
    """Logits at the final real token of each row, without materialising the
    full [B, T, V] tensor."""
    out = model.transformer(input_ids=input_ids, attention_mask=attention_mask).last_hidden_state
    idx = attention_mask.sum(dim=1) - 1
    h = out[torch.arange(out.size(0)), idx]          # [B, H]
    return model.lm_head(h).float()                  # [B, V]

@torch.no_grad()
def predict(model, tok, samples, letter_ids, opt_style=". ", template="Question: {q}\n{opts}\nAnswer:", bs=16, return_logprobs=False):
    model.eval()
    pad = tok.pad_token_id if tok.pad_token_id is not None else tok.eos_token_id
    ids_l = [letter_ids[l] for l in "ABCD"]
    preds, all_lp = [], []
    for i in range(0, len(samples), bs):
        chunk = samples[i:i + bs]
        seqs = [tok(render(s, template, opt_style) + " " + "A")["input_ids"] for s in chunk]
        T = max(len(s) for s in seqs)
        input_ids = torch.full((len(seqs), T), pad, dtype=torch.long)
        attn = torch.zeros((len(seqs), T), dtype=torch.long)
        for r, s in enumerate(seqs):
            input_ids[r, :len(s)] = torch.tensor(s)
            attn[r, :len(s)] = 1
        logits = last_logits(model, input_ids, attn)
        logp = torch.log_softmax(logits, dim=-1)
        for r in range(len(chunk)):
            sc = [logp[r, lid].item() for lid in ids_l]
            all_lp.append(sc)
            preds.append("ABCD"[max(range(4), key=lambda k: sc[k])])
    return (preds, all_lp) if return_logprobs else preds

def accuracy(preds, samples):
    return sum(p == s["answer"] for p, s in zip(preds, samples)) / len(samples)
EOF
