import json, torch

def load_split(path):
    with open(path) as f:
        return json.load(f)

def render(sample, template, opt_style):
    q = sample["question"]
    opts = []
    for i, o in enumerate(sample["options"]):
        letter = "ABCD"[i]
        # strip an existing leading "A. " / "A) " / "A " prefix, then re-render
        body = o.strip()
        for pre in (letter + ".", letter + ")", letter + ":", letter + " -"):
            if body.startswith(pre):
                body = body[len(pre):].strip()
                break
        opts.append(f"{letter}{opt_style} {body}")
    opts_txt = "\n".join(opts)
    return template.format(q=q, opts=opts_txt)

TEMPLATES = [
    "Question: {q}\n{opts}\nAnswer:",
    "{q}\n{opts}\nAnswer:",
    "Question: {q}\nOptions:\n{opts}\nAnswer:",
    "Q: {q}\n{opts}\nA:",
]
OPT_STYLES = [". ", ") "]

@torch.no_grad()
def score_letters(model, tok, samples, prompt_ids_list, letters, bs=32):
    """Return list of predicted letters by comparing logprob of each letter token
    at the position right after the prompt."""
    preds = []
    letter_ids = [letters[l] for l in "ABCD"]
    order = list(range(len(prompt_ids_list)))
    model.eval()
    for i in range(0, len(order), bs):
        chunk = order[i:i + bs]
        seqs = [prompt_ids_list[j] + [letter_ids[0]] for j in chunk]
        maxlen = max(len(s) for s in seqs)
        pad = tok.pad_token_id if tok.pad_token_id is not None else tok.eos_token_id
        input_ids = torch.full((len(seqs), maxlen), pad, dtype=torch.long)
        attn = torch.zeros((len(seqs), maxlen), dtype=torch.long)
        for r, s in enumerate(seqs):
            input_ids[r, :len(s)] = torch.tensor(s)
            attn[r, :len(s)] = 1
        out = model(input_ids=input_ids, attention_mask=attn).logits
        for r, j in enumerate(chunk):
            pos = len(prompt_ids_list[j]) - 1
            logp = torch.log_softmax(out[r, pos].float(), dim=-1)
            scores = [logp[lid].item() for lid in letter_ids]
            preds.append("ABCD"[max(range(4), key=lambda k: scores[k])])
    return preds
