    e=[lit(x) for x in po[s].get('uni:hasEnrollmentDate',[])]
    g=[lit(x) for x in po[s].get('uni:hasGraduationDate',[])]
    return all(x<=T for x in e) and (not g or any(x>T for x in g))
cnt=defaultdict(list)
for s,p,o in tri:
    if p=='uni:isEnrolledIn' and cur(s): cnt[o].append(s)
for c in sorted(cnt): print(c, len(set(cnt[c])), sorted(set(cnt[c])))
