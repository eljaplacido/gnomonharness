helper = '''
def split_outside(text, seps):
    """Split text on any char in seps that is not inside a "..." literal."""
    out, buf, in_q, i = [], '', False, 0
    while i < len(text):
        c = text[i]
        if c == '"' and (i == 0 or text[i-1] != '\\\\'):
            in_q = not in_q
            buf += c
        elif not in_q and c in seps:
            out.append(buf); buf = ''
        else:
            buf += c
        i += 1
    out.append(buf)
    return [x.strip() for x in out if x.strip()]
'''

