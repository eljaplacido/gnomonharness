import re
from collections import defaultdict
TTL=open('university_graph.ttl').read()
TTL=re.sub(r'(?m)^@prefix[^\n]*\.','',TTL); TTL=re.sub(r'#[^\n]*','',TTL)
flat=' '.join(TTL.split())
def split_outside(text,seps):
    out,buf,in_q=[],'',False
    for i,c in enumerate(text):
        if c=='"' and (i==0 or text[i-1]!='\\'): in_q=not in_q; buf+=c
        elif not in_q and c in seps: out.append(buf); buf=''
        else: buf+=c
    out.append(buf); return [x.strip() for x in out if x.strip()]
tri=set()
for st in split_outside(flat,'.'):
    parts=split_outside(st,';'); subj,_,rest=parts[0].partition(' ')
    for ch in [rest]+parts[1:]:
        pred,_,objs=ch.partition(' ')
        for o in split_outside(objs,','):
            if pred: tri.add((subj,pred,o))
po=defaultdict(lambda: defaultdict(list))
for s,p,o in tri: po[s][p].append(o)
