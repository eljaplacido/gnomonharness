p='train_lora.py'
s=open(p).read()
start=s.index('@torch.no_grad()\ndef candidate_logprobs')
end=s.index('def predict(scores):')
new='''@torch.no_grad()
def candidate_logprobs(model, tokenizer, prompts, candidates, chunk=16):
    """Log-prob of each candidate continuation for each prompt.

    Every candidate is a single token (a space + the answer letter), so the
    score is the log-softmax of that token at the final prompt position.  One
    forward pass per chunk of prompts is enough -- no need to re-run the
    encoder once per candidate.

    Returns a list (one row per prompt) of lists (one score per candidate).
    """
    model.eval()
    device = next(model.parameters()).device
    pad_id = tokenizer.pad_token_id

    cand_ids = []
    for cand in candidates:
        ids = tokenizer(cand, add_special_tokens=False)["input_ids"]
        if len(ids) != 1:
            raise ValueError(f"candidate {cand!r} is not a single token: {ids}")
        cand_ids.append(ids[0])
    cand_tensor = torch.tensor(cand_ids, dtype=torch.long, device=device)

    encoded = [tokenizer(p, add_special_tokens=False)["input_ids"] for p in prompts]
    scores = []
    for start in range(0, len(encoded), chunk):
        batch = encoded[start:start + chunk]
        max_len = max(len(ids) for ids in batch)
        input_ids = torch.full((len(batch), max_len), pad_id, dtype=torch.long)
        attention = torch.zeros((len(batch), max_len), dtype=torch.long)
        last = []
        for i, ids in enumerate(batch):
            input_ids[i, : len(ids)] = torch.tensor(ids, dtype=torch.long)
            attention[i, : len(ids)] = 1
            last.append(len(ids) - 1)
        logits = model(
            input_ids=input_ids.to(device), attention_mask=attention.to(device)
        ).logits
        # logits at the last real (non-pad) position of every prompt
        rows = logits[torch.arange(len(batch)), torch.tensor(last)]
        log_probs = torch.log_softmax(rows.float(), dim=-1)
        scores.extend(log_probs[:, cand_tensor].cpu().tolist())
    return scores


'''
s=s[:start]+new+s[end:]
s=s.replace('def evaluate(model, tokenizer, samples, chunk=16):','def evaluate(model, tokenizer, samples, chunk=32):')
s=s.replace('candidate_logprobs(model, tokenizer, prompts, candidates, chunk=chunk)','candidate_logprobs(model, tokenizer, prompts, candidates, chunk=chunk)')
s=s.replace('parser.add_argument("--batch-size", type=int, default=8)','parser.add_argument("--batch-size", type=int, default=16)')
s=s.replace('parser.add_argument("--threads", type=int, default=0)','parser.add_argument("--threads", type=int, default=8)')
open(p,'w').write(s)
