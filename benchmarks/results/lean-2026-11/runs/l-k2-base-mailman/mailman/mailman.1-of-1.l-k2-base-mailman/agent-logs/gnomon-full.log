[approval] bash: cat > /usr/local/bin/start-mail-services.sh <<'EOF'
#!/bin/sh
# Bring up Postfix + Mailman3 for reading-group@local.edu.
# This container has no init system (PID 1 is `sleep infinity`), so the two
# daemons have to be started explicitly after a restart.
set -e

# Mailman generates the Postfix transport / alias maps, so start it first and
# give it a moment to write them.
if ! /usr/lib/mailman3/bin/mailman --run-as-root -C /etc/mailman3/mailman.cfg \
        status >/dev/null 2>&1; then
    /usr/lib/mailman3/bin/mailman --run-as-root -C /etc/mailman3/mailman.cfg start
