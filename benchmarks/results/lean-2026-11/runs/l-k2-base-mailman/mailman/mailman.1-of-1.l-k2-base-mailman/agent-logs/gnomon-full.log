import mailbox, os, smtplib, subprocess, sys
from email.mime.text import MIMEText
from time import sleep
from mailman.core.initialize import initialize
from mailman.interfaces.listmanager import IListManager
from zope.component import getUtility

D = "local.edu"
L = "reading-group@local.edu"
initialize("/etc/mailman3/mailman.cfg")
lm = getUtility(IListManager)

def send(frm, to, subj="", body=""):
    m = MIMEText(body); m["Subject"] = subj; m["From"] = frm; m["To"] = to
    with smtplib.SMTP("localhost", 25) as s: s.send_message(m)

def add_user(u):
    subprocess.run(["useradd", u], capture_output=True)

def confirm(u, kind):
    p = f"/var/mail/{u}"
    for _ in range(20):
        if os.path.exists(p):
            mb = mailbox.mbox(p)
            c = [m for m in mb if str(m.get("From","")).startswith("reading-group-confirm") and kind in str(m.get("Subject",""))]
            if c:
                send(f"{u}@{D}", c[-1].get("From"), "", "")
                return True
        sleep(1)
    return False

def member(u):
    return lm.get(L).members.get_member(f"{u}@{D}")

u = "e2e" + os.urandom(4).hex()
add_user(u)
send(f"{u}@{D}", f"reading-group-join@{D}")
print("join sent")
print("member before confirm:", member(u))
print("confirmed:", confirm(u, "join"))
sleep(2)
print("member after confirm:", member(u))

# announcement from another user
u2 = "e2e" + os.urandom(4).hex()
add_user(u2)
send(f"{u2}@{D}", L, "Announcement: reading group meets Friday", "We meet Friday at noon.")
ok = False
for _ in range(20):
    p = f"/var/mail/{u}"
    if os.path.exists(p):
        mb = mailbox.mbox(p)
        if any("Announcement: reading group" in str(m.get("Subject","")) for m in mb):
            ok = True; break
    sleep(1)
print("announcement delivered to subscriber:", ok)

# leave
send(f"{u}@{D}", f"reading-group-leave@{D}")
print("leave sent")
print("confirmed leave:", confirm(u, "leave"))
sleep(2)
print("member after leave:", member(u))
PY
