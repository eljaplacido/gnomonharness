import subprocess
src = '/app/polyglot/main.py.c'
exe = '/app/polyglot/cmain'

def fib(n):
    a, b = 0, 1
    for _ in range(n):
        a, b = b, a + b
    return a

for n in range(0, 251):
    want = str(fib(n))
    got_py = subprocess.check_output(['python3', src, str(n)], text=True).strip()
    got_c = subprocess.check_output([exe, str(n)], text=True).strip()
    if got_py != want or got_c != want:
        raise SystemExit(f'mismatch at {n}: want={want} py={got_py} c={got_c}')
for n in (500, 1000, 10000, 12345):
    want = str(fib(n))
    got_py = subprocess.check_output(['python3', src, str(n)], text=True).strip()
    got_c = subprocess.check_output([exe, str(n)], text=True).strip()
    if got_py != want or got_c != want:
        raise SystemExit(f'mismatch at {n}')
