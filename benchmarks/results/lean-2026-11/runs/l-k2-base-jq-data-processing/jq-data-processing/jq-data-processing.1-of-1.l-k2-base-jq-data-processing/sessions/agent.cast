[18.971579, "o", "   3. The input file '\"'\"'/app/users.json'\"'\"' is fixed and will be used as input\r\n\u001b[?2004l\r\u001b[?2004h> "]
[18.971646, "o", "   4. The output will be redirected to '\"'\"'/app/active_users_report.json'\"'\"'\r\n\u001b[?2004l\r"]
