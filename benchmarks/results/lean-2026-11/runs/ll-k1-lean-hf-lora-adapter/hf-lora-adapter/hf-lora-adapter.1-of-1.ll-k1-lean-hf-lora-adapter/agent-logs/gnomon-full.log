import json, torch
from transformers import AutoTokenizer, AutoModelForSequenceClassification

tok = AutoTokenizer.from_pretrained('/app/merged_model/')
model = AutoModelForSequenceClassification.from_pretrained('/app/merged_model/')
model.eval()

test_samples = [
    'Bonjour, comment allez-vous aujourd'hui?',
    'Hola, ¿cómo estás hoy?',
    'Guten Tag, wie geht es Ihnen?',
    'Ciao, come stai oggi?',
    'Olá, como você está?',
    'Привет, как дела?',
    'こんにちは、お元気ですか？',
    '你好，你好吗？',
    'مرحبا، كيف حالك؟',
    'Hello, how are you?',
]

with open('/app/detection_results.json') as f:
    saved = json.load(f)

with torch.no_grad():
    for i, text in enumerate(test_samples):
        inputs = tok(text, return_tensors='pt', truncation=True, max_length=512, padding=True)
        outputs = model(**inputs)
        pred = torch.argmax(outputs.logits, dim=-1).item()
        conf = torch.softmax(outputs.logits, dim=-1).max().item()
        s = saved[i]
        match = '✓' if pred == s['predicted_class_id'] else '✗'
        print(f'{match} {text[:40]:40s} -> class {pred} (conf={conf:.4f}) [saved: {s[\"predicted_class_id\"]}]')

print('Verification complete.')
