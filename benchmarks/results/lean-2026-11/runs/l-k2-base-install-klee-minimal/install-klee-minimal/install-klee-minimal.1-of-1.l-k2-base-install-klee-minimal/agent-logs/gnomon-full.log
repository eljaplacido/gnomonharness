# ---------------------------------------------------------------------------
# KLEE symbolic execution engine (built against LLVM 16, STP solver, no uClibc)
#
# Placed before the interactive-only guard below so that a non-interactive
# `source ~/.bashrc` (e.g. from a test harness) also picks the settings up.
# ---------------------------------------------------------------------------
if [ -z "${KLEE_ENV_LOADED:-}" ]; then
    export KLEE_ENV_LOADED=1

    # KLEE, kleaver, klee-stats, ktest-tool, stp and the LLVM 16 tools
    for _klee_dir in /usr/local/bin /usr/lib/llvm-16/bin; do
        case ":${PATH}:" in
            *":${_klee_dir}:"*) ;;
            *) PATH="${_klee_dir}:${PATH}" ;;
        esac
    done
    unset _klee_dir

    # KLEE headers (`#include <klee/klee.h>`), installed to /usr/local/include
    case ":${CPATH:-}:" in
        *":/usr/local/include:"*) ;;
        *) CPATH="/usr/local/include${CPATH:+:${CPATH}}" ;;
    esac

    # libstp / libminisat and the LLVM 16 shared libraries
    for _klee_dir in /usr/local/lib /usr/lib/llvm-16/lib; do
        case ":${LD_LIBRARY_PATH:-}:" in
            *":${_klee_dir}:"*) ;;
            *) LD_LIBRARY_PATH="${_klee_dir}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}" ;;
        esac
        case ":${LIBRARY_PATH:-}:" in
            *":${_klee_dir}:"*) ;;
            *) LIBRARY_PATH="${_klee_dir}${LIBRARY_PATH:+:${LIBRARY_PATH}}" ;;
        esac
    done
    unset _klee_dir

    # KLEE's installed runtime libraries (libkleeRuntime*)
    export KLEE_INSTALL_ROOT=/usr/local
    case ":${KLEE_RUNTIME_DIR:-}:" in
        *":/usr/local/lib/klee/runtime:"*) ;;
        *) KLEE_RUNTIME_DIR="/usr/local/lib/klee/runtime${KLEE_RUNTIME_DIR:+:${KLEE_RUNTIME_DIR}}" ;;
    esac

    # Solver and compiler toolchain used to produce bitcode for KLEE
    export STP_DIR=/usr/local
    export LLVM_DIR=/usr/lib/llvm-16/lib/cmake/llvm
    export LLVM_CONFIG=/usr/bin/llvm-config-16
    export KLEE_CC=/usr/bin/clang-16
    export KLEE_CXX=/usr/bin/clang++-16

    export PATH CPATH LD_LIBRARY_PATH LIBRARY_PATH KLEE_RUNTIME_DIR
fi
BLOCK
python3 - <<'PY'
path = '/root/.bashrc'
block = open('/tmp/klee_bashrc_block.sh').read()
text = open(path).read()
if 'KLEE_ENV_LOADED' in text:
    print('already present, skipping')
    raise SystemExit
marker = '# If not running interactively, don\'t do anything\n[ -z "$PS1" ] && return\n'
assert text.count(marker) == 1, text.count(marker)
text = text.replace(marker, block + '\n' + marker, 1)
open(path, 'w').write(text)
print('inserted')
PY
