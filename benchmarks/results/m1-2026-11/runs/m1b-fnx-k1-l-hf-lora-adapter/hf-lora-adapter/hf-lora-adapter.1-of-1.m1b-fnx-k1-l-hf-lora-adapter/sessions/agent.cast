[16.1435, "o", "\u001b[?2004h> "]
[16.143579, "o", "4. Save the configured model and tokenizer to '\"'\"'/app/model_cache/xlm-roberta-base'\"'\"'\r\n\u001b[?2004l\r\u001b[?2004h"]
[16.143585, "o", "> "]
[16.143664, "o", "5. Apply the LoRA adapter to the base model\r\n\u001b[?2004l\r"]
[16.14369, "o", "\u001b[?2004h> "]
