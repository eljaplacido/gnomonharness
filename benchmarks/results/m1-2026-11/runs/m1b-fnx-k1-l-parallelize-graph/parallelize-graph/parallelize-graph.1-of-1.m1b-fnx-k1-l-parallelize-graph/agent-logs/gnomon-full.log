old_end   = s.index('/* ------------------------------------------------------------------ */\n/* output')
new = '''/* ------------------------------------------------------------------ *
 * Unitig traversal.
 *
 * The traversal is deliberately *read-only*: whether a walk may cross a node
 * depends only on that node's in/out degree, never on a visited flag.  Two
 * threads partitioning the node ids therefore compute exactly the same
 * maximal unitigs as a single thread would, with no locks and no visited
 * bookkeeping -- the maximal unitig decomposition is edge-disjoint, so walks
 * started in different partitions can never produce the same contig.
 *
 * A walk starts at a node that is a unitig boundary: no unique predecessor
 * (so it is the left end) and it is the lexicographically smallest id in its
 * chain, which breaks the one remaining symmetry -- a directed cycle, where
 * every node has in-degree 1 and out-degree 1 and no boundary exists.
 * ------------------------------------------------------------------ */

static inline int has_unique_pred(int32_t i)
{
    if (nodes[i].indeg != 1) return 0;
    int32_t l = nodes[i].in[0];
    return l >= 0 && nodes[l].outdeg == 1 && nodes[l].out[0] == i;
}

static inline int has_unique_succ(int32_t i)
{
    if (nodes[i].outdeg != 1) return 0;
    int32_t r = nodes[i].out[0];
    return r >= 0 && nodes[r].indeg == 1 && nodes[r].in[0] == i;
}

/* Start a unitig here iff this node is not the interior of a chain. */
static inline int is_walk_start(int32_t i)
{
    if (!has_unique_pred(i)) return 1;             /* left boundary          */
    /* Interior of a chain: only the smallest id in the chain starts it, so a
     * pure cycle is emitted exactly once. */
    int32_t l = nodes[i].in[0];
    return l > i;
}

static char *walk_right(char *out, int32_t len, int32_t *pcap, int32_t start)
{
    int32_t cap = *pcap, cur = start;
    for (;;) {
        if (!has_unique_succ(cur)) break;
        int32_t r = nodes[cur].out[0];
        if (r == start) break;                     /* closed cycle: stop */
        if (len + 2 > cap) {
            cap *= 2;
            char *nb = (char *)realloc(out, (size_t)cap);
            if (!nb) { fprintf(stderr, "pgen: out of memory\\n"); exit(1); }
            out = nb;
        }
        out[len++] = INT2BASE[kmer_last_base(codes[r])];
        cur = r;
    }
    *pcap = cap; out[len] = '\\0';
    return out;
}

static void traverse_phase(int32_t lo, int32_t hi)
{
    mine_c.n = 0; mine_c.cap = 0; mine_c.seq = NULL;
    for (int32_t i = lo; i < hi; i++) {
        if (!is_walk_start(i)) continue;
        int32_t cap = 2 * K + 16;
        char *out = (char *)malloc((size_t)cap);
        if (!out) { fprintf(stderr, "pgen: out of memory\\n"); exit(1); }
        kmer_decode(codes[i], K, out);
        out = walk_right(out, K, &cap, i);
        mc_push(&mine_c, out);
    }
}

