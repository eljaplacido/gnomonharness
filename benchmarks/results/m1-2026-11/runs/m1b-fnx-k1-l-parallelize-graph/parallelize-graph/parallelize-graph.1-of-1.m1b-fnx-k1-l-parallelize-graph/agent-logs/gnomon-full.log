/* k-mer sliding-window primitives                                     */
/*                                                                     */
/* A code holds exactly K bases in its low 2K bits (kmer_encode masks   */
/* off everything else), so a base always sits at a fixed bit position: */
/*   base j (0-based) occupies bits [2*(K-1-j), 2*(K-1-j)+1]            */
/* and the 2 bits a shift brings in from above are always garbage.      */
/* ------------------------------------------------------------------ */

#define KMER_LOW  (((uint64_t)1 << (2 * K)) - 1)   /* mask for the K bases */

/* Drop the first base, append base code b at the end. */
static inline uint64_t kmer_extend(uint64_t code, int b)
{
    return ((code << 2) | (uint64_t)b) & KMER_LOW;
}

/* Drop the last base, prepend base code b at the front. */
static inline uint64_t kmer_prepend(uint64_t code, int b)
{
    return (code >> 2) | ((uint64_t)b << (2 * (K - 1)));
}

/* The base kmer_extend() would append, i.e. the last base of a code. */
static inline int kmer_last_base(uint64_t code)
{
    return (int)(code & 3);
}

/* The base kmer_prepend() would prepend, i.e. the first base of a code. */
static inline int kmer_first_base(uint64_t code)
{
    return (int)((code >> (2 * (K - 1))) & 3);
}

'''
