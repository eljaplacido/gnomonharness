 * Returns the (possibly reallocated) buffer, its length and capacity. */
static char *walk_right(graph_t *g, char *out, int32_t len, int32_t *pcap, int32_t start)
{
    int32_t cap = *pcap;
    int32_t cur = start;
    for (;;) {
        int32_t r = g->nodes[cur].right;
        if (r < 0 || g->nodes[cur].rvis) break;
        if (g->nodes[r].left != cur) break;          /* branching in */
        g->nodes[cur].rvis = 1;
        g->nodes[r].lvis   = 1;
        if (len + 2 > cap) {
            cap *= 2;
            char *nb = (char *)realloc(out, (size_t)cap);
            if (!nb) { fprintf(stderr, "serial: out of memory\\n"); exit(1); }
            out = nb;
        }
        uint64_t code = g->nodes[r].code;
        out[len++] = INT2BASE[(code >> (62 - 2 * K)) & 3];
        cur = r;
    }
    *pcap = cap;
    out[len] = '\\0';
    return out;
}

/* Walk left from `start`, prepending bases and consuming left edges. */
static char *walk_left(graph_t *g, char *out, int32_t len, int32_t *pcap, int32_t start)
{
    int32_t cap = *pcap;
    int32_t cur = start;
    for (;;) {
        int32_t l = g->nodes[cur].left;
        if (l < 0 || g->nodes[cur].lvis) break;
        if (g->nodes[l].right != cur) break;         /* branching out */
        g->nodes[cur].lvis = 1;
        g->nodes[l].rvis   = 1;
        if (len + 2 > cap) {
            cap *= 2;
            char *nb = (char *)realloc(out, (size_t)cap);
            if (!nb) { fprintf(stderr, "serial: out of memory\\n"); exit(1); }
            out = nb;
        }
        uint64_t code = g->nodes[l].code;
        memmove(out + 1, out, (size_t)len + 1);
        out[0] = INT2BASE[(code >> (62 - 2 * K)) & 3];
        len++;
        cur = l;
    }
    *pcap = cap;
    out[len] = '\\0';
    return out;
}

static void contigs_init(contigs_t *c, int32_t cap)
{
    c->seq = (char **)malloc((size_t)cap * sizeof(char *));
    if (!c->seq) { fprintf(stderr, "serial: out of memory\\n"); exit(1); }
    c->n = 0;
    c->cap = cap;
}

static void contigs_push(contigs_t *c, char *seq)
{
    if (c->n == c->cap) {
        c->cap *= 2;
        char **ns = (char **)realloc(c->seq, (size_t)c->cap * sizeof(char *));
        if (!ns) { fprintf(stderr, "serial: out of memory\\n"); exit(1); }
        c->seq = ns;
    }
    c->seq[c->n++] = seq;
}

static void traverse(graph_t *g, contigs_t *c)
{
    for (int32_t i = 0; i < g->n; i++) {
        if (g->nodes[i].rvis && g->nodes[i].lvis)
            continue;                                /* fully consumed */

        int32_t cap = 2 * K + 16;
        char *out = (char *)malloc((size_t)cap);
        if (!out) { fprintf(stderr, "serial: out of memory\\n"); exit(1); }
        kmer_decode(g->nodes[i].code, K, out);
        int32_t len = K;

        out = walk_right(g, out, len, &cap, i);
        len = (int32_t)strlen(out);
        out = walk_left(g, out, len, &cap, i);

        contigs_push(c, out);
    }
}

