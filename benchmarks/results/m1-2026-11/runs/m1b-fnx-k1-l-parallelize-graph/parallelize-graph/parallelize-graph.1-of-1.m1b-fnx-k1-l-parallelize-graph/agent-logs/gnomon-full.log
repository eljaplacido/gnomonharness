#include "../../app/dbg.h"
/* replicate build from serial.c */
static void graph_init(graph_t *g, int32_t cap){int32_t t=1;while(t<cap*2)t<<=1;g->nodes=malloc((size_t)cap*sizeof(node_t));g->table=malloc((size_t)t*sizeof(int32_t));for(int32_t i=0;i<t;i++)g->table[i]=-1;g->n=0;g->mask=t-1;}
static int32_t graph_insert(graph_t *g, uint64_t code){
  uint32_t b=(uint32_t)(kmer_hash(code)&(uint64_t)g->mask);int32_t i=g->table[b];
  while(i>=0){if(g->nodes[i].code==code)return i;i=g->nodes[i].next;}
  i=g->n++;node_t*nd=&g->nodes[i];nd->code=code;nd->next=g->table[b];nd->right=-1;nd->left=-1;nd->rvis=0;nd->lvis=0;g->table[b]=i;return i;}
int main(int argc,char**argv){
  FILE*f=fopen(argv[1],"r");static char line[256];
  graph_t g;graph_init(&g,1000000);
  while(fgets(line,sizeof line,f)){
    char k[64],e[8];int got=sscanf(line,"%63s %7s",k,e);
    if(got<2)continue;
    uint64_t code=kmer_encode(k,K);int32_t id=graph_insert(&g,code);
    if(e[1]!='F'){int32_t r=graph_insert(&g,kmer_extend(code,BASE2INT[(unsigned char)e[1]]));g.nodes[id].right=r;g.nodes[r].left=id;}
    if(e[0]!='F'){int32_t l=graph_insert(&g,kmer_prepend(code,BASE2INT[(unsigned char)e[0]]));g.nodes[l].right=id;g.nodes[id].left=l;}
  }
  int lr=0,ll=0,both=0;
  for(int32_t i=0;i<g.n;i++){if(g.nodes[i].right>=0)lr++;if(g.nodes[i].left>=0)ll++;if(g.nodes[i].right>=0&&g.nodes[i].left>=0)both++;}
  printf("nodes=%d with_right=%d with_left=%d both=%d\n",g.n,lr,ll,both);
  int32_t id=graph_find(&g,kmer_encode("ATAGCCAGTGCCTGATACT",19));
  printf("id=%d right=%d left=%d\n",id,g.nodes[id].right,g.nodes[id].left);
  if(g.nodes[id].right>=0){char s[32];kmer_decode(g.nodes[g.nodes[id].right].code,K,s);printf("right=%s\n",s);}
  return 0;}
EOF
