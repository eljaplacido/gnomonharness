static inline int has_unique_pred(int32_t i)
{
    if (g_nodes[i].indeg != 1) return 0;
    int32_t l = g_nodes[i].in[0];
    return l >= 0 && g_nodes[l].outdeg == 1 && g_nodes[l].out[0] == i;
}

static inline int has_unique_succ(int32_t i)
{
    if (g_nodes[i].outdeg != 1) return 0;
    int32_t r = g_nodes[i].out[0];
    return r >= 0 && g_nodes[r].indeg == 1 && g_nodes[r].in[0] == i;
}

static inline int is_walk_start(int32_t i)
{
    if (!has_unique_pred(i)) return 1;
    int32_t l = g_nodes[i].in[0];
    return l > i;                                  /* smallest id in the chain */
}

static char *walk_right(char *out, int32_t len, int32_t *pcap, int32_t start)
{
    int32_t cap = *pcap, cur = start;
    for (;;) {
        if (!has_unique_succ(cur)) break;
        int32_t r = g_nodes[cur].out[0];
        if (r == start) break;                     /* closed cycle: stop */
        if (len + 2 > cap) {
            cap *= 2;
            char *nb = (char *)realloc(out, (size_t)cap);
            if (!nb) { fprintf(stderr, "serial: out of memory\\n"); exit(1); }
            out = nb;
        }
        out[len++] = INT2BASE[kmer_last_base(g_nodes[cur].code)];
        cur = r;
    }
    *pcap = cap; out[len] = '\\0';
    return out;
}

static void traverse(graph_t *g, contigs_t *c)
{
    g_nodes = g->nodes;
    for (int32_t i = 0; i < g->n; i++) {
        if (!is_walk_start(i)) continue;
        int32_t cap = 2 * K + 16;
        char *out = (char *)malloc((size_t)cap);
        if (!out) { fprintf(stderr, "serial: out of memory\\n"); exit(1); }
        kmer_decode(g->nodes[i].code, K, out);
        out = walk_right(out, K, &cap, i);
        contigs_push(c, out);
    }
}

