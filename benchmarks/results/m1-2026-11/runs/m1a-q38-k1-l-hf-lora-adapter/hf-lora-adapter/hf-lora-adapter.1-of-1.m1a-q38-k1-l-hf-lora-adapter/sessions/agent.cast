[19.814831, "o", "Expected output format in detection_results.json:\r\n\u001b[?2004l\r\u001b[?2004h"]
[19.81484, "o", "> ```json\r\n\u001b[?2004l\r\u001b[?2004h> [\r\n\u001b[?2004l\r"]
