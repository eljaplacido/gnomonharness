from mailman.interfaces.mailinglist import SubscriptionPolicy
initialize('/etc/mailman3/mailman.cfg')
lm = getUtility(IListManager)
mlist = lm.get('reading-group@local.edu')
print('before', mlist.subscription_policy)
mlist.subscription_policy = SubscriptionPolicy.open
print('after set', mlist.subscription_policy)
# Try to commit
from mailman.interfaces.database import IDatabase
db = getUtility(IDatabase)
db.commit()
print('committed')
# Re-read
mlist2 = lm.get('reading-group@local.edu')
print('re-read', mlist2.subscription_policy)
