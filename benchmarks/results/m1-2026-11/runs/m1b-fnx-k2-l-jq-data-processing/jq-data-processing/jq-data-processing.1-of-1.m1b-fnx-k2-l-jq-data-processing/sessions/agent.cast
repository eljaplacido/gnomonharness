[18.233394, "o", "**Note on examples below**: In the following Data Schema sections, all content following the '\"'\"'#'\"'\"' symbol is just explanatory commentary and will NOT appear in the actual JSON files. These comments are only provided to clarify the structure and requirements.\r\n\u001b[?2004l\r\u001b[?2004h"]
[18.23341, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[18.233451, "o", "**Input Data Schema**:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[18.233531, "o", "The input JSON file '\"'\"'/app/users.json'\"'\"' is an array of user objects with the following structure:\r\n\u001b[?2004l\r"]
[18.233556, "o", "\u001b[?2004h> [\r\n\u001b[?2004l\r\u001b[?2004h>   {\r\n\u001b[?2004l\r"]
[18.233574, "o", "\u001b[?2004h> "]
[18.233628, "o", "    \"id\": 1,                  # Unique numeric identifier for the user\r\n\u001b[?2004l\r"]
[18.233657, "o", "\u001b[?2004h> "]
[18.233695, "o", "    \"username\": \"john_doe\",   # User'\"'\"'s unique username (string)\r\n\u001b[?2004l\r"]
[18.233713, "o", "\u001b[?2004h> "]
[18.233774, "o", "    \"email\": \"john@example.com\",  # User'\"'\"'s email address (string)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[18.233857, "o", "    \"status\": \"active\",       # User status: '\"'\"'active'\"'\"' or '\"'\"'inactive'\"'\"'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[18.233934, "o", "    \"last_login\": \"2024-10-02T20:59:10.109812Z\",  # ISO 8601 timestamp (UTC) of the last login\r\n\u001b[?2004l\r"]
[18.233941, "o", "\u001b[?2004h> "]
[18.234015, "o", "    \"roles\": [\"admin\", \"editor\"]  # Array of roles assigned to the user (may be empty)\r\n\u001b[?2004l\r"]
[18.234042, "o", "\u001b[?2004h> "]
[18.234049, "o", "  },\r\n\u001b[?2004l\r\u001b[?2004h>   ...\r\n\u001b[?2004l\r\u001b[?2004h"]
