import duckdb, pandas as pd
from pathlib import Path
products = pd.read_csv('/app/products.csv')
orders = pd.read_csv('/app/orders.csv', parse_dates=['order_date'])
con = duckdb.connect()
con.register('products', products); con.register('orders', orders)
q = Path('/app/answer.sql').read_text()
top3 = con.execute(q).df().groupby('category')['product_id'].apply(list).to_dict()
print(top3)
# independent pandas check
m = orders[(orders.order_date>='2024-10-01')&(orders.order_date<='2024-12-31')].copy()
m['sales']=m.quantity*m.unit_price
s = m.merge(products[['product_id','category']],on='product_id').groupby(['category','product_id'])['sales'].sum().reset_index()
exp = {c:g.sort_values('sales',ascending=False).head(3).product_id.tolist() for c,g in s.groupby('category')}
print(exp)
print('MATCH' if all(sorted(top3[c])==sorted(exp[c]) for c in exp) and set(top3)==set(exp) else 'MISMATCH')
print(con.execute(q).df().head(20).to_string())
