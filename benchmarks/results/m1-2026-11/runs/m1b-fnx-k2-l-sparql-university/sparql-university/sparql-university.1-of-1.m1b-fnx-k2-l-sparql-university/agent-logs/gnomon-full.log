    p=t; i+=1
    while i<len(toks) and toks[i] not in ('.',';'):
        o=toks[i]
        if o==',': i+=1; continue
        triples.append((cur,p,o)); i+=1
def lit(o):
    m=re.match(r'^"((?:[^"\\]|\\.)*)"', o, re.S); return m.group(1) if m else o
W=collections.defaultdict(set); B={}; C={}; R={}; N={}; EN=collections.defaultdict(set); ED={}; GD={}
