"""/* ------------------------------------------------------------------ nodes
 * `next` is an index into the owning image's node pool, not a pointer: the
 * UPC translator will not carry a pointer-to-shared through a local variable,
 * so chains are walked by index.  -1 terminates a chain.
 */
typedef struct node {
    uint64_t      key;                    /* k-mer as base-4 integer          */
    unsigned char lmask;                  /* bits of observed left  exts      */
    unsigned char rmask;                  /* bits of observed right exts      */
    int           next;                   /* next node in chain, or -1        */
} node_t;

#define NIL_NODE (-1)""")
open(p,'w').write(s)
