[6.318793, "o", "\u001b[31m\u001b[1m____________________________________________________________ test_jq_args_yaml_produces_same_output ____________________________________________________________\u001b[0m\r\n\r\n"]
[6.32004, "o", "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mtest_jq_args_yaml_produces_same_output\u001b[39;49;00m():\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"Test that executing jq with args from YAML produces the same output.\"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[90m# Construct the jq command using the exact format from the task description\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        cmd = (\u001b[90m\u001b[39;49;00m\r\n            \u001b[33m\"\u001b[39;49;00m\u001b[33mjq $(yq -r \u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33m.args[]\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33m /app/jq_args.yaml) \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n            \u001b[33m\"\u001b[39;49;00m\u001b[33m\\\"\u001b[39;49;00m\u001b[33m$(yq -r \u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33m.filter\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33m /app/jq_args.yaml)\u001b[39;49;00m\u001b[33m\\\"\u001b[39;49;00m\u001b[33m /app/users.json\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        )\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[90m# Execute the command\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        \u001b[94mtry\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\r\n           "]
[6.320063, "o", " result = subprocess.run(\u001b[90m\u001b[39;49;00m\r\n                cmd, shell=\u001b[94mTrue\u001b[39;49;00m, capture_output=\u001b[94mTrue\u001b[39;49;00m, text=\u001b[94mTrue\u001b[39;49;00m, check=\u001b[94mTrue\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n            )\u001b[90m\u001b[39;49;00m\r\n            yaml_generated_output = result.stdout\u001b[90m\u001b[39;49;00m\r\n        \u001b[94mexcept\u001b[39;49;00m subprocess.CalledProcessError \u001b[94mas\u001b[39;49;00m e:\u001b[90m\u001b[39;49;00m\r\n            pytest.fail(\u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mError running jq command from YAML args: \u001b[39;49;00m\u001b[33m{\u001b[39;49;00me.stderr\u001b[33m}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[90m# Read the actual output file\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n>       \u001b[94mwith\u001b[39;49;00m \u001b[96mopen\u001b[39;49;00m(\u001b[33m\"\u001b[39;49;00m\u001b[33m/app/active_users_report.json\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33mr\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m) \u001b[94mas\u001b[39;49;00m f:\u001b[90m\u001b[39;49;00m\r\n             ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\u001b[90m\u001b[39;49;00m\r\n\u001b[1m\u001b[31mE       FileNotFoundError: [Errno 2"]
