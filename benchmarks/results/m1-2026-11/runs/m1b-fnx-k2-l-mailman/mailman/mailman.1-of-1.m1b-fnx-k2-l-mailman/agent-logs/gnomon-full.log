def wait_for(fn,tries=20,label=""):
    last=None
    for i in range(tries):
        last=fn()
        if last: return last
        sleep(2)
    raise AssertionError(f"timed out: {label} (last={last})")

u=os.urandom(8).hex(); subprocess.run(["useradd",u],check=True)
