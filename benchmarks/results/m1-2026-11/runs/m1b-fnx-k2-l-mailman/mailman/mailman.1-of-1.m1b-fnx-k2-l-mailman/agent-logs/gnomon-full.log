import os, mailbox, time
from mailman.core.initialize import initialize
from mailman.interfaces.listmanager import IListManager
from mailman.interfaces.mailinglist import SubscriptionPolicy
from mailman.interfaces.usermanager import IUserManager
from mailman.interfaces.subscriptions import ISubscriptionManager
from zope.component import getUtility
from mailman.config import config
initialize("/etc/mailman3/mailman.cfg")
LM=getUtility(IListManager); UM=getUtility(IUserManager)
m=LM.get("reading-group@local.edu")
def inbox(u):
    p=f"/var/mail/{u}"
    return [x.get("Subject","")[:70] for x in mailbox.mbox(p)] if os.path.exists(p) else "NO MBOX"
for pol in ("open","confirm"):
    u="p3-%s-%s"%(pol,os.urandom(3).hex()); os.system(f"useradd {u} 2>/dev/null")
    m.subscription_policy=SubscriptionPolicy[pol]; config.db.commit()
    addr=UM.create_address(f"{u}@local.edu")
    tok,owner,mem = ISubscriptionManager(m).register(addr); config.db.commit()
    for i in range(10):
        time.sleep(2)
        s=inbox(u)
        if s!="NO MBOX" and s: break
    print(f"{pol:8} token={str(tok)[:8]!r:12} inbox={s} in_roster={m.members.get_member(f'{u}@local.edu') is not None}")
