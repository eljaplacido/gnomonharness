# ============================================================================
# Reading-group site configuration (added by setup)
# ============================================================================

[mta]
# Local Postfix on 127.0.0.1:25 accepts the mail Mailman generates
# (subscriptions confirmations, announcements, notices to owners).
smtp_host: 127.0.0.1
smtp_port: 25

[runner.lmtp]
# The LMTP runner binds lmtp_host:lmtp_port at startup.  If a stale master is
# still holding 127.0.0.1:8024 the runner dies with EADDRINUSE and the master
# gives up after max_restarts, which silently wedges the whole pipeline.
# Restarting is cheap; failing to bind is not.
max_restarts: 100

[runner.in]
max_restarts: 100

[runner.out]
max_restarts: 100

[runner.virgin]
max_restarts: 100

