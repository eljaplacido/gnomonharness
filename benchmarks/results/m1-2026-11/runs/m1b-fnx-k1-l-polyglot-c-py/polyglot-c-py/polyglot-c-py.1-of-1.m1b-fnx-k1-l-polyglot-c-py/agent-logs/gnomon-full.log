import subprocess
def run(src,name,lang):
    fn=name+'.'+lang; open(fn,'w').write(src)
    cmd=['python3','-c',f"compile(open('{fn}').read(),'x','exec')"] if lang=='py' else ['gcc','-fsyntax-only',fn]
    r=subprocess.run(cmd,capture_output=True,text=True)
    print(('  OK  ' if r.returncode==0 else '  FAIL')+' ['+lang+'] '+name)
    if r.returncode:
        errs=[l.strip() for l in r.stderr.strip().splitlines() if 'error' in l]
        print('        '+' | '.join(errs)[:250])

# PY code after '""" ;' must be hidden from C.
# Trick: '""" ;' closes py string, and we OPEN a C comment right there:
#   '/* """ ;'  -> C: opens comment (quotes inside comment are inert)
#                -> PY: '/*' is... not valid. Hmm.
# Alternative: put C comment opener BEFORE, on its own line, and '""" ;' inside it.
#   /*        <- C opens comment; PY: inside string (ignored)
#   """ ;     <- PY closes string; C: inside comment (ignored)
#   <py code> <- PY runs; C: inside comment (ignored)  <-- but comment never closes!
# Need to close C comment at END of py code, in a way PY also tolerates:
#   */        <- C closes comment; PY: '*/' is a syntax error at top level
# BUT if we make it:  '# */'  -> PY: comment!  C: closes comment!
src = ('#define S _ /*\n'
       '"""\n'
       'end */\n'
       'int f(void){return 0;}\n'
       '/*\n'
       '""" ;\n'
       'import sys\n'
       'print("hi")\n'
       '# */\n')
run(src,'hide','c')
run(src,'hide','py')
