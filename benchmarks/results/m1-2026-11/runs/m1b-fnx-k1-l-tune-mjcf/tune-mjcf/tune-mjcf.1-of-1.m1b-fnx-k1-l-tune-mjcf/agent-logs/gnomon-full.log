import mujoco, numpy as np, time
def load(): return mujoco.MjModel.from_xml_path("model_ref.xml")
ref = load()
def sim(m, seed=0):
    d = mujoco.MjData(m)
    rng=np.random.default_rng(seed)
    d.qpos += rng.normal(0,0.01,size=d.qpos.shape)
    mujoco.mj_forward(m,d)
    nstep=int(2.0/m.opt.timestep)
    t0=time.perf_counter()
    for _ in range(nstep): mujoco.mj_step(m,d)
    t=time.perf_counter()-t0
    st = np.zeros(mujoco.mj_stateSize(m, mujoco.mjtState.mjSTATE_FULLPHYSICS))
    mujoco.mj_getState(m,d,st,mujoco.mjtState.mjSTATE_FULLPHYSICS)
    return t, st
_, st_ref = sim(ref)
def test(name, mutate, seeds=(0,1,2)):
    m = load(); mutate(m)
    try:
        ok=True; res=[]
        for s in seeds:
            t,st = sim(m,s)
            _, st_r = sim(ref,s)
            d_=np.linalg.norm(st-st_r); ok &= np.allclose(st,st_r,atol=1e-5)
            res.append((round(t,4), round(d_,8)))
        print(f"{name:35s} ok={ok} {res}")
    except Exception as e:
        print(f"{name:35s} ERR {e}")

test("integrator=implicit(1)", lambda m: setattr(m.opt,'integrator',1))
test("integrator=implicitfast(3)", lambda m: setattr(m.opt,'integrator',3))
test("solver=newton(0)", lambda m: setattr(m.opt,'solver',0))
test("solver=pgs(1)", lambda m: setattr(m.opt,'solver',1))
test("solver=cg(3)", lambda m: setattr(m.opt,'solver',3))
