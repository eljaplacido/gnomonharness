import mujoco, numpy as np, time
def load(): return mujoco.MjModel.from_xml_path("model_ref.xml")
ref = load()
def sim(m, seed):
    d = mujoco.MjData(m)
    rng=np.random.default_rng(seed)
    d.qpos += rng.normal(0,0.01,size=d.qpos.shape)
    mujoco.mj_forward(m,d)
    nstep=int(2.0/m.opt.timestep)
    t0=time.perf_counter()
    for _ in range(nstep): mujoco.mj_step(m,d)
    t=time.perf_counter()-t0
    st = np.zeros(mujoco.mj_stateSize(m, mujoco.mjtState.mjSTATE_FULLPHYSICS))
    mujoco.mj_getState(m,d,st,mujoco.mjtState.mjSTATE_FULLPHYSICS)
    return t, st
seeds=list(range(8))
refst={s:sim(ref,s)[1] for s in seeds}
reft=np.mean([sim(ref,s)[0] for s in seeds])
print("reft", reft)
def test(name, mutate):
    m = load()
    try: mutate(m)
    except Exception as e: print(f"{name:38s} MUTATE ERR {e}"); return
    try:
        ts=[]; ok=True; worst=0
        for s in seeds:
            t,st = sim(m,s)
            worst=max(worst,np.linalg.norm(st-refst[s])); ok &= np.allclose(st,refst[s],atol=1e-5)
            ts.append(t)
        print(f"{name:38s} ok={ok} worst={worst:.2e} t={np.mean(ts):.4f} pct={np.mean(ts)/reft:.3f}")
    except Exception as e:
        print(f"{name:38s} SIM ERR {e}")

def setopt(m,**kw):
    for k,v in kw.items(): setattr(m.opt,k,v)
test("newton", lambda m: setopt(m,solver=0))
test("newton+ls1", lambda m: setopt(m,solver=0,ls_iterations=1))
test("newton+ls2", lambda m: setopt(m,solver=0,ls_iterations=2))
test("newton+ls3", lambda m: setopt(m,solver=0,ls_iterations=3))
test("newton+it1+ls1", lambda m: setopt(m,solver=0,iterations=1,ls_iterations=1))
test("newton+it2+ls1", lambda m: setopt(m,solver=0,iterations=2,ls_iterations=1))
test("newton+cone1", lambda m: setopt(m,solver=0,cone=1))
test("newton+cone1+ls1", lambda m: setopt(m,solver=0,cone=1,ls_iterations=1))
test("newton+noWarm", lambda m: (setopt(m,solver=0), setattr(m.opt,'disableflags', m.opt.disableflags|int(mujoco.mjtDisableBit.mjDSBL_WARMSTART))))
test("newton+noWarm+ls1", lambda m: (setopt(m,solver=0,ls_iterations=1), setattr(m.opt,'disableflags', m.opt.disableflags|int(mujoco.mjtDisableBit.mjDSBL_WARMSTART))))
test("pgs", lambda m: setopt(m,solver=1))
test("pgs+it2", lambda m: setopt(m,solver=1,iterations=2))
test("pgs+it3", lambda m: setopt(m,solver=1,iterations=3))
test("pgs+it5", lambda m: setopt(m,solver=1,iterations=5))
