[approval] bash: cd /app && (setsid python - <<'EOF' > /tmp/evalmodes.log 2>&1
import json, torch
from transformers import AutoTokenizer, AutoModelForCausalLM
from peft import PeftModel
tok = AutoTokenizer.from_pretrained('/app/experiments/lora_adapter'); tok.pad_token=tok.eos_token; tok.padding_side='left'
base = AutoModelForCausalLM.from_pretrained('openai-community/gpt2')
m = PeftModel.from_pretrained(base, '/app/experiments/lora_adapter'); m.eval()
v = json.load(open('/app/data/val.json'))
def fmt(s):
    lines=[f"Question: {s['question'].strip()}"]
    for L,o in zip('ABCD', s['options']):
        t=o.strip()
        for p in (f"{L}.",f"{L})",f"{L}:"):
            if t.lower().startswith(p.lower()): t=t[len(p):].strip(); break
        lines.append(f"{L}. {t}")
    lines.append("Answer:")
    return "\n".join(lines)
# mode1: last-token logits of prompt
def mode1(model, samples):
    ids = {L: tok(" "+L, add_special_tokens=False)['input_ids'][0] for L in 'ABCD'}
    c=0
    for i in range(0,len(samples),16):
        b=samples[i:i+16]; ps=[fmt(s) for s in b]
        e=tok(ps, add_special_tokens=False, padding=True, return_tensors='pt', truncation=True, max_length=512)
        with torch.no_grad(): lg=model(**e).logits
        lens=e['attention_mask'].sum(1)-1
        for j,s in enumerate(b):
            last=lg[j,lens[j]].float()
            pred=max(ids, key=lambda L: float(last[ids[L]]))
            c+= int(pred==s['answer'])
    return c/len(samples)
# mode2: full continuation scoring
def mode2(model, samples):
    c=0
    for s in samples:
        p=fmt(s); base_ids=tok(p, add_special_tokens=False)['input_ids']; best=None
        for L in 'ABCD':
            ids=base_ids+tok(" "+L, add_special_tokens=False)['input_ids']
            with torch.no_grad(): lg=model(torch.tensor([ids])).logits[0][:-1].log_softmax(-1)
            sc=sum(float(lg[len(base_ids)-1+i, ids[len(base_ids)+i]]) for i in range(len(ids)-len(base_ids)))
            if best is None or sc>best[0]: best=(sc,L)
        c+=int(best[1]==s['answer'])
    return c/len(samples)
print('mode1 lora', mode1(m,v))
print('mode2 lora', mode2(m,v))
EOF
