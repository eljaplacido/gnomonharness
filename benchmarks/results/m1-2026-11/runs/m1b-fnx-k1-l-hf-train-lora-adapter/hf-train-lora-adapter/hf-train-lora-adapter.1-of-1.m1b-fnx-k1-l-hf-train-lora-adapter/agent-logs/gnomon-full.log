import json, torch
from transformers import AutoTokenizer, AutoModelForCausalLM
tok = AutoTokenizer.from_pretrained('openai-community/gpt2'); tok.pad_token = tok.eos_token
m = AutoModelForCausalLM.from_pretrained('openai-community/gpt2'); m.eval()
v = json.load(open('/app/data/val.json'))[:20]
def prompt(s):
    return f"Question: {s['question']}\n" + "\n".join(s['options']) + "\nAnswer:"
def cont(s):
    p = prompt(s); base = tok(p, add_special_tokens=False)['input_ids']
    best=None
    for L in 'ABCD':
        ids = base + tok(' '+L, add_special_tokens=False)['input_ids']
        with torch.no_grad(): out = m(torch.tensor([ids]))
        lp = out.logits[0][:-1].log_softmax(-1)
        sc = sum(float(lp[len(base)-1+i, ids[len(base)+i]]) for i in range(len(ids)-len(base)))
        if best is None or sc>best[0]: best=(sc,L)
    return best[1]
c=0
for s in v:
    p = prompt(s)
    out = m.generate(torch.tensor([tok(p, add_special_tokens=False)['input_ids']]), max_new_tokens=4, do_sample=False, pad_token_id=tok.eos_token_id)
    gen = tok.decode(out[0][len(tok(p,add_special_tokens=False)['input_ids']):], skip_special_tokens=True)
    c += (gen.strip()[:1]==s['answer'])
    print(repr(gen[:20]), s['answer'])
print('greedy generate acc', c, len(v))
