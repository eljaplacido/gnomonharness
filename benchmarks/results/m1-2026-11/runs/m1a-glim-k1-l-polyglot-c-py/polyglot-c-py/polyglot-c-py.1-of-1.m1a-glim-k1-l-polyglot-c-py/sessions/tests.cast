[9.039395, "o", "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mtest_fibonacci_polyglot\u001b[39;49;00m():\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"\u001b[39;49;00m\r\n    \u001b[33m    Test that main.py.c is a valid polyglot that runs with both python3 and gcc,\u001b[39;49;00m\r\n    \u001b[33m    produces correct Fibonacci numbers, and is contained in a single file.\u001b[39;49;00m\r\n    \u001b[33m    \"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[90m# Verify that only main.py.c exists in /app/polyglot\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n>       polyglot_files = os.listdir(\u001b[33m\"\u001b[39;49;00m\u001b[33m/app/polyglot\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n                         ^^^^^^^^^^^^^^^^^^^^^^^^^^^\u001b[90m\u001b[39;49;00m\r\n\u001b[1m\u001b[31mE       FileNotFoundError: [Errno 2] No such file or directory: '/app/polyglot'\u001b[0m\r\n\r\n\u001b[1m\u001b[31m/tests/test_outputs.py\u001b[0m:17: FileNotFoundError\r\n"]
