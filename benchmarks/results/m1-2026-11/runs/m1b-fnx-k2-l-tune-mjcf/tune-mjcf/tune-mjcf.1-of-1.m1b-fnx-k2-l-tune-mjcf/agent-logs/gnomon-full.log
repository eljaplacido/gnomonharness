import mujoco, numpy as np, time
from bench import simulate_model
ref = mujoco.MjModel.from_xml_path("model_ref.xml")
def check(it, nseed):
    m = mujoco.MjModel.from_xml_path("model_ref.xml")
    m.opt.solver = 1; m.opt.iterations = it
    worst=0.0; nbad=0
    for s in range(nseed):
        a=simulate_model(m,s); b=simulate_model(ref,s)
        d=np.abs(a-b).max(); worst=max(worst,d)
        if d>1e-5: nbad+=1
    return worst,nbad
for it in [10,12,15,20,25,30]:
    w,nb=check(it,60)
    print(f"pgs it={it:<3} worst={w:.3e} nbad={nb}/60")
