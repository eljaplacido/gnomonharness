import sys, time, itertools
import mujoco, numpy as np
from bench import simulate_model

ref = mujoco.MjModel.from_xml_path("model_ref.xml")
seeds = list(range(12)) + [np.random.randint(0,10000) for _ in range(3)]
ref_states = [simulate_model(ref, s) for s in seeds]

def trial(**kw):
    m = mujoco.MjModel.from_xml_path("model_ref.xml")
    for k,v in kw.items():
        setattr(m.opt, k, v)
    worst = 0.0
    for s, rs in zip(seeds, ref_states):
        try:
            st = simulate_model(m, s)
        except AssertionError as e:
            return None, str(e)
        worst = max(worst, np.abs(st-rs).max())
    t0=time.perf_counter()
    for s in seeds[:6]: simulate_model(m, s)
    dt=(time.perf_counter()-t0)/6
    return (worst, dt), None

for ts in [0.002,0.004,0.005,0.006,0.008,0.01,0.0125,0.015,0.02]:
    r,err = trial(timestep=ts)
    print(f"ts={ts:<7}", "ERR "+err if err else f"worst={r[0]:.3e} t={r[1]:.4f}s pct={r[1]/0.0445:.2f}")
EOF
