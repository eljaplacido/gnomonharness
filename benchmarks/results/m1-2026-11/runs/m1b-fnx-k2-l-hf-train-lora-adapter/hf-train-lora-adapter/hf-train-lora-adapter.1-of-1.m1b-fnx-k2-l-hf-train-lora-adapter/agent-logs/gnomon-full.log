import torch, json
from transformers import AutoTokenizer, AutoModelForCausalLM
tok = AutoTokenizer.from_pretrained("openai-community/gpt2")
m = AutoModelForCausalLM.from_pretrained("openai-community/gpt2").eval()
ids = {l: tok(" "+l, add_special_tokens=False)["input_ids"][0] for l in "ABCD"}
def prompt(q,opts): return f"Question: {q}\n" + "\n".join(opts) + "\nAnswer:"
d=json.load(open("data/val.json"))
correct=0; first5=0
with torch.no_grad():
    for x in d:
        enc = tok(prompt(x["question"],x["options"]), return_tensors="pt")
        logits = m(**enc).logits[0,-1]
        scores = {l: float(logits[ids[l]]) for l in "ABCD"}
        pred = max(scores, key=scores.get)
        correct += pred==x["answer"]
        first5 += x["options"][0][:2]==x["answer"]+". "
print("base argmax acc", correct/len(d), "first-option rate", first5/len(d))
