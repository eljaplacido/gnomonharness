const U = 'http://university.org/ontology/';
const P = {}; for (const p of ['isTaughtIn','isEnrolledIn','hasGraduationDate','worksIn','role','locatedInCountry','belongsTo','hasName','teaches'])
  P[p] = store.sym(U + p);
const short = u => String(u).replace(U,'');
