const rdflib = require('rdflib');
const fs = require('fs');
const store = rdflib.graph();
const txt = fs.readFileSync('/app/university_graph.ttl','utf8');
rdflib.parse(txt, store, 'file:///app/university_graph.ttl', 'text/turtle');
const U = n => 'http://university.org/ontology/' + n;
const sym = p => store.sym(U(p));
const any = p => store.sym(U(p));
// course -> dept
const deptOf = {};
store.match(any('isTaughtIn'), null, null).forEach(st => { deptOf[st.subject.value] = st.object.value; });
console.log('course->dept:', JSON.stringify(deptOf,null,0));
// students enrolled (currently) : graduation absent or > 2025-08-16
const TODAY = '2025-08-16';
const perDept = {};
const perDeptAll = {};
store.match(any('isEnrolledIn'), null, null).forEach(st => {
  const s = st.subject, course = st.object.value;
  const dept = deptOf[course];
  const grad = store.any(s, any('hasGraduationDate'));
  const enrolled = !grad || grad.value > TODAY;
  const d = dept || ('UNDEFINED:'+course.value.split('/').pop());
  perDeptAll[d] = perDeptAll[d] || new Set(); perDeptAll[d].add(s.value);
  if (enrolled) { perDept[d] = perDept[d] || new Set(); perDept[d].add(s.value); }
});
console.log('\n== distinct students per dept ==');
for (const d of Object.keys(perDeptAll)) {
  console.log(d.replace('http://university.org/ontology/',''), '| current:', perDept[d]?perDept[d].size:0, '| all:', perDeptAll[d].size);
}
console.log('\n== worksIn map ==');
store.match(any('worksIn'),null,null).forEach(st=>console.log(st.subject.value.split('/').pop(), '->', st.object.value.split('/').pop()));
console.log('\n== roles ==');
store.match(any('role'),null,null).forEach(st=>console.log(st.subject.value.split('/').pop(), '|', st.object.value));
console.log('\n== countries ==');
store.match(any('locatedInCountry'),null,null).forEach(st=>console.log(st.subject.value.split('/').pop(), st.object.value));
EOF
