      console.log('quad rows:', rows.length, 'distinct bindings:', seen.size);
    } else {
      console.log('quads:', rows.length);
    }
  } catch(e){ console.error('ERROR:', e && e.stack ? e.stack.split('\n').slice(0,8).join('\n') : e); process.exit(1); }
})();
EOF
