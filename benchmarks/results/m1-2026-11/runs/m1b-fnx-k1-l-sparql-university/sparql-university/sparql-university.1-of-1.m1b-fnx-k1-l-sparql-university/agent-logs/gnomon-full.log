(async()=>{
  const base = fs.readFileSync('/app/solution.sparql','utf8');
  // A: WITHOUT GROUP BY ?professor  (demonstrates duplicate-row bug)
  await run('no-group-by-professor', base.replace('GROUP BY ?professor ?professorName','GROUP BY ?professorName'));
  // B: no graduation-date filter (shows the date filter matters)
  await run('no-grad-filter', base.replace('FILTER ( !BOUND(?gradDate) || ?gradDate >  "2025-08-16"^^xsd:date )',''));
  // C: no EU restriction
  await run('no-eu-filter', base.replace(/FILTER \( \?euCountry IN \([\s\S]*?\) \)/,''));
  // D: full-professor filter removed
  await run('no-fullprof-filter', base.replace(/FILTER \( CONTAINS\(\?role, "Professor"\)[\s\S]*?\) \n/,''));
})();
EOF
