const N3 = require('n3');
const { HashMapDataset, Graph, PipelineEngine } = require('sparql-engine');
const fs = require('fs');

const doc = fs.readFileSync('/app/university_graph.ttl','utf8');
const parser = new N3.Parser({ format: 'text/turtle', baseIRI: 'file:///app/university_graph.ttl' });
const quads = parser.parse(doc);
const store = new N3.Store(quads);
const graph = new Graph();
graph.match = (s,p,o,g) => Promise.resolve(store.match(s,p,o,g||null));
const ds = new HashMapDataset('urn:default', graph);
const engine = new PipelineEngine(ds);
const q = fs.readFileSync(process.argv[2] || '/app/solution.sparql','utf8');
(async () => {
  try {
    const res = await engine.query(q);
    console.log('HEAD:', res.head ? res.head.vars.join(' | ') : '?');
    let n=0;
    for await (const b of res) { n++;
      const o={}; for (const k of b.keys()) { const t=b.get(k); o[k.value]= t?t.value:null; }
      console.log(JSON.stringify(o));
    }
    if(!n) console.log('(no rows)');
    console.log('rows:', n);
  } catch(e){ console.error('ERROR:', e && e.stack ? e.stack.split('\n').slice(0,6).join('\n') : e); process.exit(1); }
})();
EOF
