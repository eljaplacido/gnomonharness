store.match(null,P.belongsTo,null).forEach(s=>console.log(short(s.subject.value).padEnd(28),'->',short(s.object.value), univCountry[s.object.value]));
console.log('\n== people: role / worksIn / teaches ==');
store.match(null,P.role,null).forEach(s=>{
  const w=store.match(s.subject,P.worksIn,null).map(x=>short(x.object.value));
  const t=store.match(s.subject,P.teaches,null).map(x=>short(x.object.value));
  console.log(short(s.subject.value).padEnd(24),'|',s.object.value.padEnd(45),'| worksIn:',w.join(','),'| teaches:',t.join(','));
});
EOF
