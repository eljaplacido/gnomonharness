const engine = new QueryEngine();
async function run(label, q){
  try{
    const it = await engine.queryBindings(q, { sources:['http://127.0.0.1:8901/university_graph.ttl'] });
    const rows=[]; for await (const b of it){ const o={}; for(const [k,v] of b) o[k.value]=v.value; rows.push(o); }
