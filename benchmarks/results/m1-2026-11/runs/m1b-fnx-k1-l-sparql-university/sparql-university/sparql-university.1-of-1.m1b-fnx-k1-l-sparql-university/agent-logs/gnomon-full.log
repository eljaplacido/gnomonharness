  const s = st.subject, course = st.object.value;
  const grad = store.any(s, P.hasGraduationDate);
  const enrolled = !grad || grad.value > TODAY;
  const d = deptOf[course] || ('UNDEFINED:'+short(course));
  (perDeptAll[d] = perDeptAll[d] || new Set()).add(s.value);
  if (enrolled) (perDept[d] = perDept[d] || new Set()).add(s.value);
});
console.log('== distinct students per dept (current = not graduated by 2025-08-16) ==');
for (const d of Object.keys(perDeptAll))
  console.log(short(d).padEnd(28), 'current:', String(perDept[d]?perDept[d].size:0).padStart(3), ' all:', perDeptAll[d].size);
console.log('\n== belongsTo / country ==');
