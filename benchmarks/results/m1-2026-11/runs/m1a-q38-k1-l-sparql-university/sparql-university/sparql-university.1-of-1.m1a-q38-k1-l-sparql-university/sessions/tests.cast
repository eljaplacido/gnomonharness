[6.661812, "o", "    \u001b[0m\u001b[94mreturn\u001b[39;49;00m Query.parseString(q, parseAll=\u001b[94mTrue\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n           ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\u001b[90m\u001b[39;49;00m\r\n\u001b[1m\u001b[31m.tbench-testing/lib/python3.12/site-packages/pyparsing/util.py\u001b[0m:466: in _inner\r\n    \u001b[0m\u001b[94mreturn\u001b[39;49;00m fn(\u001b[96mself\u001b[39;49;00m, *args, **kwargs)\u001b[90m\u001b[39;49;00m\r\n           ^^^^^^^^^^^^^^^^^^^^^^^^^\u001b[90m\u001b[39;49;00m\r\n_ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ \r\n\r\nself = {Group:([{Base | PrefixDecl}]...) {SelectQuery | ConstructQuery | DescribeQuery | AskQuery}}\r\ninstring = 'PREFIX uni: <http://university.org/ontology/>\\nPREFIX xsd: <http://www.w3.org/2001/XMLSchema#>\\n\\nSELECT ?professorNa...&& ?student != ?student9 &&\\n          ?student != ?student10 && ?student != ?student11)\\n}\\nGROUP BY ?professorName\\n'\r\nparse_all = True, kwargs = {'parseAll': True}, parseAll = True, e = Suppress:({'#' rest of line})\r\n\r\n"]
[6.662265, "o", "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mparse_string\u001b[39;49;00m(\u001b[90m\u001b[39;49;00m\r\n        \u001b[96mself\u001b[39;49;00m, instring: \u001b[96mstr\u001b[39;49;00m, parse_all: \u001b[96mbool\u001b[39;49;00m = \u001b[94mFalse\u001b[39;49;00m, **kwargs\u001b[90m\u001b[39;49;00m\r\n    ) -> ParseResults:\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"\u001b[39;49;00m\r\n    \u001b[33m    Parse a string with respect to the parser definition. This function is intended as the primary interface to the\u001b[39;49;00m\r\n    \u001b[33m    client code.\u001b[39;49;00m\r\n    \u001b[33m\u001b[39;49;00m\r\n    \u001b[33m    :param instring: The input string to be parsed.\u001b[39;49;00m\r\n    \u001b[33m    :param parse_all: If set, the entire input string must match the grammar.\u001b[39;49;00m\r\n    \u001b[33m    :param parseAll: retained for pre-PEP8 compatibility, will be removed in a future release.\u001b[39;49;00m\r\n    \u001b[33m    :raises ParseException: Raised if ``parse_all`` is set and the input string does not match the whole grammar.\u001b[39;49;00m\r\n    \u001b[33m    :returns: the parsed data as a :class:`ParseResults` object, which may be accessed as a `list`, a `dict`, or\u001b[39;49;00m\r\n    \u001b[33m      an object with attributes if the given parser includes results names.\u001b[39;49;00m\r\n    \u001b[33m\u001b[39;49;00m\r\n    \u001b[33m    If the input string is required to match the entire grammar, ``parse_all`` flag must be set to ``True``. This\u001b[39;49;00m\r\n    \u001b[33m    is also equivalent to ending the grammar with :class:`StringEnd`\\\\ ().\u001b[39;49;00m\r\n    \u001b[33m\u001b[39;49;00m\r\n    \u001b[33m    To report proper column numbers, ``parse_string`` operates on a copy of the input string where all tabs are\u001b[39;49;00m\r\n    \u001b[33m    converted to spaces (8 spaces per tab, as per the default in ``string.expandtabs``). If the input string\u001b[39;49;00m\r\n"]
[6.662363, "o", "    \u001b[33m    contains tabs and the grammar uses parse actions that use the ``loc`` argument to index into the string\u001b[39;49;00m\r\n    \u001b[33m    being parsed, one can ensure a consistent view of the input string by doing one of the following:\u001b[39;49;00m\r\n    \u001b[33m\u001b[39;49;00m\r\n    \u001b[33m    - calling ``parse_with_tabs`` on your grammar before calling ``parse_string`` (see :class:`parse_with_tabs`),\u001b[39;49;00m\r\n    \u001b[33m    - define your parse action using the full ``(s,loc,toks)`` signature, and reference the input string using the\u001b[39;49;00m\r\n    \u001b[33m      parse action's ``s`` argument, or\u001b[39;49;00m\r\n    \u001b[33m    - explicitly expand the tabs in your input string before calling ``parse_string``.\u001b[39;49;00m\r\n    \u001b[33m\u001b[39;49;00m\r\n    \u001b[33m    Examples:\u001b[39;49;00m\r\n    \u001b[33m\u001b[39;49;00m\r\n    \u001b[33m    By default, partial matches are OK.\u001b[39;49;00m\r\n    \u001b[33m\u001b[39;49;00m\r\n    \u001b[33m    .. doctest::\u001b[39;49;00m\r\n    \u001b[33m\u001b[39;49;00m\r\n    \u001b[33m        >>> res = Word('a').parse_string('aaaaabaaa')\u001b[39;49;00m\r\n    \u001b[33m        >>> print(res)\u001b[39;49;00m\r\n    \u001b[33m        ['aaaaa']\u001b[39;49;00m\r\n    \u001b[33m\u001b[39;49;00m\r\n    \u001b[33m    The parsing behavior varies by the inheriting class of this abstract class. Please refer to the children\u001b[39;49;00m\r\n    \u001b[33m    directly to see more examples.\u001b[39;49;00m\r\n    \u001b[33m\u001b[39;49;00m\r\n    \u001b[33m    It raises an exception if parse_all flag is set and instring does not match the whole grammar.\u001b[39;49;00m\r\n    \u001b[33m\u001b[39;49;00m\r\n    \u001b[33m    .. doctest::\u001b[39;49;00m\r\n    \u001b[33m\u001b[39;49;00m\r\n    \u001b[33m        >>> res = Word('a').parse_string('aaaaabaaa', parse_all=True)\u001b[39;49;00m\r\n    \u001b[33m        Traceback (most recent call last):\u001b[39;49;00m\r\n    \u001b[33m        ParseException: Expected end of text, found 'b' ...\u001b[39;49;00m\r\n    \u001b[33m    \"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        parseAll: \u001b[96mbool\u001b[39;49;00m = deprecate_argument(kwargs, \u001b[33m\"\u001b[39;49;00m\u001b[33mparseAll\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[94mFalse\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        parse_all = parse_all \u001b[95mor\u001b[39;49;00m parseAll\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        ParserElement.reset_cache()\u001b[90m\u001b[39;49;00m\r\n        \u001b[94mif\u001b[39;49;00m \u001b[95mnot\u001b[39;49;00m \u001b[96mself\u001b[39;49;00m.streamlined:\u001b[90m\u001b[39;49;00m\r\n            \u001b[96mself\u001b[39;49;00m.streamline()\u001b[90m\u001b[39;49;00m\r\n        \u001b[94mfor\u001b[39;49;00m e \u001b[95min\u001b[39;49;00m \u001b[96mself\u001b[39;49;00m.ignoreExprs:\u001b[90m\u001b[39;49;00m\r\n            e.streamline()\u001b[90m\u001b[39;49;00m\r\n        \u001b[94mif\u001b[39;49;00m \u001b[95mnot\u001b[39;49;00m \u001b[96mself\u001b[39;49;00m.keepTabs:\u001b[90m\u001b[39;49;00m\r\n            instring = instring.expandtabs()\u001b[90m\u001b[39;49;00m\r\n        \u001b[94mtry\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\r\n            loc, tokens = \u001b[96mself\u001b[39;49;00m._parse(instring, \u001b[94m0\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n            \u001b[94mif\u001b[39;49;00m parse_all:\u001b[90m\u001b[39;49;00m\r\n                loc = \u001b[96mself\u001b[39;49;00m.preParse(instring, loc)\u001b[90m\u001b[39;49;00m\r\n                se = Empty() + StringEnd().set_debug(\u001b[94mFalse\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n                se._parse(instring, loc)\u001b[90m\u001b[39;49;00m\r\n        \u001b[94mexcept\u001b[39;49;00m _ParseActionIndexError \u001b[94mas\u001b[39;49;00m pa_exc:\u001b[90m\u001b[39;49;00m\r\n            \u001b[94mraise\u001b[39;49;00m pa_exc.exc\u001b[90m\u001b[39;49;00m\r\n"]
[6.662406, "o", "        \u001b[94mexcept\u001b[39;49;00m ParseBaseException \u001b[94mas\u001b[39;49;00m exc:\u001b[90m\u001b[39;49;00m\r\n            \u001b[94mif\u001b[39;49;00m ParserElement.verbose_stacktrace:\u001b[90m\u001b[39;49;00m\r\n                \u001b[94mraise\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n            \u001b[90m# catch and re-raise exception from here, clearing out pyparsing internal stack trace\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n>           \u001b[94mraise\u001b[39;49;00m exc.with_traceback(\u001b[94mNone\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n\u001b[1m\u001b[31mE           pyparsing.exceptions.ParseException: Expected SelectQuery, found 'FILTER'  (at char 817), (line:23, col:3)\u001b[0m\r\n\r\n\u001b[1m\u001b[31m.tbench-testing/lib/python3.12/site-packages/pyparsing/core.py\u001b[0m:1346: ParseException\r\n"]
