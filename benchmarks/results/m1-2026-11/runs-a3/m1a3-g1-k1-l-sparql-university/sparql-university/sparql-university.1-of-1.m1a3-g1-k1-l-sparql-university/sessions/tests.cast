[7.159911, "o", "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mtest_sparql_query_results\u001b[39;49;00m():\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"\u001b[39;49;00m\r\n    \u001b[33m    Test that the SPARQL query returns the expected professor names and countries.\u001b[39;49;00m\r\n    \u001b[33m    The order of professors and the order of countries\u001b[39;49;00m\r\n    \u001b[33m    within the country string are ignored.\u001b[39;49;00m\r\n    \u001b[33m    \"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        \u001b[90m# Load query\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        query_text = SPARQL_PATH.read_text()\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[90m# Load RDF graph\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        g = Graph()\u001b[90m\u001b[39;49;00m\r\n        g.parse(\u001b[96mstr\u001b[39;49;00m(DATA_PATH), \u001b[96mformat\u001b[39;49;00m=\u001b[33m\"\u001b[39;49;00m\u001b[33mttl\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[90m# Execute query\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n>       results = g.query(query_text)\u001b[90m\u001b[39;49;00m\r\n                  ^^^^^^^^^^^^^^^^^^^\u001b[90m\u001b[39;49;00m\r\n\r\n\u001b[1m\u001b[31m/tests/test_outputs.py\u001b[0m:62: \r\n_ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ \r\n\u001b[1m\u001b[31m.tbench-testing/lib/python3.12/site-packages/rdflib/graph.py\u001b[0m:1632: in query\r\n"]
[7.160215, "o", "    \u001b[0m\u001b[94mreturn\u001b[39;49;00m result(processor.query(query_object, initBindings, initNs, **kwargs))  \u001b[90m# type: ignore[arg-type]\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n                  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\u001b[90m\u001b[39;49;00m\r\n\u001b[1m\u001b[31m.tbench-testing/lib/python3.12/site-packages/rdflib/plugins/sparql/processor.py\u001b[0m:145: in query\r\n"]
