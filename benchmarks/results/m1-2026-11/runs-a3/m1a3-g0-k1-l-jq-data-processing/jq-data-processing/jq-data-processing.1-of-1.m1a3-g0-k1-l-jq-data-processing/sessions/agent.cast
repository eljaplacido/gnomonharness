[20.832894, "o", "\u001b[?2004h>    \r\n\u001b[?2004l\r"]
[20.832916, "o", "\u001b[?2004h> "]
[20.83294, "o", "   Requirements for the YAML file:\r\n\u001b[?2004l\r"]
[20.832953, "o", "\u001b[?2004h> "]
[20.833047, "o", "   - The '\"'\"'args'\"'\"' list should contain complete jq arguments, with both flags and their values (if any)\r\n\u001b[?2004l\r\u001b[?2004h"]
[20.83306, "o", "> "]
[20.833103, "o", "   - Each argument should be a separate string in the list\r\n\u001b[?2004l\r\u001b[?2004h"]
[20.833122, "o", "> "]
[20.833198, "o", "   - For flag-only arguments, include just the flag (e.g., '\"'\"'--unbuffered'\"'\"', '\"'\"'--tab'\"'\"')\r\n\u001b[?2004l\r\u001b[?2004h"]
[20.833213, "o", "> "]
[20.833314, "o", "   - For arguments with values, include both the flag and value as a single string (e.g., '\"'\"'--argjson min_count 5'\"'\"')\r\n\u001b[?2004l\r\u001b[?2004h"]
[20.833331, "o", "> "]
[20.833403, "o", "   - Do not include the jq command itself, the filter expression, or file paths in the args list\r\n\u001b[?2004l\r"]
[20.83342, "o", "\u001b[?2004h> "]
[20.833523, "o", "   - File paths other than the required input file '\"'\"'/app/users.json'\"'\"' and output redirections should not appear in the args\r\n\u001b[?2004l\r"]
[20.833539, "o", "\u001b[?2004h> "]
[20.833607, "o", "   - The filter should be a single string containing the complete jq filter expression\r\n\u001b[?2004l\r\u001b[?2004h"]
[20.833626, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[20.833851, "o", "**Note on examples below**: In the following Data Schema sections, all content following the '\"'\"'#'\"'\"' symbol is just explanatory commentary and will NOT appear in the actual JSON files. These comments are only provided to clarify the structure and requirements.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[20.833892, "o", "\u001b[?2004l\r\u001b[?2004h"]
[20.833908, "o", "> **Input Data Schema**:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[20.833988, "o", "The input JSON file '\"'\"'/app/users.json'\"'\"' is an array of user objects with the following structure:\r\n\u001b[?2004l\r"]
[20.834005, "o", "\u001b[?2004h> [\r\n\u001b[?2004l\r\u001b[?2004h"]
[20.834019, "o", ">   {\r\n\u001b[?2004l\r\u001b[?2004h"]
[20.834034, "o", "> "]
[20.834089, "o", "    \"id\": 1,                  # Unique numeric identifier for the user\r\n\u001b[?2004l\r\u001b[?2004h"]
[20.834103, "o", "> "]
[20.834156, "o", "    \"username\": \"john_doe\",   # User'\"'\"'s unique username (string)\r\n\u001b[?2004l\r\u001b[?2004h"]
[20.834171, "o", "> "]
[20.834225, "o", "    \"email\": \"john@example.com\",  # User'\"'\"'s email address (string)\r\n\u001b[?2004l\r\u001b[?2004h"]
[20.834244, "o", "> "]
[20.834308, "o", "    \"status\": \"active\",       # User status: '\"'\"'active'\"'\"' or '\"'\"'inactive'\"'\"'\r\n\u001b[?2004l\r"]
[20.834324, "o", "\u001b[?2004h> "]
[20.834409, "o", "    \"last_login\": \"2024-10-02T20:59:10.109812Z\",  # ISO 8601 timestamp (UTC) of the last login\r\n\u001b[?2004l\r\u001b[?2004h> "]
[20.834485, "o", "    \"roles\": [\"admin\", \"editor\"]  # Array of roles assigned to the user (may be empty)\r\n\u001b[?2004l\r\u001b[?2004h"]
[20.8345, "o", ">   },\r\n\u001b[?2004l\r\u001b[?2004h"]
[20.834516, "o", ">   ...\r\n\u001b[?2004l\r"]
[20.834529, "o", "\u001b[?2004h> ]\r\n\u001b[?2004l\r\u001b[?2004h"]
[20.834538, "o", "> \r\n\u001b[?2004l\r"]
[20.834561, "o", "\u001b[?2004h> "]
[20.834577, "o", "**Output Data Schema**:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[20.834686, "o", "The output JSON file '\"'\"'/app/active_users_report.json'\"'\"' must be an array of objects with the following structure:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[20.834698, "o", "[\r\n\u001b[?2004l\r\u001b[?2004h> "]
[20.834714, "o", "  {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[20.83478, "o", "    \"user_id\": 1,                 # Derived from '\"'\"'id'\"'\"' in input \r\n\u001b[?2004l\r"]
[20.834794, "o", "\u001b[?2004h> "]
[20.83484, "o", "    \"username\": \"john_doe\",       # Retained from input \r\n\u001b[?2004l\r\u001b[?2004h"]
[20.834855, "o", "> "]
[20.834899, "o", "    \"email\": \"john@example.com\",  # Retained from input \r\n\u001b[?2004l\r\u001b[?2004h"]
[20.83491, "o", "> "]
[20.834977, "o", "    \"last_login\": \"2024-10-02\",   # Formatted from '\"'\"'last_login'\"'\"' in input\r\n\u001b[?2004l\r\u001b[?2004h"]
[20.834998, "o", "> "]
[20.835052, "o", "    \"role_count\": 2,              # Count of '\"'\"'roles'\"'\"' from input\r\n\u001b[?2004l\r\u001b[?2004h> "]
[20.835149, "o", "    \"primary_role\": \"admin\"       # If '\"'\"'roles'\"'\"' is empty, this must be null (JSON null, not \"null\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[20.835165, "o", ">   },\r\n\u001b[?2004l\r\u001b[?2004h"]
[20.835179, "o", ">   ...\r\n\u001b[?2004l\r"]
[20.835194, "o", "\u001b[?2004h> ]\r\n\u001b[?2004l\r\u001b[?2004h"]
[20.835206, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[20.835222, "o", "> "]
[20.835263, "o", "**Requirements**:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[20.835358, "o", "- You must use jq to perform this transformation. Using other programming languages (e.g., Python, Ruby) is strictly prohibited.\r\n\u001b[?2004l\r\u001b[?2004h"]
[20.835379, "o", "> "]
