[20.830342, "o", "   - Extract '\"'\"'id'\"'\"' as '\"'\"'user_id'\"'\"'.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[20.830375, "o", "   - Extract '\"'\"'username'\"'\"'.\r\n\u001b[?2004l\r"]
[20.830384, "o", "\u001b[?2004h> "]
