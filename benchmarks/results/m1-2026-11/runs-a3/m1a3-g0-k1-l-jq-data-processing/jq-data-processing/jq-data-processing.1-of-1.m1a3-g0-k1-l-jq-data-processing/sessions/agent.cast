[20.832072, "o", "> "]
[20.832154, "o", "   '\"'\"'/app/jq_args.yaml'\"'\"' will be used to construct and execute a single jq command as follows:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[20.832291, "o", "   `jq $(yq -r '\"'\"'.args[]'\"'\"' /app/jq_args.yaml) \"$(yq -r '\"'\"'.filter'\"'\"' /app/jq_args.yaml)\" /app/users.json > /app/active_users_report.json`\r\n\u001b[?2004l\r\u001b[?2004h> "]
[20.832308, "o", "   \r\n\u001b[?2004l\r\u001b[?2004h> "]
