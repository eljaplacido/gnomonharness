#define START \
"""
#include <stdio.h>
#include <stdlib.h>
int main(int argc,char*argv[]){
    long long n=atoll(argv[1]);
    long long a=0,b=1;
    for(long long i=0;i<n;i++){
        long long t=a+b;
        a=b;
        b=t;
