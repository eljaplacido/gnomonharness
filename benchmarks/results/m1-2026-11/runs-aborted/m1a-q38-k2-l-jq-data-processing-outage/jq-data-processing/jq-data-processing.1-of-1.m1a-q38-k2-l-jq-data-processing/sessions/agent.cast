[20.514342, "o", "    \"username\": \"john_doe\",   # User'\"'\"'s unique username (string)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[20.514441, "o", "    \"email\": \"john@example.com\",  # User'\"'\"'s email address (string)\r\n\u001b[?2004l\r"]
[20.514452, "o", "\u001b[?2004h"]
[20.514477, "o", "> "]
[20.514568, "o", "    \"status\": \"active\",       # User status: '\"'\"'active'\"'\"' or '\"'\"'inactive'\"'\"'\r\n\u001b[?2004l\r"]
[20.514584, "o", "\u001b[?2004h"]
[20.5146, "o", "> "]
[20.514833, "o", "    \"last_login\": \"2024-10-02T20:59:10.109812Z\",  # ISO 8601 timestamp (UTC) of the last login\r\n\u001b[?2004l\r\u001b[?2004h> "]
