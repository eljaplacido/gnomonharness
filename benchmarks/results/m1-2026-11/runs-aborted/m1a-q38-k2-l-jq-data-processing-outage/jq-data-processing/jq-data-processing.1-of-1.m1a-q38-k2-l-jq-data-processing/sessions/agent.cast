[20.5141, "o", "[\r\n\u001b[?2004l\r"]
[20.514112, "o", "\u001b[?2004h>   {\r\n\u001b[?2004l\r"]
[20.514124, "o", "\u001b[?2004h> "]
[20.514216, "o", "    \"id\": 1,                  # Unique numeric identifier for the user\r\n\u001b[?2004l\r"]
