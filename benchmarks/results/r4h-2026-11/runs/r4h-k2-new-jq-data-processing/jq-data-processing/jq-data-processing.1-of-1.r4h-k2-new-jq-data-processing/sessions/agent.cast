[31.915924, "o", "   \r\n\u001b[?2004l\r\u001b[?2004h>    Requirements for the YAML file:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[31.916059, "o", "   - The '\"'\"'args'\"'\"' list should contain complete jq arguments, with both flags and their values (if any)\r\n\u001b[?2004l\r"]
[31.916069, "o", "\u001b[?2004h> "]
[31.916156, "o", "   - Each argument should be a separate string in the list\r\n\u001b[?2004l\r"]
[31.916196, "o", "\u001b[?2004h> "]
[31.916313, "o", "   - For flag-only arguments, include just the flag (e.g., '\"'\"'--unbuffered'\"'\"', '\"'\"'--tab'\"'\"')\r\n\u001b[?2004l\r"]
[31.91634, "o", "\u001b[?2004h> "]
[31.916497, "o", "   - For arguments with values, include both the flag and value as a single string (e.g., '\"'\"'--argjson min_count 5'\"'\"')\r\n\u001b[?2004l\r"]
[31.916504, "o", "\u001b[?2004h> "]
[31.916649, "o", "   - Do not include the jq command itself, the filter expression, or file paths in the args list\r\n\u001b[?2004l\r"]
[31.916658, "o", "\u001b[?2004h"]
[31.916695, "o", "> "]
[31.916842, "o", "   - File paths other than the required input file '\"'\"'/app/users.json'\"'\"' and output redirections should not appear in the args\r\n\u001b[?2004l\r"]
[31.916862, "o", "\u001b[?2004h"]
[31.916889, "o", "> "]
[31.916982, "o", "   - The filter should be a single string containing the complete jq filter expression\r\n\u001b[?2004l\r"]
[31.917019, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[31.917041, "o", "> "]
[31.917377, "o", "**Note on examples below**: In the following Data Schema sections, all content following the '\"'\"'#'\"'\"' symbol is just explanatory commentary and will NOT appear in the actual JSON files. These comments are only provided to clarify the structure and requirements.\r\n\u001b[?2004l\r"]
[31.91744, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[31.917473, "o", "**Input Data Schema**:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[31.917611, "o", "The input JSON file '\"'\"'/app/users.json'\"'\"' is an array of user objects with the following structure:\r\n\u001b[?2004l\r"]
[31.917639, "o", "\u001b[?2004h> [\r\n\u001b[?2004l\r"]
[31.917659, "o", "\u001b[?2004h> "]
[31.91771, "o", "  {\r\n\u001b[?2004l\r"]
[31.917738, "o", "\u001b[?2004h> "]
[31.917856, "o", "    \"id\": 1,                  # Unique numeric identifier for the user\r\n\u001b[?2004l\r\u001b[?2004h> "]
[31.917963, "o", "    \"username\": \"john_doe\",   # User'\"'\"'s unique username (string)\r\n\u001b[?2004l\r\u001b[?2004h"]
[31.917974, "o", "> "]
[31.918061, "o", "    \"email\": \"john@example.com\",  # User'\"'\"'s email address (string)\r\n\u001b[?2004l\r"]
[31.918081, "o", "\u001b[?2004h> "]
[31.91819, "o", "    \"status\": \"active\",       # User status: '\"'\"'active'\"'\"' or '\"'\"'inactive'\"'\"'\r\n\u001b[?2004l\r"]
[31.918207, "o", "\u001b[?2004h"]
[31.918219, "o", "> "]
[31.918336, "o", "    \"last_login\": \"2024-10-02T20:59:10.109812Z\",  # ISO 8601 timestamp (UTC) of the last login\r\n\u001b[?2004l\r"]
[31.918353, "o", "\u001b[?2004h"]
[31.918368, "o", "> "]
[31.91848, "o", "    \"roles\": [\"admin\", \"editor\"]  # Array of roles assigned to the user (may be empty)\r\n\u001b[?2004l\r"]
[31.918496, "o", "\u001b[?2004h> "]
[31.91851, "o", "  },\r\n\u001b[?2004l\r"]
[31.918522, "o", "\u001b[?2004h> "]
[31.918537, "o", "  ...\r\n\u001b[?2004l\r"]
[31.918554, "o", "\u001b[?2004h> "]
[31.918566, "o", "]\r\n\u001b[?2004l\r\u001b[?2004h"]
[31.918575, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[31.918595, "o", "> "]
[31.918617, "o", "**Output Data Schema**:\r\n\u001b[?2004l\r"]
[31.918634, "o", "\u001b[?2004h> "]
[31.918824, "o", "The output JSON file '\"'\"'/app/active_users_report.json'\"'\"' must be an array of objects with the following structure:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[31.918875, "o", "[\r\n\u001b[?2004l\r\u001b[?2004h>   {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[31.918972, "o", "    \"user_id\": 1,                 # Derived from '\"'\"'id'\"'\"' in input \r\n\u001b[?2004l\r"]
[31.918991, "o", "\u001b[?2004h> "]
[31.919143, "o", "    \"username\": \"john_doe\",       # Retained from input \r\n\u001b[?2004l\r\u001b[?2004h> "]
[31.91917, "o", "    \"email\": \"john@example.com\",  # Retained from input \r\n\u001b[?2004l\r"]
[31.919186, "o", "\u001b[?2004h"]
[31.919206, "o", "> "]
[31.919304, "o", "    \"last_login\": \"2024-10-02\",   # Formatted from '\"'\"'last_login'\"'\"' in input\r\n\u001b[?2004l\r"]
[31.919312, "o", "\u001b[?2004h"]
[31.91935, "o", "> "]
[31.919426, "o", "    \"role_count\": 2,              # Count of '\"'\"'roles'\"'\"' from input\r\n\u001b[?2004l\r\u001b[?2004h"]
[31.919448, "o", "> "]
[31.919589, "o", "    \"primary_role\": \"admin\"       # If '\"'\"'roles'\"'\"' is empty, this must be null (JSON null, not \"null\")\r\n\u001b[?2004l\r"]
[31.919612, "o", "\u001b[?2004h>   },\r\n\u001b[?2004l\r"]
[31.919641, "o", "\u001b[?2004h> "]
[31.919649, "o", "  ...\r\n\u001b[?2004l\r"]
[31.919682, "o", "\u001b[?2004h> ]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[31.919693, "o", "\u001b[?2004h> "]
[31.919739, "o", "**Requirements**:\r\n\u001b[?2004l\r\u001b[?2004h"]
[31.919757, "o", "> "]
[31.919942, "o", "- You must use jq to perform this transformation. Using other programming languages (e.g., Python, Ruby) is strictly prohibited.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[31.920042, "o", "- Ensure that the output JSON is properly formatted with 2-space indentation.\r\n\u001b[?2004l\r"]
[31.920053, "o", "\u001b[?2004h"]
[31.920062, "o", "> "]
[31.920244, "o", "- The output file must be created at the exact path '\"'\"'/app/active_users_report.json'\"'\"'.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[31.920505, "o", "- The jq command used to generate the output(along with the output redirection) must be saved to '\"'\"'/app/cmd.sh'\"'\"'. This file will be used to verify the correctness of your solution.\r\n\u001b[?2004l\r"]
[31.920523, "o", "\u001b[?2004h> "]
