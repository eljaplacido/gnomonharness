[31.914877, "o", "   '\"'\"'/app/jq_args.yaml'\"'\"' will be used to construct and execute a single jq command as follows:\r\n\u001b[?2004l\r\u001b[?2004h>    `jq $(yq -r '\"'\"'.args[]'\"'\"' /app/jq_args.yaml) \"$(yq -r '\"'\"'.filter'\"'\"' /app/jq_args.yaml)\" /app/users.json > /app/active_users_report.json`\r\n\u001b[?2004l\r\u001b[?2004h>    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[31.91494, "o", "   For the example above, the constructed command would be:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[31.915127, "o", "   `jq --unbuffered --argjson min_count 5 --tab '\"'\"'group_by(.address.city)'\"'\"' /app/users.json > /app/active_users_report.json`\r\n\u001b[?2004l\r\u001b[?2004h> "]
[31.915178, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[31.915206, "o", "   This means:\r\n\u001b[?2004l\r\u001b[?2004h> "]
