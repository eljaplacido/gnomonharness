[31.915537, "o", "   3. The input file '\"'\"'/app/users.json'\"'\"' is fixed and will be used as input\r\n\u001b[?2004l\r\u001b[?2004h"]
[31.915547, "o", "> "]
[31.915699, "o", "   4. The output will be redirected to '\"'\"'/app/active_users_report.json'\"'\"'\r\n\u001b[?2004l\r"]
[31.915726, "o", "\u001b[?2004h> "]
