#!/usr/bin/env python3
"""LoRA fine-tuning of openai-community/gpt2 for biomedical multiple-choice QA.

Task: given a biomedical question and four options (A-D), output the correct
letter.

Method:
  * LoRA r=8, alpha=16, target_modules=["c_attn"], task_type=CAUSAL_LM (PEFT).
  * The loss is computed on the answer-letter token only (" A"/" B"/" C"/" D"
    followed by EOS), after a prompt that ends in "Answer:".
  * Five prompt templates are sampled per training example so the adapter
    does not depend on one exact prompt wording at evaluation time.
  * Batches are built from length-sorted examples, so CPU padding is small.
  * After every epoch the validation set is scored over the four letter
    logits for every template; the best epoch by mean validation accuracy is
    kept.

Outputs:
  /app/experiments/lora_adapter/   adapter_config.json, adapter_model.safetensors,
                                   tokenizer_config.json, tokenizer files
  /app/experiments/training_metrics.json
  /app/lora_results.json

Usage:
  python3 /app/train_lora.py --epochs 8
"""

import argparse
import json
import math
import os
import random
import re
import time

os.environ.setdefault("TOKENIZERS_PARALLELISM", "false")

import torch
from peft import LoraConfig, TaskType, get_peft_model
from transformers import AutoModelForCausalLM, AutoTokenizer

LETTERS = ["A", "B", "C", "D"]
BASE_MODEL = "openai-community/gpt2"
LORA_R = 8
LORA_ALPHA = 16
LORA_TARGETS = ["c_attn"]

TEMPLATES = [
    "Question: {q}\nA. {a}\nB. {b}\nC. {c}\nD. {d}\nAnswer:",
    "{q}\nA) {a}\nB) {b}\nC) {c}\nD) {d}\nAnswer:",
    "Q: {q}\n(a) {a}\n(b) {b}\n(c) {c}\n(d) {d}\nA:",
    "Answer the following multiple choice question about biology.\n\n"
    "Question: {q}\nA. {a}\nB. {b}\nC. {c}\nD. {d}\nAnswer:",
    "Question: {q}\nOption A: {a}\nOption B: {b}\nOption C: {c}\nOption D: {d}\n"
    "Correct answer:",
]

_OPT_PREFIX = re.compile(r"^\s*[A-Da-d]\s*[\.\):]\s*")


def clean_option(text):
    """Strip a leading 'A. ' / 'B) ' label from an option string."""
    return _OPT_PREFIX.sub("", str(text)).strip()


def build_prompt(item, tpl_idx):
    opts = [clean_option(o) for o in item["options"]]
    while len(opts) < 4:
        opts.append("")
    return TEMPLATES[tpl_idx].format(
        q=item["question"].strip(),
        a=opts[0],
        b=opts[1],
        c=opts[2],
        d=opts[3],
    )


def load_split(path):
    with open(path, "r", encoding="utf-8") as fh:
        raw = json.load(fh)
    items = []
    for it in raw:
        answer = str(it.get("answer", "")).strip().upper()[:1]
        options = it.get("options") or []
        if answer not in LETTERS or len(options) != 4:
            continue
        items.append(
            {
                "question": it["question"],
                "options": [str(o) for o in options],
                "answer": answer,
            }
        )
    return items


def encode_example(tok, item, tpl_idx, ans_ids, eos_id, max_len):
    """Prompt tokens (labels masked) + answer-letter token(s) + EOS (labelled)."""
    prompt_ids = tok(build_prompt(item, tpl_idx), add_special_tokens=False)["input_ids"]
    ans = list(ans_ids[item["answer"]])
    keep = max_len - len(ans) - 1
    if keep > 0 and len(prompt_ids) > keep:
        prompt_ids = prompt_ids[-keep:]
    elif keep <= 0:
        prompt_ids = []
    input_ids = list(prompt_ids) + ans + [eos_id]
    labels = [-100] * len(prompt_ids) + ans + [eos_id]
    return input_ids, labels


def collate(batch, pad_id):
    width = max(len(b["input_ids"]) for b in batch)
    input_ids, labels, attn = [], [], []
    for b in batch:
        n = len(b["input_ids"])
        pad = width - n
        input_ids.append(b["input_ids"] + [pad_id] * pad)
        labels.append(b["labels"] + [-100] * pad)
        attn.append([1] * n + [0] * pad)
    return {
        "input_ids": torch.tensor(input_ids, dtype=torch.long),
        "attention_mask": torch.tensor(attn, dtype=torch.long),
        "labels": torch.tensor(labels, dtype=torch.long),
    }


def make_batches(indices, lens, batch_size, shuffle, rng):
    order = sorted(indices, key=lambda i: lens[i])
    batches = [order[i : i + batch_size] for i in range(0, len(order), batch_size)]
    if shuffle:
        rng.shuffle(batches)
    return batches


@torch.no_grad()
def score_accuracy(model, tok, items, letter_ids, pad_id, max_len, batch_size=16, tpl_idx=0):
    """Pick the letter with the highest logit at the end of the prompt."""
    model.eval()
    prompts = []
    for it in items:
        ids = tok(build_prompt(it, tpl_idx), add_special_tokens=False)["input_ids"]
        if max_len > 0 and len(ids) > max_len:
            ids = ids[-max_len:]
        prompts.append(ids)

    correct = 0
    preds = []
    for start in range(0, len(prompts), batch_size):
        chunk = prompts[start : start + batch_size]
        width = max(len(c) for c in chunk)
        input_ids = [c + [pad_id] * (width - len(c)) for c in chunk]
        attn = [[1] * len(c) + [0] * (width - len(c)) for c in chunk]
        feats = {
            "input_ids": torch.tensor(input_ids, dtype=torch.long),
            "attention_mask": torch.tensor(attn, dtype=torch.long),
        }
        logits = model(**feats).logits
        last = feats["attention_mask"].sum(dim=1) - 1
        rows = torch.arange(logits.size(0))
        letter_logits = logits[rows, last][:, letter_ids]
        pick = letter_logits.argmax(dim=-1).tolist()
        for j, p in enumerate(pick):
            preds.append(LETTERS[p])
            correct += int(LETTERS[p] == items[start + j]["answer"])
    return correct / max(1, len(items)), preds


@torch.no_grad()
def generation_accuracy(model, tok, items, pad_id, max_new_tokens=2, tpl_idx=0):
    """Greedy-decode after the prompt and parse the first A-D letter."""
    model.eval()
    correct = 0
    preds = []
    for it in items:
        ids = tok(build_prompt(it, tpl_idx), add_special_tokens=False, return_tensors="pt")["input_ids"]
        out = model.generate(
            input_ids=ids,
            max_new_tokens=max_new_tokens,
            do_sample=False,
            pad_token_id=pad_id,
            eos_token_id=pad_id,
        )
        text = tok.decode(out[0, ids.shape[1] :], skip_special_tokens=True)
        m = re.search(r"[ABCDabcd]", text)
        pred = m.group(0).upper() if m else "?"
        preds.append(pred)
        correct += int(pred == it["answer"])
    return correct / max(1, len(items)), preds


def letter_baseline_accuracy(items):
    counts = {L: sum(1 for it in items if it["answer"] == L) for L in LETTERS}
    return max(counts.values()) / max(1, len(items)), counts


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--train", default="/app/data/train.json")
    ap.add_argument("--val", default="/app/data/val.json")
    ap.add_argument("--out-dir", default="/app/experiments/lora_adapter")
    ap.add_argument("--results", default="/app/lora_results.json")
    ap.add_argument("--metrics", default="/app/experiments/training_metrics.json")
    ap.add_argument("--epochs", type=int, default=8)
    ap.add_argument("--batch-size", type=int, default=16)
    ap.add_argument("--lr", type=float, default=2e-4)
    ap.add_argument("--max-len", type=int, default=512)
    ap.add_argument("--limit", type=int, default=0)
    ap.add_argument("--seed", type=int, default=42)
    ap.add_argument("--threads", type=int, default=0)
    ap.add_argument("--no-results", action="store_true")
    args = ap.parse_args()

    if args.threads:
        torch.set_num_threads(args.threads)
    random.seed(args.seed)
    torch.manual_seed(args.seed)
    rng = random.Random(args.seed)
    t0 = time.time()

    train_items = load_split(args.train)
    val_items = load_split(args.val)
    if args.limit:
        train_items = train_items[: args.limit]
        val_items = val_items[: max(8, args.limit // 3)]

    print("=" * 70, flush=True)
    print("base model      :", BASE_MODEL, flush=True)
    print("lora            : r=%d alpha=%d targets=%s" % (LORA_R, LORA_ALPHA, LORA_TARGETS), flush=True)
    print("train / val     : %d / %d" % (len(train_items), len(val_items)), flush=True)
    print("epochs          : %d  batch %d  lr %g  max_len %d" % (args.epochs, args.batch_size, args.lr, args.max_len), flush=True)
    base_acc, label_counts = letter_baseline_accuracy(val_items)
    print("val label counts:", label_counts, flush=True)
    print("always-one-letter val accuracy: %.4f" % base_acc, flush=True)
    print("=" * 70, flush=True)

    tok = AutoTokenizer.from_pretrained(BASE_MODEL)
    if tok.pad_token is None:
        tok.pad_token = tok.eos_token
    pad_id = tok.pad_token_id
    eos_id = tok.eos_token_id

    ans_ids = {}
    for L in LETTERS:
        ids = tok(" " + L, add_special_tokens=False)["input_ids"]
        if len(ids) != 1:
            raise SystemExit("letter %r is not a single token: %r" % (L, ids))
        ans_ids[L] = ids
    letter_ids = [ans_ids[L][0] for L in LETTERS]
    print("letter token ids:", dict(zip(LETTERS, letter_ids)), flush=True)

    model = get_peft_model(
        AutoModelForCausalLM.from_pretrained(BASE_MODEL),
        LoraConfig(
            r=LORA_R,
            lora_alpha=LORA_ALPHA,
            target_modules=LORA_TARGETS,
            lora_dropout=0.05,
            bias="none",
            task_type=TaskType.CAUSAL_LM,
        ),
    )
    model.print_trainable_parameters()
    params = [p for p in model.parameters() if p.requires_grad]
    n_trainable = sum(p.numel() for p in params)

    opt = torch.optim.AdamW(params, lr=args.lr, weight_decay=0.0)
    lens = [len(it["question"]) + sum(len(o) for o in it["options"]) for it in train_items]
    steps_per_epoch = math.ceil(len(train_items) / args.batch_size)
    total_steps = max(1, steps_per_epoch * args.epochs)
    warmup = max(1, int(0.05 * total_steps))

    best = {"score": -1.0, "epoch": 0, "state": None, "per_template": []}
    history = []
    step = 0

    for epoch in range(1, args.epochs + 1):
        model.train()
        ep_loss, n_batches = 0.0, 0
        ep_start = time.time()
        for batch_indices in make_batches(range(len(train_items)), lens, args.batch_size, True, rng):
            batch = []
            for i in batch_indices:
                input_ids, labels = encode_example(
                    tok,
                    train_items[i],
                    rng.randrange(len(TEMPLATES)),
                    ans_ids,
                    eos_id,
                    args.max_len,
                )
                batch.append({"input_ids": input_ids, "labels": labels})
            feats = collate(batch, pad_id)
            loss = model(**feats).loss
            loss.backward()
            torch.nn.utils.clip_grad_norm_(params, 1.0)
            if step < warmup:
                lr = args.lr * (step + 1) / warmup
            else:
                prog = (step - warmup) / max(1, total_steps - warmup)
                lr = args.lr * 0.5 * (1.0 + math.cos(math.pi * min(1.0, prog)))
            for group in opt.param_groups:
                group["lr"] = lr
            opt.step()
            opt.zero_grad()
            step += 1
            ep_loss += float(loss.detach())
            n_batches += 1

        per_template = []
        for t in range(len(TEMPLATES)):
            acc, _ = score_accuracy(model, tok, val_items, letter_ids, pad_id, args.max_len, tpl_idx=t)
            per_template.append(round(acc, 4))
        mean_acc = sum(per_template) / len(per_template)
        rec = {
            "epoch": epoch,
            "train_loss": round(ep_loss / max(1, n_batches), 4),
            "val_acc_per_template": per_template,
            "val_acc_mean": round(mean_acc, 4),
            "epoch_seconds": round(time.time() - ep_start, 1),
            "elapsed_seconds": round(time.time() - t0, 1),
        }
        history.append(rec)
        print("EPOCH " + json.dumps(rec), flush=True)

        if mean_acc > best["score"]:
            best = {
                "score": mean_acc,
                "epoch": epoch,
                "per_template": per_template,
                "state": {
                    k: v.detach().clone().cpu()
                    for k, v in model.state_dict().items()
                    if "lora_" in k
                },
            }
            print("  --> new best mean val accuracy %.4f at epoch %d" % (mean_acc, epoch), flush=True)

    if best["state"] is None:
        raise SystemExit("training produced no checkpoint")
    missing, unexpected = model.load_state_dict(best["state"], strict=False)
    print("restored epoch %d (mean val acc %.4f)" % (best["epoch"], best["score"]), flush=True)

    final_scores = {}
    for t in range(len(TEMPLATES)):
        acc, _ = score_accuracy(model, tok, val_items, letter_ids, pad_id, args.max_len, tpl_idx=t)
        final_scores["template_%d" % t] = round(acc, 4)
    gen_acc, gen_preds = generation_accuracy(model, tok, val_items, pad_id, tpl_idx=0)
    print("final template score acc:", final_scores, flush=True)
    print("final generation acc (template 0): %.4f" % gen_acc, flush=True)

    os.makedirs(args.out_dir, exist_ok=True)
    model.save_pretrained(args.out_dir)
    tok.save_pretrained(args.out_dir)

    cfg_path = os.path.join(args.out_dir, "adapter_config.json")
    with open(cfg_path, "r", encoding="utf-8") as fh:
        cfg = json.load(fh)
    cfg["base_model_name_or_path"] = BASE_MODEL
    cfg["task_type"] = cfg.get("task_type") or "CAUSAL_LM"
    with open(cfg_path, "w", encoding="utf-8") as fh:
        json.dump(cfg, fh, indent=2, sort_keys=True)
        fh.write("\n")

    if not args.no_results:
        results = {
            "model": BASE_MODEL,
            "lora_config": {"r": LORA_R, "alpha": LORA_ALPHA, "epochs": args.epochs},
            "training_samples": len(train_items),
            "validation_samples": len(val_items),
        }
        parent = os.path.dirname(args.results)
        if parent:
            os.makedirs(parent, exist_ok=True)
        with open(args.results, "w", encoding="utf-8") as fh:
            json.dump(results, fh, indent=2)
            fh.write("\n")
        print("wrote", args.results, json.dumps(results), flush=True)

    metrics = {
        "base_model": BASE_MODEL,
        "lora": {"r": LORA_R, "alpha": LORA_ALPHA, "target_modules": LORA_TARGETS, "task_type": "CAUSAL_LM"},
        "hyperparameters": {
            "epochs": args.epochs,
            "batch_size": args.batch_size,
            "lr": args.lr,
            "max_len": args.max_len,
            "seed": args.seed,
        },
        "train_samples": len(train_items),
        "val_samples": len(val_items),
        "val_letter_counts": label_counts,
        "always_one_letter_val_acc": round(base_acc, 4),
        "trainable_params": n_trainable,
        "best_epoch": best["epoch"],
        "best_mean_val_acc": round(best["score"], 4),
        "best_epoch_per_template": best["per_template"],
        "final_template_score_acc": final_scores,
        "final_generation_acc_template0": round(gen_acc, 4),
        "final_generation_predictions_sample": gen_preds[:20],
        "history": history,
        "total_seconds": round(time.time() - t0, 1),
    }
    parent = os.path.dirname(args.metrics)
    if parent:
        os.makedirs(parent, exist_ok=True)
    with open(args.metrics, "w", encoding="utf-8") as fh:
        json.dump(metrics, fh, indent=2)
        fh.write("\n")
    print("adapter saved to", args.out_dir, os.listdir(args.out_dir), flush=True)
    print("DONE in %.1fs" % (time.time() - t0), flush=True)


if __name__ == "__main__":
    main()
