import mujoco, numpy as np

REF_PATH = "/app/model_ref.xml"
TOTAL_T, ATOL = 2.0, 1e-5
REF_TEXT = open(REF_PATH).read()
ANCHOR = '<compiler autolimits="true"/>'

CANDIDATES = {
    "dt002_pgsdense": {"solver": "PGS", "iterations": "200", "tolerance": "1e-10", "jacobian": "dense"},
    "dt0025_pgsdense": {"solver": "PGS", "iterations": "200", "tolerance": "1e-10", "jacobian": "dense", "timestep": "0.0025"},
    "dt003125_pgsdense": {"solver": "PGS", "iterations": "200", "tolerance": "1e-10", "jacobian": "dense", "timestep": "0.003125"},
    "dt004_pgsdense": {"solver": "PGS", "iterations": "200", "tolerance": "1e-10", "jacobian": "dense", "timestep": "0.004"},
    "dt0025_pgsdense_it50": {"solver": "PGS", "iterations": "50", "tolerance": "1e-10", "jacobian": "dense", "timestep": "0.0025"},
}

def make_xml(opts):
    if not opts:
        return REF_TEXT
    elem = "<option" + "".join(' %s="%s"' % (k, v) for k, v in opts.items()) + "/>"
    return REF_TEXT.replace(ANCHOR, ANCHOR + "\n  " + elem)

def load(opts):
    return mujoco.MjModel.from_xml_string(make_xml(opts))

def simulate(model, seed, keep_time_series=False):
    data = mujoco.MjData(model)
    nstep = int(TOTAL_T / model.opt.timestep)
    rng = np.random.default_rng(seed)
    data.qpos += rng.normal(0, 0.01, size=data.qpos.shape)
    mujoco.mj_forward(model, data)
    for _ in range(nstep):
        mujoco.mj_step(model, data)
    full = mujoco.mjtState.mjSTATE_FULLPHYSICS
    state = np.zeros(mujoco.mj_stateSize(model, full))
    mujoco.mj_getState(model, data, state, full)
    assert not np.isnan(state).any() and not np.isinf(state).any()
    return state

def timing(model, n=20):
    out = []
    for seed in range(n):
        t0 = time.perf_counter()
        simulate(model, seed)
        out.append(time.perf_counter() - t0)
    return np.array(out)

# seed sweep: 300 seeds spread over the range eval.py draws from
seeds = list(range(0, 150)) + list(range(9850, 10000)) + list(range(5000, 5100))
mref = load({})
ref_states = {s: simulate(mref, s) for s in seeds}
ref_times = timing(mref)
print("ref mean %.4f s, %d seeds swept" % (ref_times.mean(), len(seeds)))
print()
rows = []
for name, opts in CANDIDATES.items():
    m = load(opts)
    worst, wseed, nfail = 0.0, -1, 0
    for s in seeds:
        st = simulate(m, s)
        ref = ref_states[s]
        d = float(np.abs(st - ref).max())
        if d > worst:
            worst, wseed = d, s
        if not np.allclose(st, ref, atol=ATOL):
            nfail += 1
    times = timing(m)
    ratio = float((times / ref_times).mean())
    rows.append((name, ratio, worst, wseed, nfail, float(times.mean()), str({k: str(getattr(m.opt, k)) for k in opts})))
    print("%-22s mean=%.4f ratio=%.3f worst|d|=%.2e (seed %d) fails=%d/%d" % (
        name, times.mean(), ratio, worst, wseed, nfail, len(seeds)))
print()
for r in sorted(rows, key=lambda x: x[1]):
    print(r)
