import json, os, sys, time
import mujoco, numpy as np

REF_PATH = "/app/model_ref.xml"
TOTAL_T, ATOL, N_TIMING, N_DIFF = 2.0, 1e-5, 20, 50
RESULTS = "/tmp/tune_results.jsonl"
REF_TEXT = open(REF_PATH).read()
ANCHOR = '<compiler autolimits="true"/>'

VARIANTS = {
    "ref": {},
    "dense": {"jacobian": "dense"},
    "pgs100": {"solver": "PGS", "iterations": "100", "tolerance": "1e-8"},
    "pgs200t10": {"solver": "PGS", "iterations": "200", "tolerance": "1e-10"},
    "pgs500t12": {"solver": "PGS", "iterations": "500", "tolerance": "1e-12"},
    "pgsdense100": {"solver": "PGS", "iterations": "100", "tolerance": "1e-8", "jacobian": "dense"},
    "pgsdense200": {"solver": "PGS", "iterations": "200", "tolerance": "1e-10", "jacobian": "dense"},
    "cgdense": {"solver": "CG", "jacobian": "dense"},
    "implfast": {"integrator": "implicitfast"},
    "dt0025pgs": {"solver": "PGS", "iterations": "200", "tolerance": "1e-10", "timestep": "0.0025"},
    "dt0025pgsdense": {"solver": "PGS", "iterations": "200", "tolerance": "1e-10", "timestep": "0.0025", "jacobian": "dense"},
    "dt003125pgsdense": {"solver": "PGS", "iterations": "200", "tolerance": "1e-10", "timestep": "0.003125", "jacobian": "dense"},
}

def make_xml(opts):
    if not opts:
        return REF_TEXT
    elem = "<option" + "".join(' %s="%s"' % (k, v) for k, v in opts.items()) + "/>"
    assert REF_TEXT.count(ANCHOR) == 1
    return REF_TEXT.replace(ANCHOR, ANCHOR + "\n  " + elem)

def load(opts):
    return mujoco.MjModel.from_xml_string(make_xml(opts))

def simulate(model, seed):
    data = mujoco.MjData(model)
    nstep = int(TOTAL_T / model.opt.timestep)
    rng = np.random.default_rng(seed)
    data.qpos += rng.normal(0, 0.01, size=data.qpos.shape)
    mujoco.mj_forward(model, data)
    for _ in range(nstep):
        mujoco.mj_step(model, data)
    full = mujoco.mjtState.mjSTATE_FULLPHYSICS
    state = np.zeros(mujoco.mj_stateSize(model, full))
    mujoco.mj_getState(model, data, state, full)
    assert not np.isnan(state).any() and not np.isinf(state).any()
    return state

def timing(model):
    out = []
    for seed in range(N_TIMING):
        t0 = time.perf_counter()
        simulate(model, seed)
        out.append(time.perf_counter() - t0)
    return np.array(out)

def ref_cached():
    if os.path.exists(RESULTS):
        for line in open(RESULTS):
            rec = json.loads(line)
            if rec["name"] == "ref":
                return np.array(rec["times"]), rec["states"]
    m = load({})
    times = timing(m)
    states = [simulate(m, s).tolist() for s in range(N_DIFF)]
    open(RESULTS, "a").write(json.dumps({"name": "ref", "times": times.tolist(), "states": states}) + "\n")
    return times, states

def main(names):
    ref_times, ref_states = ref_cached()
    print("reference mean %.4f s (%d seeds cached)\n" % (ref_times.mean(), len(ref_states)))
    rows = []
    for name in names:
        opts = VARIANTS[name]
        model = load(opts)
        applied = {k: getattr(model.opt, k) for k in opts}
        worst, nfail = 0.0, 0
        for s in range(N_DIFF):
            st = simulate(model, s)
            ref = np.array(ref_states[s])
            worst = max(worst, float(np.abs(st - ref).max()))
            if not np.allclose(st, ref, atol=ATOL):
                nfail += 1
        times = timing(model)
        ratio = float((times / ref_times).mean())
        rec = {"name": name, "opts": opts, "applied": {k: str(v) for k, v in applied.items()},
               "mean": float(times.mean()), "ratio": ratio, "worst_abs_diff": worst,
               "nfail": nfail, "nseed": N_DIFF, "times": times.tolist()}
        open(RESULTS, "a").write(json.dumps(rec) + "\n")
        rows.append(rec)
        print("%-18s mean=%.4f ratio=%.3f worst|d|=%.2e fails=%d/%d applied=%s" % (
            name, times.mean(), ratio, worst, nfail, N_DIFF, {k: str(v) for k, v in applied.items()}))
    print("\nSUMMARY (best first)")
    for rec in sorted(rows, key=lambda r: r["ratio"]):
        ok = "OK " if (rec["ratio"] <= 0.6 and rec["nfail"] == 0) else "   "
        print("%s%-18s ratio=%.3f worst|d|=%.2e" % (ok, rec["name"], rec["ratio"], rec["worst_abs_diff"]))

if __name__ == "__main__":
    main(sys.argv[1:])
