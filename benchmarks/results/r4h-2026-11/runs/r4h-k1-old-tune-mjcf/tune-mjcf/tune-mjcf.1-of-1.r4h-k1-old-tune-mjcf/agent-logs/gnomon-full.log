import mujoco
import numpy as np
import time

model = mujoco.MjModel.from_xml_path("model_ref.xml")

total_sim_time = 2.0
n_runs = 20

def simulate_model(model, seed):
    data = mujoco.MjData(model)
    nstep = int(total_sim_time / model.opt.timestep)
    rng = np.random.default_rng(seed)
    data.qpos += rng.normal(0, 0.01, size=data.qpos.shape)
    mujoco.mj_forward(model, data)
    for _ in range(nstep):
        mujoco.mj_step(model, data)
    return data

times = []
for i in range(n_runs):
    seed = np.random.randint(0, 10000)
    t_start = time.perf_counter()
    _ = simulate_model(model, seed)
    t_end = time.perf_counter()
    elapsed = t_end - t_start
    times.append(elapsed)
    print(f"  run {i+1}/{n_runs}: {elapsed:.4f}s")

print(f"\nMean wall seconds: {np.mean(times):.4f}")
print(f"Std: {np.std(times):.4f}")
print(f"Min: {np.min(times):.4f}, Max: {np.max(times):.4f}")
