import mujoco
import numpy as np
import time

model = mujoco.MjModel.from_xml_path("model_ref.xml")
data = mujoco.MjData(model)

seed = 42
nstep = int(2.0 / model.opt.timestep)
print(f"timestep: {model.opt.timestep}, nstep: {nstep}")

rng = np.random.default_rng(seed)
data.qpos += rng.normal(0, 0.01, size=data.qpos.shape)
mujoco.mj_forward(model, data)

# Track at specific times
t_01_seen = False
t_10_seen = False
max_qvel_01 = None
max_qvel_10 = None
con_steps = 0
max_ncon = 0
wall_start = time.perf_counter()

for step in range(nstep):
    mujoco.mj_step(model, data)
    t = data.time
    
    if not t_01_seen and t >= 0.1:
        t_01_seen = True
        max_qvel_01 = np.max(np.abs(data.qvel))
        print(f"t={t:.4f}: max|qvel|={max_qvel_01:.6f}, max|qpos|={np.max(np.abs(data.qpos)):.6f}, ncon={data.ncon}, nefc={data.nefc}")
    
    if not t_10_seen and t >= 1.0:
        t_10_seen = True
        max_qvel_10 = np.max(np.abs(data.qvel))
        print(f"t={t:.4f}: max|qvel|={max_qvel_10:.6f}, max|qpos|={np.max(np.abs(data.qpos)):.6f}, ncon={data.ncon}, nefc={data.nefc}")
    
    if data.ncon > 0:
        con_steps += 1
    if data.ncon > max_ncon:
        max_ncon = data.ncon

wall_time = time.perf_counter() - wall_start

print(f"\n=== Final state at t=2.0s ===")
print(f"data.time: {data.time}")
print(f"ncon: {data.ncon}")
print(f"data.nefc: {data.nefc}")
print(f"max|qvel|: {np.max(np.abs(data.qvel)):.6f}")
print(f"max|qpos|: {np.max(np.abs(data.qpos)):.6f}")
print(f"\n=== Convergence ===")
print(f"max|qvel| at t=0.1s: {max_qvel_01}")
print(f"max|qvel| at t=1.0s: {max_qvel_10}")
print(f"Steps with ncon>0: {con_steps} / {nstep}")
print(f"Max ncon seen: {max_ncon}")
print(f"Wall time: {wall_time:.4f}s")
