import time
import mujoco
import numpy as np
from copy import deepcopy

# Load reference model
model_ref = mujoco.MjModel.from_xml_path("model_ref.xml")
nstep = int(2.0 / model_ref.opt.timestep)  # 1000
n_runs = 20

def simulate_and_time(model, seed):
    """Run the same protocol as eval.py: jiggle qpos, forward, nstep mj_step calls"""
    data = mujoco.MjData(model)
    rng = np.random.default_rng(seed)
    data.qpos += rng.normal(0, 0.01, size=data.qpos.shape)
    mujoco.mj_forward(model, data)
    for _ in range(nstep):
        mujoco.mj_step(model, data)
    full_physics = mujoco.mjtState.mjSTATE_FULLPHYSICS
    state = np.zeros(mujoco.mj_stateSize(model, full_physics))
    mujoco.mj_getState(model, data, state, full_physics)
    return state

def get_mean_time(model, n_runs=n_runs):
    times = []
    for _ in range(n_runs):
        seed = np.random.randint(0, 10000)
        t0 = time.perf_counter()
        simulate_and_time(model, seed)
        t1 = time.perf_counter()
        times.append(t1 - t0)
    return np.mean(times)

def get_max_state_diff(model, model_ref, seeds=range(5)):
    max_diff = 0.0
    for seed in seeds:
        state = simulate_and_time(model, seed)
        state_ref = simulate_and_time(model_ref, seed)
        diff = np.max(np.abs(state - state_ref))
        if diff > max_diff:
            max_diff = diff
    return max_diff

# --- Variant definitions ---
# All variants load model_ref.xml text and make minimal XML/opt changes

def build_variant_xml(variant):
    """Build XML string for a variant by modifying model_ref.xml text"""
    with open("model_ref.xml", "r") as f:
        xml = f.read()
    
    if variant == "A":
        # baseline reference - no changes
        pass
    elif variant == "B":
        # contact disable
        xml = xml.replace("<compiler autolimits=\"true\"/>",
                          "<compiler autolimits=\"true\"/>\n  <option>\n    <flag contact=\"disable\"/>\n  </option>")
    elif variant == "C":
        # jacobian dense
        xml = xml.replace("<compiler autolimits=\"true\"/>",
                          "<compiler autolimits=\"true\"/>\n  <option jacobian=\"dense\"/>")
    elif variant == "D":
        # jacobian sparse
        xml = xml.replace("<compiler autolimits=\"true\"/>",
                          "<compiler autolimits=\"true\"/>\n  <option jacobian=\"sparse\"/>")
    elif variant == "E":
        # solver CG with iterations=100 tolerance=1e-8
        xml = xml.replace("<compiler autolimits=\"true\"/>",
                          "<compiler autolimits=\"true\"/>\n  <option solver=\"CG\" iterations=\"100\" tolerance=\"1e-8\"/>")
    elif variant == "F":
        # solver PGS
        xml = xml.replace("<compiler autolimits=\"true\"/>",
                          "<compiler autolimits=\"true\"/>\n  <option solver=\"PGS\"/>")
    elif variant == "G":
        # iterations=50
        xml = xml.replace("<compiler autolimits=\"true\"/>",
                          "<compiler autolimits=\"true\"/>\n  <option iterations=\"50\"/>")
    elif variant == "H":
        # integrator implicit
        xml = xml.replace("<compiler autolimits=\"true\"/>",
                          "<compiler autolimits=\"true\"/>\n  <option integrator=\"implicit\"/>")
    elif variant == "I":
        # integrator implicitfast
        xml = xml.replace("<compiler autolimits=\"true\"/>",
                          "<compiler autolimits=\"true\"/>\n  <option integrator=\"implicitfast\"/>")
    elif variant == "J":
        # B + C combined: contact disable + jacobian dense
        xml = xml.replace("<compiler autolimits=\"true\"/>",
                          "<compiler autolimits=\"true\"/>\n  <option jacobian=\"dense\">\n    <flag contact=\"disable\"/>\n  </option>")
    elif variant == "K":
        # B + H combined: contact disable + integrator implicit
        xml = xml.replace("<compiler autolimits=\"true\"/>",
                          "<compiler autolimits=\"true\"/>\n  <option integrator=\"implicit\">\n    <flag contact=\"disable\"/>\n  </option>")
    
    return xml

# Write variant XMLs to /tmp and load them
variants = {
    "A": "baseline reference",
    "B": "contact disable",
    "C": "jacobian dense",
    "D": "jacobian sparse",
    "E": "solver CG iter=100 tol=1e-8",
    "F": "solver PGS",
    "G": "iterations=50",
    "H": "integrator implicit",
    "I": "integrator implicitfast",
    "J": "contact disable + jacobian dense",
    "K": "contact disable + integrator implicit",
}

results = {}

for vname, vdesc in variants.items():
    print(f"\n{'='*60}")
    print(f"Variant {vname}: {vdesc}")
    print(f"{'='*60}")
    
    xml = build_variant_xml(vname)
    xml_path = f"/tmp/model_variant_{vname}.xml"
    with open(xml_path, "w") as f:
        f.write(xml)
    
    try:
        model = mujoco.MjModel.from_xml_path(xml_path)
        print(f"  Compiled OK: nq={model.nq}, nv={model.nv}, nbody={model.nbody}, ngeom={model.ngeom}")
        print(f"  dt={model.opt.timestep}, solver={model.opt.solver}, integrator={model.opt.integrator}")
        print(f"  jacobian={model.opt.jacobian}, iterations={model.opt.iterations}, tolerance={model.opt.tolerance}")
        
        # Check nefc/ncon after forward
        data = mujoco.MjData(model)
        mujoco.mj_forward(model, data)
        print(f"  nefc={data.nefc}, ncon={data.ncon}")
        
        # Time it
        mean_time = get_mean_time(model)
        print(f"  Mean time ({n_runs} runs): {mean_time:.4f}s")
        
        # State diff vs reference
        max_diff = get_max_state_diff(model, model_ref)
        print(f"  Max abs state diff vs ref (seeds 0-4): {max_diff:.6e}")
        
        results[vname] = {
            "mean_time": mean_time,
            "max_diff": max_diff,
            "nq": model.nq,
            "nv": model.nv,
            "nefc": data.nefc,
            "ncon": data.ncon,
        }
    except Exception as e:
        print(f"  ERROR: {e}")
        results[vname] = {"error": str(e)}

# --- Summary ---
print(f"\n{'='*60}")
print("SUMMARY")
print(f"{'='*60}")
print(f"{'Var':>4s} {'Description':<35s} {'Mean Time':>10s} {'Speedup':>8s} {'Max Diff':>12s} {'nq':>4s} {'nv':>4s} {'nefc':>5s} {'ncon':>5s}")
print("-" * 100)

ref_mean = results["A"]["mean_time"]
for vname in sorted(results.keys()):
    r = results[vname]
    if "error" in r:
        print(f"{vname:>4s} {r['error'][:35]:<35s}")
        continue
    speedup = ref_mean / r["mean_time"] if r["mean_time"] > 0 else float('inf')
    print(f"{vname:>4s} {variants[vname][:35]:<35s} {r['mean_time']:>10.4f}s {speedup:>7.2f}x {r['max_diff']:>12.6e} {r['nq']:>4d} {r['nv']:>4d} {r['nefc']:>5d} {r['ncon']:>5d}")

