[35.804901, "o", "   - Group \"research\": full rwx permissions (both current and default)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.804978, "o", "   - Users \"alice\" and \"bob\": full rwx permissions (both current and default)  \r\n\u001b[?2004l\r\u001b[?2004h>    - Others: no permissions (both current and default)\r\n\u001b[?2004l\r"]
[35.805029, "o", "\u001b[?2004h>    - Set proper mask to allow full permissions\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.805076, "o", "3. The ACL configuration must ensure that:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.805154, "o", "   - Any file created by alice or bob in /srv/shared is accessible by both users\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.805235, "o", "   - The permissions are inherited by subdirectories and files\r\n\u001b[?2004l\r\u001b[?2004h> "]
