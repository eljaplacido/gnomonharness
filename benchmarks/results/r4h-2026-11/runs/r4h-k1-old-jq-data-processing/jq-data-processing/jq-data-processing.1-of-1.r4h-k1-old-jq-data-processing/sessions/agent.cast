[24.642541, "o", "\u001b[?2004h> "]
[24.642606, "o", "   - The '\"'\"'args'\"'\"' list should contain complete jq arguments, with both flags and their values (if any)\r\n\u001b[?2004l\r"]
[24.642629, "o", "\u001b[?2004h> "]
[24.642663, "o", "   - Each argument should be a separate string in the list\r\n\u001b[?2004l\r"]
[24.642686, "o", "\u001b[?2004h> "]
[24.642757, "o", "   - For flag-only arguments, include just the flag (e.g., '\"'\"'--unbuffered'\"'\"', '\"'\"'--tab'\"'\"')\r\n\u001b[?2004l\r"]
[24.642764, "o", "\u001b[?2004h> "]
[24.6429, "o", "   - For arguments with values, include both the flag and value as a single string (e.g., '\"'\"'--argjson min_count 5'\"'\"')\r\n\u001b[?2004l\r\u001b[?2004h> "]
