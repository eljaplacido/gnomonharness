[24.641465, "o", "\u001b[?2004h> "]
[24.641478, "o", "   ```\r\n\u001b[?2004l\r\u001b[?2004h> "]
[24.641506, "o", "   filter: \"group_by(.address.city)\"\r\n\u001b[?2004l\r"]
[24.641532, "o", "\u001b[?2004h> "]
[24.641559, "o", "   args:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[24.641582, "o", "     - \"--unbuffered\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[24.641608, "o", "     - \"--argjson min_count 5\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[24.64163, "o", ">      - \"--tab\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[24.641655, "o", "   ```\r\n\u001b[?2004l\r\u001b[?2004h>    \r\n\u001b[?2004l\r"]
[24.641663, "o", "\u001b[?2004h> "]
[24.641734, "o", "   '\"'\"'/app/jq_args.yaml'\"'\"' will be used to construct and execute a single jq command as follows:\r\n\u001b[?2004l\r\u001b[?2004h"]
[24.641751, "o", "> "]
[24.64187, "o", "   `jq $(yq -r '\"'\"'.args[]'\"'\"' /app/jq_args.yaml) \"$(yq -r '\"'\"'.filter'\"'\"' /app/jq_args.yaml)\" /app/users.json > /app/active_users_report.json`\r\n\u001b[?2004l\r"]
[24.641883, "o", "\u001b[?2004h"]
[24.641894, "o", ">    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[24.641944, "o", "   For the example above, the constructed command would be:\r\n\u001b[?2004l\r"]
[24.641965, "o", "\u001b[?2004h> "]
[24.642061, "o", "   `jq --unbuffered --argjson min_count 5 --tab '\"'\"'group_by(.address.city)'\"'\"' /app/users.json > /app/active_users_report.json`\r\n\u001b[?2004l\r"]
[24.642067, "o", "\u001b[?2004h> "]
[24.64207, "o", "\r\n\u001b[?2004l\r"]
