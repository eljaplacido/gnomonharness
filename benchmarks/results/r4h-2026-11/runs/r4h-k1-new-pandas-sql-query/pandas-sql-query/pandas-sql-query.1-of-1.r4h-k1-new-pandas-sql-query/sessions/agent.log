# Top 3 per category by total_sales DESC, product_id ASC
revenue["rn"] = revenue.groupby("category")["total_sales"].rank(method="first", ascending=False).astype(int)
# Actually need proper row_number: sort then groupby cumcount
revenue = revenue.sort_values(["category", "total_sales", "product_id"], ascending=[True, False, True])
revenue["rn"] = revenue.groupby("category").cumcount() + 1
top3_pd = revenue[revenue["rn"] <= 3][["category", "product_id"]].sort_values(["category", "product_id"]).groupby("category")["product_id"].apply(list).to_dict()

