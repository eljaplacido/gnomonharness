[6.799997, "o", "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mtest_current_acl_settings\u001b[39;49;00m():\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"Test current ACL settings on the directory\"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        acl_output = sh(\u001b[33m\"\u001b[39;49;00m\u001b[33mgetfacl -p /srv/shared\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m).stdout\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[90m# Check required ACL entries\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        required_acls = [\u001b[90m\u001b[39;49;00m\r\n            \u001b[33m\"\u001b[39;49;00m\u001b[33muser:alice:rwx\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\r\n            \u001b[33m\"\u001b[39;49;00m\u001b[33muser:bob:rwx\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\r\n            \u001b[33m\"\u001b[39;49;00m\u001b[33mgroup:research:rwx\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\r\n            \u001b[33m\"\u001b[39;49;00m\u001b[33mother::---\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\r\n        ]\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[94mfor\u001b[39;49;00m acl \u001b[95min\u001b[39;49;00m required_acls:\u001b[90m\u001b[39;49;00m\r\n>           \u001b[94massert\u001b[39;49;00m acl \u001b[95min\u001b[39;49;00m acl_output, (\u001b[90m\u001b[39;49;00m\r\n                \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mMissing ACL entry: \u001b[39;49;00m\u001b[33m{\u001b[39;49;00macl\u001b[33m}\u001b[39;49;00m\u001b[33m\\n\u001b[39;49;00m\u001b[33mFull output:\u001b[39;49;00m\u001b[33m\\n\u001b[39;49;00m\u001b[33m{\u001b[39;49;00macl_output\u001b[33m}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n            )\u001b[90m\u001b[39;49;00m\r\n\u001b[1m\u001b[31mE           AssertionError: Missing ACL entry: group:research:rwx\u001b[0m\r\n\u001b[1m\u001b[31mE             Full output:\u001b[0m\r\n\u001b[1m\u001b[31mE             # file: /srv/shared\u001b[0m\r\n"]
[6.800079, "o", "\u001b[1m\u001b[31mE             # owner: root\u001b[0m\r\n\u001b[1m\u001b[31mE             # group: research\u001b[0m\r\n\u001b[1m\u001b[31mE             # flags: -s-\u001b[0m\r\n\u001b[1m\u001b[31mE             user::rwx\u001b[0m\r\n\u001b[1m\u001b[31mE             user:alice:rwx\u001b[0m\r\n\u001b[1m\u001b[31mE             user:bob:rwx\u001b[0m\r\n\u001b[1m\u001b[31mE             group::rwx\u001b[0m\r\n\u001b[1m\u001b[31mE             mask::rwx\u001b[0m\r\n\u001b[1m\u001b[31mE             other::---\u001b[0m\r\n\u001b[1m\u001b[31mE             default:user::rwx\u001b[0m\r\n\u001b[1m\u001b[31mE             default:user:alice:rwx\u001b[0m\r\n\u001b[1m\u001b[31mE             default:user:bob:rwx\u001b[0m\r\n\u001b[1m\u001b[31mE             default:group::rwx\u001b[0m\r\n\u001b[1m\u001b[31mE             default:mask::rwx\u001b[0m\r\n\u001b[1m\u001b[31mE             default:other::---\u001b[0m\r\n\u001b[1m\u001b[31mE             \u001b[0m\r\n\u001b[1m\u001b[31mE             \u001b[0m\r\n\u001b[1m\u001b[31mE           assert 'group:research:rwx' in '# file: /srv/shared\\n# owner: root\\n# group: research\\n# flags: -s-\\nuser::rwx\\nuser:alice:rwx\\nuser:bob:rwx\\ngroup::...user::rwx\\ndefault:user:alice:rwx\\ndefault:user:bob:rwx\\ndefault:group::rwx\\ndefault:mask::rwx\\ndefault:other::---\\n\\n'\u001b[0m\r\n\r\n\u001b[1m\u001b[31m/tests/test_outputs.py\u001b[0m:48: AssertionError\r\n\u001b[31m\u001b[1m_________________________________________________________________ test_default_acl_inheritance _________________________________________________________________\u001b[0m\r\n\r\n"]
[6.800423, "o", "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mtest_default_acl_inheritance\u001b[39;49;00m():\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"Test default ACL settings for inheritance\"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        acl_output = sh(\u001b[33m\"\u001b[39;49;00m\u001b[33mgetfacl -p /srv/shared\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m).stdout\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[90m# Check required default ACL entries\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        required_default_acls = [\u001b[90m\u001b[39;49;00m\r\n            \u001b[33m\"\u001b[39;49;00m\u001b[33mdefault:user::rwx\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\r\n            \u001b[33m\"\u001b[39;49;00m\u001b[33mdefault:user:alice:rwx\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\r\n            \u001b[33m\"\u001b[39;49;00m\u001b[33mdefault:user:bob:rwx\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\r\n            \u001b[33m\"\u001b[39;49;00m\u001b[33mdefault:group::rwx\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\r\n            \u001b[33m\"\u001b[39;49;00m\u001b[33mdefault:group:research:rwx\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\r\n            \u001b[33m\"\u001b[39;49;00m\u001b[33mdefault:mask::rwx\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\r\n            \u001b[33m\"\u001b[39;49;00m\u001b[33mdefault:other::---\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\r\n        ]\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[94mfor\u001b[39;49;00m acl \u001b[95min\u001b[39;49;00m required_default_acls:\u001b[90m\u001b[39;49;00m\r\n>           \u001b[94massert\u001b[39;49;00m acl \u001b[95min\u001b[39;49;00m acl_output, (\u001b[90m\u001b[39;49;00m\r\n                \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mMissing default ACL entry: \u001b[39;49;00m\u001b[33m{\u001b[39;49;00macl\u001b[33m}\u001b[39;49;00m\u001b[33m\\n\u001b[39;49;00m\u001b[33mFull output:\u001b[39;49;00m\u001b[33m\\n\u001b[39;49;00m\u001b[33m{\u001b[39;49;00macl_output\u001b[33m}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n            )\u001b[90m\u001b[39;49;00m\r\n\u001b[1m\u001b[31mE           AssertionError: Missing default ACL entry: default:group:research:rwx\u001b[0m\r\n\u001b[1m\u001b[31mE             Full output:\u001b[0m\r\n\u001b[1m\u001b[31mE             # file: /srv/shared\u001b[0m\r\n"]
[6.800483, "o", "\u001b[1m\u001b[31mE             # owner: root\u001b[0m\r\n\u001b[1m\u001b[31mE             # group: research\u001b[0m\r\n\u001b[1m\u001b[31mE             # flags: -s-\u001b[0m\r\n\u001b[1m\u001b[31mE             user::rwx\u001b[0m\r\n\u001b[1m\u001b[31mE             user:alice:rwx\u001b[0m\r\n\u001b[1m\u001b[31mE             user:bob:rwx\u001b[0m\r\n\u001b[1m\u001b[31mE             group::rwx\u001b[0m\r\n\u001b[1m\u001b[31mE             mask::rwx\u001b[0m\r\n\u001b[1m\u001b[31mE             other::---\u001b[0m\r\n\u001b[1m\u001b[31mE             default:user::rwx\u001b[0m\r\n\u001b[1m\u001b[31mE             default:user:alice:rwx\u001b[0m\r\n\u001b[1m\u001b[31mE             default:user:bob:rwx\u001b[0m\r\n"]
[6.800498, "o", "\u001b[1m\u001b[31mE             default:group::rwx\u001b[0m\r\n\u001b[1m\u001b[31mE             default:mask::rwx\u001b[0m\r\n\u001b[1m\u001b[31mE             default:other::---\u001b[0m\r\n\u001b[1m\u001b[31mE             \u001b[0m\r\n\u001b[1m\u001b[31mE             \u001b[0m\r\n\u001b[1m\u001b[31mE           assert 'default:group:research:rwx' in '# file: /srv/shared\\n# owner: root\\n# group: research\\n# flags: -s-\\nuser::rwx\\nuser:alice:rwx\\nuser:bob:rwx\\ngroup::...user::rwx\\ndefault:user:alice:rwx\\ndefault:user:bob:rwx\\ndefault:group::rwx\\ndefault:mask::rwx\\ndefault:other::---\\n\\n'\u001b[0m\r\n\r\n\u001b[1m\u001b[31m/tests/test_outputs.py\u001b[0m:69: AssertionError\r\n\u001b[31m\u001b[1m________________________________________________________________ test_subdirectory_inheritance _________________________________________________________________\u001b[0m\r\n\r\n"]
[6.800885, "o", "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mtest_subdirectory_inheritance\u001b[39;49;00m():\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"Test that subdirectories inherit correct permissions\"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        \u001b[90m# Clean up any existing test directory\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        sh(\u001b[33m\"\u001b[39;49;00m\u001b[33mrm -rf /srv/shared/test_subdir\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, check=\u001b[94mFalse\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[90m# Alice creates a subdirectory\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        alice_mkdir = sh(\u001b[33m\"\u001b[39;49;00m\u001b[33mrunuser -u alice -- bash -lc \u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33mmkdir /srv/shared/test_subdir\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n        \u001b[94massert\u001b[39;49;00m alice_mkdir.returncode == \u001b[94m0\u001b[39;49;00m, (\u001b[90m\u001b[39;49;00m\r\n            \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mAlice cannot create subdirectory: \u001b[39;49;00m\u001b[33m{\u001b[39;49;00malice_mkdir.stderr\u001b[33m}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        )\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[90m# Check subdirectory permissions\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        subdir_acl = sh(\u001b[33m\"\u001b[39;49;00m\u001b[33mgetfacl -p /srv/shared/test_subdir\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m).stdout\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[90m# Verify key permissions are inherited\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        \u001b[94massert\u001b[39;49;00m \u001b[33m\"\u001b[39;49;00m\u001b[33muser:alice:rwx\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m \u001b[95min\u001b[39;49;00m subdir_acl, \u001b[33m\"\u001b[39;49;00m\u001b[33mSubdirectory missing alice ACL\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        \u001b[94massert\u001b[39;49;00m \u001b[33m\"\u001b[39;49;00m\u001b[33muser:bob:rwx\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m \u001b[95min\u001b[39;49;00m subdir_acl, \u001b[33m\"\u001b[39;49;00m\u001b[33mSubdirectory missing bob ACL\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n"]
[6.800936, "o", ">       \u001b[94massert\u001b[39;49;00m \u001b[33m\"\u001b[39;49;00m\u001b[33mgroup:research:rwx\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m \u001b[95min\u001b[39;49;00m subdir_acl, \u001b[33m\"\u001b[39;49;00m\u001b[33mSubdirectory missing research group ACL\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n\u001b[1m\u001b[31mE       AssertionError: Subdirectory missing research group ACL\u001b[0m\r\n\u001b[1m\u001b[31mE       assert 'group:research:rwx' in '# file: /srv/shared/test_subdir\\n# owner: alice\\n# group: research\\n# flags: -s-\\nuser::rwx\\nuser:alice:rwx\\nuser:bob...user::rwx\\ndefault:user:alice:rwx\\ndefault:user:bob:rwx\\ndefault:group::rwx\\ndefault:mask::rwx\\ndefault:other::---\\n\\n'\u001b[0m\r\n\r\n\u001b[1m\u001b[31m/tests/test_outputs.py\u001b[0m:171: AssertionError\r\n"]
[6.800972, "o", "\u001b[31m\u001b[1m______________________________________________________________ test_file_permissions_inheritance _______________________________________________________________\u001b[0m\r\n\r\n"]
[6.801198, "o", "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mtest_file_permissions_inheritance\u001b[39;49;00m():\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"Test that newly created files have correct permissions\"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        \u001b[90m# Clean up\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        sh(\u001b[33m\"\u001b[39;49;00m\u001b[33mrm -f /srv/shared/test_perms.txt\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, check=\u001b[94mFalse\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n"]
[6.801239, "o", "        \u001b[90m# Alice creates a file\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        sh(\u001b[33m\"\u001b[39;49;00m\u001b[33mrunuser -u alice -- bash -lc \u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33mecho \u001b[39;49;00m\u001b[33m\\\"\u001b[39;49;00m\u001b[33mtest\u001b[39;49;00m\u001b[33m\\\"\u001b[39;49;00m\u001b[33m > /srv/shared/test_perms.txt\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[90m# Check file ACLs\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        file_acl = sh(\u001b[33m\"\u001b[39;49;00m\u001b[33mgetfacl -p /srv/shared/test_perms.txt\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m).stdout\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[90m# Verify inherited ACLs\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        \u001b[94massert\u001b[39;49;00m \u001b[33m\"\u001b[39;49;00m\u001b[33muser:alice:rwx\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m \u001b[95min\u001b[39;49;00m file_acl, \u001b[33m\"\u001b[39;49;00m\u001b[33mFile missing alice ACL\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        \u001b[94massert\u001b[39;49;00m \u001b[33m\"\u001b[39;49;00m\u001b[33muser:bob:rwx\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m \u001b[95min\u001b[39;49;00m file_acl, \u001b[33m\"\u001b[39;49;00m\u001b[33mFile missing bob ACL\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n>       \u001b[94massert\u001b[39;49;00m \u001b[33m\"\u001b[39;49;00m\u001b[33mgroup:research:rwx\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m \u001b[95min\u001b[39;49;00m file_acl, \u001b[33m\"\u001b[39;49;00m\u001b[33mFile missing research group ACL\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n\u001b[1m\u001b[31mE       AssertionError: File missing research group ACL\u001b[0m\r\n\u001b[1m\u001b[31mE       assert 'group:research:rwx' in '# file: /srv/shared/test_perms.txt\\n# owner: alice\\n# group: research\\nuser::rw-\\nuser:alice:rwx\\t#effective:rw-\\nuser:bob:rwx\\t#effective:rw-\\ngroup::rwx\\t#effective:rw-\\nmask::rw-\\nother::---\\n\\n'\u001b[0m\r\n\r\n\u001b[1m\u001b[31m/tests/test_outputs.py\u001b[0m:251: AssertionError\r\n"]
