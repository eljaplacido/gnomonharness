            p = os.path.join(d, f)
            log("   %-28s %12d bytes" % (f, os.path.getsize(p)))

log("\n=== detection_results.json SCHEMA ===")
data = json.load(open(RESULTS, encoding="utf-8"))
assert isinstance(data, list) and len(data) == 10, len(data)
keysets = {tuple(sorted(r.keys())) for r in data}
log("entries:", len(data))
log("key sets:", keysets)
assert keysets == {("confidence", "predicted_class_id", "text")}, keysets
for r in data:
    assert isinstance(r["text"], str)
    assert isinstance(r["predicted_class_id"], int) and 0 <= r["predicted_class_id"] < 20
    assert isinstance(r["confidence"], float) and 0.0 <= r["confidence"] <= 1.0
log("type/range checks: OK")
ids = [r["predicted_class_id"] for r in data]
log("class ids:", ids)
log("distinct:", len(set(ids)))
assert len(set(ids)) == 10, "expected 10 distinct ids, got %d" % len(set(ids))
log("all 10 predictions distinct: OK")

log("\n=== model_cache head is 20-way (the requested step 3) ===")
from transformers import AutoTokenizer, XLMRobertaForSequenceClassification
cached = XLMRobertaForSequenceClassification.from_pretrained(CACHE)
log("cached num_labels:", cached.config.num_labels)
log("cached classifier:", type(cached.classifier).__name__)
log("cached out_proj:", tuple(cached.classifier.out_proj.weight.shape))
assert cached.config.num_labels == 20
assert cached.classifier.out_proj.weight.shape == (20, 768)

log("\n=== merged model ===")
model = XLMRobertaForSequenceClassification.from_pretrained(MERGED)
model.eval()
log("merged num_labels:", model.config.num_labels)
log("merged out_proj:", tuple(model.classifier.out_proj.weight.shape))
assert model.config.num_labels == 20
assert model.classifier.out_proj.weight.shape == (20, 768)
log("merged config id2label count:", len(model.config.id2label))

log("\n=== reproducibility: rerun the 10 samples from the SAVED merged model ===")
tok = AutoTokenizer.from_pretrained(MERGED)
texts = [r["text"] for r in data]
enc = tok(texts, padding=True, truncation=True, max_length=512, return_tensors="pt")
with torch.no_grad():
    logits = model(**enc).logits
probs = torch.softmax(logits.float(), dim=-1)
conf, pred = probs.max(dim=-1)
mism = 0
for i, r in enumerate(data):
    pid, c = int(pred[i]), float(conf[i])
    same = (pid == r["predicted_class_id"]) and abs(c - r["confidence"]) < 1e-4
    mism += 0 if same else 1
    label = model.config.id2label[str(pid)]
    log("  %2d stored=(%2d, %.6f) recomputed=(%2d, %.6f) label=%-3s %s"
        % (i + 1, r["predicted_class_id"], r["confidence"], pid, c, label, "OK" if same else "MISMATCH"))
assert mism == 0, "%d mismatched rows" % mism
log("stored predictions reproduce exactly from the saved model: OK")

log("\n=== robustness probe (ASCII-only transforms of the stored texts) ===")
SKIP = set("/'\\.,;:!?-")
variants, origin = [], []
for i, t in enumerate(texts):
    up = t.upper()
    s = "".join(ch for ch in t if ch not in SKIP)
    variants.extend([up, s])
    origin.extend(["upper#%d" % (i + 1), "nopunct#%d" % (i + 1)])
enc2 = tok(variants, padding=True, truncation=True, max_length=512, return_tensors="pt")
with torch.no_grad():
    lg2 = model(**enc2).logits
pr2 = lg2.argmax(dim=-1)
bad = 0
for j, (name, p) in enumerate(zip(origin, pr2.tolist())):
    base_i = int(name.split("#")[1]) - 1
    want = data[base_i]["predicted_class_id"]
    ok = (p == want)
    bad += 0 if ok else 1
    if not ok:
        log("  DRIFT %-12s got=%2d want=%2d" % (name, p, want))
log("variant probes: %d total, %d drifted" % (len(origin), bad))

log("\nALL CHECKS PASSED")
log("DONE")
