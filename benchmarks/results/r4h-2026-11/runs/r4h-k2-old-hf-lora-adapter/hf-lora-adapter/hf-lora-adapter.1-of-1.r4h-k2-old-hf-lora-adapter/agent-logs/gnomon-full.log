import json
import os
import torch

RESULTS = "/app/detection_results.json"
MERGED = "/app/merged_model"
CACHE = "/app/model_cache/xlm-roberta-base"


def log(*a):
    print(*a, flush=True)


log("=== ARTIFACTS ===")
for d in (CACHE, MERGED):
    ok = os.path.isdir(d)
    log("%s exists=%s" % (d, ok))
    if ok:
