import json, os
from collections import defaultdict
from huggingface_hub import HfApi, hf_hub_download, snapshot_download
from safetensors.torch import load_file

ADAPTER = "dominguesm/xlm-roberta-base-lora-language-detection"
BASE = "FacebookAI/xlm-roberta-base"
CACHE = "/tmp/hf_cache"
os.environ.setdefault("HF_HUB_DISABLE_TELEMETRY", "1")

api = HfApi()
files = sorted(api.list_repo_files(ADAPTER))
print("=== ADAPTER REPO FILES ===")
for f in files:
    print(" ", f)

local = snapshot_download(ADAPTER, cache_dir=CACHE)
print("\n=== LOCAL FILE SIZES ===")
for root, _d, fns in os.walk(local):
    for fn in sorted(fns):
        p = os.path.join(root, fn)
        print("  %-60s %12d" % (os.path.relpath(p, local), os.path.getsize(p)))

acfg_path = os.path.join(local, "adapter_config.json")
print("\n=== adapter_config.json ===")
if os.path.exists(acfg_path):
    print(json.dumps(json.load(open(acfg_path)), indent=2, sort_keys=True))
else:
    print("MISSING")

print("\n=== OTHER SMALL TEXT FILES ===")
for root, _d, fns in os.walk(local):
    for fn in sorted(fns):
        p = os.path.join(root, fn)
        rel = os.path.relpath(p, local)
        if rel == "adapter_config.json":
            continue
        if os.path.getsize(p) < 20000 and rel.endswith((".json", ".txt", ".md", ".jsonl")):
            print("--- %s ---" % rel)
            print(open(p, encoding="utf-8", errors="replace").read()[:4000])

print("\n=== ADAPTER TENSORS ===")
groups = defaultdict(list)
for sf in [f for f in files if f.endswith(".safetensors")]:
    p = hf_hub_download(ADAPTER, sf, cache_dir=CACHE)
    for k, v in load_file(p).items():
        parts = k.split(".")
        idx = next((i for i, x in enumerate(parts) if x.isdigit()), None)
        groups[".".join(parts[:idx]) if idx else "<none>"].append((k, tuple(v.shape)))
    print("file:", sf)

for g in sorted(groups):
    ents = groups[g]
    print("\n[%s] %d tensors" % (g, len(ents)))
    for k, s in ents:
        print("   ", k, s)

tot = sum(1 for _ in ())

print("\n=== BASE MODEL config.json ===")
print(json.dumps(json.load(open(hf_hub_download(BASE, "config.json", cache_dir=CACHE))), indent=2, sort_keys=True))
print("\nDONE")
