import json, os, shutil
os.environ.setdefault("HF_HUB_DISABLE_TELEMETRY", "1")
os.environ.setdefault("TOKENIZERS_PARALLELISM", "false")

import torch
from huggingface_hub import snapshot_download
from safetensors.torch import load_file, save_file
from transformers import AutoTokenizer, XLMRobertaForSequenceClassification
from peft import PeftModel

BASE_ID = "FacebookAI/xlm-roberta-base"
ADAPTER_ID = "dominguesm/xlm-roberta-base-lora-language-detection"
HF_CACHE = "/app/.hf_cache"
CACHE = "/app/model_cache/xlm-roberta-base"
MERGED = "/app/merged_model"
WORK = "/app/.build/adapter_local"
RESULTS = "/app/detection_results.json"
NUM_LABELS = 20

TEXTS = [
    "Bonjour, comment allez-vous aujourd'hui?",
    "Hola, \u00bfc\u00f3mo est\u00e1s hoy?",
    "Guten Tag, wie geht es Ihnen?",
    "Ciao, come stai oggi?",
    "Ol\u00e1, como voc\u00ea est\u00e1?",
    "\u041f\u0440\u0438\u0432\u0435\u0442, \u043a\u0430\u043a \u0434\u0435\u043b\u0430?",
    "\u3053\u3093\u306b\u3061\u306f\u3001\u304a\u5143\u6c17\u3067\u3059\u304b\uff1f",
    "\u4f60\u597d\uff0c\u4f60\u597d\u304b\uff1f",
    "\u0645\u0631\u062d\u0628\u0627\u060c \u0643\u064a\u0641 \u062d\u0627\u0644\u0643\u061f",
    "Hello, how are you?",
]


def log(*a):
    print(*a, flush=True)


def head_tensors(sd):
    """Pull the classification head out of the adapter checkpoint, tolerating
    both old-PEFT plain `classifier.*` and new `classifier.modules_to_save.default.*`."""
    out = {}
    for k, v in sd.items():
        if "classifier" not in k:
            continue
        for suffix in ("dense.weight", "dense.bias", "out_proj.weight", "out_proj.bias"):
            if k.endswith(suffix):
                out[suffix] = v
    return out


def main():
    torch.set_num_threads(min(20, os.cpu_count() or 4))
    os.makedirs(os.path.dirname(CACHE), exist_ok=True)
    os.makedirs(HF_CACHE, exist_ok=True)

    log("== 1. adapter metadata ==")
    adapter_repo = snapshot_download(ADAPTER_ID, cache_dir=HF_CACHE)
    with open(os.path.join(adapter_repo, "adapter_config.json")) as fh:
        acfg = json.load(fh)
    log("adapter_config:", json.dumps(acfg, sort_keys=True))

    lcfg_path = os.path.join(adapter_repo, "config.json")
    if os.path.exists(lcfg_path):
        with open(lcfg_path) as fh:
            lcfg = json.load(fh)
        id2label = {int(k): v for k, v in lcfg["id2label"].items()}
    else:
        id2label = {i: "LABEL_%d" % i for i in range(NUM_LABELS)}
    label2id = {v: k for k, v in id2label.items()}
    assert len(id2label) == NUM_LABELS, "expected %d labels, got %d" % (NUM_LABELS, len(id2label))
    log("id2label:", json.dumps({str(k): v for k, v in sorted(id2label.items())}))

    log("== 2. tokenizer ==")
    tokenizer = AutoTokenizer.from_pretrained(BASE_ID, cache_dir=HF_CACHE)
    log("tokenizer:", type(tokenizer).__name__, "vocab", len(tokenizer))

    log("== 3. base model with %d classes ==" % NUM_LABELS)
    base = XLMRobertaForSequenceClassification.from_pretrained(
        BASE_ID, num_labels=NUM_LABELS, id2label=id2label, label2id=label2id, cache_dir=HF_CACHE
    )
    log("classifier type:", type(base.classifier).__name__)
    log("classifier out_proj:", tuple(base.classifier.out_proj.weight.shape))
    log("classifier dense:", tuple(base.classifier.dense.weight.shape))
    assert base.classifier.out_proj.out_features == NUM_LABELS, "head is not %d-way" % NUM_LABELS
    assert isinstance(base.classifier.out_proj, torch.nn.Linear)

    log("== 4. save base + tokenizer -> %s ==" % CACHE)
    base.save_pretrained(CACHE, safe_serialization=True)
    tokenizer.save_pretrained(CACHE)
    log("saved:", sorted(os.listdir(CACHE)))

    log("== 5. adapter weights -> local safetensors ==")
    if os.path.isdir(WORK):
        shutil.rmtree(WORK)
    os.makedirs(WORK)
    shutil.copy(os.path.join(adapter_repo, "adapter_config.json"), os.path.join(WORK, "adapter_config.json"))
    src_st = os.path.join(adapter_repo, "adapter_model.safetensors")
    src_bin = os.path.join(adapter_repo, "adapter_model.bin")
    if os.path.exists(src_st):
        sd = load_file(src_st)
        log("source: adapter_model.safetensors")
    else:
        sd = torch.load(src_bin, map_location="cpu", weights_only=True)
        log("source: adapter_model.bin")
    sd = {k: v.contiguous().clone() for k, v in sd.items() if isinstance(v, torch.Tensor)}
    log("adapter tensors:", len(sd))
    save_file(sd, os.path.join(WORK, "adapter_model.safetensors"))

    lora_keys = [k for k in sd if "lora_A" in k or "lora_B" in k]
    log("lora tensors:", len(lora_keys))

    heads = head_tensors(sd)
    log("head tensors found:", json.dumps({k: tuple(v.shape) for k, v in sorted(heads.items())}))
    assert set(heads) == {"dense.weight", "dense.bias", "out_proj.weight", "out_proj.bias"}, \
        "adapter head incomplete: %s" % sorted(heads)
    assert heads["out_proj.weight"].shape[0] == NUM_LABELS, \
        "adapter head is not %d-way: %s" % (NUM_LABELS, tuple(heads["out_proj.weight"].shape))
    assert heads["dense.weight"].shape == (768, 768), tuple(heads["dense.weight"].shape)

    log("== 6. reload base from cache, apply LoRA ==")
    base = XLMRobertaForSequenceClassification.from_pretrained(CACHE)
    base.eval()
    q_before = {i: base.roberta.encoder.layer[i].attention.self.query.weight.detach().clone()
                for i in (0, 6, 11)}
    peft_model = PeftModel.from_pretrained(base, WORK)
    log("peft model:", type(peft_model).__name__)

    log("== 7. merge_and_unload ==")
    merged = peft_model.merge_and_unload()
    merged.eval()
    left = [n for n, _ in merged.named_modules() if "lora" in n.lower()]
    log("lora modules remaining:", len(left))
    assert not left, left[:5]

    log("classifier type after merge:", type(merged.classifier).__name__)
    if hasattr(merged.classifier, "modules_to_save"):
        log("!! modules_to_save wrapper survived merge; reading head through it")
        inner = merged.classifier.modules_to_save["default"]
        head_mod = inner
    else:
        head_mod = merged.classifier

    for i, w in q_before.items():
        d = (merged.roberta.encoder.layer[i].attention.self.query.weight.detach() - w).abs().max().item()
        log("   layer %2d query delta: %.6e" % (i, d))
        assert d > 1e-5, "LoRA delta did not land in layer %d" % i

    diffs = {}
    with torch.no_grad():
        diffs["dense.weight"] = (head_mod.dense.weight.detach().float() - heads["dense.weight"].float()).abs().max().item()
        diffs["dense.bias"] = (head_mod.dense.bias.detach().float() - heads["dense.bias"].float()).abs().max().item()
        diffs["out_proj.weight"] = (head_mod.out_proj.weight.detach().float() - heads["out_proj.weight"].float()).abs().max().item()
        diffs["out_proj.bias"] = (head_mod.out_proj.bias.detach().float() - heads["out_proj.bias"].float()).abs().max().item()
    log("head max|diff| vs adapter:", json.dumps({k: "%.3e" % v for k, v in diffs.items()}))

    if max(diffs.values()) > 1e-6:
        log("!! PEFT did not restore the trained head; copying it in from the adapter checkpoint")
        with torch.no_grad():
            head_mod.dense.weight.copy_(heads["dense.weight"].float())
            head_mod.dense.bias.copy_(heads["dense.bias"].float())
            head_mod.out_proj.weight.copy_(heads["out_proj.weight"].float())
            head_mod.out_proj.bias.copy_(heads["out_proj.bias"].float())
            diffs = {
                "dense.weight": (head_mod.dense.weight.detach().float() - heads["dense.weight"].float()).abs().max().item(),
                "dense.bias": (head_mod.dense.bias.detach().float() - heads["dense.bias"].float()).abs().max().item(),
                "out_proj.weight": (head_mod.out_proj.weight.detach().float() - heads["out_proj.weight"].float()).abs().max().item(),
                "out_proj.bias": (head_mod.out_proj.bias.detach().float() - heads["out_proj.bias"].float()).abs().max().item(),
            }
        log("head max|diff| after repair:", json.dumps({k: "%.3e" % v for k, v in diffs.items()}))
        assert max(diffs.values()) <= 1e-6, "head repair failed"

    if hasattr(merged.classifier, "modules_to_save"):
        log("!! unwrapping modules_to_save so the classifier is a plain classification head")
        inner = merged.classifier.modules_to_save["default"]
        merged.classifier = inner

    merged.config.num_labels = NUM_LABELS
    merged.config.id2label = id2label
    merged.config.label2id = label2id

    log("== 8. save merged -> %s ==" % MERGED)
    os.makedirs(MERGED, exist_ok=True)
    merged.save_pretrained(MERGED, safe_serialization=True)
    tokenizer.save_pretrained(MERGED)
    log("saved:", sorted(os.listdir(MERGED)))

    log("== 9. reload merged from disk and predict ==")
    model = XLMRobertaForSequenceClassification.from_pretrained(MERGED)
    model.eval()
    assert isinstance(model.classifier.out_proj, torch.nn.Linear)
    assert model.classifier.out_proj.out_features == NUM_LABELS, model.classifier.out_proj.out_features
    log("reloaded classifier out_features:", model.classifier.out_proj.out_features)

    with torch.no_grad():
        hd = (model.classifier.out_proj.weight.detach().float() - heads["out_proj.weight"].float()).abs().max().item()
    log("reloaded head max|diff| vs adapter: %.3e" % hd)
    assert hd <= 1e-6, "saved merged model lost the trained head"

    tok = AutoTokenizer.from_pretrained(MERGED)
    enc = tok(TEXTS, padding=True, truncation=True, max_length=512, return_tensors="pt")
    with torch.no_grad():
        logits = model(**enc).logits
    log("logits shape:", tuple(logits.shape))
    assert logits.shape == (len(TEXTS), NUM_LABELS), tuple(logits.shape)

    probs = torch.softmax(logits.float(), dim=-1)
    conf, pred = probs.max(dim=-1)

    results = []
    for i, text in enumerate(TEXTS):
        pid = int(pred[i].item())
        c = float(conf[i].item())
        top2 = torch.topk(probs[i], 2)
        margin = float(top2.values[0] - top2.values[1])
        log("  %2d pred=%2d conf=%.4f margin=%.4f label=%-3s | %s"
            % (i + 1, pid, c, margin, id2label.get(pid, "?"), text))
        results.append({"text": text, "predicted_class_id": pid, "confidence": round(c, 6)})

    with open(RESULTS, "w", encoding="utf-8") as fh:
        json.dump(results, fh, ensure_ascii=False, indent=2)
        fh.write("\n")
    log("wrote", RESULTS)

    distinct = len({r["predicted_class_id"] for r in results})
    min_conf = min(r["confidence"] for r in results)
    log("distinct predicted ids: %d of %d" % (distinct, len(results)))
    log("min confidence: %.4f" % min_conf)
    if distinct != len(results):
        log("!! WARNING: predictions collapsed -- adapter likely not applied")
    log("DONE")


if __name__ == "__main__":
    main()
