import importlib.util
import json
import os
import torch

BM = "/app/build_model.py"
MERGED = "/app/merged_model"
RESULTS = "/app/detection_results.json"
CODES = [0x4F60, 0x597D, 0xFF0C, 0x4F60, 0x597D, 0x5417, 0xFF1F]
BS = chr(92)
QUOTE = chr(34)


def log(*a):
    print(*a, flush=True)


def load_bm():
    spec = importlib.util.spec_from_file_location("bm_%d" % os.getpid(), BM)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


log("== 1. patch the corrupted sample line ==")
esc = "".join(BS + "u%04x" % c for c in CODES)
newline = "    " + QUOTE + esc + QUOTE + ","
log("target line will become:", newline)

src = open(BM, encoding="utf-8").read()
lines = src.split(chr(10))
hits = [i for i, ln in enumerate(lines) if "u4f60" in ln and ln.strip().startswith(QUOTE)]
