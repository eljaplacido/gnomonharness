#include <stdio.h>
#include <stdlib.h>

#define MAXD 200000

typedef struct {
    int len;
    unsigned char d[MAXD];
} big;

static void bset(big *x, unsigned v)
{
    x->len = 1;
    x->d[0] = (unsigned char)v;
}

static void badd(big *r, const big *a, const big *b)
{
    int i, n = a->len > b->len ? a->len : b->len;
    unsigned carry = 0;

    for (i = 0; i < n; i++) {
        unsigned s = carry;
        if (i < a->len) s += a->d[i];
        if (i < b->len) s += b->d[i];
        if (i < MAXD) r->d[i] = (unsigned char)(s % 10);
        carry = s / 10;
    }
    if (carry && n < MAXD) r->d[n++] = (unsigned char)carry;
    r->len = n;
}

static void bprint(const big *x)
{
    int i;
    for (i = x->len - 1; i >= 0; i--)
        putchar('0' + x->d[i]);
    putchar('\n');
}

static big A, B, C;

int main(int argc, char **argv)
{
    big *pa = &A, *pb = &B, *pc = &C;
    long n, i;

    if (argc < 2) {
        fprintf(stderr, "usage: %s N\n", argv[0]);
        return 1;
    }
    n = atol(argv[1]);
    if (n < 0) {
        fprintf(stderr, "usage: %s N  (N must be non-negative)\n", argv[0]);
        return 1;
    }

    bset(pa, 0);
    bset(pb, 1);
    for (i = 0; i < n; i++) {
        big *t;
        badd(pc, pa, pb);
        t = pa;
        pa = pb;
        pb = pc;
        pc = t;
    }
    bprint(pa);
    return 0;
}
