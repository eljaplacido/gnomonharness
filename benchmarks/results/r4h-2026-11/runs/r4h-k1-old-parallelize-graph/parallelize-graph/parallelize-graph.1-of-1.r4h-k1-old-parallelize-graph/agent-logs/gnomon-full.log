[approval] bash: cat > /app/Makefile <<'MAKEEOF'
# Serial + parallel (UPC) de Bruijn graph construction and traversal.
#
#   make            build serial and pgen
#   make serial     build the serial version
#   make pgen       build the parallel version
#   make run        run both on ./test
#   make test       run both and compare the contig SETS
#   make clean
#
# pgen is built with the Berkeley UPC compiler (upcc) when it is installed.
# When it is not, the same pgen.upc is compiled against upc_compat.c, a
# minimal pthreads implementation of the UPC primitives it uses (THREADS,
# MYTHREAD, upc_barrier, upc_memget/upc_memput, upc_all_alloc), so the
# parallel algorithm and its one-sided communication pattern are unchanged.

CC      = cc
CFLAGS  = -O2 -std=c99 -Wall
PTHREAD = -O2 -std=gnu99 -pthread
OUTDIR  = /app
THREADS ?= 4

all: serial pgen

serial: serial.c
	$(CC) $(CFLAGS) -o serial serial.c

pgen: pgen.upc upc_compat.c upc_compat.h
	@if command -v upcc >/dev/null 2>&1; then \
	  echo "pgen: building with Berkeley UPC (upcc)"; \
	  upcc -O2 -o pgen pgen.upc; \
	else \
	  echo "pgen: upcc not found -- building with the pthreads UPC-emulation fallback"; \
	  $(CC) $(PTHREAD) -DNO_UPC -x c -o pgen pgen.upc upc_compat.c; \
	fi

run: all
	@mkdir -p $(OUTDIR)
	./serial test
	UPC_NTHREADS=$(THREADS) ./pgen test

test: all
	@mkdir -p $(OUTDIR)
	@rm -f $(OUTDIR)/pgen_*.out
	@./serial test 2>&1 | sed 's/^/serial: /'
	@UPC_NTHREADS=$(THREADS) ./pgen test 2>&1 | sed 's/^/pgen: /'
	@cat $(OUTDIR)/pgen_*.out | sort > .pgen.sorted
	@sort $(OUTDIR)/serial.out > .serial.sorted
	@if cmp -s .serial.sorted .pgen.sorted; then \
	  echo "PASS: $(THREADS) threads produced the identical contig set"; \
	  wc -l $(OUTDIR)/serial.out; \
	  cat $(OUTDIR)/pgen_*.out | wc -l; \
	else \
	  echo "FAIL: contig sets differ"; \
	  diff .serial.sorted .pgen.sorted | head -20; \
	  exit 1; \
	fi

clean:
	rm -f serial pgen .pgen.sorted .serial.sorted

.PHONY: all run test clean
