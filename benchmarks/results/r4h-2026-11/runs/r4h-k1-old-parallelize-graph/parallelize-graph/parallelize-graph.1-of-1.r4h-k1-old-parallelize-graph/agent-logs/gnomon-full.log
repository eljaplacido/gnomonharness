[approval] bash: cat > /app/pgen.upc <<'EOF'
/* pgen.upc -- parallel de Bruijn graph construction and traversal in UPC.
 *
 * Same algorithm as serial.c, parallelised the way Georganas et al. describe:
 *   phase 1  every thread parses a contiguous byte range of the input file and
 *            publishes its (k-mer, left, right) triples into the shared arrays;
 *   phase 2  k-mer ownership is by hash bucket (bucket % THREADS), so every
 *            copy of a k-mer is seen by exactly one thread and de-duplication
 *            stays a purely local operation;
 *   phase 3  each thread publishes its unique nodes into the shared graph
 *            (fixed per-thread node-id slices) and installs its bucket chains;
 *   phase 4  each thread resolves its own nodes' forward/backward extensions
 *            into global node ids with one-sided reads of remote buckets;
 *   phase 5  each thread walks the paths that START in its own node slice and
 *            writes the contigs to its own output file; simple cycles are
 *            emitted by the unique thread owning the lexicographically
 *            smallest k-mer of the cycle, so a cycle is emitted exactly once
 *            no matter how many threads run.
 *
 * Build with Berkeley UPC:   upcc -O2 -o pgen pgen.upc
 * Run:                       upcrun -n 4 -shared-heap 256MB ./pgen <input_file>
 * Build without upcc (the pthreads UPC-emulation fallback, see upc_compat.h):
 *   cc -O2 -std=gnu99 -pthread -DNO_UPC -x c -o pgen pgen.upc upc_compat.c
 */
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>
#include <sys/stat.h>

#ifdef NO_UPC
#  include "upc_compat.h"
#else
#  include <upc.h>
#  include <upc_collective.h>
#endif

#define MAXK 63

static uint64_t fnv1a(const char *s, int n) {
  uint64_t h = 1469598103934665603ULL;
  int i;
  for (i = 0; i < n; i++) {
    h ^= (unsigned char)s[i];
    h *= 1099511628211ULL;
  }
  return h;
}

/* One-sided lookup of a K-byte k-mer in the distributed hash table.
 * Only remote reads: head[] and nxt[] and the k-mer payload itself. */
static int dbg_lookup(const char *key, int K, shared int *head,
                      shared char *nfl, shared int *nxt, long nbuck) {
  uint64_t h = fnv1a(key, K);
  long b = (long)(h % (uint64_t)nbuck);
  int g = head[b];
  char tmp[MAXK + 1];
  int steps = 0;
  while (g != -1) {
    upc_memget(tmp, &nfl[(long)g * K], K);
    if (memcmp(tmp, key, K) == 0) return g;
    g = nxt[g];
    if (++steps > (int)nbuck) return -1;  /* safety */
  }
  return -1;
}

/* first line start at or after off */
static long line_start_ge(FILE *fp, long off, long fsz) {
  int c;
  if (off <= 0) return 0;
  if (off >= fsz) return fsz;
  fseek(fp, off, SEEK_SET);
  while ((c = fgetc(fp)) != EOF) {
    if (c == '\n') return off + 1;
    off++;
  }
  return fsz;
}

static int pgen_main(int argc, char **argv);

#ifdef NO_UPC
int main(int argc, char **argv) {
  return upc_compat_launch(argc, argv, pgen_main);
}
#else
int main(int argc, char **argv) {
  return pgen_main(argc, argv);
}
#endif

static int pgen_main(int argc, char **argv) {
  int T = THREADS, me = MYTHREAD;
  const char *path = (argc > 1) ? argv[1] : NULL;
  FILE *fp;
  long fsz, lo, hi, rlen, i, mylines, gbase, nlines, nbuck, npt, NSLOT;
  int K, kl, j, nl, mind;
  char first[1024];
  char *rbuf, *lk, *outbuf;
  size_t outcap, outlen;
  long nctg;
  shared char *kfl, *lel, *rel, *nfl, *nle, *nre, *vis;
  shared int *suc, *pre, *nxt, *head, *cnt;
  shared long *lcnt;
  typedef struct { int next; char le, re; } LRec;
  LRec *lrec;
  int *lhead;
  FILE *of = NULL;

  if (!path) {
    if (me == 0) fprintf(stderr, "usage: pgen [-n threads] <input_file>\n");
    return 1;
  }

  fp = fopen(path, "rb");
  if (!fp) { if (me == 0) perror(path); return 1; }
  fseek(fp, 0, SEEK_END);
  fsz = ftell(fp);
  fseek(fp, 0, SEEK_SET);
  if (fsz <= 0) { fclose(fp); if (me == 0) fprintf(stderr, "pgen: empty input\n"); return 1; }

  if (!fgets(first, sizeof first, fp)) { fclose(fp); return 1; }
  K = 0;
  while (first[K] && first[K] != '\t' && first[K] != '\n' && first[K] != '\r' && first[K] != ' ') K++;
  if (K <= 0 || K > MAXK) {
    fprintf(stderr, "pgen: bad k-mer length %d\n", K);
    fclose(fp);
    return 1;
  }

  /* ---- phase 0: agree on line-aligned byte ranges ---------------------- */
  lo = (me == 0) ? 0 : line_start_ge(fp, (fsz * (long)me) / (long)T, fsz);
  hi = (me == T - 1) ? fsz : line_start_ge(fp, (fsz * (long)(me + 1)) / (long)T, fsz);
  if (hi < lo) hi = lo;
  rlen = hi - lo;

  rbuf = (char *)malloc((size_t)rlen + 2);
  if (!rbuf) { fprintf(stderr, "pgen: out of memory (rbuf)\n"); exit(1); }
  fseek(fp, lo, SEEK_SET);
  if (rlen > 0 && fread(rbuf, 1, (size_t)rlen, fp) != (size_t)rlen) {
    fprintf(stderr, "pgen: short read on thread %d\n", me);
    exit(1);
  }
  rbuf[rlen > 0 ? rlen : 0] = 0;
  fclose(fp);

  mylines = 0;
  for (i = 0; i < rlen; i++)
    if (rbuf[i] != '\n' && (i == 0 || rbuf[i - 1] == '\n')) mylines++;

  /* ---- global line count and this thread's global base ----------------- */
  lcnt = (shared long *)upc_all_alloc((size_t)T, sizeof(long));
  lcnt[me] = mylines;
  upc_barrier;
  gbase = 0;
  nlines = 0;
  for (j = 0; j < T; j++) {
    if (j < me) gbase += lcnt[j];
    nlines += lcnt[j];
  }
  if (nlines <= 0) { if (me == 0) fprintf(stderr, "pgen: no k-mers in input\n"); return 1; }

  nbuck = 2 * nlines + 1;
  npt = (nlines / (long)T) * 3 + 256;       /* node slots reserved per thread */
  NSLOT = npt * (long)T;

  /* ---- shared graph ---------------------------------------------------- */
  kfl = (shared char *)upc_all_alloc((size_t)(nlines * K) + 1, 1);
  lel = (shared char *)upc_all_alloc((size_t)nlines + 1, 1);
  rel = (shared char *)upc_all_alloc((size_t)nlines + 1, 1);
  nfl = (shared char *)upc_all_alloc((size_t)(NSLOT * K) + 1, 1);
  nle = (shared char *)upc_all_alloc((size_t)NSLOT + 1, 1);
  nre = (shared char *)upc_all_alloc((size_t)NSLOT + 1, 1);
  vis = (shared char *)upc_all_alloc((size_t)NSLOT + 1, 1);
  suc = (shared int *)upc_all_alloc((size_t)NSLOT + 1, sizeof(int));
  pre = (shared int *)upc_all_alloc((size_t)NSLOT + 1, sizeof(int));
  nxt = (shared int *)upc_all_alloc((size_t)NSLOT + 1, sizeof(int));
  head = (shared int *)upc_all_alloc((size_t)nbuck + 1, sizeof(int));
  cnt = (shared int *)upc_all_alloc((size_t)T + 1, sizeof(int));

  for (j = (int)me; j < (int)nbuck; j += T) head[j] = -1;
  for (i = (long)me; i < NSLOT; i += (long)T) vis[i] = 0;
  cnt[me] = 0;
  upc_barrier;

  /* ---- phase 1: parse this thread's lines into the shared triple array -- */
  {
    long gi = gbase;
    i = 0;
    while (i < rlen) {
      char km[MAXK + 1];
      char LE, RE;
      /* skip blank lines: advance past \n to start of next line */
      if (rbuf[i] == '\n') { i++; continue; }
      /* read k-mer: everything up to \t or \n */
      kl = 0;
      while (i < rlen && rbuf[i] != '\t' && rbuf[i] != '\n') {
        if (kl < K) km[kl++] = rbuf[i];
        i++;
      }
      while (kl > 0 && (km[kl - 1] == '\r' || km[kl - 1] == ' ')) kl--;
      LE = 'F';
      RE = 'F';
      if (i < rlen && rbuf[i] == '\t') {
        i++;
        if (i < rlen) { char c = rbuf[i++]; if (c != 'F' && c != '\n' && c != '\r') LE = c; }
        if (i < rlen) { char c = rbuf[i++]; if (c != 'F' && c != '\n' && c != '\r') RE = c; }
      }
      while (i < rlen && rbuf[i] != '\n') i++;
      if (i < rlen) i++;                                            /* eat '\n' */
      if (kl != K || gi >= gbase + mylines) continue;               /* malformed */
      upc_memput(&kfl[gi * K], km, K);
      lel[gi] = LE;
      rel[gi] = RE;
      gi++;
    }
  }
  upc_barrier;

  /* ---- phase 2: local de-duplication of the buckets this thread owns ---- */
  lrec = (LRec *)malloc(sizeof(LRec) * (size_t)nlines);
  lk = (char *)malloc((size_t)nlines * (size_t)K);
  lhead = (int *)malloc(sizeof(int) * (size_t)nbuck);
  if (!lrec || !lk || !lhead) { fprintf(stderr, "pgen: out of memory (local)\n"); exit(1); }
  for (i = 0; i < nbuck; i++) lhead[i] = -1;
  nl = 0;
  for (i = 0; i < nlines; i++) {
    char kk[MAXK + 1];
    uint64_t h;
    long b;
    int t;
    upc_memget(kk, &kfl[i * K], K);
    h = fnv1a(kk, K);
    b = (long)(h % (uint64_t)nbuck);
    if ((int)(b % (long)T) != me) continue;
    t = lhead[b];
    while (t != -1 && memcmp(lk + (size_t)t * K, kk, K) != 0) t = lrec[t].next;
    if (t >= 0) {
      char LE = lel[i], RE = rel[i];
      if (LE != 'F' && (lrec[t].le == 'F' || LE < lrec[t].le)) lrec[t].le = LE;
      if (RE != 'F' && (lrec[t].re == 'F' || RE < lrec[t].re)) lrec[t].re = RE;
    } else {
      if (nl >= (int)npt) {
        fprintf(stderr, "pgen: thread %d overflowed its node slice (%d)\n", me, nl);
        exit(1);
      }
      memcpy(lk + (size_t)nl * K, kk, K);
      lrec[nl].next = lhead[b];
      lrec[nl].le = lel[i];
      lrec[nl].re = rel[i];
      lhead[b] = nl;
      nl++;
    }
  }
  cnt[me] = nl;

  /* ---- phase 3: publish nodes and bucket chains ------------------------ */
  {
    int base = me * (int)npt;
    for (i = 0; i < nbuck; i++) lhead[i] = -1;
    for (j = 0; j < nl; j++) {
      int g = base + j;
      uint64_t h = fnv1a(lk + (size_t)j * K, K);
      long b = (long)(h % (uint64_t)nbuck);
      upc_memput(&nfl[(long)g * K], lk + (size_t)j * K, K);
      nle[g] = lrec[j].le;
      nre[g] = lrec[j].re;
      suc[g] = -1;
      pre[g] = -1;
      nxt[g] = lhead[b];          /* temporary: local chain, global ids */
      lhead[b] = g;
    }
    for (i = (long)me; i < nbuck; i += (long)T) head[i] = lhead[i];
  }
  upc_barrier;

  /* ---- phase 4: resolve extensions with one-sided remote reads --------- */
  {
    int base = me * (int)npt;
    char tt[MAXK + 1];
    for (j = 0; j < nl; j++) {
      int g = base + j;
      if (lrec[j].re != 'F') {
        memcpy(tt, lk + (size_t)j * K + 1, (size_t)(K - 1));
        tt[K - 1] = lrec[j].re;
        suc[g] = dbg_lookup(tt, K, head, nfl, nxt, nbuck);
      }
      if (lrec[j].le != 'F') {
        tt[0] = lrec[j].le;
        memcpy(tt + 1, lk + (size_t)j * K, (size_t)(K - 1));
        pre[g] = dbg_lookup(tt, K, head, nfl, nxt, nbuck);
      }
    }
  }
  upc_barrier;

  /* ---- phase 5: contig traversal --------------------------------------- */
  mkdir("/app", 0777);
  {
    char fname[64];
    snprintf(fname, sizeof fname, "/app/pgen_%d.out", me);
    of = fopen(fname, "w");
    if (!of) {
      fprintf(stderr, "pgen: thread %d cannot open %s\n", me, fname);
      exit(1);
    }
  }
  nctg = 0;
  outcap = 4096;
  outlen = 0;
  outbuf = (char *)malloc(outcap);
  if (!outbuf) { fprintf(stderr, "pgen: out of memory (outbuf)\n"); exit(1); }

  /* 5a: every path has exactly one start (pred == -1) and one owner thread */
  {
    int base = me * (int)npt;
    for (j = 0; j < nl; j++) {
      int g = base + j, cur;
      long steps = 0;
      if (pre[g] != -1) continue;
      cur = g;
      upc_memget(outbuf, &nfl[(long)cur * K], K);
      outlen = (size_t)K;
      vis[cur] = 1;
      for (;;) {
        int nx = suc[cur];
        char tk[MAXK + 1];
        if (nx == -1) break;
        upc_memget(tk, &nfl[(long)nx * K], K);
        if (outlen + 2 > outcap) {
          outcap *= 2;
          outbuf = (char *)realloc(outbuf, outcap);
          if (!outbuf) { fprintf(stderr, "pgen: out of memory (grow)\n"); exit(1); }
        }
        outbuf[outlen++] = tk[K - 1];
        cur = nx;
        vis[cur] = 1;
        if (++steps > NSLOT) break;
      }
      outbuf[outlen] = 0;
      fprintf(of, "%s\n", outbuf);
      nctg++;
    }
  }
  upc_barrier;

  /* 5b: simple cycles.  Emit only from the node that is the cycle minimum,
   *     which is a unique node, so each cycle is written exactly once. */
  {
    int base = me * (int)npt;
    char gk[MAXK + 1], tk[MAXK + 1];
    for (j = 0; j < nl; j++) {
      int g = base + j, cur;
      int is_min = 1;
      long steps = 0;
      if (pre[g] == -1 || vis[g]) continue;     /* path node, already emitted */
      cur = suc[g];
      if (cur == -1) continue;
      upc_memget(gk, &nfl[(long)g * K], K);
      while (cur != g) {
        upc_memget(tk, &nfl[(long)cur * K], K);
        if (memcmp(tk, gk, K) < 0) { is_min = 0; break; }
        cur = suc[cur];
        if (cur == -1) break;
        if (++steps > NSLOT) break;
      }
      if (cur != g || !is_min) continue;
      outlen = (size_t)K;
      memcpy(outbuf, gk, (size_t)K);
      cur = suc[g];
      while (cur != g && cur != -1) {
        upc_memget(tk, &nfl[(long)cur * K], K);
        if (outlen + 2 > outcap) {
          outcap *= 2;
          outbuf = (char *)realloc(outbuf, outcap);
          if (!outbuf) { fprintf(stderr, "pgen: out of memory (grow)\n"); exit(1); }
        }
        outbuf[outlen++] = tk[K - 1];
        cur = suc[cur];
        if (++steps > 2 * NSLOT) break;
      }
      outbuf[outlen] = 0;
      fprintf(of, "%s\n", outbuf);
      nctg++;
    }
  }

  fclose(of);
  if (me == 0) {
    long tot = 0;
    int t;
    for (t = 0; t < T; t++) tot += cnt[t];
    fprintf(stderr, "pgen: runtime = %s; threads = %d; k = %d; lines = %ld; "
                    "unique k-mers = %ld; contig files = /app/pgen_*.out\n",
#ifdef NO_UPC
            "pthreads UPC-emulation (upcc not available), -shared-heap has no effect",
#else
            "Berkeley UPC",
#endif
            T, K, nlines, tot);
  }
  fprintf(stderr, "pgen: thread %d: unique k-mers = %d, contigs = %ld\n", me, nl, nctg);
  return 0;
}
