#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <pthread.h>

int upc_nthreads_g = 1;
__thread int upc_mythread_g = 0;
pthread_barrier_t upc_barrier_g;

#define shared
#define THREADS             (upc_nthreads_g)
#define MYTHREAD            (upc_mythread_g)
#define upc_barrier         pthread_barrier_wait(&upc_barrier_g)
#define upc_memput(d, s, n) memcpy((void *)(d), (const void *)(s), (size_t)(n))
#define upc_memget(d, s, n) memcpy((void *)(d), (const void *)(s), (size_t)(n))

void *upc_all_alloc(size_t nelem, size_t elsize) {
  size_t n = nelem ? nelem : 1;
  void *p = calloc(n, elsize ? elsize : 1);
  return p;
}

static int (*body_g)(int, char **);
static int argc_g;
static char **argv_g;

static void *worker(void *arg) {
  upc_mythread_g = (int)(intptr_t)arg;
  fprintf(stderr, "thread %d: entering body\n", upc_mythread_g);
  body_g(argc_g, argv_g);
  fprintf(stderr, "thread %d: body done\n", upc_mythread_g);
  return NULL;
}

int upc_compat_launch(int argc, char **argv, int (*body)(int, char **)) {
  int n = 4, i;
  const char *e = getenv("UPC_NTHREADS");
  char *path = NULL;
  static char *nargv[3];
  pthread_t *tid;

  if (e && atoi(e) > 0) n = atoi(e);
  for (i = 1; i < argc; i++) {
    if (!strcmp(argv[i], "-n") && i + 1 < argc) n = atoi(argv[++i]);
    else if (!strcmp(argv[i], "-shared-heap") && i + 1 < argc) i++;
    else path = argv[i];
  }
  if (!path) return 1;
  if (n < 1) n = 1;
  if (n > 128) n = 128;
  upc_nthreads_g = n;

  nargv[0] = argv[0];
  nargv[1] = path;
  nargv[2] = NULL;
  argc_g = 2;
  argv_g = nargv;
  body_g = body;

  fprintf(stderr, "launch: creating %d threads\n", n);
  pthread_barrier_init(&upc_barrier_g, NULL, (unsigned)n);
  tid = (pthread_t *)malloc(sizeof(pthread_t) * (size_t)n);
  for (i = 1; i < n; i++)
    pthread_create(&tid[i], NULL, worker, (void *)(intptr_t)i);
  fprintf(stderr, "launch: thread 0 starting\n");
  worker((void *)(intptr_t)0);
  fprintf(stderr, "launch: thread 0 done, joining\n");
  for (i = 1; i < n; i++) pthread_join(tid[i], NULL);
  free(tid);
  return 0;
}
