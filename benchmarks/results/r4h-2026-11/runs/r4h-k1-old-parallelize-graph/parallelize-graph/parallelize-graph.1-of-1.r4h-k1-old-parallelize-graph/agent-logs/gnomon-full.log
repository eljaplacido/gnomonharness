#ifndef UPC_COMPAT_H
#define UPC_COMPAT_H
/* Minimal single-process multi-threaded emulation of the Berkeley UPC
 * primitives that pgen.upc uses.  It is compiled ONLY when the Berkeley UPC
 * compiler (upcc) is unavailable:
 *
 *   cc -O2 -std=gnu99 -pthread -DNO_UPC -x c -o pgen pgen.upc upc_compat.c
 *
 * pgen.upc is unchanged in both builds: same SPMD thread id, same blocking
 * barrier, same one-sided bulk get/put against a single globally addressable
 * space (one address space shared by all threads of the process). */
#include <stddef.h>
#include <string.h>
#include <pthread.h>

extern int upc_nthreads_g;
extern __thread int upc_mythread_g;
extern pthread_barrier_t upc_barrier_g;

#define shared
#define THREADS             (upc_nthreads_g)
#define MYTHREAD            (upc_mythread_g)
#define upc_barrier         pthread_barrier_wait(&upc_barrier_g)
#define upc_memput(d, s, n) memcpy((void *)(d), (const void *)(s), (size_t)(n))
#define upc_memget(d, s, n) memcpy((void *)(d), (const void *)(s), (size_t)(n))

void *upc_all_alloc(size_t nelem, size_t elsize);
int   upc_compat_launch(int argc, char **argv, int (*body)(int, char **));

#endif /* UPC_COMPAT_H */
