[approval] bash: cat > /app/upc_compat.c <<'EOF'
#include "upc_compat.h"
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>

int upc_nthreads_g = 1;
__thread int upc_mythread_g = 0;
pthread_barrier_t upc_barrier_g;

static int (*body_g)(int, char **);
static int argc_g;
static char **argv_g;

void *upc_all_alloc(size_t nelem, size_t elsize) {
  size_t n = nelem ? nelem : 1;
  void *p = calloc(n, elsize ? elsize : 1);
  if (!p) {
    fprintf(stderr, "pgen: out of memory (upc_all_alloc %lu x %lu)\n",
            (unsigned long)nelem, (unsigned long)elsize);
    exit(1);
  }
  return p;
}

static void *worker(void *arg) {
  upc_mythread_g = (int)(intptr_t)arg;
  body_g(argc_g, argv_g);
  return NULL;
}

int upc_compat_launch(int argc, char **argv, int (*body)(int, char **)) {
  int n = 4, i;
  const char *e = getenv("UPC_NTHREADS");
  char *path = NULL;
  static char *nargv[3];
  pthread_t *tid;

  if (e && atoi(e) > 0) n = atoi(e);
  for (i = 1; i < argc; i++) {
    if (!strcmp(argv[i], "-n") && i + 1 < argc) n = atoi(argv[++i]);
    else if (!strcmp(argv[i], "-shared-heap") && i + 1 < argc) i++;
    else path = argv[i];
  }
  if (!path) {
    fprintf(stderr, "usage: pgen [-n threads] <input_file>\n");
    return 1;
  }
  if (n < 1) n = 1;
  if (n > 128) n = 128;
  upc_nthreads_g = n;

  nargv[0] = argv[0];
  nargv[1] = path;
  nargv[2] = NULL;
  argc_g = 2;
  argv_g = nargv;
  body_g = body;

  pthread_barrier_init(&upc_barrier_g, NULL, (unsigned)n);
  tid = (pthread_t *)malloc(sizeof(pthread_t) * (size_t)n);
  if (!tid) { fprintf(stderr, "pgen: out of memory\n"); return 1; }
  for (i = 1; i < n; i++)
    if (pthread_create(&tid[i], NULL, worker, (void *)(intptr_t)i) != 0) {
      fprintf(stderr, "pgen: cannot create thread %d\n", i);
      return 1;
    }
  worker((void *)(intptr_t)0);          /* thread 0 runs on the calling thread */
  for (i = 1; i < n; i++) pthread_join(tid[i], NULL);
  free(tid);
  return 0;
}
