[approval] bash: python3 - <<'PY'
from html.parser import HTMLParser

VOID_ELEMENTS = {
    "area", "base", "br", "col", "embed", "hr", "img", "input",
    "link", "meta", "source", "track", "wbr"
}

class TagChecker(HTMLParser):
    def __init__(self):
        super().__init__()
        self.stack = []
        self.errors = []

    def handle_starttag(self, tag, attrs):
        if tag in VOID_ELEMENTS:
            return
        self.stack.append(tag)

    def handle_endtag(self, tag):
        if tag in VOID_ELEMENTS:
            return
        # Find the tag in the stack (from top)
        for i in range(len(self.stack) - 1, -1, -1):
            if self.stack[i] == tag:
                if i != len(self.stack) - 1:
                    unclosed = self.stack[i+1:]
                    self.errors.append(
                        f"Tag <{tag}> closed but <{'>, <'.join(unclosed)}> still open"
                    )
                del self.stack[i:]
                return
        self.errors.append(f"Unexpected closing tag </{tag}>")

    def check(self):
        if self.stack:
            for tag in reversed(self.stack):
                self.errors.append(f"Unclosed tag <{tag}>")
        return self.errors

for fname in ["my_website/index.html", "my_website/blog.html", "my_website/publications.html"]:
    with open(fname) as f:
        content = f.read()
    checker = TagChecker()
    checker.feed(content)
    errs = checker.check()
    if errs:
        print(f"{fname}: PROBLEMS: {'; '.join(errs)}")
    else:
        print(f"{fname}: OK (zero problems)")
