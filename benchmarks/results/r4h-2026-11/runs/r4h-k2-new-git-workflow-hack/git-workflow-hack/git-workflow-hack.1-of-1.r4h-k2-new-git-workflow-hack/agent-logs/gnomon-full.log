import sys
from html.parser import HTMLParser
VOID = {"area","base","br","col","embed","hr","img","input","link","meta","source","track","wbr"}
class P(HTMLParser):
    def __init__(self): super().__init__(convert_charrefs=True); self.stack=[]; self.errs=[]
    def handle_starttag(self,t,a):
        if t not in VOID: self.stack.append(t)
    def handle_endtag(self,t):
        if t in VOID: return
        if not self.stack: self.errs.append(f"stray </{t}>"); return
        if self.stack[-1]!=t: self.errs.append(f"</{t}> closes <{self.stack[-1]}>")
        else: self.stack.pop()
bad=0
for f in ["my_website/index.html","my_website/blog.html","my_website/publications.html"]:
    p=P(); p.feed(open(f,encoding="utf-8").read())
    e=p.errs+[f"unclosed <{t}>" for t in p.stack]
    print(f, "OK" if not e else "FAIL "+"; ".join(e)); bad+=bool(e)
sys.exit(1 if bad else 0)
