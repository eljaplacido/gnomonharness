from html.parser import HTMLParser
VOID={"area","base","br","col","embed","hr","img","input","link","meta","source","track","wbr"}
class P(HTMLParser):
    def __init__(s): super().__init__(convert_charrefs=True); s.st=[]; s.er=[]
    def handle_starttag(s,t,a):
        if t not in VOID: s.st.append(t)
    def handle_endtag(s,t):
        if t in VOID: return
        if not s.st: s.er.append("stray </%s>"%t)
        elif s.st[-1]!=t: s.er.append("</%s> closes <%s>"%(t,s.st[-1]))
        else: s.st.pop()
bad=0
