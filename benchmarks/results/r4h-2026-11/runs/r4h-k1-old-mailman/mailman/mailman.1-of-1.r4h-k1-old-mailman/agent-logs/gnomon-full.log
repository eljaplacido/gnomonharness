JOIN = "reading-group-join@local.edu"
LEAVE = "reading-group-leave@local.edu"
CFG = "/etc/mailman3/mailman.cfg"

FAILURES = []

def rand_hex(n=6):
    return os.urandom(n).hex()

def add_user(name):
    try:
        subprocess.run(["useradd", "-M", name], check=True, capture_output=True, text=True)
    except subprocess.CalledProcessError as e:
        if b"already exists" not in e.stderr:
            raise

def send_email(body, subject, from_addr, to_addr):
    msg = MIMEText(body)
    msg["Subject"] = subject
    msg["From"] = from_addr
    msg["To"] = to_addr
    with smtplib.SMTP("localhost", 25) as srv:
        srv.send_message(msg)

def poll_mailbox(user, check_fn, timeout=60, interval=2):
    end = time.time() + timeout
    while time.time() < end:
        mbox_path = f"/var/mail/{user}"
        if not os.path.exists(mbox_path):
            sleep(interval)
            continue
        try:
            mbox = mailbox.mbox(mbox_path)
            if check_fn(mbox):
                return True
        except Exception:
            pass
        sleep(interval)
    return False

def get_mlist():
    initialize(CFG)
    lm = getUtility(IListManager)
    return lm.get(LIST)

def is_member(user):
    mlist = get_mlist()
    return mlist.members.get_member(f"{user}@{DOMAIN}") is not None

def is_not_member(user):
    mlist = get_mlist()
    return mlist.members.get_member(f"{user}@{DOMAIN}") is None

def fail(msg):
    FAILURES.append(msg)
    print(f"FAIL: {msg}")

def pass_(msg):
    print(f"PASS: {msg}")

# ============================================================
# (a) Join: alice sends to reading-group-join, gets confirmation
# ============================================================
print("\n=== (a) JOIN FLOW ===")
alice = "va" + rand_hex(4)
bob = "vb" + rand_hex(4)
ann_rand = rand_hex(4)
ann2_rand = rand_hex(4)

add_user(alice)
add_user(bob)

send_email("", "", f"{alice}@{DOMAIN}", JOIN)
print(f"Sent join request from {alice}@{DOMAIN} to {JOIN}")

def check_confirm(mbox):
    for msg in mbox:
        frm = msg.get("From", "")
        if frm.startswith("reading-group-confirm"):
            return msg
    return None

confirm_msg = None
def check_confirm_found(mbox):
    global confirm_msg
    confirm_msg = check_confirm(mbox)
    return confirm_msg is not None

if poll_mailbox(alice, check_confirm_found, timeout=60, interval=2):
