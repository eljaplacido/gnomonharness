#!/usr/bin/env python3
"""Independent verification of the reading-group@local.edu mailing list."""

import mailbox
import os
import smtplib
import subprocess
import sys
import time
import random
import string
from email.mime.text import MIMEText
from time import sleep

from mailman.core.initialize import initialize
from mailman.interfaces.listmanager import IListManager
from mailman.interfaces.subscription import SubscriptionPolicy
from zope.component import getUtility

DOMAIN = "local.edu"
LIST = "reading-group@local.edu"
JOIN = "reading-group-join@local.edu"
LEAVE = "reading-group-leave@local.edu"
CFG = "/etc/mailman3/mailman.cfg"

FAILURES = []

def rand_hex(n=6):
    return os.urandom(n).hex()

def add_user(name):
    try:
        subprocess.run(["useradd", "-M", name], check=True, capture_output=True, text=True)
    except subprocess.CalledProcessError as e:
        if b"already exists" not in e.stderr:
            raise

def send_email(body, subject, from_addr, to_addr):
    msg = MIMEText(body)
    msg["Subject"] = subject
    msg["From"] = from_addr
    msg["To"] = to_addr
    with smtplib.SMTP("localhost", 25) as srv:
        srv.send_message(msg)

def poll_mailbox(user, check_fn, timeout=60, interval=2):
    end = time.time() + timeout
    while time.time() < end:
        mbox_path = f"/var/mail/{user}"
        if not os.path.exists(mbox_path):
            sleep(interval)
            continue
        try:
            mbox = mailbox.mbox(mbox_path)
            if check_fn(mbox):
                return True
        except Exception:
            pass
        sleep(interval)
    return False

def get_mlist():
    initialize(CFG)
    lm = getUtility(IListManager)
    return lm.get(LIST)

def is_member(user):
    mlist = get_mlist()
    return mlist.members.get_member(f"{user}@{DOMAIN}") is not None

def is_not_member(user):
    mlist = get_mlist()
    return mlist.members.get_member(f"{user}@{DOMAIN}") is None

def fail(msg):
    FAILURES.append(msg)
    print(f"FAIL: {msg}")

def pass_(msg):
    print(f"PASS: {msg}")

# ============================================================
# (a) Join: alice sends to reading-group-join, gets confirmation
# ============================================================
print("\n=== (a) JOIN FLOW ===")
alice = "va" + rand_hex(4)
bob = "vb" + rand_hex(4)
ann_rand = rand_hex(4)
ann2_rand = rand_hex(4)

add_user(alice)
add_user(bob)

send_email("", "", f"{alice}@{DOMAIN}", JOIN)
print(f"Sent join request from {alice}@{DOMAIN} to {JOIN}")

def check_confirm(mbox):
    for msg in mbox:
        frm = msg.get("From", "")
        if frm.startswith("reading-group-confirm"):
            return msg
    return None

confirm_msg = None
def check_confirm_found(mbox):
    global confirm_msg
    confirm_msg = check_confirm(mbox)
    return confirm_msg is not None

if poll_mailbox(alice, check_confirm_found, timeout=60, interval=2):
    pass_(f"Confirmation email arrived for {alice}")
    print(f"  From: {confirm_msg.get('From')}")
    print(f"  Subject: {confirm_msg.get('Subject')}")
else:
    fail("No confirmation email arrived for alice within 60s")
    confirm_msg = None

if is_not_member(alice):
    pass_(f"{alice} is NOT a member yet (correct)")
else:
    fail(f"{alice} is already a member before confirming")

mlist = get_mlist()
policy = mlist.subscription_policy
print(f"  subscription_policy = {policy}")
print(f"  subscription_policy is not SubscriptionPolicy.open = {policy is not SubscriptionPolicy.open}")

# ============================================================
# (b) Reply to confirmation, alice becomes member
# ============================================================
print("\n=== (b) CONFIRM JOIN ===")
if confirm_msg:
    confirm_from = confirm_msg.get("From")
    send_email("", "", f"{alice}@{DOMAIN}", confirm_from)
    print(f"Replied to {confirm_from} from {alice}@{DOMAIN}")

    if poll_mailbox(alice, lambda m: True, timeout=60, interval=2):
        pass_(f"Confirmation processed for {alice}")
    else:
        fail("Poll timeout after confirmation reply")

    if is_member(alice):
        pass_(f"{alice} IS now a member")
    else:
        fail(f"{alice} is NOT a member after confirming")
else:
    fail("Cannot confirm: no confirmation message found")

# ============================================================
# (c) Second member: bob
# ============================================================
print("\n=== (c) BOB JOIN ===")
add_user("vb" + bob)
bob_addr = "vb" + bob

send_email("", "", f"{bob_addr}@{DOMAIN}", JOIN)
print(f"Sent join request from {bob_addr}@{DOMAIN} to {JOIN}")

bob_confirm = None
def check_bob_confirm(mbox):
    global bob_confirm
    bob_confirm = check_confirm(mbox)
    return bob_confirm is not None

if poll_mailbox(bob_addr, check_bob_confirm, timeout=60, interval=2):
    pass_(f"Confirmation email arrived for {bob_addr}")
    print(f"  From: {bob_confirm.get('From')}")
    print(f"  Subject: {bob_confirm.get('Subject')}")
else:
    fail("No confirmation email arrived for bob within 60s")

if is_not_member(bob_addr):
    pass_(f"{bob_addr} is NOT a member yet (correct)")
else:
    fail(f"{bob_addr} is already a member before confirming")

if bob_confirm:
    send_email("", "", f"{bob_addr}@{DOMAIN}", bob_confirm.get("From"))
    print(f"Replied to {bob_confirm.get('From')} from {bob_addr}@{DOMAIN}")

    if poll_mailbox(bob_addr, lambda m: True, timeout=60, interval=2):
        pass_(f"Confirmation processed for {bob_addr}")
    else:
        fail("Poll timeout after bob's confirmation reply")

    if is_member(bob_addr):
        pass_(f"{bob_addr} IS now a member")
    else:
        fail(f"{bob_addr} is NOT a member after confirming")

mlist = get_mlist()
alice_m = mlist.members.get_member(f"{alice}@{DOMAIN}")
bob_m = mlist.members.get_member(f"{bob_addr}@{DOMAIN}")
if alice_m and bob_m:
    pass_(f"Both {alice} and {bob_addr} are members")
else:
    fail(f"Members: alice={alice_m}, bob={bob_m}")

# ============================================================
# (d) Announcement fan-out
# ============================================================
print("\n=== (d) ANNOUNCEMENT FAN-OUT ===")
ann_subject = f"ANNOUNCE-{ann_rand}"
send_email("hello readers", ann_subject, f"{alice}@{DOMAIN}", LIST)
print(f"Sent announcement '{ann_subject}' from {alice}@{DOMAIN} to {LIST}")

def check_ann(mbox):
    for msg in mbox:
        if msg.get("Subject", "") == ann_subject:
            return True
    return False

alice_got = poll_mailbox(alice, check_ann, timeout=60, interval=2)
bob_got = poll_mailbox(bob_addr, check_ann, timeout=60, interval=2)

if alice_got:
    pass_(f"{alice} received announcement '{ann_subject}'")
else:
    fail(f"{alice} did NOT receive announcement '{ann_subject}'")

if bob_got:
    pass_(f"{bob_addr} received announcement '{ann_subject}'")
else:
    fail(f"{bob_addr} did NOT receive announcement '{ann_subject}'")

mbox_path = f"/var/mail/{alice}"
mbox = mailbox.mbox(mbox_path)
alice_ann_count = sum(1 for m in mbox if m.get("Subject", "") == ann_subject)
print(f"  Alice received {alice_ann_count} copy/copies of the announcement (poster copy is acceptable either way)")

# ============================================================
# (e) Leave: bob leaves
# ============================================================
print("\n=== (e) LEAVE FLOW ===")
send_email("", "", f"{bob_addr}@{DOMAIN}", LEAVE)
print(f"Sent leave request from {bob_addr}@{DOMAIN} to {LEAVE}")

bob_leave_confirm = None
def check_bob_leave(mbox):
    global bob_leave_confirm
    bob_leave_confirm = check_confirm(mbox)
    return bob_leave_confirm is not None

if poll_mailbox(bob_addr, check_bob_leave, timeout=60, interval=2):
    pass_(f"Leave confirmation email arrived for {bob_addr}")
    print(f"  Subject: {bob_leave_confirm.get('Subject')}")
else:
    fail("No leave confirmation email arrived for bob within 60s")

if bob_leave_confirm:
    send_email("", "", f"{bob_addr}@{DOMAIN}", bob_leave_confirm.get("From"))
    print(f"Replied to leave confirmation from {bob_addr}@{DOMAIN}")

    if poll_mailbox(bob_addr, lambda m: True, timeout=60, interval=2):
        pass_(f"Leave confirmation processed for {bob_addr}")
    else:
        fail("Poll timeout after bob's leave confirmation reply")

    if is_not_member(bob_addr):
        pass_(f"{bob_addr} is NOT a member after leaving")
    else:
        fail(f"{bob_addr} is STILL a member after leaving")

ann2_subject = f"ANNOUNCE2-{ann2_rand}"
send_email("hello readers 2", ann2_subject, f"{alice}@{DOMAIN}", LIST)
print(f"Sent second announcement '{ann2_subject}' from {alice}@{DOMAIN}")

alice_got2 = poll_mailbox(alice, check_ann, timeout=60, interval=2)
if alice_got2:
    pass_(f"{alice} received second announcement '{ann2_subject}'")
else:
    fail(f"{alice} did NOT receive second announcement '{ann2_subject}'")

def check_bob_ann2(mbox):
    for msg in mbox:
        if msg.get("Subject", "") == ann2_subject:
            return True
    return False

bob_got2 = poll_mailbox(bob_addr, check_bob_ann2, timeout=20, interval=2)
if not bob_got2:
    pass_(f"{bob_addr} did NOT receive second announcement (leave effective)")
else:
    fail(f"{bob_addr} DID receive second announcement (leave may not be effective)")

# ============================================================
# (f) Re-join bob
# ============================================================
print("\n=== (f) RE-JOIN BOB ===")
send_email("", "", f"{bob_addr}@{DOMAIN}", JOIN)
print(f"Sent join request from {bob_addr}@{DOMAIN} to {JOIN}")

bob_rejoin_confirm = None
def check_bob_rejoin(mbox):
    global bob_rejoin_confirm
    bob_rejoin_confirm = check_confirm(mbox)
    return bob_rejoin_confirm is not None

if poll_mailbox(bob_addr, check_bob_rejoin, timeout=60, interval=2):
    pass_(f"Re-join confirmation email arrived for {bob_addr}")
    print(f"  From: {bob_rejoin_confirm.get('From')}")
    print(f"  Subject: {bob_rejoin_confirm.get('Subject')}")
else:
    fail("No re-join confirmation email arrived for bob within 60s")

if bob_rejoin_confirm:
    send_email("", "", f"{bob_addr}@{DOMAIN}", bob_rejoin_confirm.get("From"))
    print(f"Replied to re-join confirmation from {bob_addr}@{DOMAIN}")

    if poll_mailbox(bob_addr, lambda m: True, timeout=60, interval=2):
        pass_(f"Re-join confirmation processed for {bob_addr}")
    else:
        fail("Poll timeout after bob's re-join confirmation reply")

    if is_member(bob_addr):
        pass_(f"{bob_addr} IS a member again")
    else:
        fail(f"{bob_addr} is NOT a member after re-joining")

mlist = get_mlist()
alice_final = mlist.members.get_member(f"{alice}@{DOMAIN}")
bob_final = mlist.members.get_member(f"{bob_addr}@{DOMAIN}")
if alice_final and bob_final:
    pass_(f"Final state: both {alice} and {bob_addr} are members (2 members)")
else:
    fail(f"Final state: alice={alice_final}, bob={bob_final}")

# ============================================================
# Summary
# ============================================================
print("\n" + "=" * 60)
if FAILURES:
    print(f"FAILURES ({len(FAILURES)}):")
    for f in FAILURES:
        print(f"  - {f}")
    sys.exit(1)
else:
    print("ALL CHECKS PASSED")
    sys.exit(0)
PYEOF
