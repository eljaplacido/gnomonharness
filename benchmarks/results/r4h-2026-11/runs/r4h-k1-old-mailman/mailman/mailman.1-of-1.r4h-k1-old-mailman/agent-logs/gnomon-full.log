mlist = lm.get("reading-group@local.edu")
print("2. Got mlist, subscription_policy =", mlist.subscription_policy, flush=True)

def add_user(name):
    subprocess.run(["useradd", "-M", name], capture_output=True)

def send(body, subj, frm, to):
    msg = MIMEText(body)
    msg["Subject"] = subj
    msg["From"] = frm
    msg["To"] = to
    with smtplib.SMTP("localhost", 25) as srv:
        srv.send_message(msg)

def poll(user, check_fn, timeout=60, interval=2):
    end = time.time() + timeout
    while time.time() < end:
        p = f"/var/mail/{user}"
        if os.path.exists(p):
            try:
                mb = mailbox.mbox(p)
                if check_fn(mb):
                    return True
            except:
                pass
        time.sleep(interval)
    return False

