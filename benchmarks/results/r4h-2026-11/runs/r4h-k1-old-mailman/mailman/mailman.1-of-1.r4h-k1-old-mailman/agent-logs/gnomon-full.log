#!/usr/bin/env python3
import mailbox, os, smtplib, subprocess, sys, time
from email.mime.text import MIMEText
from mailman.core.initialize import initialize
from mailman.interfaces.listmanager import IListManager
from zope.component import getUtility

DOMAIN = "local.edu"
CFG = "/etc/mailman3/mailman.cfg"

print("1. Initializing mailman...", flush=True)
initialize(CFG)
lm = getUtility(IListManager)
mlist = lm.get("reading-group@local.edu")
print("2. Got mlist, subscription_policy =", mlist.subscription_policy, flush=True)

def add_user(name):
    subprocess.run(["useradd", "-M", name], capture_output=True)

def send(body, subj, frm, to):
    msg = MIMEText(body)
    msg["Subject"] = subj
    msg["From"] = frm
    msg["To"] = to
    with smtplib.SMTP("localhost", 25) as srv:
        srv.send_message(msg)

def poll(user, check_fn, timeout=60, interval=2):
    end = time.time() + timeout
    while time.time() < end:
        p = f"/var/mail/{user}"
        if os.path.exists(p):
            try:
                mb = mailbox.mbox(p)
                if check_fn(mb):
                    return True
            except:
                pass
        time.sleep(interval)
    return False

def retry_member_check(user, is_member_fn, timeout=60, interval=2):
    end = time.time() + timeout
    while time.time() < end:
        if is_member_fn():
            return True
        time.sleep(interval)
    return False

# (a) Alice join
print("3. Adding alice...", flush=True)
alice = "va" + os.urandom(4).hex()
add_user(alice)
print(f"4. Sending join for {alice}...", flush=True)
send("", "", f"{alice}@{DOMAIN}", "reading-group-join@local.edu")

confirm = [None]
def chk_confirm(m):
    for m2 in m:
        f = m2.get("From","")
        if f.startswith("reading-group-confirm"):
            confirm[0] = m2
            return True
    return False

print("5. Polling for confirmation...", flush=True)
if poll(alice, chk_confirm, 60, 2):
    print(f"6. Got confirm: From={confirm[0].get('From')}, Subject={confirm[0].get('Subject')}", flush=True)
else:
    print("6. NO CONFIRM", flush=True)
    sys.exit(1)

mem = mlist.members.get_member(f"{alice}@{DOMAIN}")
print(f"7. Alice member? {mem is not None}", flush=True)
if mem is not None:
    print("FAIL: alice already member", flush=True)
    sys.exit(1)
print("8. Alice not member yet - OK", flush=True)

# (b) Confirm
print("9. Replying to confirm...", flush=True)
send("", "", f"{alice}@{DOMAIN}", confirm[0].get("From"))
print("10. Waiting for confirmation to be processed...", flush=True)
if retry_member_check(alice, lambda: mlist.members.get_member(f"{alice}@{DOMAIN}") is not None, 60, 2):
    print("11. Alice confirmed - OK", flush=True)
else:
    print("11. FAIL: alice not member after confirm", flush=True)
    sys.exit(1)

# (c) Bob join
print("12. Adding bob...", flush=True)
bob = "vb" + os.urandom(4).hex()
add_user("vb" + bob)
bob_addr = "vb" + bob
print(f"13. Sending join for {bob_addr}...", flush=True)
send("", "", f"{bob_addr}@{DOMAIN}", "reading-group-join@local.edu")

bob_confirm = [None]
def chk_bob_confirm(m):
    for m2 in m:
        f = m2.get("From","")
        if f.startswith("reading-group-confirm"):
            bob_confirm[0] = m2
            return True
    return False

print("14. Polling for bob confirm...", flush=True)
if poll(bob_addr, chk_bob_confirm, 60, 2):
    print(f"15. Got bob confirm: From={bob_confirm[0].get('From')}", flush=True)
else:
    print("15. NO BOB CONFIRM", flush=True)
    sys.exit(1)

print("16. Replying to bob confirm...", flush=True)
send("", "", f"{bob_addr}@{DOMAIN}", bob_confirm[0].get("From"))
print("17. Waiting for bob confirmation...", flush=True)
if retry_member_check(bob_addr, lambda: mlist.members.get_member(f"{bob_addr}@{DOMAIN}") is not None, 60, 2):
    print("18. Bob confirmed - OK", flush=True)
else:
    print("18. FAIL: bob not member", flush=True)
    sys.exit(1)

am = mlist.members.get_member(f"{alice}@{DOMAIN}")
bm = mlist.members.get_member(f"{bob_addr}@{DOMAIN}")
print(f"19. Both members: alice={am is not None}, bob={bm is not None}", flush=True)
if not am or not bm:
    print("FAIL: not both members", flush=True)
    sys.exit(1)

# (d) Announcement - check for subject containing the announce string
print("20. Sending announcement...", flush=True)
ann = "ANNOUNCE-" + os.urandom(4).hex()
send("hello readers", ann, f"{alice}@{DOMAIN}", "reading-group@local.edu")

def chk_ann(m, subj):
    for m2 in m:
        s = m2.get("Subject","")
        if subj in s:
            return True
    return False

ag = poll(alice, lambda m: chk_ann(m, ann), 60, 2)
bg = poll(bob_addr, lambda m: chk_ann(m, ann), 60, 2)
print(f"21. Alice got ann? {ag}, Bob got ann? {bg}", flush=True)
if not ag or not bg:
    print("FAIL: announcement not delivered", flush=True)
    sys.exit(1)
print("22. Fan-out OK", flush=True)

# Check poster copy
mb = mailbox.mbox(f"/var/mail/{alice}")
alice_ann_count = sum(1 for m2 in mb if ann in m2.get("Subject",""))
print(f"23. Alice received {alice_ann_count} copy/copies of announcement (poster copy acceptable)", flush=True)

# (e) Bob leave
print("24. Bob leaving...", flush=True)
send("", "", f"{bob_addr}@{DOMAIN}", "reading-group-leave@local.edu")

bob_leave = [None]
def chk_leave(m):
    for m2 in m:
        f = m2.get("From","")
        if f.startswith("reading-group-confirm"):
            bob_leave[0] = m2
            return True
    return False

print("25. Polling for leave confirm...", flush=True)
if poll(bob_addr, chk_leave, 60, 2):
    print(f"26. Got leave confirm: Subject={bob_leave[0].get('Subject')}", flush=True)
else:
    print("26. NO LEAVE CONFIRM", flush=True)
    sys.exit(1)

print("27. Replying to leave confirm...", flush=True)
send("", "", f"{bob_addr}@{DOMAIN}", bob_leave[0].get("From"))
print("28. Waiting for leave to be processed...", flush=True)
if retry_member_check(bob_addr, lambda: mlist.members.get_member(f"{bob_addr}@{DOMAIN}") is None, 60, 2):
    print("29. Bob left - OK", flush=True)
else:
    print("29. FAIL: bob still member", flush=True)
    sys.exit(1)

# Second announcement
ann2 = "ANNOUNCE2-" + os.urandom(4).hex()
print(f"30. Sending ann2 '{ann2}'...", flush=True)
send("hello readers 2", ann2, f"{alice}@{DOMAIN}", "reading-group@local.edu")
ag2 = poll(alice, lambda m: chk_ann(m, ann2), 60, 2)
print(f"31. Alice got ann2? {ag2}", flush=True)
if not ag2:
    print("FAIL: alice didn't get ann2", flush=True)
    sys.exit(1)

bg2 = poll(bob_addr, lambda m: chk_ann(m, ann2), 20, 2)
print(f"32. Bob got ann2? {bg2}", flush=True)
if bg2:
    print("WARN: bob got ann2 (leave may not be effective)", flush=True)
else:
    print("33. Bob did NOT get ann2 - leave effective", flush=True)

# (f) Re-join bob
print("34. Bob re-joining...", flush=True)
send("", "", f"{bob_addr}@{DOMAIN}", "reading-group-join@local.edu")
bob_rejoin = [None]
def chk_rejoin(m):
    for m2 in m:
        f = m2.get("From","")
        if f.startswith("reading-group-confirm"):
            bob_rejoin[0] = m2
            return True
    return False

print("35. Polling for rejoin confirm...", flush=True)
if poll(bob_addr, chk_rejoin, 60, 2):
    print(f"36. Got rejoin confirm", flush=True)
else:
    print("36. NO REJOIN CONFIRM", flush=True)
    sys.exit(1)

print("37. Replying to rejoin confirm...", flush=True)
send("", "", f"{bob_addr}@{DOMAIN}", bob_rejoin[0].get("From"))
print("38. Waiting for rejoin...", flush=True)
if retry_member_check(bob_addr, lambda: mlist.members.get_member(f"{bob_addr}@{DOMAIN}") is not None, 60, 2):
    print("39. Bob re-joined - OK", flush=True)
else:
    print("39. FAIL: bob not member after rejoin", flush=True)
    sys.exit(1)

af = mlist.members.get_member(f"{alice}@{DOMAIN}")
bf = mlist.members.get_member(f"{bob_addr}@{DOMAIN}")
print(f"40. Final: alice={af is not None}, bob={bf is not None}", flush=True)
if af and bf:
    print("ALL CHECKS PASSED", flush=True)
else:
    print("FAIL: final state wrong", flush=True)
    sys.exit(1)
