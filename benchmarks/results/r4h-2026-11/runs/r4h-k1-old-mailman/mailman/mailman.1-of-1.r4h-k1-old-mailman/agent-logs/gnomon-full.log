#!/usr/bin/env python3
"""Independent verification of the reading-group@local.edu mailing list."""
import mailbox, os, smtplib, subprocess, sys, time
from email.mime.text import MIMEText
from functools import partial as bind
from mailman.core.initialize import initialize
from mailman.interfaces.listmanager import IListManager
from zope.component import getUtility

DOMAIN = "local.edu"
CFG = "/etc/mailman3/mailman.cfg"

def retry(func, retries=10, delay=2, backoff=2, exceptions=(Exception,)):
    """Retry until func() returns True or raises an exception."""
    attempt = 0
    current_delay = delay
    while attempt < retries:
        try:
            result = func()
            if result:
                return result
        except exceptions as e:
            pass  # treat as failure, retry
        attempt += 1
        if attempt == retries:
            raise AssertionError(f"retry exhausted after {retries} attempts")
        print(f"Retrying in {current_delay}s...")
        time.sleep(current_delay)
        current_delay *= backoff

def add_user(name):
    subprocess.run(["useradd", "-M", name], capture_output=True)

def send(body, subj, frm, to):
    msg = MIMEText(body)
    msg["Subject"] = subj
    msg["From"] = frm
    msg["To"] = to
    with smtplib.SMTP("localhost", 25) as srv:
        srv.send_message(msg)

def poll(user, check_fn, timeout=60, interval=2):
    end = time.time() + timeout
    while time.time() < end:
        p = f"/var/mail/{user}"
        if os.path.exists(p):
            try:
                mb = mailbox.mbox(p)
                if check_fn(mb):
                    return True
            except:
                pass
        time.sleep(interval)
    return False

def get_mlist():
    return _mlist

def is_member(user):
    return get_mlist().members.get_member(f"{user}@{DOMAIN}") is not None

def is_not_member(user):
    return get_mlist().members.get_member(f"{user}@{DOMAIN}") is None

def fail(msg):
    FAILURES.append(msg)
    print(f"FAIL: {msg}")

def pass_(msg):
    print(f"PASS: {msg}")

# Initialize once
initialize(CFG)
_lm = getUtility(IListManager)
_mlist = _lm.get("reading-group@local.edu")
FAILURES = []

# (a) Alice join
print("\n=== (a) JOIN ===")
alice = "va" + os.urandom(4).hex()
add_user(alice)
send("", "", f"{alice}@{DOMAIN}", "reading-group-join@local.edu")
print(f"Sent join from {alice}")

confirm = [None]
def chk_confirm(m):
    for m2 in m:
        f = m2.get("From","")
        if f.startswith("reading-group-confirm"):
            confirm[0] = m2
            return True
    return False

if poll(alice, chk_confirm, 60, 2):
    pass_(f"Confirm arrived: From={confirm[0].get('From')}, Subject={confirm[0].get('Subject')}")
else:
    fail("No confirm for alice"); sys.exit(1)

if is_not_member(alice):
    pass_(f"{alice} not member yet")
else:
    fail(f"{alice} already member"); sys.exit(1)

policy = _mlist.subscription_policy
print(f"  subscription_policy = {policy}")
print(f"  subscription_policy is not SubscriptionPolicy.open = {policy.name != 'open'}")

# (b) Confirm alice
print("\n=== (b) CONFIRM ===")
send("", "", f"{alice}@{DOMAIN}", confirm[0].get("From"))
print(f"Replied to confirm from {alice}")
retry(bind(is_member, alice), retries=15, delay=2, backoff=2)
if is_member(alice):
    pass_(f"{alice} confirmed")
else:
    fail(f"{alice} not member after confirm"); sys.exit(1)

# (c) Bob join
print("\n=== (c) BOB JOIN ===")
bob = "vb" + os.urandom(4).hex()
add_user("vb" + bob)
bob_addr = "vb" + bob
send("", "", f"{bob_addr}@{DOMAIN}", "reading-group-join@local.edu")
print(f"Sent join from {bob_addr}")

bob_confirm = [None]
def chk_bob(m):
    for m2 in m:
        f = m2.get("From","")
        if f.startswith("reading-group-confirm"):
            bob_confirm[0] = m2
            return True
    return False

if poll(bob_addr, chk_bob, 60, 2):
    pass_(f"Bob confirm: From={bob_confirm[0].get('From')}")
else:
    fail("No confirm for bob"); sys.exit(1)

if is_not_member(bob_addr):
    pass_(f"{bob_addr} not member yet")
else:
    fail(f"{bob_addr} already member"); sys.exit(1)

send("", "", f"{bob_addr}@{DOMAIN}", bob_confirm[0].get("From"))
print(f"Replied to bob confirm")
retry(bind(is_member, bob_addr), retries=15, delay=2, backoff=2)
if is_member(bob_addr):
    pass_(f"{bob_addr} confirmed")
else:
    fail(f"{bob_addr} not member"); sys.exit(1)

if is_member(alice) and is_member(bob_addr):
    pass_(f"Both members")
else:
    fail("Not both members"); sys.exit(1)

# (d) Announcement
print("\n=== (d) ANNOUNCE ===")
ann = "ANNOUNCE-" + os.urandom(4).hex()
send("hello readers", ann, f"{alice}@{DOMAIN}", "reading-group@local.edu")
print(f"Sent ann '{ann}'")

def chk_ann(m, s):
    for m2 in m:
        if s in m2.get("Subject",""):
            return True
    return False

ag = poll(alice, lambda m: chk_ann(m, ann), 60, 2)
bg = poll(bob_addr, lambda m: chk_ann(m, ann), 60, 2)
if ag: pass_(f"Alice got ann")
else: fail(f"Alice no ann"); sys.exit(1)
if bg: pass_(f"Bob got ann")
else: fail(f"Bob no ann"); sys.exit(1)
mb = mailbox.mbox(f"/var/mail/{alice}")
ac = sum(1 for m2 in mb if ann in m2.get("Subject",""))
print(f"  Alice poster copy: {ac}")

# (e) Bob leave
print("\n=== (e) LEAVE ===")
send("", "", f"{bob_addr}@{DOMAIN}", "reading-group-leave@local.edu")
print(f"Sent leave from {bob_addr}")

bob_leave = [None]
def chk_leave(m):
    for m2 in m:
        f = m2.get("From","")
        if f.startswith("reading-group-confirm"):
            bob_leave[0] = m2
            return True
    return False

if poll(bob_addr, chk_leave, 60, 2):
    pass_(f"Leave confirm: Subject={bob_leave[0].get('Subject')}")
else:
    fail("No leave confirm"); sys.exit(1)

send("", "", f"{bob_addr}@{DOMAIN}", bob_leave[0].get("From"))
print(f"Replied to leave confirm")
retry(bind(is_not_member, bob_addr), retries=15, delay=2, backoff=2)
if is_not_member(bob_addr):
    pass_(f"{bob_addr} left")
else:
    fail(f"{bob_addr} still member"); sys.exit(1)

ann2 = "ANNOUNCE2-" + os.urandom(4).hex()
send("hello readers 2", ann2, f"{alice}@{DOMAIN}", "reading-group@local.edu")
print(f"Sent ann2 '{ann2}'")

ag2 = poll(alice, lambda m: chk_ann(m, ann2), 60, 2)
if ag2: pass_(f"Alice got ann2")
else: fail(f"Alice no ann2"); sys.exit(1)

bg2 = poll(bob_addr, lambda m: chk_ann(m, ann2), 20, 2)
if not bg2:
    pass_(f"Bob did NOT get ann2 (leave effective)")
else:
    fail(f"Bob got ann2 (leave may not be effective)")

# (f) Re-join bob
print("\n=== (f) RE-JOIN ===")
send("", "", f"{bob_addr}@{DOMAIN}", "reading-group-join@local.edu")
print(f"Sent rejoin from {bob_addr}")

bob_rejoin = [None]
def chk_rejoin(m):
    for m2 in m:
        f = m2.get("From","")
        if f.startswith("reading-group-confirm"):
            bob_rejoin[0] = m2
            return True
    return False

if poll(bob_addr, chk_rejoin, 60, 2):
    pass_(f"Rejoin confirm")
else:
    fail("No rejoin confirm"); sys.exit(1)

send("", "", f"{bob_addr}@{DOMAIN}", bob_rejoin[0].get("From"))
print(f"Replied to rejoin confirm")
retry(bind(is_member, bob_addr), retries=15, delay=2, backoff=2)
if is_member(bob_addr):
    pass_(f"{bob_addr} re-joined")
else:
    fail(f"{bob_addr} not member after rejoin"); sys.exit(1)

af = is_member(alice)
bf = is_member(bob_addr)
if af and bf:
    pass_(f"Final: both members")
else:
    fail(f"Final: alice={af}, bob={bf}"); sys.exit(1)

print("\n" + "=" * 60)
if FAILURES:
    print(f"FAILURES ({len(FAILURES)}):")
    for f in FAILURES: print(f"  - {f}")
    sys.exit(1)
else:
    print("ALL CHECKS PASSED")
    sys.exit(0)
