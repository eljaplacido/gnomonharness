import torch, transformers, peft, json, sys
print("py", sys.version.split()[0])
print("torch", torch.__version__, "cuda", torch.cuda.is_available())
print("transformers", transformers.__version__)
print("peft", peft.__version__)
from transformers import AutoTokenizer, AutoModelForCausalLM
tok = AutoTokenizer.from_pretrained("openai-community/gpt2")
print("pad_token", tok.pad_token, "eos", tok.eos_token, tok.eos_token_id)
for L in "ABCD":
    ids = tok.encode(" " + L, add_special_tokens=False)
    ids2 = tok.encode(L, add_special_tokens=False)
    print("letter", L, "'_"+L+"'", ids, "'"+L+"'", ids2)
m = AutoModelForCausalLM.from_pretrained("openai-community/gpt2")
names = [n for n, _ in m.named_modules() if "c_attn" in n]
print("c_attn modules:", names[:3], "count", len(names))
print("c_attn type:", type(dict(m.named_modules())[names[0]]).__name__ if names else None)
print("params(M)", sum(p.numel() for p in m.parameters()) / 1e6)

data = json.load(open("/app/data/train.json"))
def prompt(s):
    lines = ["Question: " + s["question"]] + [o.strip() for o in s["options"]] + ["Answer:"]
    return "\n".join(lines)
lens = [len(tok(prompt(s) + " A").input_ids) for s in data]
lens.sort()
print("prompt token len: min", lens[0], "p50", lens[len(lens)//2], "p95", lens[int(len(lens)*0.95)], "max", lens[-1])
print("over 256:", sum(l > 256 for l in lens), "over 512:", sum(l > 512 for l in lens))
