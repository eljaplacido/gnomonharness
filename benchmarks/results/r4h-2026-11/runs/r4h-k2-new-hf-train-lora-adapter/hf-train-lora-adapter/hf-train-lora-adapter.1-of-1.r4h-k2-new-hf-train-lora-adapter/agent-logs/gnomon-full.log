[approval] bash: python3 -c "
import json
from transformers import AutoTokenizer
t = AutoTokenizer.from_pretrained('openai-community/gpt2')
with open('/app/data/train.json') as f:
    data = json.load(f)

def build_prompt(item):
    q = item['question']
    opt_lines = []
    for opt in item['options']:
        letter = opt[0]
        text = opt[2:]
        opt_lines.append(f'{letter}. {text}')
    return f'Question: {q}\nOptions:\n' + '\n'.join(opt_lines) + '\nAnswer:'

def build_target(item):
    letter = item['answer']
    for opt in item['options']:
        if opt.startswith(f'{letter}. '):
            text = opt[2:]
            return f' {letter}. {text}'
    return f' {letter}.'

lengths = []
for item in data:
    p = build_prompt(item)
    t2 = build_target(item)
    pt = t.encode(p, add_special_tokens=False)
    tt = t.encode(t2, add_special_tokens=False)
    lengths.append(len(pt) + len(tt))

import statistics
print(f'Min: {min(lengths)}, Max: {max(lengths)}, Mean: {statistics.mean(lengths):.1f}, Median: {statistics.median(lengths):.1f}')
print(f'P90: {sorted(lengths)[int(0.9*len(lengths))]}')
print(f'P95: {sorted(lengths)[int(0.95*len(lengths))]}')
print(f'P99: {sorted(lengths)[int(0.99*len(lengths))]}')
print(f'Count > 256: {sum(1 for l in lengths if l > 256)}')
print(f'Count > 200: {sum(1 for l in lengths if l > 200)}')
print(f'Count > 150: {sum(1 for l in lengths if l > 150)}')
" 2>&1 — approved
