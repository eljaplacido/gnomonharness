import os, re, sys

html_files = [
    'my_website/index.html',
    'my_website/publications.html',
    'my_website/blog.html',
    'my_website/blog/building-interpretable-models.html',
    'my_website/blog/ml-single-cell-genomics.html',
    'my_website/blog/scaling-gnns-connectomics.html',
]

errors = []
for fpath in html_files:
    with open(fpath) as f:
        content = f.read()
    base = os.path.dirname(fpath)
    # Find all href and src attributes
    for m in re.finditer(r'(?:href|src)=[\"']([^\"']+)[\"']', content):
        link = m.group(1)
        # Skip mailto:, tel:, #, javascript:, external URLs
        if link.startswith('mailto:') or link.startswith('tel:') or link.startswith('#') or link.startswith('javascript:'):
            continue
        if link.startswith('http://') or link.startswith('https://'):
            continue
        # Resolve relative to file's directory
        resolved = os.path.normpath(os.path.join(base, link))
        if not os.path.isfile(resolved):
            errors.append(f'{fpath}: {link} -> {resolved} NOT FOUND')

if errors:
    for e in errors:
        print(f'FAIL: {e}')
    sys.exit(1)
else:
    print('PASS: All internal href/src resolve to existing files')
