        if tag_lower in self.VOID_ELEMENTS:
            return
        
        self.tag_stack.append((tag_lower, self.getpos()[0]))
        
        if tag_lower == 'h1':
            self.h1_count += 1
            self.heading_tags.append((1, 'h1'))
        elif tag_lower == 'h2':
            self.heading_tags.append((2, 'h2'))
        elif tag_lower == 'h3':
            self.heading_tags.append((3, 'h3'))
        elif tag_lower == 'h4':
            self.heading_tags.append((4, 'h4'))
        elif tag_lower == 'h5':
            self.heading_tags.append((5, 'h5'))
        elif tag_lower == 'h6':
            self.heading_tags.append((6, 'h6'))
        elif tag_lower == 'link':
            attr_dict = dict(attrs)
            rel = attr_dict.get('rel', '')
            href = attr_dict.get('href', '')
            if isinstance(rel, list):
                rel = ' '.join(rel)
            if 'stylesheet' in rel:
                self.stylesheet_links.append(href)
        elif tag_lower == 'a':
            self.total_a_tags += 1
            attr_dict = dict(attrs)
            href = attr_dict.get('href', '')
            if href:
                self.internal_links.append(href)

    def handle_endtag(self, tag):
        tag_lower = tag.lower()
        for i in range(len(self.tag_stack) - 1, -1, -1):
            if self.tag_stack[i][0] == tag_lower:
                self.tag_stack.pop(i)
                break

def check_heading_order(headings):
    if not headings:
        return "PASS (no headings)"
    prev_level = 0
    for level, tag in headings:
        if level > prev_level + 1:
            return f"FAIL: skipped from h{prev_level} to h{level}"
        prev_level = level
    return "PASS"

def check_internal_links(links, base_dir):
    broken = 0
    for href in links:
        if href.startswith('http://') or href.startswith('https://') or href.startswith('mailto:') or href.startswith('#'):
            continue
        if href.startswith('data:') or href.startswith('javascript:'):
            continue
        path = href.split('#')[0].split('?')[0]
        if not path:
            continue
        page_dir = os.path.dirname(base_dir)
        full_path = os.path.normpath(os.path.join(page_dir, path))
        if not os.path.isfile(full_path):
            broken += 1
    return broken

html_files = [
    'index.html',
    'publications.html',
    'blog.html',
    'blog/building-interpretable-models.html',
    'blog/ml-single-cell-genomics.html',
    'blog/scaling-gnns-connectomics.html',
]

results = []

for hf in html_files:
    filepath = os.path.join('my_website', hf)
    with open(filepath, 'r', encoding='utf-8', errors='replace') as f:
        content = f.read()
    
    analyzer = HTMLAnalyzer()
    analyzer.feed(content)
    
    unclosed = analyzer.tag_stack
    heading_verdict = check_heading_order(analyzer.heading_tags)
    broken_links = check_internal_links(analyzer.internal_links, filepath)
    
    stylesheet_ok = True
    for sl in analyzer.stylesheet_links:
        if sl:
            sl_path = os.path.normpath(os.path.join('my_website', os.path.dirname(hf), sl))
            if not os.path.isfile(sl_path):
                stylesheet_ok = False
    
    byte_size = os.path.getsize(filepath)
    
    print(f"=== {hf} ===")
    print(f"  bytes: {byte_size}")
    print(f"  h1 count: {analyzer.h1_count}")
    print(f"  heading order: {heading_verdict}")
    print(f"  total <a> tags: {analyzer.total_a_tags}")
    print(f"  broken internal links: {broken_links}")
    print(f"  stylesheet link valid: {stylesheet_ok}")
    if unclosed:
        print(f"  unclosed tags: {unclosed}")
    else:
        print(f"  unclosed tags: none")
    print()
    
    results.append((hf, byte_size, analyzer.h1_count, heading_verdict, broken_links))

