import json, random, torch
from peft import LoraConfig, get_peft_model, TaskType
from transformers import AutoModelForCausalLM, AutoTokenizer

random.seed(42); torch.manual_seed(42)
tokenizer = AutoTokenizer.from_pretrained('openai-community/gpt2')
tokenizer.pad_token = tokenizer.eos_token
model = AutoModelForCausalLM.from_pretrained('openai-community/gpt2')
cfg = LoraConfig(r=8, lora_alpha=16, target_modules=['c_attn'], task_type=TaskType.CAUSAL_LM, lora_dropout=0.05, bias='none')
model = get_peft_model(model, cfg)
model.train()
print('Model ready')

with open('data/train.json') as f: train = json.load(f)
ex = train[0]
prompt = f\"Question: {ex['question']}\n\" + '\n'.join(ex['options']) + '\nAnswer:'
ids = tokenizer.encode(prompt, add_special_tokens=False)
print(f'Prompt tokens: {len(ids)}')

import time
t0 = time.time()
out = model(torch.tensor([ids]))
t1 = time.time()
print(f'Forward pass: {t1-t0:.2f}s')
print(f'Estimated epoch (300/8 batches): {(300/8)*(t1-t0):.0f}s')
print(f'Estimated 6 epochs: {(300/8)*(t1-t0)*6:.0f}s')
" 2>&1 — approved
