    t0 = time.perf_counter()
    time_model(ref, seed)
    t1 = time.perf_counter()
    ref_times.append(t1 - t0)
    
    t0 = time.perf_counter()
    time_model(m, seed)
    t1 = time.perf_counter()
    cand_times.append(t1 - t0)

ref_mean = np.mean(ref_times)
cand_mean = np.mean(cand_times)
print(f'Ref mean: {ref_mean:.4f}s, Cand mean: {cand_mean:.4f}s, pctg: {cand_mean/ref_mean:.4f}')
