nstep_ref = int(2.0 / ref.opt.timestep)

ref_states = {}
for seed in range(20):
    data = mujoco.MjData(ref)
    rng = np.random.default_rng(seed)
    data.qpos += rng.normal(0, 0.01, size=data.qpos.shape)
    mujoco.mj_forward(ref, data)
    for _ in range(nstep_ref):
        mujoco.mj_step(ref, data)
    full_physics = mujoco.mjtState.mjSTATE_FULLPHYSICS
    state = np.zeros(mujoco.mj_stateSize(ref, full_physics))
    mujoco.mj_getState(ref, data, state, full_physics)
    ref_states[seed] = state

# Test PGS with different tolerances
for tol in [1e-8, 1e-7, 1e-6, 1e-5]:
    xml = f'''<mujoco model=\"Cable\">
  <extension><plugin plugin=\"mujoco.elasticity.cable\"/></extension>
  <statistic center=\"0 0 .3\" extent=\"1\"/>
  <visual><global elevation=\"-30\"/></visual>
  <compiler autolimits=\"true\"/>
  <option timestep=\"0.002\" integrator=\"Euler\" solver=\"PGS\" iterations=\"20\" tolerance=\"{tol}\"/>
  <size memory=\"2M\"/>
  <worldbody>
    <composite type=\"cable\" curve=\"s\" count=\"41 1 1\" size=\"1\" offset=\"-.3 0 .6\" initial=\"none\">
      <plugin plugin=\"mujoco.elasticity.cable\">
        <config key=\"twist\" value=\"1e7\"/>
        <config key=\"bend\" value=\"4e6\"/>
        <config key=\"vmax\" value=\"0.05\"/>
      </plugin>
      <joint kind=\"main\" damping=\".015\"/>
      <geom type=\"capsule\" size=\".005\" rgba=\".8 .2 .1 1\" condim=\"1\"/>
    </composite>
    <body name=\"slider\" pos=\".7 0 .6\">
      <joint type=\"slide\" axis=\"1 0 0\" damping=\".1\"/>
      <geom size=\".01\"/>
    </body>
  </worldbody>
  <equality><connect name=\"right_boundary\" body1=\"B_last\" body2=\"slider\" anchor=\".025 0 0\"/></equality>
  <contact><exclude body1=\"B_last\" body2=\"slider\"/></contact>
  <actuator><motor site=\"S_last\" gear=\"0 0 0 1 0 0\" ctrlrange=\"-.03 .03\"/></actuator>
</mujoco>'''
    m = mujoco.MjModel.from_xml_string(xml)
    max_diff = 0
    allclose = 0
    for seed in range(20):
        data = mujoco.MjData(m)
        rng = np.random.default_rng(seed)
        data.qpos += rng.normal(0, 0.01, size=data.qpos.shape)
        mujoco.mj_forward(m, data)
        nstep = int(2.0 / m.opt.timestep)
        for _ in range(nstep):
            mujoco.mj_step(m, data)
        full_physics = mujoco.mjtState.mjSTATE_FULLPHYSICS
        state = np.zeros(mujoco.mj_stateSize(m, full_physics))
        mujoco.mj_getState(m, data, state, full_physics)
        d = np.max(np.abs(state - ref_states[seed]))
        max_diff = max(max_diff, d)
        if np.allclose(state, ref_states[seed], atol=1e-5):
            allclose += 1
    print(f'PGS tol={tol}: max_diff={max_diff:.2e}, allclose={allclose}/20')
