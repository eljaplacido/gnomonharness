import time, numpy as np, mujoco

ref = mujoco.MjModel.from_xml_path('/app/model_ref.xml')

def time_model(model, seed):
    data = mujoco.MjData(model)
    rng = np.random.default_rng(seed)
    data.qpos += rng.normal(0, 0.01, size=data.qpos.shape)
    mujoco.mj_forward(model, data)
    for _ in range(int(2.0 / model.opt.timestep)):
        mujoco.mj_step(model, data)

time_model(ref, 9999)

# Test timing for Euler PGS vs implicitfast PGS
for integ in ['Euler', 'implicitfast']:
    xml = f'''<mujoco model=\"Cable\">
  <extension><plugin plugin=\"mujoco.elasticity.cable\"/></extension>
  <statistic center=\"0 0 .3\" extent=\"1\"/>
  <visual><global elevation=\"-30\"/></visual>
  <compiler autolimits=\"true\"/>
  <option timestep=\"0.002\" integrator=\"{integ}\" solver=\"PGS\" iterations=\"20\" tolerance=\"1e-8\"/>
  <size memory=\"2M\"/>
  <worldbody>
    <composite type=\"cable\" curve=\"s\" count=\"41 1 1\" size=\"1\" offset=\"-.3 0 .6\" initial=\"none\">
      <plugin plugin=\"mujoco.elasticity.cable\">
        <config key=\"twist\" value=\"1e7\"/>
        <config key=\"bend\" value=\"4e6\"/>
        <config key=\"vmax\" value=\"0.05\"/>
      </plugin>
      <joint kind=\"main\" damping=\".015\"/>
      <geom type=\"capsule\" size=\".005\" rgba=\".8 .2 .1 1\" condim=\"1\"/>
    </composite>
    <body name=\"slider\" pos=\".7 0 .6\">
      <joint type=\"slide\" axis=\"1 0 0\" damping=\".1\"/>
      <geom size=\".01\"/>
    </body>
  </worldbody>
  <equality><connect name=\"right_boundary\" body1=\"B_last\" body2=\"slider\" anchor=\".025 0 0\"/></equality>
  <contact><exclude body1=\"B_last\" body2=\"slider\"/></contact>
  <actuator><motor site=\"S_last\" gear=\"0 0 0 1 0 0\" ctrlrange=\"-.03 .03\"/></actuator>
</mujoco>'''
    m = mujoco.MjModel.from_xml_string(xml)
    times = []
    for i in range(20):
        seed = np.random.randint(0, 10000)
        t0 = time.perf_counter()
        time_model(m, seed)
        t1 = time.perf_counter()
        times.append(t1 - t0)
    print(f'{integ} PGS: mean={np.mean(times):.4f}s')
