import re, os, sys

html_files = []
for root, dirs, files in os.walk('.'):
    for f in files:
        if f.endswith('.html'):
            html_files.append(os.path.join(root, f))
html_files.sort()

broken = []
for hf in html_files:
    with open(hf) as fh:
        content = fh.read()
    # Find all href values
    for m in re.finditer(r'href=\"([^\"]+)\"', content):
        href = m.group(1)
        # Skip mailto:, http(s)://, #, javascript:
        if href.startswith('mailto:') or href.startswith('http://') or href.startswith('https://') or href.startswith('#') or href.startswith('javascript:'):
            continue
        # Resolve relative to the HTML file's directory
        target = os.path.normpath(os.path.join(os.path.dirname(hf), href))
        if not os.path.isfile(target):
            broken.append(f'{hf}: href=\"{href}\" -> {target} (NOT FOUND)')

if broken:
    print('BROKEN LINKS:')
    for b in broken:
        print(b)
    sys.exit(1)
else:
    print('All internal hrefs resolve correctly.')
    print()
    for hf in html_files:
        print(f'  {hf}')
"
