#!/usr/bin/env python3
"""Direct query execution against parsed Turtle data."""
import re, sys
from collections import defaultdict

def parse_turtle(filepath):
    triples = []
    prefixes = {}
    with open(filepath) as f:
        content = f.read()
    for m in re.finditer(r'@prefix\s+(\w+):\s*<([^>]+)>\s*\.', content):
        prefixes[m.group(1)] = m.group(2)
    content = re.sub(r'#[^\n]*', '', content)
    pat = r'<[^>]+>|"[^"]*"|\[.*?\]|\w+:\w+|[.,;:<>[\]]|\w+'
    tokens = re.findall(pat, content)
    i = 0
    while i < len(tokens):
        n2 = parse_node(tokens, i)
        if n2 is None:
            i += 1
            continue
        i = n2['end']
        subj = n2['uri']
        while i < len(tokens):
            if tokens[i] == '.':
                i += 1
                break
            if tokens[i] == ',':
                i += 1
                continue
            pr = parse_node(tokens, i)
            if pr is None:
                i += 1
                continue
            i = pr['end']
            pred = pr['uri']
            if i >= len(tokens):
                break
            if tokens[i] == '.':
                i += 1
                break
            while True:
                or2 = parse_node(tokens, i)
                if or2 is None:
                    break
                i = or2['end']
                if 'val' in or2:
                    triples.append((subj, pred, or2['val'], or2.get('datatype'), or2.get('lang')))
                elif 'uri' in or2:
                    triples.append((subj, pred, or2['uri'], None, None))
                if i < len(tokens) and tokens[i] == ',':
                    i += 1
                    continue
                break
    return triples, prefixes

def parse_node(tokens, i):
    if i >= len(tokens):
        return None
    tok = tokens[i]
    if tok.startswith('<') and tok.endswith('>'):
        return {'uri': tok[1:-1], 'end': i + 1}
    if ':' in tok and not tok.startswith('"') and not tok.startswith('['):
        parts = tok.split(':', 1)
        if len(parts) == 2 and parts[0] and parts[1]:
            return {'uri': tok, 'end': i + 1}
    if tok.startswith('"'):
        val = tok[1:]
        datatype = None
        lang = None
        dt = re.search(r'\^\^<([^>]+)>$', val)
        if dt:
            datatype = dt.group(1)
            val = val[:dt.start()]
        else:
            lm = re.search(r'@[a-zA-Z-]+$', val)
            if lm:
                lang = lm.group(0)[1:]
                val = val[:lm.start()]
        return {'val': val, 'datatype': datatype, 'lang': lang, 'end': i + 1}
    if tok.startswith('['):
        return {'uri': '_:bnode', 'end': i + 1}
    return None

def expand(uri, prefixes):
    if uri.startswith('<') and uri.endswith('>'):
        return uri[1:-1]
    if ':' in uri:
        parts = uri.split(':', 1)
        if parts[0] in prefixes:
            return prefixes[parts[0]] + parts[1]
    return uri

def is_var(tok):
    return tok.startswith('?')

def resolve(tok, b, prefixes):
    if is_var(tok):
        return b.get(tok)
    if tok.startswith('<') and tok.endswith('>'):
        return tok[1:-1]
    if ':' in tok:
        parts = tok.split(':', 1)
        if parts[0] in prefixes:
            return prefixes[parts[0]] + parts[1]
    return tok

def eval_filter(expr, b, prefixes):
    expr = expr.strip()
    m = re.match(r'!BOUND\((\?\w+)\)', expr)
    if m:
        return m.group(1) not in b or b[m.group(1)] == ''
    m = re.match(r'BOUND\((\?\w+)\)', expr)
    if m:
        return m.group(1) in b and b[m.group(1)] != ''
    m = re.match(r'STRSTARTS\(LCASE\((\?\w+)\),\s*"([^"]*)"\)', expr)
    if m:
        val = b.get(m.group(1), '')
        return str(val).lower().startswith(m.group(2).lower())
    m = re.match(r'(\?\w+)\s+IN\s*\((.+)\)', expr)
    if m:
        vals = re.findall(r'"([^"]*)"', m.group(2))
        return b.get(m.group(1), '') in vals
    m = re.match(r'(\?\w+)\s*>\s*"([^"]*)"\^\^<([^>]+)>', expr)
    if m:
        v = b.get(m.group(1), '')
        return v > m.group(2)
    m = re.match(r'(\?\w+)\s*<\s*"([^"]*)"\^\^<([^>]+)>', expr)
    if m:
        v = b.get(m.group(1), '')
        return v < m.group(2)
    m = re.match(r'(\?\w+)\s*==\s*"([^"]*)"', expr)
    if m:
        return str(b.get(m.group(1), '')) == m.group(2)
    m = re.match(r'(\?\w+)\s*!=\s*"([^"]*)"', expr)
    if m:
        return str(b.get(m.group(1), '')) != m.group(2)
    m = re.match(r'(\?\w+)\s*==\s*<([^>]+)>', expr)
    if m:
        return str(b.get(m.group(1), '')) == m.group(2)
    m = re.match(r'(\?\w+)\s*==\s*(\?\w+)', expr)
    if m:
        return str(b.get(m.group(1), '')) == str(b.get(m.group(2), ''))
    m = re.match(r'(\?\w+)\s*>\s*(\?\w+)', expr)
    if m:
        return str(b.get(m.group(1), '')) > str(b.get(m.group(2), ''))
    m = re.match(r'(\?\w+)\s*<\s*(\?\w+)', expr)
    if m:
        return str(b.get(m.group(1), '')) < str(b.get(m.group(2), ''))
    m = re.match(r'STR\((\?\w+)\)', expr)
    if m:
        return str(b.get(m.group(1), ''))
    m = re.match(r'CONTAINS\((\?\w+),\s*"([^"]*)"\)', expr)
    if m:
        return m.group(2) in str(b.get(m.group(1), ''))
    m = re.match(r'REGEX\((\?\w+),\s*"([^"]*)"', expr)
    if m:
        return bool(re.search(m.group(2), str(b.get(m.group(1), ''))))
    m = re.match(r'(\?\w+)\s*=\s*(\d+)', expr)
    if m:
        return str(b.get(m.group(1), '')) == m.group(2)
    ee = expr
    for v in re.findall(r'\?(\w+)', ee):
        ee = ee.replace('?' + v, repr(str(b.get(v, ''))))
    try:
        return bool(eval(ee))
    except:
        return True

def match_pattern(pat, binding, fp, rp, by_subj, by_obj):
    s_tok, p_tok, o_tok = pat
    s_val = resolve(s_tok, binding, {})
    p_val = resolve(p_tok, binding, {})
    o_val = resolve(o_tok, binding, {})
    s_is_var = is_var(s_tok)
    p_is_var = is_var(p_tok)
    o_is_var = is_var(o_tok)
    results = []
    
    if not s_is_var and not p_is_var and not o_is_var:
        if o_val in fp.get((s_val, p_val), set()):
            results.append(binding)
        return results
    
    if not s_is_var and not p_is_var and o_is_var:
        for o in fp.get((s_val, p_val), set()):
            results.append({**binding, o_tok: o})
        return results
    
    if not s_is_var and o_is_var and not p_is_var:
        for p in fp.get((s_val, o_val), set()):
            results.append({**binding, p_tok: p})
        return results
    
    if not s_is_var and p_is_var and o_is_var:
        for p, o in by_subj.get(s_val, []):
            results.append({**binding, p_tok: p, o_tok: o})
        return results
    
    if s_is_var and not p_is_var and not o_is_var:
        for s in rp.get((o_val, p_val), set()):
            results.append({**binding, s_tok: s})
        return results
    
    if s_is_var and not p_is_var and o_is_var:
        for s in rp.get((o_val, p_val), set()):
            results.append({**binding, s_tok: s})
        return results
    
    if s_is_var and p_is_var and not o_is_var:
        for s, p in by_obj.get(o_val, []):
            results.append({**binding, s_tok: s, p_tok: p})
        return results
    
    if not s_is_var and p_is_var and not o_is_var:
        for p in fp.get((s_val, o_val), set()):
            results.append({**binding, p_tok: p})
        return results
    
    if s_is_var and p_is_var and o_is_var:
        for s, p in by_subj.items():
            for pp, o in p:
                results.append({**binding, s_tok: s, p_tok: pp, o_tok: o})
        return results
    
    return results

def parse_sparql(qt):
    r = {'prefixes': {}, 'select_vars': [], 'where_patterns': [], 'filters': [],
         'group_by': [], 'group_concat': [], 'optional_patterns': []}
    for m in re.finditer(r'PREFIX\s+(\w+):\s*<([^>]+)>', qt, re.I|re.S):
        r['prefixes'][m.group(1)] = m.group(2)
