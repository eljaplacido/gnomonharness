#!/usr/bin/env python3
"""
Minimal SPARQL 1.1 engine for Turtle data.
"""

import re
import sys
from collections import defaultdict

def parse_turtle(filepath):
    triples = []
    prefixes = {}
    with open(filepath, 'r') as f:
        content = f.read()
    for m in re.finditer(r'@prefix\s+(\w+):\s*<([^>]+)>\s*\.', content):
        prefixes[m.group(1)] = m.group(2)
    content = re.sub(r'#[^\n]*', '', content)
    tokens = tokenize(content)
    i = 0
    while i < len(tokens):
        subj = parse_node(tokens, i)
        if subj is None:
            i += 1
            continue
        i = subj['end']
        subj_uri = subj['uri']
        while i < len(tokens):
            if tokens[i] == '.':
                i += 1
                break
            if tokens[i] == ',':
                i += 1
                continue
            pred_result = parse_node(tokens, i)
            if pred_result is None:
                i += 1
                continue
            i = pred_result['end']
            pred_uri = pred_result['uri']
            if i >= len(tokens):
                break
            if tokens[i] == '.':
                i += 1
                break
            while True:
                obj_result = parse_node(tokens, i)
                if obj_result is None:
                    break
                i = obj_result['end']
                obj_val = obj_result['val']
                obj_datatype = obj_result.get('datatype')
                obj_lang = obj_result.get('lang')
                triples.append((subj_uri, pred_uri, obj_val, obj_datatype, obj_lang))
                if i < len(tokens) and tokens[i] == ',':
                    i += 1
                    continue
                break
    return triples, prefixes

def tokenize(content):
    tokens = []
    i = 0
    while i < len(content):
        c = content[i]
        if c in ' \t\n\r':
            i += 1
            continue
        if c == '<':
            j = content.index('>', i)
            tokens.append(content[i:j+1])
            i = j + 1
        elif c == '"':
            j = i + 1
            while j < len(content):
                if content[j] == '\\':
                    j += 2
                    continue
                if content[j] == '"':
                    break
                j += 1
            tokens.append(content[i:j+1])
            i = j + 1
        elif c == '[':
            depth = 1
            j = i + 1
            while j < len(content) and depth > 0:
                if content[j] == '[':
                    depth += 1
                elif content[j] == ']':
                    depth -= 1
                j += 1
            tokens.append(content[i:j])
            i = j
        elif c == ']':
            tokens.append(']')
            i += 1
        else:
            j = i
            while j < len(content) and content[j] not in ' \t\n\r.,;:<>[]"':
                j += 1
            if j > i:
                tokens.append(content[i:j])
            i = j
    return tokens

def parse_node(tokens, i):
    if i >= len(tokens):
        return None
    tok = tokens[i]
    if tok.startswith('<') and tok.endswith('>'):
        return {'uri': tok[1:-1], 'end': i + 1}
    if ':' in tok and not tok.startswith('"') and not tok.startswith('['):
        parts = tok.split(':', 1)
        if len(parts) == 2 and parts[0] and parts[1]:
            return {'uri': tok, 'end': i + 1}
    if tok.startswith('"'):
        val = tok[1:]
        datatype = None
        lang = None
        dt_match = re.search(r'\^\^<([^>]+)>$', val)
        if dt_match:
            datatype = dt_match.group(1)
            val = val[:dt_match.start()]
        else:
            lang_match = re.search(r'@[a-zA-Z-]+$', val)
            if lang_match:
                lang = lang_match.group(0)[1:]
                val = val[:lang_match.start()]
        return {'val': val, 'datatype': datatype, 'lang': lang, 'end': i + 1}
    if tok.startswith('['):
        return {'uri': '_:bnode', 'end': i + 1}
    return None

def expand_prefix(uri, prefixes):
    if uri.startswith('<') and uri.endswith('>'):
        return uri[1:-1]
    if ':' in uri:
        parts = uri.split(':', 1)
        if parts[0] in prefixes:
            return prefixes[parts[0]] + parts[1]
    return uri

def parse_sparql(query_text):
    result = {
        'prefixes': {},
        'select_vars': [],
        'where_patterns': [],
        'filters': [],
        'group_by': [],
        'group_concat': [],
        'optional_patterns': [],
    }
    for m in re.finditer(r'PREFIX\s+(\w+):\s*<([^>]+)>', query_text, re.IGNORECASE):
        result['prefixes'][m.group(1)] = m.group(2)
    select_match = re.search(r'SELECT\s+(.+?)\s+WHERE', query_text, re.IGNORECASE | re.DOTALL)
    if select_match:
        select_str = select_match.group(1)
        for m in re.finditer(r'GROUP_CONCAT\((.+?)\)', select_str, re.IGNORECASE | re.DOTALL):
            gc_content = m.group(1)
            var_match = re.search(r'(\?\w+)', gc_content)
            if var_match:
                result['group_concat'].append({'var': var_match.group(1), 'content': gc_content})
        for m in re.finditer(r'\?(\w+)', select_str):
            v = m.group(1)
            if v not in [gc['var'] for gc in result['group_concat']]:
                result['select_vars'].append('?' + v)
    where_match = re.search(r'WHERE\s*\{(.+)\}', query_text, re.IGNORECASE | re.DOTALL)
    if where_match:
        where_body = where_match.group(1)
        optional_match = re.finditer(r'OPTIONAL\s*\{(.+?)\}', where_body, re.IGNORECASE | re.DOTALL)
        for om in optional_match:
            opt_body = om.group(1)
            patterns = extract_patterns(opt_body)
            result['optional_patterns'].extend(patterns)
        where_body_clean = re.sub(r'OPTIONAL\s*\{.+?\}', '', where_body, flags=re.IGNORECASE | re.DOTALL)
        patterns = extract_patterns(where_body_clean)
        result['where_patterns'].extend(patterns)
    filter_matches = re.finditer(r'FILTER\s*\((.+?)\)', query_text, re.IGNORECASE | re.DOTALL)
    for fm in filter_matches:
        result['filters'].append(fm.group(1).strip())
    gb_match = re.search(r'GROUP\s+BY\s+(.+?)(?:HAVING|ORDER|LIMIT|OFFSET|$)', query_text, re.IGNORECASE)
    if gb_match:
        gb_str = gb_match.group(1).strip()
        result['group_by'] = re.findall(r'\?(\w+)', gb_str)
    return result

def extract_patterns(body):
    patterns = []
    segments = re.split(r'\.', body)
    for segment in segments:
        segment = segment.strip()
        if not segment:
            continue
        parts = re.split(r',', segment)
        for part in parts:
            part = part.strip()
            if not part:
                continue
            tokens = tokenize_sparql(part)
            if len(tokens) >= 3:
                patterns.append((tokens[0], tokens[1], ' '.join(tokens[2:])))
    return patterns

def tokenize_sparql(s):
    tokens = []
    i = 0
    s = s.strip()
    while i < len(s):
        c = s[i]
        if c in ' \t\n\r':
            i += 1
            continue
        if c == '?':
            j = i + 1
            while j < len(s) and (s[j].isalnum() or s[j] == '_'):
                j += 1
            tokens.append(s[i:j])
            i = j
        elif c == '<':
            j = s.index('>', i)
            tokens.append(s[i:j+1])
            i = j + 1
        elif c == '"':
            j = i + 1
            while j < len(s):
                if s[j] == '\\':
                    j += 2
                    continue
                if s[j] == '"':
                    break
                j += 1
            tokens.append(s[i:j+1])
            i = j + 1
        elif c in '()':
            tokens.append(c)
            i += 1
        else:
            j = i
            while j < len(s) and s[j] not in ' \t\n\r<>"?^()':
                j += 1
            if j > i:
                tokens.append(s[i:j])
            i = j
    return tokens

def is_var(tok):
    return tok.startswith('?')

def evaluate_patterns(patterns, idx, obj_idx, prefixes):
    if not patterns:
        return [{}]
    bindings = [{}]
    for subj_tok, pred_tok, obj_tok in patterns:
        new_bindings = []
        for b in bindings:
            subj_val = resolve_tok(subj_tok, b, prefixes)
            pred_val = resolve_tok(pred_tok, b, prefixes)
            obj_val = resolve_tok(obj_tok, b, prefixes)
            if subj_val is not None and pred_val is not None and obj_val is not None:
                for o, dt, lang in idx.get((subj_val, pred_val), []):
                    new_b = {**b}
                    if is_var(obj_tok):
                        new_b[obj_tok] = o
                    new_bindings.append(new_b)
            elif subj_val is not None and pred_val is not None:
                for o, dt, lang in idx.get((subj_val, pred_val), []):
                    new_b = {**b}
                    new_b[obj_tok] = o
                    new_bindings.append(new_b)
            elif subj_val is not None and obj_val is not None:
                for p, dt, lang in idx.get((subj_val, obj_val), []):
                    new_b = {**b}
                    new_b[pred_tok] = p
                    new_bindings.append(new_b)
            elif pred_val is not None and obj_val is not None:
                for s, dt, lang in obj_idx.get((obj_val, pred_val), []):
                    new_b = {**b}
                    new_b[subj_tok] = s
                    new_bindings.append(new_b)
            elif subj_val is not None:
                for (s, p), ml in idx.items():
                    if s == subj_val:
                        for o, dt, lang in ml:
                            new_b = {**b}
                            new_b[pred_tok] = p
                            new_b[obj_tok] = o
                            new_bindings.append(new_b)
            elif pred_val is not None:
                for (s, p), ml in idx.items():
                    if p == pred_val:
                        for o, dt, lang in ml:
                            new_b = {**b}
                            new_b[subj_tok] = s
                            new_b[obj_tok] = o
                            new_bindings.append(new_b)
            elif obj_val is not None:
                for (s, p), ml in obj_idx.items():
                    if p == obj_val:
                        for o, dt, lang in ml:
                            new_b = {**b}
                            new_b[subj_tok] = s
                            new_b[pred_tok] = p
                            new_bindings.append(new_b)
            else:
                for (s, p), ml in idx.items():
                    for o, dt, lang in ml:
                        new_b = {**b}
                        new_b[subj_tok] = s
                        new_b[pred_tok] = p
                        new_b[obj_tok] = o
                        new_bindings.append(new_b)
        bindings = new_bindings
    return bindings

def resolve_tok(tok, binding, prefixes):
    if is_var(tok):
        return binding.get(tok)
    if tok.startswith('<') and tok.endswith('>'):
        return tok[1:-1]
    if ':' in tok:
        parts = tok.split(':', 1)
        if parts[0] in prefixes:
            return prefixes[parts[0]] + parts[1]
    return tok

def apply_filters(bindings, filters, prefixes):
    result = []
    for b in bindings:
        if all(eval_filter(f, b, prefixes) for f in filters):
            result.append(b)
    return result

def eval_filter(expr, binding, prefixes):
    expr = expr.strip()
    m = re.match(r'!BOUND\((\?\w+)\)', expr)
    if m:
        var = m.group(1)
        return var not in binding or binding[var] == ''
    m = re.match(r'BOUND\((\?\w+)\)', expr)
    if m:
        var = m.group(1)
        return var in binding and binding[var] != ''
    m = re.match(r'STRSTARTS\(LCASE\((\?\w+)\),\s*"([^"]*)"\)', expr)
    if m:
        var = m.group(1)
        prefix = m.group(2)
        val = binding.get(var, '')
        return str(val).lower().startswith(prefix.lower())
    m = re.match(r'LCASE\((\?\w+)\)', expr)
    if m:
        var = m.group(1)
        return str(binding.get(var, '')).lower()
    m = re.match(r'(\?\w+)\s+IN\s*\((.+)\)', expr)
    if m:
        var = m.group(1)
        vals_str = m.group(2)
        vals = re.findall(r'"([^"]*)"', vals_str)
        val = binding.get(var, '')
        return val in vals
    m = re.match(r'(\?\w+)\s*>\s*"([^"]*)"\^\^<([^>]+)>', expr)
    if m:
        var = m.group(1)
        val = binding.get(var, '')
        literal_date = m.group(2)
        datatype = m.group(3)
        if datatype == 'http://www.w3.org/2001/XMLSchema#date':
            return val > literal_date
        return False
    m = re.match(r'(\?\w+)\s*<\s*"([^"]*)"\^\^<([^>]+)>', expr)
    if m:
        var = m.group(1)
        val = binding.get(var, '')
        literal_date = m.group(2)
        datatype = m.group(3)
        if datatype == 'http://www.w3.org/2001/XMLSchema#date':
            return val < literal_date
        return False
    m = re.match(r'(\?\w+)\s*==\s*"([^"]*)"', expr)
    if m:
        var = m.group(1)
        val = binding.get(var, '')
        return str(val) == m.group(2)
    m = re.match(r'(\?\w+)\s*!=\s*"([^"]*)"', expr)
    if m:
        var = m.group(1)
        val = binding.get(var, '')
        return str(val) != m.group(2)
    m = re.match(r'(\?\w+)\s*==\s*<([^>]+)>', expr)
    if m:
        var = m.group(1)
        val = binding.get(var, '')
        return str(val) == m.group(2)
    m = re.match(r'(\?\w+)\s*==\s*(\?\w+)', expr)
    if m:
        var1 = m.group(1)
        var2 = m.group(2)
        v1 = binding.get(var1, '')
        v2 = binding.get(var2, '')
        return str(v1) == str(v2)
    m = re.match(r'(\?\w+)\s*>\s*(\?\w+)', expr)
    if m:
        var1 = m.group(1)
        var2 = m.group(2)
        v1 = binding.get(var1, '')
        v2 = binding.get(var2, '')
        return str(v1) > str(v2)
    m = re.match(r'(\?\w+)\s*<\s*(\?\w+)', expr)
    if m:
        var1 = m.group(1)
        var2 = m.group(2)
        v1 = binding.get(var1, '')
        v2 = binding.get(var2, '')
        return str(v1) < str(v2)
    m = re.match(r'STR\((\?\w+)\)', expr)
    if m:
        var = m.group(1)
        return str(binding.get(var, ''))
    m = re.match(r'CONTAINS\((\?\w+),\s*"([^"]*)"\)', expr)
    if m:
        var = m.group(1)
        substr = m.group(2)
        val = binding.get(var, '')
        return substr in str(val)
    m = re.match(r'REGEX\((\?\w+),\s*"([^"]*)"', expr)
    if m:
        var = m.group(1)
        pattern = m.group(2)
        val = binding.get(var, '')
        return bool(re.search(pattern, str(val)))
    m = re.match(r'(\?\w+)\s*=\s*(\d+)', expr)
    if m:
        var = m.group(1)
        val = binding.get(var, '')
        return str(val) == m.group(2)
    eval_expr = expr
    for var in re.findall(r'\?(\w+)', eval_expr):
        val = binding.get(var, '')
        eval_expr = eval_expr.replace('?' + var, repr(str(val)))
    try:
        return bool(eval(eval_expr))
    except:
        return True

def evaluate_query(triples, prefixes, query):
    idx = defaultdict(list)
    for s, p, o, dt, lang in triples:
        idx[(s, p)].append((o, dt, lang))
    obj_idx = defaultdict(list)
    for s, p, o, dt, lang in triples:
        obj_idx[(o, p)].append((s, dt, lang))
    bindings = evaluate_patterns(query['where_patterns'], idx, obj_idx, query['prefixes'])
    for opt_patterns in query['optional_patterns']:
        opt_bindings = evaluate_patterns(opt_patterns, idx, obj_idx, query['prefixes'])
        opt_vars = set()
        for subj, pred, obj in opt_patterns:
            if is_var(subj): opt_vars.add(subj)
            if is_var(pred): opt_vars.add(pred)
            if is_var(obj): opt_vars.add(obj)
        new_bindings = []
        for b in bindings:
            matched = False
            for ob in opt_bindings:
                if all(b.get(v) == ob.get(v) for v in opt_vars if v in b):
                    new_bindings.append({**b, **ob})
                    matched = True
                    break
            if not matched:
                new_bindings.append(b)
        bindings = new_bindings
    bindings = apply_filters(bindings, query['filters'], query['prefixes'])
    if query['group_by']:
        groups = defaultdict(list)
        for b in bindings:
            key = tuple(b.get(v, '') for v in query['group_by'])
            groups[key].append(b)
        results = []
        for key, group in groups.items():
            row = {}
            for i, var in enumerate(query['group_by']):
                row[var] = group[0].get(var, '')
            for var in query['select_vars']:
                if var.startswith('?') and var not in query['group_by']:
                    vals = [b.get(var, '') for b in group]
                    row[var] = vals[0] if vals else ''
            for gc in query['group_concat']:
                gc_var = gc['var']
                vals = sorted(set(b.get(gc_var, '') for b in group if b.get(gc_var, '') != ''))
                row[gc_var] = ', '.join(vals)
            results.append(row)
        return results
    return bindings

def main():
    if len(sys.argv) < 3:
        print("Usage: python3 sparql_engine.py <turtle_file> <query_file> [mode]")
        sys.exit(1)
    turtle_file = sys.argv[1]
    query_file = sys.argv[2]
    mode = sys.argv[3] if len(sys.argv) > 3 else 'query'
    triples, prefixes = parse_turtle(turtle_file)
    if mode == 'query':
        with open(query_file, 'r') as f:
            query_text = f.read()
        query = parse_sparql(query_text)
        results = evaluate_query(triples, prefixes, query)
        if results:
            cols = list(results[0].keys())
            print('\t'.join(cols))
            for row in results:
                print('\t'.join(str(row.get(c, '')) for c in cols))
        else:
            print("(no results)")
    elif mode == 'enrollment':
        student_courses = defaultdict(set)
        student_grad = {}
        course_display = {}
        for s, p, o, dt, lang in triples:
