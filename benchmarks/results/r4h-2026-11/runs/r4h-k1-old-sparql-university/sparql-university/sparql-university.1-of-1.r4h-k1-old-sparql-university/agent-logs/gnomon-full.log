#!/usr/bin/env python3
"""Direct query execution against parsed Turtle data - regex tokenizer."""
import re, sys
from collections import defaultdict

def parse_turtle(filepath):
    triples = []
    prefixes = {}
    with open(filepath) as f:
        content = f.read()
    for m in re.finditer(r'@prefix\s+(\w+):\s*<([^>]+)>\s*\.', content):
        prefixes[m.group(1)] = m.group(2)
    content = re.sub(r'#[^\n]*', '', content)
    # Tokenize using regex
    tokens = re.findall(r'<[^>]+>|"[^"]*"|\[.*?\]|[^ \t\n\r.,;:<>\"\[\]]+', content)
    # Parse triples
    i = 0
    while i < len(tokens):
        n2 = parse_node(tokens, i)
        if n2 is None:
            i += 1
            continue
        i = n2['end']
        subj = n2['uri']
        while i < len(tokens):
            if tokens[i] == '.':
                i += 1
                break
            if tokens[i] == ',':
                i += 1
                continue
            pr = parse_node(tokens, i)
            if pr is None:
                i += 1
                continue
            i = pr['end']
            pred = pr['uri']
            if i >= len(tokens):
                break
            if tokens[i] == '.':
                i += 1
                break
            while True:
                or2 = parse_node(tokens, i)
                if or2 is None:
                    break
                i = or2['end']
                triples.append((subj, pred, or2['val'], or2.get('datatype'), or2.get('lang')))
                if i < len(tokens) and tokens[i] == ',':
                    i += 1
                    continue
                break
    return triples, prefixes

def parse_node(tokens, i):
    if i >= len(tokens):
        return None
    tok = tokens[i]
    if tok.startswith('<') and tok.endswith('>'):
        return {'uri': tok[1:-1], 'end': i + 1}
    if ':' in tok and not tok.startswith('"') and not tok.startswith('['):
        parts = tok.split(':', 1)
        if len(parts) == 2 and parts[0] and parts[1]:
            return {'uri': tok, 'end': i + 1}
    if tok.startswith('"'):
        val = tok[1:]
        datatype = None
        lang = None
        dt = re.search(r'\^\^<([^>]+)>$', val)
        if dt:
            datatype = dt.group(1)
            val = val[:dt.start()]
        else:
            lm = re.search(r'@[a-zA-Z-]+$', val)
            if lm:
                lang = lm.group(0)[1:]
                val = val[:lm.start()]
        return {'val': val, 'datatype': datatype, 'lang': lang, 'end': i + 1}
    if tok.startswith('['):
        return {'uri': '_:bnode', 'end': i + 1}
    return None

def expand(uri, prefixes):
    if uri.startswith('<') and uri.endswith('>'):
        return uri[1:-1]
    if ':' in uri:
        parts = uri.split(':', 1)
        if parts[0] in prefixes:
            return prefixes[parts[0]] + parts[1]
    return uri

def is_var(tok):
    return tok.startswith('?')

def resolve(tok, b, prefixes):
    if is_var(tok):
        return b.get(tok)
    if tok.startswith('<') and tok.endswith('>'):
        return tok[1:-1]
    if ':' in tok:
        parts = tok.split(':', 1)
        if parts[0] in prefixes:
            return prefixes[parts[0]] + parts[1]
    return tok

def eval_filter(expr, b, prefixes):
    expr = expr.strip()
    m = re.match(r'!BOUND\((\?\w+)\)', expr)
    if m:
        return m.group(1) not in b or b[m.group(1)] == ''
    m = re.match(r'BOUND\((\?\w+)\)', expr)
    if m:
        return m.group(1) in b and b[m.group(1)] != ''
    m = re.match(r'STRSTARTS\(LCASE\((\?\w+)\),\s*"([^"]*)"\)', expr)
    if m:
        val = b.get(m.group(1), '')
        return str(val).lower().startswith(m.group(2).lower())
    m = re.match(r'(\?\w+)\s+IN\s*\((.+)\)', expr)
    if m:
        vals = re.findall(r'"([^"]*)"', m.group(2))
        return b.get(m.group(1), '') in vals
    m = re.match(r'(\?\w+)\s*>\s*"([^"]*)"\^\^<([^>]+)>', expr)
    if m:
        v = b.get(m.group(1), '')
        return v > m.group(2)
    m = re.match(r'(\?\w+)\s*<\s*"([^"]*)"\^\^<([^>]+)>', expr)
    if m:
        v = b.get(m.group(1), '')
        return v < m.group(2)
    m = re.match(r'(\?\w+)\s*==\s*"([^"]*)"', expr)
    if m:
        return str(b.get(m.group(1), '')) == m.group(2)
    m = re.match(r'(\?\w+)\s*!=\s*"([^"]*)"', expr)
    if m:
        return str(b.get(m.group(1), '')) != m.group(2)
    m = re.match(r'(\?\w+)\s*==\s*<([^>]+)>', expr)
    if m:
        return str(b.get(m.group(1), '')) == m.group(2)
    m = re.match(r'(\?\w+)\s*==\s*(\?\w+)', expr)
    if m:
        return str(b.get(m.group(1), '')) == str(b.get(m.group(2), ''))
    m = re.match(r'(\?\w+)\s*>\s*(\?\w+)', expr)
    if m:
        return str(b.get(m.group(1), '')) > str(b.get(m.group(2), ''))
    m = re.match(r'(\?\w+)\s*<\s*(\?\w+)', expr)
    if m:
        return str(b.get(m.group(1), '')) < str(b.get(m.group(2), ''))
    m = re.match(r'STR\((\?\w+)\)', expr)
    if m:
        return str(b.get(m.group(1), ''))
    m = re.match(r'CONTAINS\((\?\w+),\s*"([^"]*)"\)', expr)
    if m:
        return m.group(2) in str(b.get(m.group(1), ''))
    m = re.match(r'REGEX\((\?\w+),\s*"([^"]*)"', expr)
    if m:
        return bool(re.search(m.group(2), str(b.get(m.group(1), ''))))
    m = re.match(r'(\?\w+)\s*=\s*(\d+)', expr)
    if m:
        return str(b.get(m.group(1), '')) == m.group(2)
    ee = expr
    for v in re.findall(r'\?(\w+)', ee):
        ee = ee.replace('?' + v, repr(str(b.get(v, ''))))
    try:
        return bool(eval(ee))
    except:
        return True

def match_pattern(pat, binding, fp, rp, by_subj, by_obj):
    s_tok, p_tok, o_tok = pat
    s_val = resolve(s_tok, binding, {})
    p_val = resolve(p_tok, binding, {})
    o_val = resolve(o_tok, binding, {})
    s_is_var = is_var(s_tok)
    p_is_var = is_var(p_tok)
    o_is_var = is_var(o_tok)
    results = []
    
    if not s_is_var and not p_is_var and not o_is_var:
        if o_val in fp.get((s_val, p_val), set()):
            results.append(binding)
        return results
    
    if not s_is_var and not p_is_var and o_is_var:
        for o in fp.get((s_val, p_val), set()):
            results.append({**binding, o_tok: o})
        return results
    
    if not s_is_var and o_is_var and not p_is_var:
        for p in fp.get((s_val, o_val), set()):
            results.append({**binding, p_tok: p})
        return results
    
    if not s_is_var and p_is_var and o_is_var:
        for p, o in by_subj.get(s_val, []):
            results.append({**binding, p_tok: p, o_tok: o})
        return results
    
    if s_is_var and not p_is_var and not o_is_var:
        for s in rp.get((o_val, p_val), set()):
            results.append({**binding, s_tok: s})
        return results
    
    if s_is_var and not p_is_var and o_is_var:
        for s in rp.get((o_val, p_val), set()):
            results.append({**binding, s_tok: s})
        return results
    
    if s_is_var and p_is_var and not o_is_var:
        for s, p in by_obj.get(o_val, []):
            results.append({**binding, s_tok: s, p_tok: p})
        return results
    
    if not s_is_var and p_is_var and not o_is_var:
        for p in fp.get((s_val, o_val), set()):
            results.append({**binding, p_tok: p})
        return results
    
    if s_is_var and p_is_var and o_is_var:
        for s, p in by_subj.items():
            for pp, o in p:
                results.append({**binding, s_tok: s, p_tok: pp, o_tok: o})
        return results
    
    return results

def parse_sparql(qt):
    r = {'prefixes': {}, 'select_vars': [], 'where_patterns': [], 'filters': [],
         'group_by': [], 'group_concat': [], 'optional_patterns': []}
    for m in re.finditer(r'PREFIX\s+(\w+):\s*<([^>]+)>', qt, re.I|re.S):
        r['prefixes'][m.group(1)] = m.group(2)
    sm = re.search(r'SELECT\s+(.+?)\s+WHERE', qt, re.I|re.S)
    if sm:
        ss = sm.group(1)
        for m in re.finditer(r'GROUP_CONCAT\((.+?)\)', ss, re.I|re.S):
            gc = m.group(1)
            vm = re.search(r'(\?\w+)', gc)
            if vm:
                r['group_concat'].append({'var': vm.group(1), 'content': gc})
        for m in re.finditer(r'\?(\w+)', ss):
            v = m.group(1)
            if v not in [gc['var'] for gc in r['group_concat']]:
                r['select_vars'].append('?' + v)
    wm = re.search(r'WHERE\s*\{(.+)\}', qt, re.I|re.S)
    if wm:
        wb = wm.group(1)
        for om in re.finditer(r'OPTIONAL\s*\{(.+?)\}', wb, re.I|re.S):
            r['optional_patterns'].extend(extract_patterns(om.group(1)))
        wbc = re.sub(r'OPTIONAL\s*\{.+?\}', '', wb, flags=re.I|re.S)
        r['where_patterns'].extend(extract_patterns(wbc))
    for fm in re.finditer(r'FILTER\s*\((.+?)\)', qt, re.I|re.S):
        r['filters'].append(fm.group(1).strip())
    gb = re.search(r'GROUP\s+BY\s+(.+?)(?:HAVING|ORDER|LIMIT|OFFSET|$)', qt, re.I)
    if gb:
        r['group_by'] = re.findall(r'\?(\w+)', gb.group(1).strip())
    return r

def extract_patterns(body):
    patterns = []
    for seg in re.split(r'\.', body):
        seg = seg.strip()
        if not seg:
            continue
        for part in re.split(r',', seg):
            part = part.strip()
            if not part:
                continue
            toks = tokenize_sparql(part)
            if len(toks) >= 3:
                patterns.append((toks[0], toks[1], ' '.join(toks[2:])))
    return patterns

def tokenize_sparql(s):
    tokens = []
    i = 0
    s = s.strip()
    while i < len(s):
        c = s[i]
        if c in ' \t\n\r':
            i += 1
            continue
        if c == '?':
            j = i + 1
            while j < len(s) and (s[j].isalnum() or s[j] == '_'):
                j += 1
            tokens.append(s[i:j])
            i = j
        elif c == '<':
            j = s.index('>', i)
            tokens.append(s[i:j+1])
            i = j + 1
        elif c == '"':
            j = i + 1
            while j < len(s):
                if s[j] == '\\':
                    j += 2
                    continue
                if s[j] == '"':
                    break
                j += 1
            tokens.append(s[i:j+1])
            i = j + 1
        elif c in '()':
            tokens.append(c)
            i += 1
        else:
            j = i
            while j < len(s) and s[j] not in ' \t\n\r<>"?^()':
                j += 1
            if j > i:
                tokens.append(s[i:j])
            i = j
    return tokens

def evaluate_query(triples, prefixes, query):
    fp = defaultdict(set)
    rp = defaultdict(set)
    by_subj = defaultdict(list)
    by_obj = defaultdict(list)
    for s, p, o, dt, lang in triples:
        fp[(s, p)].add(o)
        rp[(o, p)].add(s)
        by_subj[s].append((p, o))
        by_obj[o].append((s, p))
    
    bindings = [{}]
    for pat in query['where_patterns']:
        new_bindings = []
        for b in bindings:
            new_bindings.extend(match_pattern(pat, b, fp, rp, by_subj, by_obj))
        bindings = new_bindings
        if not bindings:
            break
    
    for opt_pats in query['optional_patterns']:
        opt_bindings = [{}]
        for pat in opt_pats:
            new_ob = []
            for b in opt_bindings:
                new_ob.extend(match_pattern(pat, b, fp, rp, by_subj, by_obj))
            opt_bindings = new_ob
            if not opt_bindings:
                break
        opt_vars = set()
        for s, p, o in opt_pats:
            if is_var(s): opt_vars.add(s)
            if is_var(p): opt_vars.add(p)
            if is_var(o): opt_vars.add(o)
        new_bindings = []
        for b in bindings:
            matched = False
            for ob in opt_bindings:
                if all(b.get(v) == ob.get(v) for v in opt_vars if v in b):
                    new_bindings.append({**b, **ob})
                    matched = True
                    break
            if not matched:
                new_bindings.append(b)
        bindings = new_bindings
    
    bindings = [b for b in bindings if all(eval_filter(f, b, query['prefixes']) for f in query['filters'])]
    
    if query['group_by']:
        groups = defaultdict(list)
        for b in bindings:
            key = tuple(b.get(v, '') for v in query['group_by'])
            groups[key].append(b)
        results = []
        for key, group in groups.items():
            row = {}
            for i, var in enumerate(query['group_by']):
                row[var] = group[0].get(var, '')
            for var in query['select_vars']:
                if var.startswith('?') and var not in query['group_by']:
                    vals = [b.get(var, '') for b in group]
                    row[var] = vals[0] if vals else ''
            for gc in query['group_concat']:
                gc_var = gc['var']
                vals = sorted(set(b.get(gc_var, '') for b in group if b.get(gc_var, '') != ''))
                row[gc_var] = ', '.join(vals)
            results.append(row)
        return results
    return bindings

def main():
    if len(sys.argv) < 3:
        print("Usage: python3 run_queries.py <turtle_file> <query_file> [mode]")
        sys.exit(1)
    turtle_file = sys.argv[1]
    query_file = sys.argv[2]
    mode = sys.argv[3] if len(sys.argv) > 3 else 'query'
    
    triples, prefixes = parse_turtle(turtle_file)
    print(f"Parsed {len(triples)} triples, {len(prefixes)} prefixes", file=sys.stderr)
    
    if mode == 'query':
        with open(query_file) as f:
            query_text = f.read()
        query = parse_sparql(query_text)
        print(f"Query: {len(query['where_patterns'])} WHERE, {len(query['optional_patterns'])} OPTIONAL, {len(query['filters'])} filters, gb={query['group_by']}, gc={query['group_concat']}", file=sys.stderr)
        results = evaluate_query(triples, prefixes, query)
        print(f"Got {len(results)} results", file=sys.stderr)
        if results:
            cols = list(results[0].keys())
            print('\t'.join(cols))
            for row in results:
                print('\t'.join(str(row.get(c, '')) for c in cols))
        else:
            print("(no results)")
    elif mode == 'enrollment':
        student_courses = defaultdict(set)
        student_grad = {}
        course_display = {}
        for s, p, o, dt, lang in triples:
            subj = expand(s, prefixes)
            pred = expand(p, prefixes)
            if pred == 'http://university.org/ontology/isEnrolledIn':
                student_courses[subj].add(expand(o, prefixes))
            if pred == 'http://university.org/ontology/hasGraduationDate':
                student_grad[subj] = o
            if pred == 'http://university.org/ontology/hasName':
                course_display[subj] = o
        course_counts = defaultdict(int)
        for su, courses in student_courses.items():
            gd = student_grad.get(su)
            if gd is not None and gd <= '2025-08-16':
                continue
            for cu in courses:
                course_counts[cu] += 1
        print("Course\tCount")
        for cu in sorted(course_counts.keys()):
            print(f"{course_display.get(cu, cu)}\t{course_counts[cu]}")

if __name__ == '__main__':
    main()
