[10.496621, "o", "    \u001b[0m\u001b[94mwith\u001b[39;49;00m smtplib.SMTP(\u001b[33m\"\u001b[39;49;00m\u001b[33mlocalhost\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[94m25\u001b[39;49;00m) \u001b[94mas\u001b[39;49;00m server:\u001b[90m\u001b[39;49;00m\r\n         ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\u001b[90m\u001b[39;49;00m\r\n\u001b[1m\u001b[31m/usr/lib/python3.12/smtplib.py\u001b[0m:255: in __init__\r\n"]
[10.496715, "o", "    \u001b[0m(code, msg) = \u001b[96mself\u001b[39;49;00m.connect(host, port)\u001b[90m\u001b[39;49;00m\r\n                  ^^^^^^^^^^^^^^^^^^^^^^^^\u001b[90m\u001b[39;49;00m\r\n\u001b[1m\u001b[31m/usr/lib/python3.12/smtplib.py\u001b[0m:341: in connect\r\n    \u001b[0m\u001b[96mself\u001b[39;49;00m.sock = \u001b[96mself\u001b[39;49;00m._get_socket(host, port, \u001b[96mself\u001b[39;49;00m.timeout)\u001b[90m\u001b[39;49;00m\r\n                ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\u001b[90m\u001b[39;49;00m\r\n\u001b[1m\u001b[31m/usr/lib/python3.12/smtplib.py\u001b[0m:312: in _get_socket\r\n"]
