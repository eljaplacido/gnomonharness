[10.496837, "o", "    \u001b[0m\u001b[94mraise\u001b[39;49;00m exceptions[\u001b[94m0\u001b[39;49;00m]\u001b[90m\u001b[39;49;00m\r\n_ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ \r\n\r\naddress = ('localhost', 25), timeout = <object object at 0xff3c28da1200>, source_address = None\r\n\r\n"]
[10.497309, "o", "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mcreate_connection\u001b[39;49;00m(address, timeout=_GLOBAL_DEFAULT_TIMEOUT,\u001b[90m\u001b[39;49;00m\r\n                          source_address=\u001b[94mNone\u001b[39;49;00m, *, all_errors=\u001b[94mFalse\u001b[39;49;00m):\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"Connect to *address* and return the socket object.\u001b[39;49;00m\r\n    \u001b[33m\u001b[39;49;00m\r\n    \u001b[33m    Convenience function.  Connect to *address* (a 2-tuple ``(host,\u001b[39;49;00m\r\n    \u001b[33m    port)``) and return the socket object.  Passing the optional\u001b[39;49;00m\r\n    \u001b[33m    *timeout* parameter will set the timeout on the socket instance\u001b[39;49;00m\r\n    \u001b[33m    before attempting to connect.  If no *timeout* is supplied, the\u001b[39;49;00m\r\n    \u001b[33m    global default timeout setting returned by :func:`getdefaulttimeout`\u001b[39;49;00m\r\n    \u001b[33m    is used.  If *source_address* is set it must be a tuple of (host, port)\u001b[39;49;00m\r\n    \u001b[33m    for the socket to bind as a source address before making the connection.\u001b[39;49;00m\r\n    \u001b[33m    A host of '' or port 0 tells the OS to use the default. When a connection\u001b[39;49;00m\r\n    \u001b[33m    cannot be created, raises the last error if *all_errors* is False,\u001b[39;49;00m\r\n    \u001b[33m    and an ExceptionGroup of all errors if *all_errors* is True.\u001b[39;49;00m\r\n    \u001b[33m    \"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        host, port = address\u001b[90m\u001b[39;49;00m\r\n        exceptions = []\u001b[90m\u001b[39;49;00m\r\n        \u001b[94mfor\u001b[39;49;00m res \u001b[95min\u001b[39;49;00m getaddrinfo(host, port, \u001b[94m0\u001b[39;49;00m, SOCK_STREAM):\u001b[90m\u001b[39;49;00m\r\n            af, socktype, proto, canonname, sa = res\u001b[90m\u001b[39;49;00m\r\n            sock = \u001b[94mNone\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n"]
[10.497355, "o", "            \u001b[94mtry\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\r\n                sock = socket(af, socktype, proto)\u001b[90m\u001b[39;49;00m\r\n                \u001b[94mif\u001b[39;49;00m timeout \u001b[95mis\u001b[39;49;00m \u001b[95mnot\u001b[39;49;00m _GLOBAL_DEFAULT_TIMEOUT:\u001b[90m\u001b[39;49;00m\r\n                    sock.settimeout(timeout)\u001b[90m\u001b[39;49;00m\r\n                \u001b[94mif\u001b[39;49;00m source_address:\u001b[90m\u001b[39;49;00m\r\n                    sock.bind(source_address)\u001b[90m\u001b[39;49;00m\r\n>               sock.connect(sa)\u001b[90m\u001b[39;49;00m\r\n\u001b[1m\u001b[31mE               ConnectionRefusedError: [Errno 111] Connection refused\u001b[0m\r\n\r\n\u001b[1m\u001b[31m/usr/lib/python3.12/socket.py\u001b[0m:837: ConnectionRefusedError\r\n--------------------------------------------------------------------- Captured stdout call ---------------------------------------------------------------------\r\nbobgreen added successfully.\r\n"]
[10.49739, "o", "\u001b[31m\u001b[1m______________________________________________________________________ test_mlist_exists _______________________________________________________________________\u001b[0m\r\n\r\n"]
[10.497622, "o", "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mtest_mlist_exists\u001b[39;49;00m():\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"Test that the mailman mailing list exists.\"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        mlist = get_mlist()\u001b[90m\u001b[39;49;00m\r\n>       \u001b[94massert\u001b[39;49;00m mlist, \u001b[33m\"\u001b[39;49;00m\u001b[33mMailing list does not exist\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n\u001b[1m\u001b[31mE       AssertionError: Mailing list does not exist\u001b[0m\r\n\u001b[1m\u001b[31mE       assert None\u001b[0m\r\n\r\n\u001b[1m\u001b[31m/tests/test_outputs.py\u001b[0m:167: AssertionError\r\n\u001b[31m\u001b[1m________________________________________________________________ test_join_announce_leave_flow _________________________________________________________________\u001b[0m\r\n\r\n"]
[10.498267, "o", "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mtest_join_announce_leave_flow\u001b[39;49;00m():\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"Full flow of user joining, announcing, and leaving the mailing list.\"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n"]
[10.498354, "o", "        subject = \u001b[33m\"\u001b[39;49;00m\u001b[33mSecret Announcement\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        user = \u001b[33m\"\u001b[39;49;00m\u001b[33malicegray\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        add_user(user)\u001b[90m\u001b[39;49;00m\r\n        mbox_path = \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m/var/mail/\u001b[39;49;00m\u001b[33m{\u001b[39;49;00muser\u001b[33m}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92m_assert_mailbox_exists\u001b[39;49;00m():\u001b[90m\u001b[39;49;00m\r\n            \u001b[94massert\u001b[39;49;00m os.path.exists(mbox_path), \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mMailbox not found: \u001b[39;49;00m\u001b[33m{\u001b[39;49;00mmbox_path\u001b[33m}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92m_assert_not_member\u001b[39;49;00m():\u001b[90m\u001b[39;49;00m\r\n            mlist = get_mlist()\u001b[90m\u001b[39;49;00m\r\n            user_member = mlist.members.get_member(\u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m{\u001b[39;49;00muser\u001b[33m}\u001b[39;49;00m\u001b[33m@\u001b[39;49;00m\u001b[33m{\u001b[39;49;00mDOMAIN_NAME\u001b[33m}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n            \u001b[94massert\u001b[39;49;00m user_member \u001b[95mis\u001b[39;49;00m \u001b[94mNone\u001b[39;49;00m, \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m{\u001b[39;49;00muser\u001b[33m}\u001b[39;49;00m\u001b[33m is a member: \u001b[39;49;00m\u001b[33m{\u001b[39;49;00muser_member\u001b[33m=}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92m_assert_member\u001b[39;49;00m():\u001b[90m\u001b[39;49;00m\r\n            mlist = get_mlist()\u001b[90m\u001b[39;49;00m\r\n            user_member = mlist.members.get_member(\u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m{\u001b[39;49;00muser\u001b[33m}\u001b[39;49;00m\u001b[33m@\u001b[39;49;00m\u001b[33m{\u001b[39;49;00mDOMAIN_NAME\u001b[33m}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n            \u001b[94massert\u001b[39;49;00m user_member, \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m{\u001b[39;49;00muser\u001b[33m}\u001b[39;49;00m\u001b[33m is not a member: \u001b[39;49;00m\u001b[33m{\u001b[39;49;00muser_member\u001b[33m=}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92m_assert_announcement\u001b[39;49;00m():\u001b[90m\u001b[39;49;00m\r\n            mbox = mailbox.mbox(mbox_path)\u001b[90m\u001b[39;49;00m\r\n            announce_msgs = [msg \u001b[94mfor\u001b[39;49;00m msg \u001b[95min\u001b[39;49;00m mbox \u001b[94mif\u001b[39;49;00m subject \u001b[95min\u001b[39;49;00m msg.get(\u001b[33m\"\u001b[39;49;00m\u001b[33mSubject\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)]\u001b[90m\u001b[39;49;00m\r\n            \u001b[94massert\u001b[39;49;00m \u001b[96mlen\u001b[39;49;00m(announce_msgs) == \u001b[94m1\u001b[39;49;00m, (\u001b[90m\u001b[39;49;00m\r\n                \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mExpected 1 announcement, found \u001b[39;49;00m\u001b[33m{\u001b[39;49;00m\u001b[96mlen\u001b[39;49;00m(announce_msgs)\u001b[33m}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n            )\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\