[23.621878, "o", "   - Group \"research\": full rwx permissions (both current and default)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[23.621948, "o", "   - Users \"alice\" and \"bob\": full rwx permissions (both current and default)  \r\n\u001b[?2004l\r\u001b[?2004h> "]
