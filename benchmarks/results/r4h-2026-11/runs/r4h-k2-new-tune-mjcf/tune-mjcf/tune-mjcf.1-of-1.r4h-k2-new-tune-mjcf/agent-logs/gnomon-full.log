import re, time, numpy as np, mujoco

REF = "/app/model_ref.xml"
TEXT = open(REF).read()
TOTAL, ATOL = 2.0, 1e-5
FULL = mujoco.mjtState.mjSTATE_FULLPHYSICS

def make(opt_attrs="", flags=()):
    t = TEXT
    if flags:
        inner = " ".join('%s="disable"' % f for f in flags)
        el = "<option %s><flag %s/></option>" % (opt_attrs, inner)
        t = re.sub(r'(<compiler[^>]*/>)', lambda mo: mo.group(1) + "\n  " + el, t, count=1)
    elif opt_attrs:
        t = re.sub(r'(<compiler[^>]*/>)', lambda mo: mo.group(1) + "\n  <option %s/>" % opt_attrs, t, count=1)
    p = "/tmp/_d.xml"
    open(p, "w").write(t)
    return mujoco.MjModel.from_xml_path(p)

def simulate(m, seed, jitter=None, track=False):
    d = mujoco.MjData(m)
    nstep = int(TOTAL / m.opt.timestep)
    rng = np.random.default_rng(seed)
    d.qpos[:] += rng.normal(0, 0.01, size=d.qpos.shape)
    if jitter is not None:
        d.qpos[:] += rng.normal(0, jitter, size=d.qpos.shape)
    mujoco.mj_forward(m, d)
    ncmax = 0; ntr = 0.0
    for _ in range(nstep):
        mujoco.mj_step(m, d)
        if track:
            ncmax = max(ncmax, int(d.ncon))
    s = np.zeros(mujoco.mj_stateSize(m, FULL))
    mujoco.mj_getState(m, d, s, FULL)
    return (s, ncmax) if track else s

def timeit(m, n=12):
    ts = []
    for _ in range(n):
        seed = int(np.random.randint(0, 10000))
        t0 = time.perf_counter(); simulate(m, seed); t1 = time.perf_counter()
        ts.append(t1 - t0)
    return float(np.mean(ts))

seeds = [int(x) for x in np.random.default_rng(11).integers(0, 10000, 15)]
mref = make()
ref = {sd: simulate(mref, sd, track=True) for sd in seeds}
t_ref = timeit(mref)
print("ref time %.5f s   (nq %d nv %d)" % (t_ref, mref.nq, mref.nv))
print("per-seed ref: ncon_max, |qpos|max, |qvel|max, |qacc_warmstart|max at end:")
for sd in seeds:
    s = ref[sd][0]
    print("  seed %5d nconmax %2d  qposmax %.3f qvelmax %.3f  statemax %.3f" %
          (sd, ref[sd][1], np.abs(s[1:1+mref.nq]).max(), np.abs(s[1+mref.nq:]).max(), np.abs(s).max()))

print("\n--- amplification: ref vs ref with extra tiny qpos jitter ---")
for jit in (1e-6, 1e-9, 1e-12, 1e-15):
    ds = []
    for sd in seeds:
        a = simulate(mref, sd, jitter=jit)
        b = ref[sd][0]
        ds.append(np.abs(a - b).max() if a.shape == b.shape else np.nan)
    ds = np.array(ds)
    print("  jitter %8.0e -> maxdiff median %.3e  worst %.3e" % (jit, np.median(ds), ds.max()))

print("\n--- timestep sensitivity (Newton) ---")
for dt in (0.0019, 0.0021, 0.0025, 0.004):
    m = make("timestep='%s'" % dt)
    ds = np.array([np.abs(simulate(m, sd) - ref[sd][0]).max() for sd in seeds])
    print("  dt %-6s -> median %.3e worst %.3e   time %.5f (pctg %.3f)" % (dt, np.median(ds), ds.max(), timeit(m), timeit(m)/t_ref))

print("\n--- integrator variants ---")
for name, attrs in (("implicitfast", "integrator='implicitfast'"), ("implicit", "integrator='implicit'"), ("rk4", "integrator='RK4'")):
    m = make(attrs)
    ds = np.array([np.abs(simulate(m, sd) - ref[sd][0]).max() for sd in seeds])
    t = timeit(m)
    print("  %-12s -> median %.3e worst %.3e  time %.5f pctg %.3f" % (name, np.median(ds), ds.max(), t, t/t_ref))

print("\n--- solver variants, per seed ---")
solvers = [
    ("pgs_def",   "solver='PGS'"),
    ("pgs_t1e-10_it500", "solver='PGS' tolerance='1e-10' iterations='500'"),
    ("pgs_t1e-12_it2000", "solver='PGS' tolerance='1e-12' iterations='2000'"),
    ("cg_def",    "solver='CG'"),
    ("cg_t1e-12_it2000", "solver='CG' tolerance='1e-12' iterations='2000'"),
    ("newton_it1", "solver='Newton' iterations='1' ls_iterations='1'"),
]
for name, attrs in solvers:
    try:
        m = make(attrs)
        t = timeit(m)
        ds = [np.abs(simulate(m, sd) - ref[sd][0]).max() for sd in seeds]
        ds = np.array(ds)
        print("  %-20s time %.5f pctg %.3f  diff median %.3e worst %.3e  nbad %d" %
              (name, t, t/t_ref, np.median(ds), ds.max(), int((ds > ATOL).sum())))
        print("      per-seed: " + " ".join("%.1e" % x for x in ds))
    except Exception as e:
        print("  %-20s FAILED %r" % (name, e))

print("\n--- disableflag combos (Newton), maxdiff vs ref ---")
combos = [
    ("contact", ("contact",)),
    ("actuation", ("actuation",)),
    ("sensor+energy", ("sensor", "energy")),
    ("tendon+limit", ("tendon", "limit")),
    ("midphase+nativeccd+multiccd", ("midphase", "nativeccd", "multiccd")),
    ("warmstart", ("warmstart",)),
    ("filterparent", ("filterparent",)),
    ("invdiscrete+eulerdamp", ("invdiscrete", "eulerdamp")),
    ("clampctrl+autoreset", ("clampctrl", "autoreset")),
    ("all_safe", ("contact", "actuation", "sensor", "energy", "tendon", "limit", "midphase", "nativeccd", "multiccd", "invdiscrete")),
]
for name, flags in combos:
    try:
        m = make("", flags)
        ds = np.array([np.abs(simulate(m, sd) - ref[sd][0]).max() for sd in seeds])
        t = timeit(m)
        print("  %-32s time %.5f pctg %.3f  diff median %.3e worst %.3e" % (name, t, t/t_ref, np.median(ds), ds.max()))
    except Exception as e:
        print("  %-32s FAILED %r" % (name, e))

print("\n--- MjData creation + arena size effect ---")
for mem in ("2M", "100K", "10K"):
    t = TEXT.replace('memory="2M"', 'memory="%s"' % mem)
    open("/tmp/_m.xml", "w").write(t)
    try:
        m = mujoco.MjModel.from_xml_path("/tmp/_m.xml")
        t0 = time.perf_counter()
        for _ in range(20):
            d = mujoco.MjData(m)
        t1 = time.perf_counter()
        ds = np.array([np.abs(simulate(m, sd) - ref[sd][0]).max() for sd in seeds])
        print("  memory %-5s MjData creation %7.1f us  diff worst %.3e  time %.5f pctg %.3f" %
              (mem, (t1-t0)/20*1e6, ds.max(), timeit(m) - 0, timeit(m)/t_ref))
    except Exception as e:
        print("  memory %-5s FAILED %r" % (mem, e))

print("\n--- step phase costs at solver PGS vs Newton ---")
def prof(m, n=400):
    d = mujoco.MjData(m); rng = np.random.default_rng(0)
    d.qpos[:] += rng.normal(0, 0.01, size=d.qpos.shape); mujoco.mj_forward(m, d)
    out = {}
    for nm, fn in (("step1", mujoco.mj_step1), ("step2", mujoco.mj_step2), ("fwdPosition", mujoco.mj_fwdPosition), ("fwdConstraint", mujoco.mj_fwdConstraint)):
        fn(m, d)
        t0 = time.perf_counter()
        for _ in range(n):
            fn(m, d)
        out[nm] = (time.perf_counter()-t0)/n*1e6
    return out
for nm, attrs in (("newton", "solver='Newton'"), ("pgs", "solver='PGS'"), ("cg", "solver='CG'")):
    print("  %-6s " % nm + "  ".join("%s %.1fus" % (k, v) for k, v in prof(make(attrs)).items()))
