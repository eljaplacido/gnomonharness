import re, time, numpy as np, mujoco

REF = "/app/model_ref.xml"
TEXT = open(REF).read()
TOTAL, ATOL = 2.0, 1e-5
FULL = mujoco.mjtState.mjSTATE_FULLPHYSICS
print("mujoco version:", mujoco.__version__)

def make(opt_attrs="", flags=()):
    t = TEXT
    if opt_attrs or flags:
        inner = "".join('<flag %s="disable"/>' % f for f in flags)
        el = "<option %s>%s</option>" % (opt_attrs, inner)
        t = re.sub(r'(<compiler[^>]*/>)', lambda mo: mo.group(1) + "\n  " + el, t, count=1)
    p = "/tmp/_v.xml"
    with open(p, "w") as f:
        f.write(t)
    return mujoco.MjModel.from_xml_path(p)

def simulate(m, seed, track=False):
    d = mujoco.MjData(m)
    nstep = int(TOTAL / m.opt.timestep)
    rng = np.random.default_rng(seed)
    d.qpos[:] += rng.normal(0, 0.01, size=d.qpos.shape)
    mujoco.mj_forward(m, d)
    nc = 0; ni = 0; nimax = 0
    for _ in range(nstep):
        mujoco.mj_step(m, d)
        if track:
            nc += d.ncon
            try:
                v = int(np.max(np.asarray(d.solver_niter)))
            except Exception:
                v = 0
            ni += v; nimax = max(nimax, v)
    s = np.zeros(mujoco.mj_stateSize(m, FULL))
    mujoco.mj_getState(m, d, s, FULL)
    if track:
        return s, nc / nstep, ni / nstep, nimax
    return s

def timeit(m, n=15):
    ts = []
    for _ in range(n):
        seed = int(np.random.randint(0, 10000))
        t0 = time.perf_counter(); simulate(m, seed); t1 = time.perf_counter()
        ts.append(t1 - t0)
    return float(np.mean(ts))

def profile(m, n=300, seed=0):
    d = mujoco.MjData(m)
    rng = np.random.default_rng(seed)
    d.qpos[:] += rng.normal(0, 0.01, size=d.qpos.shape)
    mujoco.mj_forward(m, d)
    fns = [("fwdPosition", mujoco.mj_fwdPosition), ("fwdVelocity", mujoco.mj_fwdVelocity),
           ("fwdActuation", mujoco.mj_fwdActuation), ("fwdAcceleration", mujoco.mj_fwdAcceleration),
           ("fwdConstraint", mujoco.mj_fwdConstraint), ("forward", mujoco.mj_forward),
           ("step", mujoco.mj_step)]
    out = []
    for name, fn in fns:
        fn(m, d)
        t0 = time.perf_counter()
        for _ in range(n):
            fn(m, d)
        out.append((name, (time.perf_counter() - t0) / n * 1e6))
    return out

mref = make()
print("nq", mref.nq, "nv", mref.nv, "nbody", mref.nbody, "ngeom", mref.ngeom,
      "njnt", mref.njnt, "nu", mref.nu, "neq", mref.neq, "nq_plugin",
      mujoco.mj_stateSize(mref, mujoco.mjtState.mjSTATE_PLUGIN),
      "nstate_full", mujoco.mj_stateSize(mref, FULL))
o = mref.opt
print("opt: timestep", o.timestep, "integrator", o.integrator, "solver", o.solver,
      "iterations", o.iterations, "ls_iterations", o.ls_iterations,
      "tolerance", o.tolerance, "ls_tolerance", o.ls_tolerance,
      "cone", o.cone, "jacobian", o.jacobian, "impratio", o.impratio,
      "disableflags", o.disableflags, "enableflags", o.enableflags,
      "noslip", o.noslip_iterations)
print("sizes: narena/opt", mref.narena if hasattr(mref, "narena") else "?", "nbody max", mref.nbody)

print("--- phase profile (us/call, ref) ---")
for name, us in profile(mref):
    print("  %-16s %8.1f us" % (name, us))

print("--- ref run stats ---")
s_ref_seed = 12345
sref, nc, ni, nimax = simulate(mref, s_ref_seed, track=True)
print("  avg contacts/step %.4f  avg solver_niter %.3f  max niter %d" % (nc, ni, nimax))
seeds = [int(x) for x in np.random.default_rng(7).integers(0, 10000, 40)]
ref_states = {sd: simulate(mref, sd) for sd in seeds}

t_ref = timeit(mref)
print("  ref mean time per 2s sim: %.5f s" % t_ref)

variants = [
    ("base", "", ()),
    ("contact_off", "", ("contact",)),
    ("actuation_off", "", ("actuation",)),
    ("cont+act_off", "", ("contact", "actuation")),
    ("cont+act+sensor_off", "", ("contact", "actuation", "sensor")),
    ("iters5", "iterations='5'", ()),
    ("iters2", "iterations='2'", ()),
    ("tol1e-8", "tolerance='1e-8'", ()),
    ("tol1e-6", "tolerance='1e-6'", ()),
    ("lsit2_lstol1e-6", "ls_iterations='2' ls_tolerance='1e-6'", ()),
    ("jacobian_sparse", "jacobian='sparse'", ()),
    ("solver_cg", "solver='CG'", ()),
    ("solver_pgs", "solver='PGS'", ()),
    ("cont_off+iters5", "iterations='5'", ("contact",)),
]

print("--- variants ---")
print("%-22s %10s %8s %10s %12s %10s %8s" % ("variant", "mean_s", "pctg", "avg_ncon", "maxabsdiff", "norm", "finite"))
for name, attrs, flags in variants:
    try:
        m = make(attrs, flags)
        t = timeit(m)
        s, nc, ni, nimax = simulate(m, s_ref_seed, track=True)
        ok = bool(np.all(np.isfinite(s)))
        if s.shape == sref.shape:
            dd = float(np.max(np.abs(s - sref)))
            nrm = float(np.linalg.norm(s - sref))
        else:
            dd, nrm = float("nan"), float("nan")
        print("%-22s %10.5f %8.3f %10.4f %12.3e %10.3e %8s  niter=%.1f" %
              (name, t, t / t_ref, nc, dd, nrm, ok, ni))
    except Exception as e:
        print("%-22s FAILED: %r" % (name, e))
