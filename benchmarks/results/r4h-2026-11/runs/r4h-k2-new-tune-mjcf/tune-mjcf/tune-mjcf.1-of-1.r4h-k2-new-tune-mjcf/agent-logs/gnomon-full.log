    open("/tmp/_d.xml", "w").write(t)
    return mujoco.MjModel.from_xml_path("/tmp/_d.xml")

def sim(m, seed, jitter=None):
    d = mujoco.MjData(m)
    n = int(TOTAL / m.opt.timestep)
    rng = np.random.default_rng(seed)
    d.qpos[:] += rng.normal(0, 0.01, size=d.qpos.shape)
    if jitter:
        d.qpos[:] += rng.normal(0, jitter, size=d.qpos.shape)
    mujoco.mj_forward(m, d)
    for _ in range(n):
        mujoco.mj_step(m, d)
    s = np.zeros(mujoco.mj_stateSize(m, FULL))
    mujoco.mj_getState(m, d, s, FULL)
    return s

def tm(m, n=12):
    t = []
    for _ in range(n):
        a = time.perf_counter(); sim(m, int(np.random.randint(0, 10000))); t.append(time.perf_counter() - a)
    return float(np.mean(t))

seeds = [int(x) for x in np.random.default_rng(11).integers(0, 10000, 12)]
mref = make()
ref = {s: sim(mref, s) for s in seeds}
tref = tm(mref)
print("mujoco", mujoco.__version__, "tref %.5f" % tref, "nq", mref.nq, "nv", mref.nv)
print("A) amplification: ref with extra qpos jitter vs ref")
for j in (1e-6, 1e-9, 1e-12):
    d = [np.abs(sim(mref, s, j) - ref[s]).max() for s in seeds]
    print("   jitter %.0e  median %.3e worst %.3e" % (j, np.median(d), max(d)))
print("B) timestep")
for dt in (0.0019, 0.0021, 0.0025):
    m = make("timestep='%s'" % dt)
    d = [np.abs(sim(m, s) - ref[s]).max() for s in seeds]
    t = tm(m)
    print("   dt %-6s median %.3e worst %.3e time %.5f pctg %.3f" % (dt, np.median(d), max(d), t, t / tref))
print("C) integrator")
for nm, a in (("implicitfast", "integrator='implicitfast'"), ("implicit", "integrator='implicit'")):
    m = make(a); d = [np.abs(sim(m, s) - ref[s]).max() for s in seeds]; t = tm(m)
    print("   %-13s median %.3e worst %.3e time %.5f pctg %.3f" % (nm, np.median(d), max(d), t, t / tref))
print("D) solvers, per-seed maxabs diff")
for nm, a in (("pgs_default", "solver='PGS'"),
              ("pgs_tol1e-10_it600", "solver='PGS' tolerance='1e-10' iterations='600'"),
              ("pgs_tol1e-12_it3000", "solver='PGS' tolerance='1e-12' iterations='3000'"),
              ("cg_default", "solver='CG'"),
              ("cg_tol1e-12_it3000", "solver='CG' tolerance='1e-12' iterations='3000'"),
              ("newton_it1", "solver='Newton' iterations='1' ls_iterations='1'")):
    try:
        m = make(a); t = tm(m); d = np.array([np.abs(sim(m, s) - ref[s]).max() for s in seeds])
        print("   %-20s time %.5f pctg %.3f median %.3e worst %.3e nbad %d" % (nm, t, t / tref, np.median(d), d.max(), int((d > 1e-5).sum())))
        print("      " + " ".join("%.1e" % x for x in d))
    except Exception as e:
        print("   %-20s FAIL" % nm, repr(e))
