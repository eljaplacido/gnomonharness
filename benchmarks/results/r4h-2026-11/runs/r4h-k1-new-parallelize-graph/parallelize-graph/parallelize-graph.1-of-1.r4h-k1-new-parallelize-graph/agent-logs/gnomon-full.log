cat > /tmp/trace.py << 'PYEOF'
import sys

KMER_MAX = 25
k = 19

class Node:
    def __init__(self, name, kmer, left, right, succ, prev):
        self.name = name  # 19-char node name
        self.kmer = kmer  # 19-char kmer
        self.left = left
        self.right = right
        self.succ = succ  # list of node names
        self.prev = prev  # node name or None
        self.used = [False, False]  # used flags for edges

# Read input
nodes = {}  # name -> Node
node_order = []  # order of node creation
kmers = []  # list of (kmer, left, right)

with open('/app/test') as f:
    for line in f:
        parts = line.strip().split('\t')
        kmer = parts[0]
        ext = parts[1]
        left = ext[0]
        right = ext[1]
        kmers.append((kmer, left, right))

# Build nodes
for kmer, left, right in kmers:
    lK = left + kmer[:k-1]  # 19 chars
    rK = kmer[1:] + right   # 19 chars
    
    # Create lK node
    if lK not in nodes:
        nodes[lK] = {'kmer': kmer, 'left': left, 'right': right, 'succ': [], 'prev': kmer, 'from_kmer': kmer}
        node_order.append(lK)
    else:
        # Merge: add succ, keep prev if unambiguous
        if right != 'F':
            if rK not in nodes[lK]['succ']:
                nodes[lK]['succ'].append(rK)
        # prev is already set from first kmer
        # Update kmer/left/right from last kmer
        nodes[lK]['kmer'] = kmer
        nodes[lK]['left'] = left
        nodes[lK]['right'] = right
        nodes[lK]['from_kmer'] = kmer
    
    # Create rK node
    if rK not in nodes:
        nodes[rK] = {'kmer': kmer, 'left': left, 'right': right, 'succ': [kmer], 'prev': None, 'from_kmer': kmer}
        node_order.append(rK)
    else:
        # Merge: add succ, keep prev if unambiguous
        nodes[rK]['succ'].append(kmer)
        # prev is already set (None for right-extension nodes)
        # Update kmer/left/right from last kmer
        nodes[rK]['kmer'] = kmer
        nodes[rK]['left'] = left
        nodes[rK]['right'] = right
        nodes[rK]['from_kmer'] = kmer

# Print nodes
print(f"Total nodes: {len(nodes)}")
for name, n in list(nodes.items())[:10]:
    print(f"  {name}: kmer={n['kmer']}, l={n['left']}, r={n['right']}, succ={n['succ']}, prev={n['prev']}")

# Compute seeds
seeds = []
for kmer, left, right in kmers:
    lK = left + kmer[:k-1]
    if left == 'F' or right == 'F':
        if lK not in seeds:
            seeds.append(lK)

print(f"\nSeeds ({len(seeds)}):")
for s in seeds[:10]:
    n = nodes[s]
    print(f"  {s}: kmer={n['kmer']}, l={n['left']}, r={n['right']}, succ={n['succ']}")

# Traverse
def move_left(node_name):
    n = nodes[node_name]
    if n['left'] == 'F':
        return None
    return n['left'] + n['kmer'][:k-1]

def move_right(node_name):
    n = nodes[node_name]
    if n['right'] == 'F':
        return None
    return n['kmer'][1:] + n['right']

def move_free(node_name):
    n = nodes[node_name]
    return n['kmer']

# Check if a move leads to a valid node
def is_valid_node(name):
    return name in nodes

# Traverse forward
def traverse_forward(start):
    contig = start
    current = start
    while True:
        # Try 'R' move first
        next_node = move_right(current)
        if next_node and is_valid_node(next_node):
            contig += next_node[-1]  # append last char
            current = next_node
            continue
        
        # Try 'L' move
        next_node = move_left(current)
        if next_node and is_valid_node(next_node):
            contig += next_node[0]  # append first char
            current = next_node
            continue
        
        # Try 'F' move
        next_node = move_free(current)
        if next_node and is_valid_node(next_node):
            contig += next_node[-1]  # append last char
            current = next_node
            continue
        
        break
    
    return contig

# Traverse backward
def traverse_backward(start):
    contig = start
    current = start
    while True:
        # Try 'L' move first (backward)
        next_node = move_left(current)
        if next_node and is_valid_node(next_node):
            contig = next_node[0] + contig  # prepend first char
            current = next_node
            continue
        
        # Try 'R' move (backward)
        next_node = move_right(current)
        if next_node and is_valid_node(next_node):
            contig = next_node[-1] + contig  # prepend last char
            current = next_node
