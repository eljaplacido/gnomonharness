            used_edges.add((current, nxt))
            used_edges.add((nxt, current))
            current = nxt
            continue
        break

    contig = ''.join(backward[::-1]) + ''.join(forward[1:])
    contigs.append(contig)

print(f"Contigs: {len(contigs)}")
