        parts = line.strip().split('\t')
        kmer, ext = parts[0], parts[1]
        left, right = ext[0], ext[1]
        kmers.append((kmer, left, right))

for kmer, left, right in kmers:
    lK = left + kmer[:k-1]
    rK = kmer[1:] + right
    if lK not in nodes:
        nodes[lK] = {'kmer': kmer, 'left': left, 'right': right, 'succ': [], 'prev': kmer}
    else:
        if right != 'F' and rK not in nodes[lK]['succ']:
            nodes[lK]['succ'].append(rK)
        nodes[lK]['kmer'] = kmer
        nodes[lK]['left'] = left
        nodes[lK]['right'] = right
    if rK not in nodes:
