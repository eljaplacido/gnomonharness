            seeds.append(lK)

# Traversal moves
def move_R(name):
    n = nodes[name]
    if n['right'] == 'F': return None
    return n['kmer'][1:] + n['right']

def move_L(name):
    n = nodes[name]
    if n['left'] == 'F': return None
    return n['left'] + n['kmer'][:k-1]

def move_F(name):
    # Drop last char of kmer -> 18 chars, not a node -> terminates
    return None

# Build contigs
contigs = []
used_edges = set()

for seed in seeds:
    n = nodes[seed]
    edge_used = False
    for s in n['succ']:
        if (seed, s) in used_edges or (s, seed) in used_edges:
            edge_used = True
            break
    if edge_used:
        continue

    # Forward walk
    forward = [seed]
    current = seed
    while True:
        nxt = move_R(current)
        if nxt and nxt in nodes:
            forward.append(nxt)
            used_edges.add((current, nxt))
            used_edges.add((nxt, current))
