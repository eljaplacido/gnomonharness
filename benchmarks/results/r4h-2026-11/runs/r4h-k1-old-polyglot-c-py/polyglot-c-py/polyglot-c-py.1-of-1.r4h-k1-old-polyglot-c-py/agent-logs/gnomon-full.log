#include <stdio.h>
#include <stdlib.h>

#define BASE 1000000000u

typedef struct {
    size_t len;
    size_t cap;
    unsigned int *d;
} Big;

static Big big_alloc(size_t cap) {
    Big b;
    b.len = 1;
    b.cap = cap;
    b.d = (unsigned int *)calloc(cap, sizeof(unsigned int));
    if (b.d == NULL) {
        fprintf(stderr, "out of memory\n");
        exit(1);
    }
    return b;
}

static void big_set(Big *b, unsigned int v) {
    b->len = 1;
    b->d[0] = v;
}

static void big_add(Big *r, const Big *a, const Big *b) {
    size_t n = a->len > b->len ? a->len : b->len;
    unsigned int carry = 0;
    size_t i;

    if (n + 1 > r->cap) {
        fprintf(stderr, "capacity exceeded\n");
        exit(1);
    }

    for (i = 0; i < n; i++) {
        unsigned int av = i < a->len ? a->d[i] : 0;
        unsigned int bv = i < b->len ? b->d[i] : 0;
        unsigned long long s = (unsigned long long)av + (unsigned long long)bv + carry;
        r->d[i] = (unsigned int)(s % BASE);
        carry = (unsigned int)(s / BASE);
    }

    r->len = n;
    if (carry != 0) {
        r->d[r->len++] = carry;
    }
}

static void big_print(const Big *b) {
    size_t i;
    printf("%u", b->d[b->len - 1]);
    for (i = b->len - 1; i-- > 0; ) {
        printf("%09u", b->d[i]);
    }
    putchar('\n');
}

int main(int argc, char **argv) {
    long long n;
    char *end;
    size_t cap;
    Big a, b, c;
    long long i;

    if (argc != 2) {
        fprintf(stderr, "usage: %s N\n", argv[0]);
        return 1;
    }

    end = NULL;
    n = strtoll(argv[1], &end, 10);
    if (end == argv[1] || *end != '\0' || n < 0) {
        fprintf(stderr, "invalid N\n");
        return 1;
    }

    if (n == 0) {
        puts("0");
        return 0;
    }
    if (n == 1) {
        puts("1");
        return 0;
    }

    cap = (size_t)n / 20 + 20;
    a = big_alloc(cap);
    b = big_alloc(cap);
    c = big_alloc(cap);

    big_set(&a, 0);
    big_set(&b, 1);

    for (i = 2; i <= n; i++) {
        Big tmp;
        big_add(&c, &a, &b);
        tmp = a;
        a = b;
        b = c;
        c = tmp;
    }

    big_print(&b);

    free(a.d);
    free(b.d);
    free(c.d);
    return 0;
}

