# ---------------------------------------------------------------------------
# Local reading-group site configuration (appended).
#
# Everything below overrides the Debian defaults above.  Later definitions of
# a section win under lazr.config, so this keeps the file self-documenting
# while changing only the values this site needs.
# ---------------------------------------------------------------------------

[mailman]
# The site owner must be a deliverable local address, otherwise Mailman error
# messages bounce forever.
site_owner: root@local.edu
noreply_address: noreply
default_language: en
# Keep the default of core, not the Debian layout's "$var_dir/..." overrides
# (unchanged, listed here only for clarity).
layout: debian

[paths.debian]
var_dir: /var/lib/mailman3
queue_dir: $var_dir/queue
bin_dir: /usr/lib/mailman3/bin
list_data_dir: $var_dir/lists
log_dir: /var/log/mailman3
lock_dir: $var_dir/locks
data_dir: $var_dir/data
cache_dir: $var_dir/cache
etc_dir: /etc/mailman3
ext_dir: $var_dir/ext
messages_dir: $var_dir/messages
archive_dir: $var_dir/archives
template_dir: $var_dir/templates
pid_file: /run/mailman3/master.pid
lock_file: $lock_dir/master.lck

[database]
class: mailman.database.sqlite.SQLiteDatabase
url: sqlite:///$DATA_DIR/mailman.db

[mta]
# Postfix talks to Mailman over LMTP on 127.0.0.1:8024, and Mailman hands
# outgoing mail back to Postfix over SMTP on localhost:25.
incoming: mailman.mta.postfix.LMTP
outgoing: mailman.mta.deliver.deliver
smtp_host: localhost
smtp_port: 25
lmtp_host: 127.0.0.1
lmtp_port: 8024
configuration: python:mailman.config.postfix

[postfix]
postmap_command: /usr/sbin/postmap
transport_file_type: hash

[archiver.prototype]
enable: no

[archiver.mhonarc]
enable: no

[archiver.mail_archive]
enable: no

[antispam]
# No DNSBL lookups: this is a closed local test box.
enabled: no
EOF
