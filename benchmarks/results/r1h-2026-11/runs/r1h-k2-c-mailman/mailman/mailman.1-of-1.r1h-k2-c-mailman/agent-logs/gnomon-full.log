from mailman.core.initialize import initialize
initialize('/etc/mailman3/mailman.cfg')
from mailman.database.transaction import transaction
from mailman.interfaces.archiver import ArchivePolicy
from mailman.interfaces.listmanager import IListManager
from mailman.interfaces.mailinglist import SubscriptionPolicy, DMARCMitigateAction
from zope.component import getUtility

mlist = getUtility(IListManager).get('reading-group@local.edu')
assert mlist is not None

with transaction():
    # No moderator/owner approval anywhere: the only gate is the user's own
    # reply to the confirmation message.
    mlist.subscription_policy = SubscriptionPolicy.confirm
    mlist.unsubscription_policy = SubscriptionPolicy.confirm
    mlist.default_member_moderation = False
    mlist.admin_immed_notify = True
    mlist.advertised = True
    mlist.archive_policy = ArchivePolicy.public
    mlist.display_name = 'Reading Group'
    mlist.description = 'Announcements for the reading group'
    mlist.max_message_size = 0
    mlist.emergency = False
    # Members may post without being held for approval.
    mlist.dmarc_mitigate_action = DMARCMitigateAction.no_mitigation
    mlist.dmarc_mitigate_unconditionally = False
    # Mailing "list-join" / "list-leave" must be handled as commands, which
    # CommandRunner does; keep the auto-response so users get feedback.
    from mailman.interfaces.autorespond import ResponseAction
    mlist.autorespond_requests = ResponseAction.respond_and_continue

with transaction():
    pass

for attr in ('subscription_policy', 'unsubscription_policy',
             'default_member_moderation', 'archive_policy',
             'display_name', 'posting_address', 'request_address',
             'join_address', 'leave_address', 'confirm_address'):
    print(attr, '=', getattr(mlist, attr))
EOF
