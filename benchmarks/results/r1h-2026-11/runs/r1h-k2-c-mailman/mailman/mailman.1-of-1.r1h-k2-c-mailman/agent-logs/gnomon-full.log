from mailman.core.initialize import initialize

initialize('/etc/mailman3/mailman.cfg')

from mailman.database.transaction import transaction
from mailman.interfaces.listmanager import IListManager
from mailman.interfaces.member import MemberRole
from mailman.interfaces.usermanager import IUserManager
from zope.component import getUtility

mlist = getUtility(IListManager).get('reading-group@local.edu')
user_manager = getUtility(IUserManager)

with transaction():
    # The owner must be a real, deliverable mailbox.  reading-group-owner@
    # is itself an alias of this list, so pointing the owner there would loop
    # every owner notification straight back into the list.
    for member in list(mlist.owners.members):
        member.unsubscribe()
    address = (user_manager.get_address('root@local.edu')
               or user_manager.create_address('root@local.edu'))
    mlist.subscribe(address, MemberRole.owner)

print('owners:', [m.address.email for m in mlist.owners.members])
EOF
