"""End-to-end check of join -> post -> leave, including membership state."""
import mailbox
import smtplib
import subprocess
import time
from email.mime.text import MIMEText

from mailman.core.initialize import initialize
from mailman.interfaces.listmanager import IListManager
from zope.component import getUtility

USER = "evalflow1"
initialize("/etc/mailman3/mailman.cfg")
mlist = getUtility(IListManager).get("reading-group@local.edu")


def send(frm, to, subject="", body=""):
    msg = MIMEText(body)
    msg["Subject"] = subject
    msg["From"] = frm
    msg["To"] = to
    with smtplib.SMTP("localhost", 25) as s:
        s.send_message(msg)


def confirm(needle, tries=30):
    for _ in range(tries):
        for msg in mailbox.mbox(f"/var/mail/{USER}"):
            frm = msg.get("From") or ""
            if frm.startswith("reading-group-confirm") and needle in (msg.get("Subject") or ""):
                send(f"{USER}@local.edu", frm)
                return True
        time.sleep(2)
    return False


def has(subject, tries=30):
    for _ in range(tries):
        if any((m.get("Subject") or "") == subject
               for m in mailbox.mbox(f"/var/mail/{USER}")):
            return True
        time.sleep(2)
    return False


subprocess.run(["useradd", USER], check=True)
print("subscribed before join:", mlist.members.get_member(f"{USER}@local.edu"))

send(f"{USER}@local.edu", "reading-group-join@local.edu")
assert confirm("join"), "no join confirmation"
for _ in range(15):
    if mlist.members.get_member(f"{USER}@local.edu"):
        break
    time.sleep(2)
print("member after confirm :", bool(mlist.members.get_member(f"{USER}@local.edu")))

send("announcer@local.edu", "reading-group@local.edu",
     subject="Chapter 3", body="Read chapter 3.")
print("announcement received:", has("Chapter 3"))

send(f"{USER}@local.edu", "reading-group-leave@local.edu")
assert confirm("leave"), "no leave confirmation"
for _ in range(15):
    if not mlist.members.get_member(f"{USER}@local.edu"):
        break
    time.sleep(2)
print("member after leave   :", bool(mlist.members.get_member(f"{USER}@local.edu")))
EOF
