from mailman.interfaces.autorespond import ResponseAction
from mailman.interfaces.listmanager import IListManager
from mailman.interfaces.mailinglist import SubscriptionPolicy
from zope.component import getUtility

mlist = getUtility(IListManager).get('reading-group@local.edu')
assert mlist is not None, 'reading-group@local.edu does not exist'

with transaction():
    # No owner/moderator approval for joining.  A brand new address is still
    # unverified, so Mailman sends the confirmation message and only
    # subscribes once the user replies to it.
    mlist.subscription_policy = SubscriptionPolicy.open
    # Leaving always needs the user's own reply to the confirmation message.
    mlist.unsubscription_policy = SubscriptionPolicy.confirm
    # Announcements from members and non-members are accepted as-is.
    mlist.default_member_action = Action.accept
    mlist.default_nonmember_action = Action.accept
    mlist.default_member_moderation = False
    # Announcements keep the subject the sender used.
    mlist.subject_prefix = ''
    mlist.display_name = 'Reading Group'
    mlist.description = 'Announcements for the reading group'
    mlist.advertised = True
    mlist.archive_policy = ArchivePolicy.public
    mlist.autorespond_postings = ResponseAction.none
    mlist.autorespond_requests = ResponseAction.respond_and_continue
    # No owner notifications: the only owner is a real local mailbox.
    mlist.admin_immed_notify = False
    mlist.admin_notify_mchanges = False
    mlist.max_message_size = 0

print('subscription_policy  :', mlist.subscription_policy)
print('unsubscription_policy:', mlist.unsubscription_policy)
print('subject_prefix       :', repr(mlist.subject_prefix))
print('members              :', mlist.members.member_count)
EOF
