import sys
rows=[]
for line in open('test'):
    line=line.rstrip('\n\r')
    if not line: continue
    km,ext=line.split('\t')
    rows.append((km,ext[0],ext[1]))
K=len(rows[0][0])
key={km:(l,r) for km,l,r in rows}
# edges per the paper: succ exists iff r!='F' and km[1:]+r present
succ={}
pred={}
for km,l,r in rows:
    if r!='F':
        s=km[1:]+r
        if s in key: succ[km]=s
    if l!='F':
        p=l+km[:-1]
        if p in key: pred[km]=p
starts=[km for km,_,_ in rows if km not in pred]
contigs=[]
seen=set()
for s in starts:
    cur=s; mods=[s]
    while cur in succ and succ[cur] not in seen:
        cur=succ[cur]; mods.append(cur)
    seen.update(mods)
    contigs.append(mods[0]+''.join(m[-1] for m in mods[1:]))
for km,_,_ in rows:
    if km in seen: continue
    cur=km; mods=[km]
    while succ.get(cur) not in seen and cur in succ:
        cur=succ[cur]; mods.append(cur)
    seen.update(mods)
    contigs.append(('CYCLE',mods[0]+''.join(m[-1] for m in mods[1:])))
out=open('/tmp/ref.out','w')
for c in contigs:
    out.write((c[1] if isinstance(c,tuple) else c)+'\n')
out.close()
print("ref contigs:", len(contigs), "kmers covered:", len(seen), "n:", len(rows), "k:", K)
