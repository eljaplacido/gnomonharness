[approval] bash: cd /app && cat > /tmp/gen.py <<'PYEOF'
import random, sys
seed=int(sys.argv[1]); k=int(sys.argv[2]); n=int(sys.argv[3]); circ=int(sys.argv[4])
random.seed(seed)
L = n + k - 1
g = [random.choice('ACGT') for _ in range(L)]
kmers = [''.join(g[i:i+k]) for i in range(L-k+1)]
seen = set()
rows = []
if circ:
    # circular genome: each k-mer's neighbours wrap around
    M = len(kmers)
    for i, km in enumerate(kmers):
        if km in seen: continue
        seen.add(km)
        l = kmers[(i-1) % M][0]
        r = kmers[(i+1) % M][-1]
        rows.append((km, l, r))
else:
    for i, km in enumerate(kmers):
        if km in seen: continue
        seen.add(km)
        l = kmers[i-1][0] if i > 0 else 'F'
        r = kmers[i+1][-1] if i < len(kmers)-1 else 'F'
        rows.append((km, l, r))
random.shuffle(rows)
with open(sys.argv[5],'w') as f:
    for km,l,r in rows:
        f.write(f"{km}\t{l}{r}\n")
print(f"{sys.argv[5]}: k={k} kmers={len(rows)} circular={circ}")
