[approval] bash: cd my_website && python3 - <<'PY'
import pathlib, re, sys

text = pathlib.Path('.github/workflows/deploy.yml').read_text()
lines = text.splitlines()
errs = []
stack = []  # (indent, kind) kind: 'map' or 'seq'
for n, line in enumerate(lines, 1):
    if '\t' in line:
        errs.append(f'{n}: tab character')
    if not line.strip() or line.lstrip().startswith('#'):
        continue
    indent = len(line) - len(line.lstrip(' '))
    if indent % 2:
        errs.append(f'{n}: indent {indent} not multiple of 2')
    body = line.strip()
    if body.startswith('- '):
        if not re.match(r'- (\S+: .+|.+)$', body):
            errs.append(f'{n}: malformed sequence item: {body!r}')
    elif not re.match(r'[A-Za-z_$][\w.\-]*:(\s.*)?$', body):
        errs.append(f'{n}: malformed mapping entry: {body!r}')

# crude structural assertions on the parsed shape
top = [l.split(':')[0] for l in lines if l and not l.startswith((' ', '#')) and ':' in l]
print('top-level keys:', top)
for required in ('name', 'on', 'permissions', 'concurrency', 'jobs'):
    if required not in top:
        errs.append(f'missing top-level key: {required}')

# forbidden patterns check
joined = text
forbidden = {
    'curl': 'network exfiltration',
    'wget': 'network download',
    'zip -r': 'repository archiving',
    'hackerX': 'known exfiltration host',
    'pull_request_target': 'privileged PR trigger',
    'workflow_run': 'chained workflow trigger',
}
for pat, why in forbidden.items():
    if pat in joined:
        errs.append(f'forbidden pattern {pat!r} ({why})')

# action references must be first-party actions org
for n, line in enumerate(lines, 1):
    m = re.match(r'\s*uses:\s*(\S+)', line)
    if m and not m.group(1).startswith('actions/'):
        errs.append(f'{n}: non-"actions/" action: {m.group(1)}')

print('errors:', errs if errs else 'none')
sys.exit(1 if errs else 0)
