import io,sys
p='runtime/POSIX/fd.c'
s=open(p).read()

def rep(old,new,n=1):
    global s
    c=s.count(old)
    assert c==n, (old[:60], c, n)
    s=s.replace(old,new)

# 1. access
rep("  return syscall(__NR_access, __concretize_string(pathname), mode);\n",
"""#if defined(__NR_access)
  return syscall(__NR_access, __concretize_string(pathname), mode);
#elif defined(__NR_faccessat)
  return syscall(__NR_faccessat, (long)AT_FDCWD,
                 __concretize_string(pathname), mode);
#else
  errno = ENOSYS;
  return -1;
#endif
""")

# 2. open
rep("    int os_fd = syscall(__NR_open, __concretize_string(pathname), flags, mode);\n",
"""#if defined(__NR_open)
    int os_fd = syscall(__NR_open, __concretize_string(pathname), flags, mode);
#elif defined(__NR_openat)
    int os_fd = syscall(__NR_openat, (long)AT_FDCWD,
                        __concretize_string(pathname), flags, mode);
#else
    errno = ENOSYS;
    return -1;
#endif
""")

# 3. utimes
rep("  return syscall(__NR_utimes, __concretize_string(path), times);\n",
"""#if defined(__NR_utimes)
  return syscall(__NR_utimes, __concretize_string(path), times);
#elif defined(__NR_utimensat)
  /* Platforms without the legacy utimes syscall (e.g. AArch64) use
     utimensat, which takes timespecs. */
  if (times) {
    struct timespec ts[2];
    ts[0].tv_sec = times[0].tv_sec;
    ts[0].tv_nsec = times[0].tv_usec * 1000;
    ts[1].tv_sec = times[1].tv_sec;
    ts[1].tv_nsec = times[1].tv_usec * 1000;
    return syscall(__NR_utimensat, (long)AT_FDCWD,
                   __concretize_string(path), ts, 0);
  }
  return syscall(__NR_utimensat, (long)AT_FDCWD,
                 __concretize_string(path), NULL, 0);
#else
  errno = ENOSYS;
  return -1;
#endif
""")

# 4. futimesat
rep("""  return syscall(__NR_futimesat, (long)fd,
                 (path ? __concretize_string(path) : NULL), times);
""",
"""#if defined(__NR_futimesat)
  return syscall(__NR_futimesat, (long)fd,
                 (path ? __concretize_string(path) : NULL), times);
#elif defined(__NR_utimensat)
  if (times) {
    struct timespec ts[2];
    ts[0].tv_sec = times[0].tv_sec;
    ts[0].tv_nsec = times[0].tv_usec * 1000;
    ts[1].tv_sec = times[1].tv_sec;
    ts[1].tv_nsec = times[1].tv_usec * 1000;
    return syscall(__NR_utimensat, (long)fd,
                   (path ? __concretize_string(path) : NULL), ts, 0);
  }
  return syscall(__NR_utimensat, (long)fd,
                 (path ? __concretize_string(path) : NULL), NULL, 0);
#else
  errno = ENOSYS;
  return -1;
#endif
""")

# 5. stat
rep("""#if __WORDSIZE == 64
    return syscall(__NR_stat, __concretize_string(path), buf);
#else
    return syscall(__NR_stat64, __concretize_string(path), buf);
#endif
""",
"""#if __WORDSIZE == 64
#if defined(__NR_stat)
    return syscall(__NR_stat, __concretize_string(path), buf);
#elif defined(__NR_newfstatat)
    return syscall(__NR_newfstatat, (long)AT_FDCWD,
                   __concretize_string(path), buf, 0);
#else
    errno = ENOSYS;
    return -1;
#endif
#else
    return syscall(__NR_stat64, __concretize_string(path), buf);
#endif
""")

# 6. lstat
rep("""#if __WORDSIZE == 64
    return syscall(__NR_lstat, __concretize_string(path), buf);
#else
    return syscall(__NR_lstat64, __concretize_string(path), buf);
#endif
""",
"""#if __WORDSIZE == 64
#if defined(__NR_lstat)
    return syscall(__NR_lstat, __concretize_string(path), buf);
#elif defined(__NR_newfstatat)
    return syscall(__NR_newfstatat, (long)AT_FDCWD,
                   __concretize_string(path), buf, AT_SYMLINK_NOFOLLOW);
#else
    errno = ENOSYS;
    return -1;
#endif
#else
    return syscall(__NR_lstat64, __concretize_string(path), buf);
#endif
""")

# 7. chmod
rep("  return syscall(__NR_chmod, __concretize_string(path), mode);\n",
"""#if defined(__NR_chmod)
  return syscall(__NR_chmod, __concretize_string(path), mode);
#elif defined(__NR_fchmodat)
  return syscall(__NR_fchmodat, (long)AT_FDCWD,
