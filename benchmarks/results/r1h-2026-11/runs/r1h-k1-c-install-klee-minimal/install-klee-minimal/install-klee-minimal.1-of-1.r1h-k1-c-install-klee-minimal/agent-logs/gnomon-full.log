#else
  errno = ENOSYS;
  return -1;
#endif
""")

# 8. chown (two occurrences)
rep("  return syscall(__NR_chown, __concretize_string(path), owner, group);\n",
"""#if defined(__NR_chown)
  return syscall(__NR_chown, __concretize_string(path), owner, group);
#elif defined(__NR_fchownat)
  return syscall(__NR_fchownat, (long)AT_FDCWD,
                 __concretize_string(path), owner, group, 0);
#else
  errno = ENOSYS;
  return -1;
#endif
""", 2)

# 9. readlink
rep("  return syscall(__NR_readlink, path, buf, bufsize);\n",
"""#if defined(__NR_readlink)
  return syscall(__NR_readlink, path, buf, bufsize);
#elif defined(__NR_readlinkat)
  return syscall(__NR_readlinkat, (long)AT_FDCWD, path, buf, bufsize);
#else
  errno = ENOSYS;
  return -1;
#endif
""")

# 10. select
rep("""    int r = syscall(__NR_select, os_nfds, 
                    &os_read, &os_write, &os_except, &tv);
""",
"""#if defined(__NR_select)
    int r = syscall(__NR_select, os_nfds, 
                    &os_read, &os_write, &os_except, &tv);
#else
    /* This platform has no legacy select syscall (e.g. AArch64); ignore
       the OS side and only account for symbolic file descriptors. */
    int r = -1;
    (void) os_nfds; (void) tv;
#endif
""")

open(p,'w').write(s)
