for _ in range(nstep_ref):
    mujoco.mj_step(model_ref, data_ref)
full_physics = mujoco.mjtState.mjSTATE_FULLPHYSICS
state_ref = np.zeros(mujoco.mj_stateSize(model_ref, full_physics))
mujoco.mj_getState(model_ref, data_ref, state_ref, full_physics)

# Test various configurations with the SAME perturbation
configs = [
    {},  # default
    {'density': '0'},
    {'magnetic': '0 0 0'},
    {'apirate': '0'},
    {'viscosity': '0'},
    {'wind': '0 0 0'},
    {'o_margin': '0'},
    {'o_solref': '0.02 1'},
    {'o_solimp': '0.9 0.95 0.001 0.5 2'},
    {'tolerance': '1e-8'},
    {'ls_tolerance': '0.01'},
]

for cfg in configs:
    xml = open('model_ref.xml').read()
    opt_str = '<option'
    for k, v in cfg.items():
        opt_str += f' {k}=\"{v}\"'
    opt_str += '/>'
    xml = xml.replace('<compiler autolimits=\"true\"/>', f'<compiler autolimits=\"true\"/>{opt_str}')
    with open('/tmp/test_model.xml', 'w') as f:
        f.write(xml)
    
    try:
        model = mujoco.MjModel.from_xml_path('/tmp/test_model.xml')
        data = mujoco.MjData(model)
        data.qpos += perturbation
        mujoco.mj_forward(model, data)
        
        nstep = int(2.0 / model.opt.timestep)
        for _ in range(nstep):
            mujoco.mj_step(model, data)
        
        state = np.zeros(mujoco.mj_stateSize(model, full_physics))
        mujoco.mj_getState(model, data, state, full_physics)
        
        diff = np.linalg.norm(state - state_ref)
        print(f'cfg={cfg}: diff={diff:.8f}')
    except Exception as e:
        print(f'cfg={cfg}: ERROR: {e}')
