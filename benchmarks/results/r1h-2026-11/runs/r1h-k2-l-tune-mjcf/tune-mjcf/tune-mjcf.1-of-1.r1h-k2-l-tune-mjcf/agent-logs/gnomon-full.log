            xml = xml.replace('<compiler autolimits=\"true\"/>', f'<compiler autolimits=\"true\"/><option timestep=\"0.002\" solver=\"{solver}\" iterations=\"{iterations}\" ls_iterations=\"{ls_iterations}\"/>')
            with open('/tmp/test_model.xml', 'w') as f:
