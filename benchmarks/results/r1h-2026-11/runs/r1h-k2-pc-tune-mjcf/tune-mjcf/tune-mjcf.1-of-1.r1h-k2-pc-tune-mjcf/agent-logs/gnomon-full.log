# 2. Reduce ls_iterations (but line search converges quickly)
# 3. Use sparse jacobian (might be faster for this model)
# 4. Change tolerance (but doesn't affect accuracy)
#
# Let me benchmark different settings:

def bench(model, n_runs=10):
    times = []
    for _ in range(n_runs):
        seed = np.random.randint(0, 10000)
        rng = np.random.default_rng(seed)
        jiggle = rng.normal(0, 0.01, size=model.nq)
        t0 = time.perf_counter()
        data = mujoco.MjData(model)
        data.qpos += jiggle
        mujoco.mj_forward(model, data)
        nstep = int(2.0 / model.opt.timestep)
        for _ in range(nstep):
            mujoco.mj_step(model, data)
        t1 = time.perf_counter()
        times.append(t1 - t0)
    return np.mean(times)

ref_time = bench(model_ref, 10)
