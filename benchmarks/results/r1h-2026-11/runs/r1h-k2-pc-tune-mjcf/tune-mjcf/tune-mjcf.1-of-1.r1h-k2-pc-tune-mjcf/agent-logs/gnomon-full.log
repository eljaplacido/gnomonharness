import mujoco, numpy as np, tempfile, time

model_ref = mujoco.MjModel.from_xml_path('model_ref.xml')
ref_xml = open('model_ref.xml').read()

# Reference state for comparison
def get_state(model, seed):
    data = mujoco.MjData(model)
    nstep = int(2.0 / model.opt.timestep)
    rng = np.random.default_rng(seed)
    data.qpos += rng.normal(0, 0.01, size=data.qpos.shape)
    mujoco.mj_forward(model, data)
    for _ in range(nstep):
        mujoco.mj_step(model, data)
    full_physics = mujoco.mjtState.mjSTATE_FULLPHYSICS
    state = np.zeros(mujoco.mj_stateSize(model, full_physics))
    mujoco.mj_getState(model, data, state, full_physics)
    return state

# Precompute reference states
SEEDS = list(range(20))
ref_states = {s: get_state(model_ref, s) for s in SEEDS}

# Test implicit integrator with various timesteps
tests = [
    ('ts=0.004, implicit', 'timestep=\"0.004\" integrator=\"implicit\" iterations=\"100\" tolerance=\"1e-8\"'),
    ('ts=0.005, implicit', 'timestep=\"0.005\" integrator=\"implicit\" iterations=\"100\" tolerance=\"1e-8\"'),
    ('ts=0.01, implicit', 'timestep=\"0.01\" integrator=\"implicit\" iterations=\"100\" tolerance=\"1e-8\"'),
    ('ts=0.02, implicit', 'timestep=\"0.02\" integrator=\"implicit\" iterations=\"100\" tolerance=\"1e-8\"'),
    ('ts=0.04, implicit', 'timestep=\"0.04\" integrator=\"implicit\" iterations=\"100\" tolerance=\"1e-8\"'),
    ('ts=0.004, implicitfast', 'timestep=\"0.004\" integrator=\"implicitfast\" iterations=\"100\" tolerance=\"1e-8\"'),
    ('ts=0.005, implicitfast', 'timestep=\"0.005\" integrator=\"implicitfast\" iterations=\"100\" tolerance=\"1e-8\"'),
    ('ts=0.01, implicitfast', 'timestep=\"0.01\" integrator=\"implicitfast\" iterations=\"100\" tolerance=\"1e-8\"'),
    ('ts=0.02, implicitfast', 'timestep=\"0.02\" integrator=\"implicitfast\" iterations=\"100\" tolerance=\"1e-8\"'),
]

for desc, opt_str in tests:
    xml = ref_xml.replace('<compiler autolimits=\"true\"/>', f'<compiler autolimits=\"true\"/>\n  <option {opt_str}/>')
    with tempfile.NamedTemporaryFile(mode='w', suffix='.xml', delete=False) as f:
        f.write(xml)
        tmp_path = f.name
    
    try:
        model = mujoco.MjModel.from_xml_path(tmp_path)
    except Exception as e:
        print(f'SKIP {desc}: {e}')
        continue
    
    ts = model.opt.timestep
    nstep = int(2.0 / ts)
    remainder = 2.0 - nstep * ts
    if abs(remainder) > 1e-6:
        print(f'SKIP {desc}: remainder={remainder}')
        continue
    
    max_diff = 0.0
    has_nan = False
    for seed in SEEDS:
        state = get_state(model, seed)
        if np.isnan(state).any():
            has_nan = True
            break
        diff = np.abs(state - ref_states[seed])
        max_diff = max(max_diff, diff.max())
    
    # Benchmark
    times = []
    for _ in range(5):
        seed = np.random.randint(0, 10000)
        t0 = time.perf_counter()
        _ = get_state(model, seed)
        t1 = time.perf_counter()
        times.append(t1 - t0)
    model_time = np.mean(times)
    
    ref_times = []
    for _ in range(5):
        seed = np.random.randint(0, 10000)
        t0 = time.perf_counter()
        _ = get_state(model_ref, seed)
        t1 = time.perf_counter()
        ref_times.append(t1 - t0)
    ref_time = np.mean(ref_times)
    
    time_pctg = model_time / ref_time
    status = 'PASS' if (max_diff < 1e-5 and time_pctg <= 0.55) else 'FAIL'
    print(f'{status} {desc}: max_diff={max_diff:.2e}, nan={has_nan}, time_pctg={time_pctg:.4f}')
    
    import os
    os.unlink(tmp_path)
