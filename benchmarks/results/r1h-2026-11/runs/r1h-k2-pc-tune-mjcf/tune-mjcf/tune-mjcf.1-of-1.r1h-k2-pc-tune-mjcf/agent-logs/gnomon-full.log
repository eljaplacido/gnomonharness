import mujoco, numpy as np

# With the SAME jiggle, the results are identical!
# So the issue in my earlier sweep was that I was using different jiggles
# for the reference and test models.
#
# Now let me re-run the sweep with the correct approach: use the same
# jiggle for both models.

model_ref = mujoco.MjModel.from_xml_path('model_ref.xml')
ref_xml = open('model_ref.xml').read()

# Precompute reference states with fixed seeds
SEEDS = list(range(20))
ref_states = {}
for seed in SEEDS:
    rng = np.random.default_rng(seed)
    jiggle = rng.normal(0, 0.01, size=model_ref.nq)
    data = mujoco.MjData(model_ref)
    data.qpos += jiggle
    mujoco.mj_forward(model_ref, data)
    nstep = int(2.0 / model_ref.opt.timestep)
    for _ in range(nstep):
        mujoco.mj_step(model_ref, data)
    full_physics = mujoco.mjtState.mjSTATE_FULLPHYSICS
    state = np.zeros(mujoco.mj_stateSize(model_ref, full_physics))
    mujoco.mj_getState(model_ref, data, state, full_physics)
    ref_states[seed] = (state, jiggle)

# Test various timesteps
tests = [
    ('ts=0.004', 'timestep=\"0.004\"'),
    ('ts=0.005', 'timestep=\"0.005\"'),
    ('ts=0.01', 'timestep=\"0.01\"'),
    ('ts=0.02', 'timestep=\"0.02\"'),
    ('ts=0.004, implicit', 'timestep=\"0.004\" integrator=\"implicit\"'),
    ('ts=0.005, implicit', 'timestep=\"0.005\" integrator=\"implicit\"'),
    ('ts=0.01, implicit', 'timestep=\"0.01\" integrator=\"implicit\"'),
    ('ts=0.02, implicit', 'timestep=\"0.02\" integrator=\"implicit\"'),
    ('ts=0.04, implicit', 'timestep=\"0.04\" integrator=\"implicit\"'),
    ('ts=0.05, implicit', 'timestep=\"0.05\" integrator=\"implicit\"'),
    ('ts=0.02, implicitfast', 'timestep=\"0.02\" integrator=\"implicitfast\"'),
    ('ts=0.04, implicitfast', 'timestep=\"0.04\" integrator=\"implicitfast\"'),
    ('ts=0.05, implicitfast', 'timestep=\"0.05\" integrator=\"implicitfast\"'),
    ('ts=0.1, implicitfast', 'timestep=\"0.1\" integrator=\"implicitfast\"'),
]

import tempfile, time, os

for desc, opt_str in tests:
    xml = ref_xml.replace('<compiler autolimits=\"true\"/>', f'<compiler autolimits=\"true\"/>\n  <option {opt_str}/>')
    with tempfile.NamedTemporaryFile(mode='w', suffix='.xml', delete=False) as f:
        f.write(xml)
        tmp_path = f.name
    
    try:
        model = mujoco.MjModel.from_xml_path(tmp_path)
    except Exception as e:
        print(f'SKIP {desc}: {e}')
        continue
    
    ts = model.opt.timestep
    nstep = int(2.0 / ts)
    remainder = 2.0 - nstep * ts
    if abs(remainder) > 1e-6:
        print(f'SKIP {desc}: remainder={remainder}')
        os.unlink(tmp_path)
        continue
    
    max_diff = 0.0
    has_nan = False
    for seed in SEEDS:
        state_ref, jiggle = ref_states[seed]
        data = mujoco.MjData(model)
        data.qpos += jiggle
        mujoco.mj_forward(model, data)
        for _ in range(nstep):
            mujoco.mj_step(model, data)
        
        full_physics = mujoco.mjtState.mjSTATE_FULLPHYSICS
        state = np.zeros(mujoco.mj_stateSize(model, full_physics))
        mujoco.mj_getState(model, data, state, full_physics)
        
        if np.isnan(state).any():
            has_nan = True
            break
        diff = np.abs(state - state_ref).max()
        max_diff = max(max_diff, diff)
    
    # Benchmark
    times = []
    for _ in range(5):
        seed = np.random.randint(0, 10000)
        rng = np.random.default_rng(seed)
        jiggle = rng.normal(0, 0.01, size=model.nq)
        t0 = time.perf_counter()
        data = mujoco.MjData(model)
        data.qpos += jiggle
        mujoco.mj_forward(model, data)
        for _ in range(nstep):
            mujoco.mj_step(model, data)
        t1 = time.perf_counter()
        times.append(t1 - t0)
    model_time = np.mean(times)
    
    ref_times = []
    for _ in range(5):
        seed = np.random.randint(0, 10000)
        rng = np.random.default_rng(seed)
        jiggle = rng.normal(0, 0.01, size=model_ref.nq)
        t0 = time.perf_counter()
        data = mujoco.MjData(model_ref)
        data.qpos += jiggle
        mujoco.mj_forward(model_ref, data)
        for _ in range(1000):
            mujoco.mj_step(model_ref, data)
        t1 = time.perf_counter()
        ref_times.append(t1 - t0)
    ref_time = np.mean(ref_times)
    
    time_pctg = model_time / ref_time
    status = 'PASS' if (max_diff < 1e-5 and time_pctg <= 0.55) else 'FAIL'
    print(f'{status} {desc}: max_diff={max_diff:.2e}, nan={has_nan}, time_pctg={time_pctg:.4f}')
    
    os.unlink(tmp_path)
