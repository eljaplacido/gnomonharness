    ('sparse+iter1', 'jacobian="sparse" iterations="1"'),
    ('sparse+iter1+ls1', 'jacobian="sparse" iterations="1" ls_iterations="1"'),
    ('sparse+tol1e-6', 'jacobian="sparse" tolerance="1e-6"'),
    ('sparse+iter1+tol1e-6', 'jacobian="sparse" iterations="1" tolerance="1e-6"'),
    ('sparse+iter1+ls1+tol1e-6', 'jacobian="sparse" iterations="1" ls_iterations="1" tolerance="1e-6"'),
    ('sparse+iter1+ls1+tol1e-6+ccd', 'jacobian="sparse" iterations="1" ls_iterations="1" tolerance="1e-6" ccd_iterations="1"'),
]

