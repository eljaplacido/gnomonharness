import mailbox, os, subprocess, smtplib, time
from email.mime.text import MIMEText

DOMAIN = "local.edu"
LIST = "reading-group@local.edu"
JOIN = "reading-group-join@local.edu"
LEAVE = "reading-group-leave@local.edu"
CFG = "/etc/mailman3/mailman.cfg"

def p(*a): print(*a, flush=True)

def send(body, subject, frm, to):
    m = MIMEText(body); m["Subject"] = subject; m["From"] = frm; m["To"] = to
    with smtplib.SMTP("localhost", 25) as s: s.send_message(m)

def members():
    r = subprocess.run(["su", "-s", "/bin/sh", "list", "-c",
                        f"mailman -C {CFG} members {LIST}"],
                       capture_output=True, text=True)
    return [l.strip() for l in r.stdout.splitlines() if "@" in l]

def poll(fn, what, timeout=60):
    end = time.time() + timeout
    while time.time() < end:
        try:
            if fn(): p(f"  OK: {what}"); return
        except Exception:
            pass
        time.sleep(2)
    raise AssertionError(f"TIMEOUT: {what}")

def new_user():
    u = os.urandom(6).hex()
    subprocess.run(["useradd", u], check=True, capture_output=True)
    return u

def confirm(u, contains):
    mbox = mailbox.mbox(f"/var/mail/{u}")
    cands = [m for m in mbox
             if (m.get("From") or "").startswith("reading-group-confirm")
             and contains in (m.get("Subject") or "")]
    assert cands, f"no {contains} confirmation mail for {u}: {[m.get('Subject') for m in mbox]}"
