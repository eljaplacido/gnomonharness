#!/bin/sh
set -u
CFG=/etc/mailman3/mailman.cfg
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
say() { echo "=== $*"; }
aslist() { su -s /bin/sh list -c "cd /var/lib/mailman3 && $*"; }

say stop-services
postfix stop >/dev/null 2>&1 || true
aslist "mailman -C $CFG stop" >/dev/null 2>&1 || true

say dirs
mkdir -p /var/lib/mailman3/data /var/lib/mailman3/queue /var/lib/mailman3/lists /var/lib/mailman3/locks /var/lib/mailman3/cache /var/lib/mailman3/archives /var/lib/mailman3/templates /var/lib/mailman3/messages /var/lib/mailman3/ext /var/log/mailman3 /run/mailman3
if [ -f /var/lib/mailman3/data/mailman.db ] && [ ! -s /var/lib/mailman3/data/mailman.db ]; then rm -f /var/lib/mailman3/data/mailman.db; fi
chown -R list:list /var/lib/mailman3 /var/log/mailman3 /run/mailman3
chmod 755 /var/lib/mailman3 /var/lib/mailman3/data /var/log/mailman3 /run/mailman3

say mailman-cfg
[ -f $CFG.orig ] || cp -p $CFG $CFG.orig
sed -i 's/^site_owner:.*/site_owner: root@local.edu/' $CFG
grep -q '^verp_confirmations:' $CFG || printf 'verp_confirmations: yes\n' >> $CFG
grep -nE '^(site_owner|layout|incoming|outgoing|smtp_host|smtp_port|lmtp_host|lmtp_port|configuration|verp_confirmations):' $CFG

say postfix-cfg
postconf -e 'mydestination = localhost'
postconf -e 'relay_domains = local.edu'
postconf -e 'transport_maps = regexp:/etc/postfix/transport.regexp'
postconf -e 'local_recipient_maps = proxy:unix:passwd.byname $alias_maps'
cat > /etc/postfix/transport.regexp <<'EOF'
/^reading-group[^@]*@local\.edu$/  lmtp:127.0.0.1:8024
/^[^@]+@local\.edu$/               local:
EOF
grep -qE '^lmtp[[:space:]]' /etc/postfix/master.cf || printf 'lmtp      unix  -       -       y       -       -       lmtp\n' >> /etc/postfix/master.cf
grep -nE '^lmtp[[:space:]]' /etc/postfix/master.cf
postconf -n
postfix check 2>&1 || true

say mailman-start
aslist "mailman -C $CFG start"
sleep 5
aslist "mailman -C $CFG status" 2>&1 || true
( ss -lntp 2>/dev/null || netstat -lnt 2>/dev/null ) | grep -E ':(8024|8001)' || true

say create-list
aslist "mailman -C $CFG create reading-group@local.edu" 2>&1 || true
aslist "mailman -C $CFG lists" 2>&1

say policies
cat > /usr/local/sbin/set-list-policies.py <<'PY'
from mailman.core.initialize import initialize
from mailman.interfaces.listmanager import IListManager
from mailman.interfaces.mailinglist import SubscriptionPolicy
from mailman.interfaces.action import Action
from mailman.database.transaction import transaction
from zope.component import getUtility

LIST = 'reading-group@local.edu'
initialize('/etc/mailman3/mailman.cfg')
mlist = getUtility(IListManager).get(LIST)
assert mlist is not None, LIST
with transaction():
    mlist.subscription_policy = SubscriptionPolicy.confirm
    mlist.unsubscription_policy = SubscriptionPolicy.confirm
    mlist.default_member_action = Action.accept
    mlist.default_nonmember_action = Action.accept
    mlist.description = 'Reading group mailing list'
print('subscription_policy=%s unsubscription_policy=%s member=%s nonmember=%s' % (
    mlist.subscription_policy, mlist.unsubscription_policy,
    mlist.default_member_action, mlist.default_nonmember_action))
PY
aslist "python3 /usr/local/sbin/set-list-policies.py" 2>&1

say postfix-start
postfix start 2>&1 || postfix reload 2>&1 || true
sleep 2
postfix status 2>&1 || true

say smoke-local-delivery
U=smoke$(od -An -N3 -tu4 /dev/urandom | tr -d ' ')
useradd "$U"
echo "Subject: local smoke test" | sendmail -f tester@local.edu "$U@local.edu"
sleep 5
ls -l "/var/mail/$U" 2>&1
grep -c 'local smoke test' "/var/mail/$U" 2>&1
echo "USER=$U"

say smoke-lmtp
echo "Subject: join smoke" | sendmail -f "$U@local.edu" reading-group-join@local.edu
sleep 8
ls -l "/var/mail/$U" 2>&1
tail -25 /var/log/mailman3/lmtp 2>&1 || true
tail -25 /var/log/mailman3/mailman.log 2>&1 || true
tail -20 /var/log/mail.log 2>&1 || true
SCRIPT_EOF
echo "WRITE_STATUS=$?" — approved
