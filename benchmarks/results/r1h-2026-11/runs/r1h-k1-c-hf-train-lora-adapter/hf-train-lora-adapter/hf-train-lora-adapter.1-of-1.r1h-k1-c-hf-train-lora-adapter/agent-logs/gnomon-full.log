[approval] bash: cd /app && cat > /tmp/evtest.py <<'PY'
import os, torch, importlib.util
torch.set_num_threads(8)
spec=importlib.util.spec_from_file_location("t","/app/train_lora.py"); t=importlib.util.module_from_spec(spec); spec.loader.exec_module(t)
from transformers import AutoTokenizer, AutoModelForCausalLM
from peft import LoraConfig, get_peft_model
def mem(): return round(int(open('/sys/fs/cgroup/memory.current').read())/1048576)
tok=AutoTokenizer.from_pretrained("openai-community/gpt2"); tok.pad_token=tok.eos_token
rows=t.load_split("/app/data/val.json")
print("loaded tok MB",mem(),flush=True)
m=AutoModelForCausalLM.from_pretrained("openai-community/gpt2")
print("loaded model MB",mem(),flush=True)
pm=get_peft_model(m, LoraConfig(r=8,lora_alpha=16,target_modules=["c_attn"],task_type="CAUSAL_LM"))
print("peft MB",mem(),flush=True)
for bs in (8,12):
    acc,_=t.evaluate(pm,tok,rows,batch_size=bs)
    print("eval bs",bs,"acc",round(acc,3),"MB",mem(),flush=True)
# now training step memory with bs 12
opt=torch.optim.AdamW([p for p in pm.parameters() if p.requires_grad],lr=1e-3); pm.train()
tr=t.load_split("/app/data/train.json")
ex=[t.build_example(tok,tr[i],i%6,256) for i in range(12)]
for step in range(6):
    ids,lab,att=t.collate(ex,tok.pad_token_id)
    out=pm(input_ids=ids,attention_mask=att,labels=lab)
    print("fwd MB",mem(),flush=True)
    out.loss.backward(); opt.step(); opt.zero_grad()
    print("step",step,"MB",mem(),flush=True)
PY
