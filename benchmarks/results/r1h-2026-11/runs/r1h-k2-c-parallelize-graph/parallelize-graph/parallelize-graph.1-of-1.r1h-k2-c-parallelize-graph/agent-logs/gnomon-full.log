new_main = '''/* -------------------------------------------------------------------- */
/* main                                                                 */
/* -------------------------------------------------------------------- */
int main(int argc, char **argv)
{
    const char *in_path = (argc > 1) ? argv[1] : "test";
    const char *out_dir = (argc > 2) ? argv[2] : ".";
    static shared int s_nrec, s_k;
    static shared int32_t s_cnt[DBG_MAXTHREADS];
    int nrec = 0, k = 0;
    char *buf;
    size_t buf_len = 0;

    uint32_t nt = (uint32_t)THREADS, me = (uint32_t)MYTHREAD, t;
    uint32_t nbuckets, bpt, bpt_shift;
    uint32_t lpp = 1, next_free = 0;
    dbg_view view;
    int32_t *path;
    char *contig;
    int contig_cap, ncontigs = 0;
    char out_path[512];
    FILE *out;
    int trace = (getenv("DBG_TRACE") != NULL);
    shared dbg_node *nodes;
    shared int32_t *heads;
    shared dbg_flag *vis;
    shared int32_t *nlocal;

    /* ---- 1. size the problem ----------------------------------------- */
    buf = read_file(in_path, &buf_len);
    if (!buf) {
        if (me == 0) fprintf(stderr, "[pgen] error: cannot read %s\\n", in_path);
        upc_global_exit(EXIT_FAILURE);
    }
    survey(buf, buf_len, &nrec, &k);
    if (me == 0) { s_nrec = nrec; s_k = k; }
    upc_barrier;
    nrec = s_nrec;
    k = s_k;
    if (nrec <= 0 || k <= 0 || k > 64) fail_all("bad or empty input");

    /* ---- 2. graph geometry, identical on every thread ----------------- */
    nbuckets = dbg_next_pow2((uint32_t)nrec * 2u);
    while (nbuckets < nt * 2u) nbuckets <<= 1;
    bpt = nbuckets / nt;                    /* buckets per thread, power of 2 */
    bpt_shift = 0;
    while ((1u << bpt_shift) < bpt) bpt_shift++;

    memset(&view, 0, sizeof view);
    view.nthreads = nt;
    view.bpt = bpt;
    view.bpt_shift = bpt_shift;
    view.bound = (uint32_t)nrec;

    /* ---- 3. how many records each thread will own --------------------
     * The owner of a k-mer is a function of its hash alone, so counting here
     * gives exactly the number of insertions the build phase will make, and the
     * shared chunks can be sized to the largest owner instead of to nrec. */
    {
        const char *p = buf, *end = buf + buf_len;
        uint64_t key;
        int left, right;
        int32_t mine = 0;

        while (parse_rec(&p, end, k, &key, &left, &right))
            if (dbg_owner_of(&view, key) == me) mine++;
        if (me == 0) for (t = 0; t < nt; t++) s_cnt[t] = 0;
        upc_barrier;
        s_cnt[me] = mine;
        upc_barrier;
        for (t = 0; t < nt; t++)
            if ((uint32_t)s_cnt[t] > lpp) lpp = (uint32_t)s_cnt[t];
        lpp += 1u;                          /* a chunk is never empty */
    }

    /* ---- 4. shared graph: one chunk per thread ----------------------- */
    nodes = (shared dbg_node *)
        upc_all_alloc((size_t)THREADS, sizeof(dbg_node) * (size_t)lpp);
    heads = (shared int32_t *)
        upc_all_alloc((size_t)THREADS, sizeof(int32_t) * (size_t)bpt);
    vis = (shared dbg_flag *)
        upc_all_alloc((size_t)THREADS, sizeof(dbg_flag) * (size_t)lpp);
    nlocal = (shared int32_t *)
        upc_all_alloc(1, sizeof(int32_t) * (size_t)THREADS);
    if (!nodes || !heads || !vis || !nlocal) fail_all("shared heap exhausted");

    for (t = 0; t < nt; t++) {
        view.node_tab[t] = nodes + (size_t)t * lpp;
        view.head_tab[t] = heads + (size_t)t * bpt;
        view.vis_tab[t] = vis + (size_t)t * lpp;
    }
    view.nlocal = nlocal;
    {
        size_t i;
        /* each thread clears only its own chunk: nothing else touches it */
        for (i = 0; i < bpt; i++) heads[(size_t)me * bpt + i] = -1;
        for (i = 0; i < lpp; i++) {
            view.node_tab[me][i].key = 0;
            vis[(size_t)me * lpp + i] = 0;
        }
    }
    upc_barrier;

    /* ---- 5. build: insert exactly the records this thread owns -------
     * Every insertion is local: no remote references, no atomics, and the
     * per-k-mer ownership rule guarantees no record is inserted twice. */
    {
        const char *p = buf, *end = buf + buf_len;
        uint64_t key;
        int left, right;

        while (parse_rec(&p, end, k, &key, &left, &right)) {
            if (dbg_owner_of(&view, key) != me) continue;
            (void)dbg_insert_local(&view, me, key, left, right, &next_free);
        }
    }
    free(buf);
    buf = NULL;
    nlocal[me] = (int32_t)next_free;
    upc_barrier;

    /* ---- 6. indegree: a stored right extension is an incoming edge ----
     * The target can live on another thread, hence the atomic add; the edge is
     * counted by the thread owning its tail, so each edge is counted once. */
    {
        uint32_t i;
        for (i = 0; i < next_free; i++) {
            int32_t gid = dbg_make_id(me, i);
            int32_t succ = dbg_succ(&view, k, gid);
            if (succ >= 0) dbg_add_indeg(&view, succ, 1);
        }
    }

    /* ---- 7. traverse ------------------------------------------------- */
    contig_cap = 4 * (k + 64) > 4096 ? 4 * (k + 64) : 4096;
    contig = (char *)xalloc((size_t)contig_cap);
    path = (int32_t *)xalloc(sizeof(int32_t) * (size_t)nrec);

    if (snprintf(out_path, sizeof out_path, "%s/pgen_%d.out", out_dir, MYTHREAD)
            >= (int)sizeof out_path)
        fail_all("output path too long");
    out = fopen(out_path, "wb");
    if (!out) fail_all("cannot open output file");

    ncontigs += run_pass(&view, dbg_pass_sources, 0, k, nrec, path,
                         contig, contig_cap, out);
    ncontigs += run_pass(&view, dbg_pass_merges, 1, k, nrec, path,
                         contig, contig_cap, out);
    ncontigs += run_pass(&view, dbg_pass_cycles, 2, k, nrec, path,
                         contig, contig_cap, out);
    fclose(out);
    free(path);
    free(contig);

    /* ---- summary ----------------------------------------------------- */
    if (trace) {
        static shared int s_print;
        if (me == 0) s_print = 0;
        upc_barrier;
        if (me == 0) {
            int total = 0;
            for (t = 0; t < nt; t++) total += (int)nlocal[t];
            fprintf(stderr,
                    "[pgen] threads=%u k=%d records=%d nodes=%d buckets=%u "
                    "contigs/thread=%d\\n",
                    nt, k, nrec, total, nbuckets, ncontigs);
        }
        (void)s_print;
    }
    upc_barrier;
    return EXIT_SUCCESS;
}
'''
