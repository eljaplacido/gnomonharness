s=s.replace("""void *upc_all_alloc(size_t nblocks, size_t nbytes)
{
    size_t total = nblocks * nbytes;
    void *p;

    if (total == 0) total = 1;
    p = calloc(1, total);                   /* zeroed, like UPC's shared heap */
    if (!p) {
        fprintf(stderr, "[upcshim] shared heap exhausted (%zu bytes)\\n", total);
        exit(EXIT_FAILURE);
    }
    return p;
}""",
"""/* upc_all_alloc() is collective in UPC: every thread calls it with the same
 * arguments and every thread gets a pointer to the same shared block.  The shim
 * reproduces that with a rendezvous per call.  Threads make their calls in the
 * same order (pgen's main() is one thread-oblivious control flow), so a shared
 * slot per call is enough.  The slots are never reused, so no second barrier is
 * needed to protect a reader. */
#define UPC_SHIM_MAX_ALLOCS 128
static void *g_slot[UPC_SHIM_MAX_ALLOCS];
static unsigned int g_slot_used;
static __thread unsigned int t_slot;

void *upc_all_alloc(size_t nblocks, size_t nbytes)
{
    size_t total = nblocks * nbytes;
    unsigned int idx = t_slot++;
    void *p;

    if (idx >= UPC_SHIM_MAX_ALLOCS) {
        fprintf(stderr, "[upcshim] too many shared allocations\\n");
        exit(EXIT_FAILURE);
    }
    if (t_mythread == 0) {
        if (total == 0) total = 1;
        p = calloc(1, total);               /* zeroed, like UPC's shared heap */
        if (!p) {
            fprintf(stderr, "[upcshim] shared heap exhausted (%zu bytes)\\n", total);
            exit(EXIT_FAILURE);
        }
        g_slot[idx] = p;
        __atomic_store_n(&g_slot_used, idx + 1, __ATOMIC_SEQ_CST);
    }
    pthread_barrier_wait(&g_barrier);
    return g_slot[idx];
}""")
open('upcshim.c','w').write(s)
