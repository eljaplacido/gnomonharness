[approval] bash: cd /app && python3 - <<'PY'
s=open('dbg_core.h').read()
head=s[:s.index('/* ---- emission ---')]
tail=s[s.index('#endif /* DBG_CORE_H */'):]
new='''/* ---- emission -------------------------------------------------------- */

/* Write the bases of path[0..L-1] to buf -- k bases for the first k-mer, one per
 * further k-mer -- and NUL terminate; returns the contig length.  `offset` is
 * where the walk starts inside the (cyclically indexed) path. */
static inline int dbg_write_bases(const dbg_view *v, int k, const int32_t *path,
                                  int L, int offset, char *buf, int bufsz)
{
    int i, len;

    if (bufsz < k + L + 2) return 0;
    dbg_unpack(dbg_key(v, path[offset % L]), k, buf);
    len = k;
    for (i = 1; i < L; i++) {
        uint64_t nk = dbg_key(v, path[(offset + i) % L]);
        buf[len++] = dbg_base_char[nk & 3];
    }
    buf[len] = '\\0';
    return len;
}

/* Claim every k-mer of the path, atomically.  Returns 1 on success.  On failure
 * the k-mers this call took are released, so the graph is left as it was. */
static inline int dbg_claim_all(const dbg_view *v, const int32_t *path, int L)
{
    int i;

    for (i = 0; i < L; i++)
        if (!dbg_claim(v, path[i])) {
            int j;
            for (j = 0; j < i; j++) dbg_unclaim(v, path[j]);
            return 0;
        }
    return 1;
}

/* Emit the unitig that `head` starts, if head starts one.
 *
 * Preconditions : path holds pathmax (~ the number of k-mers) slots, buf bufsz
 *                 bytes, and head's indegree is not 1.
 * Postconditions: the contig is written to buf and its length returned iff the
 *                 forward walk from head ends at a k-mer with no successor (a
 *                 sink or an un-stored extension) rather than closing back onto
 *                 head, and this call wins all of the walk's k-mers.  A walk
 *                 that closes onto head is a cycle: it must be emitted once,
 *                 rotated to its smallest k-mer, which dbg_emit_cycle does.
 *                 Returns 0 otherwise and leaves the graph unchanged. */
static inline int dbg_emit_path(const dbg_view *v, int k, int32_t head,
                                int32_t *path, int pathmax, char *buf, int bufsz)
{
    int L = dbg_scan_path(v, k, head, path, pathmax);
    int len;

    if (dbg_succ(v, k, path[L - 1]) == head) return 0;   /* a cycle, not a path */
    if (!dbg_claim_all(v, path, L)) return 0;
    len = dbg_write_bases(v, k, path, L, 0, buf, bufsz);
    if (len > 0) {
        int i;
        for (i = 0; i < L; i++) dbg_mark_written(v, path[i]);
    }
    return len;
}

/* Emit the cycle that contains `gid`, rotated to its smallest k-mer.
 *
 * Postconditions: the contig is written to buf and its length returned iff gid
 *                 lies on a cycle, gid is that cycle's smallest k-mer, no k-mer
 *                 of the cycle has been written yet, and this call wins them
 *                 all.  Returns 0 otherwise and leaves the graph unchanged.
 *                 Every cycle therefore yields exactly one contig, whichever
 *                 thread sees it first. */
static inline int dbg_emit_cycle(const dbg_view *v, int k, int32_t gid,
                                 int32_t *path, int pathmax, char *buf, int bufsz)
{
    int L, closed, best = 0, step, len;

    if (dbg_covered(v, gid)) return 0;
    if (!dbg_is_cycle_min(v, k, gid)) return 0;
    L = dbg_scan_cycle(v, k, gid, path, pathmax, &closed);
    if (!closed) return 0;
    if (!dbg_claim_all(v, path, L)) return 0;
    for (step = 1; step < L; step++)
        if (dbg_key(v, path[step]) < dbg_key(v, path[best])) best = step;
    len = dbg_write_bases(v, k, path, L, best, buf, bufsz);
    if (len > 0) {
        for (step = 0; step < L; step++) dbg_mark_written(v, path[step]);
    }
    return len;
}

/* ---- the traversal, one k-mer at a time ------------------------------ */
/* A pass is called once per k-mer and returns the length of the contig it made,
 * or 0.  Splitting the traversal into passes lets the parallel version put a
 * barrier between them, which is what makes the result independent of the
 * schedule: every k-mer is examined by every pass, so it does not matter which
 * thread examines which k-mer, nor in what order. */

/* Pass 1: a source -- indegree 0 -- starts a unitig. */
static inline int dbg_pass_sources(const dbg_view *v, int k, int32_t gid,
                                   int32_t *path, int pathmax,
                                   char *buf, int bufsz)
{
    if (dbg_get_indeg(v, gid) != 0) return 0;
    return dbg_emit_path(v, k, gid, path, pathmax, buf, bufsz);
}

/* Pass 2: a merge point -- indegree >= 2 -- starts a unitig, unless its walk
 * closes onto itself, in which case pass 3 emits it as a cycle. */
static inline int dbg_pass_merges(const dbg_view *v, int k, int32_t gid,
                                  int32_t *path, int pathmax,
                                  char *buf, int bufsz)
{
    int32_t indeg = dbg_get_indeg(v, gid);
    if (indeg < 2) return 0;
    return dbg_emit_path(v, k, gid, path, pathmax, buf, bufsz);
}

/* Pass 3: whatever k-mers passes 1 and 2 did not cover are on cycles -- simple
 * ones whose k-mers all have indegree 1, or ones whose only head is a merge
 * point.  Each such cycle is emitted by its smallest k-mer, once. */
static inline int dbg_pass_cycles(const dbg_view *v, int k, int32_t gid,
                                  int32_t *path, int pathmax,
                                  char *buf, int bufsz)
{
    return dbg_emit_cycle(v, k, gid, path, pathmax, buf, bufsz);
}

'''
open('dbg_core.h','w').write(head+new+tail)
