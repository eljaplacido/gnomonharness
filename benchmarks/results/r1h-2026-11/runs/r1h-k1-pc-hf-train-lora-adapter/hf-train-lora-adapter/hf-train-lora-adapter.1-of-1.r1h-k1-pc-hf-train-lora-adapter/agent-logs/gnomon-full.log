import json, random, re, time
import torch
import torch.nn.functional as F
from peft import LoraConfig, PeftModel, get_peft_model
from torch.optim import AdamW
from torch.optim.lr_scheduler import LambdaLR
from torch.utils.data import DataLoader, Dataset
from transformers import AutoModelForCausalLM, AutoTokenizer

SEED = 42
EPOCHS = 1
BATCH_SIZE = 4
LR = 1.5e-3
WEIGHT_DECAY = 0.01
WARMUP_RATIO = 0.06
MAX_LEN = 512
LETTERS = ['A', 'B', 'C', 'D']
TRAIN_STYLES = [0, 1, 2]

random.seed(SEED)
torch.manual_seed(SEED)
torch.set_num_threads(4)

with open('data/train.json') as handle:
    train_rows = json.load(handle)
with open('data/val.json') as handle:
    val_rows = json.load(handle)
print('loaded train={} val={} samples'.format(len(train_rows), len(val_rows)), flush=True)

tokenizer = AutoTokenizer.from_pretrained('openai-community/gpt2')
if tokenizer.pad_token is None:
    tokenizer.pad_token = tokenizer.eos_token

def strip_letter(option):
    return re.sub(r'^\s*[A-Da-d]\s*[\.\)\:]\s*', '', option).strip()

def option_body(texts, sep='. '):
    return '\n'.join(letter + sep + text for letter, text in zip(LETTERS, texts))

def build_prompt(question, texts, style):
    if style == 0:
        return 'Question: {}\n{}\nAnswer:'.format(question, option_body(texts))
    if style == 1:
        return 'Question: {}\n{}\nAnswer:'.format(question, option_body(texts, sep=') '))
    if style == 2:
        return 'Answer the following multiple-choice question about biology.\n\n{}\n\n{}\n\nAnswer:'.format(question, option_body(texts))

def build_target(texts, gold):
    index = LETTERS.index(gold)
    return ' {}. {}'.format(LETTERS[index], texts[index])

class MCQADataset(Dataset):
    def __init__(self, rows, styles):
        self.items = []
        for row in rows:
            question = row['question'].strip()
            texts = [strip_letter(o) for o in row['options']]
            gold = row['answer'].strip().upper()[0]
            for style in styles:
                self.items.append((build_prompt(question, texts, style), build_target(texts, gold)))
    def __len__(self):
        return len(self.items)
    def __getitem__(self, index):
        return self.items[index]

def collate(batch, tokenizer):
    pad_id = tokenizer.pad_token_id
    if pad_id is None:
        pad_id = tokenizer.eos_token_id
    input_ids, labels = [], []
    for prompt, target in batch:
        prompt_ids = tokenizer(prompt, add_special_tokens=False)['input_ids']
        target_ids = tokenizer(target, add_special_tokens=False)['input_ids']
        prompt_ids = prompt_ids[: MAX_LEN - 64]
        ids = (prompt_ids + target_ids)[:MAX_LEN]
        label = ([-100] * len(prompt_ids) + target_ids)[:MAX_LEN]
        input_ids.append(ids)
        labels.append(label)
    width = max(len(ids) for ids in input_ids)
    attention = []
    for index, ids in enumerate(input_ids):
        padding = width - len(ids)
        input_ids[index] = ids + [pad_id] * padding
        labels[index] = labels[index] + [-100] * padding
        attention.append([1] * len(ids) + [0] * padding)
    return (torch.tensor(input_ids, dtype=torch.long), torch.tensor(attention, dtype=torch.long), torch.tensor(labels, dtype=torch.long))

dataset = MCQADataset(train_rows, TRAIN_STYLES)
loader = DataLoader(dataset, batch_size=BATCH_SIZE, shuffle=True, collate_fn=lambda batch: collate(batch, tokenizer), drop_last=False)
print('prompt/answer pairs after template augmentation: {}'.format(len(dataset)), flush=True)

model = AutoModelForCausalLM.from_pretrained('openai-community/gpt2')
model.config.pad_token_id = tokenizer.pad_token_id
print('Model loaded', flush=True)

lora_config = LoraConfig(r=8, lora_alpha=16, lora_dropout=0.05, target_modules=['c_attn'], bias='none', task_type='CAUSAL_LM')
model = get_peft_model(model, lora_config)
print('LoRA applied', flush=True)
model.print_trainable_parameters()
print('Trainable params printed', flush=True)

total_steps = len(loader) * EPOCHS
warmup_steps = max(1, int(total_steps * WARMUP_RATIO))
params = [p for p in model.parameters() if p.requires_grad]
optimizer = AdamW(params, lr=LR, weight_decay=WEIGHT_DECAY)
print('Optimizer created', flush=True)

import math
def lr_lambda(step):
    if step < warmup_steps:
        return float(step + 1) / float(max(1, warmup_steps))
    progress = float(step - warmup_steps) / float(max(1, total_steps - warmup_steps))
    progress = min(1.0, max(0.0, progress))
    return max(0.05, 0.5 * (1.0 + math.cos(math.pi * progress)))

scheduler = LambdaLR(optimizer, lr_lambda)
print('Scheduler created', flush=True)

print('Starting training loop...', flush=True)
for epoch in range(1, EPOCHS + 1):
    model.train()
    epoch_start = time.time()
    running = 0.0
    steps = 0
    for input_ids, attention, labels in loader:
        logits = model(input_ids=input_ids, attention_mask=attention).logits[:, :-1, :]
        targets = labels[:, 1:].reshape(-1)
        mask = targets != -100
        if int(mask.sum()) == 0:
            continue
        selected = logits.reshape(-1, logits.size(-1))[mask]
        loss = F.cross_entropy(selected, targets[mask])
        loss.backward()
        torch.nn.utils.clip_grad_norm_(params, 1.0)
        optimizer.step()
        scheduler.step()
        optimizer.zero_grad(set_to_none=True)
        running += float(loss.detach())
        steps += 1
        if steps % 50 == 0:
            print('  step {}/{} loss {:.4f}'.format(steps, len(loader), running / steps), flush=True)
    train_loss = running / max(1, steps)
    print('Epoch {} done: loss={:.4f} steps={}'.format(epoch, train_loss, steps), flush=True)
    break

print('Training loop test done', flush=True)
