import json, torch, re
from transformers import AutoModelForCausalLM, AutoTokenizer
from peft import LoraConfig, get_peft_model

with open('data/val.json') as f:
    val_rows = json.load(f)

tokenizer = AutoTokenizer.from_pretrained('openai-community/gpt2')
if tokenizer.pad_token is None:
    tokenizer.pad_token = tokenizer.eos_token

LETTERS = ['A', 'B', 'C', 'D']

def strip_letter(option):
    return re.sub(r'^\s*[A-Da-d]\s*[\.\)\:]\s*', '', option).strip()

def option_body(texts, sep='. '):
    return '\n'.join(letter + sep + text for letter, text in zip(LETTERS, texts))

def build_prompt(question, texts, style):
    if style == 0:
        return 'Question: {}\n{}\nAnswer:'.format(question, option_body(texts))
    if style == 1:
        return 'Question: {}\n{}\nAnswer:'.format(question, option_body(texts, sep=') '))
    if style == 2:
        return 'Answer the following multiple-choice question about biology.\n\n{}\n\n{}\n\nAnswer:'.format(question, option_body(texts))

def encode(tokenizer, text):
    return tokenizer(text, add_special_tokens=False)['input_ids']

def continuation_logprob(model, context_ids, continuation_ids):
    ids = torch.tensor([context_ids + continuation_ids], dtype=torch.long)
    logits = model(input_ids=ids).logits[0]
    logprobs = torch.log_softmax(logits[-len(continuation_ids) - 0:].float(), dim=-1)
    total = 0.0
    for position, token_id in enumerate(continuation_ids):
        total += float(logprobs[position, token_id])
    return total

def letter_scores(model, tokenizer, prompt):
    context = encode(tokenizer, prompt)
    scores = {}
    for letter in LETTERS:
        token_id = encode(tokenizer, ' ' + letter)[0]
        ids = torch.tensor([context], dtype=torch.long)
        logits = model(input_ids=ids).logits[0]
        logprobs = torch.log_softmax(logits[-1].float(), dim=-1)
        scores[letter] = float(logprobs[token_id])
    return scores

def option_scores(model, tokenizer, prompt, texts, sep='. '):
    context = encode(tokenizer, prompt)
    scores = {}
