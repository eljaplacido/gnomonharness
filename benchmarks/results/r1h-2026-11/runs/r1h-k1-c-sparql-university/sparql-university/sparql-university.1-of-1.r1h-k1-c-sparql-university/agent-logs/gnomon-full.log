import sys, re
sys.path.insert(0,'.tmp_eval')
import sparql_eval as E
t = E.load_turtle('university_graph.ttl')
base = open('solution.sparql').read()

def run(q):
    p = E.Parser(E.tokenize(q)); query = p.parse_query()
    return [(r.get('professorName',('','',''))[1], r.get('countries',('','',''))[1]) for r in E.run_query(query, t)]

print("baseline:", run(base))
# control 1: drop EU VALUES -> all full professors, so EU filter is doing work
q1 = base.replace('"AT" "BE" "BG" "HR" "CY" "CZ" "DK" "EE" "FI" "FR"\n        "DE" "GR" "HU" "IE" "IT" "LV" "LT" "LU" "MT" "NL"\n        "PL" "PT" "RO" "SK" "SI" "ES" "SE"', '"US" "CH"')
print("non-EU only (CH/US as 'EU'):", run(q1))
# control 2: threshold > 12 -> impossible
print("threshold >12:", run(base.replace('> 10', '> 12')))
# control 3: threshold > 11 -> 12-student depts
print("threshold >11:", run(base.replace('> 10', '> 11')))
# control 4: ignore graduation dates -> counts change
print("no grad filter:", run(base.replace('FILTER(!BOUND(?graduatedOn) || ?graduatedOn > "2025-08-16"^^xsd:date)', '')))
# control 5: no role filter -> assistants included if they qualify
print("no rank filter:", run(base.replace('FILTER(!REGEX(LCASE(?role), "assistant|associate|adjunct|visiting|emeritus|lecturer|teaching"))','')))
# control 6: reference date before all graduations
print("today=2024-02-01:", run(base.replace('2025-08-16', '2024-02-01')))
