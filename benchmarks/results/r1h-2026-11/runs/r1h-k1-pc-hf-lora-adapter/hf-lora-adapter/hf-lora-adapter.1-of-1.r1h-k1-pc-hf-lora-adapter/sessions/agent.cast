[17.332946, "o", "2. Download the LoRA adapter '\"'\"'dominguesm/xlm-roberta-base-lora-language-detection'\"'\"' \r\n\u001b[?2004l\r\u001b[?2004h"]
[17.332978, "o", "> "]
