PREFIX uni: <http://university.org/ontology/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# Reference (today) date: 2025-08-16
# A "full professor" has a role that starts with "Professor" (so
# "Assistant Professor ..." / "Associate Professor ..." are excluded).
# Students "currently enrolled" are those whose enrollment date is not in the
# future and who have not graduated on or before the reference date.

SELECT ?professorName (GROUP_CONCAT(DISTINCT ?country; separator=", ") AS ?countries)
