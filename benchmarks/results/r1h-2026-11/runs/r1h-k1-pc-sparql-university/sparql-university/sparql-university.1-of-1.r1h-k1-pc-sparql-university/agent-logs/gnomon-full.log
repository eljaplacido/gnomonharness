  ?professor a uni:Person ;
             uni:hasName ?professorName ;
             uni:role ?role ;
             uni:worksIn ?department .

  # 1. Full professors only
  FILTER(STRSTARTS(STR(?role), "Professor "))

  # Countries where the professor works (all of them are collected in ?countries)
  ?department uni:belongsTo ?university .
  ?university uni:locatedInCountry ?country .

  # 2. Works in at least one department of a university in an EU member state
