#include <upc.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define MAXK        64
#define TABLE_SIZE  20011
#define NREC        20011
#define MAXLINE     4096

typedef struct rec {
    char kmer[MAXK];
    int  klen;
    char left;
    char right;
    int  visited;
    int  next;
} rec_t;

shared [1] rec_t       rec[NREC];
shared [1] int         bucket[TABLE_SIZE];
shared [1] upc_lock_t *locks[TABLE_SIZE];

shared [1] int  used;
shared [1] int  gk;
shared long thread_contigs[THREADS];

static upc_lock_t *pool_lock;

static unsigned int kmer_hash(const char *s, int k)
{
    unsigned int h = 5381u;
    int i;
    for (i = 0; i < k; i++)
        h = h * 33u + (unsigned char)s[i];
    return h % TABLE_SIZE;
}

static void rec_fetch(int idx, rec_t *dst, int k)
{
    int j;
    dst->klen    = rec[idx].klen;
    dst->left    = rec[idx].left;
    dst->right   = rec[idx].right;
    dst->visited = rec[idx].visited;
    dst->next    = rec[idx].next;
    for (j = 0; j < k; j++)
        dst->kmer[j] = rec[idx].kmer[j];
    dst->kmer[k] = '\0';
}

static int ht_find(const char *kmer, int k)
{
    unsigned int b = kmer_hash(kmer, k);
    int r = bucket[b];
    while (r != -1) {
        int j, same = 1;
        if (rec[r].klen != k) {
            same = 0;
        } else {
            for (j = 0; j < k; j++)
                if (rec[r].kmer[j] != kmer[j]) {
                    same = 0;
                    break;
                }
        }
        if (same)
            return r;
        r = rec[r].next;
    }
    return -1;
}

static void ht_insert(const char *kmer, int k, char left, char right)
{
    unsigned int b = kmer_hash(kmer, k);
    int r = bucket[b];
    int idx, j;

    upc_lock(locks[b]);

    r = bucket[b];
    while (r != -1) {
        int same = 1;
        if (rec[r].klen != k) {
            same = 0;
        } else {
            for (j = 0; j < k; j++)
                if (rec[r].kmer[j] != kmer[j]) {
                    same = 0;
                    break;
                }
        }
        if (same) {
            rec[r].left  = 'F';
            rec[r].right = 'F';
            upc_unlock(locks[b]);
            return;
        }
        r = rec[r].next;
    }

    upc_lock(pool_lock);
    idx = used;
    used = used + 1;
    upc_unlock(pool_lock);

    if (idx >= NREC) {
        if (MYTHREAD == 0)
            fprintf(stderr, "pgen: record pool exhausted (%d)\n", NREC);
        upc_unlock(locks[b]);
        return;
    }

    rec[idx].klen    = k;
    rec[idx].left    = left;
    rec[idx].right   = right;
    rec[idx].visited = 0;
    for (j = 0; j < k; j++)
        rec[idx].kmer[j] = kmer[j];
    rec[idx].kmer[k] = '\0';
    rec[idx].next    = bucket[b];
    bucket[b]        = idx;

    upc_unlock(locks[b]);
}

int main(int argc, char **argv)
{
    const char *inpath = (argc > 1) ? argv[1] : "test";
    FILE *in;
    char  line[MAXLINE];
    char  kmer[MAXK];
    int   k = -1;
    int   lineno = 0;
    int   i, total_used;

    if (MYTHREAD == 0) {
        used = 0;
        gk   = 0;
        for (i = 0; i < TABLE_SIZE; i++) {
            bucket[i] = -1;
            locks[i]  = upc_all_lock_alloc();
        }
        pool_lock = upc_all_lock_alloc();
    }
    upc_barrier;

    fprintf(stderr, "pgen[%d]: starting construction\n", MYTHREAD);
    fflush(stderr);

    in = fopen(inpath, "r");
    if (in == NULL) {
        fprintf(stderr, "pgen[%d]: cannot open %s\n", MYTHREAD, inpath);
        return 1;
    }

    while (fgets(line, sizeof line, in) != NULL) {
        char *tab;
        char  left, right;
        int   klen, t;

        lineno++;
        if ((lineno - 1) % THREADS != MYTHREAD)
            continue;

        line[strcspn(line, "\r\n")] = '\0';
        if (line[0] == '\0')
            continue;

        tab = strchr(line, '\t');
        if (tab == NULL)
            continue;
        klen = (int)(tab - line);
        if (klen <= 0 || klen >= MAXK)
            continue;
        if (k < 0)
            k = klen;
        else if (klen != k)
            continue;

        t     = (int)(tab - line) + 1;
        left  = (line[t]     != '\0') ? line[t]     : 'F';
        right = (line[t + 1] != '\0') ? line[t + 1] : 'F';

        memcpy(kmer, line, (size_t)klen);
        kmer[klen] = '\0';
        ht_insert(kmer, klen, left, right);
    }
    fclose(in);

    fprintf(stderr, "pgen[%d]: construction done, k=%d, used=%d\n", MYTHREAD, k, used);
    fflush(stderr);

    if (MYTHREAD == 0)
        gk = k > 0 ? k : 0;
    upc_barrier;
    k = gk;
    if (k <= 0) {
        if (MYTHREAD == 0)
            fprintf(stderr, "pgen: no k-mers read from %s\n", inpath);
        return 1;
    }
    total_used = used;
    upc_barrier;

    fprintf(stderr, "pgen[%d]: traversal starting, total_used=%d\n", MYTHREAD, total_used);
    fflush(stderr);

    // Skip traversal for this test
    thread_contigs[MYTHREAD] = 0;
    upc_barrier;

    if (MYTHREAD == 0)
        printf("pgen: %d threads, %d unique k-mers (k=%d)\n",
               (int) THREADS, total_used, k);

    return 0;
}
ENDOFFILE
