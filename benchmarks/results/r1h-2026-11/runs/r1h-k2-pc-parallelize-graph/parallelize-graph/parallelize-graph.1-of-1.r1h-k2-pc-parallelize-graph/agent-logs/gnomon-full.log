# Makefile -- serial and UPC implementations of the de Bruijn graph
#             construction and traversal algorithm.
#
#   make            build both binaries: ./serial and ./pgen
#   make serial     build the serial version
#   make pgen       build the parallel UPC version (needs upcc in PATH)
#   make run        run both and write /app/serial.out, /app/pgen_*.out
#   make verify     check that both versions produced the same contigs
#   make clean      remove binaries and outputs

CC          ?= gcc
CFLAGS      ?= -O2 -Wall
UPC         ?= upcc
UPCCFLAGS   ?= -O2
UPCFLAGS    ?= -O2
UPC_RUN     ?= upcrun
THREADS     ?= 4
SHARED_HEAP ?= 256MB
INPUT       ?= test

all: serial pgen

serial: serial.c
	$(CC) $(CFLAGS) -o $@ $<

pgen: pgen.upc
	$(UPC) $(UPCCFLAGS) -o $@ $<

run: all
	./serial $(INPUT)
	$(UPC_RUN) -n $(THREADS) -shared-heap $(SHARED_HEAP) ./pgen $(INPUT)

verify: run
	sh ./verify.sh $(THREADS) $(INPUT)

clean:
	rm -f serial pgen serial.out pgen*.out

.PHONY: all run verify clean
