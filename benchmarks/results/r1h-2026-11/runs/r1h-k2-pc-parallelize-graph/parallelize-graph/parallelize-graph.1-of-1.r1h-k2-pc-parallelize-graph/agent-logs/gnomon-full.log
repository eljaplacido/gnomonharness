#!/bin/sh
# verify.sh [threads] [input]
#
# Runs the serial and the UPC version on the same input and checks that they
# produce the same contigs. Only the order of the contigs may differ.

T=${1:-4}
INPUT=${2:-test}
SERIAL_OUT=/app/serial.out
PGEN_GLOB="/app/pgen_*.out"

echo "== building =="
make serial pgen || exit 1

echo "== serial =="
./serial "$INPUT" || exit 1

echo "== pgen ($T threads) =="
upcrun -n "$T" -shared-heap 256MB ./pgen "$INPUT" || exit 1

echo "== comparing =="
sort "$SERIAL_OUT" > /tmp/serial.sorted 2>/dev/null
cat $PGEN_GLOB 2>/dev/null | sort > /tmp/pgen.sorted

s=$(wc -l < /tmp/serial.sorted)
p=$(wc -l < /tmp/pgen.sorted)
sbp=$(awk '{n+=length($0)} END{print n+0}' /tmp/serial.sorted)
pbp=$(awk '{n+=length($0)} END{print n+0}' /tmp/pgen.sorted)

echo "serial: $s contigs, $sbp bp"
echo "pgen  : $p contigs, $pbp bp"

if diff -u /tmp/serial.sorted /tmp/pgen.sorted > /tmp/contigs.diff; then
    echo "PASS: identical contig sets"
    exit 0
else
    echo "FAIL: contig sets differ"
    head -40 /tmp/contigs.diff
    exit 1
fi
EOF
