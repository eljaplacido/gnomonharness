	$(CC) $(CFLAGS) -o $@ $<

pgen: pgen.upc
	$(UPCC) $(UPCCFLAGS) -o $@ $<

run: all
	./serial $(INPUT)
	$(UPC_RUN) -n $(THREADS) -shared-heap $(SHARED_HEAP) ./pgen $(INPUT)

verify: all
	sh ./verify.sh $(THREADS) $(INPUT)

clean:
	rm -f serial pgen serial.out pgen*.out

.PHONY: all run verify clean
