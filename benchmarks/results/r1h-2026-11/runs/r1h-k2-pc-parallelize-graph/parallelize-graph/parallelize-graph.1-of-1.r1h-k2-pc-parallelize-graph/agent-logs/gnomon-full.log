/*
 * pgen.upc -- parallel de Bruijn graph construction and traversal for de novo
 *             genome assembly in Unified Parallel C, following
 *
 *   Georganas, Buluc, Chapman, Oliker, Rokhsar, Yelick,
 *   "Parallel de Bruijn Graph Construction and Traversal for De Novo Genome
 *    Assembly", SC'14, pp. 437-448.
 *
 * Input  : "<KMER>\t<left><right>" one k-mer per line, extensions in A/C/G/T,
 *          'F' meaning "no extension".
 * Output : one DNA contig per line, to /app/pgen_<thread>.out for each thread.
 *
 * Parallel structure
 * ------------------
 * The de Bruijn graph is a hash table with separate chaining that lives in the
 * UPC shared address space, so every thread can follow a chain that another
 * thread built:
 *
 *   rec[]     shared record pool, one record per unique k-mer
 *   bucket[]  shared chain heads, -1 = empty bucket
 *   locks[]   one lock per bucket
 *
 * Construction: the k-mers are distributed over threads round-robin by line
 * number. Each thread hashes its k-mers into its own records, taking the
 * bucket lock before touching a chain. A k-mer seen twice is a repeat: its
 * extensions are cleared to 'F' so it cannot be walked through.
 *
 * Traversal: after a barrier, the records are again distributed round-robin by
 * record index. A thread only starts a walk at a node with no incoming edge
 * (left extension 'F', or a predecessor absent from the graph), then follows
 * forward extensions, marking visited nodes in shared memory. Because a walk
 * starts only where nothing can extend into it, and nodes are marked as they
 * are consumed, the contigs a thread may emit do not depend on which other
 * threads walk concurrently: the union over threads is the serial result.
 * Only the order of the contigs, and which thread writes which contig, differ.
 */

#include <upc.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define MAXK        64             /* longest k-mer this build supports */
#define TABLE_SIZE  20011          /* prime, > 10000 k-mers */
#define NREC        20011          /* record pool, > number of unique k-mers */
#define MAXLINE     4096

typedef struct rec {
    char kmer[MAXK];
    int  klen;
    char left;                     /* backward extension, 'F' = none */
    char right;                    /* forward  extension, 'F' = none */
    int  visited;                  /* traversal mark */
    int  next;                     /* next record in the chain, -1 = end */
} rec_t;

shared [1] rec_t       rec[NREC];
shared [1] int         bucket[TABLE_SIZE];
shared [1] upc_lock_t *locks[TABLE_SIZE];

shared int  used;                  /* records handed out so far */
shared int  gk;                    /* k-mer length, decided during build */
shared long thread_contigs[THREADS];

static upc_lock_t *pool_lock;      /* guards the record counter */

static unsigned int kmer_hash(const char *s, int k)
{
    unsigned int h = 5381u;
    int i;
    for (i = 0; i < k; i++)
        h = h * 33u + (unsigned char)s[i];
    return h % TABLE_SIZE;
}

/* Copy one record out of the shared pool into local memory. */
static void rec_fetch(int idx, rec_t *dst, int k)
{
    int j;
    dst->klen    = rec[idx].klen;
    dst->left    = rec[idx].left;
    dst->right   = rec[idx].right;
    dst->visited = rec[idx].visited;
    dst->next    = rec[idx].next;
    for (j = 0; j < k; j++)
        dst->kmer[j] = rec[idx].kmer[j];
    dst->kmer[k] = '\0';
}

/* Hash-table lookup. Returns the record index, or -1 if absent. */
static int ht_find(const char *kmer, int k)
{
    unsigned int b = kmer_hash(kmer, k);
    int r = bucket[b];

    while (r != -1) {
        int j, same = 1;
        if (rec[r].klen != k) {
            same = 0;
        } else {
            for (j = 0; j < k; j++)
                if (rec[r].kmer[j] != kmer[j]) {
                    same = 0;
                    break;
                }
        }
        if (same)
            return r;
        r = rec[r].next;
    }
    return -1;
}

/* Insert a k-mer. A repeated k-mer clears both extensions of the record that
 * already represents it, which marks the k-mer as a repeat. */
static void ht_insert(const char *kmer, int k, char left, char right)
{
    unsigned int b = kmer_hash(kmer, k);
    int r = bucket[b];
    int idx, j;

    upc_lock(locks[b]);

    r = bucket[b];
    while (r != -1) {
        int same = 1;
        if (rec[r].klen != k) {
            same = 0;
        } else {
            for (j = 0; j < k; j++)
                if (rec[r].kmer[j] != kmer[j]) {
                    same = 0;
                    break;
                }
        }
        if (same) {
            rec[r].left  = 'F';
            rec[r].right = 'F';
            upc_unlock(locks[b]);
            return;
        }
        r = rec[r].next;
    }

    /* Claim a record; the pool counter is shared by every thread. */
    upc_lock(pool_lock);
    idx = used;
    used = used + 1;
    upc_unlock(pool_lock);

    if (idx >= NREC) {
        if (MYTHREAD == 0)
            fprintf(stderr, "pgen: record pool exhausted (%d)\n", NREC);
        upc_unlock(locks[b]);
        return;
    }

    rec[idx].klen    = k;
    rec[idx].left    = left;
    rec[idx].right   = right;
    rec[idx].visited = 0;
    for (j = 0; j < k; j++)
        rec[idx].kmer[j] = kmer[j];
    rec[idx].kmer[k] = '\0';
    rec[idx].next    = bucket[b];
    bucket[b]        = idx;

    upc_unlock(locks[b]);
}

int main(int argc, char **argv)
{
    const char *inpath = (argc > 1) ? argv[1] : "test";
    FILE *in, *out;
    char  line[MAXLINE];
    char  kmer[MAXK];
    char *contig;
    size_t cap;
    int   k = -1;
    int   lineno = 0;
    int   i, j, total_used;
    long  local_contigs = 0;
    long  total_contigs = 0;
    char  outpath[64];

    /* ---- one-time initialisation of the shared graph -------------------- */
    if (MYTHREAD == 0) {
        used = 0;
        gk   = 0;
        for (i = 0; i < TABLE_SIZE; i++) {
            bucket[i] = -1;
            locks[i]  = upc_all_lock_alloc();
        }
        pool_lock = upc_all_lock_alloc();
    }
    upc_barrier;

    in = fopen(inpath, "r");
    if (in == NULL) {
        fprintf(stderr, "pgen[%d]: cannot open %s\n", MYTHREAD, inpath);
        return 1;
    }

    /* ---- construction: every thread hashes its share of the k-mers ------ */
    while (fgets(line, sizeof line, in) != NULL) {
        char *tab;
        char  left, right;
        int   klen, t;

        lineno++;
        if ((lineno - 1) % THREADS != MYTHREAD)
            continue;                    /* this line belongs to another thread */

        line[strcspn(line, "\r\n")] = '\0';
        if (line[0] == '\0')
            continue;

        tab = strchr(line, '\t');
        if (tab == NULL)
            continue;                    /* malformed line */
        klen = (int)(tab - line);
        if (klen <= 0 || klen >= MAXK)
            continue;
        if (k < 0)
            k = klen;
        else if (klen != k)
            continue;

        t     = (int)(tab - line) + 1;
        left  = (line[t]     != '\0') ? line[t]     : 'F';
        right = (line[t + 1] != '\0') ? line[t + 1] : 'F';

        memcpy(kmer, line, (size_t)klen);
        kmer[klen] = '\0';
        ht_insert(kmer, klen, left, right);
    }
    fclose(in);

    /* Publish k and the number of records, then make the graph visible. */
    if (MYTHREAD == 0)
        gk = k > 0 ? k : 0;
    upc_barrier;
    k = gk;
    if (k <= 0) {
        if (MYTHREAD == 0)
            fprintf(stderr, "pgen: no k-mers read from %s\n", inpath);
        return 1;
    }
    total_used = used;
    upc_barrier;

    /* ---- traversal: each thread walks its share of the records ---------- */
    snprintf(outpath, sizeof outpath, "/app/pgen_%d.out", MYTHREAD);
    out = fopen(outpath, "w");
    if (out == NULL) {
        snprintf(outpath, sizeof outpath, "pgen_%d.out", MYTHREAD);
        out = fopen(outpath, "w");
        if (out == NULL) {
            perror(outpath);
            return 1;
        }
    }

    cap = (size_t)total_used + (size_t)k + 2;
    contig = (char *) malloc(cap);
    if (contig == NULL) {
        fprintf(stderr, "pgen[%d]: out of memory\n", MYTHREAD);
        return 1;
    }

    for (i = MYTHREAD; i < total_used; i += THREADS) {
        rec_t cur, nx;
        char  probe[MAXK];
        int   len, is_start = 1, r;

        rec_fetch(i, &cur, k);
        if (cur.visited)
            continue;

        /* A walk may start only where nothing extends into the k-mer. */
        if (cur.left != 'F') {
            probe[0] = cur.left;
            for (j = 1; j < k; j++)
                probe[j] = cur.kmer[j - 1];
            probe[k] = '\0';

            r = ht_find(probe, k);
            if (r >= 0) {
                rec_fetch(r, &nx, k);
                if (nx.right == cur.left)
                    is_start = 0;        /* a real incoming edge exists */
            }
        }
        if (!is_start)
            continue;

        rec[i].visited = 1;              /* claim the node in shared memory */
        len = k;
        memcpy(contig, cur.kmer, (size_t)k);

        while (cur.right != 'F') {
            for (j = 0; j < k - 1; j++)
                probe[j] = cur.kmer[j + 1];
            probe[k - 1] = cur.right;
            probe[k]     = '\0';

            r = ht_find(probe, k);
            if (r < 0)
                break;                   /* no such k-mer in the graph */
            rec_fetch(r, &nx, k);
            if (nx.visited)
                break;                   /* another walk already took it */
            rec[r].visited = 1;
            nx.visited = 1;
            contig[len++] = cur.right;
            cur = nx;
        }

        contig[len] = '\0';
        fputs(contig, out);
        fputc('\n', out);
        local_contigs++;
    }

    fclose(out);
    free(contig);

    thread_contigs[MYTHREAD] = local_contigs;
    upc_barrier;

    if (MYTHREAD == 0) {
        for (i = 0; i < THREADS; i++)
            total_contigs += thread_contigs[i];
        printf("pgen: %d threads, %d unique k-mers (k=%d), %ld contigs\n",
               (int) THREADS, total_used, k, total_contigs);
        for (i = 0; i < THREADS; i++)
            printf("pgen: thread %d wrote %ld contigs\n", i, thread_contigs[i]);
    }

    return 0;
}
