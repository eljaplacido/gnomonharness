/*
 * serial.c -- serial de Bruijn graph construction and traversal for de novo
 *             genome assembly, following
 *
 *   Georganas, Buluc, Chapman, Oliker, Rokhsar, Yelick,
 *   "Parallel de Bruijn Graph Construction and Traversal for De Novo Genome
 *    Assembly", SC'14, pp. 437-448.
 *
 * Input  : one k-mer per line, "<KMER>\t<left><right>", where left and right
 *          are the backward and forward extension characters (A/C/G/T) and
 *          'F' means "no extension" (the k-mer ends a contig).
 * Output : one DNA contig per line, to /app/serial.out by default.
 *
 * The graph is a hash table with separate chaining, one record per UNIQUE
 * k-mer. A k-mer seen more than once in the input is a repeat: both of its
 * extensions are set to 'F', so it can neither start nor continue a walk.
 *
 * Contigs are maximal non-branching walks. A record is a walk start when its
 * left extension is 'F', or when the k-mer it would be extended from is absent
 * from the graph (or cannot actually reach it). Walking forward appends the
 * right-extension character of each node, stopping at a k-mer whose right
 * extension is 'F', whose successor is absent, or which was already emitted.
 * The visited mark makes the set of contigs independent of the order in which
 * the start records are considered -- which is what lets the parallel version
 * partition the starts across threads and still produce the same contigs.
 */

#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define MAXK        256
#define TABLE_SIZE  20011          /* prime, comfortably > 10000 k-mers */

typedef struct entry {
    char          kmer[MAXK];      /* k-mer, NUL terminated */
    int           klen;
    char          left;            /* backward extension, 'F' = none */
    char          right;           /* forward  extension, 'F' = none */
    int           visited;         /* traversal mark */
    struct entry *next;            /* separate chaining */
} entry_t;

static entry_t  *table[TABLE_SIZE];
static entry_t **uniq;             /* unique records, first-seen order */
static int       nunique = 0;
static int       nslots  = 0;

static unsigned int kmer_hash(const char *s, int k)
{
    unsigned int h = 5381u;
    int i;
    for (i = 0; i < k; i++)
        h = h * 33u + (unsigned char)s[i];
    return h % TABLE_SIZE;
}

/* Insert a k-mer. A repeated k-mer is flagged as a repeat by clearing both of
 * its extensions on the record that already represents it. */
static entry_t *insert_kmer(const char *kmer, int k, char left, char right)
{
    unsigned int b = kmer_hash(kmer, k);
    entry_t *e;

    for (e = table[b]; e != NULL; e = e->next)
        if (e->klen == k && memcmp(e->kmer, kmer, (size_t)k) == 0) {
            e->left  = 'F';
            e->right = 'F';
            return e;
        }

    e = (entry_t *) calloc(1, sizeof(entry_t));
    if (e == NULL) {
        fprintf(stderr, "out of memory\n");
        exit(1);
    }
    memcpy(e->kmer, kmer, (size_t)k);
    e->kmer[k] = '\0';
    e->klen    = k;
    e->left    = left;
    e->right   = right;
    e->next    = table[b];
    table[b]   = e;

    if (nunique == nslots) {
        nslots = nslots ? nslots * 2 : 1024;
        uniq = (entry_t **) realloc(uniq, (size_t)nslots * sizeof(entry_t *));
        if (uniq == NULL) {
            fprintf(stderr, "out of memory\n");
            exit(1);
        }
    }
    uniq[nunique++] = e;
    return e;
}

static entry_t *find_kmer(const char *kmer, int k)
{
    entry_t *e;
    for (e = table[kmer_hash(kmer, k)]; e != NULL; e = e->next)
        if (e->klen == k && memcmp(e->kmer, kmer, (size_t)k) == 0)
            return e;
    return NULL;
}

int main(int argc, char **argv)
{
    const char *inpath  = (argc > 1) ? argv[1] : "test";
    const char *outpath = (argc > 2) ? argv[2] : "/app/serial.out";
    FILE  *in, *out;
    char   line[4096];
    char   kmer[MAXK];
    char  *contig;
    size_t contig_cap;
    int    k = -1;
    int    i;
    long   ncontigs = 0;

    in = fopen(inpath, "r");
    if (in == NULL) {
        perror(inpath);
        return 1;
    }
    if (strcmp(outpath, "-") == 0) {
        out = stdout;
    } else {
        out = fopen(outpath, "w");
        if (out == NULL && strcmp(outpath, "/app/serial.out") == 0)
            out = fopen("serial.out", "w");
        if (out == NULL) {
            perror(outpath);
            return 1;
        }
    }

    /* ---- construction: hash every unique k-mer into the graph ---------- */
    while (fgets(line, sizeof line, in) != NULL) {
        char *tab;
        char  left, right;
        int   klen, t;

        line[strcspn(line, "\r\n")] = '\0';
        if (line[0] == '\0')
            continue;

        tab = strchr(line, '\t');
        if (tab == NULL)
            continue;                   /* malformed line */
        klen = (int)(tab - line);
        if (klen <= 0 || klen >= MAXK)
            continue;
        if (k < 0)
            k = klen;                   /* k is fixed by the data */
        else if (klen != k)
            continue;

        t     = (int)(tab - line) + 1;
        left  = (line[t]     != '\0') ? line[t]     : 'F';
        right = (line[t + 1] != '\0') ? line[t + 1] : 'F';

        memcpy(kmer, line, (size_t)klen);
        kmer[klen] = '\0';
        insert_kmer(kmer, klen, left, right);
    }
    fclose(in);
    if (k < 0) {
        fprintf(stderr, "serial: no k-mers read from %s\n", inpath);
        return 1;
    }

    /* ---- traversal: extend every walk start into a contig -------------- */
    contig_cap = (size_t)nunique + (size_t)k + 2;
    contig = (char *) malloc(contig_cap);
    if (contig == NULL) {
        fprintf(stderr, "out of memory\n");
        return 1;
    }

    for (i = 0; i < nunique; i++) {
        entry_t *cur = uniq[i];
        entry_t *nx;
        char     probe[MAXK];
        int      len, is_start = 1;

        if (cur->visited)
            continue;

        if (cur->left != 'F') {
            probe[0] = cur->left;
            memcpy(probe + 1, cur->kmer, (size_t)(cur->klen - 1));
            probe[cur->klen] = '\0';
            nx = find_kmer(probe, cur->klen);
            if (nx != NULL && nx->right == cur->left)
                is_start = 0;           /* a real incoming edge exists */
        }
        if (!is_start)
            continue;

        cur->visited = 1;
        len = cur->klen;
        memcpy(contig, cur->kmer, (size_t)cur->klen);

        while (cur->right != 'F') {
            probe[0] = '\0';
            memcpy(probe, cur->kmer + 1, (size_t)(cur->klen - 1));
            probe[cur->klen - 1] = cur->right;
            probe[cur->klen]     = '\0';

            nx = find_kmer(probe, cur->klen);
            if (nx == NULL || nx->visited)
                break;                  /* dead end or already emitted */

            nx->visited = 1;
            contig[len++] = cur->right;
            cur = nx;
        }

        contig[len] = '\0';
        fputs(contig, out);
        fputc('\n', out);
        ncontigs++;
    }

    free(contig);
    if (out != stdout)
        fclose(out);
    fprintf(stderr, "serial: %d unique k-mers (k=%d), %ld contigs -> %s\n",
            nunique, k, ncontigs, outpath);
    return 0;
}
