import re

with open('/usr/local/src/klee/lib/Solver/STPSolver.cpp', 'r') as f:
    content = f.read()

# 1. Guard the RISS enum value - change from 4 values to 3
content = content.replace(
    'enum SAT { MINISAT, SIMPLEMINISAT, CRYPTOMINISAT, RISS };',
    'enum SAT { MINISAT, SIMPLEMINISAT, CRYPTOMINISAT };'
)
content = content.replace(
    'const std::array<std::string, 4> SATNames{"MiniSat", "simplifying MiniSat",\n                                          "CryptoMiniSat", "RISS"};',
    'const std::array<std::string, 3> SATNames{"MiniSat", "simplifying MiniSat",\n                                          "CryptoMiniSat"};'
)

# 2. Guard the clEnumValN for RISS
content = content.replace(
    'clEnumValN(SAT::RISS, "riss", SATNames[SAT::RISS])),',
    'clEnumValN(SAT::CRYPTOMINISAT, "cryptominisat",\n                                SATNames[SAT::CRYPTOMINISAT])),'
)

# 3. Guard the case SAT::RISS block
old_case = '''  case SAT::RISS: {
    SATSolverAvailable = vc_useRiss(vc);
    break;
  }'''
new_case = '''  case SAT::RISS: {
    SATSolverAvailable = false; // Riss not available in this STP version
    break;
  }'''
content = content.replace(old_case, new_case)

# 4. Guard the vc_isUsingRiss check
content = content.replace(
    'else if (vc_isUsingRiss(vc))\n    SATName = SATNames[SAT::RISS];',
    '// Riss not available in this STP version'
)

with open('/usr/local/src/klee/lib/Solver/STPSolver.cpp', 'w') as f:
    f.write(content)

print("Patched successfully")
