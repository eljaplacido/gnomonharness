[approval] bash: python3 -c "
import sys

with open('/root/.bashrc', 'r') as f:
    lines = f.readlines()

# Check if the KLEE block is already present
klee_marker = '# >>> KLEE (LLVM 16 + STP, no uClibc) >>>'
if any(klee_marker in line for line in lines):
    print('KLEE block already present, skipping insert')
    sys.exit(0)

# Find the interactive guard: line 6 is '[ -z \"\$PS1\" ] && return'
# We insert just before that line
insert_idx = None
for i, line in enumerate(lines):
    if '[ -z \"\$PS1\" ] && return' in line:
        insert_idx = i
        break

if insert_idx is None:
    print('ERROR: could not find interactive guard')
    sys.exit(1)

klee_block = '''# >>> KLEE (LLVM 16 + STP, no uClibc) >>>
export KLEE_INSTALL_DIR=/usr/local
case \":\$PATH:\" in *:/usr/local/bin:*) ;; *) PATH=/usr/local/bin:\$PATH ;; esac
case \":\$CPATH:\" in *:/usr/local/include:*) ;; *) CPATH=/usr/local/include\${CPATH:+:\$CPATH} ;; esac
export PATH CPATH
# <<< KLEE <<<
'''

lines.insert(insert_idx, klee_block)

with open('/root/.bashrc', 'w') as f:
    f.writelines(lines)

print(f'Inserted KLEE block at line {insert_idx + 1}')
"
