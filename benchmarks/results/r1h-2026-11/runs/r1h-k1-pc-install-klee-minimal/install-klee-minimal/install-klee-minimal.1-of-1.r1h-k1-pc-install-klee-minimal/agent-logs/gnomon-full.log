#!/bin/sh
exec >>/root/klee-build/stp-build.log 2>&1
set -x
cd /root/klee-build/stp || exit 1
# Fix: system minisat 2.2.1 uses macros l_True/l_False/l_Undef (not enum values),
# so the Minisat:: namespace prefix breaks compilation.
sed -i 's/(Minisat::lbool)Minisat::l_True/(Minisat::lbool)l_True/g; s/(Minisat::lbool)Minisat::l_False/(Minisat::lbool)l_False/g; s/(Minisat::lbool)Minisat::l_Undef/(Minisat::lbool)l_Undef/g' lib/Sat/MinisatCore.cpp lib/Sat/SimplifyingMinisat.cpp
mkdir -p build && cd build || exit 1
cmake -G Ninja \
  -DCMAKE_BUILD_TYPE=Release \
  -DCMAKE_INSTALL_PREFIX=/usr/local \
  -DUSE_CRYPTOMINISAT=OFF \
  -DMINISAT_LIB=/lib/libminisat.so \
  -DMINISAT_INCLUDE_DIR=/usr/include \
  -DENABLE_PYTHON_INTERFACE=OFF \
  -DBUILD_SHARED_LIBS=ON \
  .. || { echo STP_CONFIGURE_FAILED; exit 1; }
ninja -j20 || { echo STP_BUILD_FAILED; exit 1; }
ninja install || { echo STP_INSTALL_FAILED; exit 1; }
ldconfig
echo STP_OK
