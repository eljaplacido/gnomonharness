import re
from datetime import date

# ---------- Turtle parsing ----------
def parse_turtle(path):
    src = open(path, encoding='utf-8').read()
    src = re.sub(r'#[^\n]*', '', src)
    tok_re = re.compile(r'''"(?:[^"\\]|\\.)*"(?:\^\^[A-Za-z0-9_:]+)?|<[^>]*>|@prefix|[;,.\[\]]|[^\s;,.\[\]]+''')
    toks = tok_re.findall(src)
    prefixes, i = {}, 0
    while i < len(toks):
        if toks[i].endswith(':') and i+1 < len(toks) and toks[i+1].startswith('<'):
            prefixes[toks[i][:-1]] = toks[i+1][1:-1]; i += 3
        else:
            break
    body = toks[i:]
    def exp(t):
        if t.startswith('<'): return t[1:-1]
        if ':' in t:
            p, _, l = t.partition(':')
            return prefixes.get(p, p+':') + l
        return t
    def term(t):
        if t.startswith('"'):
            m = re.match(r'^"(.*?)"(?:\^\^([A-Za-z0-9_:]+))?$', t, re.S)
            v, dt = m.group(1), m.group(2)
            if dt:
                dt = exp(dt)
                if dt.endswith('#date'):
                    return ('lit', date(*map(int, v.split('-'))), dt)
                return ('lit', v, dt)
            return ('lit', v, None)
        return ('iri', exp(t))
    triples = set()
    idx = 0
    while idx < len(body):
        if body[idx] in ('.',): idx += 1; continue
        subj = exp(body[idx]); idx += 1
        while idx < len(body) and body[idx] != '.':
            if body[idx] == ';': idx += 1; continue
            pred = exp(body[idx]); idx += 1
            while True:
                triples.add((subj, pred, term(body[idx]))); idx += 1
                if idx < len(body) and body[idx] == ',':
                    idx += 1; continue
                break
        idx += 1
    return triples

# ---------- SPARQL query parsing ----------
class Group:
    def __init__(self): self.items = []
class Subquery:
    def __init__(self): self.items=[]; self.groupby=[]; self.having=None; self.proj=[]

def strip_comments(s):
    out=[]; i=0; instr=False
    while i < len(s):
        c=s[i]
        if instr:
            out.append(c)
            if c=='\\': out.append(s[i+1]); i+=2; continue
            if c=='"': instr=False
            i+=1; continue
        if c=='"': instr=True; out.append(c); i+=1; continue
        if c=='#':
            while i < len(s) and s[i] != '\n': i+=1
            continue
        out.append(c); i+=1
    return ''.join(out)

QT = re.compile(r'''"(?:[^"\\]|\\.)*"(?:\^\^[A-Za-z0-9_:]+)?|<[^>]*>|[{}()\[\]]|[^\s{}()\[\]]+''')

def parse_query(path):
    src = strip_comments(open(path, encoding='utf-8').read())
    toks = QT.findall(src)
    prefixes, i = {}, 0
    while i < len(toks) and toks[i].upper() == 'PREFIX':
        prefixes[toks[i+1][:-1]] = toks[i+2][1:-1]; i += 3
    body = toks[i:]
    # top-level: SELECT ... WHERE { ... } GROUP BY ... ORDER BY ...
    assert body[0].upper() == 'SELECT', body[:5]
    j = body.index('{')
    head = body[:j]
    sel = parse_select_list(head[1:])
    grp, k = parse_group(body, j+1, prefixes)
    tail = body[k:]
    gb, having, ob = [], None, []
    if 'GROUP' in [t.upper() for t in tail]:
        m = [n for n,t in enumerate(tail) if t.upper()=='GROUP'][0]
        gb = [t for t in tail[m+2:] if t.startswith('?')]
    return prefixes, sel, grp, gb

def parse_select_list(toks):
    items=[]; cur=[]
    depth=0
    for t in toks:
        if t=='(': depth+=1
        if t==')': depth-=1
        if t==',' and depth==0:
            items.append(cur); cur=[]; continue
        cur.append(t)
    if cur: items.append(cur)
    return items

def parse_group(toks, i, prefixes):
    """toks[i-1] == '{' ; returns (Group, index after '}')"""
    g = Group()
    while toks[i] != '}':
        t = toks[i]
        u = t.upper()
        if u == 'FILTER':
            if toks[i+1].upper() == 'EXISTS' and toks[i+2] == '{':
                sub, i = parse_group(toks, i+3, prefixes)
                g.items.append(('exists', sub, True))
            elif toks[i+1].upper() == 'NOT' and toks[i+2].upper() == 'EXISTS':
                sub, i = parse_group(toks, i+4, prefixes)
                g.items.append(('exists', sub, False))
            else:
                assert toks[i+1] == '('
                depth=0; j=i+1; expr=[]
                while True:
                    if toks[j]=='(': depth+=1
                    if toks[j]==')':
                        depth-=1
                        if depth==0: break
                    expr.append(toks[j]); j+=1
                g.items.append(('filter', expr))
                i = j+1
        elif u == 'SELECT':
            sq = Subquery()
            j = i+1
            k = j
            while toks[k] != '{': k+=1
            sq.proj = parse_select_list(toks[j:k])
            sub, i = parse_group(toks, k+1, prefixes)
            sq.items = sub.items
            while i < len(toks) and toks[i] != '}':
                uu = toks[i].upper()
                if uu == 'GROUP':
                    i += 2
                    while toks[i] != '}' and toks[i].upper() not in ('HAVING','ORDER'):
                        if toks[i].startswith('?'): sq.groupby.append(toks[i][1:])
                        i += 1
                elif uu == 'HAVING':
                    assert toks[i+1] == '('
                    depth=0; jj=i+1; e=[]
                    while True:
                        if toks[jj]=='(': depth+=1
                        if toks[jj]==')':
                            depth-=1
                            if depth==0: break
                        e.append(toks[jj]); jj+=1
                    sq.having = e; i = jj+1
                elif uu == 'ORDER':
                    while toks[i] != '}': i += 1
                else:
                    i += 1
            g.items.append(('subquery', sq))
            i += 1  # skip '}'
        else:
            # triple pattern: s p o .
            s = toks[i]; p = toks[i+1]; o = toks[i+2]
            assert toks[i+3] == '.', toks[i:i+4]
            g.items.append(('triple', s, p, o))
            i += 4
    return g, i+1
