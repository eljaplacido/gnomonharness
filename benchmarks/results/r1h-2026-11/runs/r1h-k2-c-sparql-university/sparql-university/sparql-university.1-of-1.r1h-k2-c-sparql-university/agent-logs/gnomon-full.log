    while idx < len(toks) and toks[idx] != '.':
        if toks[idx] == ';':
            idx += 1; continue
        pred = expand(toks[idx]); idx += 1
        while True:
            t = toks[idx]; idx += 1
            obj = lit(t) if t.startswith('"') else ('iri', expand(t))
            triples.add((subj, pred, obj))
            if idx < len(toks) and toks[idx] == ',':
                idx += 1; continue
            break
    return idx + 1

