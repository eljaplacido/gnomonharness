    keys = []
    for item in sq.proj:
        if item[0].startswith('?'):
            keys.append(item[0][1:])
        else:
            txt = ' '.join(item)
            m = re.search(r'AS\\s+(\\?\\w+)', txt)
            keys.append(m.group(1)[1:])
    groups = {}
    for r in rows:
