        groups.setdefault(k, []).append(r)
    out = []
    for k, grp in groups.items():
        b = {}
        for g, kv in zip(sq.groupby, k):
            b[g] = grp[0].get(g)
        count_val = None
        for item in sq.proj:
            if item[0].startswith('?'):
                continue
            txt = ' '.join(item)
            target = re.search(r'AS\\s+(\\?\\w+)', txt).group(1)[1:]
            fn = re.search(r'\\b(GROUP_CONCAT|COUNT|SUM|AVG|MIN|MAX)\\b', txt).group(1)
            inner = re.search(r'\\(\\s*(?:DISTINCT\\s+)?(\\?\\w+)', txt).group(1)[1:]
            distinct = 'DISTINCT' in txt.upper()
            vals = [r.get(inner) for r in grp]
            if distinct:
                seen = []
                for v in vals:
                    if v not in seen: seen.append(v)
                vals = seen
            if fn == 'COUNT':
                count_val = len(vals)
                b[target] = count_val
            elif fn == 'GROUP_CONCAT':
                sep = ', '
                sm = re.search(r'separator\\s*=\\s*"(.*?)"', txt, re.I)
                if sm: sep = sm.group(1)
                b[target] = sep.join(sorted(valstr(v) for v in vals if v is not None))
            else:
                raise Exception('agg ' + fn)
        if sq.having:
            hb = dict(b)
            if count_val is not None:
                hb['__count__'] = count_val
            if not truth(eval_expr(sq.having, hb, px)):
                continue
        out.append(b)
    return out

'''
