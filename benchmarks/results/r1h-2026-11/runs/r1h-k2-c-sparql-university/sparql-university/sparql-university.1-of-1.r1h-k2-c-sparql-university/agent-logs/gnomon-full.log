# ---------- evaluation ----------
def match_term(t, s, p, o, triples, px):
    """t is token string; returns list of binding dicts (or [] / [{}])."""
    out = []
    if t.startswith('?'):
        v = t[1:]
        for (ts, tp, to) in triples:
            out.append({v: (ts, tp, to)})
        return out
    return None

def triple_matches(pat, triples, px):
    s, p, o = pat
    def is_var(x): return x.startswith('?')
    def term_val(x):
        if x.startswith('"'): return None
        return exp_iri(x, px)
    res = []
    for (ts, tp, to) in triples:
        if not is_var(s) and term_val(s) != ts: continue
        if not is_var(p) and term_val(p) != tp: continue
        if not is_var(o):
            if o.startswith('"'):
                m = re.match(r'^"(.*?)"(?:\^\^([A-Za-z0-9_:]+))?$', o, re.S)
                if to != ('lit', m.group(1), exp_iri(m.group(2), px) if m.group(2) else None):
                    continue
            elif term_val(o) != to[1] or to[0] != 'iri':
                continue
        res.append((ts, tp, to))
    return res

def join(bindings, pat, triples, px):
    s, p, o = pat
    def is_var(x): return x.startswith('?')
    out = []
    for b in bindings:
        for (ts, tp, to) in triple_matches(pat, triples, px):
            nb = dict(b); ok = True
            for tok, val in ((s, ts), (p, tp), (o, to)):
                if is_var(tok):
                    name = tok[1:]
                    if name in nb and nb[name] != val:
                        ok = False; break
                    nb[name] = val
            if ok: out.append(nb)
    return out

def eval_group(g, bindings, triples, px):
    for item in g.items:
        kind = item[0]
        if kind == 'triple':
            bindings = join(bindings, item[1:], triples, px)
        elif kind == 'filter':
            bindings = [b for b in bindings if truth(eval_expr(item[1], b, px))]
        elif kind == 'exists':
            sub, positive = item[1], item[2]
            keep = []
            for b in bindings:
                r = eval_group(sub, [dict(b)], triples, px)
                if bool(r) == positive: keep.append(b)
            bindings = keep
        elif kind == 'subquery':
            sq = item[1]
            rows = eval_group(Group_from(sq.items), [{}], triples, px)
            rows = aggregate(sq, rows, px)
            bindings = join_bindings(bindings, rows)
    return bindings

def Group_from(items):
    g = Group(); g.items = items; return g

def join_bindings(left, right):
    out = []
    for a in left:
        for b in right:
            nb = dict(a); ok = True
            for k, v in b.items():
                if k in nb and nb[k] != v: ok = False; break
                nb[k] = v
            if ok: out.append(nb)
    return out

def valstr(v):
    if isinstance(v, tuple) and v[0] == 'iri': return v[1]
    if isinstance(v, tuple) and v[0] == 'lit': return v[1]
    if isinstance(v, date): return v.isoformat()
    return str(v)

def aggregate(sq, rows, px):
    # determine projection: plain vars and (AGG(...) AS ?v)
    keys = []
    for item in sq.proj:
        if item[0].startswith('?'):
            keys.append(item[0][1:])
        else:
            m = re.search(r'AS\s+(\?\w+)\s*\)\s*$', ' '.join(item))
            keys.append(m.group(1)[1:])
    groups = {}
    for r in rows:
        k = tuple(valstr(r.get(g)) for g in sq.groupby)
        groups.setdefault(k, []).append(r)
    out = []
    for k, grp in groups.items():
        b = {}
        for g, kv in zip(sq.groupby, k):
            b[g] = grp[0].get(g)
        for item in sq.proj:
            if item[0].startswith('?'):
                continue
            txt = ' '.join(item)
            m = re.search(r'AS\s+(\?\w+)\s*\)\s*$', txt)
            target = m.group(1)[1:]
            fn = re.match(r'(\w+)\s*\(', txt).group(1).upper()
            inner = re.search(r'\(\s*(?:DISTINCT\s+)?(\?\w+)', txt).group(1)[1:]
            distinct = 'DISTINCT' in txt.upper().split('AS')[0]
            vals = [r.get(inner) for r in grp]
            if distinct:
                seen = []; 
                for v in vals:
                    if v not in seen: seen.append(v)
                vals = seen
            if fn == 'COUNT':
                b[target] = len(vals)
            elif fn == 'GROUP_CONCAT':
                sep = ', '
                sm = re.search(r'separator\s*=\s*"(.*?)"', txt, re.I)
                if sm: sep = sm.group(1)
                b[target] = sep.join(sorted(valstr(v) for v in vals if v is not None))
            else:
                raise Exception('agg ' + fn)
        if sq.having:
            if not truth(eval_expr(sq.having, b, px)):
                continue
        out.append(b)
    return out

def run(ttl, qpath):
    triples = parse_turtle(ttl)
    px, sel, grp, gb = parse_query(qpath)
    rows = eval_group(grp, [{}], triples, px)
    class SQ: pass
    sq = SQ(); sq.proj = sel; sq.groupby = gb; sq.having = None
    rows = aggregate(sq, rows, px)
    for r in sorted(rows, key=lambda b: valstr(b.get('professorName'))):
        print({k: valstr(v) for k, v in r.items() if k in ('professorName', 'countries')})
    return rows

if __name__ == '__main__':
    import sys
    run('/app/university_graph.ttl', sys.argv[1] if len(sys.argv) > 1 else '/app/solution.sparql')
