# ---------- expression evaluation ----------
ET = re.compile(r'''"(?:[^"\\]|\\.)*"(?:\^\^[A-Za-z0-9_:]+)?|<=|>=|!=|&&|\|\||[()=<>,;]|[^\s()=<>,;&|]+''')

class P:
    def __init__(self, toks, prefixes):
        self.t = toks; self.i = 0; self.px = prefixes
    def peek(self): return self.t[self.i] if self.i < len(self.t) else None
    def next(self): self.i += 1; return self.t[self.i-1]
    def or_(self):
        v = self.and_()
        while self.peek() == '||':
            self.next(); r = self.and_()
            v = truth(v) or truth(r)
        return v
    def and_(self):
        v = self.rel()
        while self.peek() == '&&':
            self.next(); r = self.rel()
            v = truth(v) and truth(r)
        return v
    def rel(self):
        v = self.add()
        p = self.peek()
        if p in ('=', '!=', '<=', '>=', '<', '>'):
            self.next(); r = self.add()
            if p == '=': return v == r
            if p == '!=': return v != r
            if v is None or r is None: return None
            return {'<': v < r, '>': v > r, '<=': v <= r, '>=': v >= r}[p]
        if p is not None and p.upper() == 'IN':
            self.next(); assert self.next() == '('
            vals = []
            while self.peek() != ')':
                if self.peek() == ',': self.next(); continue
                vals.append(self.add())
            self.next()
            return v in vals
        return v
    def add(self):
        return self.unary()
    def unary(self):
        t = self.next()
        if t == '(':
            v = self.or_(); assert self.next() == ')'; return v
        if t.startswith('?'):
            return ('VAR', t[1:])
        if t.startswith('"'):
            m = re.match(r'^"(.*?)"(?:\^\^([A-Za-z0-9_:]+))?$', t, re.S)
            v, dt = m.group(1), m.group(2)
            if dt and exp_iri(dt, self.px).endswith('#date'):
                return date(*map(int, v.split('-')))
            return v
        if t.startswith('<') or ':' in t:
            return ('IRI', exp_iri(t, self.px))
        if re.match(r'^-?\d+(\.\d+)?$', t):
            return float(t) if '.' in t else int(t)
        # function call
        if self.peek() == '(':
            self.next(); args = []
            while self.peek() != ')':
                if self.peek() == ',': self.next(); continue
                args.append(self.add())
            self.next()
            fn = t.upper()
            if fn == 'STR': return ('STR', args[0])
            if fn == 'REGEX':
                s = args[0]
                s = s[1] if isinstance(s, tuple) and s[0] == 'STR' else str(s)
                flags = 0
                if len(args) > 2 and isinstance(args[2], str) and 'i' in args[2]:
                    flags = re.I
                return re.search(args[1], s, flags) is not None
            if fn in ('COUNT', 'GROUP_CONCAT'):
                return ('AGG', fn, args)
            raise Exception('unknown function ' + t)
        raise Exception('unparsed token ' + repr(t))

def exp_iri(t, px):
    if t.startswith('<'): return t[1:-1]
    if ':' in t:
        p, _, l = t.partition(':')
        return px.get(p, p+':') + l
    return t

def truth(v):
    return bool(v)

def resolve(v, b):
    if isinstance(v, tuple):
        if v[0] == 'VAR':
            return b.get(v[1])
        if v[0] == 'STR':
            r = resolve(v[1], b)
            return str(r) if r is not None else None
        if v[0] == 'IRI':
            return v[1]
    return v

def eval_expr(toks, b, px):
    p = P(toks, px)
    v = p.or_()
    return resolve(v, b)
