        prefixes[tmp[i][:-1]] = tmp[i+1][1:-1]; i += 3
    else:
        break
body = tmp[i:]

def expand(t):
    if t.startswith('<'):
        return t[1:-1]
    if ':' in t:
        p, _, local = t.partition(':')
        return prefixes.get(p, p+':') + local
    return t

def lit(t):
    m = re.match(r'^"(.*?)"(?:\^\^([A-Za-z0-9_:]+))?$', t, re.S)
    val = m.group(1)
    if m.group(2) and m.group(2).endswith('date'):
        return ('date', date(*map(int, val.split('-'))))
    return ('str', val)

