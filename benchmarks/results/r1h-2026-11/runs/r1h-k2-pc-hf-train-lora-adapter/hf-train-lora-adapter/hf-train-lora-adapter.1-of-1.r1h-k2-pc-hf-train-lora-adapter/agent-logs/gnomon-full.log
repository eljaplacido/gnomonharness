import json, statistics

with open('/app/data/train.json') as f:
    train = json.load(f)
with open('/app/data/val.json') as f:
    val = json.load(f)

def analyze(data, label):
    n = len(data)
    keys = set()
    for s in data:
        keys.update(s.keys())
    print(f"=== {label} ===")
    print(f"Number of samples: {n}")
    print(f"Keys: {sorted(keys)}")

    # answer distribution
    ans_counts = {}
    for s in data:
        a = s['answer']
        ans_counts[a] = ans_counts.get(a, 0) + 1
    print(f"Answer distribution: {dict(sorted(ans_counts.items()))}")

    # is_few_shot count
    few_shot = sum(1 for s in data if s.get('is_few_shot') == 1)
    print(f"Samples with is_few_shot==1: {few_shot}")

    # word counts
    word_counts = []
    for s in data:
        text = s['question'] + ' ' + ' '.join(s['options'])
        wc = len(text.split())
        word_counts.append(wc)
    print(f"Word count stats (question + all options): min={min(word_counts)}, median={statistics.median(word_counts)}, max={max(word_counts)}")

    # check every sample has exactly 4 options
    all_4 = all(len(s['options']) == 4 for s in data)
    print(f"Every sample has exactly 4 options: {all_4}")
    if not all_4:
        for s in data:
            if len(s['options']) != 4:
                print(f"  id={s['id']}, options count={len(s['options'])}")

    # samples with options NOT formatted like "A. text"
    import re
    pattern = re.compile(r'^[A-D]\. ')
    bad_samples = []
    for s in data:
        for opt in s['options']:
            if not pattern.match(opt):
                bad_samples.append((s['id'], opt))
                break
    print(f"Samples with non-standard option formatting: {len(bad_samples)}")
    if bad_samples:
        for sid, opt in bad_samples[:5]:
            print(f"  id={sid}, option='{opt}'")

    # print one full raw sample
    print(f"\nFull raw sample (first):")
    print(json.dumps(data[0], indent=2))

    # val counterpart of same id
    val_by_id = {s['id']: s for s in val}
    if data[0]['id'] in val_by_id:
        print(f"\nVal counterpart of id={data[0]['id']}:")
        print(json.dumps(val_by_id[data[0]['id']], indent=2))
    else:
        print(f"\nNo val counterpart for id={data[0]['id']}")

analyze(train, "TRAIN")
print()
analyze(val, "VAL")
