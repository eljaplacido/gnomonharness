import json, re, torch
from transformers import AutoTokenizer, AutoModelForCausalLM

torch.set_num_threads(20)
LETTERS = ["A","B","C","D"]
val = json.load(open("/app/data/val.json"))
train = json.load(open("/app/data/train.json"))
tok = AutoTokenizer.from_pretrained("openai-community/gpt2")
model = AutoModelForCausalLM.from_pretrained("openai-community/gpt2").eval()

OPT = re.compile(r"^\(?([A-Da-d])[\.\)\:]\s*(.*)$", re.S)
def parse(options):
    out=[]
    for i,raw in enumerate(options):
        m = OPT.match(raw.strip())
        out.append((LETTERS[i], m.group(2).strip() if m else raw.strip()))
    return out

TEMPLATES = {
 "dot_lines":       ("Question: {q}", "{l}. {t}", "\n", "\nAnswer:", False),
 "dot_lines_space": ("Question: {q}", "{l}. {t}", "\n", "\nAnswer: ", True),
 "paren_lines":     ("Question: {q}", "{l}) {t}", "\n", "\nAnswer:", False),
 "paren_inline":    ("Question: {q}", "{l}) {t}", " ", "\nAnswer:", False),
 "bare":            ("{q}", "{l}) {t}", "\n", "\n", False),
 "instruct":        ("Answer the following multiple choice question about biology.\n\nQuestion: {q}", "{l}. {t}", "\n", "\nAnswer:", False),
 "dot_space2":      ("Question: {q}", "{l}. {t}", "\n", "\nAnswer: ", True),
}
def prompt(q, opts, name):
    head, fmt, sep, suf, _ = TEMPLATES[name]
    return head.format(q=q) + "\n" + sep.join(fmt.format(l=l,t=t) for l,t in opts) + suf

@torch.no_grad()
def acc(split, name):
    ok=0
    _,_,_,_,trail = TEMPLATES[name]
    lead = "" if trail else " "
    cand = {l: tok(lead+l, add_special_tokens=False)["input_ids"][0] for l in LETTERS}
    for s in split:
        p = prompt(s["question"], parse(s["options"]), name)
        ids = tok(p, add_special_tokens=False, return_tensors="pt")
        lg = model(**ids).logits[0,-1]
        pred = max(LETTERS, key=lambda l: lg[cand[l]].item())
        ok += int(pred == s["answer"])
    return ok/len(split)

for name in TEMPLATES:
    print(f"{name:18s} val={acc(val,name):.4f}  train={acc(train,name):.4f}", flush=True)
print("val letter histogram:", {l: sum(1 for s in val if s['answer']==l) for l in LETTERS})
for name in TEMPLATES:
    print(name, " => ", repr(prompt(val[0]['question'], parse(val[0]['options']), name)))
