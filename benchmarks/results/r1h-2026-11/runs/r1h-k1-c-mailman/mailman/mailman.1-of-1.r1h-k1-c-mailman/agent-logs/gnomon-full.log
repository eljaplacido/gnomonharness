"""Extra checks: leave flow and posting to all subscribers."""
import mailbox, os, smtplib, subprocess, time
from email.mime.text import MIMEText
from mailman.core.initialize import initialize
from mailman.interfaces.listmanager import IListManager
from zope.component import getUtility

D = 'local.edu'
CONFIG = '/etc/mailman3/mailman.cfg'
initialize(CONFIG)
mlist = getUtility(IListManager).get(f'reading-group@{D}')
assert mlist


def add_user(u):
    subprocess.run(['useradd', u], check=True, capture_output=True)


def send(frm, to, subject='', body=''):
    m = MIMEText(body)
    m['Subject'] = subject
    m['From'] = frm
    m['To'] = to
    with smtplib.SMTP('localhost', 25) as s:
        s.send_message(m)


def msgs(u):
    p = f'/var/mail/{u}'
    return list(mailbox.mbox(p)) if os.path.exists(p) else []


def wait(pred, what, tries=20, delay=1):
    for _ in range(tries):
        if pred():
            return
        time.sleep(delay)
    raise AssertionError('timed out: ' + what)


def confirm(u, what):
    def pick():
        for m in reversed(msgs(u)):
            if (m.get('From') or '').startswith('reading-group-confirm') and what in (m.get('Subject') or ''):
                return m
    wait(lambda: pick() is not None, f'{u} confirm {what}')
    send(f'{u}@{D}', pick().get('From'))
    print(f'{u} confirmed {what}')


def member(u):
    return mlist.members.get_member(f'{u}@{D}') is not None


a = os.urandom(8).hex()
b = os.urandom(8).hex()
add_user(a); add_user(b)

# join both
for u in (a, b):
    send(f'{u}@{D}', f'reading-group-join@{D}')
    confirm(u, 'join')
    wait(lambda u=u: member(u), f'{u} is a member')
print('both members:', member(a), member(b))

# post an announcement
subj = 'Announcement ' + os.urandom(4).hex()
send(f'{a}@{D}', f'reading-group@{D}', subj, 'The reading group meets Thursday.')
for u in (a, b):
    wait(lambda u=u: any(subj in (m.get('Subject') or '') for m in msgs(u)),
         f'{u} received the announcement')
print('announcement delivered to both subscribers')

# leave as b
send(f'{b}@{D}', f'reading-group-leave@{D}')
wait(lambda: not member(b), f'{b} left after confirm') if False else None
time.sleep(3)
assert member(b), 'b left before confirming'
confirm(b, 'leave')
wait(lambda: not member(b), f'{b} left')
assert member(a), 'a should still be a member'
print('leave flow works; b removed, a retained')

# post again: a gets it, b does not
subj2 = 'After ' + os.urandom(4).hex()
send(f'{a}@{D}', f'reading-group@{D}', subj2, 'Second announcement.')
wait(lambda: any(subj2 in (m.get('Subject') or '') for m in msgs(a)), f'{a} got post 2')
time.sleep(3)
assert not any(subj2 in (m.get('Subject') or '') for m in msgs(b)), 'b should not get post 2'
print('post no longer reaches unsubscribed user')
print('ALL EXTRA CHECKS PASSED')
PYEOF
