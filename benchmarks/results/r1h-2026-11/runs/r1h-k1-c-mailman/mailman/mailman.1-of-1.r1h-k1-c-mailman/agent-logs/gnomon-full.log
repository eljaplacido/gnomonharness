[approval] bash: cat > /tmp/mailman.cfg.new <<'CFGEOF'
# GNU Mailman 3 configuration for the local.edu reading group.
#
# Layout: Debian/FHS (postfix + LMTP).  Mailman receives list mail from
# Postfix over LMTP on 127.0.0.1:8024 and delivers outgoing mail back to
# Postfix on localhost:25, which hands it to the local mailboxes under
# /var/mail.

[mailman]
# The site owner.  Receives messages which must go to a human but cannot be
# sent to a list owner (e.g. a bounce from a list owner).
site_owner: root@local.edu

# Local part used in From: when there is no natural reply recipient.  Mailman
# appends '@' and the list's host name.
noreply_address: noreply

# The default language for this server.
default_language: en

# Membership tests for posting purposes look at these headers.
sender_headers: from from_ reply-to sender

# Mail command processor will ignore mail command lines after this maximum.
email_commands_max_lines: 10

# How long a pending request stays live before eviction from the pending db.
pending_request_life: 3d

# How long files are saved before they are evicted from the cache.
cache_life: 7d

# Callables run early/late in the initialization process.
pre_hook:
post_hook:

# Which paths.* file system layout to use.  You should not change this.
layout: debian

# Can MIME filtered messages be preserved by list owners?
filtered_messages_are_preservable: no

# How to convert text/html parts to text/plain when a list is set to do so.
html_to_plain_text_command: /usr/bin/lynx -dump $filename

# Characters allowed in list names.
listname_chars: [-_.0-9a-z]


[shell]
prompt: >>>
banner: Welcome to the GNU Mailman shell
use_ipython: no
history_file:


[paths.debian]
# Runtime data root.
var_dir: /var/lib/mailman3
# Mailman queue files.
queue_dir: $var_dir/queue
# Directory containing the Mailman 'runner' and 'master' commands.
bin_dir: /usr/lib/mailman3/bin
# All list-specific data.
list_data_dir: $var_dir/lists
# Directory where log files go.
log_dir: /var/log/mailman3
# Directory for system-wide locks.
lock_dir: $var_dir/locks
# Directory for system-wide data.
data_dir: $var_dir/data
# Cache files.
cache_dir: $var_dir/cache
# Directory for configuration files and such.
etc_dir: /etc/mailman3
# Directory containing Mailman plugins.
ext_dir: $var_dir/ext
# Directory where the default IMessageStore puts its messages.
messages_dir: $var_dir/messages
# Directory for archive backends to store their messages in.
archive_dir: $var_dir/archives
# Root directory for site-specific template override files.
template_dir: $var_dir/templates
# PID file for the master runner.
pid_file: /run/mailman3/master.pid
# Lock file.
lock_file: $lock_dir/master.lck


[database]
# SQLite is plenty for one reading group list.
class: mailman.database.sqlite.SQLiteDatabase
url: sqlite:///$DATA_DIR/mailman.db
debug: no


[logging.debian]
format: %(asctime)s (%(process)d) %(message)s
datefmt: %b %d %H:%M:%S %Y
propagate: no
level: info
path: mailman.log


[webservice]
hostname: localhost
port: 8001
use_https: no
show_tracebacks: no
api_version: 3.1
admin_user: restadmin
admin_pass: change-this-admin-password


[mta]
# Postfix hands list traffic to Mailman over LMTP.
incoming: mailman.mta.postfix.LMTP
# Mailman hands outgoing list traffic back to Postfix over SMTP.
outgoing: mailman.mta.deliver.deliver
smtp_host: localhost
smtp_port: 25
smtp_user:
smtp_pass:

# Where the LMTP server listens.  Use 127.0.0.1 rather than localhost, since
# Postfix resolves the transport map value itself.
lmtp_host: 127.0.0.1
lmtp_port: 8024

# Where to find the MTA specific configuration (postmap command, table type).
configuration: python:mailman.config.postfix


[archiver.prototype]
enable: no

[archiver.mhonarc]
enable: no

[archiver.mail_archive]
enable: no

[archiver.hyperkitty]
enable: no
CFGEOF
