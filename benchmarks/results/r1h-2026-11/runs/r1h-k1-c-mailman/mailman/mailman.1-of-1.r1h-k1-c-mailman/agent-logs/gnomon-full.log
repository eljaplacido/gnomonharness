#!/bin/sh
# One-shot, idempotent provisioning of the local.edu reading group mailing list.
#
#   postfix (SMTP, local delivery to /var/mail/<user>)
#     -> lmtp:127.0.0.1:8024 (mailman3)
#     -> mailman3 -> smtp:localhost:25 (postfix) -> /var/mail/<user>
#
# Safe to re-run: existing list, members and map files are left alone.
set -eu

CFG=/etc/mailman3/mailman.cfg
LIST=reading-group@local.edu
MM="runuser -u list -- /usr/bin/mailman -C $CFG"

# --- postfix ---------------------------------------------------------------
postconf -e 'mydestination = $myhostname, localhost, localhost.localdomain, localhost, local.edu'
postconf -e 'relay_domains = local.edu'
postconf -e 'transport_maps = hash:/var/lib/mailman3/data/postfix_lmtp'
postconf -e 'local_recipient_maps = proxy:unix:passwd.byname $alias_maps hash:/var/lib/mailman3/data/postfix_lmtp'
postconf -e 'owner_request_special = no'

# --- mailman ---------------------------------------------------------------
chown -R list:list /var/lib/mailman3 /var/log/mailman3 /run/mailman3 2>/dev/null || true

if ! $MM lists 2>/dev/null | grep -qx "$LIST"; then
    $MM create -q -o root@local.edu "$LIST"
fi

# Subscription policy, moderation rules, and other list defaults.
runuser -u list -- /usr/local/sbin/setup-reading-group-list.py

# Regenerate the postfix transport map from the current list set.
$MM aliases >/dev/null

postmap /var/lib/mailman3/data/postfix_lmtp
postmap /var/lib/mailman3/data/postfix_domains

/usr/local/sbin/mailservers-start
postfix reload 2>/dev/null || true

echo "reading group ready: $LIST"
EOF
