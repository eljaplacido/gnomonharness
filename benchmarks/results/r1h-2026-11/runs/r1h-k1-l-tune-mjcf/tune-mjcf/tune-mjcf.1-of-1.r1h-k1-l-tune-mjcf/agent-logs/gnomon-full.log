    ('CG iters=50', base.replace('<compiler autolimits=\"true\"/>', '<compiler autolimits=\"true\"/><option timestep=\"0.002\" integrator=\"Euler\" solver=\"CG\" iterations=\"50\" tolerance=\"1e-08\"/>')),
    ('PGS iters=100', base.replace('<compiler autolimits=\"true\"/>', '<compiler autolimits=\"true\"/><option timestep=\"0.002\" integrator=\"Euler\" solver=\"PGS\" iterations=\"100\" tolerance=\"1e-08\"/>')),
    ('PGS iters=50', base.replace('<compiler autolimits=\"true\"/>', '<compiler autolimits=\"true\"/><option timestep=\"0.002\" integrator=\"Euler\" solver=\"PGS\" iterations=\"50\" tolerance=\"1e-08\"/>')),
]

for name, xml in configs:
    diff = test_correctness_eval_style(xml)
