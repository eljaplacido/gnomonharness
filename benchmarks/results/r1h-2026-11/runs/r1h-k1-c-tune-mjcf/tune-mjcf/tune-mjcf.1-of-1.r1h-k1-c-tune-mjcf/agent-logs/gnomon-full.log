import time, itertools, mujoco, numpy as np, copy

REF = "model_ref.xml"
total = 2.0
fp = mujoco.mjtState.mjSTATE_FULLPHYSICS

def run(model, seed=0, total=total):
    d = mujoco.MjData(model)
    n = int(total/model.opt.timestep)
    rng = np.random.default_rng(seed)
    d.qpos += rng.normal(0,0.01,size=d.qpos.shape)
    mujoco.mj_forward(model,d)
    t=time.perf_counter()
    for _ in range(n): mujoco.mj_step(model,d)
    el = time.perf_counter()-t
    s=np.zeros(mujoco.mj_stateSize(model,fp)); mujoco.mj_getState(model,d,s,fp)
    return el, s

mref = mujoco.MjModel.from_xml_path(REF)
tref=[]; 
sref=None
for seed in range(3):
    el,s = run(mref, seed)
    tref.append(el); sref=s
print("ref times", [round(x,4) for x in tref], "mean", np.mean(tref))
