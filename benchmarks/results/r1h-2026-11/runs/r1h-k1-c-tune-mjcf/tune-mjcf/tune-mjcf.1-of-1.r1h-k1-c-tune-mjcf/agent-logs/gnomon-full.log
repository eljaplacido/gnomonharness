import time, re, mujoco, numpy as np

fp = mujoco.mjtState.mjSTATE_FULLPHYSICS
base = open("model_ref.xml").read()
seeds = [0,1,2]

def build(**opts):
    txt = base
    attrs = " ".join(f'{k}="{v}"' for k,v in opts.items())
    txt = txt.replace('<compiler autolimits="true"/>', f'<compiler autolimits="true"/>\n  <option {attrs}/>')
    return txt

def sim_xml(xml, seed, total=2.0):
    m = mujoco.MjModel.from_xml_string(xml)
    d = mujoco.MjData(m)
    n = int(total/m.opt.timestep)
    rng = np.random.default_rng(seed)
    d.qpos += rng.normal(0,0.01,size=d.qpos.shape)
    mujoco.mj_forward(m,d)
    t=time.perf_counter()
    for _ in range(n): mujoco.mj_step(m,d)
    el=time.perf_counter()-t
    s=np.zeros(mujoco.mj_stateSize(m,fp)); mujoco.mj_getState(m,d,s,fp)
    return s, el, d

class Model: pass

refs = {}
tref=[]
for sd in seeds:
    s,el,_ = sim_xml(build(), sd)
    refs[sd]=s; tref.append(el)
tref=np.mean(tref)
print("ref time", round(tref,4))

cases = {
 "euler-100it": {},
 "cg": dict(solver="CG"),
 "pgs": dict(solver="PGS"),
 "newton-it20": dict(iterations="20"),
 "newton-it1": dict(iterations="1"),
 "tol1e-6": dict(tolerance="1e-6"),
 "jacdense": dict(jacobian="dense"),
 "jacdense+newton": dict(jacobian="dense"),
 "noslip": dict(noslip_iterations="0"),
}
for name, opts in cases.items():
    xml = build(**opts)
    ts=[]; diffs=[]
    for sd in seeds:
        s,el,_ = sim_xml(xml, sd)
        ts.append(el); diffs.append(np.abs(s-refs[sd]).max())
    print(f"{name:18s} t={np.mean(ts):.4f} pctg={np.mean(ts)/tref:.3f} maxdiff={max(diffs):.2e}")
