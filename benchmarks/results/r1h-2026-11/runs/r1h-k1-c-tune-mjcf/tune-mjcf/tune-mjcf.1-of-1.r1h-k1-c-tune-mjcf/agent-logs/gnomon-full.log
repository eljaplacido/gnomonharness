import mujoco, numpy as np, time, sys

def timers(xml, label):
    m = mujoco.MjModel.from_xml_string(xml)
    d = mujoco.MjData(m)
    N=300
    for _ in range(100): mujoco.mj_step(m,d)
    # timers accumulate in MjData; use fresh data
    d = mujoco.MjData(m)
    t0=time.perf_counter()
    for _ in range(N): mujoco.mj_step(m,d)
    wall=(time.perf_counter()-t0)/N*1e6
    print(f"== {label}: {wall:.1f} us/step")
    for i in range(int(mujoco.mjtTimer.mjNTIMER)):
        st=d.timer[i]
        per = st.duration/st.number*1e6 if st.number else 0.0
        if per>0.3: print(f"   {mujoco.mjtTimer(i).name:24s} {per:8.1f}")
    print("   nefc", d.nefc, "ncon", d.ncon, "solver_niter", d.solver_niter[0])

base = open("model_ref.xml").read()
def build(opt="", before_option=""):
