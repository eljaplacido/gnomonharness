    d=mujoco.MjData(mm); rng=np.random.default_rng(seed); d.qpos+=rng.normal(0,0.01,size=d.qpos.shape)
    mujoco.mj_forward(mm,d)
    for _ in range(1000): mujoco.mj_step(mm,d)
    s=np.zeros(mujoco.mj_stateSize(mm,fp)); mujoco.mj_getState(mm,d,s,fp); return s
print("dense vs sparse identical:", all(np.array_equal(fin(m,s),fin(m2,s)) for s in range(5)))
