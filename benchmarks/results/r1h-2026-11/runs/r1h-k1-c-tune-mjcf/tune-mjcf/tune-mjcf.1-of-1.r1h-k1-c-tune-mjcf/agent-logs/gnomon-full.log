import time, mujoco, numpy as np, itertools, sys
fp = mujoco.mjtState.mjSTATE_FULLPHYSICS
base = open("model_ref.xml").read()
def build(opt="", flags=""):
    txt = base.replace('<compiler autolimits="true"/>', f'<compiler autolimits="true"/>\n  <option {opt}>{"<flag "+flags+"/>" if flags else ""}</option>' if flags else f'<compiler autolimits="true"/>\n  <option {opt}/>')
    return txt
def sim(xml, seed, total=2.0, timeit=False):
    m = mujoco.MjModel.from_xml_string(xml); d=mujoco.MjData(m)
    n=int(total/m.opt.timestep)
    rng=np.random.default_rng(seed); d.qpos += rng.normal(0,0.01,size=d.qpos.shape)
    mujoco.mj_forward(m,d)
    t=time.perf_counter()
    for _ in range(n): mujoco.mj_step(m,d)
    el=time.perf_counter()-t
    s=np.zeros(mujoco.mj_stateSize(m,fp)); mujoco.mj_getState(m,d,s,fp)
    return s, el, d

seeds=[0,1,2,3,4,5,9,23]
refxml = build()
refs={s:sim(refxml,s)[0] for s in seeds}
tref = np.mean([sim(refxml,s)[1] for s in seeds])
print("ref", round(tref,4))

def evaluate(xml, label, nseeds=8):
    ts=[]; diffs=[]
    for s in seeds[:nseeds]:
        st, el, d = sim(xml, s); ts.append(el); diffs.append(np.abs(st-refs[s]).max())
    print(f"{label:44s} pctg={np.mean(ts)/tref:.3f} worst={max(diffs):.2e} mean={np.mean(diffs):.2e}")
    return np.mean(ts)/tref, max(diffs)

cases = [
 ('solver="PGS"', ""),
 ('solver="PGS" tolerance="1e-10"', ""),
 ('solver="PGS" iterations="200"', ""),
 ('solver="PGS" tolerance="1e-12" iterations="200"', ""),
 ('solver="PGS"', 'eulerdamp="disable"'),
 ('solver="CG" tolerance="1e-10"', ""),
 ('integrator="implicitfast"', ""),
 ('integrator="implicit"', ""),
 ('solver="PGS" integrator="implicitfast"', ""),
]
for opt, fl in cases:
    x = build(opt, fl)
    try: evaluate(x, f"{opt} {fl}")
    except Exception as e: print(opt, fl, "ERR", e)
