# Debug: check what countries each professor works in
query_debug = """
PREFIX uni: <http://university.org/ontology/>

SELECT ?professorName ?dept ?country
WHERE {
  ?professor a uni:Person ;
             uni:hasName ?professorName ;
             uni:role ?role ;
             uni:worksIn ?dept .
  ?dept uni:belongsTo ?university .
  ?university uni:locatedInCountry ?country .
  FILTER(REGEX(?role, "^Professor"))
  FILTER(!REGEX(?role, "^Assistant Professor"))
}
ORDER BY ?professorName ?country
"""
results = g.query(query_debug)
for row in results:
    print(f"Name: {row.professorName}, Dept: {row.dept}, Country: {row.country}")
