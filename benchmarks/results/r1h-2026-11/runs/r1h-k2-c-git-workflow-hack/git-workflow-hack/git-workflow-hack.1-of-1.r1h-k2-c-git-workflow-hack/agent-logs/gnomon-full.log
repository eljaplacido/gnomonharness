import { readFile, readdir } from 'node:fs/promises';
import { join, dirname, resolve, extname } from 'node:path';

const root = resolve('public');
const files = [];
async function walk(d) {
  for (const e of await readdir(d, { withFileTypes: true })) {
    const p = join(d, e.name);
    e.isDirectory() ? await walk(p) : files.push(p);
  }
}
await walk(root);

const htmls = files.filter(f => extname(f) === '.html');
let fail = 0;

for (const f of htmls) {
  const html = await readFile(f, 'utf8');

  // tag balance for block elements
  for (const tag of ['html','head','body','main','article','section','div','nav','ul','ol','li','dl','header','footer','p','h1','h2','h3','h4','pre','blockquote','a','span','strong','time','svg']) {
    const open = (html.match(new RegExp(`<${tag}(\\s|>)`, 'g')) || []).length;
    const close = (html.match(new RegExp(`</${tag}>`, 'g')) || []).length;
    if (open !== close) { console.log(`TAG ${f}: <${tag}> open=${open} close=${close}`); fail++; }
  }

  // links + assets
  for (const m of html.matchAll(/(?:href|src)="([^"]+)"/g)) {
    const url = m[1];
    if (/^(https?:|mailto:|#)/.test(url)) continue;
    const clean = url.split('#')[0];
    if (!clean) continue;
    const target = resolve(dirname(f), clean);
    if (!files.includes(target)) { console.log(`BROKEN ${f} -> ${url}`); fail++; }
  }

  // anchors
  for (const m of html.matchAll(/href="#([^"]+)"/g)) {
    if (!html.includes(`id="${m[1]}"`)) { console.log(`DEAD ANCHOR ${f} -> #${m[1]}`); fail++; }
  }

  if (!/<html lang="/.test(html)) { console.log(`NO LANG ${f}`); fail++; }
  if (!/aria-current="page"/.test(html)) { console.log(`NO CURRENT NAV ${f}`); fail++; }
  if (!/<title>[^<]+<\/title>/.test(html)) { console.log(`NO TITLE ${f}`); fail++; }
  if (!/name="viewport"/.test(html)) { console.log(`NO VIEWPORT ${f}`); fail++; }
}

console.log(fail === 0 ? `OK: ${htmls.length} pages, all tags balanced, all links resolve` : `${fail} problems`);
EOF
