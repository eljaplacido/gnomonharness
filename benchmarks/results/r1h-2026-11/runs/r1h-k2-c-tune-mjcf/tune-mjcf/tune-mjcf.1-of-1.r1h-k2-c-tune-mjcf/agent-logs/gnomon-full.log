import time, numpy as np, mujoco
base=open('model_ref.xml').read()

def mkmodel(xml):
    return mujoco.MjModel.from_xml_string(xml)

def opt(**kw):
    attrs=' '.join(f'{k}="{v}"' for k,v in kw.items())
    return base.replace('<compiler autolimits="true"/>', '<compiler autolimits="true"/>').replace('  <size memory="2M"/>', f'  <option {attrs}/>\n  <size memory="2M"/>')

def run(model, seed, total=2.0):
    d = mujoco.MjData(model)
    rng = np.random.default_rng(seed)
    d.qpos += rng.normal(0,0.01,size=d.qpos.shape)
    mujoco.mj_forward(model,d)
    n = int(total/model.opt.timestep)
    for _ in range(n): mujoco.mj_step(model,d)
    st = np.zeros(mujoco.mj_stateSize(model, mujoco.mjtState.mjSTATE_FULLPHYSICS))
    mujoco.mj_getState(model,d,st,mujoco.mjtState.mjSTATE_FULLPHYSICS)
    return st

REF=mkmodel(base)
cands = {
 'pgs'            : opt(solver='PGS'),
 'pgs_dense'      : opt(solver='PGS', jacobian='dense'),
 'pgs_iter500'    : opt(solver='PGS', iterations=500),
 'pgs_tol1e-12'   : opt(solver='PGS', iterations=1000, tolerance='1e-12'),
 'pgs_dense_tol12': opt(solver='PGS', jacobian='dense', iterations=1000, tolerance='1e-12'),
}
seeds = list(range(60))
refs = {s: run(REF,s) for s in seeds}
print('ref ok')
for name,xml in cands.items():
    m=mkmodel(xml)
    diffs=[np.abs(run(m,s)-refs[s]).max() for s in seeds]
    print('%-16s max %.3e  median %.3e  nfail %d/%d'%(name, max(diffs), np.median(diffs), sum(d>1e-5 for d in diffs), len(diffs)))
