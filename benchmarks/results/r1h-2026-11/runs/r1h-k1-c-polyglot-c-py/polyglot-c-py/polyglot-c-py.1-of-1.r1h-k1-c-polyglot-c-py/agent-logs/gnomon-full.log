/*
 * C branch: arbitrary-precision Fibonacci via fast doubling.
 * Compiles cleanly with gcc; the Python branch below is skipped by #if 0.
 */

#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define BIG_BASE 1000000000ULL

typedef unsigned int limb;
typedef unsigned long long wide;

typedef struct {
    limb *v;      /* little endian limbs, base 1e9 */
    size_t n;     /* limbs in use, always >= 1 */
    size_t cap;
} Big;

static void die(void)
{
    fputs("out of memory\n", stderr);
    exit(1);
}

static void big_init(Big *x)
{
    x->cap = 4;
    x->n = 1;
    x->v = (limb *)malloc(x->cap * sizeof(limb));
    if (!x->v) die();
    x->v[0] = 0;
}

static void big_free(Big *x)
{
    free(x->v);
    x->v = NULL;
    x->n = 0;
    x->cap = 0;
}

static void big_reserve(Big *x, size_t cap)
{
    if (cap <= x->cap) return;
    {
        size_t c = x->cap ? x->cap : 4;
        limb *p;
        while (c < cap) c *= 2;
        p = (limb *)realloc(x->v, c * sizeof(limb));
        if (!p) die();
        x->v = p;
        x->cap = c;
    }
}

static void big_trim(Big *x)
{
    while (x->n > 1 && x->v[x->n - 1] == 0) x->n--;
}

static void big_set_u64(Big *x, unsigned long long val)
{
    big_reserve(x, 3);
    x->n = 0;
    if (val == 0) {
        x->v[0] = 0;
        x->n = 1;
        return;
    }
    while (val) {
        x->v[x->n++] = (limb)(val % BIG_BASE);
        val /= BIG_BASE;
    }
}

static void big_copy(Big *r, const Big *a)
{
    if (r == a) return;
    big_reserve(r, a->n);
    memcpy(r->v, a->v, a->n * sizeof(limb));
    r->n = a->n;
}

/* r = a + b; r may alias a or b */
static void big_add(Big *r, const Big *a, const Big *b)
{
    size_t n = a->n > b->n ? a->n : b->n;
    size_t i;
    wide carry = 0;
    big_reserve(r, n + 1);
    for (i = 0; i < n; i++) {
        wide s = carry;
        if (i < a->n) s += a->v[i];
        if (i < b->n) s += b->v[i];
        carry = s / BIG_BASE;
        r->v[i] = (limb)(s % BIG_BASE);
    }
    r->n = n;
    if (carry) r->v[r->n++] = (limb)carry;
    big_trim(r);
}

/* r = a - b, requires a >= b; r may alias a or b */
static void big_sub(Big *r, const Big *a, const Big *b)
{
    size_t i;
    wide borrow = 0;
    big_reserve(r, a->n);
    for (i = 0; i < a->n; i++) {
        wide hi = (i < b->n) ? b->v[i] : 0;
        wide ai = a->v[i];
        wide lo = hi + borrow;
        if (ai < lo) {
            r->v[i] = (limb)(ai + BIG_BASE - lo);
            borrow = 1;
        } else {
            r->v[i] = (limb)(ai - lo);
            borrow = 0;
        }
    }
    r->n = a->n;
    big_trim(r);
}

/* r = a * b; r must not alias a or b */
static void big_mul(Big *r, const Big *a, const Big *b)
{
    size_t n = a->n + b->n;
    size_t i, j;
    limb *res = (limb *)calloc(n, sizeof(limb));
    if (!res) die();
    for (i = 0; i < a->n; i++) {
        wide carry = 0;
        wide ai = a->v[i];
        for (j = 0; j < b->n; j++) {
            wide cur = (wide)res[i + j] + ai * (wide)b->v[j] + carry;
            res[i + j] = (limb)(cur % BIG_BASE);
            carry = cur / BIG_BASE;
        }
        res[i + b->n] = (limb)carry;
    }
    big_reserve(r, n);
    memcpy(r->v, res, n * sizeof(limb));
    r->n = n;
    big_trim(r);
    free(res);
}

static void big_print(const Big *x)
{
    size_t i = x->n;
    printf("%u", x->v[x->n - 1]);
    while (i-- > 1) printf("%09u", x->v[i - 1]);
    putchar(10);
}

static unsigned long long fib_double(unsigned long long n, Big *out)
{
    Big a, b, c, d, e, t;
    int top, i;

    big_init(&a);
    big_init(&b);
    big_init(&c);
    big_init(&d);
    big_init(&e);
    big_init(&t);

    big_set_u64(&a, 0);
    big_set_u64(&b, 1);

    if (n > 0) {
        top = 63;
        while (((n >> top) & 1ULL) == 0) top--;
        for (i = top; i >= 0; i--) {
            big_add(&t, &b, &b);     /* t = 2b        */
            big_sub(&t, &t, &a);     /* t = 2b - a    */
            big_mul(&c, &a, &t);     /* c = a*(2b-a)  */
            big_mul(&e, &a, &a);     /* e = a*a       */
            big_mul(&d, &b, &b);     /* d = b*b       */
            big_add(&d, &e, &d);     /* d = a*a + b*b */
            if ((n >> i) & 1ULL) {
                big_add(&e, &c, &d); /* e = c + d     */
                big_copy(&a, &d);
                big_copy(&b, &e);
            } else {
                big_copy(&a, &c);
                big_copy(&b, &d);
            }
        }
    }

    big_copy(out, &a);
    big_free(&a);
    big_free(&b);
    big_free(&c);
    big_free(&d);
    big_free(&e);
    big_free(&t);
    return 0;
}

int main(int argc, char **argv)
{
    unsigned long long n;
    char *end = NULL;
    Big result;

    if (argc < 2) {
        fputs("usage: main N\n", stderr);
        return 1;
    }
    if (argv[1][0] == 45) {           /* leading minus sign */
        fputs("N must be a non-negative integer\n", stderr);
        return 1;
    }
    n = strtoull(argv[1], &end, 10);
    if (end == NULL || end == argv[1] || end[0] != 0) {
        fputs("N must be a non-negative integer\n", stderr);
        return 1;
    }

    big_init(&result);
    fib_double(n, &result);
    big_print(&result);
    big_free(&result);
    return 0;
}

