#define HASH_INIT 1469598103934665603ULL
#define HASH_MUL  1099511628211ULL
#define NLOCKS    1024
#define MAX_KMER  256

static inline uint64_t hstep(uint64_t h, unsigned char c) {
    return (h ^ (uint64_t)c) * HASH_MUL;
}
static uint64_t hash_priv(const char *s, int len) {
    uint64_t h = HASH_INIT;
    int i;
    for (i = 0; i < len; i++) h = hstep(h, (unsigned char)s[i]);
    return h;
}

static shared char *sraw;
static shared int  *sls;
static shared char *skm;
static shared char *slext;
static shared char *srext;
static shared int  *schain;
static shared int  *shead;
static shared int  *ssucc;
static shared char *sroot;
static shared int  *sroots;
static shared int  *scnt;
static shared int  *soff;
static shared int  *serr;
static shared int  *sh_n;
static shared int  *sh_k;
static shared int  *sh_nb;
static shared int  *sh_fsize;
static shared int  *sh_nroot;
static shared int  *sh_ncontig;
static shared upc_lock_t *slocks;

static char *read_whole_file(const char *path, long *size_out) {
    FILE *f = fopen(path, "rb");
    long sz; char *buf;
    if (!f) return NULL;
    if (fseek(f, 0, SEEK_END) != 0) { fclose(f); return NULL; }
    sz = ftell(f);
    if (sz < 0) { fclose(f); return NULL; }
    rewind(f);
    buf = (char *)malloc((size_t)sz + 1);
    if (!buf) { fclose(f); return NULL; }
    if (sz > 0 && fread(buf, 1, (size_t)sz, f) != (size_t)sz) { free(buf); fclose(f); return NULL; }
    buf[sz] = '\0';
    fclose(f);
    *size_out = sz;
    return buf;
}
static void from_shared(char *dst, shared char *src, int len) {
    int i;
    for (i = 0; i < len; i++) dst[i] = src[i];
}
static void kmer_of(int v, char *dst, int k) {
    from_shared(dst, &skm[(size_t)v * (size_t)(k + 1)], k);
    dst[k] = '\0';
}
static int lookup_key(const char *key, int klen, int nb, char *probe) {
    uint64_t h = hash_priv(key, klen);
    int b = (int)(h & (uint64_t)(nb - 1));
    int j, q;
    for (j = shead[b]; j >= 0; j = schain[j]) {
        kmer_of(j, probe, klen);
        for (q = 0; q < klen; q++)
            if (probe[q] != key[q]) break;
        if (q == klen) return j;
    }
    return -1;
}

static void pgen_main(int argc, char **argv) {
    const char *input = (argc > 1 && argv[1][0] != '-') ? argv[1] : "test";
    printf("START\n"); fflush(stdout);

    if (MYTHREAD == 0) {
        long fsize = 0;
        char *buf = read_whole_file(input, &fsize);
        int count = 0, kk = -1, idx = 0;
        long p;
        shared char *raw;
        shared int *ls;
        printf("READ %ld\n", fsize); fflush(stdout);
        if (!buf) { fprintf(stderr, "cannot read %s\n", input); upc_global_exit(1); }
        for (p = 0; p < fsize; p++) if (buf[p] == '\n') count++;
        if (fsize > 0 && buf[fsize - 1] != '\n') count++;
        for (p = 0; p < fsize; p++) {
            if (buf[p] == '\t') { kk = (int)p; break; }
            if (buf[p] == '\n') break;
        }
        printf("COUNT %d KK %d\n", count, kk); fflush(stdout);
        if (count <= 0 || kk <= 0 || kk >= MAX_KMER) {
            fprintf(stderr, "empty or malformed\n"); free(buf); upc_global_exit(1);
        }
        raw = (shared char *)upc_all_alloc((size_t)fsize + 1, 1);
        ls  = (shared int *)upc_all_alloc((size_t)count, sizeof(int));
        printf("ALLOC RAW %p LS %p\n", (void*)raw, (void*)ls); fflush(stdout);
        if (!raw || !ls) { fprintf(stderr, "cannot alloc shared\n"); free(buf); upc_global_exit(1); }
        upc_memput(raw, buf, (size_t)fsize);
        for (p = 0; p < fsize; p++) {
            long s = p;
            while (p < fsize && buf[p] != '\n') p++;
            if (p > s && idx < count) ls[idx++] = (int)s;
        }
        *sh_n     = idx;
        *sh_k     = kk;
        *sh_fsize = (int)fsize;
        sraw = raw;
        sls  = ls;
        free(buf);
        printf("N %d K %d\n", *sh_n, *sh_k); fflush(stdout);
    }
