        while (b < 2 * n) b <<= 1;
        *sh_nb    = b;
        *sh_nroot = 0;
        *sh_ncontig = 0;
        skm     = (shared char *)upc_all_alloc((size_t)n * (size_t)(k + 1), 1);
        slext   = (shared char *)upc_all_alloc((size_t)n, 1);
        srext   = (shared char *)upc_all_alloc((size_t)n, 1);
        schain  = (shared int *)upc_all_alloc((size_t)n, sizeof(int));
        ssucc   = (shared int *)upc_all_alloc((size_t)n, sizeof(int));
        sroot   = (shared char *)upc_all_alloc((size_t)n, 1);
        sroots  = (shared int *)upc_all_alloc((size_t)n, sizeof(int));
        shead   = (shared int *)upc_all_alloc((size_t)b, sizeof(int));
        scnt    = (shared int *)upc_all_alloc((size_t)THREADS, sizeof(int));
        soff    = (shared int *)upc_all_alloc((size_t)THREADS, sizeof(int));
        serr    = (shared int *)upc_all_alloc((size_t)THREADS, sizeof(int));
        slocks  = (shared upc_lock_t *)upc_all_alloc(NLOCKS, sizeof(upc_lock_t));
        printf("GRAPH ALLOC nb=%d\n", *sh_nb); fflush(stdout);
        if (!skm || !slext || !srext || !schain || !ssucc || !sroot ||
            !sroots || !shead || !scnt || !soff || !serr || !slocks) {
            fprintf(stderr, "cannot alloc graph\n"); upc_global_exit(1);
        }
    }
    upc_barrier;
    printf("BARRIER2\n"); fflush(stdout);
    nb = *sh_nb;
    serr[MYTHREAD] = 0;
    for (i = MYTHREAD; i < nb; i += THREADS) shead[i] = -1;
    for (i = MYTHREAD; i < NLOCKS; i += THREADS) upc_lock_init(&slocks[i]);
    upc_barrier;
    printf("BARRIER3\n"); fflush(stdout);

    kmer  = (char *)malloc((size_t)k + 2);
    key   = (char *)malloc((size_t)k + 2);
    probe = (char *)malloc((size_t)k + 2);
    rec   = (char *)malloc((size_t)k + (size_t)n + 8);
    if (!kmer || !key || !probe || !rec) { fprintf(stderr, "OOM\n"); upc_global_exit(1); }
    printf("PARSING\n"); fflush(stdout);

    for (i = MYTHREAD; i < n; i += THREADS) {
        int s = sls[i], q;
        char *dst = &skm[(size_t)i * (size_t)(k + 1)];
        for (q = 0; q < k; q++) {
            kmer[q] = sraw[s + q];
            dst[q] = kmer[q];
        }
        kmer[k] = '\0';
        dst[k] = '\0';
        if (sraw[s + k] != '\t') { serr[MYTHREAD] = 1; continue; }
        slext[i] = (sraw[s + k + 1] != '\0') ? sraw[s + k + 1] : 'F';
        srext[i] = (sraw[s + k + 2] != '\0') ? sraw[s + k + 2] : 'F';
        schain[i] = -1;
        ssucc[i]  = -1;
        sroot[i]  = 1;
    }
    upc_barrier;
    printf("BARRIER4\n"); fflush(stdout);

    for (i = MYTHREAD; i < n; i += THREADS) {
        uint64_t h;
        int b, m, q, dup = 0;
        kmer_of(i, kmer, k);
        h = hash_priv(kmer, k);
        b = (int)(h & (uint64_t)(nb - 1));
        upc_lock(&slocks[b & (NLOCKS - 1)]);
        for (m = shead[b]; m >= 0; m = schain[m]) {
            kmer_of(m, probe, k);
            for (q = 0; q < k; q++)
                if (probe[q] != kmer[q]) break;
            if (q == k) { dup = 1; break; }
        }
        if (!dup) {
            schain[i] = shead[b];
            upc_fence;
            shead[b] = i;
        } else { serr[MYTHREAD] += 1; }
        upc_unlock(&slocks[b & (NLOCKS - 1)]);
    }
    upc_barrier;
    printf("BARRIER5\n"); fflush(stdout);

    for (i = MYTHREAD; i < n; i += THREADS) {
        unsigned char r = (unsigned char)srext[i];
        unsigned char l = (unsigned char)slext[i];
        int q;
        kmer_of(i, kmer, k);
        if (r != 'F') {
            for (q = 0; q < k - 1; q++) key[q] = kmer[q + 1];
            key[k - 1] = (char)r;
            key[k] = '\0';
            ssucc[i] = lookup_key(key, k, nb, probe);
        } else { ssucc[i] = -1; }
        if (l != 'F') {
            key[0] = (char)l;
            for (q = 0; q < k - 1; q++) key[q + 1] = kmer[q];
            key[k] = '\0';
            sroot[i] = (lookup_key(key, k, nb, probe) >= 0) ? 0 : 1;
        } else { sroot[i] = 1; }
    }
    upc_barrier;
    printf("BARRIER6\n"); fflush(stdout);

    myroots = 0;
    for (i = MYTHREAD; i < n; i += THREADS)
        if (sroot[i]) myroots++;
    scnt[MYTHREAD] = myroots;
    upc_barrier;
    printf("BARRIER7\n"); fflush(stdout);

    if (MYTHREAD == 0) {
        int run = 0;
        for (t = 0; t < THREADS; t++) {
            soff[t] = run;
            run += scnt[t];
        }
        *sh_nroot = run;
    }
    upc_barrier;
    printf("BARRIER8\n"); fflush(stdout);
    nbroot = *sh_nroot;

    mine = 0;
    base = soff[MYTHREAD];
    for (i = MYTHREAD; i < n; i += THREADS) {
        if (sroot[i]) { sroots[base + mine] = i; mine++; }
    }
    serr[MYTHREAD] = mine;
    upc_barrier;
    printf("BARRIER9\n"); fflush(stdout);

    odir = (access("/app", W_OK) == 0) ? "/app" : ".";
    snprintf(mypath, sizeof(mypath), "%s/pgen_%d.out", odir, (int)MYTHREAD);
    myout = fopen(mypath, "w");
    if (!myout) { fprintf(stderr, "cannot open %s\n", mypath); upc_global_exit(1); }

    for (i = 0; i < serr[MYTHREAD]; i++) {
        int cur = sroots[base + i], steps = 0, len = k;
        kmer_of(cur, rec, k);
        while (ssucc[cur] >= 0 && steps < n) {
            rec[len++] = srext[cur];
            cur = ssucc[cur];
            steps++;
        }
        rec[len] = '\0';
        fprintf(myout, "%s\n", rec);
        mycontigs++;
    }
    fclose(myout);
    scnt[MYTHREAD] = mycontigs;
    upc_barrier;
    if (MYTHREAD == 0) {
        int tot = 0;
        for (t = 0; t < THREADS; t++) tot += scnt[t];
        *sh_ncontig = tot;
        printf("DONE: %d threads, %d k-mers, k=%d, %d roots, %d contigs\n",
               (int)THREADS, n, k, nbroot, tot);
    }
    upc_barrier;
    free(rec);
    free(probe);
    free(key);
    free(kmer);
}

int main(int argc, char **argv) {
    return compat_run(pgen_main, argc, argv, compat_threads_env());
}
