#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>
#include <unistd.h>
#include <pthread.h>
#include <sys/mman.h>

#define shared
#define UPC_MAX_THREADS 64
typedef void (*compat_fn)(int, char **);
typedef pthread_mutex_t upc_lock_t;

static int compat_nthreads = 1;
static __thread int compat_mythread = 0;
#define THREADS  (compat_nthreads)
#define MYTHREAD (compat_mythread)
#define upc_barrier compat_barrier()
#define upc_fence ((void)0)
#define upc_all_alloc(n, sz) compat_alloc((size_t)(n), (size_t)(sz))
#define upc_global_exit(c) exit(c)
#define upc_memput(dst, src, n) memcpy((void *)(dst), (const void *)(src), (size_t)(n))
#define upc_lock_init(l) pthread_mutex_init((l), NULL)
#define upc_lock(l) pthread_mutex_lock((l))
#define upc_unlock(l) pthread_mutex_unlock((l))

static pthread_mutex_t compat_mu = PTHREAD_MUTEX_INITIALIZER;
static pthread_cond_t  compat_cv = PTHREAD_COND_INITIALIZER;
static int compat_arrived = 0;
static int compat_gen = 0;

static void compat_barrier(void) {
    int gen;
    pthread_mutex_lock(&compat_mu);
    gen = compat_gen;
    compat_arrived++;
    if (compat_arrived == compat_nthreads) {
        compat_arrived = 0;
        compat_gen++;
        pthread_cond_broadcast(&compat_cv);
    } else {
        while (gen == compat_gen)
            pthread_cond_wait(&compat_cv, &compat_mu);
    }
    pthread_mutex_unlock(&compat_mu);
}

static void *compat_alloc(size_t n, size_t sz) {
    size_t bytes = n * sz;
    void *p;
    if (bytes == 0) bytes = 1;
    p = mmap(NULL, bytes, PROT_READ | PROT_WRITE, MAP_SHARED | MAP_ANONYMOUS, -1, 0);
    if (p == MAP_FAILED) {
        fprintf(stderr, "pgen: shared allocation of %lu bytes failed\n", (unsigned long)bytes);
        exit(1);
    }
    return p;
}

struct compat_args { compat_fn fn; int argc; char **argv; int tid; };

static void *compat_wrap(void *p) {
    struct compat_args *a = (struct compat_args *)p;
    compat_mythread = a->tid;
    a->fn(a->argc, a->argv);
    return NULL;
}

static int compat_threads_env(void) {
    const char *s = getenv("PGEN_THREADS");
    int v = s ? atoi(s) : 4;
    if (v < 1) v = 1;
    if (v > UPC_MAX_THREADS) v = UPC_MAX_THREADS;
    return v;
}

static int compat_run(compat_fn fn, int argc, char **argv, int nthreads) {
    static pthread_t tids[UPC_MAX_THREADS];
    static struct compat_args args[UPC_MAX_THREADS];
    int t;
    if (nthreads < 1) nthreads = 1;
    if (nthreads > UPC_MAX_THREADS) nthreads = UPC_MAX_THREADS;
    compat_nthreads = nthreads;
    for (t = 1; t < nthreads; t++) {
        args[t].fn = fn;
        args[t].argc = argc;
        args[t].argv = argv;
        args[t].tid = t;
        if (pthread_create(&tids[t], NULL, compat_wrap, &args[t]) != 0) {
            fprintf(stderr, "pgen: cannot create thread %d\n", t);
            return 1;
        }
    }
    compat_mythread = 0;
    fn(argc, argv);
    for (t = 1; t < nthreads; t++)
        pthread_join(tids[t], NULL);
    return 0;
}

#define HASH_INIT 1469598103934665603ULL
#define HASH_MUL  1099511628211ULL
#define NLOCKS    1024
#define MAX_KMER  256

static inline uint64_t hstep(uint64_t h, unsigned char c) {
    return (h ^ (uint64_t)c) * HASH_MUL;
}

static uint64_t hash_priv(const char *s, int len) {
    uint64_t h = HASH_INIT;
    int i;
    for (i = 0; i < len; i++)
        h = hstep(h, (unsigned char)s[i]);
    return h;
}

static shared char *sraw;
static shared int  *sls;
static shared char *skm;
static shared char *slext;
static shared char *srext;
static shared int  *schain;
static shared int  *shead;
static shared int  *ssucc;
static shared char *sroot;
static shared int  *sroots;
static shared int  *scnt;
static shared int  *soff;
static shared int  *serr;
static shared int  *sh_n;
static shared int  *sh_k;
static shared int  *sh_nb;
static shared int  *sh_fsize;
static shared int  *sh_nroot;
static shared int  *sh_ncontig;
static shared upc_lock_t *slocks;

static char *read_whole_file(const char *path, long *size_out) {
    FILE *f = fopen(path, "rb");
    long sz;
    char *buf;
    if (!f) return NULL;
    if (fseek(f, 0, SEEK_END) != 0) { fclose(f); return NULL; }
    sz = ftell(f);
    if (sz < 0) { fclose(f); return NULL; }
    rewind(f);
    buf = (char *)malloc((size_t)sz + 1);
    if (!buf) { fclose(f); return NULL; }
    if (sz > 0 && fread(buf, 1, (size_t)sz, f) != (size_t)sz) {
        free(buf); fclose(f); return NULL;
    }
    buf[sz] = '\0';
    fclose(f);
    *size_out = sz;
    return buf;
}

static void from_shared(char *dst, shared char *src, int len) {
    int i;
    for (i = 0; i < len; i++)
        dst[i] = src[i];
}

static void kmer_of(int v, char *dst, int k) {
    from_shared(dst, &skm[(size_t)v * (size_t)(k + 1)], k);
    dst[k] = '\0';
}

static int lookup_key(const char *key, int klen, int nb, char *probe) {
    uint64_t h = hash_priv(key, klen);
    int b = (int)(h & (uint64_t)(nb - 1));
    int j, q;
    for (j = shead[b]; j >= 0; j = schain[j]) {
        kmer_of(j, probe, klen);
        for (q = 0; q < klen; q++)
            if (probe[q] != key[q]) break;
        if (q == klen) return j;
    }
    return -1;
}

static void pgen_main(int argc, char **argv) {
    const char *input = (argc > 1 && argv[1][0] != '-') ? argv[1] : "test";
    const char *odir;
    char mypath[512];
    FILE *myout = NULL;
    int n, k, nb, i, t, nbroot;
    int myroots, mycontigs = 0, base, mine;
    char *kmer, *key, *probe, *rec;

    printf("pgen: thread %d starting, input=%s\n", (int)MYTHREAD, input);

    if (MYTHREAD == 0) {
        long fsize = 0;
        char *buf = read_whole_file(input, &fsize);
        int count = 0, kk = -1, idx = 0;
        long p;
        shared char *raw;
        shared int *ls;

        printf("pgen: thread 0 read %ld bytes\n", fsize);
        if (!buf) { fprintf(stderr, "pgen: cannot read %s\n", input); upc_global_exit(1); }
        for (p = 0; p < fsize; p++)
            if (buf[p] == '\n') count++;
        if (fsize > 0 && buf[fsize - 1] != '\n') count++;
        for (p = 0; p < fsize; p++) {
            if (buf[p] == '\t') { kk = (int)p; break; }
            if (buf[p] == '\n') break;
        }
        printf("pgen: thread 0 count=%d kk=%d\n", count, kk);
        if (count <= 0 || kk <= 0 || kk >= MAX_KMER) {
            fprintf(stderr, "pgen: %s is empty or malformed\n", input);
            free(buf); upc_global_exit(1);
        }

        raw = (shared char *)upc_all_alloc((size_t)fsize + 1, 1);
        ls  = (shared int *)upc_all_alloc((size_t)count, sizeof(int));
        printf("pgen: thread 0 allocated raw=%p ls=%p\n", (void*)raw, (void*)ls);
        if (!raw || !ls) { fprintf(stderr, "pgen: cannot allocate shared input buffers\n"); free(buf); upc_global_exit(1); }
        upc_memput(raw, buf, (size_t)fsize);
        for (p = 0; p < fsize; p++) {
            long s = p;
            while (p < fsize && buf[p] != '\n') p++;
            if (p > s && idx < count)
                ls[idx++] = (int)s;
        }
        *sh_n     = idx;
        *sh_k     = kk;
        *sh_fsize = (int)fsize;
        sraw = raw;
        sls  = ls;
        free(buf);
        printf("pgen: thread 0 n=%d k=%d\n", *sh_n, *sh_k);
    }
    upc_barrier;
    n = *sh_n;
    k = *sh_k;
    printf("pgen: thread %d after barrier 1, n=%d k=%d\n", (int)MYTHREAD, n, k);

    if (MYTHREAD == 0) {
        int b = 1;
        while (b < 2 * n) b <<= 1;
        *sh_nb    = b;
        *sh_nroot = 0;
        *sh_ncontig = 0;
        skm     = (shared char *)upc_all_alloc((size_t)n * (size_t)(k + 1), 1);
        slext   = (shared char *)upc_all_alloc((size_t)n, 1);
        srext   = (shared char *)upc_all_alloc((size_t)n, 1);
        schain  = (shared int *)upc_all_alloc((size_t)n, sizeof(int));
        ssucc   = (shared int *)upc_all_alloc((size_t)n, sizeof(int));
        sroot   = (shared char *)upc_all_alloc((size_t)n, 1);
        sroots  = (shared int *)upc_all_alloc((size_t)n, sizeof(int));
        shead   = (shared int *)upc_all_alloc((size_t)b, sizeof(int));
        scnt    = (shared int *)upc_all_alloc((size_t)THREADS, sizeof(int));
        soff    = (shared int *)upc_all_alloc((size_t)THREADS, sizeof(int));
        serr    = (shared int *)upc_all_alloc((size_t)THREADS, sizeof(int));
        slocks  = (shared upc_lock_t *)upc_all_alloc(NLOCKS, sizeof(upc_lock_t));
        printf("pgen: thread 0 allocated graph arrays, nb=%d\n", *sh_nb);
        if (!skm || !slext || !srext || !schain || !ssucc || !sroot ||
            !sroots || !shead || !scnt || !soff || !serr || !slocks) {
            fprintf(stderr, "pgen: cannot allocate shared graph arrays\n");
            upc_global_exit(1);
        }
    }
    upc_barrier;
    nb = *sh_nb;
    printf("pgen: thread %d after barrier 2, nb=%d\n", (int)MYTHREAD, nb);

    serr[MYTHREAD] = 0;
    for (i = MYTHREAD; i < nb; i += THREADS)
        shead[i] = -1;
    for (i = MYTHREAD; i < NLOCKS; i += THREADS)
        upc_lock_init(&slocks[i]);
    upc_barrier;
    printf("pgen: thread %d after barrier 3\n", (int)MYTHREAD);

    kmer  = (char *)malloc((size_t)k + 2);
    key   = (char *)malloc((size_t)k + 2);
    probe = (char *)malloc((size_t)k + 2);
    rec   = (char *)malloc((size_t)k + (size_t)n + 8);
    if (!kmer || !key || !probe || !rec) {
        fprintf(stderr, "pgen: thread %d is out of memory\n", (int)MYTHREAD);
        upc_global_exit(1);
    }

    for (i = MYTHREAD; i < n; i += THREADS) {
        int s = sls[i], q;
        char *dst = &skm[(size_t)i * (size_t)(k + 1)];
        for (q = 0; q < k; q++) {
            kmer[q] = sraw[s + q];
            dst[q] = kmer[q];
        }
        kmer[k] = '\0';
        dst[k] = '\0';
        if (sraw[s + k] != '\t') {
            serr[MYTHREAD] = 1;
            continue;
        }
        slext[i] = (sraw[s + k + 1] != '\0') ? sraw[s + k + 1] : 'F';
        srext[i] = (sraw[s + k + 2] != '\0') ? sraw[s + k + 2] : 'F';
        schain[i] = -1;
        ssucc[i]  = -1;
        sroot[i]  = 1;
    }
    upc_barrier;
    printf("pgen: thread %d after barrier 4\n", (int)MYTHREAD);

    for (i = MYTHREAD; i < n; i += THREADS) {
        uint64_t h;
        int b, m, q, dup = 0;
        kmer_of(i, kmer, k);
        h = hash_priv(kmer, k);
        b = (int)(h & (uint64_t)(nb - 1));
        upc_lock(&slocks[b & (NLOCKS - 1)]);
        for (m = shead[b]; m >= 0; m = schain[m]) {
            kmer_of(m, probe, k);
            for (q = 0; q < k; q++)
                if (probe[q] != kmer[q]) break;
            if (q == k) { dup = 1; break; }
        }
        if (!dup) {
            schain[i] = shead[b];
            upc_fence;
            shead[b] = i;
        } else {
            serr[MYTHREAD] += 1;
        }
        upc_unlock(&slocks[b & (NLOCKS - 1)]);
    }
    upc_barrier;
    printf("pgen: thread %d after barrier 5\n", (int)MYTHREAD);

    for (i = MYTHREAD; i < n; i += THREADS) {
        unsigned char r = (unsigned char)srext[i];
        unsigned char l = (unsigned char)slext[i];
        int q;
        kmer_of(i, kmer, k);
        if (r != 'F') {
            for (q = 0; q < k - 1; q++)
                key[q] = kmer[q + 1];
            key[k - 1] = (char)r;
            key[k] = '\0';
            ssucc[i] = lookup_key(key, k, nb, probe);
        } else {
            ssucc[i] = -1;
        }
        if (l != 'F') {
            key[0] = (char)l;
            for (q = 0; q < k - 1; q++)
                key[q + 1] = kmer[q];
            key[k] = '\0';
            sroot[i] = (lookup_key(key, k, nb, probe) >= 0) ? 0 : 1;
        } else {
            sroot[i] = 1;
        }
    }
    upc_barrier;
    printf("pgen: thread %d after barrier 6\n", (int)MYTHREAD);

    myroots = 0;
    for (i = MYTHREAD; i < n; i += THREADS)
        if (sroot[i])
            myroots++;
    scnt[MYTHREAD] = myroots;
    upc_barrier;
    printf("pgen: thread %d after barrier 7, myroots=%d\n", (int)MYTHREAD, myroots);

    if (MYTHREAD == 0) {
        int run = 0;
        for (t = 0; t < THREADS; t++) {
            soff[t] = run;
            run += scnt[t];
        }
        *sh_nroot = run;
    }
    upc_barrier;
    nbroot = *sh_nroot;
    printf("pgen: thread %d after barrier 8, nbroot=%d\n", (int)MYTHREAD, nbroot);

    mine = 0;
    base = soff[MYTHREAD];
    for (i = MYTHREAD; i < n; i += THREADS) {
        if (sroot[i]) {
            sroots[base + mine] = i;
            mine++;
        }
    }
    serr[MYTHREAD] = mine;
    upc_barrier;
    printf("pgen: thread %d after barrier 9, mine=%d\n", (int)MYTHREAD, mine);

    odir = (access("/app", W_OK) == 0) ? "/app" : ".";
    snprintf(mypath, sizeof(mypath), "%s/pgen_%d.out", odir, (int)MYTHREAD);
    myout = fopen(mypath, "w");
    if (!myout) {
        fprintf(stderr, "pgen: thread %d cannot open %s\n", (int)MYTHREAD, mypath);
        upc_global_exit(1);
    }

    for (i = 0; i < serr[MYTHREAD]; i++) {
        int cur = sroots[base + i], steps = 0, len = k;
        kmer_of(cur, rec, k);
        while (ssucc[cur] >= 0 && steps < n) {
            rec[len++] = srext[cur];
            cur = ssucc[cur];
            steps++;
        }
        rec[len] = '\0';
        fprintf(myout, "%s\n", rec);
        mycontigs++;
    }
    fclose(myout);
    scnt[MYTHREAD] = mycontigs;
    upc_barrier;
    if (MYTHREAD == 0) {
        int tot = 0;
        for (t = 0; t < THREADS; t++)
            tot += scnt[t];
        *sh_ncontig = tot;
        printf("pgen: %d threads, %d k-mers, k=%d, %d roots, %d contigs -> %s/pgen_*.out\n",
               (int)THREADS, n, k, nbroot, tot, odir);
    }
    upc_barrier;
    free(rec);
    free(probe);
    free(key);
    free(kmer);
}

int main(int argc, char **argv) {
    return compat_run(pgen_main, argc, argv, compat_threads_env());
}
