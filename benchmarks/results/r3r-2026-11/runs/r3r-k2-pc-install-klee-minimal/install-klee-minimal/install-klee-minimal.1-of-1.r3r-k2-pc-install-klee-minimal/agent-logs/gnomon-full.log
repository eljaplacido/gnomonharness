import re

with open('/opt/src/klee/runtime/POSIX/fd.c', 'r') as f:
    content = f.read()

# 1. Add the aarch64 syscalls header after the license block
header = '''#include "/tmp/aarch64_syscalls.h"

'''
content = content.replace(
    '#define _LARGEFILE64_SOURCE\n',
    header + '#define _LARGEFILE64_SOURCE\n',
    1
)

# 2. Fix __NR_open -> __NR_openat with AT_FDCWD
content = content.replace(
    'syscall(__NR_open, __concretize_string(pathname), flags, mode)',
    'syscall(__NR_openat, AT_FDCWD, __concretize_string(pathname), flags, mode)'
)

# 3. Fix __NR_select -> __NR_pselect6 with NULL sigmask
content = content.replace(
    'syscall(__NR_select, os_nfds, \n                    &os_read, &os_write, &os_except, &tv)',
    'syscall(__NR_pselect6, os_nfds, \n                    &os_read, &os_write, &os_except, &tv, NULL)'
)

with open('/opt/src/klee/runtime/POSIX/fd.c', 'w') as f:
    f.write(content)

print("Patch applied successfully")
