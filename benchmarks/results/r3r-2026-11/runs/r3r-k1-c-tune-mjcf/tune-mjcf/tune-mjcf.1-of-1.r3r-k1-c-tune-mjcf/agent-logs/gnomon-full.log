    a=sim(new,s); b=sim(ref,s)
    assert np.all(np.isfinite(a)), f"non-finite seed {s}"
    # replicate eval's check exactly: allclose(atol=1e-5)
    if not np.allclose(a,b,atol=1e-5): fails+=1
    worst=max(worst, float(np.abs(a-b).max()))
print(f"seeds={len(seeds)} fails={fails} worst_abs_diff={worst:.3e} (atol=1e-5)")
# confirm physical properties identical
for name in ["body_mass","body_inertia","dof_damping","geom_size","jnt_range","qpos0"]:
    print(name, "identical" if np.array_equal(getattr(ref,name), getattr(new,name)) else "DIFFERS")
