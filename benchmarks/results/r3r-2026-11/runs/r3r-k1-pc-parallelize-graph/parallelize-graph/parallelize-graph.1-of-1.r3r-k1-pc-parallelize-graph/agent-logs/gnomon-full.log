[approval] bash: cat > /tmp/check.py << 'PYEOF'
#!/usr/bin/env python3
"""Independent verifier of serial.c contig output."""

import sys

K = 19
INPUT_FILE = "test"
OUTPUT_FILE = "/app/serial.out"

# 1. Read input: kmer -> (left_ext, right_ext)
kmer_map = {}  # kmer -> (left, right)
kmer_order = []  # preserve line order for tie-breaking
with open(INPUT_FILE) as f:
    for idx, line in enumerate(f):
        line = line.strip()
        if not line:
            continue
        parts = line.split('\t')
        kmer = parts[0]
        ext = parts[1]
        left = ext[0]
        right = ext[1]
        kmer_map[kmer] = (left, right)
        kmer_order.append(kmer)

print(f"Read {len(kmer_map)} kmers from input")

# 2. Build pred/succ and indeg
pred = {}
succ = {}
indeg = {}

for kmer in kmer_map:
    pred[kmer] = None
    succ[kmer] = None
    indeg[kmer] = 0

for kmer in kmer_map:
    left, right = kmer_map[kmer]
    if left != 'F':
        pred_kmer = left + kmer[:-1]
        if pred_kmer in kmer_map:
            pred[kmer] = pred_kmer
    if right != 'F':
        succ_kmer = kmer[1:] + right
        if succ_kmer in kmer_map:
            succ[kmer] = succ_kmer
            indeg[succ_kmer] += 1

# 3. Find cycles of indeg==1 nodes
visited_for_cycle = set()
cycle_nodes = set()

for kmer in kmer_order:
    if kmer in visited_for_cycle:
        continue
    if indeg[kmer] != 1:
        visited_for_cycle.add(kmer)
        continue
    chain = []
    current = kmer
    seen_in_chain = {}
    while current is not None and current not in visited_for_cycle:
        if current in seen_in_chain:
            cycle_start_idx = seen_in_chain[current]
            for node in chain[cycle_start_idx:]:
                cycle_nodes.add(node)
            break
        seen_in_chain[current] = len(chain)
        chain.append(current)
        current = pred.get(current)
    for node in chain:
        visited_for_cycle.add(node)

# 4. Determine anchors
anchor = {}
for kmer in kmer_map:
    if indeg[kmer] != 1:
        anchor[kmer] = True
    elif kmer in cycle_nodes:
        anchor[kmer] = True  # will refine below
    else:
        anchor[kmer] = False

# For cycles, only the smallest-id node is the anchor
visited_cycle = set()
for kmer in kmer_order:
    if kmer in visited_cycle or kmer not in cycle_nodes or indeg[kmer] != 1:
        continue
    group = []
    current = kmer
    while current not in visited_cycle:
        visited_cycle.add(current)
        group.append(current)
        current = pred[current]
        if current == kmer:
            break
    min_idx = min(kmer_order.index(n) for n in group)
    anchor_kmer = kmer_order[min_idx]
    for n in group:
        if n == anchor_kmer:
            anchor[n] = True
        else:
            anchor[n] = False

anchor_count = sum(1 for v in anchor.values() if v)
print(f"Anchors: {anchor_count}")

# 5. Build expected contigs
expected_contigs = set()
for kmer in kmer_order:
    if not anchor[kmer]:
        continue
    contig_bases = [kmer]
    current = kmer
    while succ[current] is not None and not anchor[succ[current]]:
        current = succ[current]
        contig_bases.append(current)
    contig_str = contig_bases[0]
    for i in range(1, len(contig_bases)):
        contig_str += contig_bases[i][-1]
    expected_contigs.add(contig_str)

print(f"Expected contigs: {len(expected_contigs)}")

# 6. Read actual output
actual_contigs = set()
with open(OUTPUT_FILE) as f:
    for line in f:
        line = line.strip()
        if line:
            actual_contigs.add(line)

print(f"Actual contigs: {len(actual_contigs)}")

# 7. Compare
only_expected = expected_contigs - actual_contigs
only_actual = actual_contigs - expected_contigs

print(f"Only in expected: {len(only_expected)}")
print(f"Only in actual: {len(only_actual)}")

if only_expected:
    print("First 3 only in expected:")
    for c in sorted(only_expected)[:3]:
        print(f"  {c[:80]}...")
if only_actual:
    print("First 3 only in actual:")
    for c in sorted(only_actual)[:3]:
        print(f"  {c[:80]}...")

# 8. Assert coverage
total_kmers_covered = 0
all_covered_kmers = set()
duplicates = 0
for contig in actual_contigs:
    L = len(contig)
    for i in range(L - K + 1):
        km = contig[i:i+K]
        total_kmers_covered += 1
        if km in all_covered_kmers:
            duplicates += 1
        all_covered_kmers.add(km)

print(f"Total kmers covered: {total_kmers_covered}")
print(f"Distinct kmers covered: {len(all_covered_kmers)}")
print(f"Duplicates: {duplicates}")
print(f"All 10000 kmers covered: {len(all_covered_kmers) == 10000}")
print(f"Exact coverage: {total_kmers_covered == 10000 and len(all_covered_kmers) == 10000}")
PYEOF
