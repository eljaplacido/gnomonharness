import json, torch
from transformers import AutoTokenizer, AutoModelForCausalLM
tok=AutoTokenizer.from_pretrained('openai-community/gpt2'); tok.pad_token=tok.eos_token
m=AutoModelForCausalLM.from_pretrained('openai-community/gpt2').eval()
L={c:tok(' '+c)['input_ids'][0] for c in 'ABCD'}
print(L)
val=json.load(open('data/val.json'))
def prompt(s): return "Question: %s\n%s\nAnswer:"%(s['question'],"\n".join(s['options']))
ok=0
with torch.no_grad():
  for s in val:
    ids=tok(prompt(s),return_tensors='pt').input_ids
    lg=m(ids).logits[0,-1]
    p=max('ABCD',key=lambda c: lg[L[c]].item())
    ok+= p==s['answer']
print('zero-shot acc', ok/len(val))
EOF
