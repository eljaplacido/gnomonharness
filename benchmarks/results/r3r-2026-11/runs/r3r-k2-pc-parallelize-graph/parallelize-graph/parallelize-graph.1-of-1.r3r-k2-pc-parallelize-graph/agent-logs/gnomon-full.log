[approval] bash: cat > Makefile <<'MAKEEOF'
CC      = gcc
CFLAGS  = -O2 -Wall -Wextra
UPCC   := $(shell command -v upcc 2>/dev/null)

all: serial pgen

serial: serial.c
	$(CC) $(CFLAGS) -o serial serial.c

# pgen is the parallel version. With Berkeley UPC installed it is built from
# pgen.upc and run with:  upcrun -n <threads> -shared-heap 256MB ./pgen test
# Without a UPC compiler the same algorithm is built from pgen_threads.c,
# which uses pthreads on one SMP node -- the configuration this UPC build
# targets (--enable-smp). The outputs and traversal rules are identical.
pgen: $(if $(UPCC),pgen.upc,pgen_threads.c)
ifeq ($(strip $(UPCC)),)
	@echo "NOTE: upcc not found; building pgen from pgen_threads.c (pthread SMP fallback)"
	$(CC) $(CFLAGS) -pthread -o pgen pgen_threads.c
else
	upcc -O2 -o pgen pgen.upc
endif

clean:
	rm -f serial pgen /app/serial.out $(wildcard /app/pgen_*.out)

# Runs both versions on `test` and checks the contig sets are identical
# (order is allowed to differ).
check: all
	./serial test /app/serial.out
	rm -f $(wildcard /app/pgen_*.out)
	$(if $(UPCC),upcrun -n 8 -shared-heap 256MB ./pgen test,./pgen 8 test)
	cat $(wildcard /app/pgen_*.out) | sort > /tmp/pgen.sorted
	sort /app/serial.out > /tmp/serial.sorted
	@echo "serial contigs: $$(wc -l < /app/serial.out)  parallel contigs: $$(cat $(wildcard /app/pgen_*.out) | wc -l)"
	diff -u /tmp/serial.sorted /tmp/pgen.sorted && echo "CONTIG SETS IDENTICAL"

.PHONY: all clean check
