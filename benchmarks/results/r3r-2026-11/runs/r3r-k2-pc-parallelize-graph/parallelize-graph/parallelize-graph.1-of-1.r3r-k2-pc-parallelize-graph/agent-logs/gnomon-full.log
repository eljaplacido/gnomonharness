[approval] bash: cat > /app/serial.c << 'EOF'
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define MAXK 128

typedef struct { char k[MAXK]; char left; char right; int next; } Node;

static Node *nd = NULL;
static int ncap = 0, n = 0, *head = NULL, nbuckets = 0, klen = 0;

static unsigned khash(const char *s)
{
    unsigned h = 2166136261u;
    while (*s) { h ^= (unsigned char)*s++; h *= 16777619u; }
    return h;
}

static int hfind(const char *k)
{
    unsigned b = khash(k) % (unsigned)nbuckets;
    int i;
    for (i = head[b]; i != -1; i = nd[i].next)
        if (strcmp(nd[i].k, k) == 0) return i;
    return -1;
}

static int hinsert(const char *k)
{
    unsigned b;
    int i = hfind(k);
    if (i != -1) return i;
    if (n == ncap) {
        ncap = ncap ? ncap * 2 : 1024;
        nd = (Node *)realloc(nd, (size_t)ncap * sizeof(Node));
        if (!nd) { perror("realloc"); exit(1); }
    }
    memset(&nd[n], 0, sizeof(Node));
    strcpy(nd[n].k, k);
    b = khash(k) % (unsigned)nbuckets;
    nd[n].next = head[b];
    head[b] = n;
    return n++;
}

static void die(const char *what) { perror(what); exit(1); }

int main(int argc, char **argv)
{
    const char *inpath  = (argc > 1) ? argv[1] : "test";
    const char *outpath = (argc > 2) ? argv[2] : "/app/serial.out";
    FILE *fp, *out;
    char line[MAXK + 64], key[MAXK];
    int *rsucc, *lpred, *indeg, *seeds, nseeds = 0;
    int i, j, b;
    char *buf;

    fp = fopen(inpath, "r");
    if (!fp) die(inpath);
    {
        long lines = 0;
        while (fgets(line, sizeof(line), fp)) lines++;
        rewind(fp);
        nbuckets = (int)(lines > 0 ? lines * 2 : 1024);
        head = (int *)malloc((size_t)nbuckets * sizeof(int));
        if (!head) die("malloc");
        for (b = 0; b < nbuckets; b++) head[b] = -1;
    }

    while (fgets(line, sizeof(line), fp)) {
        char *tab; size_t len;
        line[strcspn(line, "\r\n")] = '\0';
        if (line[0] == '\0') continue;
        tab = strchr(line, '\t');
        if (!tab) continue;
        *tab = '\0';
        len = strlen(line);
        if (len == 0) continue;
        if (klen == 0) { klen = (int)len; if (klen >= MAXK) { fprintf(stderr, "k too large\n"); return 1; } }
        if ((int)len != klen) continue;
        i = hinsert(line);
        nd[i].left  = tab[1] ? tab[1] : 'F';
        nd[i].right = tab[2] ? tab[2] : 'F';
    }
    fclose(fp);
    if (n == 0) { fprintf(stderr, "no k-mers read from %s\n", inpath); return 1; }

    rsucc = (int *)malloc((size_t)n * sizeof(int));
    lpred = (int *)malloc((size_t)n * sizeof(int));
    indeg = (int *)malloc((size_t)n * sizeof(int));
    seeds = (int *)malloc((size_t)n * sizeof(int));
    if (!rsucc || !lpred || !indeg || !seeds) die("malloc");
    for (i = 0; i < n; i++) indeg[i] = 0;

    key[klen] = '\0';
    for (i = 0; i < n; i++) {
        rsucc[i] = -1;
        if (nd[i].right == 'F' || nd[i].right == '\0') continue;
        for (j = 1; j < klen; j++) key[j - 1] = nd[i].k[j];
        key[klen - 1] = nd[i].right;
        rsucc[i] = hfind(key);
        if (rsucc[i] != -1) indeg[rsucc[i]]++;
    }
    for (i = 0; i < n; i++) {
        lpred[i] = -1;
        if (nd[i].left == 'F' || nd[i].left == '\0') continue;
        key[0] = nd[i].left;
        for (j = 0; j < klen - 1; j++) key[j + 1] = nd[i].k[j];
        lpred[i] = hfind(key);
    }
    for (i = 0; i < n; i++) if (lpred[i] == -1) seeds[nseeds++] = i;

    out = fopen(outpath, "w");
    if (!out) die(outpath);
    buf = (char *)malloc((size_t)n * 2 + 256);
    if (!buf) die("malloc");
    for (i = 0; i < nseeds; i++) {
        int cur = seeds[i], len;
        memcpy(buf, nd[cur].k, (size_t)klen);
        len = klen;
        while (rsucc[cur] != -1) {
            int nx = rsucc[cur];
            if (indeg[nx] != 1) break;
            buf[len++] = nd[nx].k[klen - 1];
            cur = nx;
        }
        buf[len] = '\0';
        fprintf(out, "%s\n", buf);
    }
    fclose(out);
    fprintf(stderr, "serial: %d k-mers, %d seeds, contigs -> %s\n", n, nseeds, outpath);

    free(nd); free(head); free(rsucc); free(lpred); free(indeg); free(seeds); free(buf);
    return 0;
}
