from mailman.core.initialize import initialize
from mailman.config import config
from mailman.interfaces.listmanager import IListManager
from mailman.interfaces.mailinglist import SubscriptionPolicy
from mailman.interfaces.action import Action
from mailman.interfaces.autorespond import ResponseAction
from mailman.database.transaction import transaction
from zope.component import getUtility
from datetime import timedelta

initialize('/etc/mailman3/mailman.cfg')

with transaction():
    list_manager = getUtility(IListManager)
    mlist = list_manager.get('reading-group@local.edu')
    
    # Core settings
    mlist.subscription_policy = SubscriptionPolicy.open
    mlist.preferred_language = 'en'
    mlist.default_member_action = Action.accept
    mlist.default_nonmember_action = Action.accept
    mlist.owner_chain = 'default-owner-chain'
    mlist.posting_chain = 'default-posting-chain'
    mlist.owner_pipeline = 'default-owner-pipeline'
    mlist.posting_pipeline = 'default-posting-pipeline'
    
    # Autorespond settings
    mlist.autorespond_owner = ResponseAction.none
    mlist.autorespond_requests = ResponseAction.none
    mlist.autorespond_postings = ResponseAction.none
    mlist.autoresponse_grace_period = timedelta(0)
    
    # Moderation settings
    mlist.accept_these_nonmembers = []
    mlist.hold_these_nonmembers = []
    mlist.reject_these_nonmembers = []
    mlist.discard_these_nonmembers = []
    
    # Subject prefix
    mlist.subject_prefix = ''
    
    # Post ID
    if mlist.post_id is None:
        mlist.post_id = 0
    
    print('All settings configured')
    print(f'subscription_policy: {mlist.subscription_policy}')
    print(f'post_id: {mlist.post_id}')
