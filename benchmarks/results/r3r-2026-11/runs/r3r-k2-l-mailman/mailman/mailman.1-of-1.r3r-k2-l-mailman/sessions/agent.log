# Let me try a completely different approach:
# 1. Remove local.edu from mydestination
# 2. Use virtual_mailbox_domains for local.edu
# 3. Use virtual_alias_maps to redirect list addresses to LMTP
# 4. Use virtual_mailbox_maps to map user addresses to /var/mail/<username>

# First, let me remove local.edu from mydestination:
postconf -e "mydestination = \$myhostname, localhost, localhost.localdomain"
postconf -e "virtual_mailbox_domains = local.edu"
postconf -e "virtual_mailbox_maps = hash:/etc/postfix/virtual_mailbox"
postconf -e "virtual_alias_maps = hash:/etc/postfix/virtual_alias"
postconf -e "virtual_transport = local"

# Create virtual_mailbox map for local users:
cat > /etc/postfix/virtual_mailbox << 'EOF'
EOF

# Add entries for existing users:
for user in $(cut -d: -f1 /etc/passwd | grep -v root | head -20); do
    echo "${user}@local.edu ${user}" >> /etc/postfix/virtual_mailbox
done
cat /etc/postfix/virtual_mailbox

postmap /etc/postfix/virtual_mailbox
postfix reload 2>&1
sleep 1

