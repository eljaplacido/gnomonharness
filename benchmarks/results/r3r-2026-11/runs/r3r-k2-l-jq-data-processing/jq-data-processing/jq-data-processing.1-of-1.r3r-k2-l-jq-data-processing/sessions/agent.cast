[3.161695, "o", "source /installed-agent/install-agent.sh || echo 'INSTALL_FAIL_STATUS'; tmux wait -S done\r\n\u001b[?2004l\r"]
[18.710984, "o", "ARM_VERSION=be4fc0d8835c443aca8b32ccd4c1caacf48cbdce\r\n"]
