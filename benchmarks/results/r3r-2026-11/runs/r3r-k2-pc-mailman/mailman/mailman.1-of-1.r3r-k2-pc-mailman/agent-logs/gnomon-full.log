# For each runner section that has path: (empty), set it to $QUEUE_DIR/$name
# We need to be careful to only modify the path lines within runner sections
lines = content.split('\n')
new_lines = []
current_section = None
for line in lines:
    if line.startswith('[') and line.endswith(']'):
        current_section = line
    if current_section and current_section.startswith('[runner.') and line.strip() == 'path:':
        new_lines.append('path: $QUEUE_DIR/$name')
    else:
        new_lines.append(line)

with open('/etc/mailman3/mailman.cfg', 'w') as f:
    f.write('\n'.join(new_lines))

print("Fixed paths")
PYEOF
