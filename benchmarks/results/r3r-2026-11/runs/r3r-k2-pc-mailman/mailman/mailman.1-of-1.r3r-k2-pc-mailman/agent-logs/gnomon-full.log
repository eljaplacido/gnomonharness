[approval] bash: cat > /etc/mailman3/mailman.cfg << 'MAILMANCFG'
# Mailman 3 configuration for local.edu
# Based on schema.cfg for version 3.3.8

[mailman]
site_owner: admin@local.edu
noreply_address: noreply
default_language: en
sender_headers: from from_ reply-to sender
email_commands_max_lines: 10
pending_request_life: 3d
moderator_request_life: 180d
cache_life: 7d
layout: fhs
filtered_messages_are_preservable: no
html_to_plain_text_command: /usr/bin/lynx -dump $filename
filter_report: no
listname_chars: [-_.0-9a-z]
hold_digest: no
masthead_threshold: 4
check_max_size_on_filtered_message: no

[database]
class: mailman.database.sqlite.SQLiteDatabase
url: sqlite:////var/lib/mailman3/data/mailman.db
debug: no

[paths]
var_dir: /var/lib/mailman
queue_dir: /var/spool/mailman
bin_dir: /usr/bin
list_data_dir: /var/lib/mailman/lists
log_dir: /var/log/mailman
lock_dir: /var/lock/mailman
data_dir: /var/lib/mailman3/data
cache_dir: /var/lib/mailman/cache
etc_dir: /etc/mailman
ext_dir: /etc/mailman.d
messages_dir: /var/lib/mailman/messages
archive_dir: /var/lib/mailman/archives
template_dir: /var/lib/mailman/templates
pid_file: /var/run/mailman/master.pid
lock_file: /var/lock/mailman/master.lck

[mta]
incoming: mailman.mta.postfix.LMTP
outgoing: mailman.mta.deliver.deliver
smtp_host: localhost
smtp_port: 25
smtp_user:
smtp_pass:
smtp_secure_mode: smtp
smtp_verify_cert: yes
smtp_verify_hostname: yes
lmtp_host: 127.0.0.1
lmtp_port: 8024
max_recipients: 500
max_sessions_per_connection: 0
max_delivery_threads: 0
delivery_retry_period: 5d
verp_delimiter: +
verp_format: ${bounces}+${local}=${domain}
verp_confirm_format: $address+$cookie
verp_regexp: ^(?P<bounces>[^+]+?)\+(?P<local>[^=]+)=(?P<domain>[^@]+)@.*$
verp_confirm_regexp: ^(.*<)?(?P<addr>[^+]+?)\+(?P<cookie>[^@]+)@.*$
verp_confirmations: yes
verp_personalized_deliveries: no
verp_delivery_interval: 0
verp_probe_format: $bounces+$token@$domain
verp_probe_regexp: ^(?P<bounces>[^+]+?)\+(?P<token>[^@]+)@.*$
verp_probes: no
max_autoresponses_per_day: 10
remove_dkim_headers: no
configuration: python:mailman.config.postfix

[runner.in]
class: mailman.runners.incoming.IncomingRunner
path:
start: yes
instances: 1
max_restarts: 10
sleep_time: 1s

[runner.lmtp]
class: mailman.runners.lmtp.LMTPRunner
path:
start: yes
instances: 1
max_restarts: 10
sleep_time: 1s

[runner.command]
class: mailman.runners.command.CommandRunner
path:
start: yes
instances: 1
max_restarts: 10
sleep_time: 1s

[runner.out]
class: mailman.runners.outgoing.OutgoingRunner
path:
start: yes
instances: 1
max_restarts: 10
sleep_time: 1s

[runner.pipeline]
class: mailman.runners.pipeline.PipelineRunner
path:
start: yes
instances: 1
max_restarts: 10
sleep_time: 1s

[runner.virgin]
class: mailman.runners.virgin.VirginRunner
path:
start: yes
instances: 1
max_restarts: 10
sleep_time: 1s

[runner.digest]
class: mailman.runners.digest.DigestRunner
path:
start: yes
instances: 1
max_restarts: 10
sleep_time: 1s

[runner.archive]
class: mailman.runners.archive.ArchiveRunner
path:
start: yes
instances: 1
max_restarts: 10
sleep_time: 1s

[runner.bounces]
class: mailman.runners.bounce.BounceRunner
path:
start: yes
instances: 1
max_restarts: 10
sleep_time: 2m

[runner.task]
class: mailman.runners.task.TaskRunner
path:
start: yes
instances: 1
max_restarts: 10
sleep_time: 1m

[runner.retry]
class: mailman.runners.retry.RetryRunner
path:
start: yes
instances: 1
max_restarts: 10
sleep_time: 15m

[runner.rest]
class: mailman.runners.rest.RESTRunner
path:
start: yes
instances: 1
max_restarts: 10
sleep_time: 1s

[logging.root]
level: info
format: %(asctime)s (%(process)d) %(message)s
datefmt: %b %d %H:%M:%S %Y
propagate: no

[logging.database]
level: warn

[logging.debug]
path: debug.log
level: info

[logging.error]
path: error.log

[logging.smtp]
path: smtp.log

[logging.subscribe]
path: subscribe.log

[logging.bounce]
path: bounce.log

[logging.task]
path: task.log

[logging.runner]
path: runner.log

[logging.archiver]
path: archiver.log

[logging.plugins]
path: plugins.log

[logging.http]
path: http.log

[logging.mischief]
path: mischief.log

[logging.locks]
path: locks.log

[logging.fromusenet]
path: fromusenet.log

[logging.vette]
path: vette.log

[webservice]
hostname: localhost
port: 8001
use_https: no
show_tracebacks: yes
api_version: 3.1
admin_user: restadmin
admin_pass: restpass
workers: 2
configuration: python:mailman.config.gunicorn

[bounces]
register_bounces_every: 15m

[antispam]
header_checks:
jump_chain: hold

[styles]
default: legacy-default

[digests]
mime_digest_keep_headers: Date From To Cc Subject Message-ID Keywords In-Reply-To References Content-Type MIME-Version Content-Transfer-Encoding Precedence Reply-To Message List-Post
plain_digest_keep_headers: Message Date From Subject To Cc Message-ID Keywords Content-Type MIME-Version Content-Transfer-Encoding Precedence Reply-To

[language.en]
description: English (USA)
charset: us-ascii
enabled: yes

[devmode]
enabled: no
recipient:
testing: no
wait: 60s

[passwords]
configuration: python:mailman.config.passlib
password_length: 8

[shell]
prompt: >>>
banner: Welcome to the GNU Mailman shell
use_ipython: no
history_file:

[ARC]
enabled: no
dmarc: yes
dkim: yes
authserv_id:
trusted_authserv_ids:
privkey:
selector:
domain:
sig_headers: From, Sender, Reply-To, Subject, Date, Message-ID, To, Cc, MIME-Version, Content-Type, Content-Transfer-Encoding, Content-ID, Content-Description, Resent-Date, Resent-From, Resent-Sender, Resent-To, Resent-Cc, Resent-Message-ID, In-Reply-To, References, List-Id, List-Help, List-Unsubscribe, List-Subscribe, List-Post, List-Owner, List-Archive

[nntp]
user:
password:
host:
port:
remove_headers: nntp-posting-host nntp-posting-date x-trace x-complaints-to xref date-received posted posting-version relay-version received
rewrite_duplicate_headers: To X-Original-To CC X-Original-CC Content-Transfer-Encoding X-Original-Content-Transfer-Encoding MIME-Version X-MIME-Version
gatenews_every: 5m

[dmarc]
resolver_timeout: 3s
resolver_lifetime: 5s
org_domain_data_url: https://publicsuffix.org/list/public_suffix_list.dat
cache_lifetime: 7d
