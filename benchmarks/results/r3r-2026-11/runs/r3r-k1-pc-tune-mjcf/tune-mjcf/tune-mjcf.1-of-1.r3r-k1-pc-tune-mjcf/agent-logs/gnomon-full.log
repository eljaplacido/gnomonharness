import mujoco, time, numpy as np

model_ref = mujoco.MjModel.from_xml_path('model_ref.xml')

# Test different disable combinations
# CONTACT=1, FRICTIONLOSS=4, LIMIT=8, SENSOR=1024, PASSIVE=16384
# We need to keep CONTACT for the cable plugin
# So try: SENSOR | PASSIVE | LIMIT | FRICTIONLOSS = 1024 | 16384 | 8 | 4 = 17420

configs = [
    ('baseline', 0),
    ('SENSOR', 1024),
    ('PASSIVE', 16384),
    ('LIMIT', 8),
    ('FRICTIONLOSS', 4),
    ('SENSOR+PASSIVE', 1024 | 16384),
    ('SENSOR+PASSIVE+LIMIT', 1024 | 16384 | 8),
    ('SENSOR+PASSIVE+LIMIT+FRICTIONLOSS', 1024 | 16384 | 8 | 4),
    ('LIMIT+FRICTIONLOSS', 8 | 4),
    ('SENSOR+LIMIT', 1024 | 8),
    ('PASSIVE+LIMIT', 16384 | 8),
]

rng = np.random.default_rng(42)
d_base = mujoco.MjData(model_ref)
d_base.qpos += rng.normal(0, 0.01, size=d_base.qpos.shape)

d_ref = mujoco.MjData(model_ref)
d_ref.qpos[:] = d_base.qpos[:]
mujoco.mj_forward(model_ref, d_ref)
nstep = int(2.0 / model_ref.opt.timestep)
for _ in range(nstep):
    mujoco.mj_step(model_ref, d_ref)

full_physics = mujoco.mjtState.mjSTATE_FULLPHYSICS
state_ref = np.zeros(mujoco.mj_stateSize(model_ref, full_physics))
mujoco.mj_getState(model_ref, d_ref, state_ref, full_physics)

for name, flags in configs:
    model = mujoco.MjModel.from_xml_path('model_ref.xml')
    model.opt.disableflags = flags
    d_test = mujoco.MjData(model)
    d_test.qpos[:] = d_base.qpos[:]
    mujoco.mj_forward(model, d_test)
    t0 = time.perf_counter()
    for _ in range(nstep):
        mujoco.mj_step(model, d_test)
    t1 = time.perf_counter()
    
    state_test = np.zeros(mujoco.mj_stateSize(model, full_physics))
    mujoco.mj_getState(model, d_test, state_test, full_physics)
    diff = np.max(np.abs(state_test - state_ref))
    ratio = (t1-t0) / 0.2676
    status = 'PASS' if np.allclose(state_test, state_ref, atol=1e-5) else f'FAIL(diff={diff:.2e})'
    print(f'{name:30s} flags={flags:5d} ratio={ratio:.3f} max_diff={diff:.2e} {status}')
