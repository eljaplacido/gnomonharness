import mujoco
# Let me check if there's a way to access the cable plugin's internal settings
# The cable plugin might have internal settings that can be tuned
# Let me check the MuJoCo source code for the cable plugin

# Actually, let me try a different approach: check if there's a way to
# reduce the cable plugin's computational cost by modifying the model
# structure without changing the physics

# The cable plugin computes forces based on twist and bend stiffness
# These are very high (1e7 and 4e6), which makes the system stiff
# The stiffness determines the maximum stable timestep

# Let me check if there's a way to use a different integration scheme
# that is more stable for stiff systems
# The implicit integrator might be more stable, but it was slower

# Actually, let me check if there's a way to use the implicitfast integrator
# with a larger timestep
# The implicitfast integrator is designed for stiff systems
# Let me test it with different timesteps

import time
import numpy as np

model_ref = mujoco.MjModel.from_xml_path('model_ref.xml')
seeds = [0, 1, 2, 3, 4]

# Test implicitfast with different timesteps
timesteps = [0.002, 0.003, 0.004, 0.005]

for ts in timesteps:
    xml_path = f'/tmp/model_test.xml'
    with open('model_ref.xml', 'r') as f:
        xml = f.read()
    xml = xml.replace('<size memory=\"2M\"/>', f'<size memory=\"2M\"/>\n  <option timestep=\"{ts}\" integrator=\"2\"/>')
    with open(xml_path, 'w') as f:
        f.write(xml)
    
    model = mujoco.MjModel.from_xml_path(xml_path)
    nstep_ref = int(2.0 / model_ref.opt.timestep)
    nstep_test = int(2.0 / model.opt.timestep)
    
    max_diff = 0.0
    n_fail = 0
    total_t = 0
    
    for seed in seeds:
        rng = np.random.default_rng(seed)
        
        d_base = mujoco.MjData(model_ref)
        d_base.qpos += rng.normal(0, 0.01, size=d_base.qpos.shape)
        
        d_ref = mujoco.MjData(model_ref)
        d_ref.qpos[:] = d_base.qpos[:]
        mujoco.mj_forward(model_ref, d_ref)
        for _ in range(nstep_ref):
            mujoco.mj_step(model_ref, d_ref)
        
        d_test = mujoco.MjData(model)
        d_test.qpos[:] = d_base.qpos[:]
        mujoco.mj_forward(model, d_test)
        t0 = time.perf_counter()
        for _ in range(nstep_test):
            mujoco.mj_step(model, d_test)
        t1 = time.perf_counter()
        
        full_physics = mujoco.mjtState.mjSTATE_FULLPHYSICS
        state_ref = np.zeros(mujoco.mj_stateSize(model_ref, full_physics))
        state_test = np.zeros(mujoco.mj_stateSize(model, full_physics))
        mujoco.mj_getState(model_ref, d_ref, state_ref, full_physics)
        mujoco.mj_getState(model, d_test, state_test, full_physics)
        
        diff = np.max(np.abs(state_test - state_ref))
        max_diff = max(max_diff, diff)
        
        if not np.allclose(state_test, state_ref, atol=1e-5):
            n_fail += 1
        
        total_t += t1 - t0
    
    avg_t = total_t / len(seeds)
    ratio = avg_t / 0.2676
    status = 'PASS' if n_fail == 0 else f'FAIL({n_fail})'
    print(f'ts={ts:.3f} avg_t={avg_t:.4f}s ratio={ratio:.3f} max_diff={max_diff:.2e} {status}')
