import mujoco, time, numpy as np

# Check if removing geoms affects the physics
# The cable has 41 geoms (one per segment)
# These are used for visualization and contact detection
# If there are no contacts, removing geoms should not affect the physics

model_ref = mujoco.MjModel.from_xml_path('model_ref.xml')
print(f'ngeom: {model_ref.ngeom}')

# Check if the geoms are used for contact detection
# The cable geoms are capsules with size=0.005
# The slider geom is size=0.01
# With no contacts (ncon=0), the geoms are only used for visualization

# Let me check if removing the geoms affects the physics
# by comparing the states with and without geoms

# First, let me check the current state with geoms
d = mujoco.MjData(model_ref)
rng = np.random.default_rng(42)
d.qpos += rng.normal(0, 0.01, size=d.qpos.shape)
mujoco.mj_forward(model_ref, d)
nstep = int(2.0 / model_ref.opt.timestep)
for _ in range(nstep):
    mujoco.mj_step(model_ref, d)

full_physics = mujoco.mjtState.mjSTATE_FULLPHYSICS
state_with_geoms = np.zeros(mujoco.mj_stateSize(model_ref, full_physics))
mujoco.mj_getState(model_ref, d, state_with_geoms, full_physics)

# Now let me create a model without geoms
xml_path = '/tmp/model_no_geoms.xml'
with open('model_ref.xml', 'r') as f:
    xml = f.read()

# Remove all geom elements from the composite
# The composite has one geom element: <geom type=\"capsule\" size=\".005\" rgba=\".8 .2 .1 1\" condim=\"1\"/>
# We need to remove this geom element
xml = xml.replace('<geom type=\"capsule\" size=\".005\" rgba=\".8 .2 .1 1\" condim=\"1\"/>', '')

# Also remove the slider geom
xml = xml.replace('<geom size=\".01\"/>', '')

with open(xml_path, 'w') as f:
    f.write(xml)

model = mujoco.MjModel.from_xml_path(xml_path)
print(f'ngeom (no geoms): {model.ngeom}')

# Test timing and accuracy
d_test = mujoco.MjData(model)
d_test.qpos[:] = d.qpos[:]
mujoco.mj_forward(model, d_test)
t0 = time.perf_counter()
for _ in range(nstep):
    mujoco.mj_step(model, d_test)
t1 = time.perf_counter()

state_no_geoms = np.zeros(mujoco.mj_stateSize(model, full_physics))
mujoco.mj_getState(model, d_test, state_no_geoms, full_physics)

diff = np.max(np.abs(state_no_geoms - state_with_geoms))
print(f'Time: {t1-t0:.4f}s')
print(f'Max diff: {diff:.2e}')
print(f'Passes atol=1e-5: {np.allclose(state_no_geoms, state_with_geoms, atol=1e-5)}')
