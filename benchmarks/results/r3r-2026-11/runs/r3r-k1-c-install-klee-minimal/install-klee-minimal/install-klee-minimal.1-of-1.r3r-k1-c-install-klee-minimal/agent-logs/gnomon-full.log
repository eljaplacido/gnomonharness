/* On architectures that use the asm-generic syscall ABI (e.g. aarch64) there
   is no legacy open/stat/lstat/access/select/chmod/chown/readlink/utimes
   syscall: only the *at variants exist. Rewrite the call sites below for that
   ABI so the POSIX runtime keeps working there. */
#if defined(__NR_openat) && !defined(__NR_open)
#define KLEE_ASM_GENERIC_SYSCALLS 1
#endif

#if defined(KLEE_ASM_GENERIC_SYSCALLS)
#ifndef AT_FDCWD
#define AT_FDCWD (-100)
#endif
#endif

'''
old_inc='''#include <termios.h>
#include <unistd.h>

'''
assert s.count(old_inc)==1
s=s.replace(old_inc, shim)

def sub1(old, new):
    global s
    assert s.count(old)==1, (s.count(old), old)
    s=s.replace(old,new)

# access -> faccessat(AT_FDCWD, ...)
sub1('''  return syscall(__NR_access, __concretize_string(pathname), mode);''',
'''#if defined(KLEE_ASM_GENERIC_SYSCALLS)
  return syscall(__NR_faccessat, AT_FDCWD, __concretize_string(pathname), mode);
#else
  return syscall(__NR_access, __concretize_string(pathname), mode);
#endif''')

# open -> openat(AT_FDCWD, ...)
sub1('''    int os_fd = syscall(__NR_open, __concretize_string(pathname), flags, mode);''',
'''#if defined(KLEE_ASM_GENERIC_SYSCALLS)
    int os_fd =
        syscall(__NR_openat, AT_FDCWD, __concretize_string(pathname), flags, mode);
#else
    int os_fd = syscall(__NR_open, __concretize_string(pathname), flags, mode);
#endif''')

# utimes -> utimensat
sub1('''  return syscall(__NR_utimes, __concretize_string(path), times);''',
'''#if defined(KLEE_ASM_GENERIC_SYSCALLS)
  {
    /* utimensat takes struct timespec[2], utimes takes struct timeval[2]. */
    struct timespec ts[2];
    if (times) {
      ts[0].tv_sec = times[0].tv_sec;
      ts[0].tv_nsec = times[0].tv_usec * 1000;
      ts[1].tv_sec = times[1].tv_sec;
      ts[1].tv_nsec = times[1].tv_usec * 1000;
    }
    return syscall(__NR_utimensat, AT_FDCWD, __concretize_string(path),
                   times ? ts : NULL, 0);
  }
#else
  return syscall(__NR_utimes, __concretize_string(path), times);
#endif''')

# futimesat -> utimensat
sub1('''  return syscall(__NR_futimesat, (long)fd,
                 (path ? __concretize_string(path) : NULL), times);''',
'''#if defined(KLEE_ASM_GENERIC_SYSCALLS)
  {
    struct timespec ts[2];
    if (times) {
      ts[0].tv_sec = times[0].tv_sec;
      ts[0].tv_nsec = times[0].tv_usec * 1000;
      ts[1].tv_sec = times[1].tv_sec;
      ts[1].tv_nsec = times[1].tv_usec * 1000;
    }
    return syscall(__NR_utimensat, (long)fd,
                   (path ? __concretize_string(path) : NULL), times ? ts : NULL,
                   0);
  }
#else
  return syscall(__NR_futimesat, (long)fd,
                 (path ? __concretize_string(path) : NULL), times);
#endif''')

# stat -> newfstatat
sub1('''#if __WORDSIZE == 64
    return syscall(__NR_stat, __concretize_string(path), buf);
#else''',
'''#if defined(KLEE_ASM_GENERIC_SYSCALLS)
    return syscall(__NR_newfstatat, AT_FDCWD, __concretize_string(path), buf, 0);
#elif __WORDSIZE == 64
    return syscall(__NR_stat, __concretize_string(path), buf);
#else''')

# lstat -> newfstatat(AT_SYMLINK_NOFOLLOW)
sub1('''#if __WORDSIZE == 64
    return syscall(__NR_lstat, __concretize_string(path), buf);
#else''',
'''#if defined(KLEE_ASM_GENERIC_SYSCALLS)
#ifndef AT_SYMLINK_NOFOLLOW
#define AT_SYMLINK_NOFOLLOW 0x100
#endif
    return syscall(__NR_newfstatat, AT_FDCWD, __concretize_string(path), buf,
                   AT_SYMLINK_NOFOLLOW);
#elif __WORDSIZE == 64
    return syscall(__NR_lstat, __concretize_string(path), buf);
#else''')

# fstatat fallback branch
sub1('''#if (defined __NR_newfstatat) && (__NR_newfstatat != 0)
  return syscall(__NR_newfstatat, (long)fd, PATHPARAM, buf, (long)flags);
#else''',
'''#if (defined __NR_newfstatat) && (__NR_newfstatat != 0)
  return syscall(__NR_newfstatat, (long)fd, PATHPARAM, buf, (long)flags);
#elif __WORDSIZE == 64
