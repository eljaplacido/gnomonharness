#else''')

# chmod -> fchmodat, fchownat, readlinkat
sub1('''  return syscall(__NR_chmod, __concretize_string(path), mode);''',
'''#if defined(KLEE_ASM_GENERIC_SYSCALLS)
  return syscall(__NR_fchmodat, AT_FDCWD, __concretize_string(path), mode);
