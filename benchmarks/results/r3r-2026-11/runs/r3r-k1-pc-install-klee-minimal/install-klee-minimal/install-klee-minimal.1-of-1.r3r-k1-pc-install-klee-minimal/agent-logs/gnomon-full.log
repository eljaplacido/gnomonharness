import sys

def fix_file(filepath):
    with open(filepath, 'r') as f:
        lines = f.readlines()
    
    result = []
    i = 0
    while i < len(lines):
        line = lines[i]
        if 'llvm::cl::values(' in line:
            # Replace llvm::cl::values( with nothing
            line = line.replace('llvm::cl::values(', '')
            result.append(line)
            i += 1
            
            # Collect lines until matching closing paren
            paren_depth = 1
            while i < len(lines) and paren_depth > 0:
                line = lines[i]
                for ch in line:
                    if ch == '(':
                        paren_depth += 1
                    elif ch == ')':
                        paren_depth -= 1
                        if paren_depth == 0:
                            # Last line of the block
                            stripped = line.rstrip()
                            # The original has: clEnumValN(...)),  (closes clEnumValN + values())
                            # After removing values(, we need: clEnumValN(...),  (comma to next arg)
                            # Or: clEnumValN(...)),  -> clEnumValN(...),  if followed by llvm::cl::
                            if stripped.endswith(')),'):
                                stripped = stripped[:-2] + ','  # replace )), with ,
                            elif stripped.endswith('))'):
                                stripped = stripped[:-2] + ','  # replace )) with ,
                            elif stripped.endswith('),'):
                                stripped = stripped[:-1]  # just remove trailing comma
                            elif stripped.endswith(')'):
                                stripped = stripped + ','  # add comma
                            result.append(stripped + '\n')
                            i += 1
                            break
                        else:
                            result.append(line)
                            i += 1
                            break
                    else:
                        result.append(line)
                        i += 1
                        break
        else:
            result.append(line)
            i += 1
    
    with open(filepath, 'w') as f:
        f.writelines(result)

for f in sys.argv[1:]:
    fix_file(f)
    print(f"Fixed: {f}")
PYEOF

