import re
import sys

def fix_file(filepath):
    with open(filepath, 'r') as f:
        lines = f.readlines()
    
    result = []
    i = 0
    while i < len(lines):
        line = lines[i]
        if 'llvm::cl::values(' in line:
            # Collect the entire block until we find the closing )
            block_start = i
            # Replace llvm::cl::values( with nothing on this line
