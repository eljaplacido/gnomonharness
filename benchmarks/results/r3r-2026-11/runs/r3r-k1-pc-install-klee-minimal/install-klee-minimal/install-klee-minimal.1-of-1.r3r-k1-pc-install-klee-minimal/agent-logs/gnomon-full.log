import re
import sys

def fix_file(filepath):
    with open(filepath, 'r') as f:
        content = f.read()
    
    # Pattern: llvm::cl::values( ... ) where ... contains clEnumValN calls
    # We need to remove the llvm::cl::values( wrapper and fix commas
    
    # Strategy: find each llvm::cl::values( ... ) block and process it
    # The block starts with llvm::cl::values( and ends with the matching )
    
    result = []
    i = 0
    while i < len(content):
        # Look for llvm::cl::values(
        idx = content.find('llvm::cl::values(', i)
        if idx == -1:
            result.append(content[i:])
            break
        
        result.append(content[i:idx])
        
        # Find the matching closing paren
        start = idx + len('llvm::cl::values(')
        depth = 1
        j = start
        while j < len(content) and depth > 0:
            if content[j] == '(':
                depth += 1
            elif content[j] == ')':
                depth -= 1
            j += 1
        
        block = content[start:j-1]  # content inside the parens
        
        # Now we need to parse the block and remove trailing commas from clEnumValN lines
        # that are followed by a closing paren or by llvm::cl::init/cat/desc
        
        lines = block.split('\n')
        new_lines = []
        for k, line in enumerate(lines):
            stripped = line.rstrip()
            # Check if this line ends a clEnumValN and is the last one before ) or llvm::cl::
            if stripped.endswith('),') or stripped.endswith('))'):
                # Check if next non-empty line starts with llvm::cl:: or is just )
                next_idx = k + 1
                while next_idx < len(lines) and lines[next_idx].strip() == '':
                    next_idx += 1
                
                if next_idx < len(lines):
                    next_line = lines[next_idx].strip()
                    if next_line == ')' or next_line.startswith('llvm::cl::'):
                        # Remove trailing comma
                        stripped = stripped.rstrip(',')
                        # If it ends with )), change to ))
                        if stripped.endswith('))'):
                            stripped = stripped[:-1] + ')'
                        elif stripped.endswith('),'):
                            stripped = stripped[:-1]
                        elif stripped.endswith(')'):
                            pass  # already correct
            new_lines.append(line.replace(stripped.rstrip(), stripped) if stripped != line.rstrip() else line)
        
        result.append('clEnumValN' + block)
        i = j
    
    new_content = ''.join(result)
    with open(filepath, 'w') as f:
        f.write(new_content)

for f in sys.argv[1:]:
    fix_file(f)
    print(f"Fixed: {f}")
