import sys

def fix_file(filepath):
    with open(filepath, 'r') as f:
        content = f.read()
    
    # Find all occurrences of llvm::cl::values( and replace them
    # We need to find the matching closing paren for each
    
    result = []
    i = 0
    while i < len(content):
        idx = content.find('llvm::cl::values(', i)
        if idx == -1:
            result.append(content[i:])
            break
        
        result.append(content[i:idx])
        
        # Find matching closing paren
        start = idx + len('llvm::cl::values(')
        depth = 1
        j = start
        while j < len(content) and depth > 0:
            if content[j] == '(':
                depth += 1
            elif content[j] == ')':
                depth -= 1
            j += 1
        
        # j now points past the closing paren
        # The content inside is content[start:j-1]
        # The content after is content[j:]
        # We need to check if the char after the closing paren is a comma
        # and if so, keep it (it's the comma separating from next arg)
        
        inner = content[start:j-1]
        after = content[j:]
        
        # Check if after starts with ,
        if after.startswith(','):
            # The comma separates from the next argument (llvm::cl::init etc.)
            # The inner content ends with clEnumValN(...))
            # We need to change )) to ),
            # But only the last )) on the last line
            # Split inner into lines, fix the last line
            inner_lines = inner.split('\n')
            if inner_lines:
                last = inner_lines[-1].rstrip()
                if last.endswith(')),'):
                    inner_lines[-1] = last[:-3] + ','
                elif last.endswith('))'):
                    inner_lines[-1] = last[:-2] + ','
                elif last.endswith('),'):
                    inner_lines[-1] = last[:-1]
                elif last.endswith(')'):
                    inner_lines[-1] = last + ','
            inner = '\n'.join(inner_lines)
            
            result.append(inner)
            result.append(after)  # keep the comma
        else:
            # No comma after — the values() block was the last arg
            # The inner ends with clEnumValN(...))
            inner_lines = inner.split('\n')
            if inner_lines:
                last = inner_lines[-1].rstrip()
                if last.endswith(')),'):
                    inner_lines[-1] = last[:-3]
                elif last.endswith('))'):
                    inner_lines[-1] = last[:-2]
                elif last.endswith('),'):
                    inner_lines[-1] = last[:-1]
                elif last.endswith(')'):
                    pass
            inner = '\n'.join(inner_lines)
            result.append(inner)
            result.append(after)
        
        i = j
    
    with open(filepath, 'w') as f:
        f.write(''.join(result))

for f in sys.argv[1:]:
    fix_file(f)
    print(f"Fixed: {f}")
