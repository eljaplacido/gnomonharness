s.load(fs.readFileSync('/app/university_graph.ttl','utf8'), {format:'text/turtle', base_iri:'http://example.org/'});
const q = `PREFIX uni:<http://university.org/ontology/> PREFIX xsd:<http://www.w3.org/2001/XMLSchema#>
SELECT ?d (COUNT(DISTINCT ?st) AS ?n) WHERE {
 ?st uni:isEnrolledIn ?c . ?c uni:isTaughtIn ?d .
 ?st uni:hasEnrollmentDate ?e . FILTER(?e <= "2025-08-16"^^xsd:date)
 OPTIONAL { ?st uni:hasGraduationDate ?g } FILTER(!BOUND(?g) || ?g > "2025-08-16"^^xsd:date)
} GROUP BY ?d ORDER BY DESC(?n)`;
for (const b of s.query(q)) console.log([...b].map(([k,v])=>`${k.value??k}=${v.value}`).join(' '));
EOF
