# Check for curl/wget
for keyword in ['curl ', 'wget ']:
    if keyword in content:
        errors.append(f'Contains {keyword!r}')

# Check for third-party actions (not actions/*)
for line in lines:
    stripped = line.strip()
    if stripped.startswith('uses:'):
        action = stripped.split(':', 1)[1].strip()
        if not action.startswith('actions/'):
            errors.append(f'Non-first-party action: {action}')

if errors:
    for e in errors:
        print(f'ERROR: {e}')
else:
    print('YAML structure checks passed: no tabs, no secrets.*, no curl/wget, all actions are first-party')
