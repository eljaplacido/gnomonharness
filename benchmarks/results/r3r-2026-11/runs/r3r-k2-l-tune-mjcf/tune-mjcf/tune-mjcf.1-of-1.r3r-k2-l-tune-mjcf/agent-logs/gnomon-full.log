import mujoco
import numpy as np
import tempfile, os

def test_model(xml_mod, label):
    fd, path = tempfile.mkstemp(suffix='.xml')
    with os.fdopen(fd, 'w') as f:
        f.write(xml_mod)
    
    m = mujoco.MjModel.from_xml_path(path)
    d = mujoco.MjData(m)
    np.random.seed(42)
    d.qpos += np.random.normal(0, 0.01, size=d.qpos.shape)
    mujoco.mj_forward(m, d)
    
    nstep = int(2.0 / m.opt.timestep)
    for _ in range(nstep):
        mujoco.mj_step(m, d)
    
    full_physics = mujoco.mjtState.mjSTATE_FULLPHYSICS
    state = np.zeros(mujoco.mj_stateSize(m, full_physics))
    mujoco.mj_getState(m, d, state, full_physics)
    
    os.unlink(path)
    return state, m.opt.timestep

# Get reference
ref_xml = open('model_ref.xml').read()
ref_state, ref_ts = test_model(ref_xml, 'ref')

# Test with different solver
for solver_name in ['cg', 'newton']:
    xml = ref_xml.replace('<compiler autolimits=\"true\"/>', '<compiler autolimits=\"true\"/><option solver=\"' + solver_name + '\"/>')
    state, ts = test_model(xml, solver_name)
