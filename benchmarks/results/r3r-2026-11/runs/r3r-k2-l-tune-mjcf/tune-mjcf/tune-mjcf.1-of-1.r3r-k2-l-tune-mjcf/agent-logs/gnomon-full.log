import mujoco
import numpy as np
import tempfile, os
import time

def benchmark_model(xml_content, n_runs=5):
    fd, path = tempfile.mkstemp(suffix='.xml')
    with os.fdopen(fd, 'w') as f:
        f.write(xml_content)
    
    m = mujoco.MjModel.from_xml_path(path)
    times = []
    for _ in range(n_runs):
        d = mujoco.MjData(m)
        np.random.seed(np.random.randint(0, 10000))
        d.qpos += np.random.normal(0, 0.01, size=d.qpos.shape)
        mujoco.mj_forward(m, d)
        
        nstep = int(2.0 / m.opt.timestep)
        t0 = time.perf_counter()
        for _ in range(nstep):
            mujoco.mj_step(m, d)
        t1 = time.perf_counter()
        times.append(t1 - t0)
    
    os.unlink(path)
    return np.mean(times), m.opt.timestep, m.opt.solver

