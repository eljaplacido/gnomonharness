"""#define shared                          /* one flat address space here */

/* A shared scalar has exactly one instance that every thread sees: a plain
 * global has precisely those semantics. */
#define SHARED_SCALAR(T) T

/* A shared array *pointer* at file scope is private in UPC: each thread keeps
 * its own copy of the address.  Thread-local storage reproduces that.  (The
 * array itself is collective -- see shim_all_alloc.) */
#define SHARED_PTR(T) __thread T *""")
