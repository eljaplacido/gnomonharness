import json, torch
from transformers import AutoTokenizer, AutoModelForSequenceClassification

# Load merged model from disk
model = AutoModelForSequenceClassification.from_pretrained('/app/merged_model')
tokenizer = AutoTokenizer.from_pretrained('/app/merged_model')
model.eval()

# Verify config
print(f'num_labels: {model.config.num_labels}')
print(f'model_type: {model.config.model_type}')

# Re-run all 10 samples
samples = [
    'Bonjour, comment allez-vous aujourd'hui?',
    'Hola, ¿cómo estás hoy?',
    'Guten Tag, wie geht es Ihnen?',
    'Ciao, come stai oggi?',
    'Olá, como você está?',
    'Привет, как дела?',
    'こんにちは、お元気ですか？',
    '你好，你好吗？',
    'مرحبا، كيف حالك؟',
    'Hello, how are you?',
]

with open('/app/detection_results.json') as f:
    expected = json.load(f)

all_match = True
with torch.no_grad():
    for i, text in enumerate(samples):
        inputs = tokenizer(text, return_tensors='pt', truncation=True, max_length=512)
        outputs = model(**inputs)
        probs = torch.softmax(outputs.logits, dim=-1)
        pred = torch.argmax(probs, dim=-1).item()
        conf = probs[0][pred].item()
        match = pred == expected[i]['predicted_class_id']
        if not match:
            all_match = False
        print(f'[{pred}] {text[:40]:<45} (conf={conf:.4f}) match={match}')

print(f'\nAll predictions match: {all_match}')
