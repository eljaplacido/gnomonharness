import mailbox, os, subprocess, sys
sys.path.insert(0, '/app')
from time import sleep
import eval as ev

def wait(fn, tries=20, delay=2):
    last = None
    for _ in range(tries):
        try:
            return fn()
        except Exception as e:
            last = e
            sleep(delay)
    raise last

users = [os.urandom(8).hex() for _ in range(2)]
for u in users:
    ev.add_user(u)

JOIN = 'reading-group@local.edu'
