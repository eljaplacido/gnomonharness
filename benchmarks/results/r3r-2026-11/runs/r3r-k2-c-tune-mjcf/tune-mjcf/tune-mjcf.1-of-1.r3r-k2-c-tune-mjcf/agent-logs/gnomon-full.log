import mujoco, numpy as np, time

REF = 'model_ref.xml'
T = 2.0
FULL = mujoco.mjtState.mjSTATE_FULLPHYSICS

def build(mods):
    m = mujoco.MjModel.from_xml_path(REF)
    for k,v in mods.items():
        a,b = k.split('.'); setattr(getattr(m,a), b, v)
    return m

def state_of(m, seed):
    d = mujoco.MjData(m)
    rng = np.random.default_rng(seed)
    d.qpos += rng.normal(0, 0.01, size=d.qpos.shape)
    mujoco.mj_forward(m, d)
    for _ in range(int(T/m.opt.timestep)):
        mujoco.mj_step(m, d)
    s = np.zeros(mujoco.mj_stateSize(m, FULL))
    mujoco.mj_getState(m, d, s, FULL)
    return s

mref = mujoco.MjModel.from_xml_path(REF)
SEEDS = list(range(12))
refs = {s: state_of(mref, s) for s in SEEDS}

def bench(m, n=20):
    ts=[]
    for i in range(n):
        t0=time.perf_counter(); state_of(m, 1000+i); ts.append(time.perf_counter()-t0)
    return np.array(ts)

tref = bench(mref).mean()

cfgs = {
 'PGS':              {'opt.solver':0},
 'PGS_sparse':       {'opt.solver':0,'opt.jacobian':1},
 'CG':               {'opt.solver':1},
 'CG_sparse':        {'opt.solver':1,'opt.jacobian':1},
 'Newton_sparse':    {'opt.solver':2,'opt.jacobian':1},
 'PGS_iter20':       {'opt.solver':0,'opt.iterations':20},
 'PGS_tol1e-6':      {'opt.solver':0,'opt.tolerance':1e-6},
 'PGS_nocontact':    {'opt.solver':0,'opt.disableflags':1},
 'PGS_sparse_nc':    {'opt.solver':0,'opt.jacobian':1,'opt.disableflags':1},
 'Newton_nocontact': {'opt.disableflags':1},
}
print('ref mean %.4f' % tref)
for name, mods in cfgs.items():
    m = build(mods)
    worst = 0.0; worst_norm=0.0
    for s in SEEDS:
        st = state_of(m, s)
        dd = np.abs(st-refs[s]).max()
        worst = max(worst, dd); worst_norm=max(worst_norm, np.linalg.norm(st-refs[s]))
    t = bench(m).mean()
    print('%-18s pctg %.3f  worst_maxdiff %.3e  worst_norm %.3e' % (name, t/tref, worst, worst_norm))
