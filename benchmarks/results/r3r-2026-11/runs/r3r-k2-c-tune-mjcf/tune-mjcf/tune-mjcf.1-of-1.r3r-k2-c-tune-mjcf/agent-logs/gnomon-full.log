import mujoco, numpy as np
T=2.0; ATOL=1e-5; FULL=mujoco.mjtState.mjSTATE_FULLPHYSICS
def state_of(m,seed):
    d=mujoco.MjData(m); rng=np.random.default_rng(seed)
    d.qpos += rng.normal(0,0.01,size=d.qpos.shape); mujoco.mj_forward(m,d)
    for _ in range(int(T/m.opt.timestep)): mujoco.mj_step(m,d)
    s=np.zeros(mujoco.mj_stateSize(m,FULL)); mujoco.mj_getState(m,d,s,FULL)
    assert not np.isnan(s).any() and not np.isinf(s).any()
    return s
m=mujoco.MjModel.from_xml_path('model.xml')
mr=mujoco.MjModel.from_xml_path('model_ref.xml')
# structural / physical identity checks
assert m.nq==mr.nq and m.nv==mr.nv and m.nbody==mr.nbody and m.ngeom==mr.ngeom
assert np.allclose(m.body_mass, mr.body_mass)
assert np.allclose(m.body_inertia, mr.body_inertia)
assert np.allclose(m.dof_damping, mr.dof_damping)
assert np.allclose(m.geom_size, mr.geom_size)
assert np.allclose(m.opt.gravity, mr.opt.gravity)
print('physical properties identical to reference: OK')

worst=0.0; worst_seed=None
for seed in range(600):
    st=state_of(m,seed); sr=state_of(mr,seed)
    d=np.linalg.norm(st-sr); mx=np.abs(st-sr).max()
    assert np.allclose(st,sr,atol=ATOL), (seed,d)
    if d>worst: worst,worst_seed,worst_mx=d,seed,mx
