    assert np.allclose(state_of(m,seed), state_of(mr,seed), atol=ATOL), seed
print('600 fixed + 300 eval-style random seeds: all within atol=%g' % ATOL)
print('worst |state diff| (L2) = %.3e at seed %d' % (worst, worst_seed))
