import mujoco, numpy as np, sys

def run(path, ts=None, seed=0, T=2.0, **opts):
    m = mujoco.MjModel.from_xml_path(path)
    if ts is not None: m.opt.timestep = ts
    for k,v in opts.items(): setattr(m.opt, k, v)
    d = mujoco.MjData(m)
    rng = np.random.default_rng(seed)
    d.qpos += rng.normal(0, 0.01, size=d.qpos.shape)
    mujoco.mj_forward(m, d)
    n = int(T/m.opt.timestep)
    for _ in range(n):
        mujoco.mj_step(m, d)
    full = mujoco.mjtState.mjSTATE_FULLPHYSICS
    s = np.zeros(mujoco.mj_stateSize(m, full))
    mujoco.mj_getState(m, d, s, full)
    return s

seed = int(sys.argv[1]) if len(sys.argv)>1 else 0
ref = run('model_ref.xml', seed=seed)
print('ref state: norm %.4f  max %.4f  time %.4f' % (np.linalg.norm(ref), np.abs(ref).max(), ref[0]))
for ts in [0.0025, 0.003, 0.004, 0.005, 0.0015]:
    s = run('model_ref.xml', ts=ts, seed=seed)
    print('ts=%.4f  diff %.3e  maxdiff %.3e' % (ts, np.linalg.norm(s-ref), np.abs(s-ref).max()))
