import mujoco, numpy as np, time
T=2.0; FULL=mujoco.mjtState.mjSTATE_FULLPHYSICS
def sim_time(m, n=20):
    ts=[]
    for _ in range(n):
        seed=np.random.randint(0,10000)
        d=mujoco.MjData(m); rng=np.random.default_rng(seed)
        d.qpos += rng.normal(0,0.01,size=d.qpos.shape); mujoco.mj_forward(m,d)
        t0=time.perf_counter()
        for _ in range(int(T/m.opt.timestep)): mujoco.mj_step(m,d)
        ts.append(time.perf_counter()-t0)
    return np.array(ts)
m=mujoco.MjModel.from_xml_path('model.xml'); mr=mujoco.MjModel.from_xml_path('model_ref.xml')
pcts=[]
for trial in range(5):
    a=sim_time(m); b=sim_time(mr)
    pct=(a/b).mean(); pcts.append(pct)
    print('trial %d: tuned %.4fs ref %.4fs  speedup %.2fx  pctg %.3f' % (trial, a.mean(), b.mean(), (b/a).mean(), pct))
print('worst pctg over 5 trials: %.3f (target <= 0.60)' % max(pcts))
