import mujoco, numpy as np

def run(path, T=2.0, seed=0, mods=None, qpert=1e-12):
    m = mujoco.MjModel.from_xml_path(path)
    if mods:
        for k,v in mods.items():
            if '.' in k:
                a,b = k.split('.'); setattr(getattr(m,a), b, v)
            else: setattr(m, k, v)
    d = mujoco.MjData(m)
    rng = np.random.default_rng(seed)
    q = rng.normal(0, 0.01, size=d.qpos.shape)
    if qpert: q = q + rng.normal(0, qpert, size=d.qpos.shape)
    d.qpos += q
    mujoco.mj_forward(m, d)
    for _ in range(int(T/m.opt.timestep)): mujoco.mj_step(m, d)
    full = mujoco.mjtState.mjSTATE_FULLPHYSICS
    s = np.zeros(mujoco.mj_stateSize(m, full)); mujoco.mj_getState(m, d, s, full)
    return s

for seed in [0,1,2,3]:
    a = run('model_ref.xml', seed=seed, qpert=0)
    b = run('model_ref.xml', seed=seed, qpert=1e-12)
    print('seed', seed, 'pert 1e-12 -> final diff %.3e' % np.abs(a-b).max())
