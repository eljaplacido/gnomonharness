#!/bin/sh
# Create/refresh the reading-group@local.edu mailing list and start the stack.
# Idempotent: safe to re-run after the container restarts.
set -e

CFG=/etc/mailman3/mailman.cfg

# Postfix: accept mail for local.edu and hand list traffic to Mailman over LMTP.
postconf -e \
  'mydomain = local.edu' \
  'myorigin = local.edu' \
  'mydestination = $myhostname, localhost, localhost.localdomain, local.edu' \
  'transport_maps = hash:/var/lib/mailman3/data/postfix_lmtp' \
  'local_recipient_maps = proxy:unix:passwd.byname hash:/var/lib/mailman3/data/postfix_lmtp' \
  'owner_request_special = no' \
  'recipient_delimiter = +' \
  'smtpd_relay_restrictions = permit_mynetworks permit_sasl_authenticated permit'

mkdir -p /var/log/mailman3 /run/mailman3
chown list:list /var/log/mailman3 /run/mailman3
newaliases || true
postfix status >/dev/null 2>&1 || service postfix start

# Mailman: add the list if it is missing, then (re)apply its policies.
su list -s /bin/sh -c "mailman -C $CFG lists" | grep -q reading-group@local.edu ||
  su list -s /bin/sh -c "mailman -C $CFG create --quiet reading-group@local.edu"

cat > /tmp/reading-group-policy.py <<'PY'
from mailman.core.initialize import initialize
from mailman.database.transaction import transaction
from mailman.interfaces.action import Action
from mailman.interfaces.listmanager import IListManager
from mailman.interfaces.mailinglist import SubscriptionPolicy
from zope.component import getUtility

initialize('/etc/mailman3/mailman.cfg')
mlist = getUtility(IListManager).get('reading-group@local.edu')
with transaction():
    # Nobody approves joins, posts or leaves -- the user only confirms.
    mlist.subscription_policy = SubscriptionPolicy.open
    mlist.unsubscription_policy = SubscriptionPolicy.confirm
    mlist.default_member_action = Action.accept
    mlist.default_nonmember_action = Action.accept
    mlist.send_welcome_message = True
    mlist.send_goodbye_message = True
    mlist.subject_prefix = ''
    mlist.display_name = 'Reading Group'
PY
su list -s /bin/sh -c 'python3 /tmp/reading-group-policy.py'

# Mailman master (LMTP on 127.0.0.1:8024, REST on 8001).
if [ -r /run/mailman3/master.pid ] && kill -0 "$(cat /run/mailman3/master.pid)" 2>/dev/null; then
  su list -s /bin/sh -c "mailman -C $CFG restart"
else
  su list -s /bin/sh -c "mailman -C $CFG start --force"
fi

postfix reload
echo "reading-group@local.edu is ready"
