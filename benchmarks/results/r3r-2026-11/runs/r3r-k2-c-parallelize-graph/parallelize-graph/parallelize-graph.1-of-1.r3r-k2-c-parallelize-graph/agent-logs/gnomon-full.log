/*
 * dbg_common.h -- helpers shared by the serial and UPC implementations:
 * input record, k-mer encoding, hashing, contig storage.
 */
#ifndef DBG_COMMON_H
#define DBG_COMMON_H

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>

#define FEXT 4            /* "no extension" code */
#define MAXK 31           /* k-mers packed 2 bits/base into uint64_t */
#define BASES "ACGT"

typedef struct {
    uint64_t key;         /* 2-bit packed k-mer */
    uint8_t  lext;        /* 0..3 = A/C/G/T, 4 = F */
    uint8_t  rext;
} Kmer;

typedef struct {
    char  **items;
    size_t  n, cap;
} contig_set;

static inline int base_code(int c)
{
    switch (c) {
    case 'A': case 'a': return 0;
    case 'C': case 'c': return 1;
    case 'G': case 'g': return 2;
    case 'T': case 't': return 3;
    default:            return -1;
    }
}

static inline char code_base(int c) { return BASES[c & 3]; }

static inline uint64_t mix64(uint64_t x)
{
    x += 0x9E3779B97F4A7C15ULL;
    x = (x ^ (x >> 30)) * 0xBF58476D1CE4E5B9ULL;
    x = (x ^ (x >> 27)) * 0x94D049BB133111EBULL;
    return x ^ (x >> 31);
}

static inline uint64_t encode_kmer(const char *s, int k)
{
    uint64_t key = 0;
    int i;
    for (i = 0; i < k; i++)
        key = (key << 2) | (uint64_t)base_code((unsigned char)s[i]);
    return key;
}

static inline int ceil_pow2(int v)
{
    int p = 1024;
    while (p < v) p <<= 1;
    return p;
}

static void cs_add(contig_set *cs, const char *s, size_t len)
{
    if (cs->n == cs->cap) {
        cs->cap = cs->cap ? cs->cap * 2 : 256;
        cs->items = (char **)realloc(cs->items, cs->cap * sizeof(char *));
        if (!cs->items) { fprintf(stderr, "dbg: out of memory\n"); exit(1); }
    }
    cs->items[cs->n] = (char *)malloc(len + 1);
    if (!cs->items[cs->n]) { fprintf(stderr, "dbg: out of memory\n"); exit(1); }
    memcpy(cs->items[cs->n], s, len);
    cs->items[cs->n][len] = '\0';
    cs->n++;
}

static void cs_free(contig_set *cs)
{
    size_t i;
    for (i = 0; i < cs->n; i++) free(cs->items[i]);
    free(cs->items);
    cs->items = NULL; cs->n = cs->cap = 0;
}

static int cs_cmp(const void *a, const void *b)
{
    return strcmp(*(const char *const *)a, *(const char *const *)b);
}

/* contigs are written sorted, so the file content does not depend on the
 * order in which the walks happened to be produced */
static void cs_write(contig_set *cs, const char *path)
{
    FILE  *f = fopen(path, "w");
    size_t i;
    if (!f) { perror(path); exit(1); }
    qsort(cs->items, cs->n, sizeof(char *), cs_cmp);
    for (i = 0; i < cs->n; i++) fprintf(f, "%s\n", cs->items[i]);
    fclose(f);
}

#endif /* DBG_COMMON_H */
EOF
