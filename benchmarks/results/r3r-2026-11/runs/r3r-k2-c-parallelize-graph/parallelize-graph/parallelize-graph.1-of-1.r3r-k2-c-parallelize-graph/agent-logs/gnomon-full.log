[approval] bash: cd /app && python3 - <<'EOF'
p='emu/upc_emu.c'
s=open(p).read()
old = '''void *upc_all_alloc(size_t nblocks, size_t nbytes)
{
    void *p = calloc(nblocks ? nblocks : 1, nbytes ? nbytes : 1);
    if (!p) {
        fprintf(stderr, "upc_emu: out of memory\\n");
        exit(1);
    }
    return p;
