new = '''/*
 * Collective allocation: every thread must call this the same number of times,
 * and all of them receive the same pointer -- which is the contract of UPC's
 * upc_all_alloc, and what makes the single malloc'ed block behave as one shared
 * array instead of one private copy per thread.
 */
#define EMU_MAX_ALLOCS 64

static void *emu_allocs[EMU_MAX_ALLOCS];
static size_t emu_alloc_blocks[EMU_MAX_ALLOCS];
static size_t emu_alloc_bytes[EMU_MAX_ALLOCS];
static int    emu_alloc_next;
static pthread_mutex_t emu_alloc_mutex = PTHREAD_MUTEX_INITIALIZER;

void *upc_all_alloc(size_t nblocks, size_t nbytes)
{
    static __thread int seq = 0;
    void *p;
    int   slot = seq++;

    pthread_mutex_lock(&emu_alloc_mutex);
    if (slot >= EMU_MAX_ALLOCS) {
        fprintf(stderr, "upc_emu: too many collective allocations\\n");
        _exit(1);
    }
    if (slot == emu_alloc_next) {
        p = calloc(nblocks ? nblocks : 1, nbytes ? nbytes : 1);
        if (!p) {
            fprintf(stderr, "upc_emu: out of memory\\n");
            _exit(1);
        }
        emu_allocs[slot]        = p;
        emu_alloc_blocks[slot]  = nblocks;
        emu_alloc_bytes[slot]   = nbytes;
        emu_alloc_next++;
    } else {
        p = emu_allocs[slot];
        if (nblocks != emu_alloc_blocks[slot] || nbytes != emu_alloc_bytes[slot]) {
            fprintf(stderr, "upc_emu: mismatched collective allocation\\n");
            _exit(1);
        }
    }
    pthread_mutex_unlock(&emu_alloc_mutex);

    upc_emu_barrier();          /* the block is ready, and no thread races ahead */
    return p;
}'''
assert old in s
s = s.replace(old, new)
