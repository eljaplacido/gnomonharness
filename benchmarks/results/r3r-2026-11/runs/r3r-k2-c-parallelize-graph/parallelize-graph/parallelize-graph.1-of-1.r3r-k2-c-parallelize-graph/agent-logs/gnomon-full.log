def emit(seq):
    # a linear genome: emit every k-mer with its left/right extension
    out=[]
    for i in range(len(seq)-k):
        km=seq[i:i+k]
        le=seq[i-1] if i>0 else "F"
        re=seq[i+k]
        out.append(f"{km}\t{le}{re}")
    return out
lines=[]
if mode=="path":
    g="".join(random.choice(B) for _ in range(n+k))
    lines=emit(g)
elif mode=="cycle":
    # circular genome: every k-mer has both extensions -> one big cycle
    g="".join(random.choice(B) for _ in range(n))
    ext=g+g[:k]
    for i in range(n):
        km=ext[i:i+k]; le=ext[i-1]; re=ext[i+k]
        lines.append(f"{km}\t{le}{re}")
elif mode=="random":
    for _ in range(n):
        km="".join(random.choice(B) for _ in range(k))
        le=random.choice(B+"F"); re=random.choice(B+"F")
        lines.append(f"{km}\t{le}{re}")
random.shuffle(lines)
print("\n".join(lines))
