"""Validate the contig set of a run: contigs must be reconstructible walks
over the k-mer set, and the union over pgen_*.out must equal serial.out."""
import sys, glob, collections
inp, serial_out = sys.argv[1], sys.argv[2]
kmers = {}
for line in open(inp):
    line=line.rstrip("\n")
    if not line or line.startswith("#"): continue
    km,ext = line.split("\t")
    kmers[km] = (ext[0], ext[1])   # later duplicates overwrite, as the graph does
k = len(next(iter(kmers)))

def check(contigs, tag):
    total = 0
    for c in contigs:
        assert len(c) >= k, (tag, "short contig")
        for i in range(len(c)-k):
            km = c[i:i+k]
            assert km in kmers, (tag, "contig k-mer not in input", km)
            nxt = c[i+k]
            assert nxt == kmers[km][1], (tag, "bad right extension", km, nxt)
            if i>0:
                assert c[i-1] == kmers[km][0], (tag, "bad left extension", km, c[i-1])
        total += len(c)-k
    return total

s = [l.rstrip("\n") for l in open(serial_out) if l.strip()]
p = []
for f in sorted(glob.glob("pgen_*.out")):
    p += [l.rstrip("\n") for l in open(f) if l.strip()]
cs, cp = collections.Counter(s), collections.Counter(p)
miss = cs - cp; extra = cp - cs
assert not miss, ("missing from parallel", list(miss)[:3])
assert not extra, ("extra in parallel", list(extra)[:3])
check(s, "serial"); check(p, "parallel")
print(f"OK  contigs={len(s)}  covered k-mers: serial={check(s,'s')} parallel={check(p,'p')}  input={len(kmers)}")
