#!/usr/bin/env python3
"""Verification script for model artifacts and detection results."""
import json, sys, os, math, struct, hashlib
from pathlib import Path

# ── helpers ──────────────────────────────────────────────────────────────
def check(name, ok, detail=""):
    tag = "PASS" if ok else "FAIL"
    print(f"[{tag}] {name}" + (f" — {detail}" if detail else ""))
    return ok

# ── Samples ──────────────────────────────────────────────────────────────
SAMPLES = [
    "Bonjour, comment allez-vous aujourd'hui?",
    "Hola, ¿cómo estás hoy?",
    "Guten Tag, wie geht es Ihnen?",
    "Ciao, come stai oggi?",
    "Olá, como você está?",
    "Привет, как дела?",
    "こんにちは、お元気ですか？",
    "你好，你好吗？",
    "مرحبا، كيف حالك؟",
    "Hello, how are you?",
]
EXPECTED_LANGS = [
    "French", "Spanish", "German", "Italian", "Portuguese",
    "Russian", "Japanese", "Chinese", "Arabic", "English",
]

all_pass = True

# ══════════════════════════════════════════════════════════════════════════
# A. Directory listing & required files
# ══════════════════════════════════════════════════════════════════════════
print("=" * 70)
print("CHECK A: Directory listing & required files")
print("=" * 70)
import subprocess
for d in ["/app", "/app/model_cache/xlm-roberta-base", "/app/merged_model"]:
    r = subprocess.run(["ls", "-la", d], capture_output=True, text=True)
    print(r.stdout)
    if r.returncode != 0:
        print(r.stderr)
        all_pass = False

required_files = [
    "config.json",
    "tokenizer.json",
    "tokenizer_config.json",
    "sentencepiece.bpe.model",
]
# weights: safetensors or pytorch_model.bin
weight_files = ["model.safetensors", "pytorch_model.bin"]

for d in ["/app/model_cache/xlm-roberta-base", "/app/merged_model"]:
    for f in required_files:
        p = os.path.join(d, f)
        ok = os.path.isfile(p)
        if not check(f"  {d}/{f} exists", ok, "MISSING"):
            all_pass = False
    # at least one weight file
    w_ok = any(os.path.isfile(os.path.join(d, w)) for w in weight_files)
    if not check(f"  {d}/weights file exists", w_ok, "NO WEIGHT FILE FOUND"):
        all_pass = False

# ══════════════════════════════════════════════════════════════════════════
# B. Parse both config.json files
# ══════════════════════════════════════════════════════════════════════════
print("\n" + "=" * 70)
print("CHECK B: config.json fields")
print("=" * 70)

configs = {}
for label, path in [("base", "/app/model_cache/xlm-roberta-base/config.json"),
                     ("merged", "/app/merged_model/config.json")]:
    with open(path) as f:
        cfg = json.load(f)
    configs[label] = cfg
    print(f"\n--- {label} ---")
    print(f"  num_labels          : {cfg.get('num_labels')}")
    id2l = cfg.get("id2label", {})
    print(f"  len(id2label)       : {len(id2l)}")
    print(f"  id2label            : {id2l}")
    print(f"  model_type          : {cfg.get('model_type')}")
    print(f"  architectures       : {cfg.get('architectures')}")

    ok = cfg.get("num_labels") == 20 and len(id2l) == 20
    if not check(f"  {label}: 20 labels", ok, f"got {cfg.get('num_labels')}"):
        all_pass = False

# ══════════════════════════════════════════════════════════════════════════
# C. detection_results.json
# ══════════════════════════════════════════════════════════════════════════
print("\n" + "=" * 70)
print("CHECK C: detection_results.json")
print("=" * 70)

with open("/app/detection_results.json") as f:
    raw = f.read()
print("FILE CONTENT:")
print(raw)
print()

try:
    results = json.loads(raw)
except json.JSONDecodeError as e:
    check("  valid JSON", False, str(e))
    all_pass = False
    results = None

if results is not None:
    ok = isinstance(results, list)
    check("  is a JSON list", ok, "not a list")
    if not ok:
        all_pass = False

    ok = len(results) == 10
    check("  exactly 10 items", ok, f"got {len(results)}")
    if not ok:
        all_pass = False

    expected_keys = {"text", "predicted_class_id", "confidence"}
    keys_ok = True
    for i, row in enumerate(results):
        if set(row.keys()) != expected_keys:
            check(f"  row {i} keys", False, f"got {set(row.keys())}")
            keys_ok = False
    check("  all rows have exact keys", keys_ok)
    if not keys_ok:
        all_pass = False

    ids_ok = True
    for i, row in enumerate(results):
        pid = row["predicted_class_id"]
        if not isinstance(pid, int) or isinstance(pid, bool):
            check(f"  row {i} predicted_class_id is int (not bool)", False,
                  f"got {type(pid).__name__}: {pid}")
            ids_ok = False
    check("  all predicted_class_id are int (not bool)", ids_ok)
    if not ids_ok:
        all_pass = False

    confs_ok = True
    for i, row in enumerate(results):
        c = row["confidence"]
        if not isinstance(c, (int, float)) or isinstance(c, bool):
            check(f"  row {i} confidence is float", False, f"got {type(c).__name__}")
            confs_ok = False
        elif not (0 < c <= 1):
            check(f"  row {i} confidence in (0,1]", False, f"got {c}")
            confs_ok = False
    check("  all confidences in (0,1]", confs_ok)
    if not confs_ok:
        all_pass = False

    texts_ok = True
    for i, row in enumerate(results):
        if row["text"] != SAMPLES[i]:
            check(f"  row {i} text matches sample", False,
                  f"expected {SAMPLES[i]!r}, got {row['text']!r}")
            texts_ok = False
    check("  all texts match samples byte-for-byte", texts_ok)
    if not texts_ok:
        all_pass = False

# ══════════════════════════════════════════════════════════════════════════
# D. Recompute with merged model
# ══════════════════════════════════════════════════════════════════════════
print("\n" + "=" * 70)
print("CHECK D: Recompute with merged model")
print("=" * 70)

try:
    import torch
    from transformers import AutoModelForSequenceClassification, AutoTokenizer

    model = AutoModelForSequenceClassification.from_pretrained("/app/merged_model")
    tokenizer = AutoTokenizer.from_pretrained("/app/merged_model")
    model.eval()

    recomputed = []
    for i, text in enumerate(SAMPLES):
        inputs = tokenizer(text, return_tensors="pt")
        with torch.no_grad():
            logits = model(**inputs).logits
        pid = int(logits.argmax(dim=-1).item())
        conf = float(torch.softmax(logits, dim=-1)[0, pid].item())
        recomputed.append((pid, conf))
        json_pid = results[i]["predicted_class_id"] if results is not None else None
        json_conf = results[i]["confidence"] if results is not None else None
        match_id = pid == json_pid if json_pid is not None else False
        conf_diff = abs(conf - json_conf) if json_conf is not None else 999
        conf_match = conf_diff < 1e-4
        print(f"  {i:2d} | text={text!r}")
        print(f"       recomputed: pid={pid} conf={conf:.6f}")
        print(f"       json:       pid={json_pid} conf={json_conf}")
        print(f"       id_match={match_id}  conf_diff={conf_diff:.6f}  conf_match={conf_match}")
        if not match_id:
            all_pass = False
        if not conf_match:
            all_pass = False

except Exception as e:
    print(f"ERROR loading model: {e}")
    import traceback; traceback.print_exc()
    all_pass = False

# ══════════════════════════════════════════════════════════════════════════
# E. Language names
# ══════════════════════════════════════════════════════════════════════════
print("\n" + "=" * 70)
print("CHECK E: Language names from id2label")
print("=" * 70)

try:
    merged_cfg = configs["merged"]
    id2label = merged_cfg["id2label"]
    langs_ok = True
    for i, (pid, _) in enumerate(recomputed):
        lang = id2label.get(pid, f"<UNKNOWN id={pid}>")
        exp = EXPECTED_LANGS[i]
        match = lang == exp
        print(f"  {i:2d} | pid={pid} -> {lang!r}  expected={exp!r}  match={match}")
        if not match:
            langs_ok = False
            all_pass = False
    check("  languages match expected order", langs_ok)
except Exception as e:
    print(f"ERROR: {e}")
    all_pass = False

# ══════════════════════════════════════════════════════════════════════════
# F. No LoRA artifacts in merged model; weight diff
# ══════════════════════════════════════════════════════════════════════════
print("\n" + "=" * 70)
print("CHECK F: No LoRA artifacts in merged model")
print("=" * 70)

merged_dir = "/app/merged_model"
adapter_cfg = os.path.join(merged_dir, "adapter_config.json")
adapter_safetensors = os.path.join(merged_dir, "adapter_model.safetensors")
adapter_bin = os.path.join(merged_dir, "adapter_model.bin")

ok = not os.path.exists(adapter_cfg)
check("  no adapter_config.json", ok, "EXISTS" if not ok else "")
if not ok:
    all_pass = False

ok = not os.path.exists(adapter_safetensors)
check("  no adapter_model.safetensors", ok, "EXISTS" if not ok else "")
if not ok:
    all_pass = False

ok = not os.path.exists(adapter_bin)
check("  no adapter_model.bin", ok, "EXISTS" if not ok else "")
if not ok:
    all_pass = False

# Count lora keys in merged safetensors
lora_keys_count = 0
safetensors_path = os.path.join(merged_dir, "model.safetensors")
if os.path.isfile(safetensors_path):
    with open(safetensors_path, "rb") as f:
        hdr_len = struct.unpack("<Q", f.read(8))[0]
        full_header = json.loads(f.read(hdr_len))
        tensor_keys = [k for k in full_header if k != "__metadata__"]
        lora_keys_count = sum(1 for k in tensor_keys if "lora" in k.lower())

print(f"  lora keys in merged safetensors: {lora_keys_count}")
ok = lora_keys_count == 0
check("  zero lora keys in merged safetensors", ok, f"count={lora_keys_count}")
if not ok:
    all_pass = False

# Download adapter safetensors and compare classifier weights
print("\n  Downloading adapter safetensors from huggingface_hub...")
try:
    from huggingface_hub import hf_hub_download
    adapter_st_path = hf_hub_download(
        repo_id="dominguesm/xlm-roberta-base-lora-language-detection",
        filename="adapter_model.safetensors",
    )
    print(f"  Downloaded to: {adapter_st_path}")

    with open(adapter_st_path, "rb") as f:
        hdr_len = struct.unpack("<Q", f.read(8))[0]
        adapter_header = json.loads(f.read(hdr_len))
        adapter_tensor_keys = [k for k in adapter_header if k != "__metadata__"]
        adapter_lora_count = sum(1 for k in adapter_tensor_keys if "lora" in k.lower())
        print(f"  adapter safetensors lora keys: {adapter_lora_count}")

    # Load safetensors
    import safetensors.torch as st_torch
    merged_state = st_torch.load_file(safetensors_path)
    adapter_state = st_torch.load_file(adapter_st_path)

    # Compare classifier weights
    for name in ["classifier.out_proj.weight", "classifier.dense.weight"]:
        m_key = name
        a_key = f"base_model.model.{name}"
        if m_key in merged_state and a_key in adapter_state:
            diff = (merged_state[m_key] - adapter_state[a_key]).abs().max().item()
            print(f"  {m_key} vs {a_key}: max abs diff = {diff:.10f}")
        else:
            print(f"  {m_key} in merged: {m_key in merged_state}, {a_key} in adapter: {a_key in adapter_state}")

except Exception as e:
    print(f"ERROR during adapter download/comparison: {e}")
    import traceback; traceback.print_exc()

# ══════════════════════════════════════════════════════════════════════════
# Summary
# ══════════════════════════════════════════════════════════════════════════
print("\n" + "=" * 70)
print("SUMMARY")
print("=" * 70)
print(f"Overall: {'PASS' if all_pass else 'FAIL'}")
