print(f"Classifier out_proj weight max abs diff: {diff_out_w}")
print(f"Classifier dense bias max abs diff: {diff_dense_b}")
print(f"Classifier out_proj bias max abs diff: {diff_out_b}")
print(f"All diffs ~0: {diff_dense_w < 1e-6 and diff_out_w < 1e-6 and diff_dense_b < 1e-6 and diff_out_b < 1e-6}")
