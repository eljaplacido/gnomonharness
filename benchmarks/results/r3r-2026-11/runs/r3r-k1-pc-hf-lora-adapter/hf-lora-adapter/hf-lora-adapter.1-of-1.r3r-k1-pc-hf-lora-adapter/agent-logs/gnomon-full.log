import torch
from transformers import AutoTokenizer, AutoModelForSequenceClassification
from peft import PeftModel, PeftConfig

BASE = "FacebookAI/xlm-roberta-base"
ADAPTER = "dominguesm/xlm-roberta-base-lora-language-detection"
NUM_LABELS = 20

print("=== Loading tokenizer ===")
tok = AutoTokenizer.from_pretrained(BASE)
print(f"Tokenizer loaded: vocab_size={tok.vocab_size}")

print("=== Loading base model with 20 labels ===")
model = AutoModelForSequenceClassification.from_pretrained(
    BASE, num_labels=NUM_LABELS, torch_dtype=torch.float32
)
print(f"Base model classifier weight shape: {model.classifier.weight.shape}")
print(f"Base model classifier bias shape: {model.classifier.bias.shape}")

print("=== Saving base model and tokenizer ===")
model.save_pretrained("/app/model_cache/xlm-roberta-base")
tok.save_pretrained("/app/model_cache/xlm-roberta-base")
print("Base model saved to /app/model_cache/xlm-roberta-base")

print("=== Loading adapter ===")
peft_model = PeftModel.from_pretrained(model, ADAPTER)
print(f"PeftModel loaded. Classifier weight shape: {peft_model.base_model.model.classifier.weight.shape}")

# Verify the trained head actually landed in the PeftModel
# The modules_to_save classifier should have the trained weights
print("=== Verifying trained head ===")
# Get the saved adapter classifier weights from the adapter state dict
from huggingface_hub import hf_hub_download
import torch as t

adapter_path = hf_hub_download(ADAPTER, "adapter_model.bin")
adapter_state = t.load(adapter_path, map_location="cpu", weights_only=True)

# The modules_to_save classifier tensors in the adapter
# In the adapter: base_model.model.classifier.dense.weight, base_model.model.classifier.out_proj.weight
# In the PeftModel, these are stored in the 'default' module
peft_classifier_dense_w = peft_model.base_model.model.classifier.dense.weight
peft_classifier_out_w = peft_model.base_model.model.classifier.out_proj.weight

adapter_dense_w = adapter_state["base_model.model.classifier.dense.weight"]
adapter_out_w = adapter_state["base_model.model.classifier.out_proj.weight"]

print(f"Peft classifier.dense.weight shape: {peft_classifier_dense_w.shape}")
print(f"Peft classifier.out_proj.weight shape: {peft_classifier_out_w.shape}")
print(f"Adapter classifier.dense.weight shape: {adapter_dense_w.shape}")
print(f"Adapter classifier.out_proj.weight shape: {adapter_out_w.shape}")

dense_equal = t.allclose(peft_classifier_dense_w, adapter_dense_w)
out_equal = t.allclose(peft_classifier_out_w, adapter_out_w)
print(f"Trained head dense weights match adapter: {dense_equal}")
print(f"Trained head out_proj weights match adapter: {out_equal}")

print("=== Merging and unloading ===")
merged = peft_model.merge_and_unload()
print(f"Merged model classifier weight shape: {merged.classifier.weight.shape}")

print("=== Saving merged model and tokenizer ===")
merged.save_pretrained("/app/merged_model")
tok.save_pretrained("/app/merged_model")
print("Merged model saved to /app/merged_model")

print("=== DONE Phase 2 ===")
