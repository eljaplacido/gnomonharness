        print(f"  avg: {v9_avg:.4f} s, ratio: {v9_avg/v0_avg:.3f}, max|Δ|: {diff_v9:.6e}, norm: {norm_v9:.6e}")
    else:
        print(f"  State size mismatch: V9={s_v9.shape}, base={s_v0.shape}")
        print(f"  avg: {v9_avg:.4f} s")
except Exception as e:
