import mujoco, numpy as np, time

REF='/app/model_ref.xml'

def fresh():
    return mujoco.MjModel.from_xml_path(REF)

def sim(m, seed, nstep=None):
    nstep = nstep or int(2.0/m.opt.timestep)
    d = mujoco.MjData(m)
    rng = np.random.default_rng(seed)
    d.qpos += rng.normal(0,0.01,size=d.qpos.shape)
    mujoco.mj_forward(m,d)
    for _ in range(nstep): mujoco.mj_step(m,d)
    fp = mujoco.mjtState.mjSTATE_FULLPHYSICS
    s = np.zeros(mujoco.mj_stateSize(m,fp)); mujoco.mj_getState(m,d,s,fp)
    return s

# Define configs
# disable flags
DISABLE_LIMIT = mujoco.mjtDisableBit.mjDSBL_LIMIT
DISABLE_CONTACT = mujoco.mjtDisableBit.mjDSBL_CONTACT
DISABLE_SENSOR = mujoco.mjtDisableBit.mjDSBL_SENSOR
DISABLE_WARMSTART = mujoco.mjtDisableBit.mjDSBL_WARMSTART
DISABLE_AUTORESET = mujoco.mjtDisableBit.mjDSBL_AUTORESET
DISABLE_NATIVECCD = mujoco.mjtDisableBit.mjDSBL_NATIVECCD

DISABLE_ALL = DISABLE_LIMIT | DISABLE_CONTACT | DISABLE_SENSOR | DISABLE_WARMSTART | DISABLE_AUTORESET | DISABLE_NATIVECCD
DISABLE_WARMSTART_OFF = DISABLE_LIMIT | DISABLE_CONTACT | DISABLE_SENSOR | DISABLE_AUTORESET | DISABLE_NATIVECCD

configs = {
    "C0": {"desc": "base (no mutation)"},
    "C1": {"desc": "solver=PGS", "solver": mujoco.mjtSolver.mjSOL_PGS},
    "C2": {"desc": "solver=PGS, jacobian=DENSE", "solver": mujoco.mjtSolver.mjSOL_PGS, "jacobian": mujoco.mjtJacobian.mjJAC_DENSE},
    "C3": {"desc": "solver=PGS, jacobian=DENSE, disable ALL",
