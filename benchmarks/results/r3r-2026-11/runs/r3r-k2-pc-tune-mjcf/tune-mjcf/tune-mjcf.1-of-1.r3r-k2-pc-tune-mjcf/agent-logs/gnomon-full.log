# V8
print("\n--- V8: remove actuator ---")
with open('/app/model_ref.xml', 'r') as f:
    xml = f.read()
xml_no_act = re.sub(r'\s*<actuator>.*?</actuator>\s*', '\n', xml, flags=re.DOTALL)
try:
    m_v8 = mujoco.MjModel.from_xml_string(xml_no_act.encode())
    def run_v8(seed):
        d = mujoco.MjData(m_v8)
        rng = np.random.default_rng(seed)
        d.qpos += rng.normal(0, 0.01, size=d.qpos.shape)
        mujoco.mj_forward(m_v8, d)
        for _ in range(1000):
            mujoco.mj_step(m_v8, d)
        fp = mujoco.mjtState.mjSTATE_FULLPHYSICS
        s = np.zeros(mujoco.mj_stateSize(m_v8, fp))
        mujoco.mj_getState(m_v8, d, s, fp)
        return s
    v8_times = []
    for _ in range(5):
        seed = np.random.randint(0, 10000)
        t0 = time.perf_counter()
        _ = run_v8(seed)
        v8_times.append(time.perf_counter() - t0)
    v8_avg = np.mean(v8_times)
    s_v8 = run_v8(12345)
    if s_v8.shape == s_v0.shape:
        diff_v8 = np.max(np.abs(s_v8 - s_v0))
        norm_v8 = np.linalg.norm(s_v8 - s_v0)
        add_result("V8 no actuator", v8_avg, v8_avg/v0_avg, diff_v8, norm_v8, bool(np.isnan(s_v8).any()), bool(np.isinf(s_v8).any()))
        print(f"  avg: {v8_avg:.4f} s, ratio: {v8_avg/v0_avg:.3f}, max|Δ|: {diff_v8:.6e}, norm: {norm_v8:.6e}")
    else:
        print(f"  State size mismatch: V8={s_v8.shape}, base={s_v0.shape}")
        print(f"  avg: {v8_avg:.4f} s")
        min_len = min(len(s_v8), len(s_v0))
        diff_v8 = np.max(np.abs(s_v8[:min_len] - s_v0[:min_len]))
        print(f"  max|Δ| (common prefix): {diff_v8:.6e}")
except Exception as e:
    print(f"  Error loading V8: {e}")

