    "C10": {"desc": "solver=PGS, iterations=200, tolerance=0",
            "solver": mujoco.mjtSolver.mjSOL_PGS, "iterations": 200, "tolerance": 0},
    "C11": {"desc": "solver=PGS, disable WARMSTART_OFF",
