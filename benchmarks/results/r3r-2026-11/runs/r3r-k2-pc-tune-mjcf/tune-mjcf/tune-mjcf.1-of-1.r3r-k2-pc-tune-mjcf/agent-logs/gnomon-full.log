    norm_v = np.linalg.norm(s_v - s_v0)
    add_result(f"V5 {iter_name}", avg, avg/v0_avg, diff_v, norm_v, bool(np.isnan(s_v).any()), bool(np.isinf(s_v).any()))
    print(f"  {iter_name}: avg={avg:.4f} s, ratio={avg/v0_avg:.3f}, max|Δ|={diff_v:.6e}, norm={norm_v:.6e}")

# V6
print("\n--- V6: solver types ---")
for sol_name, sol_val in [('mjSOL_CG', mujoco.mjtSolver.mjSOL_CG),
                           ('mjSOL_PGS', mujoco.mjtSolver.mjSOL_PGS)]:
    def make_tweak_sol(sv):
        def tweak(m, d):
            m.opt.solver = sv
        return tweak
    tweak_fn = make_tweak_sol(sol_val)
    times = []
    for _ in range(5):
        seed = np.random.randint(0, 10000)
        t0 = time.perf_counter()
        _ = run_harness(seed, tweak=tweak_fn)
        times.append(time.perf_counter() - t0)
    avg = np.mean(times)
    s_v, _ = run_harness(12345, tweak=tweak_fn)
    diff_v = np.max(np.abs(s_v - s_v0))
    norm_v = np.linalg.norm(s_v - s_v0)
    add_result(f"V6 {sol_name}", avg, avg/v0_avg, diff_v, norm_v, bool(np.isnan(s_v).any()), bool(np.isinf(s_v).any()))
    print(f"  {sol_name}: avg={avg:.4f} s, ratio={avg/v0_avg:.3f}, max|Δ|={diff_v:.6e}, norm={norm_v:.6e}")

# V7
print("\n--- V7: mjCONE_ELLIPTIC ---")
def tweak_v7(m, d):
    m.opt.cone = mujoco.mjtCone.mjCONE_ELLIPTIC
v7_times = []
for _ in range(5):
    seed = np.random.randint(0, 10000)
    t0 = time.perf_counter()
    _ = run_harness(seed, tweak=tweak_v7)
    v7_times.append(time.perf_counter() - t0)
v7_avg = np.mean(v7_times)
s_v7, _ = run_harness(12345, tweak=tweak_v7)
diff_v7 = np.max(np.abs(s_v7 - s_v0))
norm_v7 = np.linalg.norm(s_v7 - s_v0)
add_result("V7 mjCONE_ELLIPTIC", v7_avg, v7_avg/v0_avg, diff_v7, norm_v7, bool(np.isnan(s_v7).any()), bool(np.isinf(s_v7).any()))
print(f"  avg: {v7_avg:.4f} s, ratio: {v7_avg/v0_avg:.3f}, max|Δ|: {diff_v7:.6e}, norm: {norm_v7:.6e}")

# V8
print("\n--- V8: remove actuator ---")
with open('/app/model_ref.xml', 'r') as f:
    xml = f.read()
xml_no_act = re.sub(r'\s*<actuator>.*?</actuator>\s*', '\n', xml, flags=re.DOTALL)
try:
    m_v8 = mujoco.MjModel.from_xml_string(xml_no_act.encode())
    def run_v8(seed):
        d = mujoco.MjData(m_v8)
        rng = np.random.default_rng(seed)
        d.qpos += rng.normal(0, 0.01, size=d.qpos.shape)
        mujoco.mj_forward(m_v8, d)
        for _ in range(1000):
            mujoco.mj_step(m_v8, d)
        fp = mujoco.mjtState.mjSTATE_FULLPHYSICS
        s = np.zeros(mujoco.mj_stateSize(m_v8, fp))
        mujoco.mj_getState(m_v8, d, s, fp)
        return s
    v8_times = []
    for _ in range(5):
        seed = np.random.randint(0, 10000)
        t0 = time.perf_counter()
        _ = run_v8(seed)
        v8_times.append(time.perf_counter() - t0)
    v8_avg = np.mean(v8_times)
    s_v8 = run_v8(12345)
    if s_v8.shape == s_v0.shape:
        diff_v8 = np.max(np.abs(s_v8 - s_v0))
        norm_v8 = np.linalg.norm(s_v8 - s_v0)
        add_result("V8 no actuator", v8_avg, v8_avg/v0_avg, diff_v8, norm_v8, bool(np.isnan(s_v8).any()), bool(np.isinf(s_v8).any()))
        print(f"  avg: {v8_avg:.4f} s, ratio: {v8_avg/v0_avg:.3f}, max|Δ|: {diff_v8:.6e}, norm: {norm_v8:.6e}")
    else:
        print(f"  State size mismatch: V8={s_v8.shape}, base={s_v0.shape}")
        print(f"  avg: {v8_avg:.4f} s")
        min_len = min(len(s_v8), len(s_v0))
        diff_v8 = np.max(np.abs(s_v8[:min_len] - s_v0[:min_len]))
        print(f"  max|Δ| (common prefix): {diff_v8:.6e}")
except Exception as e:
    print(f"  Error loading V8: {e}")

# V9
print("\n--- V9: no actuator + no exclude + no equality ---")
xml_v9 = re.sub(r'\s*<actuator>.*?</actuator>\s*', '\n', xml, flags=re.DOTALL)
xml_v9 = re.sub(r'\s*<contact>.*?</contact>\s*', '\n', xml_v9, flags=re.DOTALL)
xml_v9 = re.sub(r'\s*<equality>.*?</equality>\s*', '\n', xml_v9, flags=re.DOTALL)
try:
    m_v9 = mujoco.MjModel.from_xml_string(xml_v9.encode())
    def run_v9(seed):
