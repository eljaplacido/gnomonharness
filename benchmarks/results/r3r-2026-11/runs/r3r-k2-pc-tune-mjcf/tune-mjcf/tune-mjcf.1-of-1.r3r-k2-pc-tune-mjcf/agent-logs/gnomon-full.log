    base_times.append(t1 - t0)
base_mean = np.mean(base_times)
base_us = base_mean * 1e6 / nstep
print(f"  Base mean: {base_mean:.4f}s, per-step: {base_us:.2f} us", flush=True)

# Now test each config
results = {}
for cid, cfg in configs.items():
    if cid == "C0":
        continue
    
    print(f"\n--- {cid}: {cfg['desc']} ---", flush=True)
    m = fresh()
    
    for k, v in cfg.items():
        if k == "desc":
            continue
        setattr(m.opt, k, v)
    
    print(f"  Applied: solver={m.opt.solver}, iterations={m.opt.iterations}, "
          f"tolerance={m.opt.tolerance}, jacobian={m.opt.jacobian}, "
          f"disableflags={m.opt.disableflags}", flush=True)
    
    # Timing: 3 runs each
    variant_times = []
    for k in range(3):
        t0 = time.perf_counter()
        sim(m, seed=k)
        t1 = time.perf_counter()
        variant_times.append(t1 - t0)
    
    ratio = np.mean(variant_times) / base_mean
    var_us = np.mean(variant_times) * 1e6 / nstep
    
    print(f"  Variant: {np.mean(variant_times):.4f}s ({var_us:.2f} us/step), ratio={ratio:.4f}", flush=True)
    
    # Accuracy: 10 seeds
    max_abs_diffs = []
    norms = []
    worst_seed = -1
    worst_max_abs = -1
    has_nan = False
    has_inf = False
    
    for seed in range(10):
        s_var = sim(m, seed)
        s_base = sim(m_base, seed)
        
        if np.any(np.isnan(s_var)) or np.any(np.isnan(s_base)):
            has_nan = True
        if np.any(np.isinf(s_var)) or np.any(np.isinf(s_base)):
            has_inf = True
        
        diff = np.abs(s_var - s_base)
        max_abs = np.max(diff)
        norm = np.linalg.norm(s_var - s_base)
        
        max_abs_diffs.append(max_abs)
        norms.append(norm)
        
        if max_abs > worst_max_abs:
            worst_max_abs = max_abs
            worst_seed = seed
    
    mean_max_abs = np.mean(max_abs_diffs)
    
    print(f"  Worst max-abs: {worst_max_abs:.6e} (seed {worst_seed}), mean={mean_max_abs:.6e}", flush=True)
    print(f"  Worst norm: {max(norms):.6e}, NaN={has_nan}, Inf={has_inf}", flush=True)
    
    results[cid] = {
        "ratio": ratio,
        "var_us": var_us,
        "base_us": base_us,
        "worst_max_abs": worst_max_abs,
        "worst_seed": worst_seed,
        "mean_max_abs": mean_max_abs,
        "worst_norm": max(norms),
        "has_nan": has_nan,
        "has_inf": has_inf,
    }

# Print summary table
print("\n" + "=" * 120, flush=True)
print("SUMMARY TABLE", flush=True)
print("=" * 120, flush=True)
for cid in ["C0"] + [c for c in configs if c != "C0"]:
    if cid == "C0":
        print(f"C0 | base | ~1.0 | {base_us:.2f} us | {base_us:.2f} us | 0.0 | 0 | 0.0 | N | N", flush=True)
    else:
        r = results[cid]
        print(f"{cid} | {configs[cid]['desc']} | {r['ratio']:.4f} | {r['var_us']:.2f} us | {r['base_us']:.2f} us | {r['worst_max_abs']:.6e} (seed {r['worst_seed']}) | mean={r['mean_max_abs']:.6e} | NaN={r['has_nan']} | Inf={r['has_inf']}", flush=True)
