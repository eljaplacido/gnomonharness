#!/usr/bin/env python3
"""Reconnaissance of /app/model_ref.xml — MuJoCo compilation & simulation facts."""
import time
import numpy as np
import mujoco

TOTAL_SIM_TIME = 2.0
ATOL = 1e-5

model = mujoco.MjModel.from_xml_path('/app/model_ref.xml')
data = mujoco.MjData(model)

# ── 1. Version ──────────────────────────────────────────────────────────────
print("=" * 70)
print("1. MUJOCO VERSION")
print("=" * 70)
print(f"   mujoco.__version__ = {mujoco.__version__}")
print()

# ── 2. Model dimensions ─────────────────────────────────────────────────────
print("=" * 70)
print("2. MODEL DIMENSIONS")
print("=" * 70)
dims = {
    'nq': model.nq, 'nv': model.nv, 'njnt': model.njnt,
    'nbody': model.nbody, 'ngeom': model.ngeom, 'neq': model.neq,
    'nu': model.nu, 'na': model.na, 'nsensordata': model.nsensordata,
}
for k, v in dims.items():
    print(f"   {k:15s} = {v}")
print()

# ── 3. Model options ────────────────────────────────────────────────────────
print("=" * 70)
print("3. MODEL OPTIONS")
print("=" * 70)
opt_attrs = [a for a in dir(model.opt) if not a.startswith('_')]
for a in opt_attrs:
    v = getattr(model.opt, a)
    if a == 'gravity':
        v = [f"{x:.2f}" for x in v]
    elif a == 'magnetic':
        v = [f"{x:.2f}" for x in v]
    elif a == 'o_friction':
        v = [f"{x:.2e}" for x in v]
    elif a == 'o_solimp':
        v = [f"{x:.4g}" for x in v]
    elif a == 'o_solref':
        v = [f"{x:.4g}" for x in v]
    elif a == 'wind':
        v = [f"{x:.2f}" for x in v]
    elif isinstance(v, (int, float)):
        v = repr(v)
    else:
        v = str(v)
    print(f"   {a:25s} = {v}")

# Named enums
print(f"   integrator (0) = {mujoco.mjtIntegrator(model.opt.integrator)}")
print(f"   solver   (2) = {mujoco.mjtSolver(model.opt.solver)}")
print(f"   jacobian (2) = {mujoco.mjtJacobian(model.opt.jacobian)}")
print(f"   cone     (0) = {mujoco.mjtCone(model.opt.cone)}")
print()

# ── 4. Joint types and qpos addresses ───────────────────────────────────────
print("=" * 70)
print("4. JOINT TYPES AND QPOS ADDRESSES")
print("=" * 70)
print(f"   Total joints: {model.njnt}")
first5 = range(min(5, model.njnt))
last5 = range(max(0, model.njnt - 5), model.njnt)

for i in first5:
    j = model.joint(i)
    print(f"   [{i:2d}] name={j.name:12s} type={mujoco.mjtJoint(j.type):18s} qposadr={j.qposadr[0]:4d} dofadr={j.dofadr[0]:4d}")
if len(first5) > 0 and len(last5) > 0 and first5[-1] < last5[0]:
    print("   ...")
    for i in last5:
        j = model.joint(i)
        print(f"   [{i:2d}] name={j.name:12s} type={mujoco.mjtJoint(j.type):18s} qposadr={j.qposadr[0]:4d} dofadr={j.dofadr[0]:4d}")
print()

# ── 5. Plugin info ──────────────────────────────────────────────────────────
print("=" * 70)
print("5. PLUGIN INFO")
print("=" * 70)
print(f"   nplugin = {model.nplugin}")
if model.nplugin > 0:
    adr = model.name_pluginadr[0]
    names_str = model.names.decode('latin-1')
    pname = names_str[adr:].split('\x00')[0]
    print(f"   plugin[0] name = {pname}")
    print(f"   plugin[0] id   = {model.plugin[0]}")
    print(f"   npluginattr    = {model.npluginattr}")
    print(f"   npluginstate   = {model.npluginstate}")
    print(f"   plugin_attr    = {model.plugin_attr}")
    print(f"   plugin_attradr = {model.plugin_attradr}")
print()

# ── 6. Timing: 1000 steps (2.0 s) with default settings ─────────────────────
print("=" * 70)
print("6. TIMING — DEFAULT (timestep=0.002, 1000 steps)")
print("=" * 70)
data_ref = mujoco.MjData(model)
seed = 0
rng = np.random.default_rng(seed)
data_ref.qpos += rng.normal(0, 0.01, size=data_ref.qpos.shape)
mujoco.mj_forward(model, data_ref)

t0 = time.perf_counter()
for _ in range(1000):
    mujoco.mj_step(model, data_ref)
t1 = time.perf_counter()
wall_default = t1 - t0
print(f"   Wall time for 1000 steps: {wall_default:.6f} s")
print(f"   Per-step: {wall_default/1000*1000:.3f} ms")
print(f"   Expected sim time: {1000 * model.opt.timestep:.3f} s")

# Get reference state
full_physics = mujoco.mjtState.mjSTATE_FULLPHYSICS
state_ref = np.zeros(mujoco.mj_stateSize(model, full_physics))
mujoco.mj_getState(model, data_ref, state_ref, full_physics)
has_nan_ref = bool(np.isnan(state_ref).any())
print(f"   NaN in final state: {has_nan_ref}")
print()

# ── 7. Iterations sweep: 10, 5, 1 ───────────────────────────────────────────
print("=" * 70)
print("7. ITERATIONS SWEEP (timestep=0.002, 1000 steps)")
print("=" * 70)
for iters in [10, 5, 1]:
    model.opt.iterations = iters
    data_i = mujoco.MjData(model)
    data_i.qpos[:] = data_ref.qpos[:]  # same initial perturbation
    mujoco.mj_forward(model, data_i)
    t0 = time.perf_counter()
    for _ in range(1000):
        mujoco.mj_step(model, data_i)
    t1 = time.perf_counter()
    wall_i = t1 - t0

    state_i = np.zeros(mujoco.mj_stateSize(model, full_physics))
    mujoco.mj_getState(model, data_i, state_i, full_physics)
    diff_norm = float(np.linalg.norm(state_i - state_ref))
    diff_max = float(np.max(np.abs(state_i - state_ref)))
    has_nan = bool(np.isnan(state_i).any())
    print(f"   iterations={iters:2d}: wall={wall_i:.6f} s  "
          f"norm_diff={diff_norm:.6e}  max_abs_diff={diff_max:.6e}  "
          f"NaN={has_nan}")

# Restore iterations
model.opt.iterations = 100
print()

# ── 8. Timestep sweep: 0.004 (500 steps), 0.01 (200 steps) ─────────────────
print("=" * 70)
print("8. TIMESTEP SWEEP (total sim time = 2.0 s)")
print("=" * 70)
for ts in [0.004, 0.01]:
    model.opt.timestep = ts
    nstep = int(TOTAL_SIM_TIME / ts)
    data_ts = mujoco.MjData(model)
    data_ts.qpos[:] = data_ref.qpos[:]
    mujoco.mj_forward(model, data_ts)
    t0 = time.perf_counter()
    for _ in range(nstep):
        mujoco.mj_step(model, data_ts)
    t1 = time.perf_counter()
    wall_ts = t1 - t0

    state_ts = np.zeros(mujoco.mj_stateSize(model, full_physics))
    mujoco.mj_getState(model, data_ts, state_ts, full_physics)
    diff_norm = float(np.linalg.norm(state_ts - state_ref))
    diff_max = float(np.max(np.abs(state_ts - state_ref)))
    has_nan = bool(np.isnan(state_ts).any())
    print(f"   timestep={ts:.4f}: nstep={nstep:4d}  wall={wall_ts:.6f} s  "
          f"norm_diff={diff_norm:.6e}  max_abs_diff={diff_max:.6e}  "
          f"NaN={has_nan}")

# Restore defaults
model.opt.timestep = 0.002
model.opt.iterations = 100
print()
print("=" * 70)
print("RECON COMPLETE")
print("=" * 70)
PYEOF
