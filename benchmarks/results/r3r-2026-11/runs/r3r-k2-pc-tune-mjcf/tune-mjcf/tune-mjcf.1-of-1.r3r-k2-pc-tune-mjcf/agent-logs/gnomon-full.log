# V7: elliptic cone
print("\n--- V7: mjCONE_ELLIPTIC ---")
def tweak_v7(m, d):
    m.opt.cone = mujoco.mjtCone.mjCONE_ELLIPTIC
v7_times = []
for _ in range(5):
