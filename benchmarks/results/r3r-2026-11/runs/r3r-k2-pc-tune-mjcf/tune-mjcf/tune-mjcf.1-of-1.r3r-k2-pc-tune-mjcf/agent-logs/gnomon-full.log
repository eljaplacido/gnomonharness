#!/usr/bin/env python3
"""Profiling script for /app/model_ref.xml — MuJoCo 3.3.5 cable model."""

import time
import copy
import re
import mujoco
import numpy as np

# ── helpers ──────────────────────────────────────────────────────────────────

def run_harness(seed, nstep=1000, m=None, tweak=None):
    """Exact harness matching eval.py."""
    m = m or mujoco.MjModel.from_xml_path('/app/model_ref.xml')
    d = mujoco.MjData(m)
    rng = np.random.default_rng(seed)
    d.qpos += rng.normal(0, 0.01, size=d.qpos.shape)
    mujoco.mj_forward(m, d)
    if tweak:
        tweak(m, d)
    for _ in range(nstep):
        mujoco.mj_step(m, d)
    fp = mujoco.mjtState.mjSTATE_FULLPHYSICS
    s = np.zeros(mujoco.mj_stateSize(m, fp))
    mujoco.mj_getState(m, d, s, fp)
    return s, d


def baseline_time(n_runs=5):
    """Average wall time for 1000-step baseline run."""
    times = []
    for _ in range(n_runs):
        seed = np.random.randint(0, 10000)
        t0 = time.perf_counter()
        _ = run_harness(seed)
        times.append(time.perf_counter() - t0)
    return np.mean(times)


# ── Part A ───────────────────────────────────────────────────────────────────

print("=" * 70)
print("PART A — diagnostics on reference model")
print("=" * 70)

m = mujoco.MjModel.from_xml_path('/app/model_ref.xml')

# ── A1: timer info ──────────────────────────────────────────────────────────
print("\n--- A1: Timer info ---")
d0 = mujoco.MjData(m)
print(f"hasattr(d, 'timer'): {hasattr(d0, 'timer')}")
if hasattr(d0, 'timer'):
    print(f"d.timer.shape: {d0.timer.shape}")
    print(f"d.timer (initial): {d0.timer.tolist()}")
    timer_names = [n for n in dir(mujoco.mjtTimer) if not n.startswith('_') and n not in ('name', 'value')]
    print(f"mjtTimer enum names: {timer_names}")
    for n in timer_names:
        v = getattr(mujoco.mjtTimer, n)
        if hasattr(v, 'value'):
            print(f"  {n} = {v.value}")

# Run 1000 steps and check cumulative timers
d0 = mujoco.MjData(m)
rng = np.random.default_rng(0)
d0.qpos += rng.normal(0, 0.01, size=d0.qpos.shape)
mujoco.mj_forward(m, d0)
for _ in range(1000):
    mujoco.mj_step(m, d0)

if hasattr(d0, 'timer'):
    print(f"\nd.timer after 1000 steps: {d0.timer.tolist()}")

# ── A2: trajectory stats for seeds 0-4 ──────────────────────────────────────
print("\n--- A2: Trajectory stats (seeds 0-4) ---")
for seed in range(5):
    s, d = run_harness(seed)
    # Re-run to collect stats
    d2 = mujoco.MjData(m)
    rng = np.random.default_rng(seed)
    d2.qpos += rng.normal(0, 0.01, size=d2.qpos.shape)
    mujoco.mj_forward(m, d2)

    ncon_vals = []
    nefc_vals = []
    nfev_vals = []
    njev_vals = []
    solver_niter_sum = 0
    solver_nnz = None
    max_ncon = 0
    max_pen = 0.0

    for i in range(1000):
        mujoco.mj_step(m, d2)
        ncon_vals.append(d2.ncon)
        if hasattr(d2, 'nefc'):
            nefc_vals.append(d2.nefc)
        if hasattr(d2, 'nfev'):
            nfev_vals.append(d2.nfev)
        if hasattr(d2, 'njev'):
            njev_vals.append(d2.njev)
        if hasattr(d2, 'solver_niter'):
            solver_niter_sum += d2.solver_niter[0]
            if solver_nnz is None:
                solver_nnz = d2.solver_nnz if hasattr(d2, 'solver_nnz') else None
        if d2.ncon > 0:
            pen = -d2.contact.dist[:d2.ncon]
            mp = pen.max()
            if mp > max_pen:
                max_pen = mp
        if d2.ncon > max_ncon:
            max_ncon = d2.ncon

    print(f"\n  Seed {seed}:")
    print(f"    ncon:   min={min(ncon_vals)}, max={max(ncon_vals)}, mean={np.mean(ncon_vals):.2f}")
    if nefc_vals:
        print(f"    nefc:   min={min(nefc_vals)}, max={max(nefc_vals)}")
    if nfev_vals:
        print(f"    nfev:   min={min(nfev_vals)}, max={max(nfev_vals)}, mean={np.mean(nfev_vals):.2f}")
    if njev_vals:
        print(f"    njev:   min={min(njev_vals)}, max={max(njev_vals)}, mean={np.mean(njev_vals):.2f}")
    if hasattr(d2, 'solver_niter'):
        print(f"    solver_niter[0] sum: {solver_niter_sum}")
    if hasattr(d2, 'solver_nnz'):
        print(f"    solver_nnz: {d2.solver_nnz}")
    print(f"    max ncon: {max_ncon}")
    print(f"    max penetration (-dist): {max_pen:.6e}")
    # Print raw ncon at checkpoints
    for cp in [0, 100, 200, 500, 900, 999]:
        print(f"    ncon@{cp} = {ncon_vals[cp]}")

# ── A3: seed 0 detailed contact info ────────────────────────────────────────
print("\n--- A3: Seed 0 contact details ---")
d3 = mujoco.MjData(m)
rng = np.random.default_rng(0)
d3.qpos += rng.normal(0, 0.01, size=d3.qpos.shape)
mujoco.mj_forward(m, d3)
max_ncon_0 = 0
max_pen_0 = 0.0
for i in range(1000):
    mujoco.mj_step(m, d3)
    if d3.ncon > max_ncon_0:
        max_ncon_0 = d3.ncon
    if d3.ncon > 0:
        pen = -d3.contact.dist[:d3.ncon]
        mp = pen.max()
        if mp > max_pen_0:
            max_pen_0 = mp
print(f"  max ncon over run: {max_ncon_0}")
print(f"  max penetration (-dist): {max_pen_0:.6e}")

# ── A4: Stage timing ────────────────────────────────────────────────────────
print("\n--- A4: Stage timing (µs/step) ---")

def timed_stage(label, setup_fn, step_fn, n=300):
    """Time a stage over n steps, starting from fresh MjData after mj_forward."""
    total = 0.0
    for _ in range(n):
        d = mujoco.MjData(m)
        rng = np.random.default_rng(0)
        d.qpos += rng.normal(0, 0.01, size=d.qpos.shape)
        setup_fn(m, d)
        t0 = time.perf_counter()
        step_fn(m, d)
        total += time.perf_counter() - t0
    return total / n * 1e6  # µs/step

# (a) full mj_step
t_a = timed_stage("mj_step",
    lambda m, d: mujoco.mj_forward(m, d),
    lambda m, d: [mujoco.mj_step(m, d) for _ in range(1)])
print(f"  (a) full mj_step:     {t_a:8.2f} µs/step")

# (b) mj_forward
t_b = timed_stage("mj_forward",
    lambda m, d: None,
    lambda m, d: mujoco.mj_forward(m, d))
print(f"  (b) mj_forward:       {t_b:8.2f} µs/step")

# (c) mj_step1
t_c = timed_stage("mj_step1",
    lambda m, d: mujoco.mj_forward(m, d),
    lambda m, d: mujoco.mj_step1(m, d))
print(f"  (c) mj_step1:         {t_c:8.2f} µs/step")

# (d) mj_step2
t_d = timed_stage("mj_step2",
    lambda m, d: (mujoco.mj_forward(m, d), mujoco.mj_step1(m, d)),
    lambda m, d: mujoco.mj_step2(m, d))
print(f"  (d) mj_step2:         {t_d:8.2f} µs/step")

# (e) mj_collision after mj_fwdPosition
t_e = timed_stage("mj_collision (after fwdPos)",
    lambda m, d: mujoco.mj_fwdPosition(m, d),
    lambda m, d: mujoco.mj_collision(m, d))
print(f"  (e) mj_collision:     {t_e:8.2f} µs/step")

# (f) mj_fwdPosition
t_f = timed_stage("mj_fwdPosition",
    lambda m, d: None,
    lambda m, d: mujoco.mj_fwdPosition(m, d))
print(f"  (f) mj_fwdPosition:   {t_f:8.2f} µs/step")

# (g) mj_makeConstraint after fwdPosition
t_g = timed_stage("mj_makeConstraint",
    lambda m, d: mujoco.mj_fwdPosition(m, d),
    lambda m, d: mujoco.mj_makeConstraint(m, d))
print(f"  (g) mj_makeConstraint:{t_g:8.2f} µs/step")

# (h) mj_fwdVelocity
t_h = timed_stage("mj_fwdVelocity",
    lambda m, d: (mujoco.mj_fwdPosition(m, d), mujoco.mj_collision(m, d), mujoco.mj_makeConstraint(m, d)),
    lambda m, d: mujoco.mj_fwdVelocity(m, d))
print(f"  (h) mj_fwdVelocity:   {t_h:8.2f} µs/step")

# (i) mj_fwdActuation
t_i = timed_stage("mj_fwdActuation",
    lambda m, d: (mujoco.mj_fwdPosition(m, d), mujoco.mj_collision(m, d),
                  mujoco.mj_makeConstraint(m, d), mujoco.mj_fwdVelocity(m, d)),
    lambda m, d: mujoco.mj_fwdActuation(m, d))
print(f"  (i) mj_fwdActuation:  {t_i:8.2f} µs/step")

# mj_kinematics loop
t_k = timed_stage("mj_kinematics",
    lambda m, d: None,
    lambda m, d: mujoco.mj_kinematics(m, d))
print(f"  mj_kinematics:        {t_k:8.2f} µs/step")

# ── A5: Narrowphase timing (collision disabled vs enabled) ──────────────────
print("\n--- A5: Narrowphase timing ---")

# Save original values
orig_contype = m.geom_contype.copy()
orig_conaffinity = m.geom_conaffinity.copy()

# Disabled
m.geom_contype[:] = 0
m.geom_conaffinity[:] = 0
t_disabled = timed_stage("mj_collision (geom disabled)",
    lambda m, d: mujoco.mj_fwdPosition(m, d),
    lambda m, d: mujoco.mj_collision(m, d))
print(f"  mj_collision (geom disabled): {t_disabled:8.2f} µs/step")

# Re-enabled
m.geom_contype[:] = orig_contype
m.geom_conaffinity[:] = orig_conaffinity
t_enabled = timed_stage("mj_collision (geom enabled)",
    lambda m, d: mujoco.mj_fwdPosition(m, d),
    lambda m, d: mujoco.mj_collision(m, d))
print(f"  mj_collision (geom enabled):  {t_enabled:8.2f} µs/step")

# ── Part B — candidate variants ─────────────────────────────────────────────
print("\n" + "=" * 70)
print("PART B — candidate variants")
print("=" * 70)

# Sanity check: baseline twice should match
print("\n--- Sanity check: baseline x2 ---")
s_base1, _ = run_harness(12345)
s_base2, _ = run_harness(12345)
diff = np.max(np.abs(s_base1 - s_base2))
print(f"  Baseline vs itself (seed 12345): max|Δ| = {diff}")
assert diff == 0.0, f"Sanity check failed: {diff}"
print("  OK Sanity check passed")

# Baseline timing
base_avg = baseline_time(5)
print(f"\n  Baseline avg time (5 runs): {base_avg:.4f} s/1000 steps")

results = []

def add_result(label, time_s, ratio, max_diff, norm_diff, has_nan, has_inf):
    results.append({
        'label': label,
        'time_s': time_s,
        'ratio': ratio,
        'max_diff': max_diff,
        'norm_diff': norm_diff,
        'nan': has_nan,
        'inf': has_inf,
    })

# V0 baseline
print("\n--- V0: baseline (no tweak) ---")
v0_times = []
for _ in range(5):
    seed = np.random.randint(0, 10000)
    t0 = time.perf_counter()
    _ = run_harness(seed)
    v0_times.append(time.perf_counter() - t0)
v0_avg = np.mean(v0_times)
s_v0, _ = run_harness(12345)
add_result("V0 baseline", v0_avg, 1.0, 0.0, 0.0, False, False)
print(f"  avg: {v0_avg:.4f} s, ratio: 1.000, max|Δ|: 0.0, norm: 0.0")

# V1: mjDSBL_LIMIT
print("\n--- V1: mjDSBL_LIMIT ---")
def tweak_v1(m, d):
    m.opt.disableflags |= mujoco.mjtDisableBit.mjDSBL_LIMIT
v1_times = []
for _ in range(5):
    seed = np.random.randint(0, 10000)
    t0 = time.perf_counter()
    _ = run_harness(seed, tweak=tweak_v1)
    v1_times.append(time.perf_counter() - t0)
v1_avg = np.mean(v1_times)
s_v1, _ = run_harness(12345, tweak=tweak_v1)
diff_v1 = np.max(np.abs(s_v1 - s_v0))
norm_v1 = np.linalg.norm(s_v1 - s_v0)
has_nan_v1 = bool(np.isnan(s_v1).any())
has_inf_v1 = bool(np.isinf(s_v1).any())
add_result("V1 mjDSBL_LIMIT", v1_avg, v1_avg/v0_avg, diff_v1, norm_v1, has_nan_v1, has_inf_v1)
print(f"  avg: {v1_avg:.4f} s, ratio: {v1_avg/v0_avg:.3f}, max|Δ|: {diff_v1:.6e}, norm: {norm_v1:.6e}, NaN: {has_nan_v1}, Inf: {has_inf_v1}")

# V2: individual disable flags
print("\n--- V2: individual disable flags ---")
disable_flags = [
    ('mjDSBL_LIMIT', mujoco.mjtDisableBit.mjDSBL_LIMIT),
    ('mjDSBL_CONTACT', mujoco.mjtDisableBit.mjDSBL_CONTACT),
    ('mjDSBL_FRICTIONLOSS', mujoco.mjtDisableBit.mjDSBL_FRICTIONLOSS),
    ('mjDSBL_SENSOR', mujoco.mjtDisableBit.mjDSBL_SENSOR),
    ('mjDSBL_WARMSTART', mujoco.mjtDisableBit.mjDSBL_WARMSTART),
    ('mjDSBL_AUTORESET', mujoco.mjtDisableBit.mjDSBL_AUTORESET),
    ('mjDSBL_NATIVECCD', mujoco.mjtDisableBit.mjDSBL_NATIVECCD),
    ('mjDSBL_MULTICCD', mujoco.mjtDisableBit.mjDSBL_MULTICCD),
    ('mjDSBL_EQUALITY', mujoco.mjtDisableBit.mjDSBL_EQUALITY),
    ('mjDSBL_CONSTRAINT', mujoco.mjtDisableBit.mjDSBL_CONSTRAINT),
]

for flag_name, flag_val in disable_flags:
    def make_tweak(fv):
        def tweak(m, d):
            m.opt.disableflags |= fv
        return tweak
    tweak_fn = make_tweak(flag_val)
    times = []
    for _ in range(5):
        seed = np.random.randint(0, 10000)
        t0 = time.perf_counter()
        _ = run_harness(seed, tweak=tweak_fn)
        times.append(time.perf_counter() - t0)
    avg = np.mean(times)
    s_v, _ = run_harness(12345, tweak=tweak_fn)
    diff_v = np.max(np.abs(s_v - s_v0))
    norm_v = np.linalg.norm(s_v - s_v0)
    nan_v = bool(np.isnan(s_v).any())
    inf_v = bool(np.isinf(s_v).any())
    add_result(f"V2 {flag_name}", avg, avg/v0_avg, diff_v, norm_v, nan_v, inf_v)
    print(f"  {flag_name}: avg={avg:.4f} s, ratio={avg/v0_avg:.3f}, max|Δ|={diff_v:.6e}, norm={norm_v:.6e}, NaN={nan_v}, Inf={inf_v}")

# V3: no collision (geom_contype/conaffinity = 0)
print("\n--- V3: no collision (geom disabled) ---")
def tweak_v3(m, d):
    m.geom_contype[:] = 0
    m.geom_conaffinity[:] = 0
v3_times = []
for _ in range(5):
    seed = np.random.randint(0, 10000)
    t0 = time.perf_counter()
    _ = run_harness(seed, tweak=tweak_v3)
    v3_times.append(time.perf_counter() - t0)
v3_avg = np.mean(v3_times)
s_v3, _ = run_harness(12345, tweak=tweak_v3)
diff_v3 = np.max(np.abs(s_v3 - s_v0))
norm_v3 = np.linalg.norm(s_v3 - s_v0)
nan_v3 = bool(np.isnan(s_v3).any())
inf_v3 = bool(np.isinf(s_v3).any())
add_result("V3 no collision", v3_avg, v3_avg/v0_avg, diff_v3, norm_v3, nan_v3, inf_v3)
print(f"  avg: {v3_avg:.4f} s, ratio: {v3_avg/v0_avg:.3f}, max|Δ|: {diff_v3:.6e}, norm: {norm_v3:.6e}, NaN: {nan_v3}, Inf: {inf_v3}")

# V3 + mjDSBL_CONTACT (if baseline ncon was 0)
# We already know from A2 that ncon > 0, so skip unless needed
# But let's check: if V3 diff is large, also try V3+DSBL_CONTACT
if diff_v3 > 1e-5:
    print("  V3 diff > 1e-5, trying V3 + mjDSBL_CONTACT...")
    def tweak_v3c(m, d):
        m.geom_contype[:] = 0
        m.geom_conaffinity[:] = 0
        m.opt.disableflags |= mujoco.mjtDisableBit.mjDSBL_CONTACT
    v3c_times = []
    for _ in range(5):
        seed = np.random.randint(0, 10000)
        t0 = time.perf_counter()
        _ = run_harness(seed, tweak=tweak_v3c)
        v3c_times.append(time.perf_counter() - t0)
    v3c_avg = np.mean(v3c_times)
    s_v3c, _ = run_harness(12345, tweak=tweak_v3c)
    diff_v3c = np.max(np.abs(s_v3c - s_v0))
    norm_v3c = np.linalg.norm(s_v3c - s_v0)
    nan_v3c = bool(np.isnan(s_v3c).any())
    inf_v3c = bool(np.isinf(s_v3c).any())
    add_result("V3+DSBL_CONTACT", v3c_avg, v3c_avg/v0_avg, diff_v3c, norm_v3c, nan_v3c, inf_v3c)
    print(f"  avg: {v3c_avg:.4f} s, ratio: {v3c_avg/v0_avg:.3f}, max|Δ|: {diff_v3c:.6e}, norm: {norm_v3c:.6e}, NaN: {nan_v3c}, Inf: {inf_v3c}")

# V4: jacobian types
print("\n--- V4: jacobian types ---")
for jac_name, jac_val in [('mjJAC_DENSE', mujoco.mjtJacobian.mjJAC_DENSE),
                           ('mjJAC_SPARSE', mujoco.mjtJacobian.mjJAC_SPARSE)]:
    def make_tweak_jac(jv):
        def tweak(m, d):
            m.opt.jacobian = jv
        return tweak
    tweak_fn = make_tweak_jac(jac_val)
    times = []
    for _ in range(5):
        seed = np.random.randint(0, 10000)
        t0 = time.perf_counter()
        _ = run_harness(seed, tweak=tweak_fn)
        times.append(time.perf_counter() - t0)
    avg = np.mean(times)
    s_v, _ = run_harness(12345, tweak=tweak_fn)
    diff_v = np.max(np.abs(s_v - s_v0))
    norm_v = np.linalg.norm(s_v - s_v0)
    nan_v = bool(np.isnan(s_v).any())
    inf_v = bool(np.isinf(s_v).any())
    add_result(f"V4 {jac_name}", avg, avg/v0_avg, diff_v, norm_v, nan_v, inf_v)
    print(f"  {jac_name}: avg={avg:.4f} s, ratio={avg/v0_avg:.3f}, max|Δ|={diff_v:.6e}, norm={norm_v:.6e}, NaN={nan_v}, Inf={inf_v}")

# V5: iterations
print("\n--- V5: iterations ---")
for iter_name, iter_val in [('ls_iterations=5', ('ls', 5)), ('ls_iterations=1', ('ls', 1)),
                             ('iterations=10', ('iterations', 10)), ('iterations=5', ('iterations', 5)),
                             ('iterations=2', ('iterations', 2)), ('iterations=1', ('iterations', 1))]:
    def make_tweak_iter(attr, val):
        def tweak(m, d):
            setattr(m.opt, attr, val)
        return tweak
    tweak_fn = make_tweak_iter(iter_val[0], iter_val[1])
    times = []
    for _ in range(5):
        seed = np.random.randint(0, 10000)
        t0 = time.perf_counter()
        _ = run_harness(seed, tweak=tweak_fn)
