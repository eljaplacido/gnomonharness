    print(f"  Ratio (variant/base): {ratio:.4f}")
    
    # Accuracy: 20 seeds (reduced from 40 for speed)
    max_abs_diffs = []
    norms = []
    worst_seed = -1
    worst_max_abs = -1
    has_nan = False
    has_inf = False
    
    for seed in range(20):
        s_var = sim(m, seed)
        s_base = sim(m_base, seed)
        
        if np.any(np.isnan(s_var)) or np.any(np.isnan(s_base)):
            has_nan = True
        if np.any(np.isinf(s_var)) or np.any(np.isinf(s_base)):
            has_inf = True
        
        diff = np.abs(s_var - s_base)
        max_abs = np.max(diff)
        norm = np.linalg.norm(s_var - s_base)
        
        max_abs_diffs.append(max_abs)
        norms.append(norm)
        
        if max_abs > worst_max_abs:
            worst_max_abs = max_abs
            worst_seed = seed
    
    mean_max_abs = np.mean(max_abs_diffs)
    
    print(f"  Worst max-abs: {worst_max_abs:.6e} (seed {worst_seed})")
    print(f"  Mean max-abs: {mean_max_abs:.6e}")
    print(f"  Worst norm: {max(norms):.6e}")
    print(f"  NaN: {has_nan}, Inf: {has_inf}")
    
    results[cid] = {
