        "base_us": base_us,
        "worst_max_abs": worst_max_abs,
        "worst_seed": worst_seed,
        "mean_max_abs": mean_max_abs,
        "worst_norm": max(norms),
        "has_nan": has_nan,
        "has_inf": has_inf,
    }

