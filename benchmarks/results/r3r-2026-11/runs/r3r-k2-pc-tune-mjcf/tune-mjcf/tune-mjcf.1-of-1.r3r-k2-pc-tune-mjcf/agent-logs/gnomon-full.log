print("-" * 90)
for r in results:
    nan_str = "YES" if r['nan'] else "no"
    inf_str = "YES" if r['inf'] else "no"
    print(f"{r['label']:<30} {r['time_s']:10.4f} {r['ratio']:8.3f} {r['max_diff']:14.6e} {r['norm_diff']:14.6e} {nan_str:>5} {inf_str:>5}")

