# Compact table
print("\n" + "=" * 70)
print("COMPACT TABLE")
print("=" * 70)
print(f"{'Variant':<30} {'s/1000':>10} {'ratio':>8} {'max|Δ|':>14} {'norm':>14} {'NaN':>5} {'Inf':>5}")
print("-" * 90)
for r in results:
