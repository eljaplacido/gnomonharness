inf_v7 = bool(np.isinf(s_v7).any())
add_result("V7 mjCONE_ELLIPTIC", v7_avg, v7_avg/v0_avg, diff_v7, norm_v7, nan_v7, inf_v7)
print(f"  avg: {v7_avg:.4f} s, ratio: {v7_avg/v0_avg:.3f}, max|Δ|: {diff_v7:.6e}, norm: {norm_v7:.6e}, NaN: {nan_v7}, Inf: {inf_v7}")

# V8: remove actuator
print("\n--- V8: remove actuator ---")
with open('/app/model_ref.xml', 'r') as f:
