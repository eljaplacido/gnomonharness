results = []

def add_result(label, time_s, ratio, max_diff, norm_diff, has_nan, has_inf):
    results.append({
        'label': label, 'time_s': time_s, 'ratio': ratio,
        'max_diff': max_diff, 'norm_diff': norm_diff,
        'nan': has_nan, 'inf': has_inf,
    })

