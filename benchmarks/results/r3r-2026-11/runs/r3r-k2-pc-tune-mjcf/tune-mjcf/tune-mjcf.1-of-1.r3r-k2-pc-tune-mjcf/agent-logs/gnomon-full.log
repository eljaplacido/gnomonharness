        s = np.zeros(mujoco.mj_stateSize(m_v9, fp))
        mujoco.mj_getState(m_v9, d, s, fp)
        return s
    v9_times = []
    for _ in range(5):
        seed = np.random.randint(0, 10000)
        t0 = time.perf_counter()
        _ = run_v9(seed)
        v9_times.append(time.perf_counter() - t0)
    v9_avg = np.mean(v9_times)
    s_v9 = run_v9(12345)
    if s_v9.shape == s_v0.shape:
