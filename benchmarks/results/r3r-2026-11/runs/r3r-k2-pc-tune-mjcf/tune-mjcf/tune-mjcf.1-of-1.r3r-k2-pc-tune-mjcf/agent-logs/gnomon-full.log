print(f"Within 1e-5: {[r['label'] for r in close]}")
print(f"Faster AND bit-exact: {[r['label'] for r in faster_exact]}")
if faster_exact:
    best = min(faster_exact, key=lambda r: r['ratio'])
    print(f"Fastest exact: {best['label']} at {best['ratio']:.3f}x")
