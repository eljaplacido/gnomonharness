exact = [r for r in results if r['max_diff'] == 0.0]
close = [r for r in results if 0.0 < r['max_diff'] <= 1e-5]
faster_exact = [r for r in results if r['max_diff'] == 0.0 and r['ratio'] < 1.0]
print(f"\nBit-exact (max|Δ|=0.0): {[r['label'] for r in exact]}")
print(f"Within 1e-5: {[r['label'] for r in close]}")
print(f"Faster AND bit-exact: {[r['label'] for r in faster_exact]}")
if faster_exact:
    best = min(faster_exact, key=lambda r: r['ratio'])
    print(f"Fastest exact: {best['label']} at {best['ratio']:.3f}x")
