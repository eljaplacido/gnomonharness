//===-- linux_syscalls_compat.h ---------------------------------*- C -*-===//
//
//                     The KLEE Symbolic Virtual Machine
//
// This file is distributed under the University of Illinois Open Source
// License. See LICENSE.TXT for details.
//
//===----------------------------------------------------------------------===//
//
// Portability shim for Linux architectures (e.g. AArch64) that do not
// provide the legacy non-"at" system call numbers (__NR_open, __NR_stat,
// __NR_select, ...).  The calls are emulated with their "at" variants.
//
//===----------------------------------------------------------------------===//

#ifndef KLEE_LINUX_SYSCALLS_COMPAT_H
#define KLEE_LINUX_SYSCALLS_COMPAT_H

