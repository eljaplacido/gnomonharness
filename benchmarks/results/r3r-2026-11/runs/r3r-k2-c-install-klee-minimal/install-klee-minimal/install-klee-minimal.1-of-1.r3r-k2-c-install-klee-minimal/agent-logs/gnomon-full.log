#include <sys/stat.h>
#include <sys/syscall.h>
#include <sys/time.h>
#include <time.h>
#include <unistd.h>

#ifndef AT_FDCWD
#define AT_FDCWD -100
#endif

#ifndef AT_SYMLINK_NOFOLLOW
#define AT_SYMLINK_NOFOLLOW 0x100
#endif

static long __klee_syscall_access(const char *path, int mode) {
#if defined(__NR_access)
  return syscall(__NR_access, path, mode);
#else
  return syscall(__NR_faccessat, (long)AT_FDCWD, path, (long)mode, 0L);
#endif
}

static long __klee_syscall_open(const char *path, int flags, mode_t mode) {
#if defined(__NR_open)
  return syscall(__NR_open, path, (long)flags, (long)mode);
#else
  return syscall(__NR_openat, (long)AT_FDCWD, path, (long)flags, (long)mode);
#endif
}

static void __klee_timevals_to_timespecs(const struct timeval *tv,
                                         struct timespec *ts) {
  int i;
  for (i = 0; i < 2; ++i) {
    ts[i].tv_sec = tv[i].tv_sec;
    ts[i].tv_nsec = (long)tv[i].tv_usec * 1000L;
  }
}

static long __klee_syscall_utimes(const char *path,
                                  const struct timeval times[2]) {
#if defined(__NR_utimes)
  return syscall(__NR_utimes, path, times);
#else
  struct timespec ts[2];
  if (!times)
    return syscall(__NR_utimensat, (long)AT_FDCWD, path, NULL, 0L);
  __klee_timevals_to_timespecs(times, ts);
  return syscall(__NR_utimensat, (long)AT_FDCWD, path, ts, 0L);
#endif
}

static long __klee_syscall_futimesat(int fd, const char *path,
                                     const struct timeval times[2]) {
#if defined(__NR_futimesat)
  return syscall(__NR_futimesat, (long)fd, path, times);
#else
  struct timespec ts[2];
  if (!times)
    return syscall(__NR_utimensat, (long)fd, path, NULL, 0L);
  __klee_timevals_to_timespecs(times, ts);
  return syscall(__NR_utimensat, (long)fd, path, ts, 0L);
#endif
}

static long __klee_syscall_stat(const char *path, struct stat64 *buf) {
#if defined(__NR_stat)
  return syscall(__NR_stat, path, buf);
#elif __WORDSIZE == 64
  return syscall(__NR_newfstatat, (long)AT_FDCWD, path, buf, 0L);
#else
  return syscall(__NR_fstatat64, (long)AT_FDCWD, path, buf, 0L);
#endif
}

static long __klee_syscall_lstat(const char *path, struct stat64 *buf) {
#if defined(__NR_lstat)
  return syscall(__NR_lstat, path, buf);
#elif __WORDSIZE == 64
  return syscall(__NR_newfstatat, (long)AT_FDCWD, path, buf,
                 (long)AT_SYMLINK_NOFOLLOW);
#else
  return syscall(__NR_fstatat64, (long)AT_FDCWD, path, buf,
                 (long)AT_SYMLINK_NOFOLLOW);
#endif
}

static long __klee_syscall_chmod(const char *path, mode_t mode) {
#if defined(__NR_chmod)
  return syscall(__NR_chmod, path, (long)mode);
#else
  return syscall(__NR_fchmodat, (long)AT_FDCWD, path, (long)mode, 0L);
#endif
}

static long __klee_syscall_chown(const char *path, uid_t owner, gid_t group) {
#if defined(__NR_chown)
  return syscall(__NR_chown, path, (long)owner, (long)group);
#else
  return syscall(__NR_fchownat, (long)AT_FDCWD, path, (long)owner,
                 (long)group, 0L);
#endif
}

static long __klee_syscall_lchown(const char *path, uid_t owner, gid_t group) {
#if defined(__NR_lchown)
  return syscall(__NR_lchown, path, (long)owner, (long)group);
#else
  return syscall(__NR_fchownat, (long)AT_FDCWD, path, (long)owner,
                 (long)group, (long)AT_SYMLINK_NOFOLLOW);
#endif
}

static long __klee_syscall_readlink(const char *path, char *buf, size_t bufsize) {
#if defined(__NR_readlink)
  return syscall(__NR_readlink, path, buf, bufsize);
#else
  return syscall(__NR_readlinkat, (long)AT_FDCWD, path, buf, bufsize);
#endif
}

static long __klee_syscall_select(int nfds, fd_set *readfds, fd_set *writefds,
                                  fd_set *exceptfds, struct timeval *timeout) {
#if defined(__NR_select)
  return syscall(__NR_select, (long)nfds, readfds, writefds, exceptfds, timeout);
#else
  struct timespec ts, *tsp = NULL;
  if (timeout) {
    ts.tv_sec = timeout->tv_sec;
    ts.tv_nsec = (long)timeout->tv_usec * 1000L;
    tsp = &ts;
  }
  /* pselect6(sig) argument: kernel expects a pointer to {sigset, sigsetsize} */
  return syscall(__NR_pselect6, (long)nfds, readfds, writefds, exceptfds, tsp,
                 NULL);
#endif
}

#endif /* KLEE_LINUX_SYSCALLS_COMPAT_H */
