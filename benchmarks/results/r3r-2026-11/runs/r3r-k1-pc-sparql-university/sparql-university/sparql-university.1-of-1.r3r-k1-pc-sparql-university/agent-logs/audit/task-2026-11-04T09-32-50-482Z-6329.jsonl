{"seq":40,"ts":"2026-11-04T09:34:46.613Z","kind":"approval","prev":"19a838e65a98bea6b263b7f1b621394eb2c1825bb5b5c2cdbbc46194b4abc951","tool":"bash","summary":"bash: cat > /tmp/debug.py << 'PYEOF'\nfrom rdflib import Graph, Namespace, Literal, URIRef\nfrom rdflib.namespace import XSD\n\ng = Graph()\ng.parse(\"university_graph.ttl\", format=\"turtle\")\n\n# Check STS101 enrollments\nns = Namespace(\"http://university.org/ontology/\")\nsts101 = ns.STS101\n\n# Get all students enrolled in STS101\nquery = \"\"\"\nPREFIX uni: <http://university.org/ontology/>\nPREFIX xsd: <http://www.w3.org/2001/XMLSchema#>\n\nSELECT ?student ?name ?enrollDate ?gradDate\nWHERE {\n  ?student uni:isEnrolledIn uni:STS101 ;\n           uni:hasName ?name .\n  OPTIONAL { ?student uni:hasEnrollmentDate ?enrollDate } .\n  OPTIONAL { ?student uni:hasGraduationDate ?gradDate } .\n}\n\"\"\"\nresults = g.query(query)\nprint(\"All students enrolled in STS101:\")\nfor row in results:\n    print(f\"  {row.name}: enroll={row.enrollDate}, grad={row.gradDate}\")\n\n# Now check which are currently enrolled\nquery2 = \"\"\"\nPREFIX uni: <http://university.org/ontology/>\nPREFIX xsd: <http://www.w3.org/2001/XMLSchema#>\n\nSELECT (COUNT(DISTINCT ?student) AS ?count)\nWHERE {\n  ?student a uni:Person ;\n           uni:isEnrolledIn uni:STS101 .\n  OPTIONAL { ?student uni:hasEnrollmentDate ?enrollDate } .\n  FILTER(!BOUND(?enrollDate) || ?enrollDate <= \"2025-08-16\"^^xsd:date)\n  OPTIONAL { ?student uni:hasGraduationDate ?gradDate } .\n  FILTER(!BOUND(?gradDate) || ?gradDate >= \"2025-08-16\"^^xsd:date)\n}\n\"\"\"\nresults2 = g.query(query2)\nfor row in results2:\n    print(f\"\\nCurrently enrolled in STS101: {row.count}\")\nPYEOF\npython3 /tmp/debug.py","decision":"approved","by":"flag:--yes","interactive":false,"hash":"c7565097033dfe9e42c75000e4278499e9180ba520a266d4a684bf4545e2ab6e"}
