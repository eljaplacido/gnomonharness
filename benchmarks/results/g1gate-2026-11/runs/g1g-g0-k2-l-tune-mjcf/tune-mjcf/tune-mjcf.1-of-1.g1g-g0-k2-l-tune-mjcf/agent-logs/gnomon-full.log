    data2 = mujoco.MjData(model)
    rng2 = np.random.default_rng(np.random.randint(0, 10000))
    data2.qpos += rng2.normal(0, 0.01, size=data2.qpos.shape)
    mujoco.mj_forward(model, data2)
    t0 = time.perf_counter()
    nstep = int(2.0 / model.opt.timestep)
    for _ in range(nstep):
