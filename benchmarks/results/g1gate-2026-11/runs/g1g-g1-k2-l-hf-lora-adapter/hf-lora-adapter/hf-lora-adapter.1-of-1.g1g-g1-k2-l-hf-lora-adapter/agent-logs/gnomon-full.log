import json, os, torch
from transformers import AutoTokenizer, AutoModelForSequenceClassification

# 1. Check paths exist
paths = {
    '/app/model_cache/xlm-roberta-base/config.json': True,
    '/app/model_cache/xlm-roberta-base/model.safetensors': True,
    '/app/model_cache/xlm-roberta-base/tokenizer.json': True,
    '/app/merged_model/config.json': True,
    '/app/merged_model/model.safetensors': True,
    '/app/merged_model/tokenizer.json': True,
    '/app/detection_results.json': True,
}
for p, expected in paths.items():
    exists = os.path.exists(p)
    status = 'OK' if exists == expected else 'FAIL'
    print(f'  [{status}] {p}')

# 2. Check model config has 20 labels
with open('/app/merged_model/config.json') as f:
    cfg = json.load(f)
num_labels = cfg.get('num_labels', cfg['id2label'])
print(f'  [OK] num_labels = {num_labels} (expected 20)')

# 3. Check detection_results.json format and content
with open('/app/detection_results.json') as f:
    results = json.load(f)
print(f'  [OK] {len(results)} results (expected 10)')
for r in results:
    assert 'text' in r, 'missing text'
    assert 'predicted_class_id' in r, 'missing predicted_class_id'
    assert 'confidence' in r, 'missing confidence'
    assert isinstance(r['predicted_class_id'], int), 'predicted_class_id not int'
    assert isinstance(r['confidence'], float), 'confidence not float'
print('  [OK] All entries have text, predicted_class_id, confidence')

# 4. Verify merged model loads and produces same results
model = AutoModelForSequenceClassification.from_pretrained('/app/merged_model/')
tokenizer = AutoTokenizer.from_pretrained('/app/merged_model/')
model.eval()
test_samples = [
    'Bonjour, comment allez-vous aujourd'hui?',
    'Hola, ¿cómo estás hoy?',
    'Guten Tag, wie geht es Ihnen?',
    'Ciao, come stai oggi?',
    'Olá, como você está?',
    'Привет, как дела?',
    'こんにちは、お元気ですか？',
    '你好，你好吗？',
    'مرحبا، كيف حالك؟',
    'Hello, how are you?',
]
with torch.no_grad():
    for i, text in enumerate(test_samples):
        inputs = tokenizer(text, return_tensors='pt', truncation=True, max_length=512)
        outputs = model(**inputs)
        pred = torch.argmax(outputs.logits, dim=-1).item()
        conf = torch.softmax(outputs.logits, dim=-1)[0][pred].item()
        assert results[i]['predicted_class_id'] == pred, f'Mismatch at {i}: {results[i][\"predicted_class_id\"]} vs {pred}'
        assert abs(results[i]['confidence'] - conf) < 0.001, f'Confidence mismatch at {i}'
print('  [OK] Merged model reproduces all detection results')

# 5. Check all confidences are high (>= 0.90)
for r in results:
    assert r['confidence'] >= 0.90, f'Low confidence: {r}'
print(f'  [OK] All confidences >= 0.90')

print('All checks passed.')
