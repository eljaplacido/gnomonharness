{"seq":34,"ts":"2026-11-06T07:56:01.595Z","kind":"approval","prev":"ad4b0709e783e6a1e5347ea59e15cc98770ac9c38389a220f845c433d0b73fdf","tool":"bash","summary":"bash: cd /app && python3 -c \"\nimport json, os, torch\nfrom transformers import AutoTokenizer, AutoModelForSequenceClassification\n\n# 1. Check paths exist\npaths = {\n    '/app/model_cache/xlm-roberta-base/config.json': True,\n    '/app/model_cache/xlm-roberta-base/model.safetensors': True,\n    '/app/model_cache/xlm-roberta-base/tokenizer.json': True,\n    '/app/merged_model/config.json': True,\n    '/app/merged_model/model.safetensors': True,\n    '/app/merged_model/tokenizer.json': True,\n    '/app/detection_results.json': True,\n}\nfor p, expected in paths.items():\n    exists = os.path.exists(p)\n    status = 'OK' if exists == expected else 'FAIL'\n    print(f'  [{status}] {p}')\n\n# 2. Check model config has 20 labels\nwith open('/app/merged_model/config.json') as f:\n    cfg = json.load(f)\nnum_labels = cfg.get('num_labels', cfg['id2label'])\nprint(f'  [OK] num_labels = {num_labels} (expected 20)')\n\n# 3. Check detection_results.json format and content\nwith open('/app/detection_results.json') as f:\n    results = json.load(f)\nprint(f'  [OK] {len(results)} results (expected 10)')\nfor r in results:\n    assert 'text' in r, 'missing text'\n    assert 'predicted_class_id' in r, 'missing predicted_class_id'\n    assert 'confidence' in r, 'missing confidence'\n    assert isinstance(r['predicted_class_id'], int), 'predicted_class_id not int'\n    assert isinstance(r['confidence'], float), 'confidence not float'\nprint('  [OK] All entries have text, predicted_class_id, confidence')\n\n# 4. Verify merged model loads and produces same results\nmodel = AutoModelForSequenceClassification.from_pretrained('/app/merged_model/')\ntokenizer = AutoTokenizer.from_pretrained('/app/merged_model/')\nmodel.eval()\ntest_samples = [\n    'Bonjour, comment allez-vous aujourd'hui?',\n    'Hola, ¿cómo estás hoy?',\n    'Guten Tag, wie geht es Ihnen?',\n    'Ciao, come stai oggi?',\n    'Olá, como você está?',\n    'Привет, как дела?',\n    'こんにちは、お元気ですか？',\n    '你好，你好吗？',\n    'مرحبا، كيف حالك؟',\n    'Hello, how are you?',\n]\nwith torch.no_grad():\n    for i, text in enumerate(test_samples):\n        inputs = tokenizer(text, return_tensors='pt', truncation=True, max_length=512)\n        outputs = model(**inputs)\n        pred = torch.argmax(outputs.logits, dim=-1).item()\n        conf = torch.softmax(outputs.logits, dim=-1)[0][pred].item()\n        assert results[i]['predicted_class_id'] == pred, f'Mismatch at {i}: {results[i][\\\"predicted_class_id\\\"]} vs {pred}'\n        assert abs(results[i]['confidence'] - conf) < 0.001, f'Confidence mismatch at {i}'\nprint('  [OK] Merged model reproduces all detection results')\n\n# 5. Check all confidences are high (>= 0.90)\nfor r in results:\n    assert r['confidence'] >= 0.90, f'Low confidence: {r}'\nprint(f'  [OK] All confidences >= 0.90')\n\nprint('All checks passed.')\n\" 2>&1","decision":"approved","by":"flag:--yes","interactive":false,"hash":"932b1342616f0707b000c4b127b2a9b73e144ab38d521c0ed3b03ff1174dab5e"}
