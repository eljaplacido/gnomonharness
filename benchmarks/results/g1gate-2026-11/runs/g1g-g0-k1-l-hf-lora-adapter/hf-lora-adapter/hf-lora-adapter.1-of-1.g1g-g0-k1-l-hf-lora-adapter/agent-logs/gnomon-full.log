from transformers import AutoTokenizer, AutoModelForSequenceClassification
import torch, json

model = AutoModelForSequenceClassification.from_pretrained('/app/merged_model')
tokenizer = AutoTokenizer.from_pretrained('/app/merged_model')
model.eval()

with open('/app/detection_results.json') as f:
    results = json.load(f)

tokenizer.padding_side = 'right'
correct = 0
with torch.no_grad():
    for r in results:
        inputs = tokenizer(r['text'], return_tensors='pt', padding=True, truncation=True, max_length=512)
        outputs = model(**inputs)
        pred = int(torch.argmax(torch.softmax(outputs.logits, dim=-1), dim=-1).item())
        conf = float(torch.max(torch.softmax(outputs.logits, dim=-1)).item())
        match = '✓' if pred == r['predicted_class_id'] else '✗'
        if pred == r['predicted_class_id']:
            correct += 1
        print(f'{match} {r[\"text\"][:35]:<40} pred={pred} conf={conf:.4f} (saved: {r[\"predicted_class_id\"]})')

print(f'\nVerification: {correct}/{len(results)} predictions match saved results')
