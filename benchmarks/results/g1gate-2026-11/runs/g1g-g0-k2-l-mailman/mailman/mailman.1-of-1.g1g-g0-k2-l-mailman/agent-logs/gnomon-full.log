print(f"List exists: {mlist.list_name}")
print(f"Posting address: {mlist.posting_address}")
print(f"Join address: {mlist.join_address}")
print(f"Leave address: {mlist.leave_address}")
print(f"Confirm address: {mlist.confirm_address}")
print(f"Subscription policy: {mlist.subscription_policy}")
