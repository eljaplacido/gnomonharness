[approval] bash: # Now start the Mailman LMTP runner and other necessary runners
# The LMTP runner listens on port 8024 for incoming mail from Postfix
# The command runner processes join/leave/confirm commands
# The incoming runner processes list posts
# The outgoing runner sends messages to subscribers

# Start the LMTP runner
MAILMAN_UNDER_MASTER_CONTROL=1 mailman runner lmtp &
LMTP_PID=$!
echo "LMTP runner started with PID: $LMTP_PID"

# Start the command runner (handles join/leave/confirm)
MAILMAN_UNDER_MASTER_CONTROL=1 mailman runner command &
CMD_PID=$!
echo "Command runner started with PID: $CMD_PID"

# Start the incoming runner (handles list posts)
MAILMAN_UNDER_MASTER_CONTROL=1 mailman runner in &
IN_PID=$!
echo "Incoming runner started with PID: $IN_PID"

# Start the outgoing runner (sends to subscribers)
MAILMAN_UNDER_MASTER_CONTROL=1 mailman runner out &
OUT_PID=$!
echo "Outgoing runner started with PID: $OUT_PID"

# Start the pipeline runner (processes approved messages)
MAILMAN_UNDER_MASTER_CONTROL=1 mailman runner pipeline &
PIPE_PID=$!
echo "Pipeline runner started with PID: $PIPE_PID"

# Start the virgin runner (handles unprocessed messages)
MAILMAN_UNDER_MASTER_CONTROL=1 mailman runner virgin &
VIRGIN_PID=$!
echo "Virgin runner started with PID: $VIRGIN_PID"

# Start the bounces runner
MAILMAN_UNDER_MASTER_CONTROL=1 mailman runner bounces &
BOUNCE_PID=$!
echo "Bounces runner started with PID: $BOUNCE_PID"

# Start the retry runner
MAILMAN_UNDER_MASTER_CONTROL=1 mailman runner retry &
RETRY_PID=$!
echo "Retry runner started with PID: $RETRY_PID"

# Start the archive runner
MAILMAN_UNDER_MASTER_CONTROL=1 mailman runner archive &
ARCHIVE_PID=$!
echo "Archive runner started with PID: $ARCHIVE_PID"

# Start the task runner
MAILMAN_UNDER_MASTER_CONTROL=1 mailman runner task &
TASK_PID=$!
echo "Task runner started with PID: $TASK_PID"

# Start the digest runner
MAILMAN_UNDER_MASTER_CONTROL=1 mailman runner digest &
DIGEST_PID=$!
echo "Digest runner started with PID: $DIGEST_PID"

# Start the rest runner
MAILMAN_UNDER_MASTER_CONTROL=1 mailman runner rest &
REST_PID=$!
echo "REST runner started with PID: $REST_PID"

# Start the shunt runner
MAILMAN_UNDER_MASTER_CONTROL=1 mailman runner shunt &
SHUNT_PID=$!
echo "Shunt runner started with PID: $SHUNT_PID"

sleep 2
echo "All runners started" — approved
