import json, os

# Check all required files exist
files = {
    '/app/train_lora.py': 'training script',
    '/app/experiments/lora_adapter/adapter_config.json': 'LoRA config',
    '/app/experiments/lora_adapter/adapter_model.safetensors': 'LoRA weights',
    '/app/experiments/lora_adapter/tokenizer_config.json': 'tokenizer config',
    '/app/lora_results.json': 'results file',
}
for path, desc in files.items():
    assert os.path.exists(path), f'MISSING: {path} ({desc})'
    print(f'OK: {path} ({desc})')

# Check adapter_config.json has required fields
with open('/app/experiments/lora_adapter/adapter_config.json') as f:
    cfg = json.load(f)
assert 'base_model_name_or_path' in cfg, 'Missing base_model_name_or_path'
assert 'task_type' in cfg, 'Missing task_type'
assert cfg['r'] == 8, f'r={cfg[\"r\"]}, expected 8'
assert cfg['lora_alpha'] == 16, f'alpha={cfg[\"lora_alpha\"]}, expected 16'
assert cfg['target_modules'] == ['c_attn'], f'target_modules={cfg[\"target_modules\"]}'
print(f'OK: adapter_config.json has base_model_name_or_path={cfg[\"base_model_name_or_path\"]}, task_type={cfg[\"task_type\"]}, r=8, alpha=16, target_modules={cfg[\"target_modules\"]}')

# Check lora_results.json schema
with open('/app/lora_results.json') as f:
    results = json.load(f)
assert results['model'] == 'openai-community/gpt2'
assert results['lora_config']['r'] == 8
assert results['lora_config']['alpha'] == 16
assert isinstance(results['lora_config']['epochs'], int)
assert results['training_samples'] == 300
assert results['validation_samples'] == 100
print(f'OK: lora_results.json schema correct: {json.dumps(results, indent=2)}')

# Check data files
with open('/app/data/train.json') as f:
    train = json.load(f)
with open('/app/data/val.json') as f:
    val = json.load(f)
assert len(train) == 300, f'train has {len(train)} samples'
assert len(val) == 100, f'val has {len(val)} samples'
# Check each sample has exactly 4 options
for i, s in enumerate(train):
    assert len(s['options']) == 4, f'train[{i}] has {len(s[\"options\"])} options'
    assert s['answer'] in ['A','B','C','D'], f'train[{i}] answer={s[\"answer\"]}'
for i, s in enumerate(val):
    assert len(s['options']) == 4, f'val[{i}] has {len(s[\"options\"])} options'
    assert s['answer'] in ['A','B','C','D'], f'val[{i}] answer={s[\"answer\"]}'
print(f'OK: train.json has {len(train)} samples, val.json has {len(val)} samples, all have 4 options')

# Check adapter can be loaded
from peft import PeftModel
from transformers import AutoModelForCausalLM, AutoTokenizer
model = AutoModelForCausalLM.from_pretrained('openai-community/gpt2')
model = PeftModel.from_pretrained(model, '/app/experiments/lora_adapter')
tokenizer = AutoTokenizer.from_pretrained('/app/experiments/lora_adapter')
prompt = 'Question: What is hemoglobin?\nOptions:\nA) Oxygen transport\nB) Blood clotting\nC) Immune defense\nD) Nutrient digestion\nAnswer:'
inputs = tokenizer(prompt, return_tensors='pt')
outputs = model.generate(**inputs, max_new_tokens=10)
text = tokenizer.decode(outputs[0], skip_special_tokens=True)
print(f'OK: Adapter loads and generates: {repr(text[:120])}')

print()
print('ALL CHECKS PASSED')
