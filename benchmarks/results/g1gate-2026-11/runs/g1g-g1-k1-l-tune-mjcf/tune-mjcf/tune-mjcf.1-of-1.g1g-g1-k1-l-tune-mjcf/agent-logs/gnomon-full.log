import mujoco
import numpy as np

# Test with different timesteps
for ts in [0.002, 0.004, 0.005, 0.008, 0.01, 0.0125, 0.016, 0.02]:
    xml = open('model_ref.xml').read()
    xml = xml.replace('timestep=\"0.002\"', f'timestep=\"{ts}\"') if 'timestep' in xml else xml
    # Actually the ref doesn't have explicit timestep, so add it
    xml = xml.replace('<mujoco model=\"Cable\">', '<mujoco model=\"Cable\">')
    
    model = mujoco.MjModel.from_xml_string(xml)
    model.opt.timestep = ts
    data = mujoco.MjData(model)
    seed = 42
    rng = np.random.default_rng(seed)
    data.qpos += rng.normal(0, 0.01, size=data.qpos.shape)
    mujoco.mj_forward(model, data)
    
    nstep = int(2.0 / ts)
    for _ in range(nstep):
        mujoco.mj_step(model, data)
    
    full_physics = mujoco.mjtState.mjSTATE_FULLPHYSICS
    state = np.zeros(mujoco.mj_stateSize(model, full_physics))
    mujoco.mj_getState(model, data, state, full_physics)
    
    # Compare with reference
    model_ref = mujoco.MjModel.from_xml_string(xml)
    model_ref.opt.timestep = 0.002
    data_ref = mujoco.MjData(model_ref)
    data_ref.qpos = data.qpos.copy()  # same initial
    data_ref.qvel = data.qvel.copy()
    mujoco.mj_forward(model_ref, data_ref)
    nstep_ref = int(2.0 / 0.002)
    for _ in range(nstep_ref):
        mujoco.mj_step(model_ref, data_ref)
    
    state_ref = np.zeros(mujoco.mj_stateSize(model_ref, full_physics))
    mujoco.mj_getState(model_ref, data_ref, state_ref, full_physics)
    
    diff = np.linalg.norm(state - state_ref)
    print(f'ts={ts}: diff={diff:.6e}, nstep={nstep}, NaN={np.isnan(state).any()}, Inf={np.isinf(state).any()}')
