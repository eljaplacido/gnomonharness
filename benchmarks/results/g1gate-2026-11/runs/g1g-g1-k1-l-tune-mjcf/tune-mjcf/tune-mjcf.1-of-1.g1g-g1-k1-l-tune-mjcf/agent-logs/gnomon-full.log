import mujoco
import numpy as np

# The eval script simulates for total_sim_time = 2.0 seconds
# nstep = int(total_sim_time / model.opt.timestep)
# So with different timesteps, different number of steps
# But the final state should match within atol=1e-5

# Let's test with same timestep but different solver settings
model = mujoco.MjModel.from_xml_path('model_ref.xml')
data = mujoco.MjData(model)
seed = 42
rng = np.random.default_rng(seed)
data.qpos += rng.normal(0, 0.01, size=data.qpos.shape)
mujoco.mj_forward(model, data)

full_physics = mujoco.mjtState.mjSTATE_FULLPHYSICS
state = np.zeros(mujoco.mj_stateSize(model, full_physics))
mujoco.mj_getState(model, data, state, full_physics)
print('Reference state norm:', np.linalg.norm(state))

# Now try with different solver settings
model2 = mujoco.MjModel.from_xml_path('model_ref.xml')
model2.opt.iterations = 50
model2.opt.ls_iterations = 25
model2.opt.tolerance = 1e-6
model2.opt.solver = mujoco.mjtSolver.mjtSolver_PGS
model2.opt.impratio = 1.0

data2 = mujoco.MjData(model2)
data2.qpos = data.qpos.copy()
data2.qvel = data.qvel.copy()
mujoco.mj_forward(model2, data2)

nstep = int(2.0 / model2.opt.timestep)
for _ in range(nstep):
    mujoco.mj_step(model2, data2)

state2 = np.zeros(mujoco.mj_stateSize(model2, full_physics))
mujoco.mj_getState(model2, data2, state2, full_physics)
print('Modified state norm:', np.linalg.norm(state2))
print('Diff:', np.linalg.norm(state - state2))
