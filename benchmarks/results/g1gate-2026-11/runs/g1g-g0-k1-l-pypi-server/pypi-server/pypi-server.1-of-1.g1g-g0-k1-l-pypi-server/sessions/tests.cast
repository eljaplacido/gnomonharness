[5.718793, "o", "\r\n\r\n=========================================================================== FAILURES ===========================================================================\r\n\u001b[31m\u001b[1m___________________________________________________________________________ test_api ___________________________________________________________________________\u001b[0m\r\n\r\n"]
[5.730048, "o", "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mtest_api\u001b[39;49;00m():\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"Test the vectorops package API functionality.\u001b[39;49;00m\r\n    \u001b[33m\u001b[39;49;00m\r\n    \u001b[33m    This function imports the vectorops package and tests its dotproduct function\u001b[39;49;00m\r\n    \u001b[33m    with various input vectors to ensure it calculates dot products correctly.\u001b[39;49;00m\r\n    \u001b[33m\u001b[39;49;00m\r\n    \u001b[33m    Tests include:\u001b[39;49;00m\r\n    \u001b[33m    - 2D vectors: [1,1] · [0,1] = 1\u001b[39;49;00m\r\n    \u001b[33m    - 3D vectors: [1,1,0] · [1,1,0] = 2\u001b[39;49;00m\r\n    \u001b[33m    - 4D vectors with zeros: [1,1,0,0] · [1,0,0,21.2] = 1\u001b[39;49;00m\r\n    \u001b[33m    - 4D vectors with negative and decimal values: [1,-1,0,0.01] · [0,0,10,0] = 0\u001b[39;49;00m\r\n    \u001b[33m\u001b[39;49;00m\r\n    \u001b[33m    Raises:\u001b[39;49;00m\r\n    \u001b[33m        AssertionError: If any dot product calculation doesn't match expected result.\u001b[39;49;00m\r\n    \u001b[33m        ImportError: If vectorops package cannot be imported.\u001b[39;49;00m\r\n    \u001b[33m"]
