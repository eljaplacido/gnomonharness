[11.378986, "o", "   args:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11.379013, "o", "     - \"--unbuffered\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11.379036, "o", "     - \"--argjson min_count 5\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[11.379056, "o", ">      - \"--tab\"\r\n\u001b[?2004l\r"]
[11.379079, "o", "\u001b[?2004h>    ```\r\n\u001b[?2004l\r\u001b[?2004h"]
[11.379099, "o", ">    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[11.379184, "o", "   '\"'\"'/app/jq_args.yaml'\"'\"' will be used to construct and execute a single jq command as follows:\r\n\u001b[?2004l\r\u001b[?2004h"]
[11.379207, "o", "> "]
[11.379333, "o", "   `jq $(yq -r '\"'\"'.args[]'\"'\"' /app/jq_args.yaml) \"$(yq -r '\"'\"'.filter'\"'\"' /app/jq_args.yaml)\" /app/users.json > /app/active_users_report.json`\r\n\u001b[?2004l\r\u001b[?2004h>    \r\n\u001b[?2004l\r"]
[11.379355, "o", "\u001b[?2004h> "]
