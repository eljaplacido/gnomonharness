[11.382224, "o", "\u001b[?2004h>   },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11.382248, "o", "  ...\r\n\u001b[?2004l\r\u001b[?2004h> ]\r\n\u001b[?2004l\r"]
[11.382268, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[11.382286, "o", "> "]
[11.382305, "o", "**Requirements**:\r\n\u001b[?2004l\r\u001b[?2004h> "]
