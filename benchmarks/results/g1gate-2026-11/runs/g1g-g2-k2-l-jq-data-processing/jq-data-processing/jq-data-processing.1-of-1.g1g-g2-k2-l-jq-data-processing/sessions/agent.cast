[11.380652, "o", "   - The filter should be a single string containing the complete jq filter expression\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[11.380679, "o", "\u001b[?2004h> "]
[11.3809, "o", "**Note on examples below**: In the following Data Schema sections, all content following the '\"'\"'#'\"'\"' symbol is just explanatory commentary and will NOT appear in the actual JSON files. These comments are only provided to clarify the structure and requirements.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[11.380915, "o", "\u001b[?2004h> "]
[11.38099, "o", "**Input Data Schema**:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11.381027, "o", "The input JSON file '\"'\"'/app/users.json'\"'\"' is an array of user objects with the following structure:\r\n\u001b[?2004l\r\u001b[?2004h"]
[11.381056, "o", "> [\r\n\u001b[?2004l\r"]
[11.381082, "o", "\u001b[?2004h>   {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11.381127, "o", "    \"id\": 1,                  # Unique numeric identifier for the user\r\n\u001b[?2004l\r\u001b[?2004h"]
[11.381165, "o", "> "]
[11.381196, "o", "    \"username\": \"john_doe\",   # User'\"'\"'s unique username (string)\r\n\u001b[?2004l\r\u001b[?2004h"]
[11.381219, "o", "> "]
[11.381269, "o", "    \"email\": \"john@example.com\",  # User'\"'\"'s email address (string)\r\n\u001b[?2004l\r\u001b[?2004h"]
[11.381294, "o", "> "]
[11.381349, "o", "    \"status\": \"active\",       # User status: '\"'\"'active'\"'\"' or '\"'\"'inactive'\"'\"'\r\n\u001b[?2004l\r\u001b[?2004h"]
[11.381373, "o", "> "]
[11.38144, "o", "    \"last_login\": \"2024-10-02T20:59:10.109812Z\",  # ISO 8601 timestamp (UTC) of the last login\r\n\u001b[?2004l\r"]
[11.381464, "o", "\u001b[?2004h> "]
[11.381526, "o", "    \"roles\": [\"admin\", \"editor\"]  # Array of roles assigned to the user (may be empty)\r\n\u001b[?2004l\r\u001b[?2004h"]
[11.381549, "o", ">   },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11.381578, "o", "  ...\r\n\u001b[?2004l\r\u001b[?2004h> ]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[11.381607, "o", "\u001b[?2004h> "]
[11.381629, "o", "**Output Data Schema**:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[11.381728, "o", "The output JSON file '\"'\"'/app/active_users_report.json'\"'\"' must be an array of objects with the following structure:\r\n\u001b[?2004l\r\u001b[?2004h"]
[11.381752, "o", "> [\r\n\u001b[?2004l\r\u001b[?2004h>   {\r\n\u001b[?2004l\r"]
[11.38178, "o", "\u001b[?2004h> "]
