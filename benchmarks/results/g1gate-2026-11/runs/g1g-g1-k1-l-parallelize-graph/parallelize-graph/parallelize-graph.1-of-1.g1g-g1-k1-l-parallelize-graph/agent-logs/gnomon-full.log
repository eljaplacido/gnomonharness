cat > /app/serial.c << 'SERIAL_EOF'
/*
 * Serial de Bruijn graph construction and traversal for genome assembly.
 *
 * Input:  KMER<TAB>LEFT_RIGHT  (one per line)
 *         KMER is a DNA string (A/C/G/T), LEFT_RIGHT is two chars from {A,C,G,T,F}
 *         F means no extension in that direction.
 *
 * Output: Contigs written to /app/serial.out, one per line.
 *
 * Algorithm:
 *   1. Build a hash table of k-mers -> left/right extensions.
 *   2. Find all "start" k-mers: those with no left extension (left == 'F').
 *   3. For each start k-mer, walk forward following right extensions until
 *      we hit a k-mer with right == 'F' or a k-mer already visited.
 *   4. Output the assembled contig (full k-mer of start + one char per step).
 */

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>

#define KMER_LEN 19
#define EXT_LEN 2
#define HASH_SIZE 131071  /* prime, power-of-2 minus 1 for masking */
#define MAX_KMERS 100000

/* Each k-mer node */
typedef struct KmerNode {
    char kmer[KMER_LEN + 1];       /* the k-mer string */
    char left_ext;                 /* left extension char (A/C/G/T/F) */
    char right_ext;                /* right extension char (A/C/G/T/F) */
    int visited;                   /* 1 if this k-mer has been traversed */
    struct KmerNode *next;         /* next in chain (separate chaining) */
} KmerNode;

static KmerNode *hash_table[HASH_SIZE];
static int num_kmers = 0;

/* Simple hash function for k-mer strings */
static uint32_t hash_kmer(const char *kmer) {
    uint32_t h = 5381;
    int i;
    for (i = 0; kmer[i]; i++) {
        h = ((h << 5) + h) + (unsigned char)kmer[i];
    }
    return h;
}

/* Find or insert a k-mer in the hash table */
static KmerNode *find_or_insert(const char *kmer, char left, char right) {
    uint32_t idx = hash_kmer(kmer) & HASH_SIZE;
    KmerNode *node = hash_table[idx];

    while (node) {
        if (strcmp(node->kmer, kmer) == 0) {
            return node;
        }
        node = node->next;
    }

    /* Not found, insert */
    node = (KmerNode *)malloc(sizeof(KmerNode));
    strncpy(node->kmer, kmer, KMER_LEN);
    node->kmer[KMER_LEN] = '\0';
    node->left_ext = left;
    node->right_ext = right;
    node->visited = 0;
    node->next = hash_table[idx];
    hash_table[idx] = node;
    num_kmers++;
    return node;
}

/* Find a k-mer in the hash table */
static KmerNode *find_kmer(const char *kmer) {
    uint32_t idx = hash_kmer(kmer) & HASH_SIZE;
    KmerNode *node = hash_table[idx];

    while (node) {
        if (strcmp(node->kmer, kmer) == 0) {
            return node;
        }
        node = node->next;
    }
    return NULL;
}

/* Check if a character is a valid DNA base */
static int is_dna(char c) {
    return (c == 'A' || c == 'C' || c == 'G' || c == 'T');
}

int main(int argc, char *argv[]) {
    FILE *fin, *fout;
    char line[256];
    char kmer[KMER_LEN + 1];
    char ext[EXT_LEN + 1];
    char contig[MAX_KMERS + KMER_LEN + 1];
    int contig_len;
    KmerNode *node, *start_node;
    char next_kmer[KMER_LEN + 1];
    int i;

    if (argc < 2) {
        fprintf(stderr, "Usage: %s <input_file>\n", argv[0]);
        return 1;
    }

    /* Initialize hash table */
    memset(hash_table, 0, sizeof(hash_table));

    /* Read input and build hash table */
    fin = fopen(argv[1], "r");
    if (!fin) {
        fprintf(stderr, "Cannot open input file: %s\n", argv[1]);
        return 1;
    }

    while (fgets(line, sizeof(line), fin)) {
        /* Remove trailing newline */
        line[strcspn(line, "\n")] = '\0';

        /* Parse k-mer and extensions */
        if (sscanf(line, "%19s %2s", kmer, ext) != 2) {
            continue;
        }

        if (strlen(kmer) != KMER_LEN) {
            continue;
        }

        /* Validate extensions */
        if (!is_dna(ext[0]) && ext[0] != 'F') {
            continue;
        }
        if (!is_dna(ext[1]) && ext[1] != 'F') {
            continue;
        }

        find_or_insert(kmer, ext[0], ext[1]);
    }
    fclose(fin);

    /* Open output file */
    fout = fopen("/app/serial.out", "w");
    if (!fout) {
        fprintf(stderr, "Cannot open output file: /app/serial.out\n");
        return 1;
    }

    /* Find all start k-mers (left extension == 'F') and traverse */
    for (i = 0; i < HASH_SIZE; i++) {
        node = hash_table[i];
        while (node) {
            if (node->left_ext == 'F' && !node->visited) {
                /* Start a new contig */
                start_node = node;
                node->visited = 1;

                /* Build contig: start with full k-mer */
                contig_len = KMER_LEN;
                strncpy(contig, start_node->kmer, KMER_LEN);
                contig[contig_len] = '\0';

                /* Walk forward following right extensions */
                while (start_node->right_ext != 'F') {
                    /* Build next k-mer: drop first char, append extension */
                    strncpy(next_kmer, start_node->kmer + 1, KMER_LEN - 1);
                    next_kmer[KMER_LEN - 1] = start_node->right_ext;
                    next_kmer[KMER_LEN] = '\0';

                    /* Find next k-mer in hash table */
                    KmerNode *next_node = find_kmer(next_kmer);
                    if (!next_node) {
                        break;  /* No extension found */
                    }

                    if (next_node->visited) {
                        break;  /* Already visited, stop */
                    }

                    next_node->visited = 1;
                    contig[contig_len++] = start_node->right_ext;
                    contig[contig_len] = '\0';
                    start_node = next_node;
                }

                /* Output contig */
                fprintf(fout, "%s\n", contig);
            }
            node = node->next;
        }
    }

    fclose(fout);

    /* Free hash table */
    for (i = 0; i < HASH_SIZE; i++) {
        node = hash_table[i];
        while (node) {
            KmerNode *tmp = node;
            node = node->next;
            free(tmp);
        }
    }

    return 0;
}
SERIAL_EOF
echo "serial.c written"
