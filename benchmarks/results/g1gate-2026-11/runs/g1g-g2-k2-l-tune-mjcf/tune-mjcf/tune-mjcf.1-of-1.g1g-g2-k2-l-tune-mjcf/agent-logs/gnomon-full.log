    xml2 = re.sub(r'key=\"vmax\" value=\"[^\"]*\"', 'key=\"vmax\" value=\"' + str(vmax) + '\"', xml)
    m = mujoco.MjModel.from_xml_string(xml2, None)
    d = mujoco.MjData(m)
    mujoco.mj_forward(m, d)
    
    nstep = int(2.0 / m.opt.timestep)
    start = time.perf_counter()
    for _ in range(nstep):
        mujoco.mj_step(m, d)
    elapsed = time.perf_counter() - start
    
    print(f'vmax={vmax}: {elapsed:.4f}s ({elapsed/nstep*1000:.4f}ms/step)')
