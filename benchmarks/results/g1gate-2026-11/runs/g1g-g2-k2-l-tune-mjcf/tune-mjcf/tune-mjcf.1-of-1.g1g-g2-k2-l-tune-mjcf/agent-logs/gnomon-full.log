import mujoco
import numpy as np

# Test with larger timestep
m = mujoco.MjModel.from_xml_path('model_ref.xml')
m.opt.timestep = 0.004  # double

d = mujoco.MjData(m)
seed = 42
rng = np.random.default_rng(seed)
d.qpos += rng.normal(0, 0.01, size=d.qpos.shape)
mujoco.mj_forward(m, d)

nstep = int(2.0 / m.opt.timestep)
for _ in range(nstep):
    mujoco.mj_step(m, d)

full_physics = mujoco.mjtState.mjSTATE_FULLPHYSICS
state = np.zeros(mujoco.mj_stateSize(m, full_physics))
mujoco.mj_getState(m, d, state, full_physics)

# Compare with reference
m_ref = mujoco.MjModel.from_xml_path('model_ref.xml')
d_ref = mujoco.MjData(m_ref)
d_ref.qpos += rng.normal(0, 0.01, size=d_ref.qpos.shape)
mujoco.mj_forward(m_ref, d_ref)
nstep_ref = int(2.0 / m_ref.opt.timestep)
for _ in range(nstep_ref):
    mujoco.mj_step(m_ref, d_ref)

state_ref = np.zeros(mujoco.mj_stateSize(m_ref, full_physics))
mujoco.mj_getState(m_ref, d_ref, state_ref, full_physics)

diff = np.linalg.norm(state - state_ref)
print(f'timestep=0.004, diff={diff:.6f}')
print(f'atol check: {np.allclose(state, state_ref, atol=1e-5)}')
