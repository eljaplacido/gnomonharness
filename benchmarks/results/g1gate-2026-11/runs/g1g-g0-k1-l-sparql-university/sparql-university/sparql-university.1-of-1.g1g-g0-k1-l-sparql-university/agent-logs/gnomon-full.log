    dept = g.value(course, uni.isTaughtIn)
    dept_str = str(dept).split("/")[-1]
    active_students = []
    for student, enroll_date in g.objects(subject=None, predicate=uni.isEnrolledIn):
        if g.value(student, uni.isEnrolledIn) == course:
            ed = g.value(student, uni.hasEnrollmentDate)
            if ed and ed.toPython() <= ref_date:
