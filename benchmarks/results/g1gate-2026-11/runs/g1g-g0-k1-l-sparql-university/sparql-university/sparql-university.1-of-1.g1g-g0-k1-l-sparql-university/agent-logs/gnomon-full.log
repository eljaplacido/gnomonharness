print("=== ALL PERSONS WITH ROLE 'Professor' ===")
for s, p, o in g.triples((None, uni.role, None)):
    if "Professor" in str(o):
        name = g.value(s, uni.hasName)
        works = list(g.objects(s, uni.worksIn))
        teaches = list(g.objects(s, uni.teaches))
        is_prof = "Assistant" not in str(o)
        print(f"  {name} | role: {o} | full_prof: {is_prof} | worksIn: {[str(w) for w in works]} | teaches: {[str(t) for t in teaches]}")

