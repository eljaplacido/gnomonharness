# Check if the LoRA weights were actually merged into the model
# The LoRA adapter modifies classifier weights. If merged correctly,
# the classifier weights should differ from the base model.
# Let's check by loading the LoRA adapter and comparing.

from peft import PeftModel
from transformers import AutoModelForSequenceClassification
import torch

# Load base model fresh (20 classes)
