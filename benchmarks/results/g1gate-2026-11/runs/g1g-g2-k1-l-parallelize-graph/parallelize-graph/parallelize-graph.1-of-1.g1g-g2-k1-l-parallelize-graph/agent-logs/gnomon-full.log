#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <omp.h>

#define MAX_KMER_LEN 256
#define HASH_SIZE 65536
#define MAX_CONTIG_LEN (MAX_KMER_LEN * 100)
#define MAX_CONTIGS_PER_THREAD 100
#define MAX_THREADS 1024

typedef struct KmerNode {
    char kmer[MAX_KMER_LEN];
    char left_ext;
    char right_ext;
} KmerNode;

KmerNode *hash_table;
int *start_nodes;
int start_count;
int *thread_contig_counts;
char *thread_contigs;

static unsigned int hash_kmer(const char *kmer) {
    unsigned int h = 5381;
    int c;
    while ((c = *kmer++) != '\0') {
        h = ((h << 5) + h) + c;
    }
    return h % HASH_SIZE;
}

static int find_kmer(const char *kmer) {
    unsigned int idx = hash_kmer(kmer);
    int i = idx;
    do {
        if (hash_table[i].kmer[0] == '\0') return -1;
        if (strcmp(hash_table[i].kmer, kmer) == 0) return i;
        i = (i + 1) % HASH_SIZE;
    } while (i != idx);
    return -1;
}

static int insert_kmer(const char *kmer, char left_ext, char right_ext) {
    unsigned int idx = hash_kmer(kmer);
    int i = idx;
    do {
        if (hash_table[i].kmer[0] == '\0') {
            strncpy(hash_table[i].kmer, kmer, MAX_KMER_LEN - 1);
            hash_table[i].kmer[MAX_KMER_LEN - 1] = '\0';
            hash_table[i].left_ext = left_ext;
            hash_table[i].right_ext = right_ext;
            return i;
        }
        if (strcmp(hash_table[i].kmer, kmer) == 0) return i;
        i = (i + 1) % HASH_SIZE;
    } while (i != idx);
    return -1;
}

static inline char *get_contig(int tid, int ci) {
    return thread_contigs + tid * MAX_CONTIGS_PER_THREAD * MAX_CONTIG_LEN + ci * MAX_CONTIG_LEN;
}

int main(int argc, char *argv[]) {
    if (argc < 2) { fprintf(stderr, "Usage: %s <input_file>\n", argv[0]); return 1; }
    const char *input_file = argv[1];
    int my_thread_id = 0;
    int my_thread_count = 1;

    hash_table = (KmerNode *)calloc(HASH_SIZE, sizeof(KmerNode));
    start_nodes = (int *)calloc(HASH_SIZE, sizeof(int));
    thread_contig_counts = (int *)calloc(MAX_THREADS, sizeof(int));
    thread_contigs = (char *)calloc((size_t)MAX_THREADS * (size_t)MAX_CONTIGS_PER_THREAD * (size_t)MAX_CONTIG_LEN, sizeof(char));

    for (int i = 0; i < HASH_SIZE; i++) hash_table[i].kmer[0] = '\0';

    FILE *fin = fopen(input_file, "r");
    if (!fin) { fprintf(stderr, "Cannot open %s\n", input_file); return 1; }
    char line[MAX_KMER_LEN + 32];
    while (fgets(line, sizeof(line), fin)) {
        size_t len = strlen(line);
        while (len > 0 && (line[len-1] == '\n' || line[len-1] == '\r')) line[--len] = '\0';
        char *tab = strchr(line, '\t');
        if (!tab) continue;
        *tab = '\0';
        char *ext = tab + 1;
        if (strlen(ext) < 2) continue;
        insert_kmer(line, ext[0], ext[1]);
    }
    fclose(fin);

    int local_start_count = 0;
    int local_starts[HASH_SIZE];
    for (int i = 0; i < HASH_SIZE; i++) {
        if (hash_table[i].kmer[0] != '\0' && hash_table[i].left_ext == 'F') {
            local_starts[local_start_count++] = i;
        }
    }

    for (int i = 0; i < local_start_count - 1; i++) {
        for (int j = i + 1; j < local_start_count; j++) {
            if (strcmp(hash_table[local_starts[i]].kmer, hash_table[local_starts[j]].kmer) > 0) {
                int tmp = local_starts[i];
                local_starts[i] = local_starts[j];
                local_starts[j] = tmp;
            }
        }
    }

    #pragma omp parallel num_threads(20)
    {
        my_thread_id = omp_get_thread_num();
        my_thread_count = omp_get_num_threads();

        for (int i = 0; i < local_start_count; i++) {
            if (i % my_thread_count == my_thread_id) {
                int idx = local_starts[i];
                char contig[MAX_CONTIG_LEN];
                strncpy(contig, hash_table[idx].kmer, MAX_CONTIG_LEN - 1);
                contig[MAX_CONTIG_LEN - 1] = '\0';

                int current = idx;
                while (1) {
                    char right = hash_table[current].right_ext;
                    if (right == 'F') break;
                    char next_kmer[MAX_KMER_LEN];
                    int klen = strlen(hash_table[current].kmer);
                    strncpy(next_kmer, hash_table[current].kmer + 1, klen - 1);
                    next_kmer[klen - 1] = right;
                    next_kmer[klen] = '\0';
                    int next_idx = find_kmer(next_kmer);
                    if (next_idx < 0) break;
                    strcat(contig, &right);
                    current = next_idx;
                }

                int my_count = thread_contig_counts[my_thread_id];
                strncpy(get_contig(my_thread_id, my_count), contig, MAX_CONTIG_LEN - 1);
                get_contig(my_thread_id, my_count)[MAX_CONTIG_LEN - 1] = '\0';
                thread_contig_counts[my_thread_id] = my_count + 1;
            }
        }
    }

    printf("Parallel: thread %d/%d, counts: ", my_thread_id, my_thread_count);
    for (int t = 0; t < my_thread_count; t++) printf("%d ", thread_contig_counts[t]);
    printf("\n");

    free(thread_contigs);
    free(thread_contig_counts);
    free(start_nodes);
    free(hash_table);
    return 0;
}
