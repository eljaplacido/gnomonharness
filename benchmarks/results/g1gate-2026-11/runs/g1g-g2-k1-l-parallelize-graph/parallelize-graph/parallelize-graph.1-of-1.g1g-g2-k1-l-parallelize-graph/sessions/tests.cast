[6.246032, "o", "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mtest_parallel_output_exists\u001b[39;49;00m():\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"Check that parallel version produced output files starting with pgen.\u001b[39;49;00m\r\n    \u001b[33m\u001b[39;49;00m\r\n    \u001b[33m    Output files should end with .out (e.g., pgen_0.out, pgen_1.out).\u001b[39;49;00m\r\n    \u001b[33m    \"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        \u001b[90m# Check for individual pgen_*.out files\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        pgen_files = \u001b[96mlist\u001b[39;49;00m(Path(\u001b[33m\"\u001b[39;49;00m\u001b[33m/app\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m).glob(\u001b[33m\"\u001b[39;49;00m\u001b[33mpgen*.out\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m))\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n>       \u001b[94massert\u001b[39;49;00m \u001b[96mlen\u001b[39;49;00m(pgen_files) > \u001b[94m0\u001b[39;49;00m, (\u001b[90m\u001b[39;49;00m\r\n            \u001b[33m\"\u001b[39;49;00m\u001b[33mNo parallel output files found matching pattern pgen*.out\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        )\u001b[90m\u001b[39;49;00m\r\n"]
[6.246058, "o", "\u001b[1m\u001b[31mE       AssertionError: No parallel output files found matching pattern pgen*.out\u001b[0m\r\n\u001b[1m\u001b[31mE       assert 0 > 0\u001b[0m\r\n\u001b[1m\u001b[31mE        +  where 0 = len([])\u001b[0m\r\n\r\n\u001b[1m\u001b[31m/tests/test_outputs.py\u001b[0m:53: AssertionError\r\n"]
[6.246078, "o", "\u001b[31m\u001b[1m______________________________________________________________ test_outputs_contain_dna_sequences ______________________________________________________________\u001b[0m\r\n\r\n"]
[6.24673, "o", "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mtest_outputs_contain_dna_sequences\u001b[39;49;00m():\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"Check that output files contain valid DNA contigs.\u001b[39;49;00m\r\n    \u001b[33m\u001b[39;49;00m\r\n    \u001b[33m    Contigs should only contain A, C, G, T characters.\u001b[39;49;00m\r\n    \u001b[33m    \"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        serial_out = Path(\u001b[33m\"\u001b[39;49;00m\u001b[33m/app/serial.out\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[90m# Test serial output\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        \u001b[94mif\u001b[39;49;00m serial_out.exists():\u001b[90m\u001b[39;49;00m\r\n            content = serial_out.read_text()\u001b[90m\u001b[39;49;00m\r\n            lines = content.strip().split(\u001b[33m\"\u001b[39;49;00m\u001b[33m\\n\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n            \u001b[94massert\u001b[39;49;00m \u001b[96mlen\u001b[39;49;00m(lines) > \u001b[94m0\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33mSerial output contains no contigs\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n            \u001b[94mfor\u001b[39;49;00m i, line \u001b[95min\u001b[39;49;00m \u001b[96menumerate\u001b[39;49;00m(lines):\u001b[90m\u001b[39;49;00m\r\n                \u001b[94mif\u001b[39;49;00m line.strip():  \u001b[90m# Skip empty lines\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n                    \u001b[90m# Each line should be a DNA sequence (only A, C, G, T)\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n>                   \u001b[94massert\u001b[39;49;00m \u001b[96mall\u001b[39;49;00m(c \u001b[95min\u001b[39;49;00m \u001b[33m\"\u001b[39;49;00m\u001b[33mACGT\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m \u001b[94mfor\u001b[39;49;00m c \u001b[95min\u001b[39;49;00m line.strip()), (\u001b[90m\u001b[39;49;00m\r\n                        \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mInvalid DNA sequence in serial.out line \u001b[39;49;00m\u001b[33m{\u001b[39;49;00mi\u001b[90m \u001b[39;49;00m+\u001b[90m \u001b[39;49;00m\u001b[94m1\u001b[39;49;00m\u001b[33m}\u001b[39;49;00m\u001b[33m: \u001b[39;49;00m\u001b[33m{\u001b[39;49;00mline\u001b[33m}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n                    )\u001b[90m\u001b[39;49;00m\r\n\u001b[1m\u001b[31mE                   AssertionError: Invalid DNA sequence in serial.out line 1: "]
