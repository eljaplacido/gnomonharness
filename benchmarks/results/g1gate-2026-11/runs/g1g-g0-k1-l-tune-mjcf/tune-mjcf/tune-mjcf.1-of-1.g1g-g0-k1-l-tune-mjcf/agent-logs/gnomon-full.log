import mujoco
import numpy as np
import time

# Get reference state
m_ref = mujoco.MjModel.from_xml_path('model_ref.xml')
data_ref = mujoco.MjData(m_ref)
nstep_ref = int(2.0 / m_ref.opt.timestep)
rng = np.random.default_rng(42)
data_ref.qpos += rng.normal(0, 0.01, size=data_ref.qpos.shape)
mujoco.mj_forward(m_ref, data_ref)
for _ in range(nstep_ref):
    mujoco.mj_step(m_ref, data_ref)
full_physics = mujoco.mjtState.mjSTATE_FULLPHYSICS
state_ref = np.zeros(mujoco.mj_stateSize(m_ref, full_physics))
mujoco.mj_getState(m_ref, data_ref, state_ref, full_physics)

print('Reference state norm:', np.linalg.norm(state_ref))

# Test with different timesteps
for ts in [0.002, 0.004, 0.005, 0.006, 0.008, 0.01, 0.012, 0.015, 0.02]:
    xml = open('model_ref.xml').read()
    xml = xml.replace('<statistic', f'<option timestep=\"{ts}\"/><statistic')
    m = mujoco.MjModel.from_xml_string(xml)
    data = mujoco.MjData(m)
    nstep = int(2.0 / m.opt.timestep)
    rng2 = np.random.default_rng(42)
    data.qpos += rng2.normal(0, 0.01, size=data.qpos.shape)
    mujoco.mj_forward(m, data)
    
    t0 = time.perf_counter()
    for _ in range(nstep):
        mujoco.mj_step(m, data)
    t1 = time.perf_counter()
    
    state = np.zeros(mujoco.mj_stateSize(m, full_physics))
    mujoco.mj_getState(m, data, state, full_physics)
    
    diff = np.linalg.norm(state - state_ref)
    print(f'ts={ts}, steps={nstep}, time={t1-t0:.4f}s, diff={diff:.6f}, has_nan={np.isnan(state).any()}')
