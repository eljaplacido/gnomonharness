import json, os, torch
from transformers import AutoModelForSequenceClassification, AutoTokenizer

print('=== VERIFICATION ===')
errors = []

# 1. Check paths exist
paths = {
    '/app/model_cache/xlm-roberta-base': 'base model cache',
    '/app/merged_model/': 'merged model',
    '/app/detection_results.json': 'detection results',
}
for p, desc in paths.items():
    exists = os.path.exists(p)
    print(f'Path {desc}: {p} -> {\"OK\" if exists else \"MISSING\"} ')
    if not exists:
        errors.append(f'Missing: {p}')

# 2. Check base model has 20 classes
m = AutoModelForSequenceClassification.from_pretrained('/app/model_cache/xlm-roberta-base')
print(f'Base model num_labels: {m.config.num_labels}')
if m.config.num_labels != 20:
    errors.append(f'Base model num_labels is {m.config.num_labels}, expected 20')

# 3. Check merged model has 20 classes
m2 = AutoModelForSequenceClassification.from_pretrained('/app/merged_model/')
print(f'Merged model num_labels: {m2.config.num_labels}')
if m2.config.num_labels != 20:
    errors.append(f'Merged model num_labels is {m2.config.num_labels}, expected 20')

# 4. Check detection_results.json format
with open('/app/detection_results.json') as f:
    results = json.load(f)
print(f'Results count: {len(results)}')
if len(results) != 10:
    errors.append(f'Expected 10 results, got {len(results)}')

# Check each result has required fields
for i, r in enumerate(results):
    for key in ['text', 'predicted_class_id', 'confidence']:
        if key not in r:
            errors.append(f'Result {i} missing key: {key}')
    if not isinstance(r.get('predicted_class_id'), int):
        errors.append(f'Result {i} predicted_class_id is not int')
    if not isinstance(r.get('confidence'), (int, float)):
        errors.append(f'Result {i} confidence is not number')

# 5. Re-run detection on merged model to verify
t = AutoTokenizer.from_pretrained('/app/merged_model/')
test_samples = [
    'Bonjour, comment allez-vous aujourd'hui?',
    'Hola, ¿cómo estás hoy?',
    'Guten Tag, wie geht es Ihnen?',
    'Ciao, come stai oggi?',
    'Olá, como você está?',
    'Привет, как дела?',
    'こんにちは、お元気ですか？',
    '你好，你好吗？',
    'مرحبا، كيف حالك؟',
    'Hello, how are you?',
]

print()
print('=== RE-RUNNING DETECTION ON MERGED MODEL ===')
m2.eval()
with torch.no_grad():
    for text in test_samples:
        inputs = t(text, return_tensors='pt', truncation=True, max_length=512)
        outputs = m2(**inputs)
        probs = torch.softmax(outputs.logits, dim=-1)
        conf, pred = torch.max(probs, dim=-1)
        print(f'  \"{text[:40]}\" -> class={pred.item()} conf={conf.item():.4f}')

# 6. Check tokenizer exists in both dirs
for d in ['/app/model_cache/xlm-roberta-base', '/app/merged_model/']:
    tok = AutoTokenizer.from_pretrained(d)
    print(f'Tokenizer from {d}: OK')

print()
if errors:
    print(f'ERRORS: {errors}')
else:
    print('ALL CHECKS PASSED')
