[47.368518, "o", "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mtest_join_announce_leave_flow\u001b[39;49;00m():\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"Full flow of user joining, announcing, and leaving the mailing list.\"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        subject = \u001b[33m\"\u001b[39;49;00m\u001b[33mSecret Announcement\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        user = \u001b[33m\"\u001b[39;49;00m\u001b[33malicegray\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        add_user(user)\u001b[90m\u001b[39;49;00m\r\n        mbox_path = \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m/var/mail/\u001b[39;49;00m\u001b[33m{\u001b[39;49;00muser\u001b[33m}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92m_assert_mailbox_exists\u001b[39;49;00m():\u001b[90m\u001b[39;49;00m\r\n            \u001b[94massert\u001b[39;49;00m os.path.exists(mbox_path), \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mMailbox not found: \u001b[39;49;00m\u001b[33m{\u001b[39;49;00mmbox_path\u001b[33m}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92m_assert_not_member\u001b[39;49;00m():\u001b[90m\u001b[39;49;00m\r\n            mlist = get_mlist()\u001b[90m\u001b[39;49;00m\r\n            user_member = mlist.members.get_member(\u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m{\u001b[39;49;00muser\u001b[33m}\u001b[39;49;00m\u001b[33m@\u001b[39;49;00m\u001b[33m{\u001b[39;49;00mDOMAIN_NAME\u001b[33m}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n            \u001b[94massert\u001b[39;49;00m user_member \u001b[95mis\u001b[39;49;00m \u001b[94mNone\u001b[39;49;00m, \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m{\u001b[39;49;00muser\u001b[33m}\u001b[39;49;00m\u001b[33m is a member: \u001b[39;49;00m\u001b[33m{\u001b[39;49;00muser_member\u001b[33m=}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92m_assert_member\u001b[39;49;00m():\u001b[90m\u001b[39;49;00m\r\n            mlist = get_mlist()\u001b[90m\u001b[39;49;00m\r\n            user_member = mlist.members.get_member(\u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m{\u001b[39;49;00muser\u001b[33m}\u001b[39;49;00m\u001b[33m@\u001b[39;49;00m\u001b[33m{\u001b[39;49;00mDOMAIN_NAME\u001b[33m}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n            \u001b[94massert\u001b[39;49;00m user_member, \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m{\u001b[39;49;00muser\u001b[33m}\u001b[39;49;00m\u001b[33m is not a member: \u001b[39;49;00m\u001b[33m{\u001b[39;49;00muser_member\u001b[33m=}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92m_assert_announcement\u001b[39;49;00m():\u001b[90m\u001b[39;49;00m\r\n            mbox = mailbox.mbox(mbox_path)\u001b[90m\u001b[39;49;00m\r\n            announce_msgs = [msg \u001b[94mfor\u001b[39;49;00m msg \u001b[95min\u001b[39;49;00m mbox \u001b[94mif\u001b[39;49;00m subject \u001b[95min\u001b[39;49;00m msg.get(\u001b[33m\"\u001b[39;49;00m\u001b[33mSubject\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)]\u001b[90m\u001b[39;49;00m\r\n            \u001b[94massert\u001b[39;49;00m \u001b[96mlen\u001b[39;49;00m(announce_msgs) == \u001b[94m1\u001b[39;49;00m, (\u001b[90m\u001b[39;49;00m\r\n                \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mExpected 1 announcement, found \u001b[39;49;00m\u001b[33m{\u001b[39;49;00m\u001b[96mlen\u001b[39;49;00m(announce_msgs)\u001b[33m}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n            )\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        send_email(\u001b[90m\u001b[39;49;00m\r\n            body=\u001b[33m\"\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\r\n            subject=\u001b[33m\"\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\r\n            from_addr=\u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m{\u001b[39;49;00muser\u001b[33m}\u001b[39;49;00m\u001b[33m@\u001b[39;49;00m\u001b[33m{\u001b[39;49;00mDOMAIN_NAME\u001b[33m}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\r\n            to_addr=JOIN_LIST,\u001b[90m\u001b[39;49;00m\r\n        )\u001b[90m\u001b[39;49;00m\r\n        \u001b[96mprint\u001b[39;49;00m(\u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m{\u001b[39;49;00muser\u001b[33m}\u001b[39;49;00m\u001b[33m sends a join request\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n        retry(_assert_not_member)\u001b[90m\u001b[39;49;00m\r\n        \u001b[96mprint\u001b[39;49;00m(\u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m{\u001b[39;49;00muser\u001b[33m}\u001b[39;49;00m\u001b[33m has not yet confirmed their subscription\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        retry(_assert_mailbox_exists)\u001b[90m\u001b[39;49;00m\r\n        retry(bind(confirm_last_reply, user, \u001b[33m\"\u001b[39;49;00m\u001b[33mjoin\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m))\u001b[90m\u001b[39;49;00m\r\n        retry(_assert_member)\u001b[90m\u001b[39;49;00m\r\n        \u001b[96mprint\u001b[39;49;00m(\u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m{\u001b[39;49;00muser\u001b[33m}\u001b[39;49;00m\u001b[33m has confirmed their subscription\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        send_email(\u001b[90m\u001b[39;49;00m\r\n            body=\u001b[33m\"\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\r\n            subject=subject,\u001b[90m\u001b[39;49;00m\r\n            from_addr=\u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m{\u001b[39;49;00muser\u001b[33m}\u001b[39;49;00m\u001b[33m@\u001b[39;49;00m\u001b[33m{\u001b[39;49;00mDOMAIN_NAME\u001b[33m}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\r\n            to_addr=MAILING_LIST,\u001b[90m\u001b[39;49;00m\r\n        )\u001b[90m\u001b[39;49;00m\r\n        \u001b[96mprint\u001b[39;49;00m(\u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m{\u001b[39;49;00muser\u001b[33m}\u001b[39;49;00m\u001b[33m sends an announcement\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n        \u001b[90m# broadcasting takes a bit longer\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        retry(_assert_announcement, backoff=\u001b[94m3\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n        \u001b[96mprint\u001b[39;49;00m(\u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m{\u001b[39;49;00muser\u001b[33m}\u001b[39;49;00m\u001b[33m announcement has received its own announcement\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        send_email(\u001b[90m\u001b[39;49;00m\r\n            body=\u001b[33m\"\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\r\n            subject=\u001b[33m\"\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\r\n            from_addr=\u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m{\u001b[39;49;00muser\u001b[33m}\u001b[39;49;00m\u001b[33m@\u001b[39;49;00m\u001b[33m{\u001b[39;49;00mDOMAIN_NAME\u001b[33m}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\r\n            to_addr=LEAVE_LIST,\u001b[90m\u001b[39;49;00m\r\n        )\u001b[90m\u001b[39;49;00m\r\n        \u001b[96mprint\u001b[39;49;00m(\u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m{\u001b[39;49;00muser\u001b[33m}\u001b[39;49;00m\u001b[33m decides to leave now\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n        retry(_assert_member)\u001b[90m\u001b[39;49;00m\r\n        \u001b[96mprint\u001b[39;49;00m(\u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m{\u001b[39;49;00muser\u001b[33m}\u001b[39;49;00m\u001b[33m is still a member of the list (pending confirmation)\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n>       retry(bind(confirm_last_reply, user, \u001b[33m\"\u001b[39;49;00m\u001b[33mleave\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m))\u001b[90m\u001b[39;49;00m\r\n\r\n\u001b[1m\u001b[31m/tests/test_outputs.py\u001b[0m:233: \r\n_ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ \r\n"]
[47.368633, "o", "\u001b[1m\u001b[31m/tests/test_outputs.py\u001b[0m:52: in retry\r\n    \u001b[0m\u001b[94mraise\u001b[39;49;00m e\u001b[90m\u001b[39;49;00m\r\n\u001b[1m\u001b[31m/tests/test_outputs.py\u001b[0m:48: in retry\r\n    \u001b[0m\u001b[94mreturn\u001b[39;49;00m func()\u001b[90m\u001b[39;49;00m\r\n           ^^^^^^\u001b[90m\u001b[39;49;00m\r\n_ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ \r\n\r\nuser = 'alicegray', subject_contains = 'leave'\r\n\r\n"]
[47.369226, "o", "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mconfirm_last_reply\u001b[39;49;00m(user, subject_contains=\u001b[33m\"\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m):\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"Mock user confirmation behavior when they join or leave\u001b[39;49;00m\r\n    \u001b[33m    the mailing list.\"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        mbox_path = \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m/var/mail/\u001b[39;49;00m\u001b[33m{\u001b[39;49;00muser\u001b[33m}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        mbox = mailbox.mbox(mbox_path)\u001b[90m\u001b[39;49;00m\r\n        \u001b[96mprint\u001b[39;49;00m(\u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m{\u001b[39;49;00muser\u001b[33m}\u001b[39;49;00m\u001b[33m has \u001b[39;49;00m\u001b[33m{\u001b[39;49;00m\u001b[96mlen\u001b[39;49;00m(mbox)\u001b[33m}\u001b[39;49;00m\u001b[33m messages in their inbox\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n        \u001b[96mprint\u001b[39;49;00m(\u001b[33m\"\u001b[39;49;00m\u001b[33mthe subjects are as follows:\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n        \u001b[96mprint\u001b[39;49;00m([msg.get(\u001b[33m\"\u001b[39;49;00m\u001b[33mSubject\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m) \u001b[94mfor\u001b[39;49;00m msg \u001b[95min\u001b[39;49;00m mbox])\u001b[90m\u001b[39;49;00m\r\n        candidate_msgs = [\u001b[90m\u001b[39;49;00m\r\n            msg\u001b[90m\u001b[39;49;00m\r\n            \u001b[94mfor\u001b[39;49;00m msg \u001b[95min\u001b[39;49;00m mbox\u001b[90m\u001b[39;49;00m\r\n            \u001b[94mif\u001b[39;49;00m msg.get(\u001b[33m\"\u001b[39;49;00m\u001b[33mFrom\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m).startswith(\u001b[33m\"\u001b[39;49;00m\u001b[33mreading-group-confirm\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n            \u001b[95mand\u001b[39;49;00m subject_contains \u001b[95min\u001b[39;49;00m msg.get(\u001b[33m\"\u001b[39;49;00m\u001b[33mSubject\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n        ]\u001b[90m\u001b[39;49;00m\r\n        \u001b[96mprint\u001b[39;49;00m(\u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mFound \u001b[39;49;00m\u001b[33m{\u001b[39;49;00m\u001b[96mlen\u001b[39;49;00m(candidate_msgs)\u001b[33m}\u001b[39;49;00m\u001b[33m candidate confirmation messages\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n>       \u001b[94massert\u001b[39;49;00m candidate_msgs, \u001b[33m\"\u001b[39;49;00m\u001b[33mNo \u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33mreading-group-confirm\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33m messages found\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n\u001b[1m\u001b[31mE       AssertionError: No 'reading-group-confirm' messages found\u001b[0m\r\n\u001b[1m\u001b[31mE       assert []\u001b[0m\r\n\r\n\u001b[1m\u001b[31m/tests/test_outputs.py\u001b[0m:117: AssertionError\r\n--------------------------------------------------------------------- Captured stdout call ---------------------------------------------------------------------\r\nalicegray added successfully.\r\nalicegray sends a join request\r\nalicegray has not yet confirmed their subscription\r\nRetrying in 2 seconds...\r\nalicegray has 1 messages in their inbox\r\nthe subjects are as follows:\r\n['Your confirmation is needed to join the reading-group@local.edu\\n mailing list.']\r\nFound 1 candidate confirmation messages\r\nMessage details:\r\n  From: reading-group-confirm+669a25f8392f562e4ad8567dd8aead8877b22951@local.edu\r\n  To: alicegray@local.edu\r\n  Subject: Your confirmation is needed to join the reading-group@local.edu\r\n mailing list.\r\n  Body: Email Address Registration Confirmation\r\n\r\nHello, this is the GNU Mailman server at local.edu.\r\n\r\nWe have received a registration request for the email address\r\n\r\n    alicegray@local.edu\r\n\r\nBefore you can start using GNU Mailman at this site, you must first confirm\r\nthat this is your email address.  You can do this by replying to this message.\r\n\r\nOr you should include the following line -- and only the following\r\nline -- in a message to reading-group-request@local.edu:\r\n\r\n    confirm 669a25f8392f562e4ad8567dd...\r\nReply to reading-group-confirm+669a25f8392f562e4ad8567dd8aead8877b22951@local.edu from alicegray@local.edu for join\r\nRetrying in 2 seconds...\r\nalicegray has confirmed their subscription\r\nalicegray sends an announcement\r\nRetrying in 2 seconds...\r\nalicegray announcement has received its own announcement\r\nalicegray decides to leave now\r\nalicegray is still a member of the list (pending confirmation)\r\nalicegray has 3 messages in their inbox\r\nthe subjects are as follows:\r\n['Your confirmation is needed to join the reading-group@local.edu\\n mailing list.', 'Welcome to the \"Reading-group\" mailing list', '[Reading-group] Secret Announcement']\r\nFound 0 candidate confirmation messages\r\nRetrying in 2 seconds...\r\nalicegray has 4 messages in their inbox\r\nthe subjects are as follows:\r\n['Your confirmation is needed to join the reading-group@local.edu\\n mailing list.', 'Welcome to the \"Reading-group\" mailing list', '[Reading-group] Secret Announcement', 'You have been unsubscribed from the Reading-group mailing list']\r\nFound 0 candidate confirmation messages\r\nRetrying in 4 seconds...\r\nalicegray has 4 messages in their inbox\r\nthe subjects are as follows:\r\n['Your confirmation is needed to join the reading-group@local.edu\\n mailing list.', 'Welcome to the \"Reading-group\" mailing list', '[Reading-group] Secret Announcement', 'You have been unsubscribed from the Reading-group mailing list']\r\nFound 0 candidate confirmation messages\r\nRetrying in 8 seconds...\r\nalicegray has 4 messages in their inbox\r\nthe subjects are as follows:\r\n['Your confirmation is needed to join the reading-group@local.edu\\n mailing list.', 'Welcome to the \"Reading-group\" mailing list', '[Reading-group] Secret Announcement', 'You have been unsubscribed from the Reading-group mailing list']\r\nFound 0 candidate confirmation messages\r\nRetrying in 16 seconds...\r\nalicegray has 4 messages in their inbox\r\nthe subjects are as follows:\r\n['Your confirmation is needed to join the reading-group@local.edu\\n mailing list.', 'Welcome to the \"Reading-group\" mailing list', '[Reading-group] Secret Announcement', 'You have been unsubscribed from the Reading-group mailing list']\r\nFound 0 candidate confirmation messages\r\n\u001b[33m======================================================================= warnings summary =======================================================================\u001b[0m\r\ntest_outputs.py::test_mlist_exists\r\n  /app/.tbench-testing/lib/python3.12/site-packages/mailman/database/model.py:56: MovedIn20Warning: The ``declarative_base()`` function is now available as sqlalchemy.orm.declarative_base(). (deprecated since: 2.0) (Background on SQLAlchemy 2.0 at: https://sqlalche.me/e/b8d9)\r\n    Model = declarative_base(cls=ModelMeta)\r\n\r\ntest_outputs.py::test_mlist_exists\r\n"]
