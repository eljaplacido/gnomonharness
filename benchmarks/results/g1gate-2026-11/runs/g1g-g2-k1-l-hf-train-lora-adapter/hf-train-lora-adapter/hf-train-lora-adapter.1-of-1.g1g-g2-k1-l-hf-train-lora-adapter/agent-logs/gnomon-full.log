[approval] bash: cd /app && python3 -c "
from peft import PeftModel
from transformers import GPT2LMHeadModel, GPT2Tokenizer
import torch

# Load base model and tokenizer
base_model = GPT2LMHeadModel.from_pretrained('openai-community/gpt2')
tokenizer = GPT2Tokenizer.from_pretrained('openai-community/gpt2')
tokenizer.pad_token = tokenizer.eos_token

# Load LoRA adapter
model = PeftModel.from_pretrained(base_model, '/app/experiments/lora_adapter')
model.eval()

# Test generation
question = 'What is the primary function of hemoglobin?'
options = ['A) Transport oxygen', 'B) Fight infections', 'C) Clot blood', 'D) Digest food']
prompt = f'Question: {question}\nOptions:\n'
for opt in options:
    prompt += f'{opt}\n'
prompt += 'Answer: '

inputs = tokenizer(prompt, return_tensors='pt')
with torch.no_grad():
    outputs = model.generate(
        **inputs,
        max_new_tokens=5,
        do_sample=False,
    )
answer = tokenizer.decode(outputs[0], skip_special_tokens=True)
print(f'Prompt: {prompt}')
print(f'Generated: {answer}')
print('Model loaded and generated successfully!')
