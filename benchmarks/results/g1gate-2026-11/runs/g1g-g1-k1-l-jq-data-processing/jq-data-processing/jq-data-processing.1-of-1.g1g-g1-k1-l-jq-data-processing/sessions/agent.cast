[116.978456, "o", "echo \"=== Output structure checks ===\"\r\necho \"Total active users: $(jq 'length' /app/active_users_report.json)\"\r\necho \"All sorted by username: $(jq '[.[].username] | . == sort' /app/active_users_report.json)\"\r\necho \"All dates YYYY-MM-DD: $(jq '[.[] | .last_login | test(\"^[0-9]{4}-[0-9]{2}-[0-9]{2}$\")] | all' /app/active_users_report.json)\"\r\necho \"All have required keys: $(jq '[.[] | keys] | flatten | unique' /app/active_users_report.json)\"\r\necho \"No inactive users: $(jq '[.[] | select(.status != null)] | length' /app/active_users_report.json)\"\r\necho \"Null primary_role for empty roles: $(jq '[.[] | select(.role_count == 0 and .primary_role == null)] | length' /app/active_users_report.json)\"\r\necho \"Non-null primary_role for non-empty roles: $(jq '[.[] | select(.role_count > 0 and .primary_role == null)] | length' /app/active_users_report.json)\"\r\n\r\necho \"\"\r\necho \"=== Indentation check (first 3 lines) ===\"\r\nhead -3 /app/active_users_report.json | cat -A — approved\r\n  ⚙ bash # Verify all paths exist echo \"=== "]
