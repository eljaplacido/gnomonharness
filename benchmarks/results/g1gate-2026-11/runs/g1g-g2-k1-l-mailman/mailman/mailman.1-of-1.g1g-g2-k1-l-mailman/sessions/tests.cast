[96.972368, "o", "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mreadinto\u001b[39;49;00m(\u001b[96mself\u001b[39;49;00m, b):\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"Read up to len(b) bytes into the writable buffer *b* and return\u001b[39;49;00m\r\n    \u001b[33m    the number of bytes read.  If the socket is non-blocking and no bytes\u001b[39;49;00m\r\n    \u001b[33m    are available, None is returned.\u001b[39;49;00m\r\n    \u001b[33m\u001b[39;49;00m\r\n    \u001b[33m    If *b* is non-empty, a 0 return value indicates that the connection\u001b[39;49;00m\r\n    \u001b[33m    was shutdown at the other end.\u001b[39;49;00m\r\n    \u001b[33m    \"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        \u001b[96mself\u001b[39;49;00m._checkClosed()\u001b[90m\u001b[39;49;00m\r\n        \u001b[96mself\u001b[39;49;00m._checkReadable()\u001b[90m\u001b[39;49;00m\r\n        \u001b[94mif\u001b[39;49;00m \u001b[96mself\u001b[39;49;00m._timeout_occurred:\u001b[90m\u001b[39;49;00m\r\n            \u001b[94mraise\u001b[39;49;00m \u001b[96mOSError\u001b[39;49;00m(\u001b[33m\"\u001b[39;49;00m\u001b[33mcannot read from timed out object\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n        \u001b[94mwhile\u001b[39;49;00m \u001b[94mTrue\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\r\n            \u001b[94mtry\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\r\n>               \u001b[94mreturn\u001b[39;49;00m \u001b[96mself\u001b[39;49;00m._sock.recv_into(b)\u001b[90m\u001b[39;49;00m\r\n                       ^^^^^^^^^^^^^^^^^^^^^^^\u001b[90m\u001b[39;49;00m\r\n\u001b[1m\u001b[31mE               ConnectionResetError: [Errno 104] Connection reset by peer\u001b[0m\r\n\r\n\u001b[1m\u001b[31m/usr/lib/python3.12/socket.py\u001b[0m:707: ConnectionResetError\r\n\r\n\u001b[33mDuring handling of the above exception, another exception occurred:\u001b[0m\r\n\r\n"]
[96.972681, "o", "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mtest_simple_local_delivery\u001b[39;49;00m():\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"Test that postfix can deliver mail to local users\u001b[39;49;00m\r\n    \u001b[33m    and that the email content is accessible in their local mailboxes.\u001b[39;49;00m\r\n    \u001b[33m    \"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        user = \u001b[33m\"\u001b[39;49;00m\u001b[33mbobgreen\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        add_user(user)\u001b[90m\u001b[39;49;00m\r\n        mbox_path = \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m/var/mail/\u001b[39;49;00m\u001b[33m{\u001b[39;49;00muser\u001b[33m}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        subject = \u001b[33m\"\u001b[39;49;00m\u001b[33mDirect Message\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n>       send_email(\u001b[90m\u001b[39;49;00m\r\n            from_addr=\u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m{\u001b[39;49;00muser\u001b[33m}\u001b[39;49;00m\u001b[33m@\u001b[39;49;00m\u001b[33m{\u001b[39;49;00mDOMAIN_NAME\u001b[33m}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\r\n            to_addr=\u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m{\u001b[39;49;00muser\u001b[33m}\u001b[39;49;00m\u001b[33m@\u001b[39;49;00m\u001b[33m{\u001b[39;49;00mDOMAIN_NAME\u001b[33m}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\r\n            subject=subject,\u001b[90m\u001b[39;49;00m\r\n            body=\u001b[33m\"\u001b[39;49;00m\u001b[33mDirect test message\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\r\n        )\u001b[90m\u001b[39;49;00m\r\n\r\n\u001b[1m\u001b[31m/tests/test_outputs.py\u001b[0m:144: \r\n_ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ 