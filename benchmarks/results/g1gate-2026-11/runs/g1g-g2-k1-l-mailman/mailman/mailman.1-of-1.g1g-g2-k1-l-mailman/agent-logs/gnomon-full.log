    d = getUtility(IDomain, 'local.edu')
    print(f"Domain local.edu already exists: {d.name}")
except:
    print("Domain local.edu does not exist, creating...")
    # We need to create it via the domain manager
    from mailman.interfaces.domain import IDomainSet
    domain_set = getUtility(IDomainSet)
    print("DomainSet:", domain_set)
    # Create domain
    domain = domain_set.create('local.edu')
    print(f"Created domain: {domain.name}")

# Now create the mailing list
list_manager = getUtility(IListManager)
try:
    mlist = list_manager.get('reading-group@local.edu')
    print(f"List reading-group@local.edu already exists")
except:
    print("Creating list reading-group@local.edu...")
    mlist = list_manager.create('reading-group@local.edu', 'Reading Group', 'reading-group-owner@local.edu')
    print(f"Created list: {mlist.list_name}@{mlist.domain}")

# Set subscription policy to open
from mailman.interfaces.subscription import SubscriptionPolicy
mlist.subscription_policy = SubscriptionPolicy.open
print(f"Subscription policy: {mlist.subscription_policy}")

# Set default language
mlist.default_language = 'en'
print(f"Default language: {mlist.default_language}")

print("Done!")
