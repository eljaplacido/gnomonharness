from rdflib import Graph
from datetime import date

g = Graph()
g.parse("/app/university_graph.ttl", format="turtle")

# List all students enrolled in STS101
query = """
PREFIX uni: <http://university.org/ontology/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema/>

SELECT ?student ?name ?enrollDate ?gradDate
WHERE {
  ?student uni:isEnrolledIn uni:STS101 ;
           uni:hasEnrollmentDate ?enrollDate ;
           uni:hasName ?name .
  OPTIONAL { ?student uni:hasGraduationDate ?gradDate }
}
ORDER BY ?name
"""
ref = date(2025, 8, 16)
count = 0
for row in g.query(query):
    grad = row['gradDate']
    enrolled = True
    if grad is not None:
        grad_date = grad.toPython()
        if grad_date < ref:
            enrolled = False
    status = "ENROLLED" if enrolled else "GRADUATED"
    if enrolled:
        count += 1
    print(f"  {row['name']}: enroll={row['enrollDate']}, grad={grad}, {status}")

print(f"\nTotal currently enrolled: {count}")
