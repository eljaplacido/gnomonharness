from rdflib import Graph

g = Graph()
g.parse("/app/university_graph.ttl", format="turtle")

# Check per-department student counts for each professor
query = """
PREFIX uni: <http://university.org/ontology/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema/>

SELECT ?profName ?deptName ?deptCountry ?count
WHERE {
  ?prof a uni:Person ;
        uni:hasName ?profName ;
        uni:role ?role ;
        uni:worksIn ?dept .
  FILTER(CONTAINS(?role, "Professor") && !CONTAINS(?role, "Assistant"))
  ?dept uni:belongsTo ?univ .
  ?univ uni:locatedInCountry ?deptCountry .
  ?course uni:isTaughtIn ?dept .
  ?student uni:isEnrolledIn ?course ;
           uni:hasEnrollmentDate ?enrollDate .
  FILTER(?enrollDate <= "2025-08-16"^^xsd:date)
  OPTIONAL { ?student uni:hasGraduationDate ?gradDate }
  FILTER(!BOUND(?gradDate) || ?gradDate >= "2025-08-16"^^xsd:date)
}
GROUP BY ?profName ?dept ?deptCountry
ORDER BY ?profName ?deptCountry
"""
for row in g.query(query):
    print(f"  {row.profName} | {row.deptCountry} | count={int(row.count)}")

