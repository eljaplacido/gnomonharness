import time, torch, json
t0=time.time()
import train_lora as T
from transformers import AutoTokenizer, AutoModelForCausalLM
from peft import LoraConfig, TaskType, get_peft_model
from torch.utils.data import DataLoader
tok=AutoTokenizer.from_pretrained(T.BASE_MODEL); tok.pad_token=tok.eos_token
raw=json.load(open('/app/data/train.json'))
ds=T.BioQADataset(raw[:64], tok, train=True)
m=AutoModelForCausalLM.from_pretrained(T.BASE_MODEL)
m=get_peft_model(m, LoraConfig(task_type=TaskType.CAUSAL_LM, r=8, lora_alpha=16, lora_dropout=0.05, target_modules=['c_attn'], bias='none'))
dl=DataLoader(ds, batch_size=16, shuffle=True, collate_fn=ds.collate)
opt=torch.optim.AdamW([p for p in m.parameters() if p.requires_grad], lr=1e-3)
print('rows', len(ds), 'batches', len(dl))
m.train()
for i,(ids,attn,lab) in enumerate(dl):
    if i>=15: break
    loss=m(input_ids=ids, attention_mask=attn, labels=lab).loss
    opt.zero_grad(); loss.backward(); opt.step()
    print('step',i,'seqlen',ids.shape[1],'loss',round(loss.item(),4),'t',round(time.time()-t0,1))
val=T.BioQADataset(json.load(open('/app/data/val.json'))[:32], tok, train=False)
acc=T.evaluate(m, val)
print('val32 acc', round(acc,4), 'total s', round(time.time()-t0,1))
