  char*body=NULL; size_t bodylen=0;
  while((n=read(s,buf,sizeof buf))>0){
    if(!hdr){
      body=realloc(body,bodylen+n); memcpy(body+bodylen,buf,n); bodylen+=n;
      char*e=strstr(body,"\r\n\r\n");
      if(e){ size_t off=(e+4)-body; fwrite(body+off,1,bodylen-off,f); total+=bodylen-off; free(body); body=NULL; hdr=1;
        char*h1=strndup(body?body:"",0); (void)h1;
      }
    } else { fwrite(buf,1,n,f); total+=n; }
  }
