[approval] bash: cat > /tmp/check_flows.py << 'PYEOF'
import mailbox
import os
import smtplib
import subprocess
from email.mime.text import MIMEText
from functools import partial as bind
from time import sleep

DOMAIN_NAME = "local.edu"
MAILING_LIST = "reading-group@local.edu"
JOIN_LIST = "reading-group-join@local.edu"
LEAVE_LIST = "reading-group-leave@local.edu"
MAILING_LIST_CONFIG = "/etc/mailman3/mailman.cfg"

from mailman.core.initialize import initialize
from mailman.interfaces.listmanager import IListManager
from zope.component import getUtility

def retry(func, retries=5, delay=2, backoff=2, exceptions=(Exception,)):
    attempt = 0
    current_delay = delay
    while attempt < retries:
        try:
            return func()
        except exceptions as e:
            attempt += 1
            if attempt == retries:
                raise e
            print(f"Retrying in {current_delay} seconds...")
            sleep(current_delay)
            current_delay *= backoff

def add_user(username):
    try:
        subprocess.run(["useradd", username], check=True, capture_output=True, text=True)
        print(f"{username} added successfully.")
    except subprocess.CalledProcessError as e:
        print(f"Failed to add {username}. Error: {e.stderr.strip()}")
        raise

def get_mlist():
    initialize(MAILING_LIST_CONFIG)
    list_manager = getUtility(IListManager)
    return list_manager.get(MAILING_LIST)

def send_email(*, body, subject, from_addr, to_addr):
    msg = MIMEText(body)
    msg["Subject"] = subject
    msg["From"] = from_addr
    msg["To"] = to_addr
    with smtplib.SMTP("localhost", 25) as server:
        server.send_message(msg)

def confirm_last_reply(user, subject_contains=""):
    mbox_path = f"/var/mail/{user}"
    mbox = mailbox.mbox(mbox_path)
    candidate_msgs = [
        msg for msg in mbox
        if msg.get("From").startswith("reading-group-confirm")
        and subject_contains in msg.get("Subject", "")
    ]
    assert candidate_msgs, f"No confirmation messages for {subject_contains}"
    confirmation_msg = candidate_msgs[-1]
    confirmation_from = confirmation_msg.get("From")
    send_email(body="", subject="", from_addr=f"{user}@{DOMAIN_NAME}", to_addr=confirmation_from)
    print(f"Replied for {subject_contains} from {user}")

def wait_for_mailbox_message(user, subject_contains, timeout=30):
    mbox_path = f"/var/mail/{user}"
    start = time.time()
    while time.time() - start < timeout:
        mbox = mailbox.mbox(mbox_path)
        for msg in mbox:
            if subject_contains in msg.get("Subject", ""):
                return True
        sleep(1)
    return False

import time

def main():
    user1 = os.urandom(8).hex()
    user2 = os.urandom(8).hex()
    add_user(user1)
    add_user(user2)

    # join both
    send_email(body="", subject="", from_addr=f"{user1}@{DOMAIN_NAME}", to_addr=JOIN_LIST)
    send_email(body="", subject="", from_addr=f"{user2}@{DOMAIN_NAME}", to_addr=JOIN_LIST)
    print("Join requests sent")

    # wait for confirmation mails
    def wait_confirm():
        for u in [user1, user2]:
            mbox = mailbox.mbox(f"/var/mail/{u}")
            msgs = [m for m in mbox if m.get("From","").startswith("reading-group-confirm") and "join" in m.get("Subject","")]
            if not msgs:
                raise AssertionError(f"No join confirmation for {u}")
    retry(wait_confirm, retries=10, delay=2)

    confirm_last_reply(user1, "join")
    confirm_last_reply(user2, "join")

    # verify members
    mlist = get_mlist()
    assert mlist.members.get_member(f"{user1}@{DOMAIN_NAME}"), "user1 not member"
    assert mlist.members.get_member(f"{user2}@{DOMAIN_NAME}"), "user2 not member"
    print("Both members")

    # post message
    post_subject = "Test post"
    post_body = "Hello from test"
    send_email(body=post_body, subject=post_subject, from_addr=f"{user1}@{DOMAIN_NAME}", to_addr=MAILING_LIST)
    print("Post sent")

    # wait for delivery
    def check_delivery():
        for u in [user1, user2]:
            mbox = mailbox.mbox(f"/var/mail/{u}")
            found = any(msg.get("Subject","") == post_subject and post_body in msg.get_payload() for msg in mbox)
            if not found:
                raise AssertionError(f"Post not delivered to {u}")
    retry(check_delivery, retries=10, delay=2)
    print("Post delivered to both")

    # leave user1
    send_email(body="", subject="", from_addr=f"{user1}@{DOMAIN_NAME}", to_addr=LEAVE_LIST)
    # wait for confirmation
    def wait_leave_confirm():
        mbox = mailbox.mbox(f"/var/mail/{user1}")
        msgs = [m for m in mbox if m.get("From","").startswith("reading-group-confirm") and "leave" in m.get("Subject","")]
        if not msgs:
            raise AssertionError("No leave confirmation")
    retry(wait_leave_confirm, retries=10, delay=2)

    # still member
    mlist = get_mlist()
    assert mlist.members.get_member(f"{user1}@{DOMAIN_NAME}"), "user1 should still be member before confirm"
    confirm_last_reply(user1, "leave")
    # wait for removal
    def check_removed():
        mlist = get_mlist()
        if mlist.members.get_member(f"{user1}@{DOMAIN_NAME}"):
            raise AssertionError("user1 still member after confirm")
    retry(check_removed, retries=10, delay=2)
    print("User1 left")

    # post again
    post_subject2 = "Second post"
    send_email(body="second", subject=post_subject2, from_addr=f"{user2}@{DOMAIN_NAME}", to_addr=MAILING_LIST)
    def check_second():
        mbox2 = mailbox.mbox(f"/var/mail/{user2}")
        found2 = any(msg.get("Subject","") == post_subject2 for msg in mbox2)
        if not found2:
            raise AssertionError("Second post not delivered to user2")
        mbox1 = mailbox.mbox(f"/var/mail/{user1}")
        found1 = any(msg.get("Subject","") == post_subject2 for msg in mbox1)
        if found1:
            raise AssertionError("Second post delivered to user1 who left")
    retry(check_second, retries=10, delay=2)
    print("Second post delivered only to remaining member")
    print("All checks passed")

if __name__ == "__main__":
    main()
