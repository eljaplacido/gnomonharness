    ids = set(re.findall(r'\sid="([^"]+)"', html))
    class Parser(HTMLParser):
        def handle_starttag(self, tag, attrs):
            nonlocal checked
            attrs = dict(attrs)
            for a in ('href','src'):
                if a in attrs:
                    checked += 1
                    val = attrs[a]
