from html.parser import HTMLParser

root = 'my_website'
files = [os.path.join(root,f) for f in os.listdir(root) if f.endswith('.html')]
checked = 0
broken = []
for fp in files:
    rel = os.path.relpath(fp, root)
    with open(fp, 'r', encoding='utf-8') as f:
        html = f.read()
    class P(HTMLParser):
        def handle_starttag(self, tag, attrs):
            nonlocal checked
            attrs = dict(attrs)
            for a in ('href','src'):
                if a in attrs:
                    url = attrs[a]
                    checked += 1
                    # skip external
                    if url.startswith('http://') or url.startswith('https://') or url.startswith('mailto:') or url.startswith('data:'):
                        continue
                    # fragment only
                    if url.startswith('#'):
                        # check id exists in this file
                        if f'id="{url[1:]}"' not in html and f"id='{url[1:]}'" not in html:
                            broken.append((rel, url, 'missing fragment'))
                        continue
                    # resolve relative path
                    # strip query/fragment
                    path = url.split('#')[0].split('?')[0]
                    # if path is empty, skip
                    if not path:
                        continue
                    # compute absolute path relative to file dir
                    base_dir = os.path.dirname(fp)
                    target = os.path.normpath(os.path.join(base_dir, path))
                    # ensure within root
                    if not os.path.exists(target):
                        broken.append((rel, url, 'missing file'))
    P().feed(html)

print(f"{checked} links checked, {len(broken)} broken")
for b in broken:
    print(b)
