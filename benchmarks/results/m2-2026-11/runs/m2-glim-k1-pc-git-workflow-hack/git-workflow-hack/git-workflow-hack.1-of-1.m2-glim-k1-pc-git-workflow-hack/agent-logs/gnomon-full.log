import os, re
from html.parser import HTMLParser

root='my_website'
pages=['index.html','blog.html','publications.html']

class LinkParser(HTMLParser):
    def __init__(self):
        super().__init__()
        self.links=[]
        self.ids=set()
    def handle_starttag(self,tag,attrs):
        attrs=dict(attrs)
        if tag=='a' and 'href' in attrs:
            self.links.append(('href',attrs['href']))
        if tag in ('link','script','img') and 'href' in attrs or 'src' in attrs:
            if tag=='link' and 'href' in attrs:
                self.links.append(('href',attrs['href']))
            if tag in ('script','img') and 'src' in attrs:
                self.links.append(('src',attrs['src']))
        if 'id' in attrs:
            self.ids.add(attrs['id'])

checked=0
broken=0
for page in pages:
    path=os.path.join(root,page)
    with open(path,encoding='utf-8') as f:
        html=f.read()
    parser=LinkParser()
    parser.feed(html)
    # resolve links
    base_dir=os.path.dirname(path)
    for typ,url in parser.links:
        checked+=1
        # skip external
        if re.match(r'^(https?:|mailto:|data:)',url):
            continue
        # fragment only
        if url.startswith('#'):
            frag=url[1:]
            if frag and frag not in parser.ids:
                broken+=1
                print('broken fragment',page,url)
            continue
        # split fragment
        if '#' in url:
            file_part, frag = url.split('#',1)
        else:
            file_part, frag = url, None
        # resolve relative path
        if file_part=='':
            target_path=path
        else:
            target_path=os.path.normpath(os.path.join(base_dir,file_part))
        # check existence
        if not os.path.exists(target_path):
            broken+=1
            print('broken file',page,url,target_path)
            continue
        # if fragment, check id in target
        if frag:
            # if target is html, check ids
            if target_path.endswith('.html'):
                with open(target_path,encoding='utf-8') as tf:
                    tp=LinkParser()
                    tp.feed(tf.read())
                if frag not in tp.ids:
                    broken+=1
                    print('broken fragment in file',page,url,frag)
print(f'{checked} links checked, {broken} broken')
