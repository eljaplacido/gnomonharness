import os, re
from html.parser import HTMLParser

root = 'my_website'
pages = ['index.html','blog.html','publications.html']
checked = 0
broken = 0

class LinkParser(HTMLParser):
    def __init__(self):
        super().__init__()
        self.links = []
        self.ids = set()
    def handle_starttag(self, tag, attrs):
        attrs = dict(attrs)
        if tag == 'a' and 'href' in attrs:
            self.links.append(('href', attrs['href']))
        elif tag in ('link','script','img','source') and 'src' in attrs:
            self.links.append(('src', attrs['src']))
        elif tag in ('link','script') and 'href' in attrs:
            self.links.append(('href', attrs['href']))
        if 'id' in attrs:
            self.ids.add(attrs['id'])

for page in pages:
    path = os.path.join(root, page)
    with open(path, 'r', encoding='utf-8') as f:
        html = f.read()
    parser = LinkParser()
    parser.feed(html)
    # check links
    for typ, url in parser.links:
        checked += 1
        if url.startswith('#'):
            frag = url[1:]
            if frag and frag not in parser.ids:
                broken += 1
                # print(f'broken fragment {page} #{frag}')
        elif url.startswith('http://') or url.startswith('https://') or url.startswith('mailto:') or url.startswith('data:'):
            continue
        else:
            # resolve relative
            # strip fragment
            u = url.split('#')[0]
            if not u:
                continue
            # if starts with /, treat as root
            if u.startswith('/'):
                target = os.path.join(root, u.lstrip('/'))
            else:
                target = os.path.normpath(os.path.join(root, os.path.dirname(page), u))
            if not os.path.exists(target):
                # maybe file without extension? try adding .html?
                broken += 1
                # print(f'broken link {page} -> {url}')
    # also check ids referenced from other pages? spec says every #fragment used from a page exists as id on that page
print(f'{checked} links checked, {broken} broken')
