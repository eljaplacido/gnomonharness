[5.544107, "o", "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mtest_fibonacci_polyglot\u001b[39;49;00m():\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"\u001b[39;49;00m\r\n    \u001b[33m    Test that main.py.c is a valid polyglot that runs with both python3 and gcc,\u001b[39;49;00m\r\n"]
[5.544137, "o", "    \u001b[33m    produces correct Fibonacci numbers, and is contained in a single file.\u001b[39;49;00m\r\n    \u001b[33m    \"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[90m# Verify that only main.py.c exists in /app/polyglot\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        polyglot_files = os.listdir(\u001b[33m\"\u001b[39;49;00m\u001b[33m/app/polyglot\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n>       \u001b[94massert\u001b[39;49;00m polyglot_files == [\u001b[33m\"\u001b[39;49;00m\u001b[33mmain.py.c\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m], (\u001b[90m\u001b[39;49;00m\r\n            \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mExpected only main.py.c, found: \u001b[39;49;00m\u001b[33m{\u001b[39;49;00mpolyglot_files\u001b[33m}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        )\u001b[90m\u001b[39;49;00m\r\n\u001b[1m\u001b[31mE       AssertionError: Expected only main.py.c, found: ['main.py.c', 'cmain']\u001b[0m\r\n\u001b[1m\u001b[31mE       assert ['main.py.c', 'cmain'] == ['main.py.c']\u001b[0m\r\n\u001b[1m\u001b[31mE         \u001b[0m\r\n\u001b[1m\u001b[31mE         Left contains one more item: \u001b[0m\u001b[33m'\u001b[39;49;00m\u001b[33mcmain\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\u001b[0m\r\n\u001b[1m\u001b[31mE         Use -v to get more diff\u001b[0m\r\n\r\n"]
