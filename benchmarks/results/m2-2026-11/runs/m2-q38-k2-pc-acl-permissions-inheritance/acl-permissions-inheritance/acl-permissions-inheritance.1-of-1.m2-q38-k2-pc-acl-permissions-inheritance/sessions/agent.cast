[24.80517, "o", "   - Base permissions: 2770 (rwxrws---)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> 2. Configure ACLs on /srv/shared:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[24.805222, "o", "   - Group \"research\": full rwx permissions (both current and default)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[24.805278, "o", "   - Users \"alice\" and \"bob\": full rwx permissions (both current and default)  \r\n\u001b[?2004l\r\u001b[?2004h> "]
[24.805332, "o", "   - Others: no permissions (both current and default)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[24.805377, "o", "   - Set proper mask to allow full permissions\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[24.805416, "o", "\u001b[?2004h> "]
[24.805458, "o", "3. The ACL configuration must ensure that:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[24.805512, "o", "   - Any file created by alice or bob in /srv/shared is accessible by both users\r\n\u001b[?2004l\r\u001b[?2004h> "]
[24.805665, "o", "   - The permissions are inherited by subdirectories and files\r\n\u001b[?2004l\r\u001b[?2004h> "]
[24.805744, "o", "   - Users outside the research group cannot access the directory or its contents\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
