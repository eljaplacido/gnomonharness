[5.990583, "o", "\u001b[31m\u001b[1m______________________________________________________________ test_outputs_are_contigs_not_kmers ______________________________________________________________\u001b[0m\r\n\r\n"]
[6.002845, "o", "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mtest_outputs_are_contigs_not_kmers\u001b[39;49;00m():\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"Check that outputs are actual contigs, not just input k-mers.\u001b[39;49;00m\r\n    \u001b[33m\u001b[39;49;00m\r\n    \u001b[33m    Contigs should be extended sequences longer than k-mers.\u001b[39;49;00m\r\n    \u001b[33m    \"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        \u001b[90m# Load the test input to get k-mer length\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        test_file = Path(\u001b[33m\"\u001b[39;49;00m\u001b[33m/app/test\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n        kmer_length = \u001b[94mNone\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        \u001b[94mif\u001b[39;49;00m test_file.exists():\u001b[90m\u001b[39;49;00m\r\n            \u001b[94mwith\u001b[39;49;00m \u001b[96mopen\u001b[39;49;00m(test_file, \u001b[33m\"\u001b[39;49;00m\u001b[33mr\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m) \u001b[94mas\u001b[39;49;00m f:\u001b[90m\u001b[39;49;00m\r\n                first_line = f.readline().strip()\u001b[90m\u001b[39;49;00m\r\n                \u001b[94mif\u001b[39;49;00m first_line:\u001b[90m\u001b[39;49;00m\r\n                    kmer = first_line.split(\u001b[33m\"\u001b[39;49;00m\u001b[33m\\t\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)[\u001b[94m0\u001b[39;49;00m]\u001b[90m\u001b[39;49;00m\r\n                    kmer_length = \u001b[96mlen\u001b[39;49;00m(kmer)\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[94massert\u001b[39;49;00m kmer_length \u001b[95mis\u001b[39;49;00m \u001b[95mnot\u001b[39;49;00m \u001b[94mNone\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33mCould not determine k-mer length from test file\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[90m# Check serial output\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        serial_out = Path(\u001b[33m\"\u001b[39;49;00m\u001b[33m/app/serial.out\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n        \u001b[94mif\u001b[39;49;00m serial_out.exists():\u001b[90m\u001b[39;49;00m\r\n            content = serial_out.read_text()\u001b[90m\u001b[39;49;00m\r\n            lines = [line.strip() \u001b[94mfor\u001b[39;49;00m line \u001b[95min\u001b[39;49;00m content.strip().split(\u001b[33m\"\u001b[39;49;00m\u001b[33m\\n\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m) \u001b[94mif\u001b[39;49;00m line.strip()]\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n            \u001b[90m# Contigs should be longer than k-mers (except possibly very short ones)\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n            long_contigs = [line \u001b[94mfor\u001b[39;49;00m line \u001b[95min\u001b[39;49;00m lines \u001b[94mif\u001b[39;49;00m \u001b[96mlen\u001b[39;49;00m(line) > kmer_length]\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n>           \u001b[94massert\u001b[39;49;00m \u001b[96mlen\u001b[39;49;00m(long_contigs) > \u001b[94m0\u001b[39;49;00m, (\u001b[90m\u001b[39;49;00m\r\n                \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mNo contigs longer than k-mer length (\u001b[39;49;00m\u001b[33m{\u001b[39;49;00mkmer_length\u001b[33m}\u001b[39;49;00m\u001b[33m) found. \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n                \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mOutput appears to contain k-mers instead of assembled contigs.\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n            )\u001b[90m\u001b[39;49;00m\r\n\u001b[1m\u001b[31mE           AssertionError: No contigs longer than k-mer length (19) found. Output appears to contain k-mers instead of assembled contigs.\u001b[0m\r\n\u001b[1m\u001b[31mE           assert 0 > 0\u001b[0m\r\n\u001b[1m\u001b[31mE            +  where 0 = len([])\u001b[0m\r\n\r\n\u001b[1m\u001b[31m/tests/test_outputs.py\u001b[0m:133: AssertionError\r\n============================================================================ PASSES ============================================================================\r\n"]
