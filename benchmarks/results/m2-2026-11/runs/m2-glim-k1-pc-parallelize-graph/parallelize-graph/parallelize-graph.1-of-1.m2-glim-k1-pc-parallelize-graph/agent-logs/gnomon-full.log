/* dbg_types.h -- node record shared by the serial and parallel builds.
 * Kept in its own header so a translation unit can declare its storage
 * (plain array / mutex-guarded / UPC shared) before including dbg.h.
 */
#ifndef DBG_TYPES_H
#define DBG_TYPES_H

#include <stdint.h>

/* One unique k-mer.  key holds the k-mer itself, two bits per base
 * (A=0 C=1 G=2 T=3); lext/rext are the extension characters ('F' = none);
 * next is the chain link of the hash table bucket, -1 for end of chain. */
typedef struct {
    uint64_t      key;
    unsigned char lext;
    unsigned char rext;
    int           next;
} DNode;

#endif /* DBG_TYPES_H */
