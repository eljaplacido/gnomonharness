/* pgen.c -- parallel de Bruijn graph construction and traversal.
 *
 * Two build modes from one source, because the algorithm text in
 * lib/dbg.h is written against storage macros:
 *
 *   upcc -D__UPC__  : nodes/table/visited live in UPC shared memory, the
 *                     thread count and rank come from THREADS/MYTHREAD,
 *                     synchronization is upc_barrier / upc_all_lock_alloc.
 *   cc -pthread     : the same partition of the work over pthreads with a
 *                     sense-reversing barrier and one global insert mutex.
 *                     This is the portable build for a machine without
 *                     Berkeley UPC installed.
 *
 * Both write one output file per thread: <prefix>_<rank>.out
 * Default prefix /app/pgen (argv[2], or env PGEN_PREFIX), so the files are
 * /app/pgen_0.out ... and each holds whole contigs, one per line.
 */
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>

#include "dbg_types.h"

static int  me = 0;          /* this thread's rank */
static int  nthreads = 1;    /* threads participating */

#ifdef __UPC__

#include <upc.h>
#include <upc_relaxed.h>

static shared DNode         *snodes;
static shared int           *sbuckets;
static shared int           *sindeg;
static shared unsigned char *svisited;
static shared int            snodecount;
static int                   nbuckets = 0;
static upc_lock_t           *ilock;

#define NODES(i)        (snodes[i])
#define NODE_COUNT      (snodecount)
#define BUCKETS(i)      (sbuckets[i])
#define NBUCKETS        (nbuckets)
#define INDEG(i)        (sindeg[i])
#define VISITED(i)      (svisited[i])
#define INSERT_LOCK()   upc_lock(ilock)
#define INSERT_UNLOCK() upc_unlock(ilock)

#include "dbg.h"

/* Phase 1: thread MYTHREAD takes every THREADS-th usable line. */
static long build(const char *path, long *seen)
{
    FILE *f = fopen(path, "r");
    char line[65536];
    uint64_t key;
    unsigned char l, r;
    long idx = 0, mine = 0;

    (void)seen;
    if (!f) return -1;
    while (fgets(line, (int)sizeof line, f)) {
        if (db_parse_line(line, &key, &l, &r) == 0) {
            if (idx % nthreads == me) {
                if (db_insert(key, l, r) >= 0) mine++;
            }
            idx++;
        }
    }
    fclose(f);
    upc_barrier;
    return mine;
}

static void indegrees(void)
{
    int n = NODE_COUNT, i;
    for (i = me; i < n; i += nthreads) INDEG(i) = 0;
    upc_barrier;
    for (i = me; i < n; i += nthreads)
        INDEG(i) = (db_pred(i) >= 0) ? 1 : 0;
    upc_barrier;
}

#else  /* portable pthread build */

#include <pthread.h>
#include <unistd.h>

static DNode         *nodes;
static int            node_count = 0;
static int           *buckets;
static int            nbuckets = 0;
static int           *indeg;
static unsigned char *visited;

static pthread_mutex_t ilock = PTHREAD_MUTEX_INITIALIZER;

#define NODES(i)        (nodes[i])
#define NODE_COUNT      (node_count)
#define BUCKETS(i)      (buckets[i])
#define NBUCKETS        (nbuckets)
#define INDEG(i)        (indeg[i])
#define VISITED(i)      (visited[i])
#define INSERT_LOCK()   pthread_mutex_lock(&ilock)
#define INSERT_UNLOCK() pthread_mutex_unlock(&ilock)

/* sense-reversing barrier: pthreads has none of its own */
static pthread_mutex_t bmutex = PTHREAD_MUTEX_INITIALIZER;
static pthread_cond_t  bcond  = PTHREAD_COND_INITIALIZER;
static int bcount = 0, bgen = 0, btotal = 1;

static void barrier(void)
{
    int gen;
    pthread_mutex_lock(&bmutex);
    gen = bgen;
    if (++bcount == btotal) {
        bcount = 0;
        bgen++;
        pthread_cond_broadcast(&bcond);
    } else {
        while (gen == bgen) pthread_cond_wait(&bcond, &bmutex);
    }
    pthread_mutex_unlock(&bmutex);
}

#define upc_barrier barrier()

#include "dbg.h"

static void build(const char *path)
{
    FILE *f = fopen(path, "r");
    char line[65536];
    uint64_t key;
    unsigned char l, r;
    long idx = 0;

    if (!f) return;
    while (fgets(line, (int)sizeof line, f)) {
        if (db_parse_line(line, &key, &l, &r) == 0) {
            if (idx % nthreads == me) (void)db_insert(key, l, r);
            idx++;
        }
    }
    fclose(f);
    upc_barrier;
}

static void indegrees(void)
{
    int n = NODE_COUNT, i;
    for (i = me; i < n; i += nthreads) INDEG(i) = 0;
    upc_barrier;
    for (i = me; i < n; i += nthreads)
        INDEG(i) = (db_pred(i) >= 0) ? 1 : 0;
    upc_barrier;
}

#endif /* __UPC__ */

#define DEFAULT_PREFIX "/app/pgen"

static void contig_file(char *path, size_t cap, const char *prefix, int rank)
{
    snprintf(path, cap, "%s_%d.out", prefix, rank);
}

static void run(const char *in, const char *prefix)
{
    int n = NODE_COUNT, i, k = db_k;
    char path[4096];
    char *buf;
    FILE *out;

    for (i = 0; i < n; i += nthreads)
        ;                                   /* keep the compiler honest */
    buf = (char *)malloc((size_t)(n + k + 2));
    if (!buf) { fprintf(stderr, "pgen: out of memory\n"); return; }

    contig_file(path, sizeof path, prefix, me);
    out = fopen(path, "w");
    if (!out) {
        fprintf(stderr, "pgen: thread %d cannot write \"%s\"\n", me, path);
        free(buf);
        return;
    }
    db_paths(out, me, nthreads, buf);
    db_cycles(out, me, nthreads, buf);
    fclose(out);
    free(buf);
    fprintf(stderr, "pgen: thread %d/%d wrote %s\n", me, nthreads, path);
}

#ifdef __UPC__

int main(int argc, char **argv)
{
    const char *in     = (argc > 1) ? argv[1] : "test";
    const char *prefix = (argc > 2) ? argv[2] : DEFAULT_PREFIX;
    int nlines, k;

    me       = (int)MYTHREAD;
    nthreads = (int)THREADS;
    if (nthreads < 1) nthreads = 1;

    nlines = db_count_lines(in);
    if (nlines <= 0) {
        if (me == 0) fprintf(stderr, "pgen: cannot read input \"%s\"\n", in);
        return 1;
    }
    k = db_kmer_len(in);
    if (k <= 0 || k > 31) {
        if (me == 0) fprintf(stderr, "pgen: bad k-mer length %d\n", k);
        return 1;
    }
    db_set_k(k);

    nbuckets   = nlines / 2 + 1;
    snodes     = (shared DNode *)upc_all_alloc(nlines + 1, sizeof(DNode));
    sindeg     = (shared int *)upc_all_alloc(nlines + 1, sizeof(int));
    svisited   = (shared unsigned char *)upc_all_alloc(nlines + 1, 1);
    sbuckets   = (shared int *)upc_all_alloc(nbuckets, sizeof(int));
    upc_barrier;

    if (me == 0) snodecount = 0;
    for (int b = me; b < nbuckets; b += nthreads) sbuckets[b] = -1;
    for (int v = me; v < nlines + 1; v += nthreads) svisited[v] = 0;
    ilock = upc_all_lock_alloc();
    if (!ilock) {
        if (me == 0) fprintf(stderr, "pgen: cannot allocate lock\n");
        return 1;
    }
    upc_barrier;

    build(in, NULL);
    indegrees();

    if (me == 0)
        fprintf(stderr, "pgen: %d lines, k=%d, %d unique k-mers, %d threads\n",
                nlines, k, snodecount, nthreads);
    upc_barrier;

    run(in, prefix);
    upc_barrier;
    return 0;
}

#else  /* pthread build */

static const char *g_in;
static const char *g_prefix;

static void *worker(void *arg)
{
    (void)arg;
    run(g_in, g_prefix);
    return NULL;
}

int main(int argc, char **argv)
{
    const char *prefix = (argc > 2) ? argv[2] : DEFAULT_PREFIX;
    int nlines, k, i, t;
    pthread_t *tids;
    const char *nt;

    g_in     = (argc > 1) ? argv[1] : "test";
    g_prefix = prefix;

    nt = getenv("PGEN_THREADS");
    nthreads = nt ? atoi(nt) : 4;
    if (nthreads < 1) nthreads = 1;
    if (nthreads > 256) nthreads = 256;

    nlines = db_count_lines(g_in);
    if (nlines <= 0) {
        fprintf(stderr, "pgen: cannot read input \"%s\"\n", g_in);
        return 1;
    }
    k = db_kmer_len(g_in);
    if (k <= 0 || k > 31) {
        fprintf(stderr, "pgen: bad k-mer length %d\n", k);
        return 1;
    }
    db_set_k(k);

    nodes   = (DNode *)malloc(sizeof(DNode) * (size_t)(nlines + 1));
    indeg   = (int *)malloc(sizeof(int) * (size_t)(nlines + 1));
    visited = (unsigned char *)calloc((size_t)(nlines + 1), 1);
    nbuckets = nlines / 2 + 1;
    buckets = (int *)malloc(sizeof(int) * (size_t)nbuckets);
    tids    = (pthread_t *)malloc(sizeof(pthread_t) * (size_t)nthreads);
    if (!nodes || !indeg || !visited || !buckets || !tids) {
        fprintf(stderr, "pgen: out of memory\n");
        return 1;
    }
    for (i = 0; i < nbuckets; i++) buckets[i] = -1;
    btotal = nthreads;

    me = 0;
    build(g_in);
    indegrees();

    fprintf(stderr, "pgen: %d lines, k=%d, %d unique k-mers, %d threads\n",
            nlines, k, node_count, nthreads);

    /* Phase 3/4 in parallel: each worker emits its own contig file. */
    for (t = 1; t < nthreads; t++) {
        if (pthread_create(&tids[t], NULL, worker, NULL) != 0) {
            fprintf(stderr, "pgen: cannot create thread %d\n", t);
            return 1;
        }
    }
    (void)worker(NULL);
    for (t = 1; t < nthreads; t++) pthread_join(tids[t], NULL);

    free(nodes); free(indeg); free(visited); free(buckets); free(tids);
    return 0;
}

#endif /* __UPC__ */
