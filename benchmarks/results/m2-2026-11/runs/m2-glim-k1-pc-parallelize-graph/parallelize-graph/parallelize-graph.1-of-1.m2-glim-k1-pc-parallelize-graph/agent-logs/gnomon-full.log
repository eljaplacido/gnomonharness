/* dbg.h -- de Bruijn graph construction and traversal core.
 *
 * Graph model (Georganas et al., SC'14, "Parallel de Bruijn graph
 * construction and traversal for de novo genome assembly"):
 *
 *   A node is a unique k-mer plus the single characters that extend it to
 *   the left and to the right.  succ(v) is the unique k-mer
 *   suffix(v) + rext(v); pred(v) is lext(v) + prefix(v).  Both are computed
 *   by hashing, which is what lets the graph be walked without storing any
 *   edge list.
 *
 *   Because succ(v) is a function, every node has at most one successor, so
 *   the graph is a disjoint union of
 *     - maximal non-branching paths, seeded at nodes that cannot be extended
 *       backwards (no predecessor), and
 *     - pure cycles, whose every node has a predecessor and which no path
 *       reaches; each cycle is emitted once, by its smallest-index node.
 *   A contig is one such path/cycle.  Paths seeded at distinct nodes are
 *   disjoint, so a thread walks a path without locking, and the set of
 *   contigs does not depend on the thread count.
 *
 * The including source file defines, BEFORE including this header, the
 * storage macros below.  That is the whole portability trick: the identical
 * algorithm text compiles against a plain array (serial), a mutex-guarded
 * array (pthread build) or a Berkeley UPC shared array (upcc build).
 *
 *   NODES(i)        lvalue, DNode at index i
 *   NODE_COUNT      lvalue int, number of live nodes
 *   BUCKETS(i)      lvalue int, head of bucket chain i, -1 = empty
 *   NBUCKETS        lvalue int, number of buckets
 *   INDEG(i)        lvalue int, 1 = node has a predecessor
 *   VISITED(i)      lvalue unsigned char
 *   INSERT_LOCK() / INSERT_UNLOCK()
 */
#ifndef DBG_H
#define DBG_H

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>

#include "dbg_types.h"

/* k-mer length and its 2-bits-per-base mask, defined once here so no
 * includer can disagree with the other. */
static int      db_k    = 0;
static uint64_t db_mask = 0;

static void db_set_k(int k)
{
    db_k = k;
    db_mask = (k >= 32) ? ~(uint64_t)0 : (((uint64_t)1 << (2 * k)) - 1);
}

static int db_base(int c)
{
    switch (c) {
    case 'A': case 'a': return 0;
    case 'C': case 'c': return 1;
    case 'G': case 'g': return 2;
    case 'T': case 't': return 3;
    }
    return -1;              /* 'F' (no extension) and anything else */
}

static char db_char(unsigned int b)
{
    static const char tbl[4] = { 'A', 'C', 'G', 'T' };
    return tbl[b & 3u];
}

static uint64_t db_hash(uint64_t x)
{
    x ^= x >> 33;
    x *= 0xff51afd7ed558ccdULL;
    x ^= x >> 33;
    x *= 0xc4ceb9fe1a85ec53ULL;
    x ^= x >> 33;
    return x;
}

/* decode a key into buf; writes db_k bases plus a terminating NUL */
static void db_decode(uint64_t key, char *buf)
{
    int i;
    for (i = db_k - 1; i >= 0; i--) {
        buf[i] = db_char((unsigned int)(key & 3ULL));
        key >>= 2;
    }
    buf[db_k] = '\0';
}

/* number of non-empty lines in path, -1 if the file cannot be opened */
static int db_count_lines(const char *path)
{
    FILE *f = fopen(path, "r");
    char  line[65536];
    int   n = 0;
    size_t len;

    if (!f) return -1;
    while (fgets(line, (int)sizeof line, f)) {
        len = strlen(line);
        while (len && (line[len - 1] == '\n' || line[len - 1] == '\r' ||
                       line[len - 1] == ' '  || line[len - 1] == '\t'))
            line[--len] = '\0';
        if (len) n++;
    }
    fclose(f);
    return n;
}

/* length of the first whitespace-delimited token, -1 on failure */
static int db_kmer_len(const char *path)
{
    FILE *f = fopen(path, "r");
    char  tok[65536];
    int   k = -1;

    if (!f) return -1;
    if (fscanf(f, "%65535s", tok) == 1) k = (int)strlen(tok);
    fclose(f);
    return k;
}

/* "<kmer>\t<L><R>" -> key / lext / rext.  0 on success, -1 if unusable. */
static int db_parse_line(const char *line, uint64_t *key,
                         unsigned char *lext, unsigned char *rext)
{
    const char *p = line;
    const char *t;
    uint64_t    kk = 0;
    int         i, b;

    if (db_k <= 0) return -1;
    while (*p == ' ' || *p == '\t') p++;
    t = p;
    while (*p && *p != ' ' && *p != '\t' && *p != '\n' && *p != '\r') p++;
    if (p - t != db_k) return -1;                 /* wrong k-mer length */
    for (i = 0; i < db_k; i++) {
        b = db_base((unsigned char)t[i]);
        if (b < 0) return -1;
        kk = (kk << 2) | (uint64_t)b;
    }
    while (*p == ' ' || *p == '\t') p++;
    if (!p[0] || !p[1] || p[0] == '\n' || p[0] == '\r') return -1;
    *key  = kk;
    *lext = (unsigned char)p[0];
    *rext = (unsigned char)p[1];
    return 0;
}

/* separate chaining lookup; -1 when the k-mer is not in the table */
static int db_lookup(uint64_t key)
{
    int n = BUCKETS((int)(db_hash(key) % (uint64_t)NBUCKETS));
    while (n >= 0) {
        if (NODES(n).key == key) return n;
        n = NODES(n).next;
    }
    return -1;
}

/* insert one k-mer; -1 if it was already present.  INSERT_LOCK covers
 * search + index allocation + chain append, so two threads inserting equal
 * or colliding k-mers cannot lose a link or duplicate a node. */
static int db_insert(uint64_t key, unsigned char lext, unsigned char rext)
{
    int b = (int)(db_hash(key) % (uint64_t)NBUCKETS);
    int n, idx;

    INSERT_LOCK();
    for (n = BUCKETS(b); n >= 0; n = NODES(n).next) {
        if (NODES(n).key == key) {
            INSERT_UNLOCK();
            return -1;
        }
    }
    idx = NODE_COUNT;
    NODE_COUNT = idx + 1;

    NODES(idx).key  = key;
    NODES(idx).lext = lext;
    NODES(idx).rext = rext;
    NODES(idx).next = BUCKETS(b);
    BUCKETS(b)      = idx;
    INSERT_UNLOCK();
    return idx;
}

static int db_succ(int i)
{
    unsigned char r = NODES(i).rext;
    int b = db_base(r);

    if (b < 0) return -1;                          /* 'F': no right extension */
    return db_lookup(((NODES(i).key << 2) & db_mask) | (uint64_t)b);
}

static int db_pred(int i)
{
    unsigned char l = NODES(i).lext;
    int b = db_base(l);

    if (b < 0) return -1;                          /* 'F': no left extension */
    return db_lookup(((uint64_t)b << (2 * (db_k - 1))) | (NODES(i).key >> 2));
}

/* Phase A: emit every maximal non-branching path exactly once.
 * start/stride partition the node indexes over threads (serial: 0/1). */
static void db_paths(FILE *out, int start, int stride, char *buf)
{
    int n = NODE_COUNT;
    int i;

    for (i = start; i < n; i += stride) {
        int cur, s, len;

        if (VISITED(i)) continue;
        if (INDEG(i) != 0) continue;        /* has a predecessor */
        cur = i;
        db_decode(NODES(cur).key, buf);
        len = db_k;
        VISITED(cur) = 1;
        for (;;) {
            s = db_succ(cur);
            if (s < 0 || s >= n) break;
            if (VISITED(s)) break;
            if (INDEG(s) != 0) break;       /* next node starts its own path */
            buf[len++] = db_char((unsigned int)(NODES(s).key & 3ULL));
            VISITED(s) = 1;
            cur = s;
            if (len >= n + db_k) break;
        }
        buf[len] = '\0';
        fputs(buf, out);
        fputc('\n', out);
    }
}

/* Phase B: emit pure cycles, each owned by its smallest-index node, so the
 * result does not depend on how many threads are running. */
static void db_cycles(FILE *out, int start, int stride, char *buf)
{
    int n = NODE_COUNT;
    int i;

    for (i = start; i < n; i += stride) {
        int j, mn, steps, cur, len;

        if (VISITED(i) || INDEG(i) != 1) continue;
        mn = i;
        j = i;
        steps = 0;
        for (;;) {
            j = db_succ(j);
            if (j < 0 || j >= n) break;
            steps++;
            if (j < mn) mn = j;
            if (j == i || steps > n) break;
        }
        if (j != i || mn != i) continue;    /* not a cycle, or another owner */

        cur = i;
        db_decode(NODES(cur).key, buf);
        len = db_k;
        VISITED(cur) = 1;
        for (;;) {
            cur = db_succ(cur);
            if (cur < 0 || cur >= n || cur == i || VISITED(cur)) break;
            buf[len++] = db_char((unsigned int)(NODES(cur).key & 3ULL));
            VISITED(cur) = 1;
            if (len >= n + db_k) break;
        }
        buf[len] = '\0';
        fputs(buf, out);
        fputc('\n', out);
    }
}

#endif /* DBG_H */
EOF
