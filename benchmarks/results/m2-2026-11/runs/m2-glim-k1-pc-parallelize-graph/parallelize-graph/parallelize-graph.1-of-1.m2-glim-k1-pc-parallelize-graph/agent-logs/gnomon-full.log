[approval] bash: cat > Makefile <<'EOF'
# Builds both halves of the de Bruijn assembler.
#
#   serial : reference single-threaded C build, writes /app/serial.out
#   pgen   : parallel build.  When Berkeley UPC (upcc) is on PATH this is a
#            real UPC program compiled from pgen.c and run with
#              upcrun -n <threads> -shared-heap 256MB ./pgen test
#            Without upcc the same source compiles with -pthread (the
#            portable fallback) and is run with PGEN_THREADS=<threads>.
#
#   make          both executables
#   make run      build, then run both on ./test -> /app/*.out
#   make check    build, run, and compare the contig sets

CC        ?= gcc
CFLAGS    ?= -O2 -std=gnu99 -Wall -Wextra
UPCFLAGS  ?= -O2
INCS       = -Ilib
HEADERS    = lib/dbg.h lib/dbg_types.h
THREADS   ?= 4
INPUT     ?= test

UPC        = $(shell command -v upcc 2>/dev/null)
HAVE_UPC   = $(if $(UPC),yes,no)

all: serial pgen

serial: serial.c $(HEADERS)
	$(CC) $(CFLAGS) $(INCS) -o $@ serial.c

ifeq ($(HAVE_UPC),yes)
pgen: pgen.c $(HEADERS)
	upcc $(UPCFLAGS) $(INCS) -o $@ pgen.c
else
pgen: pgen.c $(HEADERS)
	$(CC) $(CFLAGS) -pthread $(INCS) -o $@ pgen.c
endif

run: all
	./serial $(INPUT) /app/serial.out
ifeq ($(HAVE_UPC),yes)
	upcrun -n $(THREADS) -shared-heap 256MB ./pgen $(INPUT) /app/pgen
else
	PGEN_THREADS=$(THREADS) ./pgen $(INPUT) /app/pgen
endif

check: run
	sort /app/serial.out -o /app/.serial.sorted
	sort /app/pgen_*.out -o /app/.pgen.sorted
	diff -u /app/.serial.sorted /app/.pgen.sorted && echo "CHECK OK: contigs identical"

clean:
	rm -f serial pgen /app/serial.out /app/pgen_*.out

.PHONY: all run check clean
EOF
