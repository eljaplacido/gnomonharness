/* serial.c -- reference implementation: one thread, plain arrays.
 * Writes every contig to /app/serial.out (override with argv[2]). */
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>

#include "dbg_types.h"

static DNode *nodes;
static int    node_count = 0;
static int   *buckets;
static int    nbuckets = 0;
static int   *indeg;
static unsigned char *visited;

#define NODES(i)      (nodes[i])
#define NODE_COUNT    (node_count)
#define BUCKETS(i)    (buckets[i])
#define NBUCKETS      (nbuckets)
#define INDEG(i)      (indeg[i])
#define VISITED(i)    (visited[i])
#define INSERT_LOCK()   do { } while (0)
#define INSERT_UNLOCK() do { } while (0)

#include "dbg.h"

#define DEFAULT_INPUT  "test"
#define DEFAULT_OUTPUT "/app/serial.out"

int main(int argc, char **argv)
{
    const char *in  = (argc > 1) ? argv[1] : DEFAULT_INPUT;
    const char *outpath = (argc > 2) ? argv[2] : DEFAULT_OUTPUT;
    int  nlines, k, i, len;
    long nvalid = 0;
    FILE *f, *out;
    char *buf, line[65536];
    uint64_t key;
    unsigned char l, r;

    nlines = db_count_lines(in);
    if (nlines <= 0) {
        fprintf(stderr, "serial: cannot read input \"%s\"\n", in);
        return 1;
    }
    k = db_kmer_len(in);
    if (k <= 0 || k > 31) {
        fprintf(stderr, "serial: bad k-mer length %d (must be 1..31)\n", k);
        return 1;
    }
    db_set_k(k);

    nodes   = (DNode *)malloc(sizeof(DNode) * (size_t)(nlines + 1));
    indeg   = (int *)malloc(sizeof(int) * (size_t)(nlines + 1));
    visited = (unsigned char *)calloc((size_t)(nlines + 1), 1);
    nbuckets = nlines / 2 + 1;
    buckets = (int *)malloc(sizeof(int) * (size_t)nbuckets);
    if (!nodes || !indeg || !visited || !buckets) {
        fprintf(stderr, "serial: out of memory\n");
        return 1;
    }
    for (i = 0; i < nbuckets; i++) buckets[i] = -1;

    /* Phase 1 -- build: hash every unique k-mer into a node. */
    f = fopen(in, "r");
    if (!f) { fprintf(stderr, "serial: cannot open \"%s\"\n", in); return 1; }
    while (fgets(line, (int)sizeof line, f)) {
        if (db_parse_line(line, &key, &l, &r) == 0) {
            if (db_insert(key, l, r) >= 0) nvalid++;
        }
    }
    fclose(f);

    /* Phase 2 -- indegree: a node has one iff its predecessor exists. */
    for (i = 0; i < node_count; i++)
        indeg[i] = (db_pred(i) >= 0) ? 1 : 0;

    /* Phases 3 and 4 -- traversal. */
    len = node_count + k + 2;
    buf = (char *)malloc((size_t)len);
    if (!buf) { fprintf(stderr, "serial: out of memory\n"); return 1; }
    out = fopen(outpath, "w");
    if (!out) {
        fprintf(stderr, "serial: cannot write \"%s\"\n", outpath);
        return 1;
    }
    db_paths(out, 0, 1, buf);
    db_cycles(out, 0, 1, buf);
    fclose(out);

    fprintf(stderr, "serial: %d lines, k=%d, %d unique k-mers, %ld inserted\n",
            nlines, k, node_count, nvalid);
    free(nodes); free(indeg); free(visited); free(buckets); free(buf);
    return 0;
}
