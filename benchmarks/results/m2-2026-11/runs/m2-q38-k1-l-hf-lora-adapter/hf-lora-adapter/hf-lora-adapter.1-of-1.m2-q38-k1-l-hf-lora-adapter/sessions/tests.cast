[15.669817, "o", "9;49;00m\r\n                logger.warning(\u001b[90m\u001b[39;49;00m\r\n                    \u001b[33m\"\u001b[39;49;00m\u001b[33mThe tokenizer class you load from this checkpoint is not the same type as the class this\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n                    \u001b[33m\"\u001b[39;49;00m\u001b[33m function is called from. It may result in unexpected tokenization. \u001b[39;49;00m\u001b[33m\\n\u001b[39;49;00m\u001b[33mThe tokenizer class you\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n                    \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m load from this checkpoint is \u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33m{\u001b[39;49;00mconfig_tokenizer_class\u001b[33m}\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33m. \u001b[39;49;00m\u001b[33m\\n\u001b[39;49;00m\u001b[33mThe class this function is called\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n                    \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m from is \u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33m{\u001b[39;49;00m\u001b[96mcls\u001b[39;49;00m.\u001b[91m__name__\u001b[39;49;00m\u001b[33m}\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33m.\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n                )\u001b[90m\u001b"]
[15.669841, "o", "[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[90m# Update with newly provided kwargs\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        init_kwargs.update(kwargs)\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[90m# Merge resolved_vocab_files arguments in init_kwargs.\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        added_tokens_file = resolved_vocab_files.pop(\u001b[33m\"\u001b[39;49;00m\u001b[33madded_tokens_file\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[94mNone\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n        special_tokens_map_file = resolved_vocab_files.pop(\u001b[33m\"\u001b[39;49;00m\u001b[33mspecial_tokens_map_file\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[94mNone\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n        \u001b[94mfor\u001b[39;49;00m args_name, file_path \u001b[95min\u001b[39;49;00m resolved_vocab_files.items():\u001b[90m\u001b[39;49;00m\r\n            \u001b[94mif\u001b[39;49;00m args_name \u001b[95mnot\u001b[39;49;00m \u001b[95min\u001b[39;49;00m init_kwargs:\u001b[90m\u001b[39;49;00m\r\n                init_kwargs[args_name] = file_path\u001b[90m\u001b[39;49;00m\r\n        tokenizer_file = resolved_vocab_files.pop(\u001b[33m\"\u001b[39;49;00m\u001b[33mtokenizer_file\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, "]
[15.66985, "o", "\u001b[94mNone\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[94mif\u001b[39;49;00m slow_tokenizer \u001b[95mis\u001b[39;49;00m \u001b[95mnot\u001b[39;49;00m \u001b[94mNone\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\r\n            init_kwargs[\u001b[33m\"\u001b[39;49;00m\u001b[33m__slow_tokenizer\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m] = slow_tokenizer\u001b[90m\u001b[39;49;00m\r\n        init_kwargs[\u001b[33m\"\u001b[39;49;00m\u001b[33mname_or_path\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m] = pretrained_model_name_or_path\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[90m#### Handle tokenizer serialization of added and special tokens\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        added_tokens_decoder: Dict[\u001b[96mint\u001b[39;49;00m, AddedToken] = {}\u001b[90m\u001b[39;49;00m\r\n        added_tokens_map: Dict[\u001b[96mstr\u001b[39;49;00m, AddedToken] = {}\u001b[90m\u001b[39;49;00m\r\n        \u001b[90m# if we have info on the slow added tokens\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        \u001b[94mif\u001b[39;49;00m \u001b[33m\"\u001b[39;49;00m\u001b[33madded_tokens_decoder\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m \u001b[95min\u001b[39;49;00m init_kwargs:\u001b[90m\u001b[39;49;00m\r\n            \u001b[94mfor\u001b[39;49;00m idx, token \u001b[95min"]
[15.669877, "o", "\u001b[39;49;00m init_kwargs[\u001b[33m\"\u001b[39;49;00m\u001b[33madded_tokens_decoder\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m].items():\u001b[90m\u001b[39;49;00m\r\n                \u001b[94mif\u001b[39;49;00m \u001b[96misinstance\u001b[39;49;00m(token, \u001b[96mdict\u001b[39;49;00m):\u001b[90m\u001b[39;49;00m\r\n                    token = AddedToken(**token)\u001b[90m\u001b[39;49;00m\r\n                \u001b[94mif\u001b[39;49;00m \u001b[96misinstance\u001b[39;49;00m(token, AddedToken):\u001b[90m\u001b[39;49;00m\r\n                    added_tokens_decoder[\u001b[96mint\u001b[39;49;00m(idx)] = token\u001b[90m\u001b[39;49;00m\r\n                    added_tokens_map[\u001b[96mstr\u001b[39;49;00m(token)] = token\u001b[90m\u001b[39;49;00m\r\n                \u001b[94melse\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\r\n                    \u001b[94mraise\u001b[39;49;00m \u001b[96mValueError\u001b[39;49;00m(\u001b[90m\u001b[39;49;00m\r\n                        \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mFound a \u001b[39;49;00m\u001b[33m{\u001b[39;49;00mtoken.\u001b[91m__class__\u001b[39;49;00m\u001b[33m}\u001b[39;49;00m\u001b[33m in the saved `added_tokens_decoder`, should be a dictionary or an AddedToken instance\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n                    )"]
[15.669903, "o", "\u001b[90m\u001b[39;49;00m\r\n        \u001b[94melse\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\r\n            \u001b[90m# begin legacy: read the added_tokens_file and update kwargs with special_tokens_map if modified\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n            \u001b[94mif\u001b[39;49;00m special_tokens_map_file \u001b[95mis\u001b[39;49;00m \u001b[95mnot\u001b[39;49;00m \u001b[94mNone\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\r\n                \u001b[94mwith\u001b[39;49;00m \u001b[96mopen\u001b[39;49;00m(special_tokens_map_file, encoding=\u001b[33m\"\u001b[39;49;00m\u001b[33mutf-8\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m) \u001b[94mas\u001b[39;49;00m special_tokens_map_handle:\u001b[90m\u001b[39;49;00m\r\n                    special_tokens_map = json.load(special_tokens_map_handle)\u001b[90m\u001b[39;49;00m\r\n                    \u001b[94mfor\u001b[39;49;00m key, value \u001b[95min\u001b[39;49;00m special_tokens_map.items():\u001b[90m\u001b[39;49;00m\r\n                        \u001b[94mif\u001b[39;49;00m key \u001b[95min\u001b[39;49;00m kwargs \u001b[95mand\u001b[39;49;00m kwargs[key]:\u001b[90m\u001b[39;49;00m\r\n                            \u001b[90m# This value has already been redefined by the kwargs\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n                        "]
[15.669928, "o", "    \u001b[90m# We keep this new value and ignore the one stored in the special_tokens_map_file\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n                            \u001b[94mcontinue\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n                        \u001b[94mif\u001b[39;49;00m \u001b[96misinstance\u001b[39;49;00m(value, \u001b[96mdict\u001b[39;49;00m):\u001b[90m\u001b[39;49;00m\r\n                            value[\u001b[33m\"\u001b[39;49;00m\u001b[33mspecial\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m] = \u001b[94mTrue\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n                            value = AddedToken(**value)\u001b[90m\u001b[39;49;00m\r\n                        \u001b[94melif\u001b[39;49;00m key == \u001b[33m\"\u001b[39;49;00m\u001b[33madditional_special_tokens\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m \u001b[95mand\u001b[39;49;00m \u001b[96misinstance\u001b[39;49;00m(value, \u001b[96mlist\u001b[39;49;00m):\u001b[90m\u001b[39;49;00m\r\n                            additional_special_tokens = init_kwargs.pop(\u001b[33m\"\u001b[39;49;00m\u001b[33madditional_special_tokens\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, []) \u001b[95mor\u001b[39;49;00m []\u001b[90m\u001b[39;49;00m\r\n                            \u001b[94mfor\u001b[39;49;00m token \u001b[95min\u001b[39;49;00m value:\u001b[90m\u001b[39;49;00m\r\n "]
[15.669952, "o", "                               \u001b[94mif\u001b[39;49;00m \u001b[96misinstance\u001b[39;49;00m(token, \u001b[96mdict\u001b[39;49;00m):\u001b[90m\u001b[39;49;00m\r\n                                    token[\u001b[33m\"\u001b[39;49;00m\u001b[33mspecial\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m] = \u001b[94mTrue\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n                                    token = AddedToken(**token)\u001b[90m\u001b[39;49;00m\r\n                                \u001b[94mif\u001b[39;49;00m token \u001b[95mnot\u001b[39;49;00m \u001b[95min\u001b[39;49;00m additional_special_tokens:\u001b[90m\u001b[39;49;00m\r\n                                    additional_special_tokens.append(token)\u001b[90m\u001b[39;49;00m\r\n                            value = additional_special_tokens\u001b[90m\u001b[39;49;00m\r\n                        init_kwargs[key] = value\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n            \u001b[90m# slow -> slow|fast, legacy: convert the `\"added_tokens.json\"` file to `added_tokens_decoder`.\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n            \u001b[90m# this is for legacy purpose. We don't add the tokens after init for efficiency.\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n            "]
[15.669978, "o", "\u001b[94mif\u001b[39;49;00m added_tokens_file \u001b[95mis\u001b[39;49;00m \u001b[95mnot\u001b[39;49;00m \u001b[94mNone\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\r\n                special_tokens = []\u001b[90m\u001b[39;49;00m\r\n                \u001b[94mfor\u001b[39;49;00m key \u001b[95min\u001b[39;49;00m \u001b[96mcls\u001b[39;49;00m.SPECIAL_TOKENS_ATTRIBUTES & init_kwargs.keys():\u001b[90m\u001b[39;49;00m\r\n                    \u001b[94mif\u001b[39;49;00m init_kwargs[key] \u001b[95mis\u001b[39;49;00m \u001b[95mnot\u001b[39;49;00m \u001b[94mNone\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\r\n                        \u001b[94mif\u001b[39;49;00m key == \u001b[33m\"\u001b[39;49;00m\u001b[33madditional_special_tokens\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\r\n                            special_tokens += [\u001b[96mstr\u001b[39;49;00m(token) \u001b[94mfor\u001b[39;49;00m token \u001b[95min\u001b[39;49;00m init_kwargs[key]]\u001b[90m\u001b[39;49;00m\r\n                        \u001b[94melse\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\r\n                            special_tokens.append(\u001b[96mstr\u001b[39;49;00m(init_kwargs[key]))\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n                \u001b[94mwith\u001b[39;49;00m \u001b[96mopen\u001b[39;49;00m(added_tokens_file, encoding=\u001b[3"]
[15.670003, "o", "3m\"\u001b[39;49;00m\u001b[33mutf-8\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m) \u001b[94mas\u001b[39;49;00m added_tokens_handle:\u001b[90m\u001b[39;49;00m\r\n                    added_tok_encoder = json.load(added_tokens_handle)\u001b[90m\u001b[39;49;00m\r\n                \u001b[94mfor\u001b[39;49;00m str_token, index \u001b[95min\u001b[39;49;00m added_tok_encoder.items():\u001b[90m\u001b[39;49;00m\r\n                    \u001b[90m# if index not in added_tokens_decoder and str_token not in added_tokens_map:\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n                    special = str_token \u001b[95min\u001b[39;49;00m special_tokens\u001b[90m\u001b[39;49;00m\r\n                    added_tokens_decoder[index] = AddedToken(\u001b[90m\u001b[39;49;00m\r\n                        str_token, rstrip=\u001b[94mFalse\u001b[39;49;00m, lstrip=\u001b[94mFalse\u001b[39;49;00m, normalized=\u001b[95mnot\u001b[39;49;00m special, special=special\u001b[90m\u001b[39;49;00m\r\n                    )\u001b[90m\u001b[39;49;00m\r\n                    added_tokens_map[\u001b[96mstr\u001b[39;49;00m(token)] = added_tokens_decoder[index]\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n            \u001b[90m# allows converting a fast -> slow: add the `token"]
[15.670027, "o", "izer.json`'s `\"added_tokens\"` to the slow tokenizer\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n            \u001b[90m# if `tokenizer_config.json` is `None`\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n            \u001b[94mif\u001b[39;49;00m tokenizer_file \u001b[95mis\u001b[39;49;00m \u001b[95mnot\u001b[39;49;00m \u001b[94mNone\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\r\n                \u001b[90m# This is for slow so can be done before\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n                \u001b[94mwith\u001b[39;49;00m \u001b[96mopen\u001b[39;49;00m(tokenizer_file, encoding=\u001b[33m\"\u001b[39;49;00m\u001b[33mutf-8\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m) \u001b[94mas\u001b[39;49;00m tokenizer_file_handle:\u001b[90m\u001b[39;49;00m\r\n                    tokenizer_file_handle = json.load(tokenizer_file_handle)\u001b[90m\u001b[39;49;00m\r\n                    added_tokens = tokenizer_file_handle.pop(\u001b[33m\"\u001b[39;49;00m\u001b[33madded_tokens\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n                \u001b[94mfor\u001b[39;49;00m serialized_tokens \u001b[95min\u001b[39;49;00m added_tokens:\u001b[90m\u001b[39;49;00m\r\n                    idx = serialized_tokens.pop(\u001b[33m\"\u001b[39;49;00m\u001b[33mid\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b"]
[15.670051, "o", "[39;49;00m\r\n                    added_tokens_decoder[idx] = AddedToken(**serialized_tokens)\u001b[90m\u001b[39;49;00m\r\n                    added_tokens_map[\u001b[96mstr\u001b[39;49;00m(added_tokens_decoder[idx])] = added_tokens_decoder[idx]\u001b[90m\u001b[39;49;00m\r\n            \u001b[90m# end legacy\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[90m# Passing AddedTokens and not strings to the class to prevent it from casting the string to a different AddedToken\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        \u001b[90m# convert {'__type': 'AddedToken', 'content': '<ent>', 'lstrip': False, 'normalized': True, ...} to AddedTokens\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        init_kwargs[\u001b[33m\"\u001b[39;49;00m\u001b[33madded_tokens_decoder\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m] = added_tokens_decoder\u001b[90m\u001b[39;49;00m\r\n        init_kwargs = \u001b[96mcls\u001b[39;49;00m.convert_added_tokens(init_kwargs, save=\u001b[94mFalse\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n        \u001b[94mfor\u001b[39;49;00m key \u001b[95min\u001b[39;49;00m \u001b[96mcls\u001b[39;49;00m.SPECIAL_TOKENS_ATTRIBUTES & init_kwargs.keys():\u001b[90m\u001b[39;49;00m\r\n       "]
[15.670076, "o", "     \u001b[94mif\u001b[39;49;00m added_tokens_map != {} \u001b[95mand\u001b[39;49;00m init_kwargs[key] \u001b[95mis\u001b[39;49;00m \u001b[95mnot\u001b[39;49;00m \u001b[94mNone\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\r\n                \u001b[94mif\u001b[39;49;00m key != \u001b[33m\"\u001b[39;49;00m\u001b[33madditional_special_tokens\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\r\n                    init_kwargs[key] = added_tokens_map.get(\u001b[96mstr\u001b[39;49;00m(init_kwargs[key]), init_kwargs[key])\u001b[90m\u001b[39;49;00m"]
[15.67028, "o", "\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[90m# Instantiate the tokenizer.\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        \u001b[94mtry\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\r\n>           tokenizer = \u001b[96mcls\u001b[39;49;00m(*init_inputs, **init_kwargs)\u001b[90m\u001b[39;49;00m\r\n                        ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\u001b[90m\u001b[39;49;00m\r\n\r\n"]
