[15.671363, "o", "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mconvert_slow_tokenizer\u001b[39;49;00m(transformer_tokenizer, from_tiktoken=\u001b[94mFalse\u001b[39;49;00m) -> Tokenizer:\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"\u001b[39;49;00m\r\n    \u001b[33m    Utilities to convert a slow tokenizer instance in a fast tokenizer instance.\u001b[39;49;00m\r\n    \u001b[33m\u001b[39;49;00m\r\n    \u001b[33m    Args:\u001b[39;49;00m\r\n    \u001b[33m        transformer_tokenizer ([`~tokenization_utils_base.PreTrainedTokenizer`]):\u001b[39;49;00m\r\n    \u001b[33m            Instance of a slow tokenizer to convert in the backend tokenizer for\u001b[39;49;00m\r\n    \u001b[33m            [`~tokenization_utils_base.PreTrainedTokenizerFast`].\u001b[39;49;00m\r\n    \u001b[33m       from_tiktoken (bool, optional): Whether to use the `tiktoken` library to convert the tokenizer instead of sentencepiece.\u001b[39;49;00m\r\n    \u001b[33m            Defaults to False.\u001b[39;49;00m\r\n    \u001b[33m\u001b[39;49;00m\r\n    \u001b[33m    Return:\u001b[39;49;00m\r\n    \u001b[33m        A instance of [`~tokenizers.Tokenizer`] to be used as the backend tokenizer of a\u001b[39;"]
[15.671368, "o", "49;00m\r\n    \u001b[33m        [`~tokenization_utils_base.PreTrainedTokenizerFast`]\u001b[39;49;00m\r\n    \u001b[33m    \"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        tokenizer_class_name = transformer_tokenizer.\u001b[91m__class__\u001b[39;49;00m.\u001b[91m__name__\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        \u001b[94mif\u001b[39;49;00m tokenizer_class_name \u001b[95min\u001b[39;49;00m SLOW_TO_FAST_CONVERTERS \u001b[95mand\u001b[39;49;00m \u001b[95mnot\u001b[39;49;00m from_tiktoken:\u001b[90m\u001b[39;49;00m\r\n            converter_class = SLOW_TO_FAST_CONVERTERS[tokenizer_class_name]\u001b[90m\u001b[39;49;00m\r\n            \u001b[94mreturn\u001b[39;49;00m converter_class(transformer_tokenizer).converted()\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[94melse\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\r\n            \u001b[94mtry\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\r\n                logger.info(\u001b[33m\"\u001b[39;49;00m\u001b[33mConverting from Tiktoken\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n                \u001b[94mreturn\u001b[39;49;00m TikTokenConverter(\u001b[90m\u001b[39;49;00m\r\n                    vocab_file=transformer_tokenizer.vocab_file,\u001b[90m\u001b[3"]
[15.671395, "o", "9;49;00m\r\n                    additional_special_tokens=transformer_tokenizer.additional_special_tokens,\u001b[90m\u001b[39;49;00m\r\n                ).converted()\u001b[90m\u001b[39;49;00m\r\n            \u001b[94mexcept\u001b[39;49;00m \u001b[96mException\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\r\n>               \u001b[94mraise\u001b[39;49;00m \u001b[96mValueError\u001b[39;49;00m(\u001b[90m\u001b[39;49;00m\r\n                    \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mConverting from SentencePiece and Tiktoken failed, if a converter for SentencePiece is available, provide a model path \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n                    \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mwith a SentencePiece tokenizer.model file.\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n                    \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mCurrently available slow->fast converters: \u001b[39;49;00m\u001b[33m{\u001b[39;49;00m\u001b[96mlist\u001b[39;49;00m(SLOW_TO_FAST_CONVERTERS.keys())\u001b[33m}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n                )\u001b[90m\u001b[39;49;00m\r\n\u001b[1m\u001b[31mE               ValueError: Converting from "]
