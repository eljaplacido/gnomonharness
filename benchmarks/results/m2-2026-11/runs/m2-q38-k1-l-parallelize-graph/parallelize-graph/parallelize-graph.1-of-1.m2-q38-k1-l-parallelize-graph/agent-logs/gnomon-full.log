#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>
#include <time.h>
#define KMER_LEN 19
#define KMER_BUF 24
#define MAX_EDGES 1000000
typedef struct { char key[KMER_BUF]; int idx; int next; } Node;
typedef struct { int from; int to; int next; } Edge;
static Node nodes[MAX_EDGES]; static int n_nodes=0;
static Edge edges[MAX_EDGES]; static int n_edges=0;
static int *node_table, *edge_table; static int node_cap, edge_cap;
static uint64_t hash_str(const char*s){uint64_t h=1469598103934665603ULL;while(*s)h=(h^(unsigned char)*s++)*1099511628211ULL;return h;}
static uint64_t hash_edge(int a,int b){uint64_t h=1469598103934665603ULL;h=(h^(uint64_t)(a+0x9e3779b9))*1099511628211ULL;h=(h^(uint64_t)(b+0x85ebca6b))*1099511628211ULL;return h;}
static int find_node(const char*k){uint64_t h=hash_str(k);int b=(int)(h%node_cap);for(int i=node_table[b];i!=-1;i=nodes[i].next)if(strcmp(nodes[i].key,k)==0)return i;return -1;}
static int insert_node(const char*k){int i=n_nodes++;memcpy(nodes[i].key,k,KMER_LEN+1);nodes[i].idx=i;uint64_t h=hash_str(k);int b=(int)(h%node_cap);nodes[i].next=node_table[b];node_table[b]=i;return i;}
static int find_edge(int a,int b){uint64_t h=hash_edge(a,b);int e=(int)(h%edge_cap);for(int i=edge_table[e];i!=-1;i=edges[i].next)if(edges[i].from==a&&edges[i].to==b)return i;return -1;}
static int insert_edge(int a,int b){int i=n_edges++;edges[i].from=a;edges[i].to=b;uint64_t h=hash_edge(a,b);int e=(int)(h%edge_cap);edges[i].next=edge_table[e];edge_table[e]=i;return i;}
static void succ_kmer(const char*k,char c,char*out){memmove(out,k+1,KMER_LEN-1);out[KMER_LEN-1]=c;out[KMER_LEN]='\0';}
static void pred_kmer(char c,const char*k,char*out){out[0]=c;memcpy(out+1,k,KMER_LEN-1);out[KMER_LEN]='\0';}
int main(void){
  node_cap=edge_cap=1<<17;
  node_table=calloc(node_cap,sizeof(int));edge_table=calloc(edge_cap,sizeof(int));
  memset(node_table,-1,sizeof(int)*node_cap);memset(edge_table,-1,sizeof(int)*edge_cap);
  FILE*in=fopen("/app/test","r");char line[128];
  double t0=0,t1=0,t2=0,t3=0;
  while(fgets(line,sizeof(line),in)){
    char kmer[KMER_BUF],l,r;
    if(sscanf(line,"%19s %c %c",kmer,&l,&r)!=3)continue;
    double a=clock();
    int me=find_node(kmer); if(me<0)me=insert_node(kmer);
    double b=clock();
    if(r!='F'){char sk[KMER_BUF];succ_kmer(kmer,r,sk);int to=find_node(sk);if(to<0)to=insert_node(sk);if(find_edge(me,to)<0)insert_edge(me,to);}
    double c=clock();
    if(l!='F'){char pk[KMER_BUF];pred_kmer(l,kmer,pk);int from=find_node(pk);if(from<0)from=insert_node(pk);if(find_edge(from,me)<0)insert_edge(from,me);}
    double d=clock();
    t0+=b-a;t1+=c-b;t2+=d-c;t3+=d-a;
  }
  printf("find_node=%.3f succ_edge=%.3f pred_edge=%.3f total=%.3f nodes=%d edges=%d\n",t0,t1,t2,t3,n_nodes,n_edges);
  return 0;
}
