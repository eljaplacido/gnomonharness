#include <stdio.h>
#include <stdlib.h>
#include <stdint.h>

#define FIB_BASE 1000000000u

static void fib_print(long n)
{
    long i, j, la, lb, lc;
    unsigned long long carry, s;
    uint32_t *a, *b, *c, *t;
    long cap;

    if (n == 0) {
        printf("0\n");
        return;
    }

    cap = n / 36 + 4;
    a = (uint32_t *)calloc((size_t)cap, sizeof(uint32_t));
    b = (uint32_t *)calloc((size_t)cap, sizeof(uint32_t));
    c = (uint32_t *)calloc((size_t)cap, sizeof(uint32_t));
    if (a == NULL || b == NULL || c == NULL) {
        fprintf(stderr, "out of memory\n");
        exit(1);
    }

    b[0] = 1;
    la = 1;
    lb = 1;

    for (i = 0; i < n; i++) {
        lc = (la > lb ? la : lb) + 1;
        carry = 0;
        for (j = 0; j < lc; j++) {
            s = carry;
            if (j < la) s += a[j];
            if (j < lb) s += b[j];
            c[j] = (uint32_t)(s % FIB_BASE);
            carry = s / FIB_BASE;
        }
        while (lc > 1 && c[lc - 1] == 0) lc--;
        t = a;
        a = b;
        b = c;
        c = t;
        la = lb;
        lb = lc;
    }

    printf("%u", (unsigned)a[la - 1]);
    for (i = la - 2; i >= 0; i--) printf("%09u", (unsigned)a[i]);
    printf("\n");

    free(a);
    free(b);
    free(c);
}

int main(int argc, char **argv)
{
    char *end;
    long n;

    if (argc < 2) {
        fprintf(stderr, "usage: %s N\n", argv[0]);
        return 2;
    }
    end = NULL;
    n = strtol(argv[1], &end, 10);
    if (end == argv[1] || n < 0) {
        fprintf(stderr, "N must be a non-negative integer\n");
        return 2;
    }
    fib_print(n);
    return 0;
}

