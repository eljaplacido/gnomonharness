import smtplib, mailbox, time, sys
from email.mime.text import MIMEText

DOMAIN='local.edu'; USER='mtest2'
JOIN='reading-group-join@local.edu'
MBOX=f'/var/mail/{USER}'

def send(frm,to,subj='',body=''):
    m=MIMEText(body); m['Subject']=subj; m['From']=frm; m['To']=to
    with smtplib.SMTP('localhost',25) as s: s.send_message(m)
