[279.635502, "o", "(\u001b[91m__file__\u001b[39;49;00m), \u001b[33m\"\u001b[39;49;00m\u001b[33mtest.json\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n        \u001b[94massert\u001b[39;49;00m os.path.exists(test_data_path), \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mTest data not found at \u001b[39;49;00m\u001b[33m{\u001b[39;49;00mtest_data_path\u001b[33m}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[94mwith\u001b[39;49;00m \u001b[96mopen\u001b[39;49;00m(test_data_path) \u001b[94mas\u001b[39;49;00m f:\u001b[90m\u001b[39;49;00m\r\n            test_data = json.load(f)\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[94massert\u001b[39;49;00m \u001b[96mlen\u001b[39;49;00m(test_data) == \u001b[94m100\u001b[39;49;00m, \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mExpected 100 test samples, got \u001b[39;49;00m\u001b[33m{\u001b[39;49;00m\u001b[96mlen\u001b[39;49;00m(test_data)\u001b[33m}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        base_model = AutoModelForCausalLM.from_pretrained(\u001b[90m\u001b[39;49;00m\r\n            base_model_name,\u001b[90m\u001b[39;49;00m\r\n            torch_dtype=torch.float32,\u001b[90m\u001b[39;49;00m\r\n            device_map=\u001b[33m\"\u001b"]
