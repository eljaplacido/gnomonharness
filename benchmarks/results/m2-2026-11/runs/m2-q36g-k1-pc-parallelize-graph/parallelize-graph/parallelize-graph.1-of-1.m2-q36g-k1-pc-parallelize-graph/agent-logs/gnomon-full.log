#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>

#define MAX_K 64
#define MAX_LINE 4096

typedef struct {
    char kmer[MAX_K];
    char lext;
    char rext;
} Node;

typedef struct Bucket {
    Node node;
    int next;
} Bucket;

static Bucket *buckets;
static int nbuckets;
static int nrec;
static int *visited;

static uint32_t fnv1a(const char *s, int k)
{
    uint32_t h = 2166136261u;
    for (int i = 0; i < k; i++) {
        h ^= (unsigned char)s[i];
        h *= 16777619u;
    }
    return h;
}

static int insert(const char *kmer, char lext, char rext)
{
    uint32_t h = fnv1a(kmer, strlen(kmer));
    int b = h % nbuckets;
    int cur = buckets[b].next;
    while (cur != -1) {
        if (strcmp(buckets[cur].node.kmer, kmer) == 0)
            return -1;
        cur = buckets[cur].next;
    }
    int idx = nrec++;
    memcpy(buckets[idx].node.kmer, kmer, strlen(kmer) + 1);
    buckets[idx].node.lext = lext;
    buckets[idx].node.rext = rext;
    buckets[idx].next = buckets[b].next;
    buckets[b].next = idx;
    return idx;
}

static int lookup(const char *kmer)
{
    uint32_t h = fnv1a(kmer, strlen(kmer));
    int b = h % nbuckets;
    int cur = buckets[b].next;
    while (cur != -1) {
        if (strcmp(buckets[cur].node.kmer, kmer) == 0)
            return cur;
        cur = buckets[cur].next;
    }
    return -1;
}

static int succ(int u, int k)
{
    if (buckets[u].node.rext == 'F') return -1;
    char q[MAX_K];
    memcpy(q, buckets[u].node.kmer + 1, k - 1);
    q[k - 1] = buckets[u].node.rext;
    q[k] = '\0';
    return lookup(q);
}

static int pred(int v, int k)
{
    if (buckets[v].node.lext == 'F') return -1;
    char p[MAX_K];
    p[0] = buckets[v].node.lext;
    memcpy(p + 1, buckets[v].node.kmer, k - 1);
    p[k] = '\0';
    int pi = lookup(p);
    if (pi == -1) return -1;
    if (buckets[pi].node.rext != buckets[v].node.kmer[k - 1])
        return -1;
    return pi;
}

int main(int argc, char **argv)
{
    if (argc < 2) { fprintf(stderr, "Usage: %s <file>\n", argv[0]); return 1; }
    FILE *fin = fopen(argv[1], "r");
    if (!fin) { perror(argv[1]); return 1; }

    char line[MAX_LINE];
    int nlines = 0, k = 0;
    while (fgets(line, sizeof(line), fin)) {
        int len = strlen(line);
        while (len > 0 && (line[len-1] == '\n' || line[len-1] == '\r')) line[--len] = '\0';
        if (len == 0) continue;
        char *tab = strchr(line, '\t');
        if (!tab) continue;
        *tab = '\0';
        if (k == 0) k = strlen(line);
        nlines++;
    }
    rewind(fin);

    int capacity = 1;
    while (capacity < 2 * nlines) capacity <<= 1;
    nbuckets = capacity;
    buckets = calloc(nbuckets + nlines, sizeof(Bucket));
    nrec = 0;

    while (fgets(line, sizeof(line), fin)) {
        int len = strlen(line);
        while (len > 0 && (line[len-1] == '\n' || line[len-1] == '\r')) line[--len] = '\0';
        if (len == 0) continue;
        char *tab = strchr(line, '\t');
        if (!tab) continue;
        *tab = '\0';
        char *kmer = line;
        char *lr = tab + 1;
        insert(kmer, lr[0], lr[1]);
    }
    fclose(fin);

    printf("nrec=%d nbuckets=%d k=%d\n", nrec, nbuckets, k);

    /* Check a few nodes */
    for (int i = 0; i < nrec && i < 5; i++) {
        printf("node[%d]: %s lext=%c rext=%c\n", i, buckets[i].node.kmer, buckets[i].node.lext, buckets[i].node.rext);
    }

    /* Check succ/pred for first node */
    int s = succ(0, k);
    int p = pred(0, k);
    printf("succ(0)=%d pred(0)=%d\n", s, p);

    /* Check for cycles: follow succ from node 0 */
    int cur = 0;
    int steps = 0;
    while (cur != -1 && steps < nrec + 1) {
        printf("  step %d: node %d kmer=%s\n", steps, cur, buckets[cur].node.kmer);
        cur = succ(cur, k);
        steps++;
    }
    printf("stopped after %d steps, cur=%d\n", steps, cur);

    /* Count path starts */
    int path_starts = 0;
    for (int i = 0; i < nrec; i++) {
        if (pred(i, k) == -1) path_starts++;
    }
    printf("path_starts=%d\n", path_starts);

    free(buckets);
    return 0;
}
