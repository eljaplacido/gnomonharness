ts[v].node.lext;\n    memcpy(p + 1, buckets[v].node.kmer, k - 1);\n    p[k] = '\\0';\n    int pi = lookup(p);\n    if (pi == -1) return -1;\n    if (buckets[pi].node.rext != buckets[v].node.kmer[k - 1])\n        return -1;\n    return pi;\n}\n\nint main(int argc, char **argv)\n{\n    if (argc < 2) { fprintf(stderr, \"Usage: %s <file>\\n\", argv[0]); return 1; }\n    FILE *fin = fopen(argv[1], \"r\");\n    if (!fin) { perror(argv[1]); return 1; }\n\n    char line[MAX_LINE];\n    int nlines = 0, k = 0;\n    while (fgets(line, sizeof(line), fin)) {\n        int len = strlen(line);\n        while (len > 0 && (line[len-1] == '\\n' || line[len-1] == '\\r')) line[--len] = '\\0';\n        if (len == 0) continue;\n        char *tab = strchr(line, '\\t');\n        if (!tab) continue;\n        *tab = '\\0';\n        if (k == 0) k = strlen(line);\n        nlines++;\n    }\n    rewind(fin);\n\n    int capacity = 1;\n    while (capacity < 2 * nlines) capacity <<= 1;\n    nbuckets = capacity;\n    buckets = calloc(nbuckets + nlines, sizeof(Bucket));\n    nrec = 0;\n\n    while (fgets(line, sizeof(line), fin)) {\n        int len = strlen(line);\n        while (len > 0 && (line[len-1] == '\\n' || line[len-1] == '\\r')) line[--len] = '\\0';\n        if (len == 0) continue;\n        char *tab = strchr(line, '\\t');\n        if (!tab) continue;\n        *tab = '\\0';\n        char *kmer = line;\n        char *lr = tab + 1;\n        insert(kmer, lr[0], lr[1]);\n    }\n    fclose(fin);\n\n    printf(\"nrec=%d nbuckets=%d k=%d\\n\", nrec, nbuckets, k);\n\n    /* Check a few nodes */\n    for (int i = 0; i < nrec && i < 5; i++) {\n        printf(\"node[%d]: %s lext=%c rext=%c\\n\", i, buckets[i].node.kmer, buckets[i].node.lext, buckets[i].node.rext);\n    }\n\n    /* Check succ/pred for first node */\n    int s = succ(0, k);\n    int p = pred(0, k);\n    printf(\"succ(0)=%d pred(0)=%d\\n\", s, p);\n\n    /* Check for cycles: follow succ from node 0 */\n    int cur = 0;\n    int steps = 0;\