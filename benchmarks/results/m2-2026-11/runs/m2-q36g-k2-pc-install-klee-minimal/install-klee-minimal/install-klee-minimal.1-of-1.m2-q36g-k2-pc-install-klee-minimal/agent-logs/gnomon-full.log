#!/bin/sh
# Fix: undefine macros before including minisat, then redefine them
# The system minisat uses macros for l_True/l_False/l_Undef
# STP code uses Minisat::l_True etc. as class members
# Solution: undefine before include, then the system minisat will re-define them
# But STP code needs them as Minisat:: members, so we need to add them to the namespace

# Actually, the cleanest approach: wrap the minisat include with #undef and #define
# But since the system minisat uses these as macros internally, we can't undef before include

# The real fix: use the system minisat's macros directly in STP code
# Replace Minisat::l_True with l_True, etc.

for f in lib/Sat/SimplifyingMinisat.cpp lib/Sat/MinisatCore.cpp; do
  sed -i 's/Minisat::l_True/l_True/g; s/Minisat::l_False/l_False/g; s/Minisat::l_Undef/l_Undef/g' "$f"
done
echo "Done"
SCRIPT
