[6.076652, "o", "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mtest_klee_basic_symbolic_execution\u001b[39;49;00m():\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"\u001b[39;49;00m\r\n    \u001b[33m    Test KLEE with a basic symbolic execution example that creates two paths.\u001b[39;49;00m\r\n    \u001b[33m    Verifies KLEE runs successfully and explores both branches.\u001b[39;49;00m\r\n    \u001b[33m    \"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        \u001b[90m# C source code with symbolic execution\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        klee_test_source = \u001b[33m\"\"\"\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33m#include <klee/klee.h>\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33m\u001b[39;49;00m\r\n    \u001b[33mint main() \u001b[39;49;00m\u001b[33m{\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33m    int a;\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33m    klee_make_symbolic(&a, sizeof(a), \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33ma\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m);\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33m\u001b[39;49;00m\r\n    \u001b[33m    if (a > 10) \u001b[39;49;00m\u001b[33m{\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33m        return 1;\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n"]
