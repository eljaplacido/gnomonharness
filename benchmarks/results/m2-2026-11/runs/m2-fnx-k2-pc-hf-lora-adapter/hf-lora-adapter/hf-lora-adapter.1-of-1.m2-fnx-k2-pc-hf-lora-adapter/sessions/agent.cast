[17.071236, "o", "> ```json\r\n\u001b[?2004l\r"]
[17.071272, "o", "\u001b[?2004h> [\r\n\u001b[?2004l\r\u001b[?2004h"]
[17.071302, "o", ">   {\r\n\u001b[?2004l\r\u001b[?2004h> "]
