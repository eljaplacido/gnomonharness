[17.070647, "o", "- \"Bonjour, comment allez-vous aujourd'\"'\"'hui?\"\r\n\u001b[?2004l\r\u001b[?2004h> - \"Hola, ¿cómo estás hoy?\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
