import time, mujoco, numpy as np
import xml.etree.ElementTree as ET
import tempfile, os

def simulate_and_time(model_path, seed):
    model = mujoco.MjModel.from_xml_path(model_path)
    data = mujoco.MjData(model)
    nstep = int(2.0 / model.opt.timestep)
    rng = np.random.default_rng(seed)
    data.qpos += rng.normal(0, 0.01, size=data.qpos.shape)
    mujoco.mj_forward(model, data)
    t0 = time.perf_counter()
    for _ in range(nstep):
        mujoco.mj_step(model, data)
    t1 = time.perf_counter()
    return t1 - t0

# Test with disable flags
for disable in [0, 1, 2, 4, 8, 16, 32, 64, 128, 256, 512, 1024, 2048, 4096, 8192, 16384, 32768, 65536]:
    tree = ET.parse('model_ref.xml')
    root = tree.getroot()
    # Add disableflags to worldbody or size
    size = root.find('size')
    if size is None:
        size = ET.SubElement(root, 'size')
    size.set('memory', '2M')
    
    # Add disableflags to opt
    opt = root.find('.//opt')
    if opt is None:
        opt = ET.SubElement(root, 'opt')
    opt.set('disableflags', str(disable))
    
    with tempfile.NamedTemporaryFile(mode='wb', suffix='.xml', delete=False) as f:
        tree.write(f)
        tmp_path = f.name
    
    try:
        t = simulate_and_time(tmp_path, 42)
        print(f'disableflags={disable}: time={t:.4f}s')
    except Exception as e:
        print(f'disableflags={disable}: ERROR: {e}')
    os.unlink(tmp_path)
