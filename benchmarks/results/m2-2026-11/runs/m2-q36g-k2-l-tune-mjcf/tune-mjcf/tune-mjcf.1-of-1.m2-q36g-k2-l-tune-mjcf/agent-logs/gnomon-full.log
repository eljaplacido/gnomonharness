import time, mujoco, numpy as np
import xml.etree.ElementTree as ET
import tempfile, os

def simulate_and_time(model_path, seed):
    model = mujoco.MjModel.from_xml_path(model_path)
    data = mujoco.MjData(model)
    nstep = int(2.0 / model.opt.timestep)
    rng = np.random.default_rng(seed)
    data.qpos += rng.normal(0, 0.01, size=data.qpos.shape)
    mujoco.mj_forward(model, data)
    t0 = time.perf_counter()
    for _ in range(nstep):
        mujoco.mj_step(model, data)
    t1 = time.perf_counter()
    return t1 - t0

def simulate_model(model_path, seed):
    model = mujoco.MjModel.from_xml_path(model_path)
    data = mujoco.MjData(model)
    nstep = int(2.0 / model.opt.timestep)
    rng = np.random.default_rng(seed)
    data.qpos += rng.normal(0, 0.01, size=data.qpos.shape)
    mujoco.mj_forward(model, data)
    for _ in range(nstep):
        mujoco.mj_step(model, data)
    full_physics = mujoco.mjtState.mjSTATE_FULLPHYSICS
    state = np.zeros(mujoco.mj_stateSize(model, full_physics))
    mujoco.mj_getState(model, data, state, full_physics)
    return state

# Get reference state
ref_state = simulate_model('model_ref.xml', 42)

# Test with different vmax values
for vmax in [0.05, 0.1, 0.5, 1.0, 5.0, 10.0, 100.0]:
    tree = ET.parse('model_ref.xml')
    root = tree.getroot()
    for plugin in root.findall('.//plugin[@plugin=\"mujoco.elasticity.cable\"]'):
        for config in plugin.findall('config'):
            if config.get('key') == 'vmax':
                config.set('value', str(vmax))
    
    with tempfile.NamedTemporaryFile(mode='wb', suffix='.xml', delete=False) as f:
        tree.write(f)
        tmp_path = f.name
    
    try:
        t = simulate_and_time(tmp_path, 42)
        state = simulate_model(tmp_path, 42)
        diff = np.linalg.norm(state - ref_state)
        print(f'vmax={vmax}: time={t:.4f}s, diff={diff:.6f}')
    except Exception as e:
        print(f'vmax={vmax}: ERROR: {e}')
    os.unlink(tmp_path)
