import time, mujoco, numpy as np
import xml.etree.ElementTree as ET
import tempfile, os

def simulate_and_time(model_path, seed, timestep_override=None):
    model = mujoco.MjModel.from_xml_path(model_path)
    if timestep_override is not None:
        model.opt.timestep = timestep_override
    data = mujoco.MjData(model)
    nstep = int(2.0 / model.opt.timestep)
    rng = np.random.default_rng(seed)
    data.qpos += rng.normal(0, 0.01, size=data.qpos.shape)
    mujoco.mj_forward(model, data)
    t0 = time.perf_counter()
    for _ in range(nstep):
        mujoco.mj_step(model, data)
    t1 = time.perf_counter()
    return t1 - t0

# Test with different solvers
for solver in [0, 1, 2]:  # 0=PGS, 1=CG, 2=Newton
    tree = ET.parse('model_ref.xml')
    root = tree.getroot()
    size = root.find('size')
    if size is None:
        size = ET.SubElement(root, 'size')
    size.set('memory', '2M')
    
    # Add/modify solver settings
    for opt in root.findall('.//opt'):
        opt.set('solver', str(solver))
        opt.set('iterations', '10')
        opt.set('ls_iterations', '5')
    
    with tempfile.NamedTemporaryFile(mode='wb', suffix='.xml', delete=False) as f:
        tree.write(f)
        tmp_path = f.name
    
    try:
        t = simulate_and_time(tmp_path, 42)
        print(f'solver={solver}: time={t:.4f}s')
    except Exception as e:
        print(f'solver={solver}: ERROR: {e}')
    os.unlink(tmp_path)
