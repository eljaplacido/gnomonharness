import time, mujoco, numpy as np

model_ref = mujoco.MjModel.from_xml_path('model_ref.xml')
print('timestep:', model_ref.opt.timestep)
print('nstep for 2s:', int(2.0 / model_ref.opt.timestep))

# Run baseline timing
times = []
for run in range(20):
    seed = np.random.randint(0, 10000)
    data = mujoco.MjData(model_ref)
    nstep = int(2.0 / model_ref.opt.timestep)
    rng = np.random.default_rng(seed)
    data.qpos += rng.normal(0, 0.01, size=data.qpos.shape)
    mujoco.mj_forward(model_ref, data)
    t0 = time.perf_counter()
    for _ in range(nstep):
        mujoco.mj_step(model_ref, data)
    t1 = time.perf_counter()
    times.append(t1 - t0)

print(f'Avg ref time: {np.mean(times):.4f}s')
print(f'Need to be <= {np.mean(times)*0.6:.4f}s')
