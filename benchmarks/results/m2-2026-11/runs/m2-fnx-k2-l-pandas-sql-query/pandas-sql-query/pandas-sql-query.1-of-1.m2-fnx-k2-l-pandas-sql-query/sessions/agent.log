[approval] bash: cd /app && .venv/bin/python -c "
import duckdb, pandas as pd
from pathlib import Path
products = pd.read_csv('/app/products.csv')
orders = pd.read_csv('/app/orders.csv', parse_dates=['order_date'])
con = duckdb.connect()
con.register('products', products); con.register('orders', orders)
complex_query = Path('/app/answer.sql').read_text()
top3 = con.execute(complex_query).df().groupby('category')['product_id'].apply(list).to_dict()
print(top3)
print({k: len(v) for k,v in top3.items()})
# independent cross-check
s = orders[(orders.order_date>='2024-10-01')&(orders.order_date<'2025-01-01')]
s = (s.assign(v=s.quantity*s.unit_price).groupby('product_id').v.sum().round(2)).to_frame().join(products.set_index('product_id'))
exp = {c: g.sort_values('v',ascending=False).head(3).index.tolist() for c,g in s.groupby('category')}
print('MATCH' if all(sorted(top3[c])==sorted(exp[c]) for c in exp) else 'MISMATCH', sorted(exp)==sorted(top3))
