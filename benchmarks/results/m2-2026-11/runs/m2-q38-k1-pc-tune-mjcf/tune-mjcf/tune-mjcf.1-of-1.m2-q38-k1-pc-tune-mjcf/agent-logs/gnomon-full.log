import time, mujoco, numpy as np
model = mujoco.MjModel.from_xml_path("model_ref.xml")
data = mujoco.MjData(model)
rng = np.random.default_rng(0)
data.qpos += rng.normal(0, 0.01, size=data.qpos.shape)
mujoco.mj_forward(model, data)
N = 2000
# warmup
for _ in range(50): mujoco.mj_step(model, data)
def bench(fn, n=3):
    ts=[]
    for _ in range(n):
        t0=time.perf_counter()
        for _ in range(N): fn()
        ts.append(time.perf_counter()-t0)
    return min(ts)/N*1e3
print("full mj_step:      %.3f ms/step" % bench(lambda: mujoco.mj_step(model, data)))
print("mj_forward only:   %.3f ms/step" % bench(lambda: mujoco.mj_forward(model, data)))
print("mj_step1 only:     %.3f ms/step" % bench(lambda: mujoco.mj_step1(model, data)))
print("mj_step2 only:     %.3f ms/step" % bench(lambda: mujoco.mj_step2(model, data)))
# solver iteration sweep
for it in [1,2,5,10,20,50,100]:
    model.opt.iterations = it
    print(f"iterations={it:3d}: {bench(lambda: mujoco.mj_step(model, data)):.3f} ms/step")
model.opt.iterations = 100
