[6.070692, "o", ">           result = subprocess.run(\u001b[90m\u001b[39;49;00m\r\n                cmd, shell=\u001b[94mTrue\u001b[39;49;00m, capture_output=\u001b[94mTrue\u001b[39;49;00m, text=\u001b[94mTrue\u001b[39;49;00m, check=\u001b[94mTrue\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n            )\u001b[90m\u001b[39;49;00m\r\n\r\n\u001b[1m\u001b[31m/tests/test_outputs.py\u001b[0m:260: \r\n_ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ \r\n\r\ninput = None, capture_output = True, timeout = None, check = True\r\npopenargs = ('jq $(yq -r \\'.args[]\\' /app/jq_args.yaml) \"$(yq -r \\'.filter\\' /app/jq_args.yaml)\" /app/users.json',)\r\nkwargs = {'shell': True, 'stderr': -1, 'stdout': -1, 'text': True}, process = <Popen: returncode: 2 args: 'jq $(yq -r \\'.args[]\\' /app/jq_args.yaml) \"$(yq...>\r\nstdout = '[\\n  {\\n    \"user_id\": 443,\\n    \"username\": \"acosta\",\\n    \"email\": \"ybell@yahoo.com\",\\n    \"last_login\": \"2026-04-0... \"baldwinsherry@gmail.com\",\\n    \"last_login\": \"2026-06-21\",\\n    \"role_count\": 0,\\n    \"primary_ro"]
