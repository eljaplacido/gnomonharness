[6.058483, "o", "\r\n\r\n=========================================================================== FAILURES ===========================================================================\r\n\u001b[31m\u001b[1m__________________________________________________________________ test_jq_args_yaml_is_valid __________________________________________________________________\u001b[0m\r\n\r\n"]
[6.070378, "o", "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mtest_jq_args_yaml_is_valid\u001b[39;49;00m():\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"Test that the jq_args.yaml file contains valid YAML with required keys.\"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[90m# 1. Check if jq_args.yaml exists\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        \u001b[94massert\u001b[39;49;00m os.path.exists(\u001b[33m\"\u001b[39;49;00m\u001b[33m/app/jq_args.yaml\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m), \u001b[33m\"\u001b[39;49;00m\u001b[33mYAML args file jq_args.yaml not found\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[90m# 2. Read and parse the YAML file\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        \u001b[94mwith\u001b[39;49;00m \u001b[96mopen\u001b[39;49;00m(\u001b[33m\"\u001b[39;49;00m\u001b[33m/app/jq_args.yaml\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33mr\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m) \u001b[94mas\u001b[39;49;00m f:\u001b[90m\u001b[39;49;00m\r\n            \u001b[94mtry\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\r\n                yaml_content = yaml.safe_load(f)\u001b[90m\u001b[39;49;00m\r\n            \u001b[94mexcept\u001b[39;49;00m yaml."]
[6.070399, "o", "YAMLError \u001b[94mas\u001b[39;49;00m e:\u001b[90m\u001b[39;49;00m\r\n                pytest.fail(\u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mYAML args file is not valid YAML: \u001b[39;49;00m\u001b[33m{\u001b[39;49;00me\u001b[33m}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[90m# 3. Verify required keys exist\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        \u001b[94massert\u001b[39;49;00m \u001b[33m\"\u001b[39;49;00m\u001b[33mfilter\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m \u001b[95min\u001b[39;49;00m yaml_content, \u001b[33m\"\u001b[39;49;00m\u001b[33mMissing \u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33mfilter\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33m key in YAML file\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        \u001b[94massert\u001b[39;49;00m \u001b[33m\"\u001b[39;49;00m\u001b[33margs\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m \u001b[95min\u001b[39;49;00m yaml_content, \u001b[33m\"\u001b[39;49;00m\u001b[33mMissing \u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33margs\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33m key in YAML file\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[90m# 4. Verify filter is a string\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        \u001b[94massert\u001b[39;49;00m \u001b[96"]
[6.070411, "o", "misinstance\u001b[39;49;00m(yaml_content[\u001b[33m\"\u001b[39;49;00m\u001b[33mfilter\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m], \u001b[96mstr\u001b[39;49;00m), \u001b[33m\"\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33mfilter\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33m should be a string\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[90m# 5. Verify args is a list\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        \u001b[94massert\u001b[39;49;00m \u001b[96misinstance\u001b[39;49;00m(yaml_content[\u001b[33m\"\u001b[39;49;00m\u001b[33margs\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m], \u001b[96mlist\u001b[39;49;00m), \u001b[33m\"\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33margs\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33m should be a list\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[90m# 6. Verify each arg is a string and follows jq argument format\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        \u001b[94mfor\u001b[39;49;00m arg \u001b[95min\u001b[39;49;00m yaml_content[\u001b[33m\"\u001b[39;49;00m\u001b[33margs\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m]:\u001b[90m\u001b[39;49;00m\r\n            \u001b[94massert\u001b[39;49;00m \u001b[96misinstance\u001b[39;49;00m(arg, \u001b[96mstr\u001b[39;49;00m), \u001b[33m\"\u001b[39;49;00m\u001b[33mEach arg"]
[6.070561, "o", "ument in \u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33margs\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33m should be a string\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n            \u001b[90m# Check that each argument starts with - or -- and follows jq argument format\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n>           \u001b[94massert\u001b[39;49;00m arg.startswith(\u001b[33m\"\u001b[39;49;00m\u001b[33m-\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m), \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mArgument \u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33m{\u001b[39;49;00marg\u001b[33m}\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33m should start with \u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33m-\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33m or \u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33m--\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n\u001b[1m\u001b[31mE           AssertionError: Argument '[.[]|select(.status==\"active\")|{user_id:.id,username:.username,email:.email,last_login:(.last_login|split(\"T\")[0]),role_count:(.roles|length),primary_role:(.roles[0]//null)}]|sort_by(.username)' should start with '-' or '--'\u001b[0m\r\n\u001b[1m\u001b[31mE           assert False\u001b[0m\r\n\u001b[1m\u001b[31mE   "]
