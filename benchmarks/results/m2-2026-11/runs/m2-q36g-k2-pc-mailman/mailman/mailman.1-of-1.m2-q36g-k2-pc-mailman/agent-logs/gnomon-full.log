from mailman.core.initialize import initialize
from mailman.database.transaction import transaction
initialize('/etc/mailman3/mailman.cfg')
from mailman.interfaces.domain import IDomainManager
from mailman.interfaces.listmanager import IListManager
from mailman.interfaces.mailinglist import SubscriptionPolicy
from mailman.interfaces.archiver import ArchivePolicy
from zope.component import getUtility

with transaction():
    dm = getUtility(IDomainManager)
    dom = dm.get('local.edu')
    if dom is None:
        dom = dm.add('local.edu')
        print(f'Created domain: local.edu')
    else:
        print(f'Domain already exists: local.edu')

    lm = getUtility(IListManager)
    m = lm.get('reading-group@local.edu')
    if m is None:
        m = lm.create('reading-group@local.edu')
        print(f'Created list: reading-group@local.edu')
    else:
        print(f'List already exists: reading-group@local.edu')

    print(f'Before: subscription_policy={m.subscription_policy}')
    print(f'Before: unsubscription_policy={m.unsubscription_policy}')
    print(f'Before: archive_policy={m.archive_policy}')

    m.subscription_policy = SubscriptionPolicy.open
    m.unsubscription_policy = SubscriptionPolicy.confirm
    m.archive_policy = ArchivePolicy.never

    print(f'After: subscription_policy={m.subscription_policy}')
    print(f'After: unsubscription_policy={m.unsubscription_policy}')
    print(f'After: archive_policy={m.archive_policy}')

print('Done!')
