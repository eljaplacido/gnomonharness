[5.712509, "o", "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mtest_tuned_model_exists\u001b[39;49;00m():\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"Test that the tuned model exists\"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        model_path = app_dir / \u001b[33m\"\u001b[39;49;00m\u001b[33mmodel.xml\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n>       \u001b[94massert\u001b[39;49;00m model_path.exists(), \u001b[33m\"\u001b[39;49;00m\u001b[33mTuned model file does not exist\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n\u001b[1m\u001b[31mE       AssertionError: Tuned model file does not exist\u001b[0m\r\n\u001b[1m\u001b[31mE       assert False\u001b[0m\r\n\u001b[1m\u001b[31mE        +  where False = exists()\u001b[0m\r\n\u001b[1m\u001b[31mE        +    where exists = PosixPath('/app/model.xml').exists\u001b[0m\r\n\r\n\u001b[1m\u001b[31m/tests/test_outputs.py\u001b[0m:28: AssertionError\r\n\u001b[31m\u001b[1m_______________________________________________________________________ test_correctness _______________________________________________________________________\u001b[0m\r\n\r\n"]
