    ("implicit_iter3_ls3", "  <option integrator=\"implicitfast\" iterations=\"3\" ls_iterations=\"3\"/>"),
    ("implicit_iter1_ls1", "  <option integrator=\"implicitfast\" iterations=\"1\" ls_iterations=\"1\"/>"),
]

