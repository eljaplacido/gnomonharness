#!/usr/bin/env python3
"""Sweep candidate timesteps against model_ref.xml for correctness and speed."""
import time
import numpy as np
import mujoco
from pathlib import Path

total_sim_time = 2.0
atol = 1e-5
model_ref_path = Path("/app/model_ref.xml")

def simulate_model(model, seed):
    data = mujoco.MjData(model)
    nstep = int(total_sim_time / model.opt.timestep)
    rng = np.random.default_rng(seed)
    data.qpos += rng.normal(0, 0.01, size=data.qpos.shape)
    mujoco.mj_forward(model, data)
    for _ in range(nstep):
        mujoco.mj_step(model, data)
    full_physics = mujoco.mjtState.mjSTATE_FULLPHYSICS
    state = np.zeros(mujoco.mj_stateSize(model, full_physics))
    mujoco.mj_getState(model, data, state, full_physics)
    assert not np.isnan(state).any(), "NaN"
    assert not np.isinf(state).any(), "Inf"
    return state, nstep

def timing(model, n_runs=20):
    times = []
    for _ in range(n_runs):
        seed = np.random.randint(0, 10000)
        t0 = time.perf_counter()
        simulate_model(model, seed)
        t1 = time.perf_counter()
        times.append(t1 - t0)
    return np.array(times)

# Step 1: Reference timing
print("=== Reference model ===")
model_ref = mujoco.MjModel.from_xml_path(str(model_ref_path))
ref_times = timing(model_ref, 20)
print(f"Ref timestep: {model_ref.opt.timestep}")
print(f"Ref nstep: {int(total_sim_time / model_ref.opt.timestep)}")
print(f"Ref avg time: {ref_times.mean():.4f}s (std: {ref_times.std():.4f})")

# Step 2: Generate candidates and sweep
timesteps = [0.0025, 0.005, 0.01, 0.02]
seeds = list(range(0, 10000, 50))  # 200 seeds

print("\n=== Candidate sweep ===")
results = []

for dt in timesteps:
    ref_content = model_ref_path.read_text()
    new_content = ref_content.replace(
        '  <compiler autolimits="true"/>',
        f'  <compiler autolimits="true"/>\n  <option timestep="{dt}"/>'
    )
    cand_path = Path(f"/tmp/cand_{dt}.xml")
    cand_path.write_text(new_content)
    
    model_cand = mujoco.MjModel.from_xml_path(str(cand_path))
    nstep_cand = int(total_sim_time / model_cand.opt.timestep)
    
    max_diff = 0.0
    fail_count = 0
    for seed in seeds:
        state_cand, _ = simulate_model(model_cand, seed)
        state_ref, _ = simulate_model(model_ref, seed)
        diff = np.linalg.norm(state_cand - state_ref)
        max_diff = max(max_diff, diff)
        if not np.allclose(state_cand, state_ref, atol=atol):
            fail_count += 1
    
    cand_times = timing(model_cand, 20)
    time_pctg = cand_times.mean() / ref_times.mean()
    
    results.append({
        'dt': dt,
        'nstep': nstep_cand,
        'max_diff': max_diff,
        'fail_count': fail_count,
        'cand_avg': cand_times.mean(),
        'time_pctg': time_pctg,
    })
    
    print(f"dt={dt}: nstep={nstep_cand}, max_diff={max_diff:.2e}, fails={fail_count}, "
          f"avg_time={cand_times.mean():.4f}s, time_pctg={time_pctg:.4f}")

print("\n=== Summary ===")
for r in results:
    print(f"dt={r['dt']}: max_diff={r['max_diff']:.2e}, fails={r['fail_count']}, "
          f"time_pctg={r['time_pctg']:.4f} {'PASS' if r['fail_count']==0 and r['time_pctg']<=0.45 else 'FAIL'}")
