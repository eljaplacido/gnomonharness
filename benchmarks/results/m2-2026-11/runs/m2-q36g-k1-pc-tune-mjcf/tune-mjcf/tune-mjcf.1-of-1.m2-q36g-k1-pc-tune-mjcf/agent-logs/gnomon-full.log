[approval] bash: cat > /tmp/sweep9.py << 'PYEOF'
import time, numpy as np, mujoco
from pathlib import Path

total_sim_time = 2.0
atol = 1e-5
ref_path = Path("/app/model_ref.xml")

def sim(model, seed):
    data = mujoco.MjData(model)
    nstep = int(total_sim_time / model.opt.timestep)
    rng = np.random.default_rng(seed)
    data.qpos += rng.normal(0, 0.01, size=data.qpos.shape)
    mujoco.mj_forward(model, data)
    for _ in range(nstep):
        mujoco.mj_step(model, data)
    full_physics = mujoco.mjtState.mjSTATE_FULLPHYSICS
    state = np.zeros(mujoco.mj_stateSize(model, full_physics))
    mujoco.mj_getState(model, data, state, full_physics)
    return state, nstep

ref = mujoco.MjModel.from_xml_path(str(ref_path))
ref_times = []
for _ in range(10):
    seed = np.random.randint(0, 10000)
    t0 = time.perf_counter()
    sim(ref, seed)
    t1 = time.perf_counter()
    ref_times.append(t1 - t0)
ref_avg = np.mean(ref_times)
print(f"Ref avg: {ref_avg:.4f}s, dt={ref.opt.timestep}")

# Test disableflags combinations
configs = [
    ("sensor", 4096),
    ("midphase", 8192),
    ("sensor+midphase", 12288),
    ("warmstart", 256),
    ("filterparent", 512),
    ("passive", 32),
    ("limit", 8),
    ("frictionloss", 4),
    ("sensor+midphase+warmstart", 12544),
    ("sensor+midphase+warmstart+filterparent", 13056),
    ("sensor+midphase+warmstart+filterparent+passive", 13088),
    ("sensor+midphase+warmstart+filterparent+passive+limit", 13096),
    ("sensor+midphase+warmstart+filterparent+passive+limit+frictionloss", 13100),
]

seeds = [0, 100, 500, 999, 5000]

for name, flags in configs:
    spec = mujoco.MjSpec()
    spec.from_string(ref_path.read_text())
    spec.option.disableflags = flags
    
    m = spec.compile()
    spec.to_xml().replace('<mujoco', f'<mujoco').split('\n')[0]
    xml_str = spec.to_xml()
    cpath = Path(f"/tmp/cand_{name}.xml")
    cpath.write_text(xml_str)
    
    max_diff = 0.0
    fails = 0
    for s in seeds:
        sc, _ = sim(m, s)
        sr, _ = sim(ref, s)
        d = np.linalg.norm(sc - sr)
        max_diff = max(max_diff, d)
        if not np.allclose(sc, sr, atol=atol):
            fails += 1
    
    ct = []
    for _ in range(10):
        seed = np.random.randint(0, 10000)
        t0 = time.perf_counter()
        sim(m, seed)
        t1 = time.perf_counter()
        ct.append(t1 - t0)
    ct_avg = np.mean(ct)
    tpct = ct_avg / ref_avg
    status = "PASS" if fails == 0 else "FAIL"
    print(f"{name:45s}: max_diff={max_diff:.2e}, fails={fails}, avg={ct_avg:.4f}s, pctg={tpct:.4f} {status}")
