    '  return syscall(__NR_chown, __concretize_string(path), owner, group);\n'
    '#endif\n'
    '}\n'
    '\n'
    'int __fd_fstat(int fd, struct stat64 *buf) {')

rep('  return syscall(__NR_readlink, path, buf, bufsize);\n',
    '#if defined(__aarch64__)\n'
    '  return syscall(__NR_readlinkat, AT_FDCWD, path, buf, bufsize);\n'
    '#else\n'
    '  return syscall(__NR_readlink, path, buf, bufsize);\n'
    '#endif\n')

rep('    int r = syscall(__NR_select, os_nfds, \n'
    '                    &os_read, &os_write, &os_except, &tv);\n',
    '#if defined(__aarch64__)\n'
    '    struct timespec ts;\n'
    '    ts.tv_sec = tv.tv_sec;\n'
    '    ts.tv_nsec = (long)tv.tv_usec * 1000;\n'
    '    int r = syscall(__NR_pselect6, os_nfds, \n'
    '                    &os_read, &os_write, &os_except, &ts, NULL);\n'
    '#else\n'
    '    int r = syscall(__NR_select, os_nfds, \n'
    '                    &os_read, &os_write, &os_except, &tv);\n'
    '#endif\n')

open(path, 'w').write(src)
print("patched OK")
