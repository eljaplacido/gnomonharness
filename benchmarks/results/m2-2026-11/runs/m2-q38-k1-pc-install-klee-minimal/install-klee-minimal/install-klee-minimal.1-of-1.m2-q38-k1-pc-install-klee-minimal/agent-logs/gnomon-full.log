path = '/tmp/klee-src/runtime/POSIX/fd.c'
src = open(path).read()

def rep(old, new):
    global src
    assert src.count(old) == 1, f"pattern not unique/absent: {old[:60]!r} count={src.count(old)}"
    src = src.replace(old, new)

rep('#include <unistd.h>\n',
    '#include <unistd.h>\n'
    '\n'
    '/* aarch64 has no utimes/futimesat syscalls; convert timeval[2] to timespec[2] */\n'
    'static void __tv2ts(const struct timeval times[2], struct timespec ts[2]) {\n'
    '  ts[0].tv_sec = times[0].tv_sec;\n'
    '  ts[0].tv_nsec = (long)times[0].tv_usec * 1000;\n'
    '  ts[1].tv_sec = times[1].tv_sec;\n'
    '  ts[1].tv_nsec = (long)times[1].tv_usec * 1000;\n'
    '}\n')

rep('  return syscall(__NR_access, __concretize_string(pathname), mode);\n',
    '#if defined(__aarch64__)\n'
    '  return syscall(__NR_faccessat, AT_FDCWD, __concretize_string(pathname), mode);\n'
    '#else\n'
    '  return syscall(__NR_access, __concretize_string(pathname), mode);\n'
    '#endif\n')

rep('    int os_fd = syscall(__NR_open, __concretize_string(pathname), flags, mode);\n',
    '#if defined(__aarch64__)\n'
    '    int os_fd = syscall(__NR_openat, AT_FDCWD, __concretize_string(pathname), flags, mode);\n'
    '#else\n'
    '    int os_fd = syscall(__NR_open, __concretize_string(pathname), flags, mode);\n'
    '#endif\n')

rep('  return syscall(__NR_utimes, __concretize_string(path), times);\n',
    '#if defined(__aarch64__)\n'
    '  struct timespec ts[2];\n'
    '  __tv2ts(times, ts);\n'
    '  return syscall(__NR_utimensat, AT_FDCWD, __concretize_string(path), ts, 0);\n'
    '#else\n'
    '  return syscall(__NR_utimes, __concretize_string(path), times);\n'
    '#endif\n')

rep('  return syscall(__NR_futimesat, (long)fd,\n'
    '                 (path ? __concretize_string(path) : NULL), times);\n',
    '#if defined(__aarch64__)\n'
    '  struct timespec ts[2];\n'
    '  __tv2ts(times, ts);\n'
    '  return syscall(__NR_utimensat, (long)fd,\n'
    '                 (path ? __concretize_string(path) : NULL), ts, 0);\n'
    '#else\n'
    '  return syscall(__NR_futimesat, (long)fd,\n'
    '                 (path ? __concretize_string(path) : NULL), times);\n'
    '#endif\n')

rep('#if __WORDSIZE == 64\n'
    '    return syscall(__NR_stat, __concretize_string(path), buf);\n'
    '#else\n'
    '    return syscall(__NR_stat64, __concretize_string(path), buf);\n'
    '#endif\n',
    '#if defined(__aarch64__)\n'
    '    return syscall(__NR_newfstatat, AT_FDCWD, __concretize_string(path), buf, 0);\n'
    '#elif __WORDSIZE == 64\n'
    '    return syscall(__NR_stat, __concretize_string(path), buf);\n'
    '#else\n'
    '    return syscall(__NR_stat64, __concretize_string(path), buf);\n'
    '#endif\n')

rep('#if __WORDSIZE == 64\n'
    '    return syscall(__NR_lstat, __concretize_string(path), buf);\n'
    '#else\n'
    '    return syscall(__NR_lstat64, __concretize_string(path), buf);\n'
    '#endif\n',
    '#if defined(__aarch64__)\n'
    '    return syscall(__NR_newfstatat, AT_FDCWD, __concretize_string(path), buf, AT_SYMLINK_NOFOLLOW);\n'
    '#elif __WORDSIZE == 64\n'
    '    return syscall(__NR_lstat, __concretize_string(path), buf);\n'
    '#else\n'
    '    return syscall(__NR_lstat64, __concretize_string(path), buf);\n'
    '#endif\n')

rep('  return syscall(__NR_chmod, __concretize_string(path), mode);\n',
    '#if defined(__aarch64__)\n'
    '  return syscall(__NR_fchmodat, AT_FDCWD, __concretize_string(path), mode);\n'
    '#else\n'
    '  return syscall(__NR_chmod, __concretize_string(path), mode);\n'
    '#endif\n')

rep('  return syscall(__NR_chown, __concretize_string(path), owner, group);\n'
    '}\n'
    '\n'
    'int fchown(int fd, uid_t owner, gid_t group) {',
    '#if defined(__aarch64__)\n'
    '  return syscall(__NR_fchownat, AT_FDCWD, __concretize_string(path), owner, group, 0);\n'
    '#else\n'
    '  return syscall(__NR_chown, __concretize_string(path), owner, group);\n'
    '#endif\n'
    '}\n'
    '\n'
    'int fchown(int fd, uid_t owner, gid_t group) {')

rep('  return syscall(__NR_chown, __concretize_string(path), owner, group);\n'
