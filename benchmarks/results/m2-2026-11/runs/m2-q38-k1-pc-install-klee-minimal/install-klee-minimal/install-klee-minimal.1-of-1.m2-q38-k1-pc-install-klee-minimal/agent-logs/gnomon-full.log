    '\n'
    'int __fd_fstat(int fd, struct stat64 *buf) {',
    '#if defined(__aarch64__)\n'
    '  return syscall(__NR_fchownat, AT_FDCWD, __concretize_string(path), owner, group, AT_SYMLINK_NOFOLLOW);\n'
