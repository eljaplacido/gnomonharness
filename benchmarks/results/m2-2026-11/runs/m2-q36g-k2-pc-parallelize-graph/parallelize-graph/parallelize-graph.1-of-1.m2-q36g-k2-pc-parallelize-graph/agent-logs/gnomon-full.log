/* pgen.upc -- parallel de Bruijn graph construction and traversal in UPC.
 *
 * Phase 1  parse: every thread scans the input and keeps the lines whose
 *          index is congruent to MYTHREAD, so node index == line number on
 *          every thread and the graph is laid out identically to the serial
 *          version.
 * Phase 2  build: each thread inserts its own nodes into a shared hash table
 *          with separate chaining; buckets are guarded by sharded locks
 *          (bucket b uses lock b % THREADS) so insertion runs concurrently.
 * Phase 3  edges: each thread resolves the successor of its own nodes, then
 *          (after a barrier) the predecessor of its own nodes.
 * Phase 4  traverse: each thread walks the contigs rooted in its own nodes
 *          and writes them to pgen_<MYTHREAD>.out. Nodes are claimed under a
 *          global lock, so every node belongs to exactly one contig.
 */
#include <upc.h>
#include <upc_relaxed.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>

typedef struct {
    uint64_t code;
    int next;
    char left;
    char right;
} Node;

shared Node *g_nodes;
shared int  *g_head;
shared int  *g_out;
shared int  *g_in;
shared char *g_visited;
shared int64_t g_N;
shared int g_K;

static upc_lock_t *g_claim;   /* global lock, claims a node for one contig */
static upc_lock_t *g_bucket;  /* THREADS sharded locks for the hash table */

static int basebits(char c)
{
    switch (c) {
    case 'C': return 1;
    case 'G': return 2;
    case 'T': return 3;
    default:  return 0;
    }
}

static uint64_t pack(const char *s, int k)
{
    uint64_t c = 0;
    int i;
    for (i = 0; i < k; i++) {
        c <<= 2;
        c |= (uint64_t)basebits(s[i]);
    }
    return c;
}

static void unpack(uint64_t c, int k, char *s)
{
    static const char b[4] = {'A', 'C', 'G', 'T'};
    int i;
    for (i = k - 1; i >= 0; i--) {
        s[i] = b[c & 3];
        c >>= 2;
    }
}

static unsigned long hash64(uint64_t x)
{
    x ^= x >> 33; x *= 0xff51afd7ed558ccdULL;
    x ^= x >> 33; x *= 0xc4ceb9fe1a85ec53ULL;
    x ^= x >> 33;
    return (unsigned long)x;
}

static long lookup(uint64_t code, long nb)
{
    long b = (long)(hash64(code) % (unsigned long)nb);
    int i;
    for (i = g_head[b]; i >= 0; i = g_nodes[i].next)
        if (g_nodes[i].code == code) return (long)i;
    return -1;
}

static void pwalk(long start, FILE *of, char *buf, int k)
{
    long cur = start;
    int len;
    unpack(g_nodes[cur].code, k, buf);
    len = k;
    while (g_nodes[cur].right != 'F') {
        long nxt = g_out[cur];
        if (nxt < 0) break;
        upc_lock(g_claim);
        if (g_visited[nxt]) { upc_unlock(g_claim); break; }
        g_visited[nxt] = 1;
        upc_unlock(g_claim);
        buf[len++] = g_nodes[cur].right;
        cur = nxt;
    }
    buf[len] = '\0';
    fputs(buf, of);
    fputc('\n', of);
}

int main(int argc, char **argv)
{
    const char *path = (argc > 1) ? argv[1] : "test";
    char outname[512];
    FILE *f, *of;
    char line[1024], *buf;
    long N, NB, idx;
    int K, rc = 0;
    uint64_t MASK;

    if (MYTHREAD == 0) {
        FILE *fp = fopen(path, "r");
        if (!fp) {
            fprintf(stderr, "pgen: cannot open %s\n", path);
            rc = 1;
        } else {
            long n = 0;
            int k = -1;
            while (fgets(line, sizeof line, fp)) {
                char *t;
                if (line[0] == '\n' || line[0] == '\0') continue;
                if (k < 0) { t = strchr(line, '\t'); if (t) k = (int)(t - line); }
                n++;
            }
            fclose(fp);
            g_N = n;
            g_K = k;
        }
    }
    upc_barrier;
    if (rc) return 1;

    N = (long)g_N;
    K = (int)g_K;
    if (N <= 0 || K <= 0 || K > 31) {
        if (MYTHREAD == 0) fprintf(stderr, "pgen: bad or empty input\n");
        return 1;
    }
    MASK = (1ULL << (2 * K)) - 1;
    NB = 2 * N + 1;

    g_nodes   = (shared Node *)upc_all_alloc((size_t)N, sizeof(Node));
    g_head    = (shared int  *)upc_all_alloc((size_t)NB, sizeof(int));
    g_out     = (shared int  *)upc_all_alloc((size_t)N, sizeof(int));
    g_in      = (shared int  *)upc_all_alloc((size_t)N, sizeof(int));
    g_visited = (shared char *)upc_all_alloc((size_t)N, sizeof(char));
    if (!g_nodes || !g_head || !g_out || !g_in || !g_visited) {
        if (MYTHREAD == 0) fprintf(stderr, "pgen: shared allocation failed\n");
        return 1;
    }
    g_claim  = upc_global_lock_alloc();
    g_bucket = upc_all_lock_alloc();

    for (idx = MYTHREAD; idx < NB; idx += THREADS) g_head[idx] = -1;
    for (idx = MYTHREAD; idx < N;  idx += THREADS) {
        g_visited[idx] = 0;
        g_out[idx] = -1;
        g_in[idx]  = -1;
    }
    upc_barrier;

    /* ---- phase 1: parse, keeping the lines this thread owns ---- */
    f = fopen(path, "r");
    if (!f) {
        if (MYTHREAD == 0) fprintf(stderr, "pgen: cannot open %s\n", path);
        return 1;
    }
    idx = 0;
    while (fgets(line, sizeof line, f)) {
        char *t;
        if (line[0] == '\n' || line[0] == '\0') continue;
        if ((idx % (long)THREADS) == (long)MYTHREAD) {
            t = strchr(line, '\t');
            if (t) {
                char l, r;
                *t = '\0';
                l = t[1];
                r = t[2];
                if (l == '\0' || l == '\n' || l == '\r') l = 'F';
                if (r == '\0' || r == '\n' || r == '\r') r = 'F';
                g_nodes[idx].code  = pack(line, K);
                g_nodes[idx].left  = l;
                g_nodes[idx].right = r;
            } else {
                g_nodes[idx].code  = pack(line, K);
                g_nodes[idx].left  = 'F';
                g_nodes[idx].right = 'F';
            }
            g_nodes[idx].next = -1;
        }
        idx++;
    }
    fclose(f);

    /* ---- phase 2: insert into the shared hash table ---- */
    for (idx = MYTHREAD; idx < N; idx += THREADS) {
        uint64_t c = g_nodes[idx].code;
        long b = (long)(hash64(c) % (unsigned long)NB);
        long shard = b % (long)THREADS;
        upc_lock(g_bucket + shard);
        g_nodes[idx].next = g_head[b];
        g_head[b] = (int)idx;
        upc_unlock(g_bucket + shard);
    }
    upc_barrier;

    /* ---- phase 3a: successors ---- */
    for (idx = MYTHREAD; idx < N; idx += THREADS) {
        char r = g_nodes[idx].right;
        if (r == 'F') {
            g_out[idx] = -1;
        } else {
            uint64_t s = ((g_nodes[idx].code << 2) | (uint64_t)basebits(r)) & MASK;
            g_out[idx] = (int)lookup(s, NB);
        }
    }
    upc_barrier;

    /* ---- phase 3b: predecessors ---- */
    for (idx = MYTHREAD; idx < N; idx += THREADS) {
        char l = g_nodes[idx].left;
        if (l == 'F') {
            g_in[idx] = -1;
        } else {
            uint64_t p = (g_nodes[idx].code >> 2) | ((uint64_t)basebits(l) << (2 * (K - 1)));
            long pi = lookup(p, NB);
            g_in[idx] = (pi >= 0 && g_out[pi] == (int)idx) ? (int)pi : -1;
        }
    }
    upc_barrier;

    /* ---- phase 4: traversal ---- */
    buf = (char *)malloc((size_t)N + (size_t)K + 2);
    if (!buf) return 1;
    if (argc > 2) snprintf(outname, sizeof outname, "%s_%d.out", argv[2], (int)MYTHREAD);
    else          snprintf(outname, sizeof outname, "/app/pgen_%d.out", (int)MYTHREAD);
    of = fopen(outname, "w");
    if (!of) {
        fprintf(stderr, "pgen: cannot write %s\n", outname);
        return 1;
    }

    for (idx = MYTHREAD; idx < N; idx += THREADS) {
        if (g_in[idx] != -1) continue;
        upc_lock(g_claim);
        if (g_visited[idx]) { upc_unlock(g_claim); continue; }
        g_visited[idx] = 1;
        upc_unlock(g_claim);
        pwalk(idx, of, buf, K);
    }
    upc_barrier;

    for (idx = MYTHREAD; idx < N; idx += THREADS) {   /* remaining cycles */
        long cur, mn;
        int steps;
        if (g_visited[idx]) continue;
        cur = idx; mn = idx; steps = 0;
        while (steps <= N) {
            long nxt = g_out[cur];
            if (nxt < 0) { cur = -1; break; }
            if (nxt < mn) mn = nxt;
            cur = nxt; steps++;
            if (cur == idx) break;
        }
        if (cur != idx || mn != idx) continue;
        upc_lock(g_claim);
        if (g_visited[idx]) { upc_unlock(g_claim); continue; }
        g_visited[idx] = 1;
        upc_unlock(g_claim);
        pwalk(idx, of, buf, K);
    }
    fclose(of);
    free(buf);
    return 0;
}
EOF
