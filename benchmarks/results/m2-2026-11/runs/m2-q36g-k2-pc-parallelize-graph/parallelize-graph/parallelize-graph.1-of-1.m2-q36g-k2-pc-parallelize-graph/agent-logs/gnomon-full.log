[approval] bash: cat > /app/serial.c <<'EOF'
/* serial.c -- serial de Bruijn graph construction and traversal.
 * Nodes are k-mers read from the input; edges follow the right extension.
 * Contigs are emitted from source nodes, then from the remaining cycles. */
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>

typedef struct {
    uint64_t code;   /* k-mer packed two bits per base */
    int next;        /* hash chain */
    char left;       /* left extension, 'F' = none */
    char right;      /* right extension, 'F' = none */
} Node;

static Node *nodes;
static int *head;      /* hash buckets, separate chaining */
static int *outidx;    /* successor node or -1 */
static int *inidx;     /* predecessor node or -1 */
static char *visited;
static long N, NB;
static int K;
static uint64_t MASK;
static long n_conflicts = 0, n_contigs = 0;
static unsigned long long n_bases = 0;

static int basebits(char c)
{
    switch (c) {
    case 'C': return 1;
    case 'G': return 2;
    case 'T': return 3;
    default:  return 0;   /* 'A' */
    }
}

static uint64_t pack(const char *s, int k)
{
    uint64_t c = 0;
    int i;
    for (i = 0; i < k; i++) {
        c <<= 2;
        c |= (uint64_t)basebits(s[i]);
    }
    return c;
}

static void unpack(uint64_t c, int k, char *s)
{
    static const char b[4] = {'A', 'C', 'G', 'T'};
    int i;
    for (i = k - 1; i >= 0; i--) {
        s[i] = b[c & 3];
        c >>= 2;
    }
}

static unsigned long hash64(uint64_t x)
{
    x ^= x >> 33; x *= 0xff51afd7ed558ccdULL;
    x ^= x >> 33; x *= 0xc4ceb9fe1a85ec53ULL;
    x ^= x >> 33;
    return (unsigned long)x;
}

static long lookup(uint64_t code)
{
    long b = (long)(hash64(code) % (unsigned long)NB);
    int i;
    for (i = head[b]; i >= 0; i = nodes[i].next)
        if (nodes[i].code == code) return (long)i;
    return -1;
}

/* Walk forward from start, appending one base per edge. */
static void emit(long start, FILE *of, char *buf, int is_cycle)
{
    long cur = start;
    int len;
    unpack(nodes[cur].code, K, buf);
    len = K;
    while (nodes[cur].right != 'F') {
        long nxt = outidx[cur];
        if (nxt < 0) break;
        if (visited[nxt]) {
            if (!is_cycle) n_conflicts++;
            break;
        }
        visited[nxt] = 1;
        buf[len++] = nodes[cur].right;
        cur = nxt;
    }
    buf[len] = '\0';
    fputs(buf, of);
    fputc('\n', of);
    n_contigs++;
    n_bases += (unsigned long long)len;
}

int main(int argc, char **argv)
{
    const char *path = (argc > 1) ? argv[1] : "test";
    const char *outpath = (argc > 2) ? argv[2] : "/app/serial.out";
    FILE *f, *of;
    char line[1024], *buf;
    long i, n = 0, b;
    int k = -1;

    f = fopen(path, "r");
    if (!f) { fprintf(stderr, "serial: cannot open %s\n", path); return 1; }
    while (fgets(line, sizeof line, f)) {
        char *t;
        if (line[0] == '\n' || line[0] == '\0') continue;
        if (k < 0) { t = strchr(line, '\t'); if (t) k = (int)(t - line); }
        n++;
    }
    fclose(f);
    if (n <= 0 || k <= 0 || k > 31) { fprintf(stderr, "serial: bad or empty input\n"); return 1; }

    N = n; K = k;
    MASK = (1ULL << (2 * K)) - 1;
    NB = 2 * N + 1;

    nodes   = (Node *)malloc((size_t)N * sizeof(Node));
    head    = (int *)malloc((size_t)NB * sizeof(int));
    outidx  = (int *)malloc((size_t)N * sizeof(int));
    inidx   = (int *)malloc((size_t)N * sizeof(int));
    visited = (char *)malloc((size_t)N);
    buf     = (char *)malloc((size_t)N + (size_t)K + 2);
    if (!nodes || !head || !outidx || !inidx || !visited || !buf) {
        fprintf(stderr, "serial: out of memory\n"); return 1;
    }
    for (b = 0; b < NB; b++) head[b] = -1;

    /* ---- construction: parse and insert into the hash table ---- */
    f = fopen(path, "r");
    if (!f) { fprintf(stderr, "serial: cannot open %s\n", path); return 1; }
    i = 0;
    while (fgets(line, sizeof line, f)) {
        char *t;
        if (line[0] == '\n' || line[0] == '\0') continue;
        t = strchr(line, '\t');
        if (t) {
            char l, r;
            *t = '\0';
            l = t[1];
            r = t[2];
            if (l == '\0' || l == '\n' || l == '\r') l = 'F';
            if (r == '\0' || r == '\n' || r == '\r') r = 'F';
            nodes[i].code  = pack(line, K);
            nodes[i].left  = l;
            nodes[i].right = r;
        } else {
            nodes[i].code  = pack(line, K);
            nodes[i].left  = 'F';
            nodes[i].right = 'F';
        }
        nodes[i].next = -1;
        i++;
    }
    fclose(f);
    for (i = 0; i < N; i++) {
        b = (long)(hash64(nodes[i].code) % (unsigned long)NB);
        nodes[i].next = head[b];
        head[b] = (int)i;
    }

    /* ---- out edges: k-mer shifted left plus the right extension ---- */
    for (i = 0; i < N; i++) {
        char r = nodes[i].right;
        if (r == 'F') {
            outidx[i] = -1;
        } else {
            uint64_t s = ((nodes[i].code << 2) | (uint64_t)basebits(r)) & MASK;
            outidx[i] = (int)lookup(s);
        }
    }
    /* ---- in edges: k-mer shifted right plus the left extension ---- */
    for (i = 0; i < N; i++) {
        char l = nodes[i].left;
        if (l == 'F') {
            inidx[i] = -1;
        } else {
            uint64_t p = (nodes[i].code >> 2) | ((uint64_t)basebits(l) << (2 * (K - 1)));
            long pi = lookup(p);
            inidx[i] = (pi >= 0 && outidx[pi] == (int)i) ? (int)pi : -1;
        }
    }

    /* ---- traversal ---- */
    for (i = 0; i < N; i++) visited[i] = 0;
    of = fopen(outpath, "w");
    if (!of) { fprintf(stderr, "serial: cannot write %s\n", outpath); return 1; }

    for (i = 0; i < N; i++) {            /* contigs rooted at source nodes */
        if (inidx[i] != -1 || visited[i]) continue;
        visited[i] = 1;
        emit(i, of, buf, 0);
    }
    for (i = 0; i < N; i++) {            /* whatever is left is a cycle */
        long cur, mn;
        int steps;
        if (visited[i]) continue;
        cur = i; mn = i; steps = 0;
        while (steps <= N) {
            long nxt = outidx[cur];
            if (nxt < 0) { cur = -1; break; }
            if (nxt < mn) mn = nxt;
            cur = nxt; steps++;
            if (cur == i) break;
        }
        if (cur != i || mn != i) continue;
        visited[i] = 1;
        emit(i, of, buf, 1);
    }
    fclose(of);
    fprintf(stderr, "serial: %ld k-mers, %ld contigs, %llu bases, %ld walk conflicts\n",
            N, n_contigs, n_bases, n_conflicts);
    return 0;
}
EOF
