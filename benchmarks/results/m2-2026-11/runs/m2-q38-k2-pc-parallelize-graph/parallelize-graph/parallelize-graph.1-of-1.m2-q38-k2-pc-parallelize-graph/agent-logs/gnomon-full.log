#include <stdio.h>
#include <string.h>
#include <stdlib.h>
#define K 19
typedef struct { char key[K]; char left,right; int next; } node_t;
static unsigned int fnv1a(const char *s,int n){unsigned int h=2166136261u;for(int i=0;i<n;i++){h^=(unsigned char)s[i];h*=16777619u;}return h;}
static int is_prime(unsigned long m){if(m<2)return 0;if(m%2==0)return m==2;for(unsigned long d=3;d*d<=m;d+=2)if(m%d==0)return 0;return 1;}
static unsigned long next_prime_ge(unsigned long m){if(m<=2)return 2;if(m%2==0)m++;while(!is_prime(m))m+=2;return m;}
int main(){
  FILE *f=fopen("test","r");
  long n=0; char line[256];
  while(fgets(line,sizeof line,f)){ if(strchr(line,'\t')) n++; }
  unsigned long nb=next_prime_ge(n/2+1);
  node_t *tb=calloc(n,sizeof(node_t));
  int *head=malloc(nb*sizeof(int)); int *next=malloc(n*sizeof(int));
  for(unsigned long b=0;b<nb;b++)head[b]=-1;
  rewind(f); long i=0;
  while(fgets(line,sizeof line,f)){
    char *tab=strchr(line,'\t'); if(!tab){i++;continue;}
    *tab='\0'; char *ext=tab+1;
    if(strlen(line)!=K||strlen(ext)!=2){printf("BAD LINE %ld: klen=%zu extlen=%zu\n",i,strlen(line),strlen(ext));i++;continue;}
    memcpy(tb[i].key,line,K); tb[i].left=ext[0]; tb[i].right=ext[1];
    int b=(int)(fnv1a(line,K)%nb); next[i]=head[b]; head[b]=(int)i; i++;
  }
  printf("n=%ld nb=%lu\n",n,nb);
  /* check node 0 */
  printf("node0 key=%s left=%c right=%c\n",tb[0].key,tb[0].left,tb[0].right);
  return 0;
}
EOF
