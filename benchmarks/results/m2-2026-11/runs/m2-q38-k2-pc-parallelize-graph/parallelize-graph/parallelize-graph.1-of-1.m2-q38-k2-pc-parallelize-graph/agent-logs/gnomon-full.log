  /* check predecessor of 9791 */
  char key[K];
  key[0]=tb[9791].left;
  memcpy(key+1, tb[9791].key, K-1);
  printf("pred key: ");
  for(int j=0;j<K;j++)printf("%c",key[j]);
  printf("\n");
  int b=(int)(fnv1a(key,K)%nb);
  int found=-1;
  for(int j=head[b];j!=-1;j=next[j]) if(memcmp(tb[j].key,key,K)==0){found=j;break;}
