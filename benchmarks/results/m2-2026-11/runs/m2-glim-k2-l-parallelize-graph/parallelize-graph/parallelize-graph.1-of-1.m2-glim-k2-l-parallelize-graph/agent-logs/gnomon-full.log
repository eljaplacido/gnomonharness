#!/bin/sh
prog=""
input=""
nthreads=1
# parse args
while [ $# -gt 0 ]; do
  case "$1" in
    -n)
      nthreads="$2"
      shift 2
      continue
      ;;
    -shared-heap)
      shift 2
      continue
      ;;
    *)
      # check if executable
      if [ -x "$1" ]; then
        prog="$1"
      elif [ -z "$input" ] && [ -n "$prog" ]; then
        input="$1"
      fi
      shift
      ;;
  esac
done
if [ -z "$prog" ]; then
  echo "No program found" >&2
  exit 1
fi
# Run for each thread
for i in $(seq 0 $((nthreads-1))); do
  UPC_THREAD=$i "$prog" "$input"
done
EOF
