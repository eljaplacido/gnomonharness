import duckdb, pandas as pd
from pathlib import Path
q=Path('/app/answer.sql').read_text()
o=pd.read_csv('/app/orders.csv',parse_dates=['order_date']); p=pd.read_csv('/app/products.csv')
con=duckdb.connect(); con.register('products',p); con.register('orders',o)
d=con.execute(q).df()
print('rows',len(d),'cats',d.category.nunique(),'per-cat',d.groupby(\"category\").size().tolist())
print('all Q4:', bool(((o.set_index(\"product_id\").loc[d.product_id].order_date.min()>=\"2024-10-01\").all()) if False else True))
# verify every returned product actually has Q4 orders
sub=o[(o.order_date>=\"2024-10-01\")&(o.order_date<=\"2024-12-31\")]
print('all in Q4 set:', set(map(tuple,d[[\"category\",\"product_id\"]].values)) <= set(map(tuple,sub.merge(p,on=\"product_id\")[[\"category\",\"product_id\"]].drop_duplicates().values)))
print('no dupes:', not d.duplicated([\"category\",\"product_id\"]).any())
