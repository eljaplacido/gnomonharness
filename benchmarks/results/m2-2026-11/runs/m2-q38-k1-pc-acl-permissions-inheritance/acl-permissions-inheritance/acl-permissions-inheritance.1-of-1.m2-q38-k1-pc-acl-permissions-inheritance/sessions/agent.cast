[29.10611, "o", "   - Base permissions: 2770 (rwxrws---)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[29.106154, "o", "\u001b[?2004h> 2. Configure ACLs on /srv/shared:\r\n\u001b[?2004l\r"]
[29.1062, "o", "\u001b[?2004h> "]
[29.106235, "o", "   - Group \"research\": full rwx permissions (both current and default)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.106314, "o", "   - Users \"alice\" and \"bob\": full rwx permissions (both current and default)  \r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.106365, "o", "   - Others: no permissions (both current and default)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.106421, "o", "   - Set proper mask to allow full permissions\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[29.106463, "o", "\u001b[?2004h> "]
