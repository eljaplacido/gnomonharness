{"seq":21,"ts":"2026-11-04T14:51:06.298Z","kind":"approval","prev":"6c2fec24346dee7a3a813a24bfdb61241952bd1e40dd296a43b27a34e1358f55","tool":"bash","summary":"bash: # Check 1: count equality\nREPORT_COUNT=$(jq 'length' /app/active_users_report.json)\nINPUT_COUNT=$(jq '[.[]|select(.status==\"active\")]|length' /app/users.json)\necho \"Check 1 - Count: report=$REPORT_COUNT, input=$INPUT_COUNT, match=$([ \"$REPORT_COUNT\" = \"$INPUT_COUNT\" ] && echo YES || echo NO)\"\n\n# Check 2: sorted by username\nSORTED=$(jq -r '.[].username' /app/active_users_report.json | sort -c 2>&1 && echo \"SORTED\" || echo \"NOT_SORTED\")\necho \"Check 2 - Sorted: $SORTED\"\n\n# Check 3: all last_login match YYYY-MM-DD\nBAD_DATES=$(jq '[.[]|select((.last_login|test(\"^\\\\d{4}-\\\\d{2}-\\\\d{2}$\"))|not)]|length' /app/active_users_report.json)\necho \"Check 3 - Bad date formats: $BAD_DATES (must be 0)\"\n\n# Check 4: primary_role for role_count==0 must be null\nNULL_CHECK=$(jq '[.[]|select(.role_count==0)|.primary_role]|unique' /app/active_users_report.json)\necho \"Check 4 - Null primary_roles for empty roles: $NULL_CHECK (must be [null])\"\n\n# Check 5: no leftover input-only keys (status, id, roles should not exist as top-level keys)\nLEFTOVER=$(jq '[.[]|select((.status!=null or .id!=null or .roles!=null))]|length' /app/active_users_report.json)\necho \"Check 5 - Leftover input keys: $LEFTOVER (must be 0)\"\n\n# Check 6: keys on first element\nKEYS=$(jq -r '.[0]|keys|join(\",\")' /app/active_users_report.json)\necho \"Check 6 - First element keys: $KEYS (must be email,last_login,primary_role,role_count,user_id,username)\"\n\n# Check 7: indentation\necho \"Check 7 - Indentation (first 200 chars):\"\nhead -c 200 /app/active_users_report.json\necho \"\"","decision":"approved","by":"flag:--yes","interactive":false,"hash":"6047a41bc98b7c7fbecb8a945c8da889c987282fcb49b8e06806dc03ced2ea33"}
