from html.parser import HTMLParser
import os, sys, re

VOID = {'area','base','br','col','embed','hr','img','input','link','meta','param','source','track','wbr'}

class Check(HTMLParser):
    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.stack=[]; self.headings=[]; self.errors=[]; self.text=[]
    def handle_starttag(self, tag, attrs):
        if tag not in VOID: self.stack.append(tag)
        if re.fullmatch(r'h[1-6]', tag):
            self.headings.append((int(tag[1]), []))
        if tag=='a':
            d=dict(attrs)
            if d.get('href')=='#': self.errors.append('dead href="#"')
    def handle_endtag(self, tag):
        if tag in VOID: return
        if not self.stack or self.stack[-1]!=tag:
            self.errors.append(f'mismatch: </{tag}> at line {self.getpos()[0]}, open={self.stack[-3:]}')
        else:
            self.stack.pop()
    def handle_data(self, data):
        if self.headings: self.headings[-1][1].append(data)

bad=0
for f in ['my_website/index.html','my_website/blog.html','my_website/publications.html']:
    src=open(f, encoding='utf-8').read()
    p=Check(); p.feed(src); p.close()
    if p.stack: p.errors.append(f'unclosed tags: {p.stack}')
    lv=[l for l,_ in p.headings]
    if lv.count(1)!=1: p.errors.append(f'h1 count={lv.count(1)}')
    prev=0
    for l in lv:
        if prev and l>prev+1: p.errors.append(f'heading skip h{prev}->h{l}')
        prev=l
    # mojibake / smart-char check
    for ch in ['\u2010','\u2011','\u2018','\u2019','\u201c','\u201d','\u2013','\u2014','\ufffd','&amp;#','â€']:
        if ch in src: p.errors.append(f'non-ASCII typographic char {ch!r} in source')
    print(f'{f}: headings={lv} errors={p.errors or "none"}')
    if p.errors: bad=1
print('RESULT:', 'FAIL' if bad else 'OK')
sys.exit(bad)
EOF
