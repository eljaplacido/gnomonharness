[approval] bash: cd /tmp && cat > mk.py <<'EOF'
import subprocess, itertools
py_head = '#if 0\nimport sys\nprint("x")\n'
c_body  = '#endif\n#include <stdio.h>\nint main(void){puts("ok");return 0;}\n'
openers = ['r"""\n', 'r"" ;\n', 'r""x ;\n', 'r"" "" ;\n', 'r"" ""\n']
closers = ['"""\n', '"" ;\n', '""\n', '" "" ""\n', '"" ""\n', 'r"""\n']
for o,c in itertools.product(openers, closers):
    src = py_head + o + c_body + '#if 0\n' + c + '#endif\n'
    open('t.c','w').write(src)
    g = subprocess.run(['gcc','-Wall','-Wextra','-std=c99','t.c','-o','t'],capture_output=True,text=True)
    p = subprocess.run(['python3','t.c','7'],capture_output=True,text=True)
    r = subprocess.run(['./t'],capture_output=True,text=True)
    ok = (g.returncode==0 and g.stderr=='' and p.returncode==0 and p.stdout=='x\n' and r.stdout=='ok\n')
    print('OK ' if ok else 'no ', repr(o), repr(c), '| gccrc',g.returncode,'warn',repr(g.stderr[:60]),'| pyrc',p.returncode,repr(p.stdout[:20]),repr(p.stderr[:60]))
EOF
