[15.632365, "o", "00m\r\n        model = AutoModelForSequenceClassification.from_pretrained(\u001b[90m\u001b[39;49;00m\r\n            merged_model_path, torch_dtype=torch.float32, device_map=\u001b[33m\"\u001b[39;49;00m\u001b[33mcpu\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        )\u001b[90m\u001b[39;49;00m\r\n        tokenizer = AutoTokenizer.from_pretrained(merged_model_path)\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[90m# Load evaluation dataset\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        data_path = \u001b[33m\"\u001b[39;49;00m\u001b[33m/tests/data.json\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        \u001b[94massert\u001b[39;49;00m os.path.exists(data_path), \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mEvaluation dataset not found at \u001b[39;49;00m\u001b[33m{\u001b[39;49;00mdata_path\u001b[33m}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[94mwith\u001b[39;49;00m \u001b[96mopen\u001b[39;49;00m(data_path, \u001b[33m\"\u001b[39;49;00m\u001b[33mr\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m) \u001b[94mas\u001b[39;49;00m f:\u001b[90m\u001b[39;49;00m\r\n            eval_data = json.load(f)\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[94massert"]
[15.632368, "o", "\u001b[39;49;00m \u001b[96mlen\u001b[39;49;00m(eval_data) == \u001b[94m40\u001b[39;49;00m, \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mExpected 40 samples, got \u001b[39;49;00m\u001b[33m{\u001b[39;49;00m\u001b[96mlen\u001b[39;49;00m(eval_data)\u001b[33m}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[90m# Evaluate model\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        correct_predictions = \u001b[94m0\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        predictions_by_language = {}\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[94mfor\u001b[39;49;00m sample \u001b[95min\u001b[39;49;00m eval_data:\u001b[90m\u001b[39;49;00m\r\n            text = sample[\u001b[33m\"\u001b[39;49;00m\u001b[33mtext\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m]\u001b[90m\u001b[39;49;00m\r\n            expected_label = sample[\u001b[33m\"\u001b[39;49;00m\u001b[33mlabel\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m]\u001b[90m\u001b[39;49;00m\r\n            language = sample[\u001b[33m\"\u001b[39;49;00m\u001b[33mlanguage\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m]\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n            \u001b[90m# Initialize language accuracy tracking\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n            \u001b[94mif\u001b[39;49;00m language \u001b[95mnot\u001b[39;49;00"]
[15.632372, "o", "m \u001b[95min\u001b[39;49;00m predictions_by_language:\u001b[90m\u001b[39;49;00m\r\n                predictions_by_language[language] = {\u001b[33m\"\u001b[39;49;00m\u001b[33mcorrect\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m: \u001b[94m0\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33mtotal\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m: \u001b[94m0\u001b[39;49;00m}\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n            \u001b[90m# Make prediction\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n            inputs = tokenizer(\u001b[90m\u001b[39;49;00m\r\n                text, return_tensors=\u001b[33m\"\u001b[39;49;00m\u001b[33mpt\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, padding=\u001b[94mTrue\u001b[39;49;00m, truncation=\u001b[94mTrue\u001b[39;49;00m, max_length=\u001b[94m128\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n            )\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n            \u001b[94mwith\u001b[39;49;00m torch.no_grad():\u001b[90m\u001b[39;49;00m\r\n                outputs = model(**inputs)\u001b[90m\u001b[39;49;00m\r\n                predictions = torch.nn.functional.softmax(outputs.logits, dim=-\u001b[94m1\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n                predicted_class_id = torch.argmax(predictions, dim=-\u001b[94m1\u001b[39;49;00m).item()\u001b[90m\u001b[39;49;"]
[15.632466, "o", "00m\r\n    \u001b[90m\u001b[39;49;00m\r\n            \u001b[90m# Track accuracy\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n            predictions_by_language[language][\u001b[33m\"\u001b[39;49;00m\u001b[33mtotal\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m] += \u001b[94m1\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n            \u001b[94mif\u001b[39;49;00m predicted_class_id == expected_label:\u001b[90m\u001b[39;49;00m\r\n                correct_predictions += \u001b[94m1\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n                predictions_by_language[language][\u001b[33m\"\u001b[39;49;00m\u001b[33mcorrect\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m] += \u001b[94m1\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[90m# Calculate overall accuracy\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        overall_accuracy = correct_predictions / \u001b[96mlen\u001b[39;49;00m(eval_data)\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[90m# Assert minimum accuracy threshold\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n>       \u001b[94massert\u001b[39;49;00m overall_accuracy >= \u001b[94m0.95\u001b[39;49;00m, (\u001b[90m\u001b[39;49;00m\r\n            \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mModel accuracy \u001b[39;49;00m\u001b[33m{\u001b[39;49;00moverall_accur"]
