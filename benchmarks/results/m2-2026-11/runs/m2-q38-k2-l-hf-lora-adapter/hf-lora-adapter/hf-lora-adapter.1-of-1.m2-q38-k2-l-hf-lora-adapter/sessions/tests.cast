[15.630667, "o", "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mtest_detection_results\u001b[39;49;00m():\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"Test that detection results exist with correct format and values.\"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        results_file = \u001b[33m\"\u001b[39;49;00m\u001b[33m/app/detection_results.json\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[94massert\u001b[39;49;00m os.path.exists(results_file), \u001b[33m\"\u001b[39;49;00m\u001b[33mResults file not found\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[94mwith\u001b[39;49;00m \u001b[96mopen\u001b[39;49;00m(results_file, \u001b[33m\"\u001b[39;49;00m\u001b[33mr\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m) \u001b[94mas\u001b[39;49;00m f:\u001b[90m\u001b[39;49;00m\r\n            results = json.load(f)\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[94massert\u001b[39;49;00m \u001b[96mlen\u001b[39;49;00m(results) == \u001b[94m10\u001b[39;49;00m, \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mExpected 10 results, got \u001b[39;49;00m\u001b[33m{\u001b[39;49;00m\u001b[96mlen\u001b[39;49;00m(results)\u001b[33m}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49"]
[15.630693, "o", ";00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[90m# Expected class IDs for the test samples\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        \u001b[90m# If the LoRA is correctly applied, these should match.\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        expected_ids = [\u001b[94m6\u001b[39;49;00m, \u001b[94m5\u001b[39;49;00m, \u001b[94m2\u001b[39;49;00m, \u001b[94m8\u001b[39;49;00m, \u001b[94m12\u001b[39;49;00m, \u001b[94m13\u001b[39;49;00m, \u001b[94m9\u001b[39;49;00m, \u001b[94m19\u001b[39;49;00m, \u001b[94m0\u001b[39;49;00m, \u001b[94m4\u001b[39;49;00m]\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[94mfor\u001b[39;49;00m i, result \u001b[95min\u001b[39;49;00m \u001b[96menumerate\u001b[39;49;00m(results):\u001b[90m\u001b[39;49;00m\r\n            \u001b[90m# Check required fields\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n            \u001b[94massert\u001b[39;49;00m \u001b[33m\"\u001b[39;49;00m\u001b[33mtext\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m \u001b[95min\u001b[39;49;00m result, \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mResult \u001b[39;49;00m\u001b[33m{\u001b[39;49;00mi\u001b[33m}\u001b[39;49;00m\u001b[33m missing \u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33mtext\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n            \u001b[94massert\u001b[39;49;00m \u001b[33m\"\u001b[39;49;00m\u001b[33mp"]
