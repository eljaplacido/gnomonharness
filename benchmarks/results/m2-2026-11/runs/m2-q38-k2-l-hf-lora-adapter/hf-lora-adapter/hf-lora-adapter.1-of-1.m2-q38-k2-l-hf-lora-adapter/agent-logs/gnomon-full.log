# check merged model logits for the same
merged = torch.load("/dev/null") if False else None
from transformers import XLMRobertaForSequenceClassification as M
m2 = M.from_pretrained("/app/merged_model/")
m2.eval()
for text in texts:
    inputs = tok(text, return_tensors="pt", truncation=True, max_length=512)
    with torch.no_grad():
        l = m2(**inputs).logits[0]
    print("merged:", text, "-> argmax", int(l.argmax()), "top5:", torch.topk(l, 5).indices.tolist())
