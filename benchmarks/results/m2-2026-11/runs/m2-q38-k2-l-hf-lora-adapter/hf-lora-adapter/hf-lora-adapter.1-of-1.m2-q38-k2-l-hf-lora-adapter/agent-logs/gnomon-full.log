model.save_pretrained("/app/model_cache/xlm-roberta-base")
tok = XLMRobertaTokenizer.from_pretrained("FacebookAI/xlm-roberta-base")
tok.save_pretrained("/app/model_cache/xlm-roberta-base")
print("saved. num_labels:", model.config.num_labels, "classifier out:", model.classifier.out_features)
