from transformers import XLMRobertaForSequenceClassification, XLMRobertaTokenizer
from peft import PeftModel

base = XLMRobertaForSequenceClassification.from_pretrained("/app/model_cache/xlm-roberta-base")
peft_model = PeftModel.from_pretrained(base, "/root/.cache/huggingface/hub/models--dominguesm--xlm-roberta-base-lora-language-detection/snapshots/64a23e9057e79cde85b3c19637e21642fbd4bc42")
peft_model.eval()
tok = XLMRobertaTokenizer.from_pretrained("/app/model_cache/xlm-roberta-base")

texts = ["Hello, how are you?", "Bonjour, comment allez-vous aujourd'hui?", "你好，你好吗？"]
for text in texts:
    inputs = tok(text, return_tensors="pt", truncation=True, max_length=512)
    with torch.no_grad():
        out = peft_model(**inputs)
    l = out.logits[0]
    print(text, "-> argmax", int(l.argmax()), "top5:", torch.topk(l, 5).indices.tolist(), [round(x,3) for x in torch.topk(l,5).values.tolist()])
EOF
