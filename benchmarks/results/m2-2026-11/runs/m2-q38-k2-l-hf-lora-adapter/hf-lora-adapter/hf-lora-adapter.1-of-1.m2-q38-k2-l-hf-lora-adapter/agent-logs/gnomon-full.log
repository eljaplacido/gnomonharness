[approval] bash: cd /tmp && python3 - <<'EOF' > /tmp/detect.log 2>&1
import json, torch
from transformers import XLMRobertaForSequenceClassification, XLMRobertaTokenizer

model = XLMRobertaForSequenceClassification.from_pretrained("/app/merged_model/")
model.eval()
tok = XLMRobertaTokenizer.from_pretrained("/app/merged_model/")

samples = [
    "Bonjour, comment allez-vous aujourd'hui?",
    "Hola, ¿cómo estás hoy?",
    "Guten Tag, wie geht es Ihnen?",
    "Ciao, come stai oggi?",
    "Olá, como você está?",
    "Привет, как дела?",
    "こんにちは、お元気ですか？",
    "你好，你好吗？",
    "مرحبا، كيف حالك؟",
    "Hello, how are you?",
]

results = []
for text in samples:
    inputs = tok(text, return_tensors="pt", truncation=True, max_length=512)
    with torch.no_grad():
        logits = model(**inputs).logits
    probs = torch.softmax(logits, dim=-1)
    conf, pred = torch.max(probs, dim=-1)
    results.append({"text": text, "predicted_class_id": int(pred.item()), "confidence": round(float(conf.item()), 4)})

with open("/app/detection_results.json", "w") as f:
    json.dump(results, f, ensure_ascii=False, indent=2)
print(json.dumps(results, ensure_ascii=False, indent=2))
EOF
