import re
src = open("university_graph.ttl", encoding="utf-8").read()
src = "\n".join(l.split("#")[0] for l in src.splitlines())
blocks = re.split(r"\n(?=uni:\w+\s)", src)
for b in blocks:
    m = re.match(r"\s*uni:(\w+)\s+((?:.|\n)*)", b)
    if not m:
        continue
    subj, body = m.group(1), m.group(2)
    for stmt in re.split(r";\s*", body):
        pred = re.match(r"\s*uni:(\w+)", stmt)
        if pred and pred.group(1) == "isEnrolledIn":
            print(subj, "->", re.findall(r"uni:(\w+)", stmt))
