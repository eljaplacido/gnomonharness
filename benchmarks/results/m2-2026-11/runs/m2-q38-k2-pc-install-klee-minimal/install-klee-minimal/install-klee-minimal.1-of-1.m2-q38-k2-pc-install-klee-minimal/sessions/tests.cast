;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        )\u001b[90m\u001b[39;49;00m\r\n\u001b[1m\u001b[31mE       AssertionError: Compilation failed with return code 1. stderr: test.c:2:10: fatal error: 'klee/klee.h' file not found\u001b[0m\r\n\u001b[1m\u001b[31mE         #include <klee/klee.h>\u001b[0m\r\n\u001b[1m\u001b[31mE                  ^~~~~~~~~~~~~\u001b[0m\r\n\u001b[1m\u001b[31mE         1 error generated.\u001b[0m\r\n\u001b[1m\u001b[31mE         \u001b[0m\r\n\u001b[1m\u001b[31mE       assert 1 == 0\u001b[0m\r\n\u001b[1m\u001b[31mE        +  where 1 = CompletedProcess(args=['bash', '-c', 'source ~/.bashrc && clang-16 -emit-llvm -c -g -O0 -Xclang -disable-O0-optnone te...2:10: fatal error: 'klee/klee.h' file not found\\n#include <klee/klee.h>\\n         ^~~~~~~~~~~~~\\n1 error generated.\\n\").returncode\u001b[0m\r\n\r\n\u001b[1m\u001b[31m/tests/test_outputs.py\u001b[0m:65: AssertionError\r\n"]
