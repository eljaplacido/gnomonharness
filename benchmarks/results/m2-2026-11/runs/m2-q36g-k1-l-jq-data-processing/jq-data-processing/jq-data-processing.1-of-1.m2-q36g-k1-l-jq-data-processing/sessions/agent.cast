[21.032135, "o", "\u001b[?2004h> "]
[21.032147, "o", "   ```\r\n\u001b[?2004l\r\u001b[?2004h"]
[21.032158, "o", ">    \r\n\u001b[?2004l\r"]
[21.032168, "o", "\u001b[?2004h> "]
[21.032256, "o", "   '\"'\"'/app/jq_args.yaml'\"'\"' will be used to construct and execute a single jq command as follows:\r\n\u001b[?2004l\r\u001b[?2004h"]
[21.032269, "o", "> "]
