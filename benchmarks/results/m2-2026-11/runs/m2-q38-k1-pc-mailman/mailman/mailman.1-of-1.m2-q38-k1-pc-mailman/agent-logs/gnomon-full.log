[approval] bash: cat > /tmp/patch_cfg.py <<'EOF'
import shutil
P = '/etc/mailman3/mailman.cfg'
shutil.copyfile(P, P + '.orig')
wanted = [
    ('mailman', 'site_owner', 'root@local.edu'),
    ('mailman', 'user', 'list'),
    ('mailman', 'group', 'list'),
    ('mta', 'incoming', 'mailman.mta.postfix.LMTP'),
    ('mta', 'outgoing', 'mailman.mta.deliver.deliver'),
    ('mta', 'smtp_host', 'localhost'),
    ('mta', 'smtp_port', '25'),
    ('mta', 'lmtp_host', '127.0.0.1'),
    ('mta', 'lmtp_port', '8024'),
    ('mta', 'configuration', 'python:mailman.config.postfix'),
    ('database', 'class', 'mailman.database.sqlite.SQLiteDatabase'),
    ('database', 'url', 'sqlite:///$DATA_DIR/mailman.db'),
]
with open(P) as fp:
    lines = fp.readlines()
header, where, section = {}, {}, None
for i, line in enumerate(lines):
    s = line.strip()
    if s.startswith('[') and s.endswith(']'):
        section = s[1:-1]
        header[section] = i
    elif section is not None and not s.startswith('#') and ':' in s:
        where[(section, s.split(':', 1)[0].strip())] = i
inserts = {}
for sec, key, value in wanted:
    new = '{}: {}\n'.format(key, value)
    idx = where.get((sec, key))
    if idx is not None:
        lines[idx] = new
    else:
        assert sec in header, sec
        inserts.setdefault(sec, []).append(new)
for sec, new_lines in inserts.items():
    at = header[sec] + 1
    lines[at:at] = new_lines
text = ''.join(lines)
banner = """
# ---------------------------------------------------------------------------
# Reading-group mailing list: reading-group@local.edu
#
# Postfix hands every list address (posting, -join, -leave, -confirm+token,
# -bounces, -owner, -request, -subscribe, -unsubscribe) to this Mailman
# instance over LMTP at 127.0.0.1:8024, per /var/lib/mailman3/data/postfix_lmtp
# (referenced by postfix `transport_maps`).  Plain <user>@local.edu mail keeps
# normal local delivery to /var/mail/<user>.
#
# The list itself is configured with subscription_policy = confirm and
# unsubscription_policy = confirm: no list-owner/moderator approval is ever
# needed, but the user must reply to the confirmation mail to finish joining
# or leaving.  SubscriptionPolicy.open is NOT used because it subscribes
# immediately and sends no confirmation message at all.
# ---------------------------------------------------------------------------
"""
if 'Reading-group mailing list' not in text:
    text = text.rstrip('\n') + '\n' + banner
with open(P, 'w') as fp:
    fp.write(text)
print('patched /etc/mailman3/mailman.cfg')
EOF
