[23.804597, "o", "    \u001b[0mserver.send_message(msg)\u001b[90m\u001b[39;49;00m\r\n\u001b[1m\u001b[31m/usr/lib/python3.12/smtplib.py\u001b[0m:975: in send_message\r\n"]
[23.804762, "o", "    \u001b[0m\u001b[94mreturn\u001b[39;49;00m \u001b[96mself\u001b[39;49;00m.sendmail(from_addr, to_addrs, flatmsg, mail_options,\u001b[90m\u001b[39;49;00m\r\n\u001b[1m\u001b[31m/usr/lib/python3.12/smtplib.py\u001b[0m:870: in sendmail\r\n"]
[23.804871, "o", "    \u001b[0m(code, resp) = \u001b[96mself\u001b[39;49;00m.mail(from_addr, esmtp_opts)\u001b[90m\u001b[39;49;00m\r\n                   ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\u001b[90m\u001b[39;49;00m\r\n\u001b[1m\u001b[31m/usr/lib/python3.12/smtplib.py\u001b[0m:546: in mail\r\n"]
[23.80497, "o", "    \u001b[0m\u001b[94mreturn\u001b[39;49;00m \u001b[96mself\u001b[39;49;00m.getreply()\u001b[90m\u001b[39;49;00m\r\n           ^^^^^^^^^^^^^^^\u001b[90m\u001b[39;49;00m\r\n_ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ \r\n\r\n"]
[23.805017, "o", "self = <smtplib.SMTP object at 0xf2164fd820c0>\r\n\r\n"]
[23.805403, "o", "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mgetreply\u001b[39;49;00m(\u001b[96mself\u001b[39;49;00m):\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"Get a reply from the server.\u001b[39;49;00m\r\n    \u001b[33m\u001b[39;49;00m\r\n    \u001b[33m    Returns a tuple consisting of:\u001b[39;49;00m\r\n    \u001b[33m\u001b[39;49;00m\r\n    \u001b[33m      - server response code (e.g. '250', or such, if all goes well)\u001b[39;49;00m\r\n    \u001b[33m        Note: returns -1 if it can't read response code.\u001b[39;49;00m\r\n"]
[23.805432, "o", "    \u001b[33m\u001b[39;49;00m\r\n    \u001b[33m      - server response string corresponding to response code (multiline\u001b[39;49;00m\r\n    \u001b[33m        responses are converted to a single, multiline string).\u001b[39;49;00m\r\n    \u001b[33m\u001b[39;49;00m\r\n    \u001b[33m    Raises SMTPServerDisconnected if end-of-file is reached.\u001b[39;49;00m\r\n    \u001b[33m    \"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        resp = []\u001b[90m\u001b[39;49;00m\r\n        \u001b[94mif\u001b[39;49;00m \u001b[96mself\u001b[39;49;00m.file \u001b[95mis\u001b[39;49;00m \u001b[94mNone\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\r\n            \u001b[96mself\u001b[39;49;00m.file = \u001b[96mself\u001b[39;49;00m.sock.makefile(\u001b[33m'\u001b[39;49;00m\u001b[33mrb\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n        \u001b[94mwhile\u001b[39;49;00m \u001b[94m1\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\r\n            \u001b[94mtry\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\r\n                line = \u001b[96mself\u001b[39;49;00m.file.readline(_MAXLINE + \u001b[94m1\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n            \u001b[94mexcept\u001b[39;49;00m \u001b[96mOSError\u001b[39;49;00m \u001b[94mas\u001b[39;49;00m e:\u001b[90m\u001b[39;49;00m\r\n                \u001b[96mself\u001b[39;49;00m.close()\u001b[90m\u001b[39;49;00m"]
[23.805462, "o", "\r\n                \u001b[94mraise\u001b[39;49;00m SMTPServerDisconnected(\u001b[33m\"\u001b[39;49;00m\u001b[33mConnection unexpectedly closed: \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n                                             + \u001b[96mstr\u001b[39;49;00m(e))\u001b[90m\u001b[39;49;00m\r\n            \u001b[94mif\u001b[39;49;00m \u001b[95mnot\u001b[39;49;00m line:\u001b[90m\u001b[39;49;00m\r\n                \u001b[96mself\u001b[39;49;00m.close()\u001b[90m\u001b[39;49;00m\r\n>               \u001b[94mraise\u001b[39;49;00m SMTPServerDisconnected(\u001b[33m\"\u001b[39;49;00m\u001b[33mConnection unexpectedly closed\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n\u001b[1m\u001b[31mE               smtplib.SMTPServerDisconnected: Connection unexpectedly closed\u001b[0m\r\n\r\n\u001b[1m\u001b[31m/usr/lib/python3.12/smtplib.py\u001b[0m:405: SMTPServerDisconnected\r\n"]
