python3 << 'PYEOF'
from mailman.core.initialize import initialize
initialize('/etc/mailman3/mailman.cfg')

from mailman.interfaces.listmanager import IListManager
from mailman.interfaces.domain import IDomainManager
from zope.component import getUtility

# Add the domain
dm = getUtility(IDomainManager)
try:
    domain = dm.add('local.edu', description='Reading group domain')
    print(f"Domain added: {domain.name}")
except Exception as e:
    print(f"Domain may already exist: {e}")

# Create the mailing list
lm = getUtility(IListManager)
try:
    mlist = lm.create('reading-group@local.edu')
    print(f"List created: {mlist.list_name}")
except Exception as e:
    print(f"List may already exist: {e}")

# Configure the list settings
mlist = lm.get('reading-group@local.edu')
print(f"List: {mlist.list_name}")
print(f"  Mail host: {mlist.mail_host}")
print(f"  Subscription policy: {mlist.subscription_policy}")
print(f"  Default language: {mlist.default_language}")

# Set open subscription policy
from mailman.interfaces.subscription_policy import SubscriptionPolicy
mlist.subscription_policy = SubscriptionPolicy.open
print(f"  Subscription policy set to: open")

# Set posting policy to allow all
from mailman.interfaces.send_mail import HoldRequest
mlist.preferred_language = 'en'

# Save changes
from mailman.database.transaction import user_commit
user_commit(mlist)
print("List configuration saved")

# Verify
mlist = lm.get('reading-group@local.edu')
print(f"  Final subscription policy: {mlist.subscription_policy}")
