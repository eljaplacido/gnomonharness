# And the transport file maps addresses to LMTP

# First, let me understand: for local.edu, we want:
# - reading-group@local.edu -> LMTP to mailman
# - reading-group-join@local.edu -> LMTP to mailman  
# - reading-group-leave@local.edu -> LMTP to mailman
# - user@local.edu -> local mailbox delivery

# The simplest approach: use transport_maps for the list addresses,
# and keep local.edu in mydestination for other users

cat > /etc/postfix/main.cf << 'EOF'
smtpd_banner = $myhostname ESMTP $mail_name (Ubuntu)
biff = no
append_dot_mydomain = no
readme_directory = no
compatibility_level = 3.6

smtpd_tls_cert_file=/etc/ssl/certs/ssl-cert-snakeoil.pem
smtpd_tls_key_file=/etc/ssl/private/ssl-cert-snakeoil.key
smtpd_tls_security_level=may
smtp_tls_CApath=/etc/ssl/certs
smtp_tls_security_level=may
smtp_tls_session_cache_database = btree:${data_directory}/smtp_scache

smtpd_relay_restrictions = permit_mynetworks permit_sasl_authenticated defer_unauth_destination
myhostname = localhost.localdomain
alias_maps = hash:/etc/aliases
alias_database = hash:/etc/aliases
mydestination = localhost.localdomain, localhost, local.edu
relayhost =
mynetworks = 127.0.0.0/8 [::ffff:127.0.0.0]/104 [::1]/128
mailbox_size_limit = 0
recipient_delimiter = +
inet_interfaces = all
inet_protocols = all

# Mailman3 transport map for list addresses
transport_maps = hash:/var/lib/mailman3/data/postfix_transport
EOF
