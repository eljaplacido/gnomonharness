[approval] bash: cd /app && cat > serial.c <<'CEOF'
/*
 * serial.c -- serial de Bruijn graph construction and traversal for de novo
 *             genome assembly.
 *
 * Reference: Georganas, Buluc, Chapman, Oliker, Rokhsar, Yelick,
 *   "Parallel de bruijn graph construction and traversal for de novo genome
 *   assembly", SC'14.
 *
 * Input : one record per line:  <KMER>\t<LEFT><RIGHT>   (A/C/G/T/F, F = none)
 * Output: contigs, one per line, written to OUT_PATH.
 *
 * Graph model (identical in the serial and the UPC version):
 *   - vertices are the distinct k-mers of the input
 *   - k-mer K with right extension c has an edge to suffix(K)+c when that
 *     k-mer is itself present
 *   - k-mer K with left extension c has an edge from c+prefix(K) into K
 *   - a k-mer is a tip when it has no usable left or no usable right
 *     extension; a contig is a maximal chain of non-branching k-mers
 *     (in-degree == out-degree == 1) grown to the right from a tip.
 *
 * The graph is a hash table with separate chaining; the chain links live in
 * the bucket heads, so a chain is walked with one load per hop.
 */

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>

#ifndef OUT_PATH
#define OUT_PATH "/app/serial.out"
#endif

#define KMAX        64
#define MAX_KMERS   4000000
#define MAX_CONTIGS 400000
#define CONTIG_BUF  (4 * MAX_KMERS + 64)

static const char DNA[4] = { 'A', 'C', 'G', 'T' };

/* ---------------- graph, in one flat structure ---------------- */
typedef struct {
  uint64_t *key;    /* packed k-mer (2 bits/base, first base in the top bits) */
  int32_t  *lext;   /* left extension  0=A 1=C 2=G 3=T -1=F                   */
  int32_t  *rext;   /* right extension, same encoding                          */
  int32_t  *head;   /* bucket -> first node, -1 when empty                     */
  int32_t  *next;   /* node -> next node in the same bucket, -1 ends the chain */
  int32_t  *indeg;
  int32_t  *outdeg;
  int8_t   *seen;
  uint64_t  mask;   /* keeps the low K*2 bits of a packed k-mer                */
  uint64_t  shift;  /* (K-1)*2                                                  */
  uint64_t  cmask;  /* cap-1                                                    */
  int       klen;
  int       n;
} Graph;

static Graph G;
static char  *cbuf;
static char **contigs;
static int    ncontig;

static uint64_t code2 (char c) {
  switch (c) { case 'A': return 0; case 'C': return 1;
               case 'G': return 2; case 'T': return 3; }
  return 0;
}
static int codeext (char c) {
  switch (c) { case 'A': return 0; case 'C': return 1;
               case 'G': return 2; case 'T': return 3; case 'F': return -1; }
  return -1;
}
static uint64_t mix (uint64_t x) {
  x ^= x >> 33; x *= 0xff51afd7ed558ccdULL;
  x ^= x >> 33; x *= 0xc4ceb9fe1a85ec53ULL;
  x ^= x >> 33;
  return x;
}

static int32_t find_node (uint64_t k) {
  int32_t i = G.head[mix(k) & G.cmask];
  while (i >= 0) {
    if (G.key[i] == k) return i;
    i = G.next[i];
  }
  return -1;
}

static int32_t insert_node (uint64_t k, int le, int re) {
  uint64_t h = mix(k) & G.cmask;
  int32_t i = G.head[h];
  while (i >= 0) {
    if (G.key[i] == k) {
      if (G.lext[i] == -1) G.lext[i] = le;
      if (G.rext[i] == -1) G.rext[i] = re;
      return i;
    }
    i = G.next[i];
  }
  if (G.n >= MAX_KMERS) { fprintf(stderr, "serial: too many k-mers\n"); exit(1); }
  i = G.n++;
  G.key[i] = k; G.lext[i] = le; G.rext[i] = re;
  G.next[i] = G.head[h]; G.head[h] = i;
  return i;
}

static void emit (const char *s, int len) {
  if (len <= 0 || ncontig >= MAX_CONTIGS) return;
  contigs[ncontig] = (char *)malloc(len + 1);
  if (!contigs[ncontig]) { fprintf(stderr, "serial: out of memory\n"); exit(1); }
  memcpy(contigs[ncontig], s, len);
  contigs[ncontig][len] = 0;
  ncontig++;
}

/* grow a contig to the right starting at k-mer `start` */
static void walk (int32_t start) {
  int len = 0, steps = 0;
  int32_t cur = start;
  uint64_t k = G.key[cur];
  int j;

  for (j = G.klen - 1; j >= 0; j--) cbuf[len++] = DNA[(int)((k >> (2 * j)) & 3)];
  G.seen[cur] = 1;

  for (;;) {
    int re = G.rext[cur];
    int32_t nx;
    if (re < 0) break;
    nx = find_node(((G.key[cur] << 2) | (uint64_t)re) & G.mask);
    if (nx < 0) break;
    if (G.seen[nx]) break;
    if (G.lext[nx] < 0) break;
    if (G.outdeg[cur] != 1) break;
    if (G.indeg[nx] != 1) break;
    cbuf[len++] = DNA[re];
    G.seen[nx] = 1;
    cur = nx;
    if (++steps > MAX_KMERS) break;
  }
  emit(cbuf, len);
}

static void *xmalloc (size_t n) {
  void *p = malloc(n);
  if (!p && n) { fprintf(stderr, "serial: out of memory\n"); exit(1); }
  return p;
}

int main (int argc, char **argv) {
  const char *in_path  = (argc > 1) ? argv[1] : "/app/test";
  const char *out_path = (argc > 2) ? argv[2] : OUT_PATH;
  FILE *f;
  char line[512];
  uint64_t cap = 1 << 15;
  uint64_t *rkey = (uint64_t *)xmalloc(sizeof(uint64_t) * MAX_KMERS);
  int8_t   *rl   = (int8_t *)xmalloc(sizeof(int8_t) * MAX_KMERS);
  int8_t   *rr   = (int8_t *)xmalloc(sizeof(int8_t) * MAX_KMERS);
  int nrec = 0, i;

  /* ---- pass 1: read the records ---- */
  f = fopen(in_path, "r");
  if (!f) { fprintf(stderr, "serial: cannot open %s\n", in_path); return 1; }
  while (fgets(line, sizeof(line), f)) {
    char *t = strchr(line, '\t');
    int klen, j;
    uint64_t k = 0;
    int L, R;
    if (!t) continue;
    *t = 0;
    klen = (int)strlen(line);
    if (klen == 0 || klen > KMAX) continue;
    if (t[1] == 0 || t[2] == 0) continue;
    if (G.klen && klen != G.klen) continue;
    for (j = 0; j < klen; j++) {
      char c = line[j];
      if (c != 'A' && c != 'C' && c != 'G' && c != 'T') { klen = 0; break; }
      k = (k << 2) | code2(c);
    }
    if (!klen) continue;
    L = codeext(t[1]); R = codeext(t[2]);
    if (nrec >= MAX_KMERS) break;
    rkey[nrec] = k; rl[nrec] = (int8_t)L; rr[nrec] = (int8_t)R;
    if (!G.klen) G.klen = klen;
    nrec++;
  }
  fclose(f);
  free(rkey); free(rl); free(rr);

  f = NULL;
  if (G.klen == 0) { FILE *o = fopen(out_path, "w"); if (o) fclose(o); return 0; }

  G.shift = (uint64_t)(G.klen - 1) * 2;
  G.mask  = (G.klen * 2 >= 64) ? ~(uint64_t)0 : ((1ULL << (G.klen * 2)) - 1);

  while (cap < (uint64_t)nrec * 2 + 16) cap <<= 1;
  G.cmask = cap - 1;
  G.head  = (int32_t *)xmalloc(sizeof(int32_t) * cap);
  for (i = 0; i < (int)cap; i++) G.head[i] = -1;
  G.key   = (uint64_t *)xmalloc(sizeof(uint64_t) * MAX_KMERS);
  G.lext  = (int32_t *)xmalloc(sizeof(int32_t) * MAX_KMERS);
  G.rext  = (int32_t *)xmalloc(sizeof(int32_t) * MAX_KMERS);
  G.next  = (int32_t *)xmalloc(sizeof(int32_t) * MAX_KMERS);

  /* ---- pass 2: build the graph ---- */
  f = fopen(in_path, "r");
  if (!f) { fprintf(stderr, "serial: cannot open %s\n", in_path); return 1; }
  while (fgets(line, sizeof(line), f)) {
    char *t = strchr(line, '\t');
    int klen, j;
    uint64_t k = 0;
    if (!t) continue;
    *t = 0;
    klen = (int)strlen(line);
    if (klen != G.klen) continue;
    for (j = 0; j < klen; j++) k = (k << 2) | code2(line[j]);
    insert_node(k, codeext(t[1]), codeext(t[2]));
  }
  fclose(f);

  G.indeg  = (int32_t *)calloc(G.n, sizeof(int32_t));
  G.outdeg = (int32_t *)calloc(G.n, sizeof(int32_t));
  G.seen   = (int8_t *)calloc(G.n, sizeof(int8_t));
  cbuf     = (char *)xmalloc(CONTIG_BUF);
  contigs  = (char **)xmalloc(sizeof(char *) * MAX_CONTIGS);
  if (!G.indeg || !G.outdeg || !G.seen) { fprintf(stderr, "serial: oom\n"); return 1; }

  /* ---- degrees ---- */
  for (i = 0; i < G.n; i++) {
    int re = G.rext[i], le = G.lext[i];
    if (re >= 0) {
      int32_t t = find_node(((G.key[i] << 2) | (uint64_t)re) & G.mask);
      if (t >= 0) { G.outdeg[i]++; G.indeg[t]++; }
    }
    if (le >= 0) {
      uint64_t p = (((uint64_t)le << G.shift) | (G.key[i] >> 2)) & G.mask;
      int32_t s = find_node(p);
      if (s >= 0) { G.outdeg[s]++; G.indeg[i]++; }
    }
  }

  /* ---- contigs: grow every tip to the right, then break any cycles ---- */
  for (i = 0; i < G.n; i++)
    if (!G.seen[i] && (G.indeg[i] != 1 || G.outdeg[i] != 1)) walk(i);
  for (i = 0; i < G.n; i++)
    if (!G.seen[i]) walk(i);

  {
    FILE *o = fopen(out_path, "w");
    if (!o) { fprintf(stderr, "serial: cannot write %s\n", out_path); return 1; }
    for (i = 0; i < ncontig; i++) fprintf(o, "%s\n", contigs[i]);
    fclose(o);
  }
  return 0;
}
