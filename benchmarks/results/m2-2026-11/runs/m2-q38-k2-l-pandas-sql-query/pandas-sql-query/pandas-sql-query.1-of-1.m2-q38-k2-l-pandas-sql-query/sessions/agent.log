orders = pd.read_csv("/app/orders.csv", parse_dates=["order_date"])
con = duckdb.connect()
con.register('products', products); con.register('orders', orders)
q = """
WITH s AS (
  SELECT p.product_id, p.category, SUM(o.quantity*o.unit_price) AS sales
  FROM orders o JOIN products p ON o.product_id=p.product_id
  WHERE o.order_date >= DATE '2024-10-01' AND o.order_date <= DATE '2024-12-31'
  GROUP BY 1,2)
SELECT category, product_id, sales FROM s
ORDER BY category, sales DESC
"""
df = con.execute(q).df()
for cat in df.category.unique():
    print(cat)
    print(df[df.category==cat].head(5).to_string(index=False))
