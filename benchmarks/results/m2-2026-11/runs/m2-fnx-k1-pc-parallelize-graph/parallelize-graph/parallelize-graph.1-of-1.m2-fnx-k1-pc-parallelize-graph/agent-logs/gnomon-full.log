        j=nxt[i]; return 1 if (j>=0 and not dead[j]) else 0
    def idg(i):
        j=prv[i]; return 1 if (j>=0 and not dead[j]) else 0
    passes=0
    while True:
        passes+=1; rem=False
        for i in range(n):
            if not dead[i] and rule(i,od): dead[i]=True; rem=True
        for i in range(n):
            if not dead[i] and idg(i)==0:
                j=nxt[i]
                if j>=0 and not dead[j] and idg(j)==0: dead[i]=True; rem=True
        if not rem: break
    alive=[i for i in range(n) if not dead[i]]
    used=[False]*n; contigs=[]
    for s in alive:
        if used[s] or idg(s)!=0: continue
        used[s]=True; seq=[s]; cur=s
        while True:
            j=nxt[cur]
            if j>=0 and not dead[j] and not used[j]: used[j]=True; seq.append(j); cur=j
            else: break
        contigs.append(seq)
    tot=0; lines=[]
    for c in contigs:
        s=(L[c[0]] if L[c[0]]!='F' else '')+''.join(kmers[i] for i in c)+(R[c[-1]] if R[c[-1]]!='F' else '')
        lines.append(s); tot+=len(s)
    print(f"{label}: passes={passes} alive={len(alive)} contigs={len(contigs)} bases={tot} unclaimed={sum(1 for i in alive if not used[i])}")
    for s in lines: print("   ",len(s),s[:50])
run(lambda i,od: od(i)!=1, "rule outdeg!=1")
run(lambda i,od: False, "rule none")
