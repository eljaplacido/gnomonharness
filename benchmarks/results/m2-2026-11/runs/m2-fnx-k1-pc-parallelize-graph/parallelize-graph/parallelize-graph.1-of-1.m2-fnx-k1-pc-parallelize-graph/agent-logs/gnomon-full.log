import sys
K=19
kmers=[]; L=[]; R=[]
for line in open('test'):
    line=line.rstrip('\n')
    k,lr=line.split('\t')
    kmers.append(k); L.append(lr[0]); R.append(lr[1])
idx={k:i for i,k in enumerate(kmers)}
n=len(kmers)
nxt=[-1]*n; prv=[-1]*n
missing=[]
for i,k in enumerate(kmers):
    if R[i]!='F':
        j=idx.get(k[1:]+R[i], -1)
        nxt[i]=j
        if j<0: missing.append(i)
    if L[i]!='F':
        j=idx.get(L[i]+k[:K-1], -1)
        prv[i]=j
print("missing successors:", [(i,kmers[i],L[i],R[i]) for i in missing])
# consistency check
bad=0
for i in range(n):
    j=nxt[i]
    if j>=0 and L[j]!=R[i]: bad+=1
    k2=prv[i]
    if k2>=0 and R[k2]!=L[i]: bad+=1
print("inconsistencies:",bad)
# out/in degree
outd=[1 if nxt[i]>=0 else 0 for i in range(n)]
ind=[0]*n
for i in range(n):
    if nxt[i]>=0: ind[nxt[i]]+=1
print("outdeg0:",sum(1 for d in outd if d==0), "outdeg>1:",sum(1 for d in outd if d>1))
print("indeg0:",sum(1 for d in ind if d==0),"indeg1:",sum(1 for d in ind if d==1),"indeg>1:",sum(1 for d in ind if d>1))
# simulate prune
dead=[False]*n
def outdeg(i):
    j=nxt[i]
    return 1 if (j>=0 and not dead[j]) else 0
def indeg(i):
    j=prv[i]
    return 1 if (j>=0 and not dead[j]) else 0
passes=0
while True:
    passes+=1
    rem=False
    for i in range(n):
        if not dead[i] and outdeg(i)!=1:
            dead[i]=True; rem=True
    for i in range(n):
        if not dead[i] and indeg(i)==0:
            j=nxt[i]
            if j>=0 and not dead[j] and indeg(j)==0:
                dead[i]=True; rem=True
    if not rem: break
print("prune passes:",passes,"alive:",sum(1 for d in dead if not d),"dead:",sum(dead))
alive=[i for i in range(n) if not dead[i]]
starts=[i for i in alive if indeg(i)==0]
print("starts:",len(starts))
used=[False]*n
contigs=[]
for s in starts:
    if used[s]: continue
    used[s]=True
    seq=[s]; cur=s
    while True:
        j=nxt[cur]
        if j>=0 and not dead[j] and not used[j]:
            used[j]=True; seq.append(j); cur=j
        else: break
    contigs.append(seq)
print("contigs:",len(contigs),"lens:",[len(c) for c in contigs])
print("claimed:",sum(used),"unclaimed alive:",sum(1 for i in alive if not used[i]))
for c in contigs:
    s=(L[c[0]] if L[c[0]]!='F' else '')+''.join(kmers[i] for i in c)+(R[c[-1]] if R[c[-1]]!='F' else '')
    print(len(c), len(s), s[:60])
EOF
