[20.397313, "o", "   '\"'\"'/app/jq_args.yaml'\"'\"' Example format:\r\n\u001b[?2004l\r"]
[20.397331, "o", "\u001b[?2004h> "]
[20.397348, "o", "   ```\r\n\u001b[?2004l\r"]
[20.397364, "o", "\u001b[?2004h> "]
