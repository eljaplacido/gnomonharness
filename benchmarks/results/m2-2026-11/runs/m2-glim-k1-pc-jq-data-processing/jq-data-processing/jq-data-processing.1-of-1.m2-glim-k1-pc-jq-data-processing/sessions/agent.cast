[20.397208, "o", "   - '\"'\"'args'\"'\"': A list of strings, each representing a complete jq argument including both flags and values\r\n\u001b[?2004l\r"]
[20.397223, "o", "\u001b[?2004h"]
[20.397241, "o", ">    \r\n\u001b[?2004l\r"]
