import time, numpy as np, mujoco

REF_PATH = '/app/model_ref.xml'
TOTAL = 2.0
FP = mujoco.mjtState.mjSTATE_FULLPHYSICS
NSEED = 5

ref_xml = open(REF_PATH).read()
INSERT = '<compiler autolimits=\"true\"/>'

def build(block):
    return mujoco.MjModel.from_xml_string(ref_xml.replace(INSERT, INSERT + '\n  ' + block))

def state_of(model, seed):
    data = mujoco.MjData(model)
    nstep = int(TOTAL / model.opt.timestep)
    rng = np.random.default_rng(seed)
    data.qpos += rng.normal(0, 0.01, size=data.qpos.shape)
    mujoco.mj_forward(model, data)
    for _ in range(nstep):
        mujoco.mj_step(model, data)
    st = np.zeros(mujoco.mj_stateSize(model, FP))
    mujoco.mj_getState(model, data, st, FP)
    return st

def mean_time(model, n=6):
    ts = []
    for _ in range(n):
        seed = int(np.random.randint(0, 10000))
        t0 = time.perf_counter()
        state_of(model, seed)
        ts.append(time.perf_counter() - t0)
    return float(np.mean(ts))

ref = mujoco.MjModel.from_xml_path(REF_PATH)
ref_states = [state_of(ref, s) for s in range(NSEED)]
t_ref = mean_time(ref)
print('ref mean time %.4f s' % t_ref)

# Try contact disabled with larger timesteps
CANDS = [
    ('dt.005-nocontact', '<option timestep=\"0.005\"><flag contact=\"disable\"/></option>'),
    ('dt.01-nocontact', '<option timestep=\"0.01\"><flag contact=\"disable\"/></option>'),
    ('dt.0025-nocontact', '<option timestep=\"0.0025\"><flag contact=\"disable\"/></option>'),
    ('dt.0025-if', '<option timestep=\"0.0025\" integrator=\"implicitfast\"/>'),
    ('dt.0025-if-nocontact', '<option timestep=\"0.0025\" integrator=\"implicitfast\"><flag contact=\"disable\"/></option>'),
    ('dt.004-if-nocontact', '<option timestep=\"0.004\" integrator=\"implicitfast\"><flag contact=\"disable\"/></option>'),
    ('dt.005-if-nocontact', '<option timestep=\"0.005\" integrator=\"implicitfast\"><flag contact=\"disable\"/></option>'),
    ('dt.008-if-nocontact', '<option timestep=\"0.008\" integrator=\"implicitfast\"><flag contact=\"disable\"/></option>'),
    ('dt.01-if-nocontact', '<option timestep=\"0.01\" integrator=\"implicitfast\"><flag contact=\"disable\"/></option>'),
    ('dt.0025-imp', '<option timestep=\"0.0025\" integrator=\"implicit\"/>'),
    ('dt.004-imp', '<option timestep=\"0.004\" integrator=\"implicit\"/>'),
]

for name, block in CANDS:
    try:
        m = build(block)
        if mujoco.mj_stateSize(m, FP) != ref_states[0].size:
            print('%-25s STATE SIZE MISMATCH' % name)
            continue
        diffs = []
        bad = False
        for s in range(NSEED):
            st = state_of(m, s)
            if not np.all(np.isfinite(st)):
                bad = True
                break
            diffs.append(float(np.abs(st - ref_states[s]).max()))
        if bad:
            print('%-25s non-finite state' % name)
            continue
        dmax = max(diffs)
        tt = mean_time(m)
        ratio = tt / t_ref
        verdict = 'PASS' if (dmax < 1e-5 and ratio <= 0.55) else ''
        print('%-25s maxdiff=%.3e time=%.4f ratio=%.3f %s' % (name, dmax, tt, ratio, verdict))
    except Exception as exc:
        print('%-25s FAILED: %s' % (name, exc))
