import numpy as np, mujoco

REF_PATH = '/app/model_ref.xml'
MODEL_PATH = '/app/model.xml'
TOTAL = 2.0
FP = mujoco.mjtState.mjSTATE_FULLPHYSICS

ref = mujoco.MjModel.from_xml_path(REF_PATH)
model = mujoco.MjModel.from_xml_path(MODEL_PATH)

def state_of(model, seed):
    data = mujoco.MjData(model)
    nstep = int(TOTAL / model.opt.timestep)
    rng = np.random.default_rng(seed)
    data.qpos += rng.normal(0, 0.01, size=data.qpos.shape)
    mujoco.mj_forward(model, data)
    for _ in range(nstep):
        mujoco.mj_step(model, data)
    st = np.zeros(mujoco.mj_stateSize(model, FP))
    mujoco.mj_getState(model, data, st, FP)
    return st

max_diff = 0
all_finite = True
for s in range(20):
    st_ref = state_of(ref, s)
    st_model = state_of(model, s)
    diff = float(np.abs(st_model - st_ref).max())
    finite = np.all(np.isfinite(st_model))
    if not finite:
        all_finite = False
    max_diff = max(max_diff, diff)
    if s < 5 or s >= 18:
        print(f'seed {s:2d}: maxdiff={diff:.3e}, finite={finite}')

print(f'Overall max diff over 20 seeds: {max_diff:.3e}')
print(f'All finite: {all_finite}')
print(f'Passes atol=1e-5: {max_diff < 1e-5}')
