    Node *n = hash_table[idx];
    while (n) {
        if (n->hash == h && strcmp(n->kmer, kmer) == 0) return n;
        n = n->next;
    }
    n = (Node *)malloc(sizeof(Node));
    memset(n, 0, sizeof(Node));
    strncpy(n->kmer, kmer, MAX_KMER_LEN - 1);
    n->kmer[MAX_KMER_LEN - 1] = '\0';
    n->left_ext = left_ext;
    n->right_ext = right_ext;
    n->forward = NULL;
    n->backward = NULL;
    n->visited = 0;
    n->in_degree = 0;
    n->out_degree = 0;
    n->hash = h;
    n->next = hash_table[idx];
    hash_table[idx] = n;
    node_count++;
    return n;
}

static void add_forward_edge(Node *node, char base) {
    Edge *e = (Edge *)malloc(sizeof(Edge));
    e->base = base;
    e->next = node->forward;
    node->forward = e;
    node->out_degree++;
}

static void add_backward_edge(Node *node, char base) {
    Edge *e = (Edge *)malloc(sizeof(Edge));
    e->base = base;
    e->next = node->backward;
    node->backward = e;
    node->in_degree++;
}

static Node *find_node(const char *kmer) {
    uint64_t h = hash_kmer(kmer);
    int idx = (int)(h & (HASH_SIZE - 1));
    Node *n = hash_table[idx];
    while (n) {
        if (n->hash == h && strcmp(n->kmer, kmer) == 0) return n;
        n = n->next;
    }
    return NULL;
}

int main() {
    FILE *fp = fopen("test", "r");
    char line[256];
    while (fgets(line, sizeof(line), fp)) {
        int len = strlen(line);
        while (len > 0 && (line[len-1] == '\n' || line[len-1] == '\r')) line[--len] = '\0';
        char *tab = strchr(line, '\t');
        if (!tab) continue;
        *tab = '\0';
        char *ext = tab + 1;
        while (*ext == ' ') ext++;
        char left_ext = ext[0];
        char right_ext = ext[1];
        Node *node = find_or_create_node(line, left_ext, right_ext);
        if (right_ext != 'F') add_forward_edge(node, right_ext);
        if (left_ext != 'F') add_backward_edge(node, left_ext);
    }
    fclose(fp);

    Node **nodes = (Node **)malloc(node_count * sizeof(Node *));
    int idx = 0;
    for (int i = 0; i < HASH_SIZE; i++) {
        Node *n = hash_table[i];
        while (n) { nodes[idx++] = n; n = n->next; }
    }

    /* Simulate the exact logic from serial.c */
    int contigs = 0;
    for (int i = 0; i < node_count; i++) {
        Node *start = nodes[i];
        if (start->visited) continue;
        if (start->in_degree != 0) continue;

        char contig[MAX_CONTIG_LEN];
        strcpy(contig, start->kmer);
        int clen = strlen(contig);

        Node *node = start;
        while (node->forward != NULL) {
            Edge *e = node->forward;
            contig[clen] = e->base;
            clen++;
            char next_kmer[MAX_KMER_LEN];
            int klen = strlen(node->kmer);
            memcpy(next_kmer, node->kmer + 1, klen - 1);
            next_kmer[klen - 1] = e->base;
            next_kmer[klen] = '\0';
            node = find_node(next_kmer);
            if (!node) break;
        }

        /* Mark all nodes in this path as visited */
        Node *cur = start;
        int mark_steps = 0;
        while (cur != NULL) {
            cur->visited = 1;
            char next_kmer[MAX_KMER_LEN];
            int klen = strlen(cur->kmer);
            if (cur->forward != NULL) {
                memcpy(next_kmer, cur->kmer + 1, klen - 1);
                next_kmer[klen - 1] = cur->forward->base;
                next_kmer[klen] = '\0';
                cur = find_node(next_kmer);
            } else {
                break;
            }
            mark_steps++;
        }

        contigs++;
        printf("Contig %d: len=%d, mark_steps=%d\n", contigs, clen, mark_steps);
    }

    /* Count remaining */
    int remaining = 0;
    for (int i = 0; i < node_count; i++) {
        if (!nodes[i]->visited) remaining++;
    }
    printf("Remaining unvisited: %d\n", remaining);

    free(nodes);
    return 0;
}
