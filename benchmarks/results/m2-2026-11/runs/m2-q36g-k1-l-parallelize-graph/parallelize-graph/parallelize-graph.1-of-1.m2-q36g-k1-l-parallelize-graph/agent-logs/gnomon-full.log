    n->kmer[MAX_KMER_LEN - 1] = '\0';
    n->left_ext = left_ext;
    n->right_ext = right_ext;
    n->forward = NULL;
    n->visited = 0;
    n->in_degree = 0;
    n->out_degree = 0;
    n->hash = h;
    n->next = hash_table[idx];
    hash_table[idx] = n;
    node_count++;
    return n;
}

int main() {
    FILE *fp = fopen("test", "r");
    char line[256];
    while (fgets(line, sizeof(line), fp)) {
        int len = strlen(line);
        while (len > 0 && (line[len-1] == '\n' || line[len-1] == '\r')) line[--len] = '\0';
        char *tab = strchr(line, '\t');
        if (!tab) continue;
        *tab = '\0';
        char *ext = tab + 1;
        while (*ext == ' ') ext++;
        char left_ext = ext[0];
        char right_ext = ext[1];
        Node *node = find_or_create_node(line, left_ext, right_ext);
        if (right_ext != 'F') node->out_degree++;
        if (left_ext != 'F') node->in_degree++;
