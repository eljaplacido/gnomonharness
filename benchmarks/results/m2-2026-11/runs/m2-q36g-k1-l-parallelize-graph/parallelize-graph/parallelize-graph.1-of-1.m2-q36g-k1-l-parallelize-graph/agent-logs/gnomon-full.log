/*
 * Parallel de Bruijn graph construction and traversal for genome assembly.
 * Uses pthreads for parallelism.
 *
 * Input:  Each line has KMER<TAB>LEFT_EXT RIGHT_EXT
 *         where LEFT_EXT and RIGHT_EXT are single chars: A/C/G/T/F (F = none)
 *
 * Output: Contigs written to /app/pgen_<thread_id>.out, one per line.
 *
 * Algorithm:
 *   1. Read all k-mers and build a shared hash table (separate chaining).
 *      Each node stores: the k-mer string, left extension char, right extension char.
 *   2. Traverse the graph in parallel:
 *      a. Each thread processes a subset of source nodes (in_degree == 0).
 *      b. Follow forward edges to produce contigs.
 *      c. Remaining unvisited nodes (cycles) are handled by remaining threads.
 *   3. Each contig starts with the first k-mer and appends each right extension base.
 */

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>
#include <pthread.h>

#define MAX_KMER_LEN 64
#define MAX_CONTIG_LEN 1000000
#define HASH_SIZE 131071

typedef struct Edge {
    char base;
    struct Edge *next;
} Edge;

typedef struct Node {
    char kmer[MAX_KMER_LEN];
    char left_ext;
    char right_ext;
    Edge *forward;
    Edge *backward;
    int visited;
    int in_degree;
    int out_degree;
    uint64_t hash;
    struct Node *next;
} Node;

static Node *hash_table[HASH_SIZE];
static int node_count = 0;
static pthread_mutex_t hash_mutex = PTHREAD_MUTEX_INITIALIZER;

static uint64_t hash_kmer(const char *s) {
    uint64_t h = 5381;
    int len = strlen(s);
    for (int i = 0; i < len; i++) {
        h = ((h << 5) + h) + (unsigned char)s[i];
    }
    return h;
}

static Node *find_or_create_node(const char *kmer, char left_ext, char right_ext) {
    uint64_t h = hash_kmer(kmer);
    int idx = (int)(h & (HASH_SIZE - 1));

    Node *n = hash_table[idx];
    while (n != NULL) {
        if (n->hash == h && strcmp(n->kmer, kmer) == 0) {
            return n;
        }
        n = n->next;
    }

    n = (Node *)malloc(sizeof(Node));
    memset(n, 0, sizeof(Node));
    strncpy(n->kmer, kmer, MAX_KMER_LEN - 1);
    n->kmer[MAX_KMER_LEN - 1] = '\0';
    n->left_ext = left_ext;
    n->right_ext = right_ext;
    n->forward = NULL;
    n->backward = NULL;
    n->visited = 0;
    n->in_degree = 0;
    n->out_degree = 0;
    n->hash = h;
    n->next = hash_table[idx];
    hash_table[idx] = n;
    node_count++;
    return n;
}

static void add_forward_edge(Node *node, char base) {
    Edge *e = (Edge *)malloc(sizeof(Edge));
    e->base = base;
    e->next = node->forward;
    node->forward = e;
    node->out_degree++;
}

static void add_backward_edge(Node *node, char base) {
    Edge *e = (Edge *)malloc(sizeof(Edge));
    e->base = base;
    e->next = node->backward;
    node->backward = e;
    node->in_degree++;
}

static Node *find_node(const char *kmer) {
    uint64_t h = hash_kmer(kmer);
    int idx = (int)(h & (HASH_SIZE - 1));
    Node *n = hash_table[idx];
    while (n != NULL) {
        if (n->hash == h && strcmp(n->kmer, kmer) == 0) {
            return n;
        }
        n = n->next;
    }
    return NULL;
}

/* Build graph - called by all threads, each processes a subset of lines */
static void build_graph(const char *filename, int thread_id, int num_threads) {
    FILE *fp = fopen(filename, "r");
    if (!fp) {
        fprintf(stderr, "Cannot open file: %s\n", filename);
        exit(1);
    }

    char line[256];
    int line_num = 0;

    /* First pass: count total lines */
    while (fgets(line, sizeof(line), fp)) line_num++;
    rewind(fp);

    /* Second pass: distribute lines among threads */
    int current_line = 0;
    while (fgets(line, sizeof(line), fp)) {
        /* Only process lines assigned to this thread */
        if (current_line % num_threads != thread_id) {
            current_line++;
            continue;
        }

        int len = strlen(line);
        while (len > 0 && (line[len-1] == '\n' || line[len-1] == '\r')) {
            line[--len] = '\0';
        }

        char *tab = strchr(line, '\t');
        if (!tab) { current_line++; continue; }

        *tab = '\0';
        char *kmer = line;
        char *ext = tab + 1;
        while (*ext == ' ') ext++;

        char left_ext = ext[0];
        char right_ext = ext[1];

        pthread_mutex_lock(&hash_mutex);
        Node *node = find_or_create_node(kmer, left_ext, right_ext);
        if (right_ext != 'F') {
            add_forward_edge(node, right_ext);
        }
        if (left_ext != 'F') {
            add_backward_edge(node, left_ext);
        }
        pthread_mutex_unlock(&hash_mutex);

        current_line++;
    }

    fclose(fp);
}

/* Traverse paths from source nodes - called by each thread */
static void traverse_sources(FILE *out, int thread_id, int num_threads, Node **nodes) {
    for (int i = 0; i < node_count; i++) {
        Node *start = nodes[i];
        if (start->visited) continue;
        if (start->in_degree != 0) continue;

        /* Only process sources assigned to this thread */
        if (i % num_threads != thread_id) continue;

        /* Build contig by following forward edges */
        char contig[MAX_CONTIG_LEN];
        strcpy(contig, start->kmer);
        int clen = strlen(contig);

        Node *cur = start;
        while (cur->forward != NULL) {
            Edge *e = cur->forward;
            contig[clen] = e->base;
            clen++;

            char next_kmer[MAX_KMER_LEN];
            int klen = strlen(cur->kmer);
            memcpy(next_kmer, cur->kmer + 1, klen - 1);
            next_kmer[klen - 1] = e->base;
            next_kmer[klen] = '\0';

            cur = find_node(next_kmer);
            if (!cur) break;
        }

        /* Mark all nodes in this path as visited */
        cur = start;
        while (cur != NULL) {
            cur->visited = 1;
            char next_kmer[MAX_KMER_LEN];
            int klen = strlen(cur->kmer);
            if (cur->forward != NULL) {
                memcpy(next_kmer, cur->kmer + 1, klen - 1);
                next_kmer[klen - 1] = cur->forward->base;
                next_kmer[klen] = '\0';
                cur = find_node(next_kmer);
            } else {
                break;
            }
        }

        contig[clen] = '\0';
        fprintf(out, "%s\n", contig);
    }
}

/* Handle remaining unvisited nodes (cycles) */
static void traverse_cycles(FILE *out, int thread_id, int num_threads, Node **nodes) {
    for (int i = 0; i < node_count; i++) {
        Node *start = nodes[i];
        if (start->visited) continue;

        /* Only process nodes assigned to this thread */
        if (i % num_threads != thread_id) continue;

        /* Build contig by following forward edges */
        char contig[MAX_CONTIG_LEN];
        strcpy(contig, start->kmer);
        int clen = strlen(contig);

        Node *cur = start;
        while (cur->forward != NULL) {
            Edge *e = cur->forward;
            contig[clen] = e->base;
            clen++;

            char next_kmer[MAX_KMER_LEN];
            int klen = strlen(cur->kmer);
            memcpy(next_kmer, cur->kmer + 1, klen - 1);
            next_kmer[klen - 1] = e->base;
            next_kmer[klen] = '\0';

            cur = find_node(next_kmer);
            if (!cur) break;
        }

        /* Mark all nodes in this cycle as visited */
        cur = start;
        while (cur != NULL && !cur->visited) {
            cur->visited = 1;
            char next_kmer[MAX_KMER_LEN];
            int klen = strlen(cur->kmer);
            if (cur->forward != NULL) {
                memcpy(next_kmer, cur->kmer + 1, klen - 1);
                next_kmer[klen - 1] = cur->forward->base;
                next_kmer[klen] = '\0';
                Node *next = find_node(next_kmer);
                if (next == start) break;
                cur = next;
            } else {
                break;
            }
        }

        contig[clen] = '\0';
        fprintf(out, "%s\n", contig);
    }
}

typedef struct {
    int thread_id;
    int num_threads;
    const char *filename;
} ThreadArg;

static void *thread_func(void *arg) {
    ThreadArg *ta = (ThreadArg *)arg;
    int tid = ta->thread_id;
    int nthreads = ta->num_threads;

    /* Build graph - each thread processes its assigned lines */
    build_graph(ta->filename, tid, nthreads);

    /* Collect all nodes */
    Node **nodes = (Node **)malloc(node_count * sizeof(Node *));
    int idx = 0;
    for (int i = 0; i < HASH_SIZE; i++) {
        Node *n = hash_table[i];
        while (n) {
            nodes[idx++] = n;
            n = n->next;
        }
    }

    /* Open output file for this thread */
    char outfile[256];
    snprintf(outfile, sizeof(outfile), "/app/pgen_%d.out", tid);
    FILE *out = fopen(outfile, "w");
    if (!out) {
        fprintf(stderr, "Cannot open output file: %s\n", outfile);
        free(nodes);
        return NULL;
    }

    /* Phase 1: Traverse from source nodes */
    traverse_sources(out, tid, nthreads, nodes);

    /* Phase 2: Handle remaining unvisited nodes (cycles) */
    traverse_cycles(out, tid, nthreads, nodes);

    fclose(out);
    free(nodes);

    return NULL;
}

int main(int argc, char *argv[]) {
    if (argc < 2) {
        fprintf(stderr, "Usage: %s <input_file> [num_threads]\n", argv[0]);
        return 1;
    }

    int num_threads = 4;
    if (argc >= 3) {
        num_threads = atoi(argv[2]);
        if (num_threads < 1) num_threads = 1;
    }

    memset(hash_table, 0, sizeof(hash_table));

    pthread_t *threads = (pthread_t *)malloc(num_threads * sizeof(pthread_t));
    ThreadArg *args = (ThreadArg *)malloc(num_threads * sizeof(ThreadArg));

    for (int i = 0; i < num_threads; i++) {
        args[i].thread_id = i;
        args[i].num_threads = num_threads;
        args[i].filename = argv[1];
        pthread_create(&threads[i], NULL, thread_func, &args[i]);
    }

    for (int i = 0; i < num_threads; i++) {
        pthread_join(threads[i], NULL);
    }

    /* Free memory */
    for (int i = 0; i < HASH_SIZE; i++) {
        Node *n = hash_table[i];
        while (n) {
            Node *next = n->next;
            free(n->forward);
            free(n->backward);
            free(n);
            n = next;
        }
    }

    free(threads);
    free(args);
    pthread_mutex_destroy(&hash_mutex);

    return 0;
}
