        }
        contig[clen] = '\0';
        fprintf(out, "%s\n", contig);
    }

    fclose(out);
    free(nodes);
    return NULL;
}

int main(int argc, char *argv[]) {
    if (argc < 2) { fprintf(stderr, "Usage: %s <input_file> [num_threads]\n", argv[0]); return 1; }
    int num_threads = 4;
    if (argc >= 3) { num_threads = atoi(argv[2]); if (num_threads < 1) num_threads = 1; }
    memset(hash_table, 0, sizeof(hash_table));
    pthread_t *threads = (pthread_t *)malloc(num_threads * sizeof(pthread_t));
    ThreadArg *args = (ThreadArg *)malloc(num_threads * sizeof(ThreadArg));
    for (int i = 0; i < num_threads; i++) {
        args[i].thread_id = i;
        args[i].num_threads = num_threads;
        args[i].filename = argv[1];
        pthread_create(&threads[i], NULL, thread_func, &args[i]);
    }
    for (int i = 0; i < num_threads; i++) pthread_join(threads[i], NULL);
    for (int i = 0; i < HASH_SIZE; i++) {
        Node *n = hash_table[i];
        while (n) { Node *next = n->next; free(n->forward); free(n->backward); free(n); n = next; }
    }
    free(threads); free(args);
    pthread_mutex_destroy(&hash_mutex);
    return 0;
}
