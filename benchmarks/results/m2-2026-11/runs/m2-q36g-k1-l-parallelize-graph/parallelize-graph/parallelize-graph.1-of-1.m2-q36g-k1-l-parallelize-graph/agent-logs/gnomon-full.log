#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>

#define MAX_KMER_LEN 64
#define HASH_SIZE 131071

typedef struct Edge {
    char base;
    struct Edge *next;
} Edge;

typedef struct Node {
    char kmer[MAX_KMER_LEN];
    char left_ext;
    char right_ext;
    Edge *forward;
    Edge *backward;
    int in_degree;
    int out_degree;
    uint64_t hash;
    struct Node *next;
} Node;

static Node *hash_table[HASH_SIZE];
static int node_count = 0;

static uint64_t hash_kmer(const char *s) {
    uint64_t h = 5381;
    int len = strlen(s);
    for (int i = 0; i < len; i++) {
        h = ((h << 5) + h) + (unsigned char)s[i];
    }
    return h;
}

static Node *find_or_create_node(const char *kmer, char left_ext, char right_ext) {
    uint64_t h = hash_kmer(kmer);
    int idx = (int)(h & (HASH_SIZE - 1));
    Node *n = hash_table[idx];
    while (n != NULL) {
        if (n->hash == h && strcmp(n->kmer, kmer) == 0) return n;
        n = n->next;
    }
    n = (Node *)malloc(sizeof(Node));
    memset(n, 0, sizeof(Node));
    strncpy(n->kmer, kmer, MAX_KMER_LEN - 1);
    n->kmer[MAX_KMER_LEN - 1] = '\0';
    n->left_ext = left_ext;
    n->right_ext = right_ext;
    n->forward = NULL;
    n->backward = NULL;
    n->in_degree = 0;
    n->out_degree = 0;
    n->hash = h;
    n->next = hash_table[idx];
    hash_table[idx] = n;
    node_count++;
    return n;
}

int main() {
    FILE *fp = fopen("test", "r");
    char line[256];
    while (fgets(line, sizeof(line), fp)) {
        int len = strlen(line);
        while (len > 0 && (line[len-1] == '\n' || line[len-1] == '\r')) line[--len] = '\0';
        char *tab = strchr(line, '\t');
        if (!tab) continue;
        *tab = '\0';
        char *ext = tab + 1;
        while (*ext == ' ') ext++;
        char left_ext = ext[0];
        char right_ext = ext[1];
        Node *node = find_or_create_node(line, left_ext, right_ext);
        if (right_ext != 'F') node->out_degree++;
        if (left_ext != 'F') node->in_degree++;
    }
    fclose(fp);

    int sources = 0, sinks = 0, isolated = 0, cycles = 0, normal = 0;
    for (int i = 0; i < HASH_SIZE; i++) {
        Node *n = hash_table[i];
        while (n) {
            if (n->in_degree == 0 && n->out_degree == 0) isolated++;
            else if (n->in_degree == 0) sources++;
            else if (n->out_degree == 0) sinks++;
            else normal++;
            n = n->next;
        }
    }
    printf("Total nodes: %d\n", node_count);
    printf("Sources (in=0, out>0): %d\n", sources);
    printf("Sinks (in>0, out=0): %d\n", sinks);
    printf("Isolated (in=0, out=0): %d\n", isolated);
    printf("Normal (in>0, out>0): %d\n", normal);
    return 0;
}
