[18.78141, "o", "\u001b[?2004h> "]
[18.78151, "o", "7. Test language detection on the following 10 test samples and save results to '\"'\"'/app/detection_results.json'\"'\"':\r\n\u001b[?2004l\r\u001b[?2004h"]
[18.781542, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
