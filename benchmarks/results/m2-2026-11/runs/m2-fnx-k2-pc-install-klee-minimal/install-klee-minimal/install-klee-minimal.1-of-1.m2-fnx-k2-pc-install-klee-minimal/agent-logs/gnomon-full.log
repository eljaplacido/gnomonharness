import re, os
p = os.path.expanduser('~/.bashrc')
s = open(p).read()

BLOCK = '''# --- KLEE / STP environment (added by build; must stay above the
# --- non-interactive early-return so `source ~/.bashrc` works in scripts) ---
export PATH=/usr/local/bin:$PATH
export CPATH=/usr/local/include${CPATH:+:$CPATH}
export LD_LIBRARY_PATH=/usr/local/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}
# --- end KLEE / STP environment ---
'''

# strip any previous copy of our block (idempotency)
s = re.sub(r'# --- KLEE / STP environment.*?# --- end KLEE / STP environment ---\n', '', s, flags=re.S)

marker = '[ -z "$PS1" ] && return'
assert marker in s, "early-return marker not found"

# insert our block immediately BEFORE the early return, after its comment line
idx = s.index(marker)
# back up over the comment lines that document the early return
head, tail = s[:idx], s[idx:]
lines = head.rstrip('\n').split('\n')
# move trailing comment lines (the "# If not running interactively..." header) after our block
moved = []
while lines and lines[-1].lstrip().startswith('#'):
    moved.insert(0, lines.pop())
head = '\n'.join(lines).rstrip('\n')

s = head + '\n\n' + BLOCK + '\n' + '\n'.join(moved) + ('\n' + tail if moved else tail)
open(p, 'w').write(s)
print("rewritten")
