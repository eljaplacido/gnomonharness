import pathlib, re, html
root = pathlib.Path('.')
pages = sorted(root.rglob('*.html'))
fails = []
def chk(page, label, cond):
    if not cond:
        fails.append(f'{page}: {label}')
        print(f'  FAIL {page}: {label}')

for p in pages:
    t = p.read_text(encoding='utf-8')
    chk(p, 'doctype', t.lstrip().lower().startswith('<!doctype html>'))
    chk(p, 'lang=en', '<html lang="en">' in t)
    chk(p, 'charset utf-8', 'charset="utf-8"' in t.lower())
    chk(p, 'viewport', 'name="viewport"' in t and 'width=device-width' in t)
    chk(p, 'unique title', len(re.findall(r'<title>', t)) == 1 and len(re.search(r'<title>(.*?)</title>', t, re.S).group(1).strip()) > 5)
    chk(p, 'meta description', len(re.findall(r'name="description"', t)) == 1)
    chk(p, 'no canonical', 'rel="canonical"' not in t)
    chk(p, 'skip-link', 'class="skip-link"' in t and 'href="#main"' in t)
    chk(p, 'main#main', 'id="main"' in t)
    for tag in ('header','nav','main','footer'):
        chk(p, f'<{tag}> landmark', f'<{tag}' in t and f'</{tag}>' in t)
    h1 = re.findall(r'<h1[^>]*>(.*?)</h1>', t, re.S)
    chk(p, f'exactly one h1 (got {len(h1)})', len(h1) == 1)
    chk(p, 'favicon link', 'rel="icon"' in t and 'favicon.svg' in t)
    chk(p, 'stylesheet link', 'assets/css/style.css' in t)
    chk(p, 'no inline event handler', not re.search(r'\son(click|load|error|mouse|key)\w*=', t, re.I))
