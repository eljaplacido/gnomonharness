    d['on'] == {'push':{'branches':['main']}, 'workflow_dispatch':None})
chk('concurrency group=pages, cancel-in-progress=false',
    d['concurrency'] == {'group':'pages','cancel-in-progress':False})
jobs = d['jobs']
chk('two jobs: build + deploy', set(jobs) == {'build','deploy'})
chk('deploy needs build', jobs['deploy'].get('needs') == 'build')
chk('deploy environment github-pages', jobs['deploy']['environment']['name'] == 'github-pages')
uses = [s['uses'] for j in jobs.values() for s in j['steps']]
chk('official actions only, pinned to major tags',
    all(u.startswith('actions/') and u.split('@')[1].startswith('v') for u in uses))
chk('exact action set', set(uses) == {'actions/checkout@v4','actions/configure-pages@v5',
