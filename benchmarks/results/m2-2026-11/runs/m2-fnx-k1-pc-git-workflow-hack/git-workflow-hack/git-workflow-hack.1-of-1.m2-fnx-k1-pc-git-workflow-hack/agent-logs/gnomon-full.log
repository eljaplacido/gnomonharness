co = jobs['build']['steps'][0]
chk('checkout persist-credentials: false', co['with']['persist-credentials'] is False)
up = [s for s in jobs['build']['steps'] if s['uses'].startswith('actions/upload-pages-artifact')][0]
chk('upload-pages-artifact path: .', up['with']['path'] == '.')
chk('no npm/node anywhere', not any('npm' in str(s) or 'node' in str(s).lower()
    for j in jobs.values() for s in j['steps']))
chk('no run: steps at all (no shell commands)',
    not any('run' in s for j in jobs.values() for s in j['steps']))
chk('only secrets-free ${{ }} expression (page_url output)',
    [v for j in jobs.values() for s in j.get('steps',[]) for v in s.values()
     if isinstance(v,str) and '${{' in v] == [])
print('RESULT:', 'ALL PASS' if not fails else f'{len(fails)} FAILED: {fails}')
sys.exit(1 if fails else 0)
