import re, pathlib
p = pathlib.Path('assets/css/style.css')
src = p.read_text(encoding='utf-8')

# Split into: banner comments (/* ==== ... ==== */), inline comments, rules, blanks
out, i, lines = [], 0, src.splitlines()
keep_banner = True
while i < len(lines):
    l = lines[i]
    s = l.strip()
    if s.startswith('/* ===='):
        # banner: keep as 3 lines -> collapse to 1
        title = lines[i+1].strip()
        out.append(f'/* ---- {title} ---- */')
        i += 3
        continue
    if s.startswith('/*') and s.endswith('*/'):
        out.append((' ' * (len(l)-len(l.lstrip()))) + s)   # inline comment, keep
        i += 1
        continue
    if not s:
        i += 1
        continue
    if s.endswith('{'):
        sel = s[:-1].strip()
        decls = []
        i += 1
        while i < len(lines) and lines[i].strip() != '}':
            if lines[i].strip():
                decls.append(lines[i].strip())
            i += 1
        i += 1  # skip }
        if len(decls) <= 2:
            out.append(f'{sel} {{ {" ".join(decls)} }}')
        else:
            out.append(sel + ' {')
            out += ['  ' + d for d in decls]
            out.append('}')
        continue
    out.append(l)
    i += 1

# collapse runs of blank lines to one, strip leading/trailing
txt = '\n'.join(out)
txt = re.sub(r'\n{3,}', '\n\n', txt)
txt = re.sub(r'\n+\Z', '\n', txt).lstrip('\n')
p.write_text(txt, encoding='utf-8')
print('rewritten lines:', len(txt.splitlines()))
