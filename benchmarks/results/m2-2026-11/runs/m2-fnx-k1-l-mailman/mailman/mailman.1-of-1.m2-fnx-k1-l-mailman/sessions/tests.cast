[41.863498, "o", "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mtest_join_announce_leave_flow\u001b[39;49;00m():\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"Full flow of user joining, announcing, and leaving the mailing list.\"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        subject = \u001b[33m\"\u001b[39;49;00m\u001b[33mSecret Announcement\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        user = \u001b[33m\"\u001b[39;49;00m\u001b[33malicegray\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        add_user(user)\u001b[90m\u001b[39;49;00m\r\n        mbox_path = \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m/var/mail/\u001b[39;49;00m\u001b[33m{\u001b[39;49;00muser\u001b[33m}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92m_assert_mailbox_exists\u001b[39;49;00m():\u001b[90m\u001b[39;49;00m\r\n            \u001b[94massert\u001b[39;49;00m os.path.exists(mbox_path), \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mMailbox not found: \u001b[39;49;00m\u001b[33m{\u001b[39;49;00mmbox_path\u001b[33m}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92m_assert_not_member\u001b[39;49;00m():\u001b[90m\u001b[39;49;00m\r\n            mlist = get_mlist()\u001b[90m\u001b[39;49;00m\r\n"]
[41.86351, "o", "            user_member = mlist.members.get_member(\u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m{\u001b[39;49;00muser\u001b[33m}\u001b[39;49;00m\u001b[33m@\u001b[39;49;00m\u001b[33m{\u001b[39;49;00mDOMAIN_NAME\u001b[33m}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n            \u001b[94massert\u001b[39;49;00m user_member \u001b[95mis\u001b[39;49;00m \u001b[94mNone\u001b[39;49;00m, \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m{\u001b[39;49;00muser\u001b[33m}\u001b[39;49;00m\u001b[33m is a member: \u001b[39;49;00m\u001b[33m{\u001b[39;49;00muser_member\u001b[33m=}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92m_assert_member\u001b[39;49;00m():\u001b[90m\u001b[39;49;00m\r\n            mlist = get_mlist()\u001b[90m\u001b[39;49;00m\r\n            user_member = mlist.members.get_member(\u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m{\u001b[39;49;00muser\u001b[33m}\u001b[39;49;00m\u001b[33m@\u001b[39;49;00m\u001b[33m{\u001b[39;49;00mDOMAIN_NAME\u001b[33m}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n"]
