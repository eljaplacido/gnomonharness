[41.848691, "o", "\u001b[31m\u001b[1m__________________________________________________________________ test_simple_local_delivery __________________________________________________________________\u001b[0m\r\n\r\n"]
[41.861088, "o", "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mtest_simple_local_delivery\u001b[39;49;00m():\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"Test that postfix can deliver mail to local users\u001b[39;49;00m\r\n    \u001b[33m    and that the email content is accessible in their local mailboxes.\u001b[39;49;00m\r\n    \u001b[33m    \"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        user = \u001b[33m\"\u001b[39;49;00m\u001b[33mbobgreen\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        add_user(user)\u001b[90m\u001b[39;49;00m\r\n        mbox_path = \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m/var/mail/\u001b[39;49;00m\u001b[33m{\u001b[39;49;00muser\u001b[33m}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        subject = \u001b[33m\"\u001b[39;49;00m\u001b[33mDirect Message\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n>       send_email(\u001b[90m\u001b[39;49;00m\r\n            from_addr=\u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m{\u001b[39;49;00muser\u001b[33m}\u001b[39;49;00m\u001b[33m@\u001b[39;49;00m\u001b[33m{\u001b[39;49;00mDOMAIN_NAME\u001b[33m}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\r\n            to_addr=\u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m{\u001b[39;49;00muser\u001b[33m}\u001b[39;49;00m\u001b[33m@\u001b[39;49;00m\u001b[33m{\u001b[39;49;00mDOMAIN_NAME\u001b[33m}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\r\n            subject=subject,\u001b[90m\u001b[39;49;00m\r\n            body=\u001b[33m\"\u001b[39;49;00m\u001b[33mDirect test message\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\r\n        )\u001b[90m\u001b[39;49;00m\r\n\r\n\u001b[1m\u001b[31m/tests/test_outputs.py\u001b[0m:144: \r\n_ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ \r\n\u001b[1m\u001b[31m/tests/test_outputs.py\u001b[0m:90: in send_email\r\n    \u001b[0mserver.send_message(msg)\u001b[90m\u001b[39;49;00m\r\n\u001b[1m\u001b[31m/usr/lib/python3.12/smtplib.py\u001b[0m:975: in send_message\r\n"]
[41.861339, "o", "    \u001b[0m\u001b[94mreturn\u001b[39;49;00m \u001b[96mself\u001b[39;49;00m.sendmail(from_addr, to_addrs, flatmsg, mail_options,\u001b[90m\u001b[39;49;00m\r\n_ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ \r\n\r\nself = <smtplib.SMTP object at 0xf80232fe38f0>, from_addr = 'bobgreen@local.edu', to_addrs = ['bobgreen@local.edu']\r\nmsg = b'Content-Type: text/plain; charset=\"us-ascii\"\\r\\nMIME-Version: 1.0\\r\\nContent-Transfer-Encoding: 7bit\\r\\nSubject: Direct Message\\r\\nFrom: bobgreen@local.edu\\r\\nTo: bobgreen@local.edu\\r\\n\\r\\nDirect test message'\r\nmail_options = (), rcpt_options = ()\r\n\r\n"]
[41.862258, "o", "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92msendmail\u001b[39;49;00m(\u001b[96mself\u001b[39;49;00m, from_addr, to_addrs, msg, mail_options=(),\u001b[90m\u001b[39;49;00m\r\n                 rcpt_options=()):\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"This command performs an entire mail transaction.\u001b[39;49;00m\r\n    \u001b[33m\u001b[39;49;00m\r\n    \u001b[33m    The arguments are:\u001b[39;49;00m\r\n"]
[41.862269, "o", "    \u001b[33m        - from_addr    : The address sending this mail.\u001b[39;49;00m\r\n    \u001b[33m        - to_addrs     : A list of addresses to send this mail to.  A bare\u001b[39;49;00m\r\n    \u001b[33m                         string will be treated as a list with 1 address.\u001b[39;49;00m\r\n    \u001b[33m        - msg          : The message to send.\u001b[39;49;00m\r\n    \u001b[33m        - mail_options : List of ESMTP options (such as 8bitmime) for the\u001b[39;49;00m\r\n    \u001b[33m                         mail command.\u001b[39;49;00m\r\n    \u001b[33m        - rcpt_options : List of ESMTP options (such as DSN commands) for\u001b[39;49;00m\r\n"]
[41.862285, "o", "    \u001b[33m                         all the rcpt commands.\u001b[39;49;00m\r\n    \u001b[33m\u001b[39;49;00m\r\n    \u001b[33m    msg may be a string containing characters in the ASCII range, or a byte\u001b[39;49;00m\r\n    \u001b[33m    string.  A string is encoded to bytes using the ascii codec, and lone\u001b[39;49;00m\r\n    \u001b[33m    \\\\r and \\\\n characters are converted to \\\\r\\\\n characters.\u001b[39;49;00m\r\n"]
[41.862307, "o", "    \u001b[33m\u001b[39;49;00m\r\n    \u001b[33m    If there has been no previous EHLO or HELO command this session, this\u001b[39;49;00m\r\n    \u001b[33m    method tries ESMTP EHLO first.  If the server does ESMTP, message size\u001b[39;49;00m\r\n    \u001b[33m    and each of the specified options will be passed to it.  If EHLO\u001b[39;49;00m\r\n"]
[41.862407, "o", "    \u001b[33m    fails, HELO will be tried and ESMTP options suppressed.\u001b[39;49;00m\r\n    \u001b[33m\u001b[39;49;00m\r\n    \u001b[33m    This method will return normally if the mail is accepted for at least\u001b[39;49;00m\r\n    \u001b[33m    one recipient.  It returns a dictionary, with one entry for each\u001b[39;49;00m\r\n    \u001b[33m    recipient that was refused.  Each entry contains a tuple of the SMTP\u001b[39;49;00m\r\n    \u001b[33m    error code and the accompanying error message sent by the server.\u001b[39;49;00m\r\n    \u001b[33m\u001b[39;49;00m\r\n    \u001b[33m    This method may raise the following exceptions:\u001b[39;49;00m\r\n    \u001b[33m\u001b[39;49;00m\r\n    \u001b[33m     SMTPHeloError          The server didn't reply properly to\u001b[39;49;00m\r\n    \u001b[33m                            the helo greeting.\u001b[39;49;00m\r\n    \u001b[33m     SMTPRecipientsRefused  The server rejected ALL recipients\u001b[39;49;00m\r\n    \u001b[33m                            (no mail was sent).\u001b[39;49;00m\r\n    \u001b[33m     SMTPSenderRefused      The server didn't accept the from_addr.\u001b[39;49;00m\r\n    \u001b[33m     SMTPDataError          The server replied with an unexpected\u001b[39;49;00m\r\n    \u001b[33m                            error code (other than a refusal of\u001b[39;49;00m\r\n    \u001b[33m                            a recipient).\u001b[39;49;00m\r\n    \u001b[33m     SMTPNotSupportedError  The mail_options parameter includes 'SMTPUTF8'\u001b[39;49;00m\r\n    \u001b[33m                            but the SMTPUTF8 extension is not supported by\u001b[39;49;00m\r\n    \u001b[33m                            the server.\u001b[39;49;00m\r\n    \u001b[33m\u001b[39;49;00m\r\n    \u001b[33m    Note: the connection will be open even after an exception is raised.\u001b[39;49;00m\r\n    \u001b[33m\u001b[39;49;00m\r\n    \u001b[33m    Example:\u001b[39;49;00m\r\n    \u001b[33m\u001b[39;49;00m\r\n    \u001b[33m     >>> import smtplib\u001b[39;49;00m\r\n    \u001b[33m     >>> s=smtplib.SMTP(\"localhost\")\u001b[39;49;00m\r\n    \u001b[33m     >>> tolist=[\"one@one.org\",\"two@two.org\",\"three@three.org\",\"four@four.org\"]\u001b[39;49;00m\r\n    \u001b[33m     >>> msg = '''\\\\\u001b[39;49;00m\r\n    \u001b[33m     ... From: Me@my.org\u001b[39;49;00m\r\n    \u001b[33m     ... Subject: testin'...\u001b[39;49;00m\r\n    \u001b[33m     ...\u001b[39;49;00m\r\n    \u001b[33m     ... This is a test '''\u001b[39;49;00m\r\n    \u001b[33m     >>> s.sendmail(\"me@my.org\",tolist,msg)\u001b[39;49;00m\r\n    \u001b[33m     { \"three@three.org\" : ( 550 ,\"User unknown\" ) }\u001b[39;49;00m\r\n    \u001b[33m     >>> s.quit()\u001b[39;49;00m\r\n    \u001b[33m\u001b[39;49;00m\r\n    \u001b[33m    In the above example, the message was accepted for delivery to three\u001b[39;49;00m\r\n    \u001b[33m    of the four addresses, and one was rejected, with the error code\u001b[39;49;00m\r\n    \u001b[33m    550.  If all addresses are accepted, then the method will return an\u001b[39;49;00m\r\n    \u001b[33m    empty dictionary.\u001b[39;49;00m\r\n"]
[41.862461, "o", "    \u001b[33m\u001b[39;49;00m\r\n    \u001b[33m    \"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        \u001b[96mself\u001b[39;49;00m.ehlo_or_helo_if_needed()\u001b[90m\u001b[39;49;00m\r\n        esmtp_opts = []\u001b[90m\u001b[39;49;00m\r\n        \u001b[94mif\u001b[39;49;00m \u001b[96misinstance\u001b[39;49;00m(msg, \u001b[96mstr\u001b[39;49;00m):\u001b[90m\u001b[39;49;00m\r\n            msg = _fix_eols(msg).encode(\u001b[33m'\u001b[39;49;00m\u001b[33mascii\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n        \u001b[94mif\u001b[39;49;00m \u001b[96mself\u001b[39;49;00m.does_esmtp:\u001b[90m\u001b[39;49;00m\r\n            \u001b[94mif\u001b[39;49;00m \u001b[96mself\u001b[39;49;00m.has_extn(\u001b[33m'\u001b[39;49;00m\u001b[33msize\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m):\u001b[90m\u001b[39;49;00m\r\n                esmtp_opts.append(\u001b[33m\"\u001b[39;49;00m\u001b[33msize=\u001b[39;49;00m\u001b[33m%d\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m % \u001b[96mlen\u001b[39;49;00m(msg))\u001b[90m\u001b[39;49;00m\r\n            \u001b[94mfor\u001b[39;49;00m option \u001b[95min\u001b[39;49;00m mail_options:\u001b[90m\u001b[39;49;00m\r\n                esmtp_opts.append(option)\u001b[90m\u001b[39;49;00m\r\n        (code, resp) = \u001b[96mself\u001b[39;49;00m.mail(from_addr, esmtp_opts)\u001b[90m\u001b[39;49;00m\r\n        \u001b[94mif\u001b[39;49;00m code != \u001b[94m250\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\r\n            \u001b[94mif\u001b[39;49;00m code == \u001b[94m421\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\r\n                \u001b[96mself\u001b[39;49;00m.close()\u001b[90m\u001b[39;49;00m\r\n            \u001b[94melse\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\r\n                \u001b[96mself\u001b[39;49;00m._rset()\u001b[90m\u001b[39;49;00m\r\n            \u001b[94mraise\u001b[39;49;00m SMTPSenderRefused(code, resp, from_addr)\u001b[90m\u001b[39;49;00m\r\n        senderrs = {}\u001b[90m\u001b[39;49;00m\r\n        \u001b[94mif\u001b[39;49;00m \u001b[96misinstance\u001b[39;49;00m(to_addrs, \u001b[96mstr\u001b[39;49;00m):\u001b[90m\u001b[39;49;00m\r\n            to_addrs = [to_addrs]\u001b[90m\u001b[39;49;00m\r\n        \u001b[94mfor\u001b[39;49;00m each \u001b[95min\u001b[39;49;00m to_addrs:\u001b[90m\u001b[39;49;00m\r\n            (code, resp) = \u001b[96mself\u001b[39;49;00m.rcpt(each, rcpt_options)\u001b[90m\u001b[39;49;00m\r\n            \u001b[94mif\u001b[39;49;00m (code != \u001b[94m250\u001b[39;49;00m) \u001b[95mand\u001b[39;49;00m (code != \u001b[94m251\u001b[39;49;00m):\u001b[90m\u001b[39;49;00m\r\n                senderrs[each] = (code, resp)\u001b[90m\u001b[39;49;00m\r\n            \u001b[94mif\u001b[39;49;00m code == \u001b[94m421\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\r\n                \u001b[96mself\u001b[39;49;00m.close()\u001b[90m\u001b[39;49;00m\r\n                \u001b[94mraise\u001b[39;49;00m SMTPRecipientsRefused(senderrs)\u001b[90m\u001b[39;49;00m\r\n        \u001b[94mif\u001b[39;49;00m \u001b[96mlen\u001b[39;49;00m(senderrs) == \u001b[96mlen\u001b[39;49;00m(to_addrs):\u001b[90m\u001b[39;49;00m\r\n            \u001b[90m# the server refused all our recipients\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n            \u001b[96mself\u001b[39;49;00m._rset()\u001b[90m\u001b[39;49;00m\r\n>           \u001b[94mraise\u001b[39;49;00m SMTPRecipientsRefused(senderrs)\u001b[90m\u001b[39;49;00m\r\n\u001b[1m\u001b[31mE           smtplib.SMTPRecipientsRefused: {'bobgreen@local.edu': (550, b'5.1.1 <bobgreen@local.edu>: Recipient address rejected: User unknown in local recipient table')}\u001b[0m\r\n\r\n\u001b[1m\u001b[31m/usr/lib/python3.12/smtplib.py\u001b[0m:890: SMTPRecipientsRefused\r\n"]
[41.862475, "o", "--------------------------------------------------------------------- Captured stdout call ---------------------------------------------------------------------\r\nbobgreen added successfully.\r\n\u001b[31m\u001b[1m________________________________________________________________ test_join_announce_leave_flow _________________________________________________________________\u001b[0m\r\n"]
