[20.732639, "o", "    3. Among all departments they work in, at least one has more than 10 students currently enrolled in any classes taught in that department.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[20.732676, "o", "\u001b[?2004h> "]
