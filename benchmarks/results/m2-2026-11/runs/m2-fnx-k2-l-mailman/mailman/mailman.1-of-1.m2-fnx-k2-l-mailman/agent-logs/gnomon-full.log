import mailbox, os, smtplib, subprocess, sys
from email.mime.text import MIMEText
from time import sleep
sys.path.insert(0, '/app')
from mailman.core.initialize import initialize
from mailman.interfaces.listmanager import IListManager
from zope.component import getUtility

DOMAIN='local.edu'; LIST='reading-group@local.edu'
initialize('/etc/mailman3/mailman.cfg')
lm=getUtility(IListManager)

def send(*,body,subject,frm,to):
    m=MIMEText(body); m['Subject']=subject; m['From']=frm; m['To']=to
    with smtplib.SMTP('127.0.0.1',25) as s: s.send_message(m)

def wait(fn,tries=30,d=1):
    for i in range(tries):
        try: return fn()
        except AssertionError as e:
            if i==tries-1: raise
            sleep(d)

# --- subscriber 1 joins (pre-confirmed via direct add is NOT what we test;
# use the real mail flow)
u1=os.urandom(6).hex(); u2=os.urandom(6).hex()
for u in (u1,u2): subprocess.run(['useradd',u],check=True)

for u in (u1,u2):
    send(body='',subject='',frm=f'{u}@{DOMAIN}',to='reading-group-join@local.edu')
print('join requests sent for',u1,u2)

def member(u):
    m=lm.get(LIST); assert m.members.get_member(f'{u}@{DOMAIN}'), u
    return True

# confirm both
for u in (u1,u2):
    wait(lambda u=u: os.path.exists(f'/var/mail/{u}'))
    mbox=mailbox.mbox(f'/var/mail/{u}')
    c=[m for m in mbox if (m.get('From') or '').startswith('reading-group-confirm')]
    assert c, f'no confirm for {u}'
    send(body='',subject='',frm=f'{u}@{DOMAIN}',to=c[-1]['From'])
    print(f'{u} confirmed')

wait(lambda: member(u1)); wait(lambda: member(u2))
print('BOTH ARE MEMBERS -> join flow OK')

# --- announcement
SUBJ='ANNOUNCE-'+os.urandom(4).hex()
send(body='Chapter 7 discussion tonight',subject=SUBJ,frm='someone@{d}'.format(d=DOMAIN),to=LIST)
print('announcement posted from a NON-member')

def got(u):
    mbox=mailbox.mbox(f'/var/mail/{u}')
    assert any(m.get('Subject')==SUBJ for m in mbox), f'{u} did not get announcement'
wait(lambda: got(u1)); wait(lambda: got(u2))
print('BOTH SUBSCRIBERS RECEIVED THE ANNOUNCEMENT -> post flow OK')

# --- leave flow for u1
send(body='',subject='',frm=f'{u1}@{DOMAIN}',to='reading-group-leave@local.edu')
print('leave request sent for',u1)
def notmember(u):
    m=lm.get(LIST); assert m.members.get_member(f'{u}@{DOMAIN}') is None, f'{u} still a member'
    return True
# wait for the leave confirmation mail to arrive
def leave_confirm(u):
    mbox=mailbox.mbox(f'/var/mail/{u}')
    c=[m for m in mbox if (m.get('From') or '').startswith('reading-group-confirm')
       and 'leave' in (m.get('Subject') or '').lower()]
    assert c, 'no leave confirmation yet'
    return c[-1]['From']
addr=wait(lambda: leave_confirm(u1))
print('leave confirmation received from', addr)
send(body='',subject='',frm=f'{u1}@{DOMAIN}',to=addr)
wait(lambda: notmember(u1))
print('USER LEFT AFTER CONFIRMATION -> leave flow OK')

# u2 still subscribed
assert lm.get(LIST).members.get_member(f'{u2}@{DOMAIN}'), 'u2 should still be a member'
print('remaining member intact:', u2)
print('\nALL EXTRA CHECKS PASSED')
EOF
