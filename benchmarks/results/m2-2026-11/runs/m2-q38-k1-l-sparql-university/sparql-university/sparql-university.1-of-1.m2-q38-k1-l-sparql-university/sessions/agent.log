q = """
PREFIX uni: <http://university.org/ontology/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?prof ?dept ?course ?student ?enroll ?grad
WHERE {
  ?prof uni:worksIn ?dept .
  ?course uni:isTaughtIn ?dept .
  ?student uni:isEnrolledIn ?course .
  OPTIONAL { ?student uni:hasEnrollmentDate ?enroll }
  OPTIONAL { ?student uni:hasGraduationDate ?grad }
  FILTER(?prof = uni:Orfeas_Menis)
}
"""
for row in g.query(q):
