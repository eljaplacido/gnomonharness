import time, re
import mujoco, numpy as np
BASE=open('/app/model_ref.xml').read()

def build(opt):
    xml = BASE.replace('<compiler', f'<option {opt}/>\n  <compiler',1) if opt else BASE
    try: return mujoco.MjModel.from_xml_string(xml)
    except Exception as e:
        print('  BUILD FAIL:', str(e).split('\n')[0]); return None

def sim(model, seed):
    data = mujoco.MjData(model)
    nstep = int(2.0/model.opt.timestep)
    rng = np.random.default_rng(seed)
    data.qpos += rng.normal(0,0.01,size=data.qpos.shape)
    mujoco.mj_forward(model,data)
    t0=time.perf_counter()
    for _ in range(nstep): mujoco.mj_step(model,data)
    t1=time.perf_counter()
    s=np.zeros(mujoco.mj_stateSize(model,mujoco.mjtState.mjSTATE_FULLPHYSICS))
    mujoco.mj_getState(model,data,s,mujoco.mjtState.mjSTATE_FULLPHYSICS)
    return s, t1-t0

SEEDS=list(range(10))
ref=build(None)
RS={}; RT=[]
for s in SEEDS:
    st,t=sim(ref,s); RS[s]=st; RT.append(t)
REF_T=np.mean(RT)
print('ref avg %.4f'%REF_T)

def ev(opt, seeds=SEEDS, label=None):
    m=build(opt)
    if m is None: return
    worst=0; times=[]; bad=''
    for s in seeds:
        st,t=sim(m,s); times.append(t)
        if np.isnan(st).any() or np.isinf(st).any(): bad='NONFINITE'; worst=float('inf'); break
        worst=max(worst, np.abs(st-RS[s]).max())
    print(f'{(label or opt):60s} maxerr={worst:.3e} pct={np.mean(times)/REF_T:.3f} {bad}')

print('--- solver / ls knobs at ts=0.002 ---')
