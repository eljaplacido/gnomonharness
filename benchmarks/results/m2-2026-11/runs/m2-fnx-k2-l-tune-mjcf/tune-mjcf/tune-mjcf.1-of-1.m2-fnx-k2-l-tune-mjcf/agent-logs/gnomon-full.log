import time, sys
import mujoco, numpy as np

def build(ts=None, **opt):
    xml = open('/app/model_ref.xml').read()
    repl = f'<option timestep="{ts}"'
    for k,v in opt.items(): repl += f' {k}="{v}"'
    repl += '/>'
    if '<option' in xml:
        import re
        xml = re.sub(r'<option[^>]*/>', repl, xml)
    else:
        xml = xml.replace('<compiler', repl + '\n  <compiler')
    return mujoco.MjModel.from_xml_string(xml)

def sim(model, seed):
    data = mujoco.MjData(model)
    nstep = int(2.0/model.opt.timestep)
    rng = np.random.default_rng(seed)
    data.qpos += rng.normal(0,0.01,size=data.qpos.shape)
    mujoco.mj_forward(model,data)
    t0=time.perf_counter()
    for _ in range(nstep): mujoco.mj_step(model,data)
    t1=time.perf_counter()
    s=np.zeros(mujoco.mj_stateSize(model,mujoco.mjtState.mjSTATE_FULLPHYSICS))
    mujoco.mj_getState(model,data,s,mujoco.mjtState.mjSTATE_FULLPHYSICS)
    return s, t1-t0

ref = build()
seed=42
sref, tref = sim(ref, seed)
print(f'ref ts={ref.opt.timestep} t={tref:.4f}')
for ts in [0.004,0.005,0.008,0.01,0.02]:
    m = build(ts=ts)
    s,t = sim(m, seed)
    d = np.linalg.norm(s-sref)
    mx = np.abs(s-sref).max()
    print(f'ts={ts} t={t:.4f} pct={t/tref:.2f} ||d||={d:.3e} max={mx:.3e} nan={np.isnan(s).any()} inf={np.isinf(s).any()}')
EOF
