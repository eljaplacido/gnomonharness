import time, itertools, re
import mujoco, numpy as np

BASE = open('/app/model_ref.xml').read()

def build(optstr):
    xml = BASE.replace('<compiler', f'<option {optstr}/>\n  <compiler', 1) if '<option' not in BASE else re.sub(r'<option[^>]*/>', f'<option {optstr}/>', BASE)
    try:
        return mujoco.MjModel.from_xml_string(xml)
    except Exception as e:
        print('BUILD FAIL', optstr, e); return None

def sim(model, seed):
    data = mujoco.MjData(model)
    nstep = int(2.0/model.opt.timestep)
    rng = np.random.default_rng(seed)
    data.qpos += rng.normal(0,0.01,size=data.qpos.shape)
    mujoco.mj_forward(model,data)
    t0=time.perf_counter()
    for _ in range(nstep): mujoco.mj_step(model,data)
    t1=time.perf_counter()
    s=np.zeros(mujoco.mj_stateSize(model,mujoco.mjtState.mjSTATE_FULLPHYSICS))
    mujoco.mj_getState(model,data,s,mujoco.mjtState.mjSTATE_FULLPHYSICS)
    return s, t1-t0

SEEDS = list(range(12))
ref = build('timestep="0.002"')
refstates = {}
reftimes=[]
for s in SEEDS:
    st,t = sim(ref,s); refstates[s]=st; reftimes.append(t)
print('ref avg', np.mean(reftimes))

def evaluate(optstr, seeds=SEEDS):
    m = build(optstr)
    if m is None: return None
    worst=0; times=[]
    for s in seeds:
        st,t = sim(m,s); times.append(t)
        if np.isnan(st).any() or np.isinf(st).any():
            return (float('inf'), np.mean(times), 'NONFINITE')
        worst=max(worst, np.abs(st-refstates[s]).max())
    return (worst, np.mean(times)/np.mean(reftimes), '')

cands = [
 'timestep="0.002"',
 'timestep="0.002" iterations="1" tolerance="1e-12"',
 'timestep="0.002" iterations="10" tolerance="1e-8"',
 'timestep="0.002" iterations="30" tolerance="1e-8"',
 'timestep="0.002" iterations="50" tolerance="1e-8"',
 'timestep="0.002" solver="0"',
 'timestep="0.002" solver="1"',
 'timestep="0.002" solver="2" ls_iterations="5"',
 'timestep="0.002" cone="1"',
 'timestep="0.002" integrator="1"',
 'timestep="0.002" integrator="2"',
 'timestep="0.002" noslip_iterations="0"',
 'timestep="0.004"',
 'timestep="0.005"',
]
for c in cands:
    r = evaluate(c)
    if r: print(f'{c:55s} maxerr={r[0]:.3e} timepct={r[1]:.3f} {r[2]}')
EOF
