BASE=open('/app/model_ref.xml').read()
def build(ts, **kw):
    o=f'timestep="{ts}"'
    for k,v in kw.items(): o+=f' {k}="{v}"'
    return mujoco.MjModel.from_xml_string(BASE.replace('<compiler', f'<option {o}/>\n  <compiler',1))
def sim(model, seed):
    data = mujoco.MjData(model)
    nstep = int(round(2.0/model.opt.timestep))
    rng = np.random.default_rng(seed)
    data.qpos += rng.normal(0,0.01,size=data.qpos.shape)
    mujoco.mj_forward(model,data)
    t0=time.perf_counter()
    for _ in range(nstep): mujoco.mj_step(model,data)
    t1=time.perf_counter()
    s=np.zeros(mujoco.mj_stateSize(model,mujoco.mjtState.mjSTATE_FULLPHYSICS))
    mujoco.mj_getState(model,data,s,mujoco.mjtState.mjSTATE_FULLPHYSICS)
    return s, t1-t0
