#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>
#include <time.h>
#define K 19
#define BUCKETS 65536
typedef struct Node { char kmer[K+1]; char L,R; int next,fwd,in_deg,visited; } Node;
static Node *nodes; static int *head; static int n_nodes;
static unsigned long hash(const char *s){unsigned long h=1469598103934665603UL;while(*s){h^=(unsigned char)*s++;h*=1099511628211UL;}return h;}
static int find_node(const char *s){int b=hash(s)%BUCKETS;for(int i=head[b];i!=-1;i=nodes[i].next)if(memcmp(nodes[i].kmer,s,K+1)==0)return i;return -1;}
static int insert_node(const char *s,char L,char R){int i=find_node(s);if(i!=-1)return i;i=n_nodes++;memcpy(nodes[i].kmer,s,K+1);nodes[i].L=L;nodes[i].R=R;nodes[i].next=head[hash(s)%BUCKETS];head[hash(s)%BUCKETS]=i;nodes[i].fwd=-1;nodes[i].in_deg=0;nodes[i].visited=0;return i;}
static int cmp_nodes(const void *a,const void *b){return strcmp(nodes[(int)(intptr_t)a].kmer,nodes[(int)(intptr_t)b].kmer);}
int main(int argc,char**argv){
 const char*in=argc>1?argv[1]:"test";
 FILE*f=fopen(in,"r"); if(!f)return 1;
 nodes=calloc(BUCKETS*4,sizeof(Node)); head=malloc(BUCKETS*sizeof(int));
 for(int i=0;i<BUCKETS;i++)head[i]=-1;
 char line[128];
 while(fgets(line,sizeof line,f)){char*tab=strchr(line,'\t');if(!tab)continue;*tab=0;if(strlen(line)!=K)continue;insert_node(line,tab[1],tab[2]);}
 fclose(f);
 fprintf(stderr,"nodes=%d\n",n_nodes);
 for(int i=0;i<n_nodes;i++){char buf[K+1];
  if(nodes[i].R!='F'){memcpy(buf,nodes[i].kmer+1,K-1);buf[K-1]=nodes[i].R;buf[K]=0;int j=find_node(buf);if(j!=-1){nodes[i].fwd=j;nodes[j].in_deg++;}}
  if(nodes[i].L!='F'){buf[0]=nodes[i].L;memcpy(buf+1,nodes[i].kmer,K-1);buf[K]=0;int j=find_node(buf);if(j!=-1)nodes[i].in_deg++;}}
 fprintf(stderr,"edges done\n");
 int*starts=malloc(n_nodes*sizeof(int));int n_starts=0;
 for(int i=0;i<n_nodes;i++)if(nodes[i].in_deg==0)starts[n_starts++]=i;
 qsort(starts,n_starts,sizeof(int),cmp_nodes);
 fprintf(stderr,"starts=%d\n",n_starts);
 FILE*o=fopen("/app/serial.out","w");
 char contig[1<<20]; int n_contigs=0;
 for(int s=0;s<n_starts;s++){int i=starts[s];if(nodes[i].visited)continue;
  int len=0;memcpy(contig,nodes[i].kmer,K);len=K;
  while(!nodes[i].visited){nodes[i].visited=1;int j=nodes[i].fwd;if(j==-1)break;contig[len++]=nodes[j].kmer[K-1];i=j;}
  contig[len]=0;fputs(contig,o);fputc('\n',o);fflush(o);n_contigs++;
  fprintf(stderr,"contig %d len %d\n",n_contigs,len);}
 int*all=malloc(n_nodes*sizeof(int));for(int i=0;i<n_nodes;i++)all[i]=i;
 qsort(all,n_nodes,sizeof(int),cmp_nodes);
 fprintf(stderr,"cycle phase\n");
 for(int s=0;s<n_nodes;s++){int i=all[s];if(nodes[i].visited)continue;
  int len=0;memcpy(contig,nodes[i].kmer,K);len=K;
  while(!nodes[i].visited){nodes[i].visited=1;int j=nodes[i].fwd;if(j==-1)break;contig[len++]=nodes[j].kmer[K-1];i=j;}
  contig[len]=0;fputs(contig,o);fputc('\n',o);fflush(o);n_contigs++;
  fprintf(stderr,"contig %d len %d\n",n_contigs,len);}
 fclose(o);fprintf(stderr,"done contigs=%d\n",n_contigs);return 0;}
EOF
