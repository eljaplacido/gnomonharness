[22.279352, "o", "> "]
[22.279373, "o", "     - \"--argjson min_count 5\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[22.2794, "o", "     - \"--tab\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[22.279423, "o", "   ```\r\n\u001b[?2004l\r\u001b[?2004h>    \r\n\u001b[?2004l\r\u001b[?2004h"]
[22.279448, "o", "> "]
[22.279503, "o", "   '\"'\"'/app/jq_args.yaml'\"'\"' will be used to construct and execute a single jq command as follows:\r\n\u001b[?2004l\r\u001b[?2004h"]
[22.27951, "o", "> "]
[22.279631, "o", "   `jq $(yq -r '\"'\"'.args[]'\"'\"' /app/jq_args.yaml) \"$(yq -r '\"'\"'.filter'\"'\"' /app/jq_args.yaml)\" /app/users.json > /app/active_users_report.json`\r\n\u001b[?2004l\r"]
[22.279645, "o", "\u001b[?2004h>    \r\n\u001b[?2004l\r"]
[22.279678, "o", "\u001b[?2004h> "]
[22.279706, "o", "   For the example above, the constructed command would be:\r\n\u001b[?2004l\r"]
[22.27972, "o", "\u001b[?2004h> "]
[22.279824, "o", "   `jq --unbuffered --argjson min_count 5 --tab '\"'\"'group_by(.address.city)'\"'\"' /app/users.json > /app/active_users_report.json`\r\n\u001b[?2004l\r"]
[22.279831, "o", "\u001b[?2004h"]
