[22.279043, "o", "\u001b[?2004h"]
[22.279046, "o", "> "]
[22.279147, "o", "   - '\"'\"'args'\"'\"': A list of strings, each representing a complete jq argument including both flags and values\r\n\u001b[?2004l\r\u001b[?2004h"]
[22.279154, "o", ">    \r\n\u001b[?2004l\r"]
[22.27919, "o", "\u001b[?2004h> "]
[22.27922, "o", "   '\"'\"'/app/jq_args.yaml'\"'\"' Example format:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[22.279232, "o", "   ```\r\n\u001b[?2004l\r\u001b[?2004h> "]
