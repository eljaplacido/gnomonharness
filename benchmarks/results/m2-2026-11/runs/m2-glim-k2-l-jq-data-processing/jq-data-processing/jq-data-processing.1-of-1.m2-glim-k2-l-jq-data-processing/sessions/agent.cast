[22.28023, "o", "   5. jq will be executed exactly once with all these components\r\n\u001b[?2004l\r\u001b[?2004h"]
[22.280274, "o", ">    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[22.280291, "o", "   Requirements for the YAML file:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[22.280384, "o", "   - The '\"'\"'args'\"'\"' list should contain complete jq arguments, with both flags and their values (if any)\r\n\u001b[?2004l\r"]
[22.280391, "o", "\u001b[?2004h> "]
[22.280444, "o", "   - Each argument should be a separate string in the list\r\n\u001b[?2004l\r"]
[22.280452, "o", "\u001b[?2004h> "]
[22.280536, "o", "   - For flag-only arguments, include just the flag (e.g., '\"'\"'--unbuffered'\"'\"', '\"'\"'--tab'\"'\"')\r\n\u001b[?2004l\r"]
[22.280544, "o", "\u001b[?2004h> "]
[22.280652, "o", "   - For arguments with values, include both the flag and value as a single string (e.g., '\"'\"'--argjson min_count 5'\"'\"')\r\n\u001b[?2004l\r\u001b[?2004h"]
[22.280661, "o", "> "]
[22.280738, "o", "   - Do not include the jq command itself, the filter expression, or file paths in the args list\r\n\u001b[?2004l\r"]
[22.280751, "o", "\u001b[?2004h> "]
[22.280877, "o", "   - File paths other than the required input file '\"'\"'/app/users.json'\"'\"' and output redirections should not appear in the args\r\n\u001b[?2004l\r\u001b[?2004h"]
[22.280914, "o", "> "]
[22.280955, "o", "   - The filter should be a single string containing the complete jq filter expression\r\n\u001b[?2004l\r"]
[22.280969, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[22.280978, "o", "\u001b[?2004h> "]
[22.281194, "o", "**Note on examples below**: In the following Data Schema sections, all content following the '\"'\"'#'\"'\"' symbol is just explanatory commentary and will NOT appear in the actual JSON files. These comments are only provided to clarify the structure and requirements.\r\n\u001b[?2004l\r"]
[22.281208, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[22.281222, "o", "\u001b[?2004h"]
[22.281231, "o", "> "]
[22.281247, "o", "**Input Data Schema**:\r\n\u001b[?2004l\r"]
[22.281259, "o", "\u001b[?2004h> "]
[22.281344, "o", "The input JSON file '\"'\"'/app/users.json'\"'\"' is an array of user objects with the following structure:\r\n\u001b[?2004l\r"]
[22.281368, "o", "\u001b[?2004h> [\r\n\u001b[?2004l\r\u001b[?2004h> "]
[22.281391, "o", "  {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[22.28144, "o", "    \"id\": 1,                  # Unique numeric identifier for the user\r\n\u001b[?2004l\r"]
[22.281459, "o", "\u001b[?2004h> "]
[22.281508, "o", "    \"username\": \"john_doe\",   # User'\"'\"'s unique username (string)\r\n\u001b[?2004l\r"]
[22.28152, "o", "\u001b[?2004h> "]
[22.281583, "o", "    \"email\": \"john@example.com\",  # User'\"'\"'s email address (string)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[22.281655, "o", "    \"status\": \"active\",       # User status: '\"'\"'active'\"'\"' or '\"'\"'inactive'\"'\"'\r\n\u001b[?2004l\r"]
[22.281664, "o", "\u001b[?2004h> "]
[22.281756, "o", "    \"last_login\": \"2024-10-02T20:59:10.109812Z\",  # ISO 8601 timestamp (UTC) of the last login\r\n\u001b[?2004l\r\u001b[?2004h"]
[22.28179, "o", "> "]
[22.281839, "o", "    \"roles\": [\"admin\", \"editor\"]  # Array of roles assigned to the user (may be empty)\r\n\u001b[?2004l\r"]
[22.281889, "o", "\u001b[?2004h>   },\r\n\u001b[?2004l\r"]
[22.28192, "o", "\u001b[?2004h>   ...\r\n\u001b[?2004l\r\u001b[?2004h> ]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[22.281926, "o", "**Output Data Schema**:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[22.282035, "o", "The output JSON file '\"'\"'/app/active_users_report.json'\"'\"' must be an array of objects with the following structure:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[22.282043, "o", "[\r\n\u001b[?2004l\r"]
[22.282082, "o", "\u001b[?2004h>   {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[22.282129, "o", "    \"user_id\": 1,                 # Derived from '\"'\"'id'\"'\"' in input \r\n\u001b[?2004l\r"]
[22.282153, "o", "\u001b[?2004h> "]
[22.282192, "o", "    \"username\": \"john_doe\",       # Retained from input \r\n\u001b[?2004l\r\u001b[?2004h"]
[22.2822, "o", "> "]
[22.282247, "o", "    \"email\": \"john@example.com\",  # Retained from input \r\n\u001b[?2004l\r"]
[22.282256, "o", "\u001b[?2004h> "]
[22.282329, "o", "    \"last_login\": \"2024-10-02\",   # Formatted from '\"'\"'last_login'\"'\"' in input\r\n\u001b[?2004l\r\u001b[?2004h> "]
[22.282393, "o", "    \"role_count\": 2,              # Count of '\"'\"'roles'\"'\"' from input\r\n\u001b[?2004l\r"]
[22.282402, "o", "\u001b[?2004h> "]
[22.282492, "o", "    \"primary_role\": \"admin\"       # If '\"'\"'roles'\"'\"' is empty, this must be null (JSON null, not \"null\")\r\n\u001b[?2004l\r"]
[22.282506, "o", "\u001b[?2004h>   },\r\n\u001b[?2004l\r"]
[22.282518, "o", "\u001b[?2004h> "]
[22.28253, "o", "  ...\r\n\u001b[?2004l\r\u001b[?2004h"]
[22.282539, "o", "> ]\r\n\u001b[?2004l\r"]
[22.282548, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[22.282558, "o", "\u001b[?2004h> "]
[22.28257, "o", "**Requirements**:\r\n\u001b[?2004l\r"]
[22.282586, "o", "\u001b[?2004h> "]
[22.282687, "o", "- You must use jq to perform this transformation. Using other programming languages (e.g., Python, Ruby) is strictly prohibited.\r\n\u001b[?2004l\r"]
[22.282696, "o", "\u001b[?2004h> "]
