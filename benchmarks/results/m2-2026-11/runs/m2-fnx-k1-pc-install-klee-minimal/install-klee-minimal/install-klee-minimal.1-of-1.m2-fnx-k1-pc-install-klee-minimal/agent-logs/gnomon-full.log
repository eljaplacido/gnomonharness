#!/bin/sh
set -x
export DEBIAN_FRONTEND=noninteractive
SRC=/opt/klee-build/klee
BLD=/opt/klee-build/klee-build

python3 -c 'import tabulate' 2>/dev/null || apt-get install -y python3-tabulate

cmake -G Ninja -B "$BLD" -S "$SRC" \
  -DCMAKE_BUILD_TYPE=Release \
  -DCMAKE_INSTALL_PREFIX=/usr/local \
  -DLLVM_CONFIG_BINARY=/usr/bin/llvm-config-16 \
  -DLLVM_DIR=/usr/lib/llvm-16/lib/cmake/llvm \
  -DCMAKE_PREFIX_PATH="/usr/local;/usr/lib/llvm-16" \
  -DSTP_DIR=/usr/local/lib/cmake/STP \
  -DENABLE_SOLVER_STP=ON \
  -DENABLE_SOLVER_Z3=OFF \
  -DENABLE_KLEE_UCLIBC=OFF \
  -DENABLE_POSIX_RUNTIME=ON \
  -DENABLE_UNIT_TESTS=OFF \
  -DENABLE_SYSTEM_TESTS=OFF \
  -DENABLE_KLEE_LIBCXX=OFF \
  -DUSE_TCMALLOC=ON
cfg=$?
echo "CONFIGURE_EXIT=$cfg"
[ $cfg -ne 0 ] && { echo $cfg > /opt/klee-build/logs/klee.rc; exit $cfg; }

ninja -C "$BLD" -j8
build=$?
echo "BUILD_EXIT=$build"
[ $build -ne 0 ] && { echo $build > /opt/klee-build/logs/klee.rc; exit $build; }

ninja -C "$BLD" install
inst=$?
