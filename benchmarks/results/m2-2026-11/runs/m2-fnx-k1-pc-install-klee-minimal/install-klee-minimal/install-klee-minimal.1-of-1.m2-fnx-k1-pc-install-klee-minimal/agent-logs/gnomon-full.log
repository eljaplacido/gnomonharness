      ts[0].tv_nsec = 1000L * times[0].tv_usec;
      ts[1].tv_sec  = times[1].tv_sec;
      ts[1].tv_nsec = 1000L * times[1].tv_usec;
    }
    return syscall(__NR_utimensat, (long)fd,
                   (path ? __concretize_string(path) : NULL),
                   times ? ts : NULL, 0);
  }
#else
  return syscall(__NR_futimesat, (long)fd,
                 (path ? __concretize_string(path) : NULL), times);
#endif""")

# 5. stat -> newfstatat
sub_once("    return syscall(__NR_stat, __concretize_string(path), buf);",
"""#if defined(__aarch64__) && !defined(__NR_stat)
    return syscall(__NR_newfstatat, AT_FDCWD, __concretize_string(path), buf, 0);
#else
    return syscall(__NR_stat, __concretize_string(path), buf);
#endif""")

# 6. lstat -> newfstatat AT_SYMLINK_NOFOLLOW
sub_once("    return syscall(__NR_lstat, __concretize_string(path), buf);",
"""#if defined(__aarch64__) && !defined(__NR_lstat)
    return syscall(__NR_newfstatat, AT_FDCWD, __concretize_string(path), buf,
                   AT_SYMLINK_NOFOLLOW);
#else
    return syscall(__NR_lstat, __concretize_string(path), buf);
#endif""")

# 7. chmod -> fchmodat
sub_once("  return syscall(__NR_chmod, __concretize_string(path), mode);",
"""#if defined(__aarch64__) && !defined(__NR_chmod)
  return syscall(__NR_fchmodat, AT_FDCWD, __concretize_string(path), mode, 0);
#else
  return syscall(__NR_chmod, __concretize_string(path), mode);
#endif""")

# 8. chown -> fchownat  (appears twice)
assert s.count("  return syscall(__NR_chown, __concretize_string(path), owner, group);")==2
s=s.replace("  return syscall(__NR_chown, __concretize_string(path), owner, group);",
"""#if defined(__aarch64__) && !defined(__NR_chown)
  return syscall(__NR_fchownat, AT_FDCWD, __concretize_string(path), owner, group, 0);
#else
  return syscall(__NR_chown, __concretize_string(path), owner, group);
#endif""")

# 9. readlink -> readlinkat
sub_once("  return syscall(__NR_readlink, path, buf, bufsize);",
"""#if defined(__aarch64__) && !defined(__NR_readlink)
  return syscall(__NR_readlinkat, AT_FDCWD, path, buf, bufsize);
#else
  return syscall(__NR_readlink, path, buf, bufsize);
#endif""")

# 10. select -> pselect6
sub_once("""    int r = syscall(__NR_select, os_nfds, 
                    &os_read, &os_write, &os_except, &tv);""",
"""#if defined(__aarch64__) && !defined(__NR_select)
    struct timespec pts = { 0, 0 };
    int r = syscall(__NR_pselect6, os_nfds,
                    &os_read, &os_write, &os_except, &pts, NULL);
#else
    int r = syscall(__NR_select, os_nfds, 
                    &os_read, &os_write, &os_except, &tv);
#endif""")

assert s!=orig
open(p,'w').write(s)
print("patched OK, %d bytes added" % (len(s)-len(orig)))
