import subprocess
from fractions import Fraction
def ref(n):  # Binet via exact integer arithmetic (independent of the loop impl)
    # use fast doubling instead, structurally different from the linear loop
    def fd(n):
        if n == 0: return (0,1)
        a,b = fd(n>>1)
        c = a*(2*b-a)
        d = a*a+b*b
        return (c,d) if n%2==0 else (d,c+d)
    return fd(n)[0]
bad=0
for n in list(range(0,200))+[500,1000]:
    p=int(subprocess.run(["python3","main.py.c",str(n)],capture_output=True,text=True).stdout)
    r=ref(n)
    if p!=r: print("PY MISMATCH",n,p,r); bad+=1
for n in range(0,93):
    c=int(subprocess.run(["./cmain",str(n)],capture_output=True,text=True).stdout)
    if c!=ref(n): print("C MISMATCH",n,c,ref(n)); bad+=1
print("mismatches:",bad,"checked python 0-199,500,1000 / c 0-92")
