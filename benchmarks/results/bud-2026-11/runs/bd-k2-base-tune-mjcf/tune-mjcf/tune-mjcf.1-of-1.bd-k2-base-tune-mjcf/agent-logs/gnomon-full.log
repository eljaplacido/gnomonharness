import mujoco
import numpy as np

def simulate_model(model, seed):
    data = mujoco.MjData(model)
    nstep = int(2.0 / model.opt.timestep)
    rng = np.random.default_rng(seed)
    data.qpos += rng.normal(0, 0.01, size=data.qpos.shape)
    mujoco.mj_forward(model, data)
    for _ in range(nstep):
        mujoco.mj_step(model, data)
    full_physics = mujoco.mjtState.mjSTATE_FULLPHYSICS
    state = np.zeros(mujoco.mj_stateSize(model, full_physics))
    mujoco.mj_getState(model, data, state, full_physics)
    return state

m_ref = mujoco.MjModel.from_xml_path('model_ref.xml')

for iters in [5, 3, 1, 0]:
    m_test = mujoco.MjModel.from_xml_path('model_ref.xml')
    m_test.opt.iterations = iters
    s_test = simulate_model(m_test, 42)
    diff = np.linalg.norm(m_ref.qpos - m_test.qpos)
    s_ref = simulate_model(m_ref, 42)
    diff2 = np.linalg.norm(s_ref - s_test)
    print(f'iterations={iters}: diff={diff2:.6e}')
