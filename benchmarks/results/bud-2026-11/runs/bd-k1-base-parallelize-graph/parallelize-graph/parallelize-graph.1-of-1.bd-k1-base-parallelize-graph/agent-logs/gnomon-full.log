#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define KMER_LEN 19
#define HASH_SIZE 131071
#define HASH_MASK (HASH_SIZE - 1)
#define MAX_CONTIG_LEN 1000000

typedef struct Node {
    char kmer[KMER_LEN + 1];
    char left_ext;
    char right_ext;
    struct Node *next;
} Node;

static Node *hash_table[HASH_SIZE];
static int num_nodes = 0;

static unsigned int hash_kmer(const char *s) {
    unsigned int h = 5381;
    for (int i = 0; s[i]; i++) {
        h = ((h << 5) + h) + (unsigned char)s[i];
    }
    return h & HASH_MASK;
}

static void insert_kmer(const char *kmer, char left, char right) {
    unsigned int idx = hash_kmer(kmer);
    Node *n = hash_table[idx];
    while (n) {
        if (strcmp(n->kmer, kmer) == 0) return;
        n = n->next;
    }
    Node *new_node = (Node *)malloc(sizeof(Node));
    memcpy(new_node->kmer, kmer, KMER_LEN);
    new_node->kmer[KMER_LEN] = '\0';
    new_node->left_ext = left;
    new_node->right_ext = right;
    new_node->next = hash_table[idx];
    hash_table[idx] = new_node;
    num_nodes++;
}

static Node *find_kmer(const char *kmer) {
    unsigned int idx = hash_kmer(kmer);
    Node *n = hash_table[idx];
    while (n) {
        if (strcmp(n->kmer, kmer) == 0) return n;
        n = n->next;
    }
    return NULL;
}

static char *build_contig_right(const char *start) {
    char *contig = (char *)malloc(MAX_CONTIG_LEN);
    strcpy(contig, start);
    
    char cur_kmer[KMER_LEN + 2];
    strcpy(cur_kmer, start);
    
    int steps = 0;
    while (1) {
        Node *n = find_kmer(cur_kmer);
        if (!n || n->right_ext == 'F') break;
        int clen = strlen(contig);
        contig[clen] = n->right_ext;
        contig[clen + 1] = '\0';
        memmove(cur_kmer, cur_kmer + 1, KMER_LEN);
        cur_kmer[KMER_LEN] = n->right_ext;
        cur_kmer[KMER_LEN + 1] = '\0';
        steps++;
        if (steps > 200000) {
            fprintf(stderr, "Too many steps at step %d, contig len=%d\n", steps, clen);
            break;
        }
    }
    return contig;
}

static void extend_left(char *contig) {
    int steps = 0;
    while (1) {
        char first_char = contig[0];
        Node *found = NULL;
        for (int i = 0; i < HASH_SIZE; i++) {
            Node *n = hash_table[i];
            while (n) {
                if (n->right_ext == first_char) {
                    found = n;
                    break;
                }
                n = n->next;
            }
            if (found) break;
        }
        if (!found) break;
        memmove(contig + 1, contig, strlen(contig) + 1);
        contig[0] = found->kmer[0];
        steps++;
        if (steps > 100) {
            fprintf(stderr, "Too many left steps at step %d\n", steps);
            break;
        }
    }
}

int main(int argc, char **argv) {
    if (argc < 2) {
        fprintf(stderr, "Usage: %s <input_file>\n", argv[0]);
        return 1;
    }

    FILE *fp = fopen(argv[1], "r");
    if (!fp) {
        fprintf(stderr, "Cannot open input file: %s\n", argv[1]);
        return 1;
    }

    char line[256];
    while (fgets(line, sizeof(line), fp)) {
        line[strcspn(line, "\n")] = '\0';
        char *tab = strchr(line, '\t');
        if (!tab) continue;
        *tab = '\0';
        char *kmer = line;
        char *ext = tab + 1;
        if (strlen(kmer) != KMER_LEN) continue;
        if (strlen(ext) != 2) continue;
        insert_kmer(kmer, ext[0], ext[1]);
    }
    fclose(fp);

    printf("Loaded %d nodes\n", num_nodes);

    FILE *out = fopen("/app/serial.out", "w");
    if (!out) {
        fprintf(stderr, "Cannot open output file: /app/serial.out\n");
        return 1;
    }

    Node **starts = (Node **)malloc(num_nodes * sizeof(Node *));
    int num_starts = 0;
    
    for (int i = 0; i < HASH_SIZE; i++) {
        Node *n = hash_table[i];
        while (n) {
            if (n->left_ext == 'F') {
                starts[num_starts++] = n;
            }
            n = n->next;
        }
    }
    
    printf("Found %d start nodes\n", num_starts);

    for (int i = 0; i < num_starts; i++) {
        printf("Building contig %d from %s\n", i, starts[i]->kmer);
        char *contig = build_contig_right(starts[i]->kmer);
        printf("Right extension done, len=%d\n", (int)strlen(contig));
        extend_left(contig);
        printf("Left extension done, len=%d\n", (int)strlen(contig));
        fprintf(out, "%s\n", contig);
        free(contig);
    }

    free(starts);
    fclose(out);

    for (int i = 0; i < HASH_SIZE; i++) {
        Node *n = hash_table[i];
        while (n) {
            Node *next = n->next;
            free(n);
            n = next;
        }
    }

    return 0;
}
