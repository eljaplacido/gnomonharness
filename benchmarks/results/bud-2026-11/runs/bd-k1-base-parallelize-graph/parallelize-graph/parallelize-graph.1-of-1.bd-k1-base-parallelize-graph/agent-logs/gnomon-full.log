        if (!tab) continue;
        *tab = '\0';
        insert_kmer(line, tab[1], tab[2]);
    }
    fclose(fp);
    
    /* Find start nodes */
    Node **starts = (Node **)malloc(num_nodes * sizeof(Node *));
    int num_starts = 0;
    for (int i = 0; i < HASH_SIZE; i++) {
