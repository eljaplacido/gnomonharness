} Node;

static Node *hash_table[HASH_SIZE];
static int num_nodes = 0;

static unsigned int hash_kmer(const char *s) {
    unsigned int h = 5381;
    for (int i = 0; s[i]; i++) {
        h = ((h << 5) + h) + (unsigned char)s[i];
    }
    return h & HASH_MASK;
}

static void insert_kmer(const char *kmer, char left, char right) {
    unsigned int idx = hash_kmer(kmer);
    Node *n = hash_table[idx];
    while (n) {
        if (strcmp(n->kmer, kmer) == 0) return;
        n = n->next;
    }
    Node *new_node = (Node *)malloc(sizeof(Node));
    memcpy(new_node->kmer, kmer, KMER_LEN);
    new_node->kmer[KMER_LEN] = '\0';
    new_node->left_ext = left;
    new_node->right_ext = right;
    new_node->next = hash_table[idx];
    hash_table[idx] = new_node;
    num_nodes++;
}

int main() {
    FILE *fp = fopen("test", "r");
    char line[256];
    long long line_num = 0;
    while (fgets(line, sizeof(line), fp)) {
        line[strcspn(line, "\n")] = '\0';
        char *tab = strchr(line, '\t');
        if (!tab) { line_num++; continue; }
        *tab = '\0';
        if (strlen(line) != KMER_LEN) { line_num++; continue; }
        insert_kmer(line, tab[1], tab[2]);
        line_num++;
    }
    fclose(fp);
    
    printf("Total nodes: %d\n", num_nodes);
    
    /* Check start nodes */
    int start_count = 0;
    for (int i = 0; i < HASH_SIZE; i++) {
        Node *n = hash_table[i];
        while (n) {
            if (n->left_ext == 'F') {
                start_count++;
            }
            n = n->next;
        }
    }
    printf("Start nodes: %d\n", start_count);
    
    return 0;
}
