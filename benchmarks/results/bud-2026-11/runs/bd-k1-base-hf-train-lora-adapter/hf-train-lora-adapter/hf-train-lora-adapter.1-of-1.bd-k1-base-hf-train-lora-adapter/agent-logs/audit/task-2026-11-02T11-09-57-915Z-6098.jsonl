{"seq":87,"ts":"2026-11-02T11:26:56.203Z","kind":"approval","prev":"b5041b11bbe82fb41cb0f093f77acd9e31e7f2c478f91a4846ac681a77420d10","tool":"bash","summary":"bash: cd /app && python3 -c \"\nfrom peft import PeftModel\nfrom transformers import AutoModelForCausalLM, AutoTokenizer\nimport torch\n\nbase_model = AutoModelForCausalLM.from_pretrained('openai-community/gpt2')\nbase_tokenizer = AutoTokenizer.from_pretrained('openai-community/gpt2')\nbase_tokenizer.pad_token = base_tokenizer.eos_token\n\nmodel = PeftModel.from_pretrained(base_model, '/app/experiments/lora_adapter')\nmodel = model.to('cpu')\n\n# Test with a biomedical question - use max_new_tokens=1 to get just the answer letter\nprompt = 'Question: What is the function of ribosomes?\\nA. Energy production\\nB. Protein synthesis\\nC. DNA replication\\nD. Cell division\\nAnswer: '\ninputs = base_tokenizer(prompt, return_tensors='pt')\noutputs = model.generate(**inputs, max_new_tokens=1, do_sample=False)\nresponse = base_tokenizer.decode(outputs[0], skip_special_tokens=True)\nprint(f'Prompt: {prompt}')\nprint(f'Generated (max_new_tokens=1): {response}')\nprint()\n\n# Also check what tokens are generated\ninput_ids = inputs['input_ids']\nlogits = model(**inputs).logits\nnext_token_logits = logits[0, -1, :]\npredicted = torch.argmax(next_token_logits).item()\nprint(f'Predicted token id: {predicted}')\nprint(f'Predicted token: {base_tokenizer.decode([predicted])}')\nprint(f'Vocab mapping for A,B,C,D:')\nfor letter in ['A', 'B', 'C', 'D']:\n    tid = base_tokenizer.encode(letter, add_special_tokens=False)\n    print(f'  {letter} -> {tid}')\n\" 2>&1","decision":"approved","by":"flag:--yes","interactive":false,"hash":"431d7d5019e0993d9e9b547d30289d4cfc688a6ff6669d7d8fcb862a68144854"}
