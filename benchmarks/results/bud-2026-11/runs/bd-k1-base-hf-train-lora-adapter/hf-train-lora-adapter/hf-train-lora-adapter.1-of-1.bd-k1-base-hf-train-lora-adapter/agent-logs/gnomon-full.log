#!/usr/bin/env python3
"""
Train a LoRA adapter on openai-community/gpt2 for biomedical multiple-choice QA.

Uses a simpler prompt format to help the model learn to predict answer letters.
"""

import json
import os
import random

import torch
from datasets import Dataset
from peft import LoraConfig, TaskType, get_peft_model, PeftModel
from transformers import (
    AutoModelForCausalLM,
    AutoTokenizer,
    DataCollatorForLanguageModeling,
    Trainer,
    TrainingArguments,
)

# ── Configuration ──────────────────────────────────────────────────────────────

BASE_MODEL = "openai-community/gpt2"
LORA_R = 8
LORA_ALPHA = 16
TARGET_MODULES = ["c_attn"]
OUTPUT_DIR = "/app/experiments/lora_adapter"
DATA_DIR = "/app/data"
RESULTS_FILE = "/app/lora_results.json"

# Training hyper-parameters
NUM_EPOCHS = 3
BATCH_SIZE = 4
GRAD_ACCUM = 4          # effective batch = 16
LR = 5e-4
MAX_LENGTH = 256
SEED = 42

random.seed(SEED)
torch.manual_seed(SEED)


# ── Data loading ───────────────────────────────────────────────────────────────

def load_json(path):
    with open(path) as f:
        return json.load(f)


def build_sample(sample):
    """
    Format each sample as a causal-LM prompt.
    The model learns to predict the answer letter.
    """
    q = sample["question"]
    opts = sample["options"]
    ans = sample["answer"]

    prompt = (
        f"Question: {q}\n"
        + "\n".join(opts)
        + "\nAnswer: "
    )
    return prompt, ans


# ── Tokenization ───────────────────────────────────────────────────────────────

def tokenize_fn(examples, tokenizer):
    """Tokenize and create labels for causal LM."""
    tokenized = tokenizer(
        examples["input_text"],
        truncation=True,
        max_length=MAX_LENGTH,
        padding=False,
    )
    tokenized["labels"] = [x[:] for x in tokenized["input_ids"]]
    return tokenized


def collate_fn(features):
    """Custom collator: pad input_ids and labels to same length."""
    batch = {}
    max_len = max(len(f["input_ids"]) for f in features)
    input_ids = []
    attention_mask = []
    labels = []
    for f in features:
        length = len(f["input_ids"])
        pad_len = max_len - length
        input_ids.append(f["input_ids"] + [tokenizer.pad_token_id] * pad_len)
        attention_mask.append([1] * length + [0] * pad_len)
        labels.append(f["labels"] + [-100] * pad_len)
    batch["input_ids"] = torch.tensor(input_ids)
    batch["attention_mask"] = torch.tensor(attention_mask)
    batch["labels"] = torch.tensor(labels)
    return batch


# ── Main ───────────────────────────────────────────────────────────────────────

def main():
    print("Loading data...")
    train_data = load_json(os.path.join(DATA_DIR, "train.json"))
    val_data = load_json(os.path.join(DATA_DIR, "val.json"))
    print(f"  Train: {len(train_data)}, Val: {len(val_data)}")

    # Build prompt/answer pairs
    train_texts = []
    val_texts = []
    for s in train_data:
        prompt, _ = build_sample(s)
        train_texts.append(prompt)
    for s in val_data:
        prompt, _ = build_sample(s)
        val_texts.append(prompt)

    # Create HuggingFace datasets
    train_ds = Dataset.from_dict({"input_text": train_texts})
    val_ds = Dataset.from_dict({"input_text": val_texts})

    print("Loading tokenizer and model...")
    global tokenizer
    tokenizer = AutoTokenizer.from_pretrained(BASE_MODEL)
    tokenizer.pad_token = tokenizer.eos_token
    tokenizer.padding_side = "right"

    # Load model on CPU to save GPU memory
    model = AutoModelForCausalLM.from_pretrained(
        BASE_MODEL,
        torch_dtype=torch.float32,
    )

    # ── LoRA setup ───────────────────────────────────────────────────────────
    print("Setting up LoRA...")
    peft_config = LoraConfig(
        r=LORA_R,
        lora_alpha=LORA_ALPHA,
        target_modules=TARGET_MODULES,
        lora_dropout=0.05,
        bias="none",
        task_type=TaskType.CAUSAL_LM,
    )
    model = get_peft_model(model, peft_config)
    model.print_trainable_parameters()

    # ── Tokenize ─────────────────────────────────────────────────────────────
    print("Tokenizing...")
    train_ds = train_ds.map(
        lambda x: tokenize_fn(x, tokenizer),
        batched=True,
        remove_columns=["input_text"],
    )
    val_ds = val_ds.map(
        lambda x: tokenize_fn(x, tokenizer),
        batched=True,
        remove_columns=["input_text"],
    )

    # ── Training args ────────────────────────────────────────────────────────
    training_args = TrainingArguments(
        output_dir=OUTPUT_DIR,
        num_train_epochs=NUM_EPOCHS,
        per_device_train_batch_size=BATCH_SIZE,
        gradient_accumulation_steps=GRAD_ACCUM,
        learning_rate=LR,
        weight_decay=0.01,
        logging_steps=10,
        save_strategy="no",
        eval_strategy="epoch",
        load_best_model_at_end=False,
        report_to="none",
        dataloader_num_workers=0,
        fp16=False,
        bf16=False,
        remove_unused_columns=False,
    )

    # ── Trainer ──────────────────────────────────────────────────────────────
    print("Training...")
    trainer = Trainer(
        model=model,
        args=training_args,
        train_dataset=train_ds,
        eval_dataset=val_ds,
        data_collator=collate_fn,
    )

    trainer.train()

    # ── Save LoRA adapter ────────────────────────────────────────────────────
    print("Saving LoRA adapter...")
    os.makedirs(OUTPUT_DIR, exist_ok=True)

    # Save the LoRA adapter weights (PEFT format)
    model.save_pretrained(OUTPUT_DIR)

    # Save tokenizer alongside
    tokenizer.save_pretrained(OUTPUT_DIR)

    # ── Save results JSON ────────────────────────────────────────────────────
    results = {
        "model": BASE_MODEL,
