    base_tokenizer.pad_token = base_tokenizer.eos_token

    loaded_model = PeftModel.from_pretrained(base_model, OUTPUT_DIR)
    loaded_model = loaded_model.to("cpu")

    test_q = "What is the function of hemoglobin?"
    test_opts = [
        "A. Transport oxygen",
        "B. Fight infections",
        "C. Clot blood",
        "D. Digest food",
    ]
    prompt = f"Question: {test_q}\n" + "\n".join(test_opts) + "\nAnswer: "
    inputs = base_tokenizer(prompt, return_tensors="pt")
    outputs = loaded_model.generate(
        **inputs, max_new_tokens=5, do_sample=False, temperature=0.1
    )
    response = base_tokenizer.decode(outputs[0], skip_special_tokens=True)
    print(f"Prompt: {prompt}")
    print(f"Generated: {response}")

    print("\nDone!")


