[17.565548, "o", "2. Download the LoRA adapter '\"'\"'dominguesm/xlm-roberta-base-lora-language-detection'\"'\"' \r\n\u001b[?2004l\r\u001b[?2004h> "]
[17.565651, "o", "3. Configure the base model with 20 language classes (not the default 2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[17.565772, "o", "4. Save the configured model and tokenizer to '\"'\"'/app/model_cache/xlm-roberta-base'\"'\"'\r\n\u001b[?2004l\r"]
