from mailman.core.initialize import initialize
initialize('/etc/mailman3/mailman.cfg')
from mailman.interfaces.domain import IDomainManager
from mailman.interfaces.listmanager import IListManager
from zope.component import getUtility
from mailman.database.transaction import user_commit

# Create the domain
dm = getUtility(IDomainManager)
domain = dm.create('local.edu')
print(f"Domain created: {domain.name}")

# Create the mailing list
lm = getUtility(IListManager)
mlist = lm.create('reading-group', 'local.edu')
print(f"List created: {mlist.list_name}@{mlist.domain_name}")

# Set subscription policy to open (no approval needed)
mlist.subscription_policy = 1  # 1 = SUBSCRIPTION_POLICY.OPEN
print(f"Subscription policy: {mlist.subscription_policy}")

# Set the list to accept posts from members only (default)
mlist.default_member_delivery = True

# Make the list owner (admin@local.edu) not need to approve
mlist.bounce_info.maximum_bounce_count = 5

user_commit()
print("Committed changes")

# Verify
mlist2 = lm.get('reading-group@local.edu')
print(f"List verified: {mlist2.list_name}@{mlist2.domain_name}")
print(f"Subscription policy: {mlist2.subscription_policy}")
