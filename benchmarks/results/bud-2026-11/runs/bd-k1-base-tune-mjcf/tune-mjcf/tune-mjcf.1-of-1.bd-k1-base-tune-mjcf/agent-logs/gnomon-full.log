try:
    model = mujoco.MjModel.from_xml_string(xml, None)
    print('dt config accepted')
    nstep = int(2.0 / model.opt.timestep)
    print('nstep:', nstep)
    
    # Timing
    times = []
    for run in range(5):
        seed = np.random.randint(0, 10000)
        d = mujoco.MjData(model)
        d.qpos += np.random.default_rng(seed).normal(0, 0.01, size=d.qpos.shape)
        mujoco.mj_forward(model, d)
        t0 = time.perf_counter()
        for _ in range(nstep):
            mujoco.mj_step(model, d)
        t1 = time.perf_counter()
        times.append(t1 - t0)
    
    print('Avg time:', np.mean(times))
    
    # Check correctness
    model_ref = mujoco.MjModel.from_xml_path('model_ref.xml')
    seed = 42
    d_ref = mujoco.MjData(model_ref)
    d_ref.qpos += np.random.default_rng(seed).normal(0, 0.01, size=d_ref.qpos.shape)
    mujoco.mj_forward(model_ref, d_ref)
    nstep_ref = int(2.0 / model_ref.opt.timestep)
    for _ in range(nstep_ref):
        mujoco.mj_step(model_ref, d_ref)
    
    d = mujoco.MjData(model)
    d.qpos += np.random.default_rng(seed).normal(0, 0.01, size=d.qpos.shape)
    mujoco.mj_forward(model, d)
    for _ in range(nstep):
        mujoco.mj_step(model, d)
    
    full = mujoco.mjtState.mjSTATE_FULLPHYSICS
    state_ref = np.zeros(mujoco.mj_stateSize(model_ref, full))
    state = np.zeros(mujoco.mj_stateSize(model, full))
    mujoco.mj_getState(model_ref, d_ref, state_ref, full)
    mujoco.mj_getState(model, d, state, full)
    
    diff = np.linalg.norm(state - state_ref)
    print('State difference:', diff)
    print('Time pctg:', np.mean(times) / 0.267)
except Exception as e:
    print('Error:', e)
