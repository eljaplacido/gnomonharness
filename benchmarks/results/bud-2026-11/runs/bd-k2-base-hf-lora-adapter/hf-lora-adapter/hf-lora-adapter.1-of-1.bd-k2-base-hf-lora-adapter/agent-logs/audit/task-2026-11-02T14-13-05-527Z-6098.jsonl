{"seq":18,"ts":"2026-11-02T14:14:58.180Z","kind":"approval","prev":"65894d3fad07a4e260ff0e6f042fcfca3f206a34e29c7699c928e948c00a42ec","tool":"bash","summary":"bash: cd /app && python3 -c \"\nimport json, torch\nfrom transformers import AutoTokenizer, AutoModelForSequenceClassification\n\n# Load merged model from disk\nmodel = AutoModelForSequenceClassification.from_pretrained('/app/merged_model/')\ntokenizer = AutoTokenizer.from_pretrained('/app/merged_model/')\nmodel.eval()\n\n# Re-run inference\nwith open('/app/detection_results.json') as f:\n    results = json.load(f)\n\nwith torch.no_grad():\n    for r in results:\n        inputs = tokenizer(r['text'], return_tensors='pt', truncation=True, max_length=512)\n        outputs = model(**inputs)\n        probs = torch.softmax(outputs.logits, dim=-1)\n        pred = torch.argmax(probs, dim=-1).item()\n        conf = probs[0][pred].item()\n        status = 'OK' if pred == r['predicted_class_id'] else 'MISMATCH'\n        print(f'{status}: {r[\\\"text\\\"][:40]}... -> class {pred} (conf {conf:.4f}) [saved: {r[\\\"predicted_class_id\\\"]}]')\n\nprint('Verification complete.')\n\" 2>&1","decision":"approved","by":"flag:--yes","interactive":false,"hash":"33c3dc214b796f128477f74e80d4bf9f56f1a68067c6df900fbb312297b72c48"}
