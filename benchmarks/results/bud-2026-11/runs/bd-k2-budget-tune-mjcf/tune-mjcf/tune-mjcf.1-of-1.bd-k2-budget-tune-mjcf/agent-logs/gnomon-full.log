import mujoco
import numpy as np
import time

def run_test(model_path, seed=42):
    model = mujoco.MjModel.from_xml_path(model_path)
    data = mujoco.MjData(model)
    rng = np.random.default_rng(seed)
    data.qpos += rng.normal(0, 0.01, size=data.qpos.shape)
    mujoco.mj_forward(model, data)
    
    nstep = int(2.0 / model.opt.timestep)
    for _ in range(nstep):
        mujoco.mj_step(model, data)
    
    full_physics = mujoco.mjtState.mjSTATE_FULLPHYSICS
    state = np.zeros(mujoco.mj_stateSize(model, full_physics))
    mujoco.mj_getState(model, data, state, full_physics)
    return state

# Test with different solver settings by modifying the XML
import xml.etree.ElementTree as ET

base_xml = ET.parse('model_ref.xml').getroot()

# Test 1: Reduce solver iterations
for iters in [100, 50, 20, 10, 5]:
    for ls_iters in [50, 20, 10, 5]:
        # Modify the XML
        size_elem = base_xml.find('size')
        if size_elem is None:
            size_elem = ET.SubElement(base_xml, 'size')
        size_elem.set('iterations', str(iters))
        size_elem.set('ls_iterations', str(ls_iters))
        
        tree = ET.ElementTree(base_xml)
        tmp_path = f'/tmp/test_model.xml'
        tree.write(tmp_path)
        
        state = run_test(tmp_path)
        ref_state = run_test('model_ref.xml')
        diff = np.linalg.norm(state - ref_state)
        print(f'iters={iters}, ls={ls_iters}: diff={diff:.6e}')
        
        # Reset
        size_elem.attrib = {'memory': '2M'}
