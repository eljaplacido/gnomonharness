import mujoco
import numpy as np
import copy

model = mujoco.MjModel.from_xml_path('model_ref.xml')

# Test with reduced solver iterations
for iters in [100, 50, 20, 10, 5]:
    m = copy.deepcopy(model)
    m.opt.iterations = iters
    m.opt.ls_iterations = min(iters, 50)
    data = mujoco.MjData(m)
    rng = np.random.default_rng(42)
    data.qpos += rng.normal(0, 0.01, size=data.qpos.shape)
    mujoco.mj_forward(m, data)
    
    for _ in range(1000):
        mujoco.mj_step(m, data)
    
    full_physics = mujoco.mjtState.mjSTATE_FULLPHYSICS
    state = np.zeros(mujoco.mj_stateSize(m, full_physics))
    mujoco.mj_getState(m, data, state, full_physics)
    
    # Compare with reference
    ref_model = mujoco.MjModel.from_xml_path('model_ref.xml')
    ref_data = mujoco.MjData(ref_model)
    ref_data.qpos = data.qpos.copy()
    ref_data.qvel = data.qvel.copy()
    for _ in range(1000):
        mujoco.mj_step(ref_model, ref_data)
    ref_state = np.zeros(mujoco.mj_stateSize(ref_model, full_physics))
    mujoco.mj_getState(ref_model, ref_data, ref_state, full_physics)
    
    diff = np.linalg.norm(state - ref_state)
    print(f'iterations={iters}, ls_iterations={min(iters,50)}: diff={diff:.6e}')
