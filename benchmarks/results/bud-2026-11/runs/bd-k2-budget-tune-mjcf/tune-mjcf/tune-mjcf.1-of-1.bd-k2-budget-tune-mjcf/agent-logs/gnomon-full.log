print(f'atol=1e-6 check: {np.allclose(state, ref_state, atol=1e-6)}')
print(f'atol=1e-7 check: {np.allclose(state, ref_state, atol=1e-7)}')

# Find which components differ
mask = np.abs(state - ref_state) > 1e-5
if mask.any():
    print(f'Components exceeding 1e-5: {np.sum(mask)}')
    print(f'Max diff: {np.max(np.abs(state - ref_state)):.6e}')
else:
    print('All components within 1e-5')
