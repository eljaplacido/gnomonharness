[28.85067, "o", "\u001b[?2004h"]
[28.851086, "o", ">    - Others: no permissions (both current and default)\r\n\u001b[?2004l\r\u001b[?2004h>    - Set proper mask to allow full permissions\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
