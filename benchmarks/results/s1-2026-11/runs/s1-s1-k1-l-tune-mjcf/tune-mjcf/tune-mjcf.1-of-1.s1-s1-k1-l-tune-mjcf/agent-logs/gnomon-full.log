import mujoco
import numpy as np
import time

# Test with different timesteps
for ts in [0.002, 0.004, 0.005, 0.008, 0.01]:
    xml = open('model_ref.xml').read()
    xml = xml.replace('timestep=\"0.002\"', f'timestep=\"{ts}\"')
    
    import tempfile, os
    with tempfile.NamedTemporaryFile(mode='w', suffix='.xml', delete=False) as f:
        f.write(xml)
        tmp_path = f.name
    
    model = mujoco.MjModel.from_xml_path(tmp_path)
    nstep = int(2.0 / model.opt.timestep)
    
    data = mujoco.MjData(model)
    seed = 42
    rng = np.random.default_rng(seed)
    data.qpos += rng.normal(0, 0.01, size=data.qpos.shape)
    mujoco.mj_forward(model, data)
    
    start = time.perf_counter()
    for _ in range(nstep):
        mujoco.mj_step(model, data)
    elapsed = time.perf_counter() - start
    
    full = mujoco.mjtState.mjSTATE_FULLPHYSICS
    state = np.zeros(mujoco.mj_stateSize(model, full))
