import mujoco
import numpy as np
import time

# Test with reduced solver iterations and tolerance
model = mujoco.MjModel.from_xml_path('model_ref.xml')

# Let's see what happens with different settings
# First, baseline
data = mujoco.MjData(model)
seed = 42
rng = np.random.default_rng(seed)
data.qpos += rng.normal(0, 0.01, size=data.qpos.shape)
mujoco.mj_forward(model, data)

nstep = int(2.0 / model.opt.timestep)
print(f'nstep: {nstep}')

start = time.perf_counter()
for _ in range(nstep):
    mujoco.mj_step(model, data)
elapsed = time.perf_counter() - start
print(f'Baseline time: {elapsed:.4f}s')

# Now try with reduced iterations
model.opt.iterations = 10
model.opt.tolerance = 1e-4
model.opt.ls_iterations = 10
model.opt.ls_tolerance = 0.1
model.opt.ccd_iterations = 10
model.opt.sdf_iterations = 5
model.opt.sdf_initpoints = 10
model.opt.apirate = 10

data2 = mujoco.MjData(model)
data2.qpos += rng.normal(0, 0.01, size=data2.qpos.shape)
mujoco.mj_forward(model, data2)

start = time.perf_counter()
for _ in range(nstep):
    mujoco.mj_step(model, data2)
elapsed2 = time.perf_counter() - start
print(f'Reduced solver time: {elapsed2:.4f}s')

# Compare states
full = mujoco.mjtState.mjSTATE_FULLPHYSICS
state1 = np.zeros(mujoco.mj_stateSize(model, full))
state2 = np.zeros(mujoco.mj_stateSize(model, full))
mujoco.mj_getState(model, data, state1, full)
mujoco.mj_getState(model, data2, state2, full)
diff = np.linalg.norm(state1 - state2)
print(f'State diff: {diff}')
