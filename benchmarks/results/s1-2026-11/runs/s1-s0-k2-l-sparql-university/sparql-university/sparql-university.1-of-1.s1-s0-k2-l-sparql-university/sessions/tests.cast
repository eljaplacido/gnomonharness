[9.110365, "o", "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mtest_sparql_runs_without_error\u001b[39;49;00m():\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"\u001b[39;49;00m\r\n    \u001b[33m    Test that the SPARQL query in the file is valid and can be executed\u001b[39;49;00m\r\n    \u001b[33m    on the RDF dataset without raising an exception.\u001b[39;49;00m\r\n    \u001b[33m    \"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        \u001b[90m# Load query\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        query_text = SPARQL_PATH.read_text()\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[90m# Load RDF graph\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        g = Graph()\u001b[90m\u001b[39;49;00m\r\n        \u001b[94massert\u001b[39;49;00m DATA_PATH.exists(), \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mRDF data file \u001b[39;49;00m\u001b[33m{\u001b[39;49;00mDATA_PATH\u001b[33m}\u001b[39;49;00m\u001b[33m does not exist\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        g.parse(\u001b[96mstr\u001b[39;49;00m(DATA_PATH), \u001b[96mformat\u001b[39;49;00m=\u001b[33m\"\u001b[39;49;00m\u001b[33mttl\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[94mtry\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\r\n>           g.query(query_text)\u001b[90m\u001b[39;49;00m\r\n\r\n\u001b[1m\u001b[31m/tests/test_outputs.py\u001b[0m:43: \r\n_ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ \r\n\u001b[1m\u001b[31m.tbench-testing/lib/python3.12/site-packages/rdflib/graph.py\u001b[0m:1632: in query\r\n    \u001b[0m\u001b[94mreturn\u001b[39;49;00m result(processor.query(query_object, initBindings, initNs, **kwargs))  \u001b[90m# type: ignore[arg-type]\u001b[3