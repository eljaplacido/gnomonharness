# Quick test: how long does 1 epoch take?
import json, os, random, torch
from datasets import Dataset
from peft import LoraConfig, get_peft_model, TaskType
from transformers import GPT2LMHeadModel, GPT2TokenizerFast, TrainingArguments, Trainer

SEED = 42
random.seed(SEED)
torch.manual_seed(SEED)

train_data = json.load(open('/app/data/train.json'))
val_data = json.load(open('/app/data/val.json'))

BASE_MODEL = 'openai-community/gpt2'
MAX_LENGTH = 256

tokenizer = GPT2TokenizerFast.from_pretrained(BASE_MODEL)
tokenizer.pad_token = tokenizer.eos_token
model = GPT2LMHeadModel.from_pretrained(BASE_MODEL)

def build_prompt(sample):
    q = sample['question']
    opts = sample['options']
    return f'Question: {q}\nOptions:\n' + '\n'.join(opts) + '\nAnswer:'

def build_target(sample):
    return sample['answer']

def tokenize_fn(sample):
    prompt = build_prompt(sample)
    target = build_target(sample)
    inputs = tokenizer(prompt, truncation=True, padding='max_length', max_length=MAX_LENGTH, return_tensors='pt')
    labels_input = tokenizer(target, truncation=True, padding='max_length', max_length=MAX_LENGTH, return_tensors='pt')
    input_ids = inputs['input_ids'].squeeze(0)
    attention_mask = inputs['attention_mask'].squeeze(0)
    label_ids = labels_input['input_ids'].squeeze(0)
    labels = torch.full_like(input_ids, -100)
    prompt_tokens = tokenizer(prompt, truncation=True, max_length=MAX_LENGTH, return_tensors='pt')
    num_prompt_tokens = prompt_tokens['input_ids'].shape[1]
    answer_len = min(label_ids.shape[0], MAX_LENGTH - num_prompt_tokens)
    labels[num_prompt_tokens:num_prompt_tokens + answer_len] = label_ids[:answer_len]
    return {'input_ids': input_ids, 'attention_mask': attention_mask, 'labels': labels}

train_ds = Dataset.from_list(train_data).map(tokenize_fn, remove_columns=['id','question','options','answer','is_few_shot'])
val_ds = Dataset.from_list(val_data).map(tokenize_fn, remove_columns=['id','question','options','answer','is_few_shot'])

lora_config = LoraConfig(r=8, lora_alpha=16, target_modules=['c_attn'], lora_dropout=0.05, bias='none', task_type=TaskType.CAUSAL_LM)
model = get_peft_model(model, lora_config)

training_args = TrainingArguments(
    output_dir='/app/experiments/lora_adapter',
    num_train_epochs=3,
    per_device_train_batch_size=8,
    gradient_accumulation_steps=2,
    learning_rate=2e-4,
    logging_steps=100,
    save_strategy='epoch',
    eval_strategy='epoch',
    load_best_model_at_end=True,
    metric_for_best_model='eval_loss',
    fp16=False,
    report_to='none',
    seed=SEED,
    dataloader_num_workers=0,
)

trainer = Trainer(model=model, args=training_args, train_dataset=train_ds, eval_dataset=val_ds)
trainer.train()
model.save_pretrained('/app/experiments/lora_adapter')
tokenizer.save_pretrained('/app/experiments/lora_adapter')
print('DONE')
