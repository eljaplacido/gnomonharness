[35.882509, "o", "You must save mailman configuration file in /etc/mailman3/mailman.cfg\r\n\u001b[?2004l\r\u001b[?2004h"]
[35.884503, "o", "> \r\n\u001b[?2004l\r"]
[35.884554, "o", "\u001b[?2004h> For ease of testing:\r\n\u001b[?2004l\r"]
[35.884581, "o", "\u001b[?2004h> "]
