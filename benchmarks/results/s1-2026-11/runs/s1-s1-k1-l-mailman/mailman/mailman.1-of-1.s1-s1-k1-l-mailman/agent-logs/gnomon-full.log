# 2. virtual_mailbox_maps = hash:/path (list addresses -> some path)
# 3. virtual_transport = lmtp:[127.0.0.1]:8024

# This tells Postfix: for local.edu domain, deliver to LMTP.
# The virtual_mailbox_maps just needs to say "this address exists".

cat > /tmp/virtual_mailbox_maps.txt << 'EOF'
reading-group@local.edu reading-group@local.edu
reading-group-bounces@local.edu reading-group-bounces@local.edu
reading-group-confirm@local.edu reading-group-confirm@local.edu
reading-group-join@local.edu reading-group-join@local.edu
reading-group-leave@local.edu reading-group-leave@local.edu
reading-group-owner@local.edu reading-group-owner@local.edu
reading-group-request@local.edu reading-group-request@local.edu
reading-group-subscribe@local.edu reading-group-subscribe@local.edu
reading-group-unsubscribe@local.edu reading-group-unsubscribe@local.edu
EOF

postmap /tmp/virtual_mailbox_maps.txt 2>&1
chmod 644 /tmp/virtual_mailbox_maps.txt.db 2>&1

cat > /etc/postfix/main.cf << 'EOF'
myorigin = local.edu

smtpd_banner = $myhostname ESMTP $mail_name (Ubuntu)
biff = no
append_dot_mydomain = no
readme_directory = no
compatibility_level = 3.6

smtpd_tls_cert_file=/etc/ssl/certs/ssl-cert-snakeoil.pem
smtpd_tls_key_file=/etc/ssl/private/ssl-cert-snakeoil.key
smtpd_tls_security_level=may

smtp_tls_CApath=/etc/ssl/certs
smtp_tls_security_level=may
smtp_tls_session_cache_database = btree:${data_directory}/smtp_scache

smtpd_relay_restrictions = permit_mynetworks permit_sasl_authenticated defer_unauth_destination
myhostname = localhost
alias_maps = hash:/etc/aliases
alias_database = hash:/etc/aliases
mydestination = localhost, localhost.localdomain
relayhost =
mynetworks = 127.0.0.0/8 [::ffff:127.0.0.0]/104 [::1]/128
mailbox_size_limit = 0
recipient_delimiter = +
inet_interfaces = all
inet_protocols = all

# local.edu is a virtual domain
virtual_mailbox_domains = local.edu
# List addresses exist in the virtual mailbox
virtual_mailbox_maps = hash:/tmp/virtual_mailbox_maps.txt
# Deliver all virtual mail via LMTP to Mailman
virtual_transport = lmtp:[127.0.0.1]:8024
# Regular users: redirect to user@localhost for local delivery
virtual_alias_maps = regexp:/tmp/virtual_aliases.regexp
EOF

postfix reload 2>&1
echo "done" — approved
