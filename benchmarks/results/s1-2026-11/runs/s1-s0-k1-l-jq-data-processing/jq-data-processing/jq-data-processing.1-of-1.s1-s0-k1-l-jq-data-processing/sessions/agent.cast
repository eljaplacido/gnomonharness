[21.208223, "o", "\u001b[?2004h> "]
[21.208283, "o", "   - For arguments with values, include both the flag and value as a single string (e.g., '\"'\"'--argjson min_count 5'\"'\"')\r\n\u001b[?2004l\r\u001b[?2004h"]
