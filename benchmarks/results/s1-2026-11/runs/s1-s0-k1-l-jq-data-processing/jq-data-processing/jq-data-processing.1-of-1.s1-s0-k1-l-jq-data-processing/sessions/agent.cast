[21.208001, "o", "   - The '\"'\"'args'\"'\"' list should contain complete jq arguments, with both flags and their values (if any)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[21.208061, "o", "   - Each argument should be a separate string in the list\r\n\u001b[?2004l\r\u001b[?2004h> "]
[21.208154, "o", "   - For flag-only arguments, include just the flag (e.g., '\"'\"'--unbuffered'\"'\"', '\"'\"'--tab'\"'\"')"]
