[21.206988, "o", "     - \"--argjson min_count 5\"\r\n\u001b[?2004l\r\u001b[?2004h>      - \"--tab\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[21.207014, "o", ">    ```\r\n\u001b[?2004l\r\u001b[?2004h>    \r\n\u001b[?2004l\r"]
