#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>

#define KMER_LEN 19
#define HASH_SIZE 65536

typedef struct Node {
    char kmer[KMER_LEN + 1];
    char left;
    char right;
    int  visited;
    struct Node *next;
} Node;

static Node *ht[HASH_SIZE];

static unsigned long hash(const char *s)
{
    unsigned long h = 5381;
    while (*s)
        h = ((h << 5) + h) + (unsigned char)(*s++);
    return h % HASH_SIZE;
}

static Node *lookup(const char *kmer)
{
    unsigned long idx = hash(kmer);
    Node *n = ht[idx];
    while (n) {
        if (strcmp(n->kmer, kmer) == 0)
            return n;
        n = n->next;
    }
    return NULL;
}

static void insert(const char *kmer, char left, char right)
{
    unsigned long idx = hash(kmer);
    Node *n = (Node *)malloc(sizeof(Node));
    memcpy(n->kmer, kmer, KMER_LEN + 1);
    n->left  = left;
    n->right = right;
    n->visited = 0;
    n->next    = ht[idx];
    ht[idx]    = n;
}

static void right_extend(const char *kmer, char ext, char *out)
{
    memcpy(out, kmer + 1, KMER_LEN - 1);
    out[KMER_LEN - 1] = ext;
    out[KMER_LEN]     = '\0';
}

static void left_extend(const char *kmer, char ext, char *out)
{
    out[0] = ext;
    memcpy(out + 1, kmer, KMER_LEN - 1);
    out[KMER_LEN] = '\0';
}

static char *assemble_contig(const char *start_kmer)
{
    char prev[KMER_LEN + 1];
    const char *cur = start_kmer;
    while (1) {
        Node *n = lookup(cur);
        if (!n || n->left == 'F')
            break;
        left_extend(cur, n->left, prev);
        Node *nb = lookup(prev);
        if (!nb || nb->visited)
            break;
        cur = prev;
    }

    char *contig = (char *)malloc(KMER_LEN * 4 + 1);
    if (!contig) { perror("malloc"); exit(1); }
    strcpy(contig, cur);

    Node *start_node = lookup(cur);
    if (start_node) start_node->visited = 1;

    char next_kmer[KMER_LEN + 1];
    const char *walk = cur;
    while (1) {
        Node *n = lookup(walk);
        if (!n || n->right == 'F')
            break;
        right_extend(walk, n->right, next_kmer);
        Node *nb = lookup(next_kmer);
        if (!nb || nb->visited)
            break;
        contig[strlen(contig)] = n->right;
        walk = next_kmer;
        Node *wn = lookup(walk);
        if (wn) wn->visited = 1;
    }

    return contig;
}

int main(int argc, char **argv)
{
    if (argc < 2) { fprintf(stderr, "Usage: %s <input_file>\n", argv[0]); return 1; }

    FILE *fp = fopen(argv[1], "r");
    if (!fp) { perror("fopen"); return 1; }

    memset(ht, 0, sizeof(ht));

    char line[256];
    int count = 0;
    while (fgets(line, sizeof(line), fp)) {
        size_t len = strlen(line);
        while (len > 0 && (line[len-1] == '\n' || line[len-1] == '\r'))
            line[--len] = '\0';
        char *tab = strchr(line, '\t');
        if (!tab) continue;
        *tab = '\0';
        char *kmer = line;
        char *ext  = tab + 1;
        if (strlen(kmer) != KMER_LEN || strlen(ext) != 2) continue;
        insert(kmer, ext[0], ext[1]);
        count++;
    }
    fclose(fp);
    printf("Loaded %d k-mers\n", count);

    int contig_count = 0;
    for (int i = 0; i < HASH_SIZE; i++) {
        Node *n = ht[i];
        while (n) {
            if (!n->visited) {
                char *contig = assemble_contig(n->kmer);
                printf("%s\n", contig);
                free(contig);
                contig_count++;
                if (contig_count % 100 == 0) {
                    printf("DEBUG: contig %d\n", contig_count);
                }
            }
            n = n->next;
        }
    }
    printf("Total contigs: %d\n", contig_count);

    for (int i = 0; i < HASH_SIZE; i++) {
        Node *n = ht[i];
        while (n) {
            Node *tmp = n;
            n = n->next;
            free(tmp);
        }
    }

    return 0;
}
