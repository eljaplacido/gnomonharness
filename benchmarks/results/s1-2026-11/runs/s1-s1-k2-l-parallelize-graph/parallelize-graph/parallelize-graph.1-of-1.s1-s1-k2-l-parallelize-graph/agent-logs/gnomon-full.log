#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>

#define KMER_LEN 19
#define HASH_SIZE 65536

typedef struct Node {
    char kmer[KMER_LEN + 1];
    char left;
    char right;
    int  visited;
    struct Node *next;
} Node;

static Node *ht[HASH_SIZE];

static unsigned long hash(const char *s)
{
    unsigned long h = 5381;
    while (*s)
        h = ((h << 5) + h) + (unsigned char)(*s++);
    return h % HASH_SIZE;
}

static Node *lookup(const char *kmer)
{
    unsigned long idx = hash(kmer);
    Node *n = ht[idx];
    while (n) {
        if (strcmp(n->kmer, kmer) == 0)
            return n;
        n = n->next;
    }
    return NULL;
}

static void insert(const char *kmer, char left, char right)
{
    unsigned long idx = hash(kmer);
    Node *n = (Node *)malloc(sizeof(Node));
    memcpy(n->kmer, kmer, KMER_LEN + 1);
    n->left  = left;
    n->right = right;
    n->visited = 0;
    n->next    = ht[idx];
    ht[idx]    = n;
}

static void right_extend(const char *kmer, char ext, char *out)
{
    memcpy(out, kmer + 1, KMER_LEN - 1);
    out[KMER_LEN - 1] = ext;
    out[KMER_LEN]     = '\0';
}

static void left_extend(const char *kmer, char ext, char *out)
{
    out[0] = ext;
    memcpy(out + 1, kmer, KMER_LEN - 1);
    out[KMER_LEN] = '\0';
}

int main(int argc, char **argv)
{
    if (argc < 2) { fprintf(stderr, "Usage: %s <input_file>\n", argv[0]); return 1; }

    FILE *fp = fopen(argv[1], "r");
    if (!fp) { perror("fopen"); return 1; }

    memset(ht, 0, sizeof(ht));

    char line[256];
    int count = 0;
    while (fgets(line, sizeof(line), fp)) {
        size_t len = strlen(line);
        while (len > 0 && (line[len-1] == '\n' || line[len-1] == '\r'))
            line[--len] = '\0';
        char *tab = strchr(line, '\t');
        if (!tab) continue;
        *tab = '\0';
        char *kmer = line;
        char *ext  = tab + 1;
        if (strlen(kmer) != KMER_LEN || strlen(ext) != 2) continue;
        insert(kmer, ext[0], ext[1]);
        count++;
    }
    fclose(fp);
    printf("Loaded %d k-mers\n", count);

    /* Test: pick a kmer and walk forward */
    const char *test_kmer = "ATAGCCAGTGCCTGATACT";
    printf("Testing forward walk from %s\n", test_kmer);
    Node *n = lookup(test_kmer);
    if (n) {
        printf("Found: left=%c right=%c\n", n->left, n->right);
        char next_kmer[KMER_LEN + 1];
        right_extend(test_kmer, n->right, next_kmer);
        printf("Right extend: %s\n", next_kmer);
        Node *nb = lookup(next_kmer);
        if (nb) {
            printf("Next found: left=%c right=%c\n", nb->left, nb->right);
        } else {
            printf("Next NOT found!\n");
        }
    } else {
        printf("NOT FOUND!\n");
    }

    /* Now test the full traversal */
    int contig_count = 0;
    for (int i = 0; i < HASH_SIZE; i++) {
        Node *n = ht[i];
        while (n) {
            if (!n->visited) {
                /* Walk backward */
                char prev[KMER_LEN + 1];
                const char *cur = n->kmer;
                while (1) {
                    Node *nn = lookup(cur);
                    if (!nn || nn->left == 'F') break;
                    left_extend(cur, nn->left, prev);
                    Node *nb = lookup(prev);
                    if (!nb || nb->visited) break;
                    cur = prev;
                }

                /* Walk forward */
                char contig[KMER_LEN * 4 + 1];
                strcpy(contig, cur);
                Node *sn = lookup(cur);
                if (sn) sn->visited = 1;

                char next_kmer[KMER_LEN + 1];
                const char *walk = cur;
                int steps = 0;
                while (1) {
                    Node *wn = lookup(walk);
                    if (!wn || wn->right == 'F') break;
                    right_extend(walk, wn->right, next_kmer);
                    Node *nb = lookup(next_kmer);
                    if (!nb || nb->visited) break;
                    contig[strlen(contig)] = wn->right;
                    walk = next_kmer;
                    Node *wn2 = lookup(walk);
                    if (wn2) wn2->visited = 1;
                    steps++;
                }

                printf("Contig %d: %s (len=%zu, steps=%d)\n", contig_count, contig, strlen(contig), steps);
                contig_count++;
            }
            n = n->next;
        }
    }
    printf("Total contigs: %d\n", contig_count);

    for (int i = 0; i < HASH_SIZE; i++) {
        Node *n = ht[i];
        while (n) {
            Node *tmp = n;
            n = n->next;
            free(tmp);
        }
    }

    return 0;
}
