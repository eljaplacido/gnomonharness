{"seq":19,"ts":"2026-11-03T20:22:55.228Z","kind":"approval","prev":"86602d2982fc30dc154e54e7910fa6c0f7e389a24f6d710e32d60c2a81bb7c3c","tool":"bash","summary":"bash: cd /app && python3 -c \"\nimport json, torch\nfrom transformers import AutoTokenizer, AutoModelForSequenceClassification\n\n# Load merged model from disk\nmodel = AutoModelForSequenceClassification.from_pretrained('/app/merged_model/')\ntokenizer = AutoTokenizer.from_pretrained('/app/merged_model/')\nmodel.eval()\n\n# Re-run all 10 samples\nsamples = [\n    'Bonjour, comment allez-vous aujourd'hui?',\n    'Hola, ¿cómo estás hoy?',\n    'Guten Tag, wie geht es Ihnen?',\n    'Ciao, come stai oggi?',\n    'Olá, como você está?',\n    'Привет, как дела?',\n    'こんにちは、お元気ですか？',\n    '你好，你好吗？',\n    'مرحبا، كيف حالك؟',\n    'Hello, how are you?',\n]\n\nwith open('/app/detection_results.json') as f:\n    expected = json.load(f)\n\nall_match = True\nfor i, (text, exp) in enumerate(zip(samples, expected)):\n    inputs = tokenizer(text, return_tensors='pt', truncation=True, max_length=512)\n    with torch.no_grad():\n        logits = model(**inputs).logits\n        pred = logits.argmax(dim=-1).item()\n        conf = torch.softmax(logits, dim=-1).max().item()\n    \n    match = pred == exp['predicted_class_id']\n    if not match:\n        all_match = False\n    print(f'{\\\"✓\\\" if match else \\\"✗\\\"} {text[:40]:<40} pred={pred} exp={exp[\\\"predicted_class_id\\\"]} conf={conf:.4f}')\n\nprint(f'\\nAll predictions match: {all_match}')\n\" 2>&1","decision":"approved","by":"flag:--yes","interactive":false,"hash":"e1d8c794302ff989512e1a2a00c2d57f0ba2f8c2b98674e42b97cf2b4a13dde9"}
