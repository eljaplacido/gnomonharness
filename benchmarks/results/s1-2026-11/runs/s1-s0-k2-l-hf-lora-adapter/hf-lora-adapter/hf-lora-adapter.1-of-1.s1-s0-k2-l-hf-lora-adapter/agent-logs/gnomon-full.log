import json, torch
from transformers import AutoTokenizer, AutoModelForSequenceClassification

# Load merged model from disk
model = AutoModelForSequenceClassification.from_pretrained('/app/merged_model/')
tokenizer = AutoTokenizer.from_pretrained('/app/merged_model/')
model.eval()

# Re-run all 10 samples
samples = [
    'Bonjour, comment allez-vous aujourd'hui?',
    'Hola, ¿cómo estás hoy?',
    'Guten Tag, wie geht es Ihnen?',
    'Ciao, come stai oggi?',
    'Olá, como você está?',
    'Привет, как дела?',
    'こんにちは、お元気ですか？',
    '你好，你好吗？',
    'مرحبا، كيف حالك؟',
    'Hello, how are you?',
]

with open('/app/detection_results.json') as f:
    expected = json.load(f)

all_match = True
for i, (text, exp) in enumerate(zip(samples, expected)):
    inputs = tokenizer(text, return_tensors='pt', truncation=True, max_length=512)
    with torch.no_grad():
        logits = model(**inputs).logits
        pred = logits.argmax(dim=-1).item()
        conf = torch.softmax(logits, dim=-1).max().item()
    
    match = pred == exp['predicted_class_id']
    if not match:
        all_match = False
    print(f'{\"✓\" if match else \"✗\"} {text[:40]:<40} pred={pred} exp={exp[\"predicted_class_id\"]} conf={conf:.4f}')

print(f'\nAll predictions match: {all_match}')
