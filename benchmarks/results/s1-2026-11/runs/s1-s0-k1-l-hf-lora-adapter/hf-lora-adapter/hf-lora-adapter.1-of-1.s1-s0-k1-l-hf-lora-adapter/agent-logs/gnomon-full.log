import json, torch
from transformers import AutoTokenizer, AutoModelForSequenceClassification

tokenizer = AutoTokenizer.from_pretrained('/app/merged_model')
model = AutoModelForSequenceClassification.from_pretrained('/app/merged_model')
model.eval()

with open('/app/detection_results.json') as f:
    results = json.load(f)

print('Verification: loading merged model and re-running inference')
with torch.no_grad():
    for r in results:
        inputs = tokenizer(r['text'], return_tensors='pt', truncation=True, max_length=512, padding=True)
        outputs = model(**inputs)
        probs = torch.softmax(outputs.logits, dim=-1)
        conf, pred = torch.max(probs, dim=-1)
        assert pred.item() == r['predicted_class_id'], f'Mismatch for {r[\"text\"]}'
        print(f'  OK: {r[\"text\"][:40]}... -> class {pred.item()} (conf: {conf.item():.4f})')
print('All 10 samples verified successfully.')
