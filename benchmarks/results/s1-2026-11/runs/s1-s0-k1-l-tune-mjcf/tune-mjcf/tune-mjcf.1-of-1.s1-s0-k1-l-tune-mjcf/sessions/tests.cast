[18.991828, "o", "    \u001b[90m\u001b[39;49;00m\r\n        model = mujoco.MjModel.from_xml_path(\u001b[96mstr\u001b[39;49;00m(model_path))\u001b[90m\u001b[39;49;00m\r\n        model_ref = mujoco.MjModel.from_xml_path(\u001b[96mstr\u001b[39;49;00m(model_ref_path))\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        times_model = simulation_time(model, n_runs=n_runs)\u001b[90m\u001b[39;49;00m\r\n        times_model = drop_extreme_percentiles(times_model, \u001b[94m5\u001b[39;49;00m, \u001b[94m95\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n        times_model_ref = simulation_time(model_ref, n_runs=n_runs)\u001b[90m\u001b[39;49;00m\r\n        times_model_ref = drop_extreme_percentiles(times_model_ref, \u001b[94m5\u001b[39;49;00m, \u001b[94m95\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n        speedup = (times_model_ref / times_model).mean().item()\u001b[90m\u001b[39;49;00m\r\n        act_time_pctg = (times_model / times_model_ref).mean().item()\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[96mprint\u001b[39;49;00m(\u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mAvg simulation time: \u001b[39;49;00m\u001b[33m{\u001b[39;49;00mtimes_model.mean().item()\u001b[33m:\u001b[39;49;00m\u001b[33m.4f\u001b[39;49;00m\u001b[33m}\u001b[39;"]
