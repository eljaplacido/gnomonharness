import numpy as np

# Test with larger timestep - compare states
model_ref = mujoco.MjModel.from_xml_path('model_ref.xml')
model = mujoco.MjModel.from_xml_path('model_ref.xml')
model.opt.timestep = 0.004

seed = 42
rng = np.random.default_rng(seed)

data_ref = mujoco.MjData(model_ref)
data_ref.qpos += rng.normal(0, 0.01, size=data_ref.qpos.shape)
mujoco.mj_forward(model_ref, data_ref)

nstep_ref = int(2.0 / model_ref.opt.timestep)
for i in range(nstep_ref):
    mujoco.mj_step(model_ref, data_ref)

data = mujoco.MjData(model)
data.qpos += rng.normal(0, 0.01, size=data.qpos.shape)
mujoco.mj_forward(model, data)

nstep = int(2.0 / model.opt.timestep)
for i in range(nstep):
    mujoco.mj_step(model, data)

full_physics = mujoco.mjtState.mjSTATE_FULLPHYSICS
state_ref = np.zeros(mujoco.mj_stateSize(model_ref, full_physics))
state = np.zeros(mujoco.mj_stateSize(model, full_physics))
mujoco.mj_getState(model_ref, data_ref, state_ref, full_physics)
mujoco.mj_getState(model, data, state, full_physics)

diff = np.linalg.norm(state - state_ref)
print(f'State difference: {diff:.10f}')
print(f'atol=1e-5: {np.allclose(state, state_ref, atol=1e-5)}')
print(f'atol=1e-4: {np.allclose(state, state_ref, atol=1e-4)}')
print(f'atol=1e-3: {np.allclose(state, state_ref, atol=1e-3)}')
"
