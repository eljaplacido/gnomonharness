import mujoco
import numpy as np

# Compare states between different solvers
model_ref = mujoco.MjModel.from_xml_path('model_ref.xml')
model_cg = mujoco.MjModel.from_xml_path('model_ref.xml')
model_cg.opt.solver = 0

seed = 42
rng = np.random.default_rng(seed)

data_ref = mujoco.MjData(model_ref)
data_ref.qpos += rng.normal(0, 0.01, size=data_ref.qpos.shape)
mujoco.mj_forward(model_ref, data_ref)

nstep_ref = int(2.0 / model_ref.opt.timestep)
for _ in range(nstep_ref):
    mujoco.mj_step(model_ref, data_ref)

data_cg = mujoco.MjData(model_cg)
data_cg.qpos += rng.normal(0, 0.01, size=data_cg.qpos.shape)
mujoco.mj_forward(model_cg, data_cg)

nstep_cg = int(2.0 / model_cg.opt.timestep)
for _ in range(nstep_cg):
    mujoco.mj_step(model_cg, data_cg)

full_physics = mujoco.mjtState.mjSTATE_FULLPHYSICS
state_ref = np.zeros(mujoco.mj_stateSize(model_ref, full_physics))
state_cg = np.zeros(mujoco.mj_stateSize(model_cg, full_physics))
mujoco.mj_getState(model_ref, data_ref, state_ref, full_physics)
mujoco.mj_getState(model_cg, data_cg, state_cg, full_physics)

diff = np.linalg.norm(state_ref - state_cg)
