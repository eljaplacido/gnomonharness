import mujoco
import numpy as np
import time

# Let me try a completely different approach
# The cable plugin likely has its own internal timestep that is derived from the main timestep
# If I increase the main timestep, the internal timestep increases too
# But if I also increase vmax proportionally, the plugin might take fewer sub-steps
# and the total number of internal steps might remain the same

# Let me test this by comparing states with different main timesteps
# but the same total simulation time

model_ref = mujoco.MjModel.from_xml_path('model_ref.xml')
data_ref = mujoco.MjData(model_ref)
seed = 42
rng = np.random.default_rng(seed)
data_ref.qpos += rng.normal(0, 0.01, size=data_ref.qpos.shape)
mujoco.mj_forward(model_ref, data_ref)

nstep_ref = int(2.0 / model_ref.opt.timestep)
for _ in range(nstep_ref):
    mujoco.mj_step(model_ref, data_ref)

full_physics = mujoco.mjtState.mjSTATE_FULLPHYSICS
state_ref = np.zeros(mujoco.mj_stateSize(model_ref, full_physics))
mujoco.mj_getState(model_ref, data_ref, state_ref, full_physics)

# Test with different timestep/vmax combinations
# The cable plugin's internal timestep might be main_timestep * vmax / 0.05
# If I increase both proportionally, the internal timestep should remain the same
for main_timestep, vmax in [
    (0.002, 0.05),
    (0.004, 0.05),
    (0.008, 0.05),
    (0.002, 0.1),
    (0.002, 1.0),
    (0.002, 10.0),
    (0.002, 100.0),
]:
    xml = open('model_ref.xml').read()
    xml = xml.replace('value=\"0.05\"', f'value=\"{vmax}\"')
    with open('/tmp/test_model.xml', 'w') as f:
        f.write(xml)
    
    model = mujoco.MjModel.from_xml_path('/tmp/test_model.xml')
    model.opt.timestep = main_timestep
    data = mujoco.MjData(model)
    data.qpos += rng.normal(0, 0.01, size=data.qpos.shape)
    mujoco.mj_forward(model, data)
    
    nstep = int(2.0 / model.opt.timestep)
    t0 = time.perf_counter()
    for _ in range(nstep):
        mujoco.mj_step(model, data)
    t1 = time.perf_counter()
    
    state = np.zeros(mujoco.mj_stateSize(model, full_physics))
    mujoco.mj_getState(model, data, state, full_physics)
    
    diff = np.linalg.norm(state - state_ref)
    print(f'timestep={main_timestep}, vmax={vmax}: time={t1-t0:.4f}s, diff={diff:.10f}, atol=1e-5: {np.allclose(state, state_ref, atol=1e-5)}')
"
