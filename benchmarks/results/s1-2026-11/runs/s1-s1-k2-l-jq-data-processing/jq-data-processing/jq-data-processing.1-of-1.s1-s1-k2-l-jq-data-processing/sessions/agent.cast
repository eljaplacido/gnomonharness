[20.253415, "o", ">    ```\r\n\u001b[?2004l\r"]
[20.253435, "o", "\u001b[?2004h> "]
[20.253449, "o", "   \r\n\u001b[?2004l\r"]
[20.253469, "o", "\u001b[?2004h> "]
[20.253626, "o", "   '\"'\"'/app/jq_args.yaml'\"'\"' will be used to construct and execute a single jq command as follows:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[20.253828, "o", "   `jq $(yq -r '\"'\"'.args[]'\"'\"' /app/jq_args.yaml) \"$(yq -r '\"'\"'.filter'\"'\"' /app/jq_args.yaml)\" /app/users.json > /app/active_users_report.json`\r\n\u001b[?2004l\r"]
[20.253845, "o", "\u001b[?2004h>    \r\n\u001b[?2004l\r"]
[20.25386, "o", "\u001b[?2004h> "]
