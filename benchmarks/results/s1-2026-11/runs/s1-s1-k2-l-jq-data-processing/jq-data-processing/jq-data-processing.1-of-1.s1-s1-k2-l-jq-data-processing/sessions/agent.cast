[20.254812, "o", "\u001b[?2004h> "]
[20.254855, "o", "   \r\n\u001b[?2004l\r"]
[20.254879, "o", "\u001b[?2004h> "]
[20.254894, "o", "   Requirements for the YAML file:\r\n\u001b[?2004l\r\u001b[?2004h"]
[20.254908, "o", "> "]
[20.255051, "o", "   - The '\"'\"'args'\"'\"' list should contain complete jq arguments, with both flags and their values (if any)\r\n\u001b[?2004l\r"]
[20.255067, "o", "\u001b[?2004h> "]
[20.255152, "o", "   - Each argument should be a separate string in the list\r\n\u001b[?2004l\r"]
[20.255169, "o", "\u001b[?2004h> "]
[20.255309, "o", "   - For flag-only arguments, include just the flag (e.g., '\"'\"'--unbuffered'\"'\"', '\"'\"'--tab'\"'\"')\r\n\u001b[?2004l\r"]
[20.255325, "o", "\u001b[?2004h> "]
[20.255491, "o", "   - For arguments with values, include both the flag and value as a single string (e.g., '\"'\"'--argjson min_count 5'\"'\"')\r\n\u001b[?2004l\r"]
[20.255505, "o", "\u001b[?2004h> "]
[20.25564, "o", "   - Do not include the jq command itself, the filter expression, or file paths in the args list\r\n\u001b[?2004l\r"]
[20.255654, "o", "\u001b[?2004h> "]
[20.255837, "o", "   - File paths other than the required input file '\"'\"'/app/users.json'\"'\"' and output redirections should not appear in the args\r\n\u001b[?2004l\r"]
[20.255856, "o", "\u001b[?2004h> "]
[20.256003, "o", "   - The filter should be a single string containing the complete jq filter expression\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[20.256039, "o", "\u001b[?2004h> "]
[20.256397, "o", "**Note on examples below**: In the following Data Schema sections, all content following the '\"'\"'#'\"'\"' symbol is just explanatory commentary and will NOT appear in the actual JSON files. These comments are only provided to clarify the structure and requirements.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[20.256425, "o", "\u001b[?2004h> "]
[20.256442, "o", "**Input Data Schema**:\r\n\u001b[?2004l\r"]
[20.256484, "o", "\u001b[?2004h> "]
[20.256604, "o", "The input JSON file '\"'\"'/app/users.json'\"'\"' is an array of user objects with the following structure:\r\n\u001b[?2004l\r"]
[20.25663, "o", "\u001b[?2004h> [\r\n\u001b[?2004l\r\u001b[?2004h"]
[20.256653, "o", ">   {\r\n\u001b[?2004l\r\u001b[?2004h"]
[20.256684, "o", "> "]
[20.256771, "o", "    \"id\": 1,                  # Unique numeric identifier for the user\r\n\u001b[?2004l\r\u001b[?2004h"]
[20.256783, "o", "> "]
[20.256873, "o", "    \"username\": \"john_doe\",   # User'\"'\"'s unique username (string)\r\n\u001b[?2004l\r"]
[20.256891, "o", "\u001b[?2004h> "]
[20.25702, "o", "    \"email\": \"john@example.com\",  # User'\"'\"'s email address (string)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[20.257135, "o", "    \"status\": \"active\",       # User status: '\"'\"'active'\"'\"' or '\"'\"'inactive'\"'\"'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[20.257267, "o", "    \"last_login\": \"2024-10-02T20:59:10.109812Z\",  # ISO 8601 timestamp (UTC) of the last login\r\n\u001b[?2004l\r"]
[20.257282, "o", "\u001b[?2004h> "]
[20.257438, "o", "    \"roles\": [\"admin\", \"editor\"]  # Array of roles assigned to the user (may be empty)\r\n\u001b[?2004l\r\u001b[?2004h>   },\r\n\u001b[?2004l\r"]
[20.257481, "o", "\u001b[?2004h>   ...\r\n\u001b[?2004l\r\u001b[?2004h> ]\r\n\u001b[?2004l\r\u001b[?2004h"]
[20.257494, "o", "> \r\n\u001b[?2004l\r"]
[20.257508, "o", "\u001b[?2004h> "]
[20.257553, "o", "**Output Data Schema**:\r\n\u001b[?2004l\r\u001b[?2004h"]
[20.257567, "o", "> "]
[20.257725, "o", "The output JSON file '\"'\"'/app/active_users_report.json'\"'\"' must be an array of objects with the following structure:\r\n\u001b[?2004l\r"]
[20.257785, "o", "\u001b[?2004h> [\r\n\u001b[?2004l\r"]
[20.257802, "o", "\u001b[?2004h>   {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[20.257907, "o", "    \"user_id\": 1,                 # Derived from '\"'\"'id'\"'\"' in input \r\n\u001b[?2004l\r\u001b[?2004h> "]
[20.258008, "o", "    \"username\": \"john_doe\",       # Retained from input \r\n\u001b[?2004l\r\u001b[?2004h> "]
[20.258087, "o", "    \"email\": \"john@example.com\",  # Retained from input \r\n\u001b[?2004l\r\u001b[?2004h"]
[20.258124, "o", "> "]
[20.258235, "o", "    \"last_login\": \"2024-10-02\",   # Formatted from '\"'\"'last_login'\"'\"' in input\r\n\u001b[?2004l\r\u001b[?2004h> "]
[20.258333, "o", "    \"role_count\": 2,              # Count of '\"'\"'roles'\"'\"' from input\r\n\u001b[?2004l\r"]
[20.258374, "o", "\u001b[?2004h> "]
[20.258496, "o", "    \"primary_role\": \"admin\"       # If '\"'\"'roles'\"'\"' is empty, this must be null (JSON null, not \"null\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[20.258523, "o", ">   },\r\n\u001b[?2004l\r"]
[20.258557, "o", "\u001b[?2004h>   ...\r\n\u001b[?2004l\r\u001b[?2004h> "]
[20.25859, "o", "]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[20.258623, "o", "> **Requirements**:\r\n\u001b[?2004l\r"]
[20.258655, "o", "\u001b[?2004h> "]
[20.258828, "o", "- You must use jq to perform this transformation. Using other programming languages (e.g., Python, Ruby) is strictly prohibited.\r\n\u001b[?2004l\r"]
[20.258864, "o", "\u001b[?2004h> "]
[20.25895, "o", "- Ensure that the output JSON is properly formatted with 2-space indentation.\r\n\u001b[?2004l\r"]
[20.258982, "o", "\u001b[?2004h> "]
[20.259094, "o", "- The output file must be created at the exact path '\"'\"'/app/active_users_report.json'\"'\"'.\r\n\u001b[?2004l\r"]
[20.259125, "o", "\u001b[?2004h> "]
[20.259363, "o", "- The jq command used to generate the output(along with the output redirection) must be saved to '\"'\"'/app/cmd.sh'\"'\"'. This file will be used to verify the correctness of your solution.\r\n\u001b[?2004l\r"]
[20.259394, "o", "\u001b[?2004h"]
[20.259419, "o", "> "]
