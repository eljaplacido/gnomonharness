import mujoco, numpy as np, time
xml = open("model_ref.xml").read()
def final_state(xmlstr, t_end=2.0, seed=7, jig=0.01):
    mm = mujoco.MjModel.from_xml_string(xmlstr)
    d = mujoco.MjData(mm)
    rng=np.random.default_rng(seed)
    d.qpos += rng.normal(0,jig,size=d.qpos.shape)
    mujoco.mj_forward(mm,d)
    for _ in range(int(round(t_end/mm.opt.timestep))):
        mujoco.mj_step(mm,d)
    s=np.zeros(mujoco.mj_stateSize(mm, mujoco.mjtState.mjSTATE_FULLPHYSICS))
    mujoco.mj_getState(mm,d,s,mujoco.mjtState.mjSTATE_FULLPHYSICS)
    return s
m = mujoco.MjModel.from_xml_string(xml)
print("joints:", [ (mujoco.mj_id2name(m,mujoco.mjtObj.mjOBJ_JOINT,i), m.jnt_type[i]) for i in range(min(6,m.njnt))])
s0 = final_state(xml, jig=0.01)
s1 = final_state(xml, jig=0.01+1e-12)
print("jig +1e-12 -> maxdiff", np.abs(s0-s1).max())
s2 = final_state(xml, jig=0.01+1e-9)
print("jig +1e-9  -> maxdiff", np.abs(s0-s2).max())
# timestep change
for ts in [0.001, 0.0025, 0.004]:
    x = xml.replace('<compiler autolimits="true"/>', '<compiler autolimits="true"/>').replace('<mujoco model="Cable">', '<mujoco model="Cable">')
    x = x.replace('<size memory="2M"/>', f'<size memory="2M"/>\n  <option timestep="{ts}"/>')
    s = final_state(x)
    print(f"timestep {ts} -> maxdiff {np.abs(s0-s).max():.3e}")
