[93.427987, "o", "\u001b[0m$ \u001b[0mcd /app && python -c \"\r\nimport mujoco, numpy as np, time\r\nm = mujoco.MjModel.from_xml_path('model_ref.xml')\r\nd = mujoco.MjData(m)\r\nrng = np.random.default_rng(0)\r\nd.qpos += rng.normal(0,0.01,size=d.qpos.shape)\r\nmujoco.mj_forward(m,d)\r\nmaxcon=0\r\nn=int(2.0/m.opt.timestep)\r\nt0=time.perf_counter()\r\nfor i in range(n):\r\n    mujoco.mj_step(m,d)\r\n    maxcon=max(maxcon,d.ncon)\r\nprint('maxcon',maxcon,'time',time.perf_counter()-t0)\r\nprint('nefc',d.nefc,'nwarmstart', m.opt.disableflags)\r\n# timing breakdown\r\nd2=mujoco.MjData(m)\r\nt0=time.perf_counter()\r\nfor i in range(n): mujoco.mj_forward(m,d2)\r\nprint('forward',time.perf_counter()-t0)\r\nt0=time.perf_counter()\r\nfor i in range(n): mujoco.mj_step1(m,d2)\r\nprint('step1',time.perf_counter()-t0)\r\nt0=time.perf_counter()\r\nfor i in range(n): mujoco.mj_step2(m,d2)\r\nprint('step2',time.perf_counter()-t0)\r\n\"\r\nmaxcon 0 time 0.2647655649925582\r\nnefc 3 nwarmstart 0\r\nforward 0.21657962299650535\r\nstep1 0.06326361501123756\r\nstep2 0.19440907600801438\r\n"]
[94.60001, "o", "> build · deepseek-v4.1-flash\r\n"]
[99.009917, "o", "\u001b[0m$ \u001b[0mcd /app && python -c \"\r\nimport mujoco, numpy as np, time\r\nm = mujoco.MjModel.from_xml_path('model_ref.xml')\r\nd = mujoco.MjData(m)\r\nrng = np.random.default_rng(0)\r\nd.qpos += rng.normal(0,0.01,size=d.qpos.shape)\r\nmujoco.mj_forward(m,d)\r\nn=300\r\nfns=['mj_fwdPosition','mj_fwdVelocity','mj_fwdActuation','mj_fwdAcceleration','mj_fwdConstraint','mj_Euler','mj_forward']\r\nfor f in fns:\r\n    fn=getattr(mujoco,f)\r\n    t0=time.perf_counter()\r\n    for i in range(n): fn(m,d)\r\n    print(f, (time.perf_counter()-t0)/n*1e6,'us')\r\n# constraint dims\r\nprint('nefc',d.nefc, 'ncon', d.ncon)\r\nprint('efc_type',d.efc_type[:d.nefc])\r\nprint('efc_id',d.efc_id[:d.nefc])\r\n\"\r\nmj_fwdPosition 53.620860077595964 us\r\nmj_fwdVelocity 12.188096685955923 us\r\nmj_fwdActuation 0.41179000011955696 us\r\nmj_fwdAcceleration 4.195446672383696 us\r\nmj_fwdConstraint 151.952909945976 us\r\nmj_Euler 42.15996673641106 us\r\nmj_forward 224.53690665618825 us\r\nnefc 6 ncon 3\r\nefc_type [0 0 0 5 5 5]\r\nefc_id [0 0 0 0 1 2]\r\n"]
[101.933705, "o", "> build · deepseek-v4.1-flash\r\n"]
[112.110786, "o", "\u001b[0m$ \u001b[0mcd /app && python -c \"\r\nimport mujoco, numpy as np, time\r\nm = mujoco.MjModel.from_xml_path('model_ref.xml')\r\nd = mujoco.MjData(m)\r\nrng = np.random.default_rng(0)\r\nd.qpos += rng.normal(0,0.01,size=d.qpos.shape)\r\nmujoco.mj_forward(m,d)\r\nn=int(2.0/m.opt.timestep)\r\nimport collections\r\nc=collections.Counter()\r\nfor i in range(n):\r\n    mujoco.mj_step(m,d); c[d.solver_niter[0]]+=1\r\nprint(c)\r\nprint('jacobian', m.opt.jacobian, 'cone', m.opt.cone, 'tolerance', m.opt.tolerance, 'ls_iterations', m.opt.ls_iterations)\r\n\"\r\nCounter({np.int32(1): 1000})\r\njacobian 2 cone 0 tolerance 1e-08 ls_iterations 50\r\n"]
