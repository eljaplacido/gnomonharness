[214.234323, "o", "\u001b[0m$ \u001b[0mcd /app && python -c \"\r\nimport mujoco, numpy as np, time\r\nfor extra,label in [('<option jacobian=\\\"dense\\\"/>','dense'),('<option jacobian=\\\"dense\\\"/><flag contact=\\\"disable\\\"/>','dense+nocontact')]:\r\n    src=open('model_ref.xml').read().replace('<compiler autolimits=\\\"true\\\"/>','<compiler autolimits=\\\"true\\\"/>'+extra)\r\n    open('/tmp/opencode/t.xml','w').write(src)\r\n    m=mujoco.MjModel.from_xml_path('/tmp/opencode/t.xml')\r\n    d=mujoco.MjData(m); rng=np.random.default_rng(0)\r\n    d.qpos += rng.normal(0,0.01,size=d.qpos.shape); mujoco.mj_forward(m,d)\r\n    print('==',label,'jacobian resolved',m.opt.jacobian)\r\n    n=500\r\n    for f in ['mj_fwdPosition','mj_fwdVelocity','mj_fwdActuation','mj_fwdAcceleration','mj_fwdConstraint','mj_Euler']:\r\n        fn=getattr(mujoco,f); t0=time.perf_counter()\r\n        for i in range(n): fn(m,d)\r\n        print(' ',f,(time.perf_counter()-t0)/n*1e6,'us')\r\n    t0=time.perf_counter()\r\n    for i in range(200): mujoco.mj_step(m,d)\r\n    print('  mj_step',(time.perf_counter()-t0"]
