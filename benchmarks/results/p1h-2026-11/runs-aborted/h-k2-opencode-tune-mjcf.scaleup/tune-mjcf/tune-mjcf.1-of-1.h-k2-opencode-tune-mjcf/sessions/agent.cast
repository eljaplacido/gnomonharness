[288.787507, "o", "\u001b[0m$ \u001b[0mcd /app && python grid.py\r\nref 266.7250704980688 ms\r\nPGS it=100 tol=1e-8                max=3.72e-06 mean=7.56e-07 fail=0 t= 132.7ms pctg=0.497\r\nPGS it=100 tol=1e-10               max=3.90e-07 mean=7.50e-08 fail=0 t= 132.5ms pctg=0.497\r\nPGS it=100 tol=1e-12               max=3.67e-08 mean=6.91e-09 fail=0 t= 131.9ms pctg=0.494\r\nPGS it=300 tol=1e-8                max=3.72e-06 mean=7.56e-07 fail=0 t= 132.5ms pctg=0.497\r\nPGS it=300 tol=1e-10               max=3.90e-07 mean=7.50e-08 fail=0 t= 132.6ms pctg=0.497\r\nPGS it=300 tol=1e-12               max=3.67e-08 mean=6.91e-09 fail=0 t= 131.6ms pctg=0.493\r\nPGS it=1000 tol=1e-8               max=3.72e-06 mean=7.56e-07 fail=0 t= 132.6ms pctg=0.497\r\nPGS it=1000 tol=1e-10              max=3.90e-07 mean=7.50e-08 fail=0 t= 131.9ms pctg=0.494\r\nPGS it=1000 tol=1e-12              max=3.67e-08 mean=6.91e-09 fail=0 t= 131.6ms pctg=0.493\r\nPGSdense it=100 tol=1e-10          max=3.90e-07 mean=7.50e-08 fail=0 t= 123.0ms pctg=0.461\r\nPGSdense it=100 tol=1e-12          max=3."]
