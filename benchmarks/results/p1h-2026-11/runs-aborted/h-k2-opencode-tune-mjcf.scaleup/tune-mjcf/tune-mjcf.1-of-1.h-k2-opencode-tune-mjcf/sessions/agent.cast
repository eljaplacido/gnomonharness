[23.110349, "o", "\u001b[0m$ \u001b[0mcd /app && python -c \"\r\nimport mujoco, numpy as np\r\nm = mujoco.MjModel.from_xml_path('model_ref.xml')\r\nd = mujoco.MjData(m)\r\nprint('nq',m.nq,'nv',m.nv,'nbody',m.nbody,'ngeom',m.ngeom,'neq',m.neq,'nu',m.nu)\r\nprint('timestep',m.opt.timestep,'integrator',m.opt.integrator,'solver',m.opt.solver,'iterations',m.opt.iterations)\r\nprint('plugin state size', mujoco.mj_stateSize(m, mujoco.mjtState.mjSTATE_FULLPHYSICS))\r\nprint('nplugin', m.nplugin, [m.plugin(i).name for i in range(m.nplugin)])\r\n\"\r\nTraceback (most recent call last):\r\n  File \"<string>\", line 8, in <module>\r\n    print('nplugin', m.nplugin, [m.plugin(i).name for i in range(m.nplugin)])\r\n                                 ~~~~~~~~^^^\r\nTypeError: 'numpy.ndarray' object is not callable\r\nnq 157 nv 118 nbody 42 ngeom 41 neq 1 nu 1\r\ntimestep 0.002 integrator 0 solver 2 iterations 100\r\nplugin state size 276\r\n"]
