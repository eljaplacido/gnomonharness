[29.426831, "o", "\u001b[0m$ \u001b[0mcd /app && for dt in 0.004 0.005 0.0033333333 0.0025; do\r\n  sed \"s|<compiler autolimits=\\\"true\\\"/>|<compiler autolimits=\\\"true\\\"/><option timestep=\\\"$dt\\\"/>|\" model_ref.xml > model_$dt.xml\r\ndone && ls\r\nbench.py\r\neval.py\r\nmodel_0.0025.xml\r\nmodel_0.0033333333.xml\r\nmodel_0.004.xml\r\nmodel_0.005.xml\r\nmodel_ref.xml\r\n"]
