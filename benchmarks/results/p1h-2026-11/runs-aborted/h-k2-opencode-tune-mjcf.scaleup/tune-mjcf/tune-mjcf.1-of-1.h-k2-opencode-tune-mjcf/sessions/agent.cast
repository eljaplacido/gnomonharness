[200.169334, "o", "\u001b[0m$ \u001b[0mcd /app && python explore.py\r\nbaseline         diff=0.00e+00 t=268.1ms pctg=1.005\r\nnocontact        diff=0.00e+00 t=265.7ms pctg=0.996\r\nnocontact_mid    diff=0.00e+00 t=265.8ms pctg=0.996\r\ndense            diff=6.05e-15 t=224.3ms pctg=0.841\r\nsparse           diff=0.00e+00 t=267.5ms pctg=1.003\r\npgs              diff=3.72e-06 t=130.9ms pctg=0.491\r\ncg               diff=8.14e-06 t=217.2ms pctg=0.814\r\nnowarm           diff=7.72e-15 t=254.1ms pctg=0.953\r\nnoref            diff=0.00e+00 t=267.9ms pctg=1.005\r\niters1           diff=0.00e+00 t=267.0ms pctg=1.001\r\nls0              diff=0.00e+00 t=266.9ms pctg=1.001\r\nREF              t=266.7ms\r\n"]
