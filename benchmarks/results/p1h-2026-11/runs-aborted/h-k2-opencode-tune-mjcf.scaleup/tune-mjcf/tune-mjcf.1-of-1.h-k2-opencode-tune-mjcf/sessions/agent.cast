[82.870957, "o", "\u001b[0m$ \u001b[0mcd /app && for f in model_0.0025.xml model_0.0033333333.xml model_0.004.xml model_0.005.xml; do echo \"== $f\"; python bench.py $f; done\r\n== model_0.0025.xml\r\nmax abs diff per seed: max=1.426e-03 mean=3.744e-04\r\nn seeds failing atol=1e-5: 20\r\nworst seed 17 0.0014256848675924284\r\ntime cand 0.2130 ref 0.2662 pctg 0.800\r\n== model_0.0033333333.xml\r\nmax abs diff per seed: max=3.582e-03 mean=1.000e-03\r\nn seeds failing atol=1e-5: 20\r\nworst seed 17 0.0035817018456401582\r\ntime cand 0.1586 ref 0.2638 pctg 0.601\r\n== model_0.004.xml\r\nmax abs diff per seed: max=5.035e-03 mean=1.501e-03\r\nn seeds failing atol=1e-5: 20\r\nworst seed 17 0.005034767986654915\r\ntime cand 0.1336 ref 0.2662 pctg 0.502\r\n== model_0.005.xml\r\nmax abs diff per seed: max=6.839e-03 mean=2.240e-03\r\nn seeds failing atol=1e-5: 20\r\nworst seed 17 0.006838576128732532\r\ntime cand 0.1071 ref 0.2659 pctg 0.403\r\n"]
