[203.326367, "o", "\u001b[0m← \u001b[0mEdit my_website/public/index.html\r\nIndex: my_website/public/index.html\r\n===================================================================\r\n--- my_website/public/index.html\r\n+++ my_website/public/index.html\r\n@@ -335,9 +335,9 @@\r\n     <section class=\"section\" aria-labelledby=\"contact-title\">\r\n       <div class=\"wrap\">\r\n         <div class=\"cta\">\r\n           <div class=\"cta-inner\">\r\n-            <p class=\"eyebrow\" style=\"color:#b9dcd7;\">Collaborate</p>\r\n+            <p class=\"eyebrow\">Collaborate</p>\r\n             <h2 id=\"contact-title\">Let's work on a question worth asking.</h2>\r\n             <p>\r\n               I welcome conversations about neural decoding, imaging pipelines, single-cell\r\n               atlases, and reproducible computational science.\r\n\r\n\u001b[0m← \u001b[0mEdit my_website/public/publications/index.html\r\nIndex: my_website/public/publications/index.html\r\n===================================================================\r\n--- my_website/public/publications/index.html\r\n+++ my_website/public/publications/index.html\r\n@@ -218,9 +218,9 @@\r\n     <section class=\"section\" aria-labelledby=\"cite-title\">\r\n       <div class=\"wrap\">\r\n         <div class=\"cta\">\r\n           <div class=\"cta-inner\">\r\n-            <p class=\"eyebrow\" style=\"color:#b9dcd7;\">Collaborate</p>\r\n+            <p class=\"eyebrow\">Collaborate</p>\r\n             <h2 id=\"cite-title\">Interested in the methods?</h2>\r\n             <p>\r\n               I am happy to share code, preprocessing details, or the longer version of an\r\n               analysis. Email is the best way to reach me.\r\n\r\n"]
