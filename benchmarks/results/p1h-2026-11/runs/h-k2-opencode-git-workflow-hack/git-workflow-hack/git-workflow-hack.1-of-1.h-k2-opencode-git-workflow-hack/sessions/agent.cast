[224.311516, "o", "\u001b[0m← \u001b[0mEdit my_website/scripts/check_site.py\r\nIndex: my_website/scripts/check_site.py\r\n===================================================================\r\n--- my_website/scripts/check_site.py\r\n+++ my_website/scripts/check_site.py\r\n@@ -61,8 +61,10 @@\r\n             self.has_main = True\r\n         if tag == \"h1\":\r\n             self.h1_count += 1\r\n         if data.get(\"id\"):\r\n+            if data[\"id\"] in self.ids:\r\n+                self.id_duplicates.add(data[\"id\"])\r\n             self.ids.add(data[\"id\"])\r\n \r\n         for attr in LINK_ATTRS.get(tag, ()):\r\n             value = data.get(attr, \"\").strip()\r\n\r\n"]
