[50.792688, "o", "\u001b[32m`\u001b[0m\u001b[32mError: Found no subterm matching \"n' + m\" in the current goal.\u001b[0m\u001b[32m`\u001b[0m\r\n\r\n"]
[50.812225, "o", "\u001b[34m##\u001b[0m\u001b[37m \u001b[0m\u001b[34mThe completed proof\u001b[0m\r\n"]
[51.594883, "o", "\r\n\u001b[37m```\u001b[0m\u001b[38;5;9mcoq\u001b[0m\r\n\u001b[37mTheorem plus_comm : forall n m : nat,\u001b[0m\r\n\u001b[37m  n + m = m + n.\u001b[0m\r\n\u001b[37mProof.\u001b[0m\r\n\u001b[37m  intros n m.\u001b[0m\r\n\u001b[37m  induction n as [| n' IHn'].\u001b[0m\r\n\u001b[37m  - simpl.\u001b[0m\r\n\u001b[37m    (* Base case: goal is  m = m + 0  *)\u001b[0m\r\n\u001b[37m    rewrite <- plus_n_O.\u001b[0m\r\n\u001b[37m    reflexivity.\u001b[0m\r\n\u001b[37m  - simpl.\u001b[0m\r\n\u001b[37m    (* Inductive case: goal is  S (n' + m) = m + S n'  *)\u001b[0m\r\n\u001b[37m    rewrite <- plus_n_Sm.   (* m + S n'  -->  S (m + n') *)\u001b[0m\r\n\u001b[37m    rewrite IHn'.            (* n' + m    -->  m + n'  *)\u001b[0m\r\n"]
[51.595063, "o", "\u001b[37m    reflexivity.\u001b[0m\r\n\u001b[37mQed.\u001b[0m\r\n\u001b[37m```\u001b[0m\r\n\r\n\u001b[37mStep\u001b[0m"]
[51.628288, "o", "\u001b[37m by\u001b[0m"]
[51.650993, "o", "\u001b[37m step in\u001b[0m"]
[51.660413, "o", "\u001b[37m the inductive case:\u001b[0m\r\n\u001b[37m1\u001b[0m"]
[51.695009, "o", "\u001b[37m. \u001b[0m\u001b[32m`\u001b[0m\u001b[32msimpl\u001b[0m\u001b[32m`\u001b[0m\u001b[37m reduces\u001b[0m"]
[51.714846, "o", "\u001b[37m \u001b[0m"]
[51.738127, "o", "\u001b[32m`\u001b[0m\u001b[32mS n' + m\u001b[0m\u001b[32m`\u001b[0m\u001b[37m to \u001b[0m"]
[51.785179, "o", "\u001b[32m`\u001b[0m\u001b[32mS (n' + m)\u001b[0m\u001b[32m`\u001b[0m\u001b[37m, goal:\u001b[0m"]
