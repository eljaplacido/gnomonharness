[52.98685, "o", "\u001b[37m|\u001b[0m\u001b[37m \u001b[0m\u001b[32m`\u001b[0m\u001b[32mRequire Import plus_comm.\u001b[0m\u001b[32m`\u001b[0m\u001b[37m + \u001b[0m\u001b[32m`\u001b[0m\u001b[32mCheck plus_comm\u001b[0m\u001b[32m`\u001b[0m\u001b[37m \u001b[0m\u001b[37m|\u001b[0m\u001b[37m \u001b[0m\u001b[32m`\u001b[0m\u001b[32mforall n m : nat, n + m = m + n\u001b[0m\u001b[32m`\u001b[0m\u001b[37m                          \u001b[0m\u001b[37m|\u001b[0m\r\n"]
[52.986948, "o", "\u001b[37m|\u001b[0m\u001b[37m \u001b[0m\u001b[32m`\u001b[0m\u001b[32mPrint Assumptions plus_comm\u001b[0m\u001b[32m`\u001b[0m\u001b[37m                   \u001b[0m\u001b[37m|\u001b[0m\u001b[37m \u001b[0m\u001b[1;33m**\u001b[0m\u001b[1;33mClosed under the global context\u001b[0m\u001b[1;33m**\u001b[0m\u001b[37m (no axioms, no admits) \u001b[0m\u001b[37m|\u001b[0m\r\n\u001b[37m|\u001b[0m\u001b[37m Concrete instance \u001b[0m\u001b[32m`\u001b[0m\u001b[32m3 + 5 = 5 + 3\u001b[0m\u001b[32m`\u001b[0m\u001b[37m               \u001b[0m\u001b[37m|\u001b[0m\u001b[37m \u001b[0m\u001b[32m`\u001b[0m\u001b[32mreflexivity\u001b[0m\u001b[32m`\u001b[0m\u001b[37m closes it                                    \u001b[0m\u001b[37m|\u001b[0m\r\n\u001b[37mThe \u001b[0m"]
