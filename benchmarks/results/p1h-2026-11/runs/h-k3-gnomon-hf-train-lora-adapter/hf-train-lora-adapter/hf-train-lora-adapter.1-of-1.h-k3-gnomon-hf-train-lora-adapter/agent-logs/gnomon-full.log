import json, re, torch
from transformers import AutoTokenizer, AutoModelForCausalLM
torch.set_num_threads(8)
tok = AutoTokenizer.from_pretrained("openai-community/gpt2")
tok.pad_token = tok.eos_token
m = AutoModelForCausalLM.from_pretrained("openai-community/gpt2", torch_dtype=torch.float32).eval()
LETTER_IDS = [tok.encode(" "+c)[0] for c in "ABCD"]

def strip_letter(o):
    return re.sub(r'^\s*[A-D]\s*[\.\)\:]\s*', '', o).strip()

def build(s, style):
    lines = [f"Question: {s['question'].strip()}"]
    for i,o in enumerate(s['options']):
        lines.append(f"{'ABCD'[i]}. {strip_letter(o)}")
    tail = {"answer_colon":"\nAnswer:", "answer_space":"\nAnswer: ", "plain":"\nAnswer: The correct option is"}[style]
    return "\n".join(lines)+tail

va = json.load(open('data/val.json'))
gold = torch.tensor(["ABCD".index(s['answer']) for s in va])
for style in ["answer_colon","answer_space","plain"]:
    preds=[]
    for i in range(0, len(va), 8):
        batch = va[i:i+8]
        prompts=[build(s,style) for s in batch]
        enc = tok(prompts, return_tensors="pt", padding=True, truncation=True, max_length=384)
        with torch.no_grad():
            h = m.transformer(input_ids=enc["input_ids"], attention_mask=enc["attention_mask"]).last_hidden_state
            last = enc["attention_mask"].sum(1)-1
            lg = m.lm_head(h[torch.arange(len(batch)), last])
        preds.append(lg[:, LETTER_IDS].argmax(-1))
    pred=torch.cat(preds)
    print(style, "zero-shot acc", round((pred==gold).float().mean().item(),4))
