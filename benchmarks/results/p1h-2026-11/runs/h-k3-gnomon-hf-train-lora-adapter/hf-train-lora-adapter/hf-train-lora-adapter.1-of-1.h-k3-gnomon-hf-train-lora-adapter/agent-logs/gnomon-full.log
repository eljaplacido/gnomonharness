import json, re, torch
from transformers import AutoTokenizer, AutoModelForCausalLM
tok = AutoTokenizer.from_pretrained("openai-community/gpt2")
tok.pad_token = tok.eos_token
m = AutoModelForCausalLM.from_pretrained("openai-community/gpt2", torch_dtype=torch.float32).eval()
LETTER_IDS = [tok.encode(" "+c)[0] for c in "ABCD"]
print("letter ids", LETTER_IDS)

def strip_letter(o):
    return re.sub(r'^\s*[A-D]\s*[\.\)\:]\s*', '', o).strip()

def build(s, style):
    lines = [f"Question: {s['question'].strip()}"]
    for i,o in enumerate(s['options']):
        lines.append(f"{'ABCD'[i]}. {strip_letter(o)}")
    if style=="answer_colon":
        return "\n".join(lines)+"\nAnswer:"
    if style=="answer_space":
        return "\n".join(lines)+"\nAnswer: "
    if style=="plain":
        return "\n".join(lines)+"\nAnswer: The correct option is"

va = json.load(open('data/val.json'))
for style in ["answer_colon","answer_space","plain"]:
    prompts = [build(s, style) for s in va]
    enc = tok(prompts, return_tensors="pt", padding=True, truncation=True, max_length=512)
    with torch.no_grad():
        logits = m(**enc).logits
    last = enc["attention_mask"].sum(1)-1
    lg = logits[torch.arange(len(va)), last]
    scores = lg[:, LETTER_IDS]
    pred = scores.argmax(-1)
    acc = (pred == torch.tensor([ "ABCD".index(s['answer']) for s in va])).float().mean().item()
    print(style, "acc", round(acc,4), "seqlen", enc["input_ids"].shape)
