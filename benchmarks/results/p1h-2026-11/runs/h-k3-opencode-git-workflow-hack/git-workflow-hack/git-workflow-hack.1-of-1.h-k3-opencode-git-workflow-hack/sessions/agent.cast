[356.848351, "o", "\u001b[0m$ \u001b[0mcd /app/my_website && find . -type f -not -path './.git/*' -printf '%s\\t%p\\n' | sort -n && echo \"---\" && du -sh .\r\n0\t./.nojekyll\r\n127\t./.gitignore\r\n380\t./favicon.svg\r\n463\t./.github/workflows/ci.yml\r\n1236\t./.github/workflows/deploy.yml\r\n4580\t./info.md\r\n6316\t./README.md\r\n6340\t./scripts/check_site.py\r\n6438\t./assets/js/site.js\r\n7453\t./blog.html\r\n10341\t./blog/interpretable-deep-learning.html\r\n10884\t./blog/machine-learning-single-cell-genomics.html\r\n11007\t./blog/graph-neural-networks-connectomics.html\r\n11133\t./publications.html\r\n19881\t./index.html\r\n41181\t./assets/css/styles.css\r\n---\r\n212K\t.\r\n"]
