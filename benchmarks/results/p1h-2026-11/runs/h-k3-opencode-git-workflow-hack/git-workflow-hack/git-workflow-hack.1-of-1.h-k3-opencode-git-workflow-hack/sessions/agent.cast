[340.28564, "o", "\u001b[0m← \u001b[0mEdit my_website/blog.html\r\nIndex: my_website/blog.html\r\n===================================================================\r\n--- my_website/blog.html\r\n+++ my_website/blog.html\r\n@@ -53,9 +53,9 @@\r\n         </div>\r\n         <dl class=\"page-stats\" aria-label=\"Blog summary\">\r\n           <div><dt>Essays</dt><dd>3</dd></div>\r\n           <div><dt>Latest</dt><dd>Mar ’25</dd></div>\r\n-          <div><dt>Topics</dt><dd>3</dd></div>\r\n+          <div><dt>Themes</dt><dd>4</dd></div>\r\n         </dl>\r\n       </div>\r\n     </section>\r\n \r\n\r\n\u001b[0m← \u001b[0mEdit my_website/index.html\r\nIndex: my_website/index.html\r\n===================================================================\r\n--- my_website/index.html\r\n+++ my_website/index.html\r\n@@ -45,11 +45,13 @@\r\n         <div class=\"hero-copy\">\r\n           <p class=\"eyebrow\">Computational Neuroscience · Riverbend University</p>\r\n           <h1>Dr. Lydia <em>Moreno</em></h1>\r\n           <p class=\"hero-lede\">\r\n-            I build interpretable machine-learning models that connect neural activity\r\n-            to behaviour — from two-photon imaging of the visual cortex to graph\r\n-            representations of complete connectomes.\r\n+            I am an associate professor of Computational Neuroscience at Riverbend\r\n+            University, working at the intersection of machine learning, systems\r\n+            neuroscience, and bioinformatics. I build interpretable models that\r\n+            connect neural activity to behaviour — from two-photon imaging of the\r\n+            visual cortex to graph representations of complete connectomes.\r\n           </p>\r\n           <div class=\"hero-actions\">\r\n             <a class=\"button button--primary\" href=\"publications.html\">Explore publications</a>\r\n             <a class=\"button button--ghost\" href=\"#research\">Research interests</a>\r\n\r\n\u001b[0m← \u001b[0mEdit my_website/publications.html\r\nIndex: my_website/publications.html\r\n===================================================================\r\n--- my_website/publications.html\r\n+++ my_website/publications.html\r\n@@ -53,9 +53,9 @@\r\n         </div>\r\n         <dl class=\"page-stats\" aria-label=\"Publication summary\">\r\n           <div><dt>Peer-reviewed</dt><dd>4</dd></div>\r\n           <div><dt>Span</dt><dd>2021–24</dd></div>\r\n-          <div><dt>Open tools</dt><dd>3</dd></div>\r\n+          <div><dt>Projects</dt><dd>3</dd></div>\r\n         </dl>\r\n       </div>\r\n     </section>\r\n \r\n\r\n"]
[340.311555, "o", "\u001b[0m← \u001b[0mEdit my_website/index.html\r\nIndex: my_website/index.html\r\n===================================================================\r\n--- my_website/index.html\r\n+++ my_website/index.html\r\n@@ -285,8 +285,16 @@\r\n         </div>\r\n \r\n         <ol class=\"timeline\">\r\n           <li class=\"timeline-item\">\r\n+            <span class=\"timeline-years\">Postdoctoral</span>\r\n+            <div class=\"timeline-content\">\r\n+              <h3>High-Throughput Imaging Analysis</h3>\r\n+              <p class=\"timeline-place\">Northborough Research Center</p>\r\n+              <p class=\"timeline-note\">Postdoctoral training in large-scale imaging analysis, bridging microscopy pipelines and computational models of neural structure.</p>\r\n+            </div>\r\n+          </li>\r\n+          <li class=\"timeline-item\">\r\n             <span class=\"timeline-years\">2014–2019</span>\r\n             <div class=\"timeline-content\">\r\n               <h3>Ph.D., Computational Biology</h3>\r\n               <p class=\"timeline-place\">Baywood Institute of Technology</p>\r\n\r\n"]
