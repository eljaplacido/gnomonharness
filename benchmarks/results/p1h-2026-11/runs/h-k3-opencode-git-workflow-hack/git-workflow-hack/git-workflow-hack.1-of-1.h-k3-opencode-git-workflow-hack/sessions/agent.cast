[390.522663, "o", "\u001b[0m$ \u001b[0mcd /tmp/opencode/pages-preview && python3 -m http.server 8124 >/tmp/opencode/preview-server.log 2>&1 & echo $! > /tmp/opencode/preview-server.pid; sleep 1; for p in index.html publications.html blog.html blog/graph-neural-networks-connectomics.html assets/css/styles.css; do printf '%-55s ' \"$p\"; curl -s -o /dev/null -w '%{http_code}\\n' \"http://127.0.0.1:8124/$p\"; done; kill \"$(cat /tmp/opencode/preview-server.pid)\" 2>/dev/null || true; kill \"$(cat /tmp/opencode/site-server.pid)\" 2>/dev/null || true; echo \"servers stopped\"\r\nindex.html                                              200\r\npublications.html                                       200\r\nblog.html                                               200\r\nblog/graph-neural-networks-connectomics.html            200\r\nassets/css/styles.css                                   200\r\nservers stopped\r\n"]
