[387.840262, "o", "\u001b[0m$ \u001b[0mrm -rf /tmp/opencode/pages-preview && mkdir -p /tmp/opencode/pages-preview && tar --dereference --hard-dereference --directory /app/my_website -cf /tmp/opencode/artifact.tar --exclude=.git --exclude=.github . && tar -tf /tmp/opencode/artifact.tar | sort && tar -xf /tmp/opencode/artifact.tar -C /tmp/opencode/pages-preview && test -f /tmp/opencode/pages-preview/index.html && test ! -e /tmp/opencode/pages-preview/.git && test ! -e /tmp/opencode/pages-preview/.github && echo \"artifact check: OK\"\r\n./\r\n./.gitignore\r\n./.nojekyll\r\n./README.md\r\n./assets/\r\n./assets/css/\r\n./assets/css/styles.css\r\n./assets/js/\r\n./assets/js/site.js\r\n./blog.html\r\n./blog/\r\n./blog/graph-neural-networks-connectomics.html\r\n./blog/interpretable-deep-learning.html\r\n./blog/machine-learning-single-cell-genomics.html\r\n./favicon.svg\r\n./index.html\r\n./info.md\r\n./publications.html\r\n./scripts/\r\n./scripts/check_site.py\r\nartifact check: OK\r\n"]
