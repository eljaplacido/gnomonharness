[20.600569, "o", "\u001b[0m$ \u001b[0mgrep -n \"role\\|Graduation\\|isEnrolledIn\\|hasEnrollmentDate\\|Professor\" /app/university_graph.ttl\r\n109:# Professors \r\r\n114:    uni:role \"Professor of Computer Science\" ;\r\r\n120:    uni:role \"Assistant Professor of Computer Science\" ;\r\r\n126:    uni:role \"Professor of Mathematics\" ;\r\r\n132:    uni:role \"Professor of History of Scienceand Technology\" ;\r\r\n138:    uni:role \"Professor of Biology\" ;\r\r\n144:    uni:role \"Professor of Mathematics\" ;\r\r\n150:    uni:role \"Assistant Professor of Engineering\" ;\r\r\n160:    uni:role \"Student\" .\r\r\n164:    uni:role \"Student\" .\r\r\n168:    uni:role \"Student\" .\r\r\n172:    uni:role \"Student\" .\r\r\n176:    uni:role \"Student\" .\r\r\n180:    uni:role \"Student\" .\r\r\n184:    uni:role \"Student\" .\r\r\n188:    uni:role \"Student\" .\r\r\n192:    uni:role \"Student\" .\r\r\n196:    uni:role \"Student\" .\r\r\n200:    uni:role \"Student\" .\r\r\n204:    uni:role \"Student\" .\r\r\n208:    uni:role \"Student\" .\r\r\n212:    uni:role \"Student\" .\r\r\n216:    uni:role \"Student\" .\r\r\n220:    uni:role \"Student\" .\r\r\n224:    uni:role \"Student\" .\r\r\n228:    uni:role \"Student\" .\r\r\n232:    uni:role \"Student\" .\r\r\n236:    uni:role \"Student\" .\r\r\n240:    uni:role \"Student\" .\r\r\n244:    uni:role \"Student\" .\r\r\n248:    uni:role \"Student\" .\r\r\n252:    uni:role \"Student\" .\r\r\n256:    uni:role \"Student\" .\r\r\n260:    uni:role \"Student\" .\r\r\n264:    uni:role \"Student\" .\r\r\n268:    uni:role \"Student\" .\r\r\n272:    uni:role \"Student\" .\r\r\n276:    uni:role \"Student\" .\r\r\n278:uni:Student1 uni:isEnrolledIn uni:CS101, uni:Bio101, uni:STS101, uni:EngUS302 ; uni:hasEnrollmentDate \"2024-01-10\"^^xsd:date .\r\r\n279:uni:Student2 uni:isEnrolledIn uni:CS101, uni:Bio101, uni:EngUS302 ; uni:hasEnrollmentDate \"2024-01-11\"^^xsd:date .\r\r\n280:uni:Student3 uni:isEnrolledIn uni:CS101, uni:Bio101, uni:EngUS302 ;