[101.188676, "o", "<returncode>\r\n0\r\n<output>\r\n(rdflib.term.URIRef('http://university.org/ontology/Biology_MIT'), rdflib.term.Literal('7', \r\ndatatype=rdflib.term.URIRef('http://www.w3.org/2001/XMLSchema#integer')), rdflib.term.Literal('http://university.org/ontology/Student1, \r\nhttp://university.org/ontology/Student2, http://university.org/ontology/Student3, http://university.org/ontology/Student7, \r\nhttp://university.org/ontology/Student9, http://university.org/ontology/Student10, http://university.org/ontology/Student11'))\r\n(rdflib.term.URIRef('http://university.org/ontology/ComputerScience_NTUA'), rdflib.term.Literal('12', \r\ndatatype=rdflib.term.URIRef('http://www.w3.org/2001/XMLSchema#integer')), rdflib.term.Literal('http://university.org/ontology/Student1, \r\n"]
