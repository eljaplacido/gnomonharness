[96.028262, "o", "\r\u001b[2K\u001b[32m⠦\u001b[0m Waiting for the LM to respond..."]
[96.108625, "o", "\r\u001b[2K\u001b[32m⠧\u001b[0m Waiting for the LM to respond..."]
