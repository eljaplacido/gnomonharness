[101.046923, "o", "\r\u001b[2K```\r\n/tmp/venv/bin/python - <<'PY'\r\nfrom rdflib import Graph\r\ng = Graph(); g.parse('/app/university_graph.ttl', format='turtle')\r\nq = '''\r\nPREFIX uni: <http://university.org/ontology/>\r\nPREFIX xsd: <http://www.w3.org/2001/XMLSchema#>\r\nSELECT ?dept (COUNT(DISTINCT ?student) AS ?count) (GROUP_CONCAT(DISTINCT ?student; separator=\", \") AS ?students) WHERE {\r\n ?course uni:isTaughtIn ?dept .\r\n ?student uni:isEnrolledIn ?course ; uni:hasEnrollmentDate ?ed .\r\n FILTER(?ed <= \"2025-08-16\"^^xsd:date)\r\n FILTER NOT EXISTS { ?student uni:hasGraduationDate ?gd . FILTER(?gd <= \"2025-08-16\"^^xsd:date) }\r\n} GROUP BY ?dept ORDER BY ?dept\r\n'''\r\nfor r in g.query(q): print(r)\r\nPY\r\n```\r\n\u001b[32m⠹\u001b[0m Waiting for the LM to respond..."]
[101.047138, "o", "\r\u001b[2K\u001b[32m⠹\u001b[0m Waiting for the LM to respond...\r\n\u001b[?25h\r\u001b[1A\u001b[2K"]
