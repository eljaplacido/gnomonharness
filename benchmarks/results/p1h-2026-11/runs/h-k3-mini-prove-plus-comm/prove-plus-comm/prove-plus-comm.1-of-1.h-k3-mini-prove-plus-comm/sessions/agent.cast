[81.864655, "o", "<returncode>\r\n0\r\n<output>\r\nWelcome to Coq 8.18.0\r\n\r\nCoq < [Loading ML file ring_plugin.cmxs (using legacy method) ... done]\r\n\r\nCoq < plus_n_Sm\r\n     : forall n m : nat, S (n + m) = n + S m\r\n\r\nCoq < plus_Sn_m\r\n     : forall n m : nat, S n + m = S (n + m)\r\n\r\nCoq < Nat.add_succ_r\r\n     : forall n m : nat, n + S m = S (n + m)\r\n\r\nCoq < Nat.add_succ_l\r\n     : forall n m : nat, S n + m = S (n + m)\r\n\r\nCoq < plus_n_O\r\n     : forall n : nat, n = n + 0\r\n\r\nCoq < Nat.add_0_r\r\n     : forall n : nat, n + 0 = n\r\n\r\nCoq < \r\n\r\n"]
