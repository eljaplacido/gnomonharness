import mujoco, numpy as np, time
base = open('model_ref.xml').read()
FULL = mujoco.mjtState.mjSTATE_FULLPHYSICS

def mk(opt='', size='<size memory="2M"/>', extra=''):
    s = base.replace('<size memory="2M"/>', size + (f'<option {opt}/>' if opt else ''))
    return s.replace('<compiler autolimits="true"/>', '<compiler autolimits="true"/>'+extra)

def sim(model, seed):
    d = mujoco.MjData(model)
    rng = np.random.default_rng(seed)
    d.qpos += rng.normal(0,0.01,size=d.qpos.shape)
    mujoco.mj_forward(model,d)
    for _ in range(int(2.0/model.opt.timestep)): mujoco.mj_step(model,d)
    s=np.zeros(mujoco.mj_stateSize(model,FULL)); mujoco.mj_getState(model,d,s,FULL); return s

def timeit(model,n=20):
    ts=[]
    for i in range(n):
        t0=time.perf_counter(); sim(model,i); ts.append(time.perf_counter()-t0)
    return np.mean(ts)

ref = mujoco.MjModel.from_xml_string(base)
seeds = list(range(12))
refs = {s: sim(ref,s) for s in seeds}
tref = timeit(ref)
print(f"ref {tref*1000:.1f} ms")

cands = {
 'PGS': mk('solver="PGS"'),
 'PGS mem1M': mk('solver="PGS"','<size memory="1M"/>'),
 'PGS nomem': mk('solver="PGS"',''),
 'PGS mem4M': mk('solver="PGS"','<size memory="4M"/>'),
 'PGS it=50': mk('solver="PGS" iterations="50"'),
 'PGS sparse': mk('solver="PGS" jacobian="sparse"'),
}
for name,x in cands.items():
    try: m = mujoco.MjModel.from_xml_string(x)
    except Exception as e: print(name,"FAIL",e); continue
    errs=[np.abs(sim(m,s)-refs[s]).max() for s in seeds[:6]]
    t=timeit(m)
    print(f"{name:14s} {t*1000:7.1f} ms pctg={t/tref:.3f} maxerr={max(errs):.2e}")
