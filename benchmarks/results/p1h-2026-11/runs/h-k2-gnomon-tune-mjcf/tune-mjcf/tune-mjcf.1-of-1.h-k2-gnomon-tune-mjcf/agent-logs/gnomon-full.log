```python
import mujoco, numpy as np, time
base = open('model_ref.xml').read()
FULL = mujoco.mjtState.mjSTATE_FULLPHYSICS
EN = int(mujoco.mjtEnableBit.mjENBL_EULERDAMP)

def build(opt_attrs='', flags=None, memory='2M'):
    opt = '<option'
    if opt_attrs: opt += ' ' + opt_attrs
    opt += '>'
    if flags:
        opt += '<flag ' + flags + '/>'
    opt += '</option>'
    return base.replace('<size memory="2M"/>', f'<size memory="{memory}"/>' + opt)

models = {}
def add(name, xml):
    m = mujoco.MjModel.from_xml_string(xml)
    print(name, 'eulerdamp on =', bool(m.opt.enableflags & EN), 'solver', m.opt.solver, 'int', m.opt.integrator)
    models[name]=m
```

