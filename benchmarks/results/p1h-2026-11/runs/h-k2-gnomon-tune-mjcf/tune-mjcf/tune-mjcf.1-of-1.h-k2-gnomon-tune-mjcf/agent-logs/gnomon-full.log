d = mujoco.MjData(ref); mujoco.mj_forward(ref,d)
t0=time.perf_counter()
for _ in range(2000): mujoco.mj_Euler(ref,d)
print("ref mj_Euler us %.1f"%((time.perf_counter()-t0)/2000*1e6))

