import mujoco, numpy as np, time
base = open('model_ref.xml').read()
FULL = mujoco.mjtState.mjSTATE_FULLPHYSICS

def variant(**opts):
    attrs = ' '.join(f'{k}="{v}"' for k,v in opts.items())
    return base.replace('<size memory="2M"/>', f'<size memory="2M"/><option {attrs}/>')

def sim(model, seed):
    d = mujoco.MjData(model)
    rng = np.random.default_rng(seed)
    d.qpos += rng.normal(0,0.01,size=d.qpos.shape)
    mujoco.mj_forward(model,d)
    for _ in range(int(2.0/model.opt.timestep)): mujoco.mj_step(model,d)
    s = np.zeros(mujoco.mj_stateSize(model, FULL)); mujoco.mj_getState(model,d,s,FULL); return s

def timeit(model, n=20):
    ts=[]
    for i in range(n):
        t0=time.perf_counter(); sim(model, i); ts.append(time.perf_counter()-t0)
    return np.mean(ts), np.array(ts)

ref = mujoco.MjModel.from_xml_string(base)
tref,_ = timeit(ref)
print(f"ref {tref*1000:.1f} ms")

cands = {
 'PGS': dict(solver='PGS'),
 'PGS+sparse': dict(solver='PGS', jacobian='sparse'),
 'PGS+sparse+implicitfast': dict(solver='PGS', jacobian='sparse', integrator='implicitfast'),
 'PGS+dt4m': dict(solver='PGS', jacobian='sparse', timestep='0.004'),
 'PGS+dt1m': dict(solver='PGS', jacobian='sparse', timestep='0.001'),
}
for name,o in cands.items():
    try:
        m = mujoco.MjModel.from_xml_string(variant(**o))
    except Exception as e:
        print(name, "LOADFAIL", e); continue
    t,_ = timeit(m)
    errs = [np.abs(sim(m,s)-sim(ref,s)).max() for s in range(4)]
    ok = all(np.allclose(sim(m,s), sim(ref,s), atol=1e-5) for s in range(4))
    print(f"{name:26s} {t*1000:7.1f} ms  pctg={t/tref:.3f}  maxerr={max(errs):.2e} ok={ok}")
