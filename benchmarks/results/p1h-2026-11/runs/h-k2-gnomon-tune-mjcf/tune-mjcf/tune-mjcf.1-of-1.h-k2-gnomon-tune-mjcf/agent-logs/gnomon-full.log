Let me finalize the code to be robust:

```python
import mujoco, numpy as np, time
base = open('model_ref.xml').read()
FULL = mujoco.mjtState.mjSTATE_FULLPHYSICS
EN = int(getattr(mujoco.mjtEnableBit,'mjENBL_EULERDAMP',0))

def build(attrs='', flags=None):
    o = '<option' + ((' '+attrs) if attrs else '') + '>'
    if flags: o += '<flag ' + flags + '/>'
    o += '</option>'
    return base.replace('<size memory="2M"/>', '<size memory="2M"/>' + o)

def sim(model, seed):
    d = mujoco.MjData(model)
    rng = np.random.default_rng(seed)
    d.qpos += rng.normal(0,0.01,size=d.qpos.shape)
    mujoco.mj_forward(model,d)
    for _ in range(int(2.0/model.opt.timestep)): mujoco.mj_step(model,d)
    s=np.zeros(mujoco.mj_stateSize(model,FULL)); mujoco.mj_getState(model,d,s,FULL); return s

def timeit(model,n=12):
    ts=[]
    for i in range(n):
        t0=time.perf_counter(); sim(model,i); ts.append(time.perf_counter()-t0)
    return float(np.mean(ts))

ref = mujoco.MjModel.from_xml_string(base)
print("ref eulerdamp enabled:", bool(ref.opt.enableflags & EN) if EN else 'ENUM MISSING', ref.opt.enableflags)
specs = [("pgs",'solver="PGS"',None),
         ("pgs+dampoff",'solver="PGS"','eulerdamp="disable"'),
         ("dampoff",'','eulerdamp="disable"'),
         ("pgs tight",'solver="PGS" tolerance="1e-12"',None),
         ("pgs tight+dampoff",'solver="PGS" tolerance="1e-12"','eulerdamp="disable"')]
models={}
for name,a,f in specs:
    try:
        mm = mujoco.MjModel.from_xml_string(build(a,f))
    except Exception as e:
        print(name,'LOAD FAIL',e); continue
    print(f"{name}: eulerdamp_on={bool(mm.opt.enableflags & EN)} solver={mm.opt.solver}")
    models[name]=mm
seeds=list(range(16))
refstates={s:sim(ref,s) for s in seeds}
tref=timeit(ref)
print(f"ref {tref*1000:.1f} ms")
for name,mm in models.items():
    errs=[]; bad=0
    for s in seeds:
        st=sim(mm,s)
        if not np.isfinite(st).all(): bad+=1; continue
        errs.append(np.abs(st-refstates[s]).max())
        if not np.allclose(st,refstates[s],atol=1e-5): bad+=1
    t=timeit(mm)
    print(f"{name:20s} {t*1000:7.1f} ms pctg={t/tref:.3f} maxerr={max(errs):.2e} badeg={bad}")
EOF
```

