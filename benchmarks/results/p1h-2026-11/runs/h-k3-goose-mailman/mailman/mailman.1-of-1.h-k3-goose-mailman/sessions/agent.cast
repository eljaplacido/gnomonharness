[81.159376, "o", "    \u001b[2m  Free Software Foundation, Inc. http://www.list.org\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2mOptions:\u001b[0m\r\n    \u001b[2m  --version          Show the version and exit.\u001b[0m\r\n    \u001b[2m  --run-as-root      Running mailman commands as root is not recommended and\u001b[0m\r\n    \u001b[2m                     mailman will refuse to run as root unless this option is\u001b[0m\r\n    \u001b[2m                     specified.\u001b[0m\r\n"]
