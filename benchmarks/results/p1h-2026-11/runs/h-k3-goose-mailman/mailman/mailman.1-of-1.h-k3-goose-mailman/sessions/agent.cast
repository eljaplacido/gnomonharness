[59.937581, "o", "    \u001b[2m            if subaddress is not None:\u001b[0m\r\n    \u001b[2m                # Check that local-subaddress is not an actual list name.\u001b[0m\r\n    \u001b[2m                listname = '{}-{}@{}'.format(local, subaddress, domain)\u001b[0m\r\n    \u001b[2m                if listname in listnames:\u001b[0m\r\n    \u001b[2m                    local = '{}-{}'.format(local, subaddress)\u001b[0m\r\n    \u001b[2m                    subaddress = None\u001b[0m\r\n    \u001b[2m            listname = '{}@{}'.format(local, domain)\u001b[0m\r\n    \u001b[2m            if listname not in listnames:\u001b[0m\r\n    \u001b[2m                return ERR_550\u001b[0m\r\n    \u001b[2m            canonical_subaddress = SUBADDRESS_NAMES.get(subaddress)\u001b[0m\r\n    \u001b[2m\u001b[3m... (121 lines hidden, /toggle to show all)\u001b[0m\r\n    \u001b[2m        # All done; returning this big status string should give the expected\u001b[0m\r\n    \u001b[2m        # response to the LMTP client.\u001b[0m\r\n    \u001b[2m        return CRLF.join(status)\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2mclass LMTPController(Controller):\u001b[0m\r\n    \u001b[2m    def factory(self):\u001b[0m\r\n    \u001b[2m        server = LMTP(self.handler)\u001b[0m\r\n    \u001b[2m        server.__ident__ = 'GNU Mailman LMTP runner 2.0'\u001b[0m\r\n    \u001b[2m        return server\u001b[0m\r\n"]
