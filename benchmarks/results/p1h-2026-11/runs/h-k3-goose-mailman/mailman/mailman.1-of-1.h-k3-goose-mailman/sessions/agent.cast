[24.840909, "o", "    \u001b[2m/usr/sbin/postfix\u001b[0m\r\n    \u001b[2m/usr/bin/mailman\u001b[0m\r\n    \u001b[2m---\u001b[0m\r\n    \u001b[2mmailman.cfg\u001b[0m\r\n    \u001b[2m--- postfix\u001b[0m\r\n    \u001b[2mmail_version = 3.8.6\u001b[0m\r\n    \u001b[2m--- users\u001b[0m\r\n    \u001b[2msync:x:4:65534:sync:/bin:/bin/sync\u001b[0m\r\n    \u001b[2mgames:x:5:60:games:/usr/games:/usr/sbin/nologin\u001b[0m\r\n    \u001b[2mman:x:6:12:man:/var/cache/man:/usr/sbin/nologin\u001b[0m\r\n    \u001b[2m\u001b[3m... (7 lines hidden, /toggle to show all)\u001b[0m\r\n    \u001b[2mlist:x:38:38:Mailing List Manager:/var/list:/usr/sbin/nologin\u001b[0m\r\n    \u001b[2mirc:x:39:39:ircd:/run/ircd:/usr/sbin/nologin\u001b[0m\r\n    \u001b[2m_apt:x:42:65534::/nonexistent:/usr/sbin/nologin\u001b[0m\r\n    \u001b[2mnobody:x:65534:65534:nobody:/nonexistent:/usr/sbin/nologin\u001b[0m\r\n    \u001b[2mubuntu:x:1000:1000:Ubuntu:/home/ubuntu:/bin/bash\u001b[0m\r\n    \u001b[2msystemd-network:x:998:998:systemd Network Management:/:/usr/sbin/nologin\u001b[0m\r\n    \u001b[2msystemd-timesync:x:996:996:systemd Time Synchronization:/:/usr/sbin/nologin\u001b[0m\r\n    \u001b[2mmessagebus:x:100:102::/nonexistent:/usr/sbin/nologin\u001b[0m\r\n    \u001b[2msystemd-resolve:x:995:995:systemd Resolver:/:/usr/sbin/nologin\u001b[0m\r\n    \u001b[2mpostfix:x:101:103::/var/spool/postfix:/usr/sbin/nologin\u001b[0m\r\n"]
