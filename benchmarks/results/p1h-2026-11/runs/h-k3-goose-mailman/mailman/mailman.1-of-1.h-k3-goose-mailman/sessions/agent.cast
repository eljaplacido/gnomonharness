[28.024967, "o", "    \u001b[2m\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2mif __name__ == \"__main__\":\u001b[0m\r\n    \u001b[2m    test_simple_local_delivery()\u001b[0m\r\n    \u001b[2m    test_mlist_exists()\u001b[0m\r\n    \u001b[2m    test_join_flow()\u001b[0m\r\n    \u001b[2m=== CFG ===\u001b[0m\r\n    \u001b[2m# Copyright (C) 2008-2017 by the Free Software Foundation, Inc.\u001b[0m\r\n    \u001b[2m#\u001b[0m\r\n    \u001b[2m# This file is part of GNU Mailman.\u001b[0m\r\n    \u001b[2m\u001b[3m... (258 lines hidden, /toggle to show all)\u001b[0m\r\n    \u001b[2mlmtp_port: 8024\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2m# Where can we find the mail server specific configuration file?  The path can\u001b[0m\r\n    \u001b[2m# be either a file system path or a Python import path.  If the value starts\u001b[0m\r\n    \u001b[2m# with python: then it is a Python import path, otherwise it is a file system\u001b[0m\r\n    \u001b[2m# path.  File system paths must be absolute since no guarantees are made about\u001b[0m\r\n    \u001b[2m# the current working directory.  Python paths should not include the trailing\u001b[0m\r\n    \u001b[2m# .cfg, which the file must end with.\u001b[0m\r\n    \u001b[2m#configuration: python:mailman.config.exim4\u001b[0m\r\n    \u001b[2mconfiguration: python:mailman.config.postfix\u001b[0m\r\n    \u001b[2mtotal 16\u001b[0m\r\n    \u001b[2mdrwxr-xr-x 3 list list 4096 Oct 31 12:15 .\u001b[0m\r\n    \u001b[2mdrwxr-xr-x 1 root root 4096 Oct 31 12:15 ..\u001b[0m\r\n    \u001b[2mdrwxrwx--- 2 list list 4096 Oct 31 12:15 data\u001b[0m\r\n    \u001b[2m---\u001b[0m\r\n    \u001b[2mdynamicmaps.cf\u001b[0m\r\n    \u001b[2mdynamicmaps.cf.d\u001b[0m\r\n    \u001b[2mmain.cf\u001b[0m\r\n    \u001b[2mmain.cf.proto\u001b[0m\r\n    \u001b[2mmakedefs.out\u001b[0m\r\n    \u001b[2m\u001b[3m... (46 lines hidden, /toggle to show all)\u001b[0m\r\n    \u001b[2mroot         500  0.0  0.0   4428  3008 pts/1    S    09:06   0:00 bash -c ls -la /var/lib/mailman3 2>/dev/null; echo \"---\"; ls /etc/postfix; echo \"---\"; postconf -n; echo \"--- running\"; ps aux | head -20; echo \"--- mailman ver\"; mailman --version 2>&1 | head -5; python3 -c \"import mailman; print(mailman.__version__)\"\u001b[0m\r\n    \u001b[2mroot         505  0.0  0.0   8024  3828 pts/1    R    09:06   0:00 ps aux\u001b[0m\r\n    \u001b[2mroot         506  0.0  0.0   2676  1592 pts/1    S    09:06   0:00 head -20\u001b[0m\r\n    \u001b[2m--- mailman ver\u001b[0m\r\n    \u001b[2mGNU Mailman 3.3.8 (Tom Sawyer)\u001b[0m\r\n    \u001b[2mTraceback (most recent call last):\u001b[0m\r\n    \u001b[2m  File \"<string>\", line 1, in <module>\u001b[0m\r\n    \u001b[2mAttributeError: module 'mailman' has no attribute '__version__'\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2mCommand exited with code 1\u001b[0m\r\n"]
