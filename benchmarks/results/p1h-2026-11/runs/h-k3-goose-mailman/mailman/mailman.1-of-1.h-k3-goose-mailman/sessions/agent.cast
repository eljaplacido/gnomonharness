[155.426735, "o", "    \u001b[2m# This address is the \"site owner\" address.  Certain messages which must be\u001b[0m\r\n    \u001b[2m# delivered to a human, but which can't be delivered to a list owner (e.g. a\u001b[0m\r\n    \u001b[2m# bounce from a list owner), will be sent to this address.  It should point to\u001b[0m\r\n    \u001b[2m# a human.\u001b[0m\r\n    \u001b[2msite_owner: reading-group-owner@local.edu\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2m# This is the local-part of an email address used in the From field whenever a\u001b[0m\r\n    \u001b[2m# message comes from some entity to which there is no natural reply recipient.\u001b[0m\r\n    \u001b[2m# Mailman will append '@' and the host name of the list involved.  This\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2m\u001b[3m... (11 lines hidden, /toggle to show all)\u001b[0m\r\n    \u001b[2mlmtp_port: 8024\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2m# Where can we find the mail server specific configuration file?  The path can\u001b[0m\r\n    \u001b[2m# be either a file system path or a Python import path.  If the value starts\u001b[0m\r\n    \u001b[2m# with python: then it is a Python import path, otherwise it is a file system\u001b[0m\r\n    \u001b[2m# path.  File system paths must be absolute since no guarantees are made about\u001b[0m\r\n    \u001b[2m# the current working directory.  Python paths should not include the trailing\u001b[0m\r\n    \u001b[2m# .cfg, which the file must end with.\u001b[0m\r\n    \u001b[2m#configuration: python:mailman.config.exim4\u001b[0m\r\n    \u001b[2mconfiguration: python:mailman.config.postfix\u001b[0m\r\n"]
[159.145207, "o", "\r\n  \u001b[2m────────────────────────────────────────\u001b[0m\r\n  \u001b[2m▸\u001b[0m \u001b[2mshell\u001b[0m\r\n    \u001b[2mcommand\u001b[0m: \u001b[32mmkdir -p /run/mailman3 && chown list:list /run/mailman3 && chown -R list:list /var/log/mailman3 /var/lib/mailman3 && chmod 755 /var/log/mailman3...\u001b[0m\r\n\r\n\r\n  \u001b[2m────────────────────────────────────────\u001b[0m\r\n  \u001b[2m▸\u001b[0m \u001b[2mshell\u001b[0m\r\n    \u001b[2mcommand\u001b[0m: \u001b[32mls -la /run/mailman3 /var/lib/mailman3/lists 2>/dev/null; grep -n \"DATA_DIR\\|data_dir\" /etc/mailman3/mailman.cfg | head\u001b[0m\r\n\r\n"]
