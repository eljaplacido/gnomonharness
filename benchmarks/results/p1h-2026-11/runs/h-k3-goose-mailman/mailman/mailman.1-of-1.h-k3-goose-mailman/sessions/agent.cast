[767.13772, "o", "    \u001b[2m\u001b[0m\r\n    \u001b[2mHello, this is the GNU Mailman server at local.edu.\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2mWe have received a registration request for the email address\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2m    85d38a1f2894@local.edu\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2mBefore you can start using GNU Mailman at this site, you must first confirm\u001b[0m\r\n    \u001b[2mthat this is your email address.  You can do this by replying to this message.\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2mOr you should include the following line -- and only the following\u001b[0m\r\n    \u001b[2mline -- in a message to reading-group-request@local.edu:\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2m    confirm 067d0c36cb74f2c14afeb3...\u001b[0m\r\n"]
[767.137854, "o", "    \u001b[2mReply to reading-group-confirm+067d0c36cb74f2c14afeb3b861c437801629c823@local.edu from 85d38a1f2894@local.edu for join\u001b[0m\r\n    \u001b[2mTraceback (most recent call last):\u001b[0m\r\n    \u001b[2m  File \"/tmp/t4.py\", line 40, in <module>\u001b[0m\r\n    \u001b[2m    print(\"members:\", sorted(m.address for m in mlist.members.members))\u001b[0m\r\n    \u001b[2m                      ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\u001b[0m\r\n    \u001b[2mTypeError: '<' not supported between instances of 'Address' and 'Address'\u001b[0m\r\n"]
