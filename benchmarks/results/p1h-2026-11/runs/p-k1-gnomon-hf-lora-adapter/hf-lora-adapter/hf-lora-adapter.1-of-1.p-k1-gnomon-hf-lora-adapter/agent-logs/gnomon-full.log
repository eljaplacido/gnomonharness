from collections import defaultdict
from datasets import load_dataset
from transformers import AutoTokenizer, XLMRobertaForSequenceClassification
torch.set_grad_enabled(False)

tok=AutoTokenizer.from_pretrained('merged_model')
model=XLMRobertaForSequenceClassification.from_pretrained('merged_model').eval()
labels=json.load(open('dl/adapter/config.json'))['label2id']

ds=load_dataset('papluca/language-identification', split='test')
