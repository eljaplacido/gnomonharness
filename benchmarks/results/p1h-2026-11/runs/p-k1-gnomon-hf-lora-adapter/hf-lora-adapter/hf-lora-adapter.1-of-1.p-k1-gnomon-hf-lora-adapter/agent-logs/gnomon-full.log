# subsample 200 per language
by_lang=defaultdict(list)
for ex in ds:
    l=ex['labels']
    if len(by_lang[l])<200: by_lang[l].append(ex['text'])
texts=[];golds=[]
for l,t in by_lang.items():
    for x in t: texts.append(x); golds.append(l)
print('eval n=',len(texts),'langs=',len(by_lang))
preds=[]
for i in range(0,len(texts),32):
    b=texts[i:i+32]
    e=tok(b,padding=True,truncation=True,max_length=64,return_tensors='pt')
    preds+=model(**e).logits.argmax(-1).tolist()
corr=0; per=defaultdict(lambda:[0,0])
for g,p in zip(golds,preds):
    ok = labels[g]==p
    corr+=ok; per[g][0]+=ok; per[g][1]+=1
acc=corr/len(golds)
print(f'overall acc = {acc*100:.2f}%')
worst=min(per.items(), key=lambda kv: kv[1][0]/kv[1][1])
for l,(c,n) in sorted(per.items(), key=lambda kv: kv[1][0]/kv[1][1]):
    print(f'  {l}: {c/n*100:6.2f}%  ({c}/{n})')
print(f'macro over langs = {sum(c/n for c,n in per.values())/len(per)*100:.2f}%')
print('worst:',worst[0], worst[1][0]/worst[1][1])
print('PASS' if acc>=0.95 and all(c/n>=0.75 for c,n in per.values()) else 'FAIL')
