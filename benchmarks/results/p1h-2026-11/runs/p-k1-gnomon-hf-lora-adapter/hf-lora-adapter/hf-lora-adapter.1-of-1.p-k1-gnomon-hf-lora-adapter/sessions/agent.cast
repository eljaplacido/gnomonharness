[20.693572, "o", "\u001b[?2004h> ```json\r\n\u001b[?2004l\r\u001b[?2004h> [\r\n\u001b[?2004l\r\u001b[?2004h>   {\r\n\u001b[?2004l\r"]
[20.693596, "o", "\u001b[?2004h> "]
