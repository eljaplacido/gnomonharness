[12.696134, "o", "\u001b[?2004h> "]
[12.696204, "o", "   1. All arguments in the '\"'\"'args'\"'\"' list will be passed directly to jq\r\n\u001b[?2004l\r\u001b[?2004h"]
[12.696212, "o", "> "]
[12.69628, "o", "   2. The filter string will be passed as the jq filter expression\r\n\u001b[?2004l\r"]
[12.696286, "o", "\u001b[?2004h> "]
[12.69636, "o", "   3. The input file '\"'\"'/app/users.json'\"'\"' is fixed and will be used as input\r\n\u001b[?2004l\r"]
[12.696365, "o", "\u001b[?2004h> "]
[12.696438, "o", "   4. The output will be redirected to '\"'\"'/app/active_users_report.json'\"'\"'\r\n\u001b[?2004l\r"]
[12.696447, "o", "\u001b[?2004h> "]
