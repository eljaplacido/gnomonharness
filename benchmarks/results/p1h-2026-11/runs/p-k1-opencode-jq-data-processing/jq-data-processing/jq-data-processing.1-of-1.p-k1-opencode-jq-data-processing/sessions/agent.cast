[30.771771, "o", "\u001b[0m$ \u001b[0mbash /app/cmd.sh && head -40 /app/active_users_report.json && jq 'length' /app/active_users_report.json\r\n[\r\n  {\r\n    \"user_id\": 443,\r\n    \"username\": \"acosta\",\r\n    \"email\": \"ybell@yahoo.com\",\r\n    \"last_login\": \"2026-04-05\",\r\n    \"role_count\": 1,\r\n    \"primary_role\": \"admin\"\r\n  },\r\n  {\r\n    \"user_id\": 273,\r\n    \"username\": \"alexisrogers\",\r\n    \"email\": \"gregorychase@yahoo.com\",\r\n    \"last_login\": \"2026-04-06\",\r\n    \"role_count\": 1,\r\n    \"primary_role\": \"user\"\r\n  },\r\n  {\r\n    \"user_id\": 292,\r\n    \"username\": \"allencarlos\",\r\n    \"email\": \"griffinemily@hotmail.com\",\r\n    \"last_login\": \"2026-04-09\",\r\n    \"role_count\": 2,\r\n    \"primary_role\": \"viewer\"\r\n  },\r\n  {\r\n    \"user_id\": 224,\r\n    \"username\": \"alyssasanders\",\r\n    \"email\": \"john10@hotmail.com\",\r\n    \"last_login\": \"2026-01-18\",\r\n    \"role_count\": 0,\r\n    \"primary_role\": null\r\n  },\r\n  {\r\n    \"user_id\": 408,\r\n    \"username\": \"amberfields\",\r\n    \"email\": \"tapiaaaron@hotmail.com\",\r\n    \"last_login\": \"2026-08-17\",\r\n    \"role_count\": 0,\r\n    \"primary_ro"]
