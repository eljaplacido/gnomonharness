[12.69592, "o", "   `jq $(yq -r '\"'\"'.args[]'\"'\"' /app/jq_args.yaml) \"$(yq -r '\"'\"'.filter'\"'\"' /app/jq_args.yaml)\" /app/users.json > /app/active_users_report.json`\r\n\u001b[?2004l\r\u001b[?2004h>    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[12.695974, "o", "   For the example above, the constructed command would be:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[12.696089, "o", "   `jq --unbuffered --argjson min_count 5 --tab '\"'\"'group_by(.address.city)'\"'\"' /app/users.json > /app/active_users_report.json`\r\n\u001b[?2004l\r"]
