[272.017021, "o", "\u001b[0m$ \u001b[0mldconfig -p | grep -E 'libstp|libcryptominisat' | head; echo '---without LD_LIBRARY_PATH---'; env -u LD_LIBRARY_PATH bash --noprofile --norc -c 'source ~/.bashrc; PATH=/usr/local/bin:/usr/bin:/bin; klee --version >/dev/null && echo KLEE_RUNS'; echo '---ldd---'; ldd /usr/local/bin/klee | grep -E 'stp|LLVM|not found' | head\r\nlibstp.so.2.4 (libc6,AArch64) => /usr/local/lib/libstp.so.2.4\r\n\tlibstp.so (libc6,AArch64) => /usr/local/lib/libstp.so\r\n\tlibcryptominisat5.so.5.11 (libc6,AArch64) => /lib/aarch64-linux-gnu/libcryptominisat5.so.5.11\r\n\tlibcryptominisat5.so (libc6,AArch64) => /lib/aarch64-linux-gnu/libcryptominisat5.so\r\n---without LD_LIBRARY_PATH---\r\nKLEE_RUNS\r\n---ldd---\r\n\tlibstp.so.2.4 => /usr/local/lib/libstp.so.2.4 (0x0000fdc725f90000)\r\n\tlibLLVM-16.so.1 => /usr/lib/llvm-16/lib/libLLVM-16.so.1 (0x0000fdc71eae0000)\r\n"]
