[252.795279, "o", "\u001b[0m$ \u001b[0mklee --version 2>&1 | head -10; echo '---'; klee --help 2>&1 | grep -iE 'solver|version|uclibc' | head -20; echo '---runtime---'; ls /usr/local/lib/klee/runtime | head -5; echo '---install config---'; grep -rn \"KLEE_INSTALL_RUNTIME_DIR\\|KLEE_RUNTIME_DIRECTORY\" /tmp/opencode/src/klee/build/include/klee/Config/config.h /tmp/opencode/src/klee/CMakeLists.txt | head -20\r\nKLEE 3.4-pre (https://klee-se.org/)\r\n  Build mode: Release (Asserts: ON)\r\n  Build revision: 78df9e234fdb806530184ecd8963268da87418c5\r\n\r\nUbuntu LLVM version 16.0.6\r\n  Optimized build.\r\n---\r\n  --cex-cache-superset                                    - Try substituting SAT superset counterexample before asking the SMT solver (default=false)\r\n  --cex-cache-try-all                                     - Try substituting all counterexamples before asking the SMT solver (default=false)\r\n  --debug-assignment-validating-solver                    - Debug the correctness of generated assignments (default=false)\r\n  --debug-crosscheck-core-solver=<value>                  - Specifiy a solver to use for crosschecking the results of the core solver\r\n    =dummy                                                -   Dummy solver\r\n  --debug-validate-solver                                 - Crosscheck the results of the solver chain above the core solver with the results of the core solver (default=false)\r\n  --equality-substitution                                 - Simplify equality expressions before querying the solver (default=true)\r\n  --ignore-stp-failures                                   - Ignore any STP solver failures (default=false)\r\n  --log-partial-queries-early                             - Log queries before calling the solver (default=false)\r\n  --max-solver-time=<string>                              - Maximum amount of time for a single SMT query (default=0s (off)). Enables --use-forked-solver\r\n  --solver-backend=<value>                                - Specifiy the core solver backend to use\r\n    =dummy                                                -   Dummy solver\r\n  --solver-optimize-divides                               - Optimize constant divides into add/shift/multiplies before passing them to the core SMT solver (default=false)\r\n  --stp-sat-solver=<value>                                - Set the underlying SAT solver for STP (default=cryptominisat)\r\n  --use-fast-cex-solver                                   - Enable an experimental range-based solver (default=false)\r\n  --use-forked-solver                                     - Run the core SMT solver in a forked process (default=true)\r\n  --use-independent-solver                                - Use constraint independence (default=true)\r\n    =solver:kquery                                        -   All queries reaching the solver in .kquery (KQuery) format\r\n    =solver:smt2                                          -   All queries reaching the solver in .smt2 (SMT-LIBv2) format\r\n  --version                                               - Display the version of this program\r\n---runtime---\r\nlibkleeRuntimeFortify64_Debug+Asserts.bca\r\nlibkleeRuntimeFortify64_Debug.bca\r\nlibkleeRuntimeFortify64_Release+Asserts.bca\r\nlibkleeRuntimeFortify64_Release+Debug+Asserts.bca\r\nlibkleeRuntimeFortify64_Release+Debug.bca\r\n---install config---\r\n/tmp/opencode/src/klee/build/include/klee/Config/config.h:105:#define KLEE_INSTALL_RUNTIME_DIR \"/usr/local/lib/klee/runtime\"\r\n/tmp/opencode/src/klee/CMakeLists.txt:467:set(KLEE_INSTALL_RUNTIME_DIR \"${CMAKE_INSTALL_FULL_LIBDIR}/klee/runtime\")\r\n/tmp/opencode/src/klee/CMakeLists.txt:470:set(KLEE_RUNTIME_DIRECTORY \"${CMAKE_BINARY_DIR}/runtime/lib\")\r\n/tmp/opencode/src/klee/CMakeLists.txt:472:file(MAKE_DIRECTORY ${KLEE_RUNTIME_DIRECTORY})\r\n/tmp/opencode/src/klee/CMakeLists.txt:500:    \"${KLEE_RUNTIME_DIRECTORY}/${KLEE_UCLIBC_BCA_NAME}\"\r\n/tmp/opencode/src/klee/CMakeLists.txt:554:  file(MAKE_DIRECTORY \"${KLEE_RUNTIME_DIRECTORY}\")\r\n/tmp/opencode/src/klee/CMakeLists.txt:557:    \"${KLEE_RUNTIME_DIRECTORY}/${KLEE_LIBCXX_BC_PATH}\"\r\n"]
