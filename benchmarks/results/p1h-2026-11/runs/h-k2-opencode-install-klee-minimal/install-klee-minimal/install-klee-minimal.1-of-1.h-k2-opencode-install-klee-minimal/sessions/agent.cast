[243.117892, "o", "\u001b[0m$ \u001b[0mcat > /tmp/opencode/klee_test.c <<'EOF'\r\n#include <klee/klee.h>\r\n#include <assert.h>\r\nint main(void) {\r\n  int a;\r\n  klee_make_symbolic(&a, sizeof(a), \"a\");\r\n  if (a == 42) {\r\n    klee_assert(0);\r\n  }\r\n  return 0;\r\n}\r\nEOF\r\nclang-16 -I/usr/local/include -emit-llvm -c -g -O0 -Xclang -disable-O0-optnone /tmp/opencode/klee_test.c -o /tmp/opencode/klee_test.bc && rm -rf /tmp/opencode/klee_out && klee --solver-backend=stp --output-dir=/tmp/opencode/klee_out /tmp/opencode/klee_test.bc 2>&1 | tail -30; echo \"exit=$?\"; ls /tmp/opencode/klee_out | head\r\nKLEE: output directory is \"/tmp/opencode/klee_out\"\r\nKLEE: Using STP solver backend\r\nKLEE: SAT solver: CryptoMiniSat\r\nKLEE: Deterministic allocator: Using quarantine queue size 8\r\nKLEE: Deterministic allocator: globals (start-address=0xe6742ac00000 size=10 GiB)\r\nKLEE: Deterministic allocator: constants (start-address=0xe671aac00000 size=10 GiB)\r\nKLEE: Deterministic allocator: heap (start-address=0xe571aac00000 size=1024 GiB)\r\nKLEE: Deterministic allocator: stack (start-address=0xe551aac00000 size=128 GiB)\r\nKLEE: ERROR: /tmp/opencode/klee_test.c:7: ASSERTION FAIL: 0\r\nKLEE: NOTE: now ignoring this error at this location\r\nKLEE: Deterministic allocator: Using quarantine queue size 8\r\nKLEE: Deterministic allocator: globals (start-address=0xe54f2ac00000 size=10 GiB)\r\nKLEE: Deterministic allocator: constants (start-address=0xe54caac00000 size=10 GiB)\r\nKLEE: Deterministic allocator: heap (start-address=0xe44caac00000 size=1024 GiB)\r\nKLEE: Deterministic allocator: stack (start-address=0xe42caac00000 size=128 GiB)\r\n\r\nKLEE: done: total instructions = 10\r\nKLEE: done: completed paths = 1\r\nKLEE: done: partially completed paths = 1\r\nKLEE: done: generated tests = 2\r\nexit=0\r\nassembly.ll\r\ninfo\r\nmessages.txt\r\nrun.istats\r\nrun.stats\r\ntest000001.assert.err\r\ntest000001.kquery\r\ntest000001.ktest\r\ntest000002.ktest\r\nwarnings.t