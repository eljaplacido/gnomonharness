[18.863516, "o", "\u001b[0m$ \u001b[0mcat /etc/os-release; echo \"---\"; uname -a; echo \"---\"; whoami; echo \"---\"; echo $HOME; echo \"---\"; which clang-16 llvm-config-16 cmake ninja make gcc g++ git curl wget; echo \"---\"; ls /usr/lib/llvm-16/bin | head -50\r\nPRETTY_NAME=\"Ubuntu 24.04.2 LTS\"\r\nNAME=\"Ubuntu\"\r\nVERSION_ID=\"24.04\"\r\nVERSION=\"24.04.2 LTS (Noble Numbat)\"\r\nVERSION_CODENAME=noble\r\nID=ubuntu\r\nID_LIKE=debian\r\nHOME_URL=\"https://www.ubuntu.com/\"\r\nSUPPORT_URL=\"https://help.ubuntu.com/\"\r\nBUG_REPORT_URL=\"https://bugs.launchpad.net/ubuntu/\"\r\nPRIVACY_POLICY_URL=\"https://www.ubuntu.com/legal/terms-and-policies/privacy-policy\"\r\nUBUNTU_CODENAME=noble\r\nLOGO=ubuntu-logo\r\n---\r\nLinux f3ab44d18294 6.17.0-1014-nvidia #14-Ubuntu SMP PREEMPT_DYNAMIC Tue Mar 17 19:01:40 UTC 2026 aarch64 aarch64 aarch64 GNU/Linux\r\n---\r\nroot\r\n---\r\n/root\r\n---\r\n/usr/bin/clang-16\r\n/usr/bin/llvm-config-16\r\n/usr/bin/curl\r\n---\r\nFileCheck\r\nUnicodeNameMappingGenerator\r\nbugpoint\r\nclang\r\nclang++\r\nclang-16\r\nclang-cpp\r\ncount\r\ndsymutil\r\nllc\r\nlli\r\nlli-child-target\r\nllvm-PerfectShuffle\r\nllvm-addr2line\r\nllvm-ar\r\nllvm-as\r\nllvm-bcanalyzer\r\nllvm-bitcode-strip\r\nllvm-c-test\r\nllvm-cat\r\nllvm-cfi-verify\r\nllvm-config\r\nllvm-cov\r\nllvm-cvtres\r\nllvm-cxxdump\r\nllvm-cxxfilt\r\nllvm-cxxmap\r\nllvm-debuginfo-analyzer\r\nllvm-debuginfod\r\nllvm-debuginfod-find\r\nllvm-diff\r\nllvm-dis\r\nllvm-dlltool\r\nllvm-dwarfdump\r\nllvm-dwarfutil\r\nllvm-dwp\r\nllvm-exegesis\r\nllvm-extract\r\nllvm-gsymutil\r\nllvm-ifs\r\nllvm-install-name-tool\r\nllvm-jitlink\r\nllvm-jitlink-executor\r\nllvm-lib\r\nllvm-libtool-darwin\r\nllvm-link\r\nllvm-lipo\r\nllvm-lto\r\nllvm-lto2\r\nllvm-mc\r\n"]
[18.89777, "o", "\u001b[0m$ \u001b[0mcat ~/.bashrc 2>/dev/null | tail -40; echo \"---CPATH---\"; echo \"$CPATH\"; echo \"---klee---\"; which klee kleaver klee-stats 2>/dev/null; echo \"---stp---\"; which stp 2>/dev/null; ls /usr/include/stp 2>/dev/null; dpkg -l | grep -Ei 'stp|klee|llvm|z3|minisat|boost' 2>/dev/null | head -40\r\ncase \"$TERM\" in\r\nxterm*|rxvt*)\r\n    PS1=\"\\[\\e]0;${debian_chroot:+($debian_chroot)}\\u@\\h: \\w\\a\\]$PS1\"\r\n    ;;\r\n*)\r\n    ;;\r\nesac\r\n\r\n# enable color support of ls and also add handy aliases\r\nif [ -x /usr/bin/dircolors ]; then\r\n    test -r ~/.dircolors && eval \"$(dircolors -b ~/.dircolors)\" || eval \"$(dircolors -b)\"\r\n    alias ls='ls --color=auto'\r\n    #alias dir='dir --color=auto'\r\n    #alias vdir='vdir --color=auto'\r\n\r\n    alias grep='grep --color=auto'\r\n    alias fgrep='fgrep --color=auto'\r\n    alias egrep='egrep --color=auto'\r\nfi\r\n\r\n# some more ls aliases\r\nalias ll='ls -alF'\r\nalias la='ls -A'\r\nalias l='ls -CF'\r\n\r\n# Alias definitions.\r\n# You may want to put all your additions into a separate file like\r\n# ~/.bash_aliases, instead of adding them here directly.\r\n# See /usr/share/doc/bash-doc/examples in the bash-doc package.\r\n\r\nif [ -f ~/.bash_aliases ]; then\r\n    . ~/.bash_aliases\r\nfi\r\n\r\n# enable programmable completion features (you don't need to enable\r\n# this, if it's already enabled in /etc/bash.bashrc and /etc/profile\r\n# sources /etc/bash.bashrc).\r\n#if [ -f /etc/bash_completion ] && ! shopt -oq posix; then\r\n#    . /etc/bash_completion\r\n#fi\r\n---CPATH---\r\n\r\n---klee---\r\n---stp---\r\nii  libllvm16t64:arm64           1:16.0.6-23ubuntu4                arm64        Modular compiler and toolchain technologies, runtime library\r\nii  libz3-4:arm64                4.8.12-3.1build1                  arm64        theorem prover from Microsoft Research - runtime libraries\r\nii  libz3-dev:arm64              4.8.12-3.1build1                  arm64        theorem prover from Microsoft Research - development files\r\nii  llvm-16                      1:16.0.6-23ubuntu4                arm64        Modular compiler and toolchain technologies\r\nii  llvm-16-dev                  1:16.0.6-23ubuntu4                arm64        Modular compiler and toolchain technologies, libraries and headers\r\nii  llvm-16-linker-tools         1:16.0.6-23ubuntu4                arm64        Modular compiler and toolchain technologies - Plugins\r\nii  llvm-16-runtime              1:16.0.6-23ubuntu4                arm64        Modular compiler and toolchain technologies, IR interpreter\r\nii  llvm-16-tools                1:16.0.6-23ubuntu4                arm64        Modular compiler and toolchain technologies, tools\r\n"]
