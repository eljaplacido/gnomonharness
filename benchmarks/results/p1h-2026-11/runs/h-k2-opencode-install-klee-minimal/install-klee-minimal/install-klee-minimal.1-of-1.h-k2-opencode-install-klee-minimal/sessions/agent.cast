[91.589679, "o", "\u001b[0m$ \u001b[0mcd /tmp/opencode/src/stp && git ls-remote --tags origin | grep -E 'refs/tags/(2\\.|3\\.)' | tail -30\r\n3ae3e92b29b9551cd146a2382d8391a6c89ef102\trefs/tags/2.1.0\r\n1fdabf26b8f329d077f65facd116bf12fe8d72dd\trefs/tags/2.1.1\r\n9c22ea1682eed439577fb1ebc89dd1047d365d7f\trefs/tags/2.1.2\r\n15943d7fa821106c350a367d83aaf143d4720023\trefs/tags/2.3.1\r\na58a4ab2f42a334854c7e7485593e33cd4b4ee53\trefs/tags/2.3.2\r\n7a3fd493ae6f0a524f853946308f4f3c3ddcbe76\trefs/tags/2.3.3\r\nd70085462f07c8a5a2f1225f727cda3ef505b141\trefs/tags/2.3.4\r\n207c63a88c67a4ec673da519039ce1212565c49c\trefs/tags/2.3.4_cadical\r\n8c1af1c2e34dd9e9d2087ef8d3ac7ca703b1c472\trefs/tags/2.4.0\r\n295953fc1f7424cc4822a02f5c7964e0aafbdf10\trefs/tags/2.4.1\r\n"]
