[101.96633, "o", "\u001b[0m$ \u001b[0mcd /tmp/opencode/src/stp && for t in 2.3.3 2.3.4 2.4.0 2.4.1; do git fetch --depth 1 origin refs/tags/$t:refs/tags/$t >/dev/null 2>&1; echo \"=== $t $(git log -1 --format=%cs $t) ===\"; git show $t:CMakeLists.txt | grep -nE \"find_package\\((SymFPU|LibBF|IMath)|option\\((USE_MINISAT|USE_CRYPTOMINISAT|USE_CADICAL)|NO.*(BOOST|MINISAT)|ENABLE_PYTHON|ONLY_SIMPLE\" | head -20; done\r\n=== 2.3.3 2019-03-02 ===\r\n134:    set(ENABLE_PYTHON_INTERFACE OFF)\r\n410:option(ONLY_SIMPLE \"Only build very simplistic executable -- no Boost needed\" OFF)\r\n411:if (NOT ONLY_SIMPLE)\r\n416:    set(ONLY_SIMPLE ON)\r\n438:option(NOCRYPTOMINISAT \"Don't try to use cryptominisat\" OFF)\r\n440:if (NOT NOCRYPTOMINISAT)\r\n443:  if (cryptominisat5_FOUND AND HAVE_FLAG_STD_CPP11 AND (NOT NOCRYPTOMINISAT))\r\n457:if (FORCE_CMS AND NOT USE_CRYPTOMINISAT)\r\n476:        if (NOT ONLY_SIMPLE)\r\n507:if (NOT MINISAT_FOUND)\r\n609:if ((NOT DEFINED ENABLE_PYTHON_INTERFACE) OR ENABLE_PYTHON_INTERFACE)\r\n625:        set(ENABLE_PYTHON_INTERFACE ON)\r\n=== 2.3.4 2024-06-11 ===\r\n151:    set(ENABLE_PYTHON_INTERFACE OFF)\r\n452:option(ONLY_SIMPLE \"Only build very simplistic executable -- no Boost needed\" OFF)\r\n453:if (NOT ONLY_SIMPLE)\r\n458:    set(ONLY_SIMPLE ON)\r\n460:add_feature_info(SimpleOptions ONLY_SIMPLE \"Simplifies command-line interface, only a few command-line options will be available\")\r\n477:option(NOCRYPTOMINISAT \"Don't try to use cryptominisat\" OFF)\r\n479:if (NOT NOCRYPTOMINISAT)\r\n487:  if (cryptominisat5_FOUND AND HAVE_FLAG_STD_CPP11 AND (NOT NOCRYPTOMINISAT))\r\n500:if (FORCE_CMS AND NOT USE_CRYPTOMINISAT)\r\n519:        if (NOT ONLY_SIMPLE)\r\n665:if((NOT DEFINED ENABLE_PYTHON_INTERFACE) OR ENABLE_PYTHON_INTERFACE)\r\n668:        set(ENABLE_PYTHON_INTERFACE ON)\r\n670:        set(ENABLE_PYTHON_INTERFACE OFF)\r\n673:add_feature_info(PythonInterface ENABLE_PYTHON_INTERFACE \"Enables Python interface\")\r\n=== 2.4.0 2026-07-31 ===\r\n135:    set(ENABLE_PYTHON_INTERFACE OFF)\r\n571:option(ONLY_SIMPLE \"Only build very simplistic executable -- no Boost needed\" OFF)\r\n572:if (NOT ONLY_SIMPLE)\r\n577:    set(ONLY_SIMPLE ON)\r\n579:add_feature_info(SimpleOptions ONLY_SIMPLE \"Simplifies command-line interface, only a few command-line options will be available\")\r\n596:option(USE_CADICAL \"Try to use Cadical\" OFF)\r\n709:option(NOCRYPTOMINISAT \"Don't try to use cryptominisat\" OFF)\r\n711:if (NOT NOCRYPTOMINISAT)\r\n725:  if (cryptominisat5_FOUND AND HAVE_FLAG_STD_CPP11 AND (NOT NOCRYPTOMINISAT))\r\n738:if (FORCE_CMS AND NOT USE_CRYPTOMINISAT)\r\n757:        if (NOT ONLY_SIMPLE)\r\n903:if((NOT DEFINED ENABLE_PYTHON_INTERFACE) OR ENABLE_PYTHON_INTERFACE)\r\n937:        set(ENABLE_PYTHON_INTERFACE ON)\r\n939:        set(ENABLE_PYTHON_INTERFACE OFF)\r\n942:add_feature_info(PythonInterface ENABLE_PYTHON_INTERFACE \"Enables Python interface\")\r\n=== 2.4.1 2026-08-01 ===\r\n135:    set(ENABLE_PYTHON_INTERFACE OFF)\r\n571:option(ONLY_SIMPLE \"Only build very simplistic executable -- no Boost needed\" OFF)\r\n572:if (NOT ONLY_SIMPLE)\r\n577:    set(ONLY_SIMPLE ON)\r\n579:add_feature_info(SimpleOptions ONLY_SIMPLE \"Simplifies command-line interface, only a few command-line options will be available\")\r\n596:option(USE_CADICAL \"Try to use Cadical\" OFF)\r\n709:option(NOCRYPTOMINISAT \"Don't try to use cryptominisat\" OFF)\r\n711:if (NOT NOCRYPTOMINISAT)\r\n725:  if (cryptominisat5_FOUND AND HAVE_FLAG_STD_CPP11 AND (NOT NOCRYPTOMINISAT))\r\n738:if (FORCE_CMS AND NOT USE_CRYPTOMINISAT)\r\n757:        if (NOT ONLY_SIMPLE)\r\n903:if((NOT DEFINED ENABLE_PYTHON_INTERFACE) OR ENABLE_PYTHON_INTERFACE)\r\n937:        set(ENABLE_PYTHON_INTERFACE ON)\r\n939:        set(ENABLE_PYTHON_INTERFACE OFF)\r\n942:add_feature_info(PythonInterface ENABLE_PYTHON_INTERFACE \"Enables Python interface\")\r\n"]
