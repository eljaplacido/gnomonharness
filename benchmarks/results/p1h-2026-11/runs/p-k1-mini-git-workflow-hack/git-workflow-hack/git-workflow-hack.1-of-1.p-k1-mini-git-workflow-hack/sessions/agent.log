Then I’ll rebuild, validate, and finalize the repository history and dummy remote.

```
cd /app/my_website && python3 - <<'PY'
from pathlib import Path

css = Path('assets/css/styles.css')
text = css.read_text(encoding='utf-8')
text = text.replace(
""".reveal {
  opacity: 0;
  transform: translateY(14px);
  transition: opacity 500ms ease, transform 500ms ease;
}

.reveal.is-visible {
  opacity: 1;
  transform: none;
}""",
""".js .reveal {
  opacity: 0;
  transform: translateY(14px);
  transition: opacity 500ms ease, transform 500ms ease;
}

.js .reveal.is-visible {
  opacity: 1;
  transform: none;
}"""
)
text = text.replace(
"""  .reveal {
    opacity: 1;
    transform: none;
  }""",
"""  .js .reveal {
    opacity: 1;
    transform: none;
  }"""
)
css.write_text(text, encoding='utf-8')

js = Path('assets/js/main.js')
text = js.read_text(encoding='utf-8')
text = text.replace(
'(() => {\n  "use strict";\n',
'(() => {\n  "use strict";\n\n  // Enable JS-only enhancements while keeping content visible without JS.\n  document.documentElement.classList.add("js");\n'
)
js.write_text(text, encoding='utf-8')
PY
python3 scripts/check_site.py && bash scripts/build.sh && grep -n 'js .reveal' assets/css/styles.css && grep -n 'classList.add("js")' assets/js/main.js
```
