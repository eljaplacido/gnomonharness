/* ==========================================================================
   Lydia Moreno — Research Profile
   Dependency-free, accessible, responsive styles
   ========================================================================== */

:root {
  --ink: #172530;
  --ink-soft: #314552;
  --muted: #5c6d78;
  --paper: #fbfaf6;
  --paper-deep: #f3f1ea;
  --card: #ffffff;
  --navy: #102b3f;
  --navy-light: #1b4159;
  --teal: #137b82;
  --teal-dark: #0d5e64;
  --teal-wash: #e4f1f1;
  --gold: #b07a3b;
  --line: #dce3e4;
  --line-dark: #c7d3d5;
  --shadow-sm: 0 1px 2px rgba(16, 43, 63, 0.04), 0 8px 24px rgba(16, 43, 63, 0.05);
  --shadow-md: 0 16px 44px rgba(16, 43, 63, 0.10);
  --radius: 14px;
  --radius-lg: 24px;
  --serif: "Iowan Old Style", "Palatino Linotype", "Book Antiqua", Palatino, Georgia, serif;
  --sans: "Inter", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  --max-width: 1160px;
  --header-height: 76px;
}

*,
*::before,
*::after {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: calc(var(--header-height) + 24px);
}

body {
  margin: 0;
  background:
    radial-gradient(circle at 8% 4%, rgba(19, 123, 130, 0.07), transparent 26rem),
    var(--paper);
  color: var(--ink);
  font-family: var(--sans);
  font-size: 1rem;
  line-height: 1.7;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

body.nav-open {
  overflow: hidden;
}

img,
svg {
  display: block;
  max-width: 100%;
}

a {
  color: var(--teal-dark);
  text-decoration-thickness: 1px;
  text-underline-offset: 0.18em;
}

a:hover {
  color: var(--navy);
}

:focus-visible {
  outline: 3px solid rgba(19, 123, 130, 0.45);
  outline-offset: 4px;
  border-radius: 4px;
}

.skip-link {
  position: fixed;
  top: 0.75rem;
  left: 0.75rem;
  z-index: 1000;
  padding: 0.75rem 1rem;
  background: var(--navy);
  color: #fff;
  border-radius: 8px;
  font-weight: 700;
  transform: translateY(-160%);
  transition: transform 160ms ease;
}

.skip-link:focus {
  color: #fff;
  transform: translateY(0);
}

.container {
  width: min(100% - 2.5rem, var(--max-width));
  margin-inline: auto;
}

.container--narrow {
  width: min(100% - 2.5rem, 820px);
  margin-inline: auto;
}

/* Header and navigation -------------------------------------------------- */

.site-header {
  position: sticky;
  top: 0;
  z-index: 100;
  min-height: var(--header-height);
  border-bottom: 1px solid rgba(199, 211, 213, 0.72);
  background: rgba(251, 250, 246, 0.92);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
}

.header-inner {
  min-height: var(--header-height);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 2rem;
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 0.8rem;
  color: var(--ink);
  text-decoration: none;
  line-height: 1.15;
}

.brand:hover {
  color: var(--ink);
}

.brand-mark {
  display: grid;
  width: 2.55rem;
  height: 2.55rem;
  place-items: center;
  flex: 0 0 auto;
  border-radius: 50%;
  background: var(--navy);
  color: #fff;
  font-family: var(--serif);
  font-size: 0.96rem;
  font-weight: 700;
  letter-spacing: 0.03em;
}

.brand-copy strong {
  display: block;
  font-family: var(--serif);
  font-size: 1.08rem;
  font-weight: 700;
  letter-spacing: -0.015em;
}

.brand-copy span {
  display: block;
  margin-top: 0.12rem;
  color: var(--muted);
  font-size: 0.69rem;
  font-weight: 700;
  letter-spacing: 0.13em;
  text-transform: uppercase;
}

.site-nav ul {
  display: flex;
  align-items: center;
  gap: 0.35rem;
  margin: 0;
  padding: 0;
  list-style: none;
}

.site-nav a {
  display: inline-block;
  padding: 0.55rem 0.8rem;
  border-radius: 999px;
  color: var(--ink-soft);
  font-size: 0.9rem;
  font-weight: 650;
  text-decoration: none;
  transition: background-color 160ms ease, color 160ms ease;
}

.site-nav a:hover {
  background: rgba(19, 123, 130, 0.08);
  color: var(--teal-dark);
}

.site-nav a[aria-current="page"] {
  background: var(--teal-wash);
  color: var(--teal-dark);
}

.site-nav .nav-contact {
  margin-left: 0.35rem;
  border: 1px solid var(--line-dark);
  background: var(--card);
}

.nav-toggle {
  display: none;
  align-items: center;
  justify-content: center;
  width: 2.75rem;
  height: 2.75rem;
  padding: 0;
  border: 1px solid var(--line-dark);
  border-radius: 50%;
  background: var(--card);
  color: var(--ink);
  cursor: pointer;
}

.nav-toggle-lines,
.nav-toggle-lines::before,
.nav-toggle-lines::after {
  display: block;
  width: 1.1rem;
  height: 2px;
  border-radius: 2px;
  background: currentColor;
  transition: transform 180ms ease, opacity 180ms ease;
}

.nav-toggle-lines {
  position: relative;
}

.nav-toggle-lines::before,
.nav-toggle-lines::after {
  position: absolute;
  left: 0;
  content: "";
}

.nav-toggle-lines::before {
  top: -6px;
}

.nav-toggle-lines::after {
  top: 6px;
}

.nav-open .nav-toggle-lines {
  background: transparent;
}

.nav-open .nav-toggle-lines::before {
  transform: translateY(6px) rotate(45deg);
}

.nav-open .nav-toggle-lines::after {
  transform: translateY(-6px) rotate(-45deg);
}

/* Buttons ---------------------------------------------------------------- */

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.55rem;
  min-height: 2.9rem;
  padding: 0.72rem 1.15rem;
  border: 1px solid transparent;
  border-radius: 999px;
  background: var(--navy);
  color: #fff;
  font: inherit;
  font-size: 0.91rem;
  font-weight: 700;
  line-height: 1.2;
  text-decoration: none;
  cursor: pointer;
  transition: transform 160ms ease, background-color 160ms ease, border-color 160ms ease;
}

.btn:hover {
  background: var(--navy-light);
  color: #fff;
  transform: translateY(-1px);
}

.btn--teal {
  background: var(--teal);
}

.btn--teal:hover {
  background: var(--teal-dark);
}

.btn--ghost {
  border-color: var(--line-dark);
  background: transparent;
  color: var(--ink);
}

.btn--ghost:hover {
  border-color: var(--teal);
  background: var(--teal-wash);
  color: var(--teal-dark);
}

.btn--small {
  min-height: 2.35rem;
  padding: 0.52rem 0.85rem;
  font-size: 0.8rem;
}

.btn-row {
  display: flex;
  flex-wrap: wrap;
  gap: 0.7rem;
  margin-top: 1.6rem;
}

/* Shared text and sections ---------------------------------------------- */

.eyebrow {
  margin: 0 0 0.85rem;
  color: var(--teal-dark);
  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 0.17em;
  text-transform: uppercase;
}

h1,
h2,
h3,
h4 {
  margin-top: 0;
  color: var(--ink);
  font-family: var(--serif);
  font-weight: 700;
  line-height: 1.16;
  letter-spacing: -0.025em;
}

h1 {
  margin-bottom: 1.1rem;
  font-size: clamp(2.65rem, 6.1vw, 5rem);
}

h2 {
  margin-bottom: 0.85rem;
  font-size: clamp(1.85rem, 3.25vw, 2.65rem);
}

h3 {
  margin-bottom: 0.55rem;
  font-size: 1.3rem;
}

p {
  margin-top: 0;
  margin-bottom: 1rem;
}

.lead {
  max-width: 42rem;
  color: var(--ink-soft);
  font-size: clamp(1.08rem, 1.8vw, 1.28rem);
  line-height: 1.72;
}

.muted {
  color: var(--muted);
}

.section {
  padding: 4.75rem 0;
}

.section--tinted {
  border-block: 1px solid rgba(199, 211, 213, 0.72);
  background:
    linear-gradient(180deg, rgba(228, 241, 241, 0.45), rgba(243, 241, 234, 0.55));
}

.section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 2rem;
  margin-bottom: 2.2rem;
}

.section-heading > div {
  max-width: 47rem;
}

.section-heading p {
  margin-bottom: 0;
  color: var(--muted);
}

/* Hero ------------------------------------------------------------------- */

.hero {
  position: relative;
  overflow: hidden;
  padding: clamp(4.5rem, 8vw, 7rem) 0 clamp(4rem, 7vw, 6rem);
}

.hero-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.12fr) minmax(19rem, 0.88fr);
  align-items: center;
  gap: clamp(2.5rem, 6vw, 5.5rem);
}

.hero h1 {
  max-width: 12ch;
}

.hero h1 em {
  color: var(--teal-dark);
  font-style: italic;
}

.hero .lead {
  max-width: 39rem;
}

.hero-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.55rem 1.2rem;
  margin-top: 2rem;
  color: var(--muted);
  font-size: 0.84rem;
  font-weight: 650;
}

.hero-meta span {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
}

.hero-meta span::before {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: var(--teal);
  content: "";
}

.profile-card {
  position: relative;
  padding: 0.7rem;
  border: 1px solid rgba(199, 211, 213, 0.8);
  border-radius: var(--radius-lg);
  background: rgba(255, 255, 255, 0.66);
  box-shadow: var(--shadow-md);
}

.profile-visual {
  position: relative;
  display: grid;
  min-height: 25rem;
  place-items: center;
  overflow: hidden;
  border-radius: 18px;
  background:
    radial-gradient(circle at 72% 20%, rgba(64, 179, 181, 0.55), transparent 36%),
    radial-gradient(circle at 16% 84%, rgba(176, 122, 59, 0.32), transparent 30%),
    linear-gradient(150deg, var(--navy-light), var(--navy) 70%);
}

.profile-visual::before,
.profile-visual::after {
  position: absolute;
  border: 1px solid rgba(255, 255, 255, 0.18);
  border-radius: 50%;
  content: "";
}

.profile-visual::before {
  width: 19rem;
  height: 19rem;
}

.profile-visual::after {
  width: 14rem;
  height: 14rem;
}

.monogram {
  position: relative;
  z-index: 1;
  color: #fff;
  font-family: var(--serif);
  font-size: clamp(5rem, 10vw, 7rem);
  font-weight: 700;
  letter-spacing: -0.09em;
  line-height: 1;
  transform: translateX(-0.05em);
}

.profile-label {
  position: absolute;
  right: 1.1rem;
  bottom: 1.1rem;
  left: 1.1rem;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  padding: 0.8rem 0.95rem;
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 12px;
  background: rgba(9, 31, 46, 0.72);
  color: rgba(255, 255, 255, 0.84);
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.075em;
  text-transform: uppercase;
  backdrop-filter: blur(8px);
}

.profile-label strong {
  color: #fff;
  font-weight: 800;
}

.profile-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  padding: 0.95rem 0.6rem 0.35rem;
  color: var(--muted);
  font-size: 0.78rem;
}

.profile-foot strong {
  color: var(--ink);
}

.status {
  display: inline-flex;
  align-items: center;
  gap: 0.42rem;
}

.status::before {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #2f9d78;
  box-shadow: 0 0 0 4px rgba(47, 157, 120, 0.12);
  content: "";
}

/* Stats ------------------------------------------------------------------ */

.stats {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  margin-top: 3rem;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  background: rgba(255, 255, 255, 0.64);
  box-shadow: var(--shadow-sm);
}

.stat {
  padding: 1.15rem 1.35rem;
  border-right: 1px solid var(--line);
}

.stat:last-child {
  border-right: 0;
}

.stat strong {
  display: block;
  color: var(--navy);
  font-family: var(--serif);
  font-size: 1.45rem;
  line-height: 1.2;
}

.stat span {
  color: var(--muted);
  font-size: 0.74rem;
  font-weight: 700;
  letter-spacing: 0.065em;
  text-transform: uppercase;
}

/* About ------------------------------------------------------------------ */

.about-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.5fr) minmax(17rem, 0.7fr);
  gap: clamp(2.5rem, 6vw, 5rem);
  align-items: start;
}

.prose p:last-child {
  margin-bottom: 0;
}

.prose p {
  color: var(--ink-soft);
  font-size: 1.02rem;
}

.fact-card {
  padding: 1.5rem;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  background: var(--card);
  box-shadow: var(--shadow-sm);
}

.fact-card h3 {
  font-size: 1.06rem;
}

.fact-list {
  margin: 0;
  padding: 0;
  list-style: none;
}

.fact-list li {
  display: grid;
  gap: 0.16rem;
  padding: 0.78rem 0;
  border-top: 1px solid var(--line);
}

.fact-list li:first-child {
  padding-top: 0;
  border-top: 0;
}

.fact-list strong {
  color: var(--ink);
  font-size: 0.73rem;
  font-weight: 800;
  letter-spacing: 0.09em;
  text-transform: uppercase;
}

.fact-list span {
  color: var(--ink-soft);
  font-size: 0.91rem;
  line-height: 1.5;
}

/* Card grids ------------------------------------------------------------- */

.card-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1rem;
}

.info-card {
  position: relative;
  padding: 1.5rem;
  overflow: hidden;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  background: var(--card);
  box-shadow: var(--shadow-sm);
  transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
}

.info-card::after {
  position: absolute;
  top: 0;
  right: 0;
  width: 4.5rem;
  height: 4.5rem;
  border-radius: 0 0 0 100%;
  background: var(--teal-wash);
  content: "";
}

.info-card:hover {
  border-color: #b9cecf;
  box-shadow: var(--shadow-md);
  transform: translateY(-2px);
}

.info-card h3,
.info-card h2 {
  position: relative;
  z-index: 1;
  padding-right: 2rem;
  font-size: 1.18rem;
}

.info-card p {
  position: relative;
  z-index: 1;
  margin-bottom: 0;
  color: var(--muted);
  font-size: 0.94rem;
  line-height: 1.65;
}

.card-index {
  position: absolute;
  top: 1.25rem;
  right: 1.35rem;
  z-index: 1;
  color: var(--teal-dark);
  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 0.08em;
}

/* Timeline --------------------------------------------------------------- */

.timeline {
  position: relative;
  margin: 0;
  padding: 0 0 0 1.55rem;
  list-style: none;
}

.timeline::before {
  position: absolute;
  top: 0.4rem;
  bottom: 0.4rem;
  left: 0.32rem;
  width: 1px;
  background: var(--line-dark);
  content: "";
}

.timeline-item {
  position: relative;
  padding: 0 0 1.65rem 1rem;
}

.timeline-item:last-child {
  padding-bottom: 0;
}

.timeline-item::before {
  position: absolute;
  top: 0.42rem;
  left: -1.55rem;
  width: 0.67rem;
  height: 0.67rem;
  border: 2px solid var(--paper);
  border-radius: 50%;
  background: var(--teal);
  box-shadow: 0 0 0 1px var(--teal);
  content: "";
}

.timeline-item h3 {
  margin-bottom: 0.2rem;
  font-size: 1.12rem;
}

.timeline-meta {
  margin-bottom: 0.35rem;
  color: var(--teal-dark);
  font-size: 0.78rem;
  font-weight: 800;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.timeline-item p {
  margin-bottom: 0;
  color: var(--muted);
  font-size: 0.92rem;
}

/* Projects --------------------------------------------------------------- */

.project-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1rem;
}

.project-card {
  display: flex;
  flex-direction: column;
  padding: 1.55rem;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  background: var(--card);
  box-shadow: var(--shadow-sm);
}

.project-role {
  margin-bottom: 0.8rem;
  color: var(--gold);
  font-size: 0.7rem;
  font-weight: 800;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.project-card h3 {
  margin-bottom: 0.7rem;
  font-size: 1.22rem;
}

.project-card p {
  margin-bottom: 1rem;
  color: var(--muted);
  font-size: 0.91rem;
}

.clean-list {
  margin: auto 0 0;
  padding: 1rem 0 0;
  border-top: 1px solid var(--line);
  list-style: none;
}

.clean-list li {
  position: relative;
  padding: 0.26rem 0 0.26rem 0.95rem;
  color: var(--ink-soft);
  font-size: 0.86rem;
  line-height: 1.55;
}

.clean-list li::before {
  position: absolute;
  top: 0.72rem;
  left: 0;
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background: var(--teal);
  content: "";
}

/* Publications ----------------------------------------------------------- */

.publication-list {
  display: grid;
  gap: 1rem;
  margin: 0;
  padding: 0;
  list-style: none;
}

.publication {
  display: grid;
  grid-template-columns: 5.5rem minmax(0, 1fr) auto;
  gap: 1.35rem;
  align-items: start;
  padding: 1.4rem;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  background: var(--card);
  box-shadow: var(--shadow-sm);
}

.pub-year {
  padding-top: 0.08rem;
  color: var(--teal-dark);
  font-family: var(--serif);
  font-size: 1.2rem;
  font-weight: 700;
}

.pub-body h3 {
  margin-bottom: 0.35rem;
  font-size: 1.18rem;
  line-height: 1.35;
}

.pub-authors {
  margin-bottom: 0.15rem;
  color: var(--ink-soft);
  font-size: 0.91rem;
}

.pub-venue {
  margin-bottom: 0;
  color: var(--muted);
  font-size: 0.87rem;
  font-style: italic;
}

.pub-actions {
  display: flex;
  flex-direction: column;
  gap: 0.45rem;
  min-width: 7.8rem;
}

.pub-tag {
  display: inline-flex;
  align-items: center;
  width: fit-content;
  padding: 0.27rem 0.58rem;
  border-radius: 999px;
  background: var(--teal-wash);
  color: var(--teal-dark);
  font-size: 0.67rem;
  font-weight: 800;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.copy-status {
  color: var(--muted);
  font-size: 0.72rem;
  line-height: 1.3;
}

/* Blog ------------------------------------------------------------------- */

.blog-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1rem;
}

.post-card {
  display: flex;
  flex-direction: column;
  overflow: hidden;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  background: var(--card);
  box-shadow: var(--shadow-sm);
  transition: transform 180ms ease, box-shadow 180ms ease;
}

.post-card:hover {
  box-shadow: var(--shadow-md);
  transform: translateY(-2px);
}

.post-art {
  position: relative;
  min-height: 9.2rem;
  overflow: hidden;
  background:
    linear-gradient(130deg, rgba(19, 123, 130, 0.96), rgba(16, 43, 63, 0.98));
}

.post-art::before,
.post-art::after {
  position: absolute;
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  content: "";
}

.post-art::before {
  width: 9rem;
  height: 9rem;
  top: -3.4rem;
  right: -2.2rem;
}

.post-art::after {
  width: 6rem;
  height: 6rem;
  bottom: -2.4rem;
  left: 1.4rem;
}

.post-art--gold {
  background:
    linear-gradient(130deg, rgba(176, 122, 59, 0.95), rgba(68, 50, 37, 0.98));
}

.post-art--sky {
  background:
    linear-gradient(130deg, rgba(47, 114, 157, 0.95), rgba(16, 43, 63, 0.98));
}

.post-art-label {
  position: absolute;
  right: 1rem;
  bottom: 1rem;
  left: 1rem;
  color: rgba(255, 255, 255, 0.8);
  font-size: 0.68rem;
  font-weight: 800;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.post-content {
  display: flex;
  flex: 1;
  flex-direction: column;
  padding: 1.3rem;
}

.post-date {
  margin-bottom: 0.5rem;
  color: var(--teal-dark);
  font-size: 0.7rem;
  font-weight: 800;
  letter-spacing: 0.085em;
  text-transform: uppercase;
}

.post-content h3 {
  font-size: 1.16rem;
  line-height: 1.35;
}

.post-content h3 a {
  color: var(--ink);
  text-decoration: none;
}

.post-content h3 a:hover {
  color: var(--teal-dark);
  text-decoration: underline;
}

.post-content p {
  color: var(--muted);
  font-size: 0.9rem;
}

.read-link {
  display: inline-flex;
  align-items: center;
  gap: 0.38rem;
  margin-top: auto;
  font-size: 0.82rem;
  font-weight: 800;
  text-decoration: none;
}

.read-link::after {
  content: "→";
  transition: transform 160ms ease;
}

.read-link:hover::after {
  transform: translateX(3px);
}

/* Contact ---------------------------------------------------------------- */

.contact-panel {
  display: grid;
  grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
  gap: 2.5rem;
  padding: clamp(2rem, 5vw, 3.4rem);
  border-radius: var(--radius-lg);
  background:
    radial-gradient(circle at 100% 0%, rgba(52, 161, 164, 0.33), transparent 22rem),
    var(--navy);
  color: rgba(255, 255, 255, 0.78);
  box-shadow: var(--shadow-md);
}

.contact-panel h2,
.contact-panel h3 {
  color: #fff;
}

.contact-panel p {
  color: rgba(255, 255, 255, 0.72);
}

.contact-panel .eyebrow {
  color: #8cd6d5;
}

.contact-links {
  display: grid;
  gap: 0.75rem;
  align-content: start;
}

.contact-link {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  padding: 0.8rem 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.15);
  color: #fff;
  text-decoration: none;
}

.contact-link span {
  color: rgba(255, 255, 255, 0.56);
  font-size: 0.68rem;
  font-weight: 800;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.contact-link strong {
  font-size: 0.91rem;
  font-weight: 650;
  text-align: right;
  overflow-wrap: anywhere;
}

.contact-link:hover {
  color: #8cd6d5;
}

/* Page hero and article -------------------------------------------------- */

.page-hero {
  padding: 4.5rem 0 3.25rem;
  border-bottom: 1px solid var(--line);
  background:
    radial-gradient(circle at 90% 0%, rgba(19, 123, 130, 0.1), transparent 27rem),
    transparent;
}

.page-hero h1 {
  max-width: 15ch;
  margin-bottom: 0.9rem;
  font-size: clamp(2.6rem, 5.2vw, 4.2rem);
}

.page-hero .lead {
  max-width: 46rem;
}

.breadcrumbs {
  display: flex;
  flex-wrap: wrap;
  gap: 0.45rem;
  margin-bottom: 1.2rem;
  padding: 0;
  color: var(--muted);
  font-size: 0.78rem;
  font-weight: 650;
  list-style: none;
}

.breadcrumbs li:not(:last-child)::after {
  margin-left: 0.45rem;
  content: "/";
  color: var(--line-dark);
}

.breadcrumbs a {
  color: var(--teal-dark);
  text-decoration: none;
}

.article-shell {
  padding: 3.5rem 0 5rem;
}

.article-header {
  margin-bottom: 2.5rem;
  padding-bottom: 2rem;
  border-bottom: 1px solid var(--line);
}

.article-header h1 {
  font-size: clamp(2.2rem, 5vw, 3.6rem);
}

.article-byline {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 1.2rem;
  color: var(--muted);
  font-size: 0.83rem;
  font-weight: 650;
}

.article-body h2 {
  margin-top: 2.4rem;
  font-size: 1.7rem;
}

.article-body h3 {
  margin-top: 2rem;
}

.article-body p,
.article-body li {
  color: var(--ink-soft);
  font-size: 1.04rem;
  line-height: 1.8;
}

.article-body ul {
  padding-left: 1.2rem;
}

.article-body blockquote {
  margin: 1.8rem 0;
  padding: 1rem 1.3rem;
  border-left: 3px solid var(--teal);
  background: var(--teal-wash);
  color: var(--ink-soft);
  font-family: var(--serif);
  font-size: 1.15rem;
}

.article-note {
  margin-top: 2.5rem;
  padding: 1.25rem;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  background: rgba(255, 255, 255, 0.68);
  color: var(--muted);
  font-size: 0.9rem;
}

/* Footer ----------------------------------------------------------------- */

.site-footer {
  padding: 2.8rem 0;
  border-top: 1px solid var(--line);
  background: var(--paper-deep);
}

.footer-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1.5rem;
}

.footer-inner p {
  margin: 0;
  color: var(--muted);
  font-size: 0.8rem;
}

.footer-links {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
}

.footer-links a {
  color: var(--ink-soft);
  font-size: 0.8rem;
  font-weight: 650;
  text-decoration: none;
}

.footer-links a:hover {
  color: var(--teal-dark);
  text-decoration: underline;
}

/* Reveal animation ------------------------------------------------------- */

.reveal {
  opacity: 0;
  transform: translateY(14px);
  transition: opacity 500ms ease, transform 500ms ease;
}

.reveal.is-visible {
  opacity: 1;
  transform: none;
}

/* Responsive ------------------------------------------------------------- */

@media (max-width: 980px) {
  .hero-grid,
  .about-grid,
  .contact-panel {
    grid-template-columns: 1fr;
  }

  .hero-grid {
    gap: 3rem;
  }

  .profile-card {
    max-width: 32rem;
  }

  .project-grid,
  .blog-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .publication {
    grid-template-columns: 4.5rem minmax(0, 1fr);
  }

  .pub-actions {
    grid-column: 2;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
  }
}

@media (max-width: 780px) {
  :root {
    --header-height: 68px;
  }

  .container,
  .container--narrow {
    width: min(100% - 1.8rem, var(--max-width));
  }

  .nav-toggle {
    display: inline-flex;
  }

  .site-nav {
    position: fixed;
    top: var(--header-height);
    right: 0;
    left: 0;
    display: none;
    max-height: calc(100vh - var(--header-height));
    padding: 0.75rem 0.9rem 1.4rem;
    overflow-y: auto;
    border-bottom: 1px solid var(--line);
    background: var(--paper);
    box-shadow: var(--shadow-md);
  }

  .nav-open .site-nav {
    display: block;
  }

  .site-nav ul {
    align-items: stretch;
    flex-direction: column;
    gap: 0.15rem;
  }

  .site-nav a,
  .site-nav .nav-contact {
    display: block;
    margin: 0;
    border: 0;
    border-radius: 8px;
    padding: 0.78rem 0.85rem;
  }

  .section {
    padding: 3.5rem 0;
  }

  .section-heading {
    display: block;
  }

  .section-heading .btn {
    margin-top: 1rem;
  }

  .stats {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .stat:nth-child(2) {
    border-right: 0;
  }

  .stat:nth-child(-n + 2) {
    border-bottom: 1px solid var(--line);
  }

  .card-grid,
  .project-grid,
  .blog-grid {
    grid-template-columns: 1fr;
  }

  .publication {
    grid-template-columns: 1fr;
    gap: 0.6rem;
  }

  .pub-year {
    padding-top: 0;
  }

  .pub-actions {
    grid-column: auto;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
  }

  .footer-inner {
    align-items: flex-start;
    flex-direction: column;
  }
}

@media (max-width: 520px) {
  .brand-copy span {
    display: none;
  }

  .hero {
    padding-top: 3.4rem;
  }

  .profile-visual {
    min-height: 21rem;
  }

  .stats {
    grid-template-columns: 1fr;
  }

  .stat,
  .stat:nth-child(2) {
    border-right: 0;
    border-bottom: 1px solid var(--line);
  }

  .stat:last-child {
    border-bottom: 0;
  }

  .contact-panel {
    padding: 1.6rem;
  }

  .contact-link {
    align-items: flex-start;
    flex-direction: column;
    gap: 0.2rem;
  }

  .contact-link strong {
    text-align: left;
  }
}

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }

  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }

  .reveal {
    opacity: 1;
    transform: none;
  }
}

@media print {
  .site-header,
  .site-footer,
  .btn-row,
  .nav-toggle {
    display: none !important;
  }

  body {
    background: #fff;
  }

  .section,
  .hero {
    padding: 1.5rem 0;
  }

  .profile-card,
  .info-card,
  .project-card,
  .publication,
  .post-card,
  .contact-panel {
    break-inside: avoid;
    box-shadow: none;
  }

  .contact-panel {
    color: var(--ink);
    background: #fff;
    border: 1px solid var(--line);
  }

  .contact-panel h2,
  .contact-panel p,
  .contact-link,
  .contact-link strong,
  .contact-link span {
    color: var(--ink);
  }
}
