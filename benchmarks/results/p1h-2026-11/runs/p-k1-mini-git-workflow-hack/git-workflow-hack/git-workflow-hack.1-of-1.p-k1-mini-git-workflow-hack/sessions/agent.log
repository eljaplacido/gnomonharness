<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Notes and reflections from Dr. Lydia Moreno on interpretable machine learning, single-cell genomics, and graph neural 
networks for neuroscience.">
    <meta name="theme-color" content="#102b3f">
    <title>Blog | Dr. Lydia Moreno</title>
    <link rel="stylesheet" href="assets/css/styles.css">
    <script src="assets/js/main.js" defer></script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="index.html" aria-label="Dr. Lydia Moreno — home">
          <span class="brand-mark" aria-hidden="true">LM</span>
          <span class="brand-copy">
            <strong>Lydia Moreno</strong>
            <span>Computational Neuroscience</span>
          </span>
        </a>
        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
          <span class="nav-toggle-lines" aria-hidden="true"></span>
          <span class="sr-only">Toggle navigation</span>
        </button>
        <nav class="site-nav" id="site-nav" aria-label="Primary navigation">
          <ul>
            <li><a href="about.html">About Me</a></li>
            <li><a href="blog.html" aria-current="page">Blog</a></li>
            <li><a href="publications.html">Publications</a></li>
            <li><a class="nav-contact" href="about.html#contact">Contact</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main-content">
      <section class="page-hero" aria-labelledby="page-title">
        <div class="container">
          <p class="eyebrow">Notes from the Lab</p>
          <h1 id="page-title">Blog</h1>
          <p class="lead">
            Reflections on interpretable machine learning, reproducible pipelines, and the
            craft of computational neuroscience.
          </p>
        </div>
      </section>

      <section class="section" aria-labelledby="latest-posts-title">
        <div class="container">
          <div class="section-heading reveal">
            <div>
              <p class="eyebrow">Latest Posts</p>
              <h2 id="latest-posts-title">Methods, models, and scientific judgment.</h2>
              <p>Three recent notes from ongoing research and teaching.</p>
            </div>
          </div>

          <div class="blog-grid">
            <article class="post-card reveal">
              <div class="post-art" aria-hidden="true">
                <span class="post-art-label">Interpretability</span>
              </div>
              <div class="post-content">
                <p class="post-date"><time datetime="2025-03-01">March 2025</time></p>
                <h3><a href="blog/interpretable-neural-models.html">Building Interpretable Deep Learning Models for Neuroscience</a></h3>
                <p>
                  Predictive accuracy is only the beginning. Here is how attribution and
                  representation analyses can help models answer scientific questions.
                </p>
                <a class="read-link" href="blog/interpretable-neural-models.html">Read post</a>
              </div>
            </article>

            <article class="post-card reveal">
              <div class="post-art post-art--gold" aria-hidden="true">
                <span class="post-art-label">Single-cell</span>
              </div>
              <div class="post-content">
                <p class="post-date"><time datetime="2025-01-01">January 2025</time></p>
                <h3><a href="blog/ml-single-cell-genomics.html">Bridging Machine Learning and Single-Cell Genomics</a></h3>
                <p>
                  What changes when multi-modal single-cell data meets scalable, reproducible
                  workflow design?
                </p>
                <a class="read-link" href="blog/ml-single-cell-genomics.html">Read post</a>
              </div>
            </article>

            <article class="post-card reveal">
              <div class="post-art post-art--sky" aria-hidden="true">
                <span class="post-art-label">Connectomics</span>
              </div>
              <div class="post-content">
                <p class="post-date"><time datetime="2024-11-01">November 2024</time></p>
                <h3><a href="blog/graph-neural-networks-connectomics.html">Scaling Graph Neural Networks for Connectomics</a></h3>
                <p>
                  Lessons from learning on neuron meshes, sparse synaptic graphs, and
                  electron-microscopy reconstructions.
                </p>
                <a class="read-link" href="blog/graph-neural-networks-connectomics.html">Read post</a>
              </div>
            </article>
          </div>
        </div>
      </section>

      <section class="section section--tinted" aria-labelledby="newsletter-title">
        <div class="container">
          <div class="about-grid">
            <div class="reveal">
              <p class="eyebrow">About This Blog</p>
              <h2 id="newsletter-title">A working notebook, not a press release.</h2>
              <p class="lead">
                Posts will focus on method design, practical tradeoffs, and the assumptions
                behind computational claims.
              </p>
            </div>
            <aside class="fact-card reveal">
              <h3>Topics</h3>
              <ul class="tag-list">
                <li>Explainable AI</li>
                <li>Neural decoding</li>
                <li>Single-cell omics</li>
                <li>Graph learning</li>
                <li>Reproducibility</li>
              </ul>
            </aside>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <p>© <span data-current-year>2025</span> Lydia Moreno · Computational Neuroscience</p>
        <div class="footer-links">
          <a href="index.html">Home</a>
          <a href="about.html">About Me</a>
          <a href="publications.html">Publications</a>
          <a href="info.md" download>CV</a>
        </div>
      </div>
    </footer>
  </body>
</html>
EOF
printf 'Created publications.html (%s lines) and blog.html (%s lines).\n' "$(wc -l < publications.html)" "$(wc -l < blog.html)"
