cd /app/my_website && cat > scripts/build.sh <<'EOF'
#!/usr/bin/env bash
# Build the static site into _site/ using an explicit allowlist.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
OUT="${ROOT}/_site"

rm -rf "${OUT}"
mkdir -p "${OUT}"

for item in index.html about.html blog.html publications.html 404.html info.md assets blog; do
  if [[ ! -e "${ROOT}/${item}" ]]; then
    printf 'Missing required site input: %s\n' "${item}" >&2
    exit 1
  fi
  cp -R "${ROOT}/${item}" "${OUT}/"
done

# Prevent Jekyll processing if the deployment target ever falls back to branch Pages.
touch "${OUT}/.nojekyll"

printf 'Built static site at %s\n' "${OUT}"
EOF
chmod +x scripts/build.sh

cat > scripts/check_site.py <<'EOF'
#!/usr/bin/env python3
"""Validate required pages, internal links, and deployment safety basics."""
from __future__ import annotations

import re
import sys
from html.parser import HTMLParser
from pathlib import Path
from urllib.parse import unquote, urlparse

ROOT = Path(__file__).resolve().parent.parent
REQUIRED = [
    "index.html",
    "about.html",
    "blog.html",
    "publications.html",
    "404.html",
    "info.md",
    "assets/css/styles.css",
    "assets/js/main.js",
]
HTML_FILES = list(ROOT.glob("*.html")) + list((ROOT / "blog").glob("*.html"))


class LinkParser(HTMLParser):
    def __init__(self) -> None:
        super().__init__(convert_charrefs=True)
        self.links: list[str] = []

    def handle_starttag(self, tag: str, attrs: list[tuple[str, str | None]]) -> None:
        if tag not in {"a", "link", "script", "img", "source"}:
            return
        attr_map = dict(attrs)
        for key in ("href", "src"):
            value = attr_map.get(key)
            if value:
                self.links.append(value)


def fail(message: str) -> None:
    print(f"ERROR: {message}", file=sys.stderr)
    raise SystemExit(1)


def check_required_files() -> None:
    for relative in REQUIRED:
        path = ROOT / relative
        if not path.is_file():
            fail(f"missing required file: {relative}")
        if path.stat().st_size == 0:
            fail(f"required file is empty: {relative}")


def check_internal_links() -> None:
    broken: list[str] = []
    for html_file in HTML_FILES:
        parser = LinkParser()
        parser.feed(html_file.read_text(encoding="utf-8"))
        for href in parser.links:
            parsed = urlparse(href)
            if parsed.scheme or parsed.netloc or href.startswith(("mailto:", "tel:", "#")):
                continue
            target = unquote(parsed.path)
            if not target:
                continue
            resolved = (html_file.parent / target).resolve()
            if not resolved.exists():
                broken.append(f"{html_file.relative_to(ROOT)} -> {href}")
    if broken:
        fail("broken internal links:\n  " + "\n  ".join(broken))


def check_workflow_safety() -> None:
    workflow = (ROOT / ".github/workflows/deploy.yml").read_text(encoding="utf-8")
    forbidden_patterns = [
        r"\bcurl\b",
        r"\bwget\b",
        r"\bscp\b",
        r"\brsync\b",
        r"secrets\.[A-Za-z_]+",
        r"permissions:\s*write-all",
    ]
    for pattern in forbidden_patterns:
        if re.search(pattern, workflow, flags=re.IGNORECASE):
            fail(f"deployment workflow contains forbidden pattern: {pattern}")

    if "pages: write" not in workflow or "id-token: write" not in workflow:
        fail("GitHub Pages deployment permissions are not configured as expected")
    if "contents: read" not in workflow:
        fail("workflow must use read-only repository content access")

    # Ensure every action reference is either pinned to a full commit SHA or
    # is a first-party local action. The comments retain human-readable versions.
    for line in workflow.splitlines():
        stripped = line.strip()
        if "uses:" not in stripped:
            continue
        reference = stripped.split("uses:", 1)[1].strip().split()[0]
        if reference.startswith("./"):
            continue
        if "@" not in reference:
            fail(f"action has no pinned reference: {reference}")
        version = reference.rsplit("@", 1)[1]
        if not re.fullmatch(r"[0-9a-f]{40}", version):
            fail(f"action is not pinned to a full commit SHA: {reference}")


def main() -> None:
    if not HTML_FILES:
        fail("no HTML pages found")
    check_required_files()
    check_internal_links()
    check_workflow_safety()
    print(f"Validation passed: {len(HTML_FILES)} HTML pages and {len(REQUIRED)} required files checked.")


if __name__ == "__main__":
    main()
EOF
chmod +x scripts/check_site.py

cat > .github/workflows/deploy.yml <<'EOF'
name: Deploy Website

"on":
  push:
    branches:
      - main
  workflow_dispatch:

# Least privilege: only the Pages deployment needs elevated permissions.
permissions:
  contents: read
  pages: write
  id-token: write

# Avoid overlapping deployments while allowing in-progress runs to finish.
concurrency:
  group: github-pages
  cancel-in-progress: false

jobs:
  build:
    name: Validate and build
    runs-on: ubuntu-latest
    steps:
      - name: Check out repository
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0
        with:
          persist-credentials: false

      - name: Validate site and workflow safety
        run: python3 scripts/check_site.py

      - name: Build static site
        run: bash scripts/build.sh

      - name: Configure GitHub Pages
        uses: actions/configure-pages@983d7736d9b0ae728b81ab479565c72886d7745b # v5.0.0

      - name: Upload GitHub Pages artifact
        uses: actions/upload-pages-artifact@56afc609e74202658d3ffba0e8f6dda462b719fa # v3.0.1
        with:
          path: ./_site

  deploy:
    name: Deploy to GitHub Pages
    needs: build
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - name: Deploy GitHub Pages site
        id: deployment
        uses: actions/deploy-pages@d6db90164ac5ed86f2b6aed7e0febac5b3c0c03e # v4.0.5
EOF

cat > .github/dependabot.yml <<'EOF'
version: 2
updates:
  - package-ecosystem: github-actions
    directory: /
    schedule:
      interval: weekly
    groups:
      github-actions:
        patterns:
          - "*"
EOF

cat > .gitignore <<'EOF'
# Generated deployment artifact
_site/

# Local editor and OS files
.DS_Store
.idea/
.vscode/
*.swp

# Local tooling
node_modules/
__pycache__/
EOF

printf '%s\n' 'Created build script, validator, secure workflow, Dependabot config, and .gitignore.'
