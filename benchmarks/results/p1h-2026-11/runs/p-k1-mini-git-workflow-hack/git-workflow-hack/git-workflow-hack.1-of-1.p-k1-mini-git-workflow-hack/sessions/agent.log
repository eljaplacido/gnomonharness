    text = path.read_text(encoding="utf-8")
    text = text.replace(
        '    <link rel="stylesheet" href="assets/css/styles.css">',
        '    <link rel="icon" href="assets/favicon.svg" type="image/svg+xml">\n    <link rel="stylesheet" href="assets/css/styles.css">',
    )
