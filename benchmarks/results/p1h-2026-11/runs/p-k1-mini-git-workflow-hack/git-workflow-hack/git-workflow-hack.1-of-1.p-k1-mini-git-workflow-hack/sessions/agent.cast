[338.797422, "o", "<returncode>\r\n0\r\n<output>\r\n--- available YAML parsers ---\r\n/usr/bin/perl\r\nPyYAML unavailable: No module named 'yaml'\r\nruamel.yaml unavailable: No module named 'ruamel'\r\n--- favicon references ---\r\n./404.html\r\n./about.html\r\n./blog.html\r\n./blog/graph-neural-networks-connectomics.html\r\n./blog/interpretable-neural-models.html\r\n./blog/ml-single-cell-genomics.html\r\n./index.html\r\n./publications.html\r\n--- validation ---\r\nValidation passed: 8 HTML pages and 8 required files checked.\r\n--- rebuild ---\r\nBuilt static site at /app/my_website/_site\r\n--- serve and smoke test ---\r\n/                                                200\r\n/about.html                                      200\r\n/blog.html                                       200\r\n/publications.html                               200\r\n/blog/interpretable-neural-models.html           200\r\n/assets/css/styles.css                           200\r\n/assets/js/main.js                               200\r\n/assets/favicon.svg                              200\r\n/info.md                                         200\r\n\r\n"]
