[201.318667, "o", "\r\u001b[2KI’m creating the visual foundation first: a responsive, accessible research-profile design with a restrained navy/teal palette, readable typography, and mobile \r\nnavigation. The site will use only local assets and no third-party runtime dependencies.\r\n\r\n```\r\ncd /app/my_website && mkdir -p assets/css assets/js scripts blog && cat > assets/css/styles.css <<'EOF'\r\n/* ==========================================================================\r\n   Lydia Moreno — Research Profile\r\n   Dependency-free, accessible, responsive styles\r\n   ========================================================================== */\r\n\r\n:root {\r\n  --ink: #172530;\r\n  --ink-soft: #314552;\r\n  --muted: #5c6d78;\r\n  --paper: #fbfaf6;\r\n  --paper-deep: #f3f1ea;\r\n  --card: #ffffff;\r\n  --navy: #102b3f;\r\n  --navy-light: #1b4159;\r\n  --teal: #137b82;\r\n  --teal-dark: #0d5e64;\r\n  --teal-wash: #e4f1f1;\r\n  --gold: #b07a3b;\r\n  --line: #dce3e4;\r\n  --line-dark: #c7d3d5;\r\n  --shadow-sm: 0 1px 2px rgba(16, 43, 63, 0.04), 0 8px 24px rgba(16, 43, 63, 0.05);\r\n  --shadow-md: 0 16px 44px rgba(16, 43, 63, 0.10);\r\n  --radius: 14px;\r\n  --radius-lg: 24px;\r\n  --serif: \"Iowan Old Style\", \"Palatino Linotype\", \"Book Antiqua\", Palatino, Georgia, serif;\r\n  --sans: \"Inter\", \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\r\n  --max-width: 1160px;\r\n  --header-height: 76px;\r\n}\r\n\r\n*,\r\n*::before,\r\n*::after {\r\n  box-sizing: border-box;\r\n}\r\n\r\nhtml {\r\n  scroll-behavior: smooth;\r\n  scroll-padding-top: calc(var(--header-height) + 24px);\r\n}\r\n\r\nbody {\r\n  margin: 0;\r\n  background:\r\n    radial-gradient(circle at 8% 4%, rgba(19, 123, 130, 0.07), transparent 26rem),\r\n    var(--paper);\r\n  color: var(--ink);\r\n  font-family: var(--sans);\r\n  font-size: 1rem;\r\n  line-height: 1.7;\r\n  -webkit-font-smoothing: antialiased;\r\n  text-rendering: optimizeLegibility;\r\n}\r\n\r\nbody.nav-open {\r\n  overflow: hidden;\r\n}\r\n\r\nimg,\r\nsvg {\r\n  display: block;\r\n  max-width: 100%;\r\n}\r\n\r\na {\r\n  color: var(--teal-dark);\r\n  text-decoration-thickness: 1px;\r\n  text-underline-offset: 0.18em;\r\n}\r\n\r\na:hover {\r\n  color: var(--navy);\r\n}\r\n\r\n:focus-visible {\r\n  outline: 3px solid rgba(19, 123, 130, 0.45);\r\n  outline-offset: 4px;\r\n  border-radius: 4px;\r\n}\r\n\r\n.skip-link {\r\n  position: fixed;\r\n  top: 0.75rem;\r\n  left: 0.75rem;\r\n  z-index: 1000;\r\n  padding: 0.75rem 1rem;\r\n  background: var(--navy);\r\n  color: #fff;\r\n  border-radius: 8px;\r\n  font-weight: 700;\r\n  transform: translateY(-160%);\r\n  transition: transform 160ms ease;\r\n}\r\n\r\n.skip-link:focus {\r\n  color: #fff;\r\n  transform: translateY(0);\r\n}\r\n\r\n.container {\r\n  width: min(100% - 2.5rem, var(--max-width));\r\n  margin-inline: auto;\r\n}\r\n\r\n.container--narrow {\r\n  width: min(100% - 2.5rem, 820px);\r\n  margin-inline: auto;\r\n}\r\n\r\n/* Header and navigation -------------------------------------------------- */\r\n\r\n.site-header {\r\n  position: sticky;\r\n  top: 0;\r\n  z-index: 100;\r\n  min-height: var(--header-height);\r\n  border-bottom: 1px solid rgba(199, 211, 213, 0.72);\r\n  background: rgba(251, 250, 246, 0.92);\r\n  backdrop-filter: blur(16px);\r\n  -webkit-backdrop-filter: blur(16px);\r\n}\r\n\r\n.header-inner {\r\n  min-height: var(--header-height);\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 2rem;\r\n}\r\n\r\n.brand {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 0.8rem;\r\n  color: var(--ink);\r\n  text-decoration: none;\r\n  line-height: 1.15;\r\n}\r\n\r\n.brand:hover {\r\n  color: var(--ink);\r\n}\r\n\r\n.brand-mark {\r\n  display: grid;\r\n  width: 2.55rem;\r\n  height: 2.55rem;\r\n  place-items: center;\r\n  flex: 0 0 auto;\r\n  border-radius: 50%;\r\n  background: var(--navy);\r\n  color: #fff;\r\n  font-family: var(--serif);\r\n  font-size: 0.96rem;\r\n  font-weight: 700;\r\n  letter-spacing: 0.03em;\r\n}\r\n\r\n.brand-copy strong {\r\n  display: block;\r\n  font-family: var(--serif);\r\n  font-size: 1.08rem;\r\n  font-weight: 700;\r\n  letter-spacing: -0.015em;\r\n}\r\n\r\n.brand-copy span {\r\n  display: block;\r\n  margin-top: 0.12rem;\r\n  color: var(--muted);\r\n  font-size: 0.69rem;\r\n  font-weight: 700;\r\n  letter-spacing: 0.13em;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.site-nav ul {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 0.35rem;\r\n  margin: 0;\r\n  padding: 0;\r\n  list-style: none;\r\n}\r\n\r\n.site-nav a {\r\n  display: inline-block;\r\n  padding: 0.55rem 0.8rem;\r\n  border-radius: 999px;\r\n  color: var(--ink-soft);\r\n  font-size: 0.9rem;\r\n  font-weight: 650;\r\n  text-decoration: none;\r\n  transition: background-color 160ms ease, color 160ms ease;\r\n}\r\n\r\n.site-nav a:hover {\r\n  background: rgba(19, 123, 130, 0.08);\r\n  color: var(--teal-dark);\r\n}\r\n\r\n.site-nav a[aria-current=\"page\"] {\r\n  background: var(--teal-wash);\r\n  color: var(--teal-dark);\r\n}\r\n\r\n.site-nav .nav-contact {\r\n  margin-left: 0.35rem;\r\n  border: 1px solid var(--line-dark);\r\n  background: var(--card);\r\n}\r\n\r\n.nav-toggle {\r\n  display: none;\r\n  align-items: center;\r\n  justify-content: center;\r\n  width: 2.75rem;\r\n  height: 2.75rem;\r\n  padding: 0;\r\n  border: 1px solid var(--line-dark);\r\n  border-radius: 50%;\r\n  background: var(--card);\r\n  color: var(--ink);\r\n  cursor: pointer;\r\n}\r\n\r\n.nav-toggle-lines,\r\n.nav-toggle-lines::before,\r\n.nav-toggle-lines::after {\r\n  display: block;\r\n  width: 1.1rem;\r\n  height: 2px;\r\n  border-radius: 2px;\r\n  background: currentColor;\r\n  transition: transform 180ms ease, opacity 180ms ease;\r\n}\r\n\r\n.nav-toggle-lines {\r\n  position: relative;\r\n}\r\n\r\n.nav-toggle-lines::before,\r\n.nav-toggle-lines::after {\r\n  position: absolute;\r\n  left: 0;\r\n  content: \"\";\r\n}\r\n\r\n.nav-toggle-lines::before {\r\n  top: -6px;\r\n}\r\n\r\n.nav-toggle-lines::after {\r\n  top: 6px;\r\n}\r\n\r\n.nav-open .nav-toggle-lines {\r\n  background: transparent;\r\n}\r\n\r\n.nav-open .nav-toggle-lines::before {\r\n  transform: translateY(6px) rotate(45deg);\r\n}\r\n\r\n.nav-open .nav-toggle-lines::after {\r\n  transform: translateY(-6px) rotate(-45deg);\r\n}\r\n\r\n/* Buttons ---------------------------------------------------------------- */\r\n\r\n.btn {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  gap: 0.55rem;\r\n  min-height: 2.9rem;\r\n  padding: 0.72rem 1.15rem;\r\n  border: 1px solid transparent;\r\n  border-radius: 999px;\r\n  background: var(--navy);\r\n  color: #fff;\r\n  font: inherit;\r\n  font-size: 0.91rem;\r\n  font-weight: 700;\r\n  line-height: 1.2;\r\n  text-decoration: none;\r\n  cursor: pointer;\r\n  transition: transform 160ms ease, background-color 160ms ease, border-color 160ms ease;\r\n}\r\n\r\n.btn:hover {\r\n  background: var(--navy-light);\r\n  color: #fff;\r\n  transform: translateY(-1px);\r\n}\r\n\r\n.btn--teal {\r\n  background: var(--teal);\r\n}\r\n\r\n.btn--teal:hover {\r\n  background: var(--teal-dark);\r\n}\r\n\r\n.btn--ghost {\r\n  border-color: var(--line-dark);\r\n  background: transparent;\r\n  color: var(--ink);\r\n}\r\n\r\n.btn--ghost:hover {\r\n  border-color: var(--teal);\r\n  background: var(--teal-wash);\r\n  color: var(--teal-dark);\r\n}\r\n\r\n.btn--small {\r\n  min-height: 2.35rem;\r\n  padding: 0.52rem 0.85rem;\r\n  font-size: 0.8rem;\r\n}\r\n\r\n.btn-row {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 0.7rem;\r\n  margin-top: 1.6rem;\r\n}\r\n\r\n/* Shared text and sections ---------------------------------------------- */\r\n\r\n.eyebrow {\r\n  margin: 0 0 0.85rem;\r\n  color: var(--teal-dark);\r\n  font-size: 0.72rem;\r\n  font-weight: 800;\r\n  letter-spacing: 0.17em;\r\n  text-transform: uppercase;\r\n}\r\n\r\nh1,\r\nh2,\r\nh3,\r\nh4 {\r\n  margin-top: 0;\r\n  color: var(--ink);\r\n  font-family: var(--serif);\r\n  font-weight: 700;\r\n  line-height: 1.16;\r\n  letter-spacing: -0.025em;\r\n}\r\n\r\nh1 {\r\n  margin-bottom: 1.1rem;\r\n  font-size: clamp(2.65rem, 6.1vw, 5rem);\r\n}\r\n\r\nh2 {\r\n  margin-bottom: 0.85rem;\r\n  font-size: clamp(1.85rem, 3.25vw, 2.65rem);\r\n}\r\n\r\nh3 {\r\n  margin-bottom: 0.55rem;\r\n  font-size: 1.3rem;\r\n}\r\n\r\np {\r\n  margin-top: 0;\r\n  margin-bottom: 1rem;\r\n}\r\n\r\n.lead {\r\n  max-width: 42rem;\r\n  color: var(--ink-soft);\r\n  font-size: clamp(1.08rem, 1.8vw, 1.28rem);\r\n  line-height: 1.72;\r\n}\r\n\r\n.muted {\r\n  color: var(--muted);\r\n}\r\n\r\n.section {\r\n  padding: 4.75rem 0;\r\n}\r\n\r\n.section--tinted {\r\n  border-block: 1px solid rgba(199, 211, 213, 0.72);\r\n  background:\r\n    linear-gradient(180deg, rgba(228, 241, 241, 0.45), rgba(243, 241, 234, 0.55));\r\n}\r\n\r\n.section-heading {\r\n  display: flex;\r\n  align-items: flex-end;\r\n  justify-content: space-between;\r\n  gap: 2rem;\r\n  margin-bottom: 2.2rem;\r\n}\r\n\r\n.section-heading > div {\r\n  max-width: 47rem;\r\n}\r\n\r\n.section-heading p {\r\n  margin-bottom: 0;\r\n  color: var(--muted);\r\n}\r\n\r\n/* Hero ------------------------------------------------------------------- */\r\n\r\n.hero {\r\n  position: relative;\r\n  overflow: hidden;\r\n  padding: clamp(4.5rem, 8vw, 7rem) 0 clamp(4rem, 7vw, 6rem);\r\n}\r\n\r\n.hero-grid {\r\n  display: grid;\r\n  grid-template-columns: minmax(0, 1.12fr) minmax(19rem, 0.88fr);\r\n  align-items: center;\r\n  gap: clamp(2.5rem, 6vw, 5.5rem);\r\n}\r\n\r\n.hero h1 {\r\n  max-width: 12ch;\r\n}\r\n\r\n.hero h1 em {\r\n  color: var(--teal-dark);\r\n  font-style: italic;\r\n}\r\n\r\n.hero .lead {\r\n  max-width: 39rem;\r\n}\r\n\r\n.hero-meta {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  gap: 0.55rem 1.2rem;\r\n  margin-top: 2rem;\r\n  color: var(--muted);\r\n  font-size: 0.84rem;\r\n  font-weight: 650;\r\n}\r\n\r\n.hero-meta span {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 0.45rem;\r\n}\r\n\r\n.hero-meta span::before {\r\n  width: 5px;\r\n  height: 5px;\r\n  border-radius: 50%;\r\n  background: var(--teal);\r\n  content: \"\";\r\n}\r\n\r\n.profile-card {\r\n  position: relative;\r\n  padding: 0.7rem;\r\n  border: 1px solid rgba(199, 211, 213, 0.8);\r\n  border-radius: var(--radius-lg);\r\n  background: rgba(255, 255, 255, 0.66);\r\n  box-shadow: var(--shadow-md);\r\n}\r\n\r\n.profile-visual {\r\n  position: relative;\r\n  display: grid;\r\n  min-height: 25rem;\r\n  place-items: center;\r\n  overflow: hidden;\r\n  border-radius: 18px;\r\n  background:\r\n    radial-gradient(circle at 72% 20%, rgba(64, 179, 181, 0.55), transparent 36%),\r\n    radial-gradient(circle at 16% 84%, rgba(176, 122, 59, 0.32), transparent 30%),\r\n    linear-gradient(150deg, var(--navy-light), var(--navy) 70%);\r\n}\r\n\r\n.profile-visual::before,\r\n.profile-visual::after {\r\n  position: absolute;\r\n  border: 1px solid rgba(255, 255, 255, 0.18);\r\n  border-radius: 50%;\r\n  content: \"\";\r\n}\r\n\r\n.profile-visual::before {\r\n  width: 19rem;\r\n  height: 19rem;\r\n}\r\n\r\n.profile-visual::after {\r\n  width: 14rem;\r\n  height: 14rem;\r\n}\r\n\r\n.monogram {\r\n  position: relative;\r\n  z-index: 1;\r\n  color: #fff;\r\n  font-family: var(--serif);\r\n  font-size: clamp(5rem, 10vw, 7rem);\r\n  font-weight: 700;\r\n  letter-spacing: -0.09em;\r\n  line-height: 1;\r\n  transform: translateX(-0.05em);\r\n}\r\n\r\n.profile-label {\r\n  position: absolute;\r\n  right: 1.1rem;\r\n  bottom: 1.1rem;\r\n  left: 1.1rem;\r\n  z-index: 2;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 1rem;\r\n  padding: 0.8rem 0.95rem;\r\n  border: 1px solid rgba(255, 255, 255, 0.2);\r\n  border-radius: 12px;\r\n  background: rgba(9, 31, 46, 0.72);\r\n  color: rgba(255, 255, 255, 0.84);\r\n  font-size: 0.72rem;\r\n  font-weight: 700;\r\n  letter-spacing: 0.075em;\r\n  text-transform: uppercase;\r\n  backdrop-filter: blur(8px);\r\n}\r\n\r\n.profile-label strong {\r\n  color: #fff;\r\n  font-weight: 800;\r\n}\r\n\r\n.profile-foot {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 1rem;\r\n  padding: 0.95rem 0.6rem 0.35rem;\r\n  color: var(--muted);\r\n  font-size: 0.78rem;\r\n}\r\n\r\n.profile-foot strong {\r\n  color: var(--ink);\r\n}\r\n\r\n.status {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 0.42rem;\r\n}\r\n\r\n.status::before {\r\n  width: 7px;\r\n  height: 7px;\r\n  border-radius: 50%;\r\n  background: #2f9d78;\r\n  box-shadow: 0 0 0 4px rgba(47, 157, 120, 0.12);\r\n  content: \"\";\r\n}\r\n\r\n/* Stats ------------------------------------------------------------------ */\r\n\r\n.stats {\r\n  display: grid;\r\n  grid-template-columns: repeat(4, minmax(0, 1fr));\r\n  margin-top: 3rem;\r\n  border: 1px solid var(--line);\r\n  border-radius: var(--radius);\r\n  background: rgba(255, 255, 255, 0.64);\r\n  box-shadow: var(--shadow-sm);\r\n}\r\n\r\n.stat {\r\n  padding: 1.15rem 1.35rem;\r\n  border-right: 1px solid var(--line);\r\n}\r\n\r\n.stat:last-child {\r\n  border-right: 0;\r\n}\r\n\r\n.stat strong {\r\n  display: block;\r\n  color: var(--navy);\r\n  font-family: var(--serif);\r\n  font-size: 1.45rem;\r\n  line-height: 1.2;\r\n}\r\n\r\n.stat span {\r\n  color: var(--muted);\r\n  font-size: 0.74rem;\r\n  font-weight: 700;\r\n  letter-spacing: 0.065em;\r\n  text-transform: uppercase;\r\n}\r\n\r\n/* About ------------------------------------------"]
[201.319761, "o", "------------------------ */\r\n\r\n.about-grid {\r\n  display: grid;\r\n  grid-template-columns: minmax(0, 1.5fr) minmax(17rem, 0.7fr);\r\n  gap: clamp(2.5rem, 6vw, 5rem);\r\n  align-items: start;\r\n}\r\n\r\n.prose p:last-child {\r\n  margin-bottom: 0;\r\n}\r\n\r\n.prose p {\r\n  color: var(--ink-soft);\r\n  font-size: 1.02rem;\r\n}\r\n\r\n.fact-card {\r\n  padding: 1.5rem;\r\n  border: 1px solid var(--line);\r\n  border-radius: var(--radius);\r\n  background: var(--card);\r\n  box-shadow: var(--shadow-sm);\r\n}\r\n\r\n.fact-card h3 {\r\n  font-size: 1.06rem;\r\n}\r\n\r\n.fact-list {\r\n  margin: 0;\r\n  padding: 0;\r\n  list-style: none;\r\n}\r\n\r\n.fact-list li {\r\n  display: grid;\r\n  gap: 0.16rem;\r\n  padding: 0.78rem 0;\r\n  border-top: 1px solid var(--line);\r\n}\r\n\r\n.fact-list li:first-child {\r\n  padding-top: 0;\r\n  border-top: 0;\r\n}\r\n\r\n.fact-list strong {\r\n  color: var(--ink);\r\n  font-size: 0.73rem;\r\n  font-weight: 800;\r\n  letter-spacing: 0.09em;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.fact-list span {\r\n  color: var(--ink-soft);\r\n  font-size: 0.91rem;\r\n  line-height: 1.5;\r\n}\r\n\r\n/* Card grids ------------------------------------------------------------- */\r\n\r\n.card-grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(2, minmax(0, 1fr));\r\n  gap: 1rem;\r\n}\r\n\r\n.info-card {\r\n  position: relative;\r\n  padding: 1.5rem;\r\n  overflow: hidden;\r\n  border: 1px solid var(--line);\r\n  border-radius: var(--radius);\r\n  background: var(--card);\r\n  box-shadow: var(--shadow-sm);\r\n  transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;\r\n}\r\n\r\n.info-card::after {\r\n  position: absolute;\r\n  top: 0;\r\n  right: 0;\r\n  width: 4.5rem;\r\n  height: 4.5rem;\r\n  border-radius: 0 0 0 100%;\r\n  background: var(--teal-wash);\r\n  content: \"\";\r\n}\r\n\r\n.info-card:hover {\r\n  border-color: #b9cecf;\r\n  box-shadow: var(--shadow-md);\r\n  transform: translateY(-2px);\r\n}\r\n\r\n.info-card h3,\r\n.info-card h2 {\r\n  position: relative;\r\n  z-index: 1;\r\n  padding-right: 2rem;\r\n  font-size: 1.18rem;\r\n}\r\n\r\n.info-card p {\r\n  position: relative;\r\n  z-index: 1;\r\n  margin-bottom: 0;\r\n  color: var(--muted);\r\n  font-size: 0.94rem;\r\n  line-height: 1.65;\r\n}\r\n\r\n.card-index {\r\n  position: absolute;\r\n  top: 1.25rem;\r\n  right: 1.35rem;\r\n  z-index: 1;\r\n  color: var(--teal-dark);\r\n  font-size: 0.72rem;\r\n  font-weight: 800;\r\n  letter-spacing: 0.08em;\r\n}\r\n\r\n/* Timeline --------------------------------------------------------------- */\r\n\r\n.timeline {\r\n  position: relative;\r\n  margin: 0;\r\n  padding: 0 0 0 1.55rem;\r\n  list-style: none;\r\n}\r\n\r\n.timeline::before {\r\n  position: absolute;\r\n  top: 0.4rem;\r\n  bottom: 0.4rem;\r\n  left: 0.32rem;\r\n  width: 1px;\r\n  background: var(--line-dark);\r\n  content: \"\";\r\n}\r\n\r\n.timeline-item {\r\n  position: relative;\r\n  padding: 0 0 1.65rem 1rem;\r\n}\r\n\r\n.timeline-item:last-child {\r\n  padding-bottom: 0;\r\n}\r\n\r\n.timeline-item::before {\r\n  position: absolute;\r\n  top: 0.42rem;\r\n  left: -1.55rem;\r\n  width: 0.67rem;\r\n  height: 0.67rem;\r\n  border: 2px solid var(--paper);\r\n  border-radius: 50%;\r\n  background: var(--teal);\r\n  box-shadow: 0 0 0 1px var(--teal);\r\n  content: \"\";\r\n}\r\n\r\n.timeline-item h3 {\r\n  margin-bottom: 0.2rem;\r\n  font-size: 1.12rem;\r\n}\r\n\r\n.timeline-meta {\r\n  margin-bottom: 0.35rem;\r\n  color: var(--teal-dark);\r\n  font-size: 0.78rem;\r\n  font-weight: 800;\r\n  letter-spacing: 0.06em;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.timeline-item p {\r\n  margin-bottom: 0;\r\n  color: var(--muted);\r\n  font-size: 0.92rem;\r\n}\r\n\r\n/* Projects --------------------------------------------------------------- */\r\n\r\n.project-grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(3, minmax(0, 1fr));\r\n  gap: 1rem;\r\n}\r\n\r\n.project-card {\r\n  display: flex;\r\n  flex-direction: column;\r\n  padding: 1.55rem;\r\n  border: 1px solid var(--line);\r\n  border-radius: var(--radius);\r\n  background: var(--card);\r\n  box-shadow: var(--shadow-sm);\r\n}\r\n\r\n.project-role {\r\n  margin-bottom: 0.8rem;\r\n  color: var(--gold);\r\n  font-size: 0.7rem;\r\n  font-weight: 800;\r\n  letter-spacing: 0.1em;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.project-card h3 {\r\n  margin-bottom: 0.7rem;\r\n  font-size: 1.22rem;\r\n}\r\n\r\n.project-card p {\r\n  margin-bottom: 1rem;\r\n  color: var(--muted);\r\n  font-size: 0.91rem;\r\n}\r\n\r\n.clean-list {\r\n  margin: auto 0 0;\r\n  padding: 1rem 0 0;\r\n  border-top: 1px solid var(--line);\r\n  list-style: none;\r\n}\r\n\r\n.clean-list li {\r\n  position: relative;\r\n  padding: 0.26rem 0 0.26rem 0.95rem;\r\n  color: var(--ink-soft);\r\n  font-size: 0.86rem;\r\n  line-height: 1.55;\r\n}\r\n\r\n.clean-list li::before {\r\n  position: absolute;\r\n  top: 0.72rem;\r\n  left: 0;\r\n  width: 4px;\r\n  height: 4px;\r\n  border-radius: 50%;\r\n  background: var(--teal);\r\n  content: \"\";\r\n}\r\n\r\n/* Publications ----------------------------------------------------------- */\r\n\r\n.publication-list {\r\n  display: grid;\r\n  gap: 1rem;\r\n  margin: 0;\r\n  padding: 0;\r\n  list-style: none;\r\n}\r\n\r\n.publication {\r\n  display: grid;\r\n  grid-template-columns: 5.5rem minmax(0, 1fr) auto;\r\n  gap: 1.35rem;\r\n  align-items: start;\r\n  padding: 1.4rem;\r\n  border: 1px solid var(--line);\r\n  border-radius: var(--radius);\r\n  background: var(--card);\r\n  box-shadow: var(--shadow-sm);\r\n}\r\n\r\n.pub-year {\r\n  padding-top: 0.08rem;\r\n  color: var(--teal-dark);\r\n  font-family: var(--serif);\r\n  font-size: 1.2rem;\r\n  font-weight: 700;\r\n}\r\n\r\n.pub-body h3 {\r\n  margin-bottom: 0.35rem;\r\n  font-size: 1.18rem;\r\n  line-height: 1.35;\r\n}\r\n\r\n.pub-authors {\r\n  margin-bottom: 0.15rem;\r\n  color: var(--ink-soft);\r\n  font-size: 0.91rem;\r\n}\r\n\r\n.pub-venue {\r\n  margin-bottom: 0;\r\n  color: var(--muted);\r\n  font-size: 0.87rem;\r\n  font-style: italic;\r\n}\r\n\r\n.pub-actions {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 0.45rem;\r\n  min-width: 7.8rem;\r\n}\r\n\r\n.pub-tag {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  width: fit-content;\r\n  padding: 0.27rem 0.58rem;\r\n  border-radius: 999px;\r\n  background: var(--teal-wash);\r\n  color: var(--teal-dark);\r\n  font-size: 0.67rem;\r\n  font-weight: 800;\r\n  letter-spacing: 0.06em;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.copy-status {\r\n  color: var(--muted);\r\n  font-size: 0.72rem;\r\n  line-height: 1.3;\r\n}\r\n\r\n/* Blog ------------------------------------------------------------------- */\r\n\r\n.blog-grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(3, minmax(0, 1fr));\r\n  gap: 1rem;\r\n}\r\n\r\n.post-card {\r\n  display: flex;\r\n  flex-direction: column;\r\n  overflow: hidden;\r\n  border: 1px solid var(--line);\r\n  border-radius: var(--radius);\r\n  background: var(--card);\r\n  box-shadow: var(--shadow-sm);\r\n  transition: transform 180ms ease, box-shadow 180ms ease;\r\n}\r\n\r\n.post-card:hover {\r\n  box-shadow: var(--shadow-md);\r\n  transform: translateY(-2px);\r\n}\r\n\r\n.post-art {\r\n  position: relative;\r\n  min-height: 9.2rem;\r\n  overflow: hidden;\r\n  background:\r\n    linear-gradient(130deg, rgba(19, 123, 130, 0.96), rgba(16, 43, 63, 0.98));\r\n}\r\n\r\n.post-art::before,\r\n.post-art::after {\r\n  position: absolute;\r\n  border: 1px solid rgba(255, 255, 255, 0.2);\r\n  border-radius: 50%;\r\n  content: \"\";\r\n}\r\n\r\n.post-art::before {\r\n  width: 9rem;\r\n  height: 9rem;\r\n  top: -3.4rem;\r\n  right: -2.2rem;\r\n}\r\n\r\n.post-art::after {\r\n  width: 6rem;\r\n  height: 6rem;\r\n  bottom: -2.4rem;\r\n  left: 1.4rem;\r\n}\r\n\r\n.post-art--gold {\r\n  background:\r\n    linear-gradient(130deg, rgba(176, 122, 59, 0.95), rgba(68, 50, 37, 0.98));\r\n}\r\n\r\n.post-art--sky {\r\n  background:\r\n    linear-gradient(130deg, rgba(47, 114, 157, 0.95), rgba(16, 43, 63, 0.98));\r\n}\r\n\r\n.post-art-label {\r\n  position: absolute;\r\n  right: 1rem;\r\n  bottom: 1rem;\r\n  left: 1rem;\r\n  color: rgba(255, 255, 255, 0.8);\r\n  font-size: 0.68rem;\r\n  font-weight: 800;\r\n  letter-spacing: 0.12em;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.post-content {\r\n  display: flex;\r\n  flex: 1;\r\n  flex-direction: column;\r\n  padding: 1.3rem;\r\n}\r\n\r\n.post-date {\r\n  margin-bottom: 0.5rem;\r\n  color: var(--teal-dark);\r\n  font-size: 0.7rem;\r\n  font-weight: 800;\r\n  letter-spacing: 0.085em;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.post-content h3 {\r\n  font-size: 1.16rem;\r\n  line-height: 1.35;\r\n}\r\n\r\n.post-content h3 a {\r\n  color: var(--ink);\r\n  text-decoration: none;\r\n}\r\n\r\n.post-content h3 a:hover {\r\n  color: var(--teal-dark);\r\n  text-decoration: underline;\r\n}\r\n\r\n.post-content p {\r\n  color: var(--muted);\r\n  font-size: 0.9rem;\r\n}\r\n\r\n.read-link {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 0.38rem;\r\n  margin-top: auto;\r\n  font-size: 0.82rem;\r\n  font-weight: 800;\r\n  text-decoration: none;\r\n}\r\n\r\n.read-link::after {\r\n  content: \"→\";\r\n  transition: transform 160ms ease;\r\n}\r\n\r\n.read-link:hover::after {\r\n  transform: translateX(3px);\r\n}\r\n\r\n/* Contact ---------------------------------------------------------------- */\r\n\r\n.contact-panel {\r\n  display: grid;\r\n  grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);\r\n  gap: 2.5rem;\r\n  padding: clamp(2rem, 5vw, 3.4rem);\r\n  border-radius: var(--radius-lg);\r\n  background:\r\n    radial-gradient(circle at 100% 0%, rgba(52, 161, 164, 0.33), transparent 22rem),\r\n    var(--navy);\r\n  color: rgba(255, 255, 255, 0.78);\r\n  box-shadow: var(--shadow-md);\r\n}\r\n\r\n.contact-panel h2,\r\n.contact-panel h3 {\r\n  color: #fff;\r\n}\r\n\r\n.contact-panel p {\r\n  color: rgba(255, 255, 255, 0.72);\r\n}\r\n\r\n.contact-panel .eyebrow {\r\n  color: #8cd6d5;\r\n}\r\n\r\n.contact-links {\r\n  display: grid;\r\n  gap: 0.75rem;\r\n  align-content: start;\r\n}\r\n\r\n.contact-link {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 1rem;\r\n  padding: 0.8rem 0;\r\n  border-bottom: 1px solid rgba(255, 255, 255, 0.15);\r\n  color: #fff;\r\n  text-decoration: none;\r\n}\r\n\r\n.contact-link span {\r\n  color: rgba(255, 255, 255, 0.56);\r\n  font-size: 0.68rem;\r\n  font-weight: 800;\r\n  letter-spacing: 0.1em;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.contact-link strong {\r\n  font-size: 0.91rem;\r\n  font-weight: 650;\r\n  text-align: right;\r\n  overflow-wrap: anywhere;\r\n}\r\n\r\n.contact-link:hover {\r\n  color: #8cd6d5;\r\n}\r\n\r\n/* Page hero and article -------------------------------------------------- */\r\n\r\n.page-hero {\r\n  padding: 4.5rem 0 3.25rem;\r\n  border-bottom: 1px solid var(--line);\r\n  background:\r\n    radial-gradient(circle at 90% 0%, rgba(19, 123, 130, 0.1), transparent 27rem),\r\n    transparent;\r\n}\r\n\r\n.page-hero h1 {\r\n  max-width: 15ch;\r\n  margin-bottom: 0.9rem;\r\n  font-size: clamp(2.6rem, 5.2vw, 4.2rem);\r\n}\r\n\r\n.page-hero .lead {\r\n  max-width: 46rem;\r\n}\r\n\r\n.breadcrumbs {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 0.45rem;\r\n  margin-bottom: 1.2rem;\r\n  padding: 0;\r\n  color: var(--muted);\r\n  font-size: 0.78rem;\r\n  font-weight: 650;\r\n  list-style: none;\r\n}\r\n\r\n.breadcrumbs li:not(:last-child)::after {\r\n  margin-left: 0.45rem;\r\n  content: \"/\";\r\n  color: var(--line-dark);\r\n}\r\n\r\n.breadcrumbs a {\r\n  color: var(--teal-dark);\r\n  text-decoration: none;\r\n}\r\n\r\n.article-shell {\r\n  padding: 3.5rem 0 5rem;\r\n}\r\n\r\n.article-header {\r\n  margin-bottom: 2.5rem;\r\n  padding-bottom: 2rem;\r\n  border-bottom: 1px solid var(--line);\r\n}\r\n\r\n.article-header h1 {\r\n  font-size: clamp(2.2rem, 5vw, 3.6rem);\r\n}\r\n\r\n.article-byline {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 0.5rem 1.2rem;\r\n  color: var(--muted);\r\n  font-size: 0.83rem;\r\n  font-weight: 650;\r\n}\r\n\r\n.article-body h2 {\r\n  margin-top: 2.4rem;\r\n  font-size: 1.7rem;\r\n}\r\n\r\n.article-body h3 {\r\n  margin-top: 2rem;\r\n}\r\n\r\n.article-body p,\r\n.article-body li {\r\n  color: var(--ink-soft);\r\n  font-size: 1.04rem;\r\n  line-height: 1.8;\r\n}\r\n\r\n.article-body ul {\r\n  padding-left: 1.2rem;\r\n}\r\n\r\n"]
[201.319824, "o", ".article-body blockquote {\r\n  margin: 1.8rem 0;\r\n  padding: 1rem 1.3rem;\r\n  border-left: 3px solid var(--teal);\r\n  background: var(--teal-wash);\r\n  color: var(--ink-soft);\r\n  font-family: var(--serif);\r\n  font-size: 1.15rem;\r\n}\r\n\r\n.article-note {\r\n  margin-top: 2.5rem;\r\n  padding: 1.25rem;\r\n  border: 1px solid var(--line);\r\n  border-radius: var(--radius);\r\n  background: rgba(255, 255, 255, 0.68);\r\n  color: var(--muted);\r\n  font-size: 0.9rem;\r\n}\r\n\r\n/* Footer ----------------------------------------------------------------- */\r\n\r\n.site-footer {\r\n  padding: 2.8rem 0;\r\n  border-top: 1px solid var(--line);\r\n  background: var(--paper-deep);\r\n}\r\n\r\n.footer-inner {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 1.5rem;\r\n}\r\n\r\n.footer-inner p {\r\n  margin: 0;\r\n  color: var(--muted);\r\n  font-size: 0.8rem;\r\n}\r\n\r\n.footer-links {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 1rem;\r\n}\r\n\r\n.footer-links a {\r\n  color: var(--ink-soft);\r\n  font-size: 0.8rem;\r\n  font-weight: 650;\r\n  text-decoration: none;\r\n}\r\n\r\n.footer-links a:hover {\r\n  color: var(--teal-dark);\r\n  text-decoration: underline;\r\n}\r\n\r\n/* Reveal animation ------------------------------------------------------- */\r\n\r\n.reveal {\r\n  opacity: 0;\r\n  transform: translateY(14px);\r\n  transition: opacity 500ms ease, transform 500ms ease;\r\n}\r\n\r\n.reveal.is-visible {\r\n  opacity: 1;\r\n  transform: none;\r\n}\r\n\r\n/* Responsive ------------------------------------------------------------- */\r\n\r\n@media (max-width: 980px) {\r\n  .hero-grid,\r\n  .about-grid,\r\n  .contact-panel {\r\n    grid-template-columns: 1fr;\r\n  }\r\n\r\n  .hero-grid {\r\n    gap: 3rem;\r\n  }\r\n\r\n  .profile-card {\r\n    max-width: 32rem;\r\n  }\r\n\r\n  .project-grid,\r\n  .blog-grid {\r\n    grid-template-columns: repeat(2, minmax(0, 1fr));\r\n  }\r\n\r\n  .publication {\r\n    grid-template-columns: 4.5rem minmax(0, 1fr);\r\n  }\r\n\r\n  .pub-actions {\r\n    grid-column: 2;\r\n    flex-direction: row;\r\n    flex-wrap: wrap;\r\n    align-items: center;\r\n  }\r\n}\r\n\r\n@media (max-width: 780px) {\r\n  :root {\r\n    --header-height: 68px;\r\n  }\r\n\r\n  .container,\r\n  .container--narrow {\r\n    width: min(100% - 1.8rem, var(--max-width));\r\n  }\r\n\r\n  .nav-toggle {\r\n    display: inline-flex;\r\n  }\r\n\r\n  .site-nav {\r\n    position: fixed;\r\n    top: var(--header-height);\r\n    right: 0;\r\n    left: 0;\r\n    display: none;\r\n    max-height: calc(100vh - var(--header-height));\r\n    padding: 0.75rem 0.9rem 1.4rem;\r\n    overflow-y: auto;\r\n    border-bottom: 1px solid var(--line);\r\n    background: var(--paper);\r\n    box-shadow: var(--shadow-md);\r\n  }\r\n\r\n  .nav-open .site-nav {\r\n    display: block;\r\n  }\r\n\r\n  .site-nav ul {\r\n    align-items: stretch;\r\n    flex-direction: column;\r\n    gap: 0.15rem;\r\n  }\r\n\r\n  .site-nav a,\r\n  .site-nav .nav-contact {\r\n    display: block;\r\n    margin: 0;\r\n    border: 0;\r\n    border-radius: 8px;\r\n    padding: 0.78rem 0.85rem;\r\n  }\r\n\r\n  .section {\r\n    padding: 3.5rem 0;\r\n  }\r\n\r\n  .section-heading {\r\n    display: block;\r\n  }\r\n\r\n  .section-heading .btn {\r\n    margin-top: 1rem;\r\n  }\r\n\r\n  .stats {\r\n    grid-template-columns: repeat(2, minmax(0, 1fr));\r\n  }\r\n\r\n  .stat:nth-child(2) {\r\n    border-right: 0;\r\n  }\r\n\r\n  .stat:nth-child(-n + 2) {\r\n    border-bottom: 1px solid var(--line);\r\n  }\r\n\r\n  .card-grid,\r\n  .project-grid,\r\n  .blog-grid {\r\n    grid-template-columns: 1fr;\r\n  }\r\n\r\n  .publication {\r\n    grid-template-columns: 1fr;\r\n    gap: 0.6rem;\r\n  }\r\n\r\n  .pub-year {\r\n    padding-top: 0;\r\n  }\r\n\r\n  .pub-actions {\r\n    grid-column: auto;\r\n    flex-direction: row;\r\n    flex-wrap: wrap;\r\n    align-items: center;\r\n  }\r\n\r\n  .footer-inner {\r\n    align-items: flex-start;\r\n    flex-direction: column;\r\n  }\r\n}\r\n\r\n@media (max-width: 520px) {\r\n  .brand-copy span {\r\n    display: none;\r\n  }\r\n\r\n  .hero {\r\n    padding-top: 3.4rem;\r\n  }\r\n\r\n  .profile-visual {\r\n    min-height: 21rem;\r\n  }\r\n\r\n  .stats {\r\n    grid-template-columns: 1fr;\r\n  }\r\n\r\n  .stat,\r\n  .stat:nth-child(2) {\r\n    border-right: 0;\r\n    border-bottom: 1px solid var(--line);\r\n  }\r\n\r\n  .stat:last-child {\r\n    border-bottom: 0;\r\n  }\r\n\r\n  .contact-panel {\r\n    padding: 1.6rem;\r\n  }\r\n\r\n  .contact-link {\r\n    "]
[201.320516, "o", "align-items: flex-start;\r\n    flex-direction: column;\r\n    gap: 0.2rem;\r\n  }\r\n\r\n  .contact-link strong {\r\n    text-align: left;\r\n  }\r\n}\r\n\r\n@media (prefers-reduced-motion: reduce) {\r\n  html {\r\n    scroll-behavior: auto;\r\n  }\r\n\r\n  *,\r\n  *::before,\r\n  *::after {\r\n    animation-duration: 0.01ms !important;\r\n    animation-iteration-count: 1 !important;\r\n    transition-duration: 0.01ms !important;\r\n  }\r\n\r\n  .reveal {\r\n    opacity: 1;\r\n    transform: none;\r\n  }\r\n}\r\n\r\n@media print {\r\n  .site-header,\r\n  .site-footer,\r\n  .btn-row,\r\n  .nav-toggle {\r\n    display: none !important;\r\n  }\r\n\r\n  body {\r\n    background: #fff;\r\n  }\r\n\r\n  .section,\r\n  .hero {\r\n    padding: 1.5rem 0;\r\n  }\r\n\r\n  .profile-card,\r\n  .info-card,\r\n  .project-card,\r\n  .publication,\r\n  .post-card,\r\n  .contact-panel {\r\n    break-inside: avoid;\r\n    box-shadow: none;\r\n  }\r\n\r\n  .contact-panel {\r\n    color: var(--ink);\r\n    background: #fff;\r\n    border: 1px solid var(--line);\r\n  }\r\n\r\n  .contact-panel h2,\r\n  .contact-panel p,\r\n  .contact-link,\r\n  .contact-link strong,\r\n  .contact-link span {\r\n    color: var(--ink);\r\n  }\r\n}\r\nEOF\r\ncat > assets/js/main.js <<'EOF'\r\n(() => {\r\n  \"use strict\";\r\n\r\n  const body = document.body;\r\n  const navToggle = document.querySelector(\".nav-toggle\");\r\n  const siteNav = document.querySelector(\".site-nav\");\r\n\r\n  const closeNavigation = () => {\r\n    body.classList.remove(\"nav-open\");\r\n    if (navToggle) {\r\n      navToggle.setAttribute(\"aria-expanded\", \"false\");\r\n    }\r\n  };\r\n\r\n  if (navToggle && siteNav) {\r\n    navToggle.addEventListener(\"click\", () => {\r\n      const isOpen = body.classList.toggle(\"nav-open\");\r\n      navToggle.setAttribute(\"aria-expanded\", String(isOpen));\r\n    });\r\n\r\n    siteNav.addEventListener(\"click\", (event) => {\r\n      if (event.target.closest(\"a\")) {\r\n        closeNavigation();\r\n      }\r\n    });\r\n\r\n    window.addEventListener(\"keydown\", (event) => {\r\n      if (event.key === \"Escape\") {\r\n        closeNavigation();\r\n        navToggle.focus();\r\n      }\r\n    });\r\n\r\n    window.addEventListener(\"resize\", () => {\r\n      if (window.innerWidth > 780) {\r\n        closeNavigation();\r\n      }\r\n    });\r\n  }\r\n\r\n  document.querySelectorAll(\"[data-current-year]\").forEach((node) => {\r\n    node.textContent = String(new Date().getFullYear());\r\n  });\r\n\r\n  // Copy a publication citation from the publication page.\r\n  document.querySelectorAll(\"[data-copy-citation]\").forEach((button) => {\r\n    button.addEventListener(\"click\", async () => {\r\n      const citation = button.getAttribute(\"data-copy-citation\");\r\n      const status = document.getElementById(button.getAttribute(\"data-status-target\"));\r\n      if (!citation) return;\r\n\r\n      try {\r\n        await navigator.clipboard.writeText(citation);\r\n        button.textContent = \"Copied\";\r\n        if (status) status.textContent = \"Citation copied to clipboard.\";\r\n      } catch {\r\n        if (status) status.textContent = \"Copy failed — select the citation text manually.\";\r\n      }\r\n\r\n      window.setTimeout(() => {\r\n        button.textContent = \"Copy citation\";\r\n        if (status) status.textContent = \"\";\r\n      }, 2400);\r\n    });\r\n  });\r\n\r\n  // Subtle, optional entrance animation. Content remains visible without JS.\r\n  const reduceMotion = window.matchMedia(\"(prefers-reduced-motion: reduce)\").matches;\r\n  const revealItems = document.querySelectorAll(\".reveal\");\r\n\r\n  if (!reduceMotion && \"IntersectionObserver\" in window && revealItems.length) {\r\n    const observer = new IntersectionObserver(\r\n      (entries) => {\r\n        entries.forEach((entry) => {\r\n          if (entry.isIntersecting) {\r\n            entry.target.classList.add(\"is-visible\");\r\n            observer.unobserve(entry.target);\r\n          }\r\n        });\r\n      },\r\n      { threshold: 0.08, rootMargin: \"0px 0px -30px 0px\" }\r\n    );\r\n\r\n    revealItems.forEach((item) => observer.observe(item));\r\n\r\n    // Ensure content is visible if the observer is delayed or unavailable.\r\n    window.setTimeout(() => {\r\n      revealItems.forEach((item) => item.classList.add(\"is-visible\"));\r\n    }, 1200);\r\n  } else {\r\n    revealItems.forEach((item) => item.classL"]
