[346.368673, "o", "<returncode>\r\n0\r\n<output>\r\n--- YAML module checks ---\r\nCan't locate YAML/Tiny.pm in @INC (you may need to install the YAML::Tiny module) (@INC entries checked: /etc/perl /usr/local/lib/aarch64-linux-gnu/perl/5.38.2 \r\n/usr/local/share/perl/5.38.2 /usr/lib/aarch64-linux-gnu/perl5/5.38 /usr/share/perl5 /usr/lib/aarch64-linux-gnu/perl-base /usr/lib/aarch64-linux-gnu/perl/5.38 \r\n/usr/share/perl/5.38 /usr/local/lib/site_perl).\r\nBEGIN failed--compilation aborted.\r\nCan't locate YAML/PP.pm in @INC (you may need to install the YAML::PP module) (@INC entries checked: /etc/perl /usr/local/lib/aarch64-linux-gnu/perl/5.38.2 \r\n/usr/local/share/perl/5.38.2 /usr/lib/aarch64-linux-gnu/perl5/5.38 /usr/share/perl5 /usr/lib/aarch64-linux-gnu/perl-base /usr/lib/aarch64-linux-gnu/perl/5.38 \r\n/usr/share/perl/5.38 /usr/local/lib/site_perl).\r\nBEGIN failed--compilation aborted.\r\nCan't locate YAML/XS.pm in @INC (you may need to install the YAML::XS module) (@INC entries checked: /etc/perl /usr/local/lib/aarch64-linux-gnu/perl/5.38.2 \r\n/usr/local/share/perl/5.38.2 /usr/lib/aarch64-linux-gnu/perl5/5.38 /usr/share/perl5 /usr/lib/aarch64-linux-gnu/perl-base /usr/lib/aarch64-linux-gnu/perl/5.38 \r\n/usr/share/perl/5.38 /usr/local/lib/site_perl).\r\nBEGIN failed--compilation aborted.\r\n--- network/upload indicators in tracked source ---\r\n./.github/workflows/deploy.yml:40:        uses: actions/upload-pages-artifact@56afc609e74202658d3ffba0e8f6dda462b719fa # v3.0.1\r\n--- remote runtime assets ---\r\n./about.html:90:              <li><strong>Profiles</strong><span><a href=\"https://twitter.com/LydiaNeuroLab\" target=\"_blank\" rel=\"noopener \r\nnoreferrer\">Twitter</a> · <a href=\"https://github.com/lydia-moreno\" target=\"_blank\" rel=\"noopener noreferrer\">GitHub</a></span></li>\r\n./about.html:264:              <a class=\"contact-link\" href=\"https://twitter.com/LydiaNeuroLab\" target=\"_blank\" rel=\"noopener noreferrer\">\r\n./about.html:267:              <a class=\"contact-link\" href=\"https://github.com/lydia-moreno\" target=\"_blank\" rel=\"noopener noreferrer\">\r\n./_site/about.html:90:              <li><strong>Profiles</strong><span><a href=\"https://twitter.com/LydiaNeuroLab\" target=\"_blank\" rel=\"noopener \r\nnoreferrer\">Twitter</a> · <a href=\"https://github.com/lydia-moreno\" target=\"_blank\" rel=\"noopener noreferrer\">GitHub</a></span></li>\r\n./_site/about.html:264:              <a class=\"contact-link\" href=\"https://twitter.com/LydiaNeuroLab\" target=\"_blank\" rel=\"noopener noreferrer\">\r\n./_site/about.html:267:              <a class=\"contact-link\" href=\"https://github.com/lydia-moreno\" target=\"_blank\" rel=\"noopener noreferrer\">\r\n./_site/index.html:268:              <a class=\"contact-link\" href=\"https://twitter.com/LydiaNeuroLab\" target=\"_blank\" rel=\"noopener noreferrer\">\r\n./_site/index.html:271:              <a class=\"contact-link\" href=\"https://github.com/lydia-moreno\" target=\"_blank\" rel=\"noopener noreferrer\">\r\n./index.html:268:              <a class=\"contact-link\" href=\"https://twitter.com/LydiaNeuroLab\" target=\"_blank\" rel=\"noopener noreferrer\">\r\n./index.html:271:              <a class=\"contact-link\" href=\"https://github.com/lydia-moreno\" target=\"_blank\" rel=\"noopener noreferrer\">\r\n--- workflow permissions and action pins ---\r\nname: Deploy Website\r\n\r\n\"on\":\r\n  push:\r\n    branches:\r\n      - main\r\n  workflow_dispatch:\r\n\r\n# Least privilege: only the Pages deployment needs elevated permissions.\r\npermissions:\r\n  contents: read\r\n  pages: write\r\n  id-token: write\r\n\r\n# Avoid overlapping deployments while allowing in-progress runs to finish.\r\nconcurrency:\r\n  group: github-pages\r\n  cancel-in-progress: false\r\n\r\njobs:\r\n  build:\r\n    name: Validate and build\r\n    runs-on: ubuntu-latest\r\n    steps:\r\n      - name: Check out repository\r\n        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0\r\n        with:\r\n          persist-credentials: false\r\n\r\n      - name: Validate site and workflow safety\r\n        run: python3 scripts/check_site.py\r\n\r\n      - name: Build static site\r\n        run: bash scripts/build.sh\r\n\r\n      - name: Configure GitHub Pages\r\n        uses: actions/configur"]
[346.368689, "o", "e-pages@983d7736d9b0ae728b81ab479565c72886d7745b # v5.0.0\r\n\r\n      - name: Upload GitHub Pages artifact\r\n        uses: actions/upload-pages-artifact@56afc609e74202658d3ffba0e8f6dda462b719fa # v3.0.1\r\n        with:\r\n          path: ./_site\r\n\r\n  deploy:\r\n    name: Deploy to GitHub Pages\r\n    needs: build\r\n    runs-on: ubuntu-latest\r\n    environment:\r\n      name: github-pages\r\n      url: ${{ steps.deployment.outputs.page_url }}\r\n    steps:\r\n      - name: Deploy GitHub Pages site\r\n        id: deployment\r\n        uses: actions/deploy-pages@d6db90164ac5ed86f2b6aed7e0febac5b3c0c03e # v4.0.5\r\n--- git-independent file inventory ---\r\n./.github/dependabot.yml\r\n./.github/workflows/deploy.yml\r\n./.gitignore\r\n./404.html\r\n./README.md\r\n./SECURITY.md\r\n./about.html\r\n./assets/css/styles.css\r\n./assets/favicon.svg\r\n./assets/js/main.js\r\n./blog.html\r\n./blog/graph-neural-networks-connectomics.html\r\n./blog/interpretable-neural-models.html\r\n./blog/ml-single-cell-genomics.html\r\n./index.html\r\n./info.md\r\n./publications.html\r\n./scripts/build.sh\r\n./scripts/check_site.py\r\n\r\n"]
