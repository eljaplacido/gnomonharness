[258.043995, "o", "\r\u001b[2KNext I’ll create the Publications page with the four CV publications and citation-copy controls, plus the Blog index linking to three article pages.\r\n\r\n```\r\ncd /app/my_website && cat > publications.html <<'EOF'\r\n<!doctype html>\r\n<html lang=\"en\">\r\n  <head>\r\n    <meta charset=\"utf-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\r\n    <meta name=\"description\" content=\"Selected publications by Dr. Lydia Moreno on neural decoding, graph embeddings, single-cell atlases, and explainable AI.\">\r\n    <meta name=\"theme-color\" content=\"#102b3f\">\r\n    <title>Publications | Dr. Lydia Moreno</title>\r\n    <link rel=\"stylesheet\" href=\"assets/css/styles.css\">\r\n    <script src=\"assets/js/main.js\" defer></script>\r\n  </head>\r\n  <body>\r\n    <a class=\"skip-link\" href=\"#main-content\">Skip to main content</a>\r\n\r\n    <header class=\"site-header\">\r\n      <div class=\"container header-inner\">\r\n        <a class=\"brand\" href=\"index.html\" aria-label=\"Dr. Lydia Moreno — home\">\r\n          <span class=\"brand-mark\" aria-hidden=\"true\">LM</span>\r\n          <span class=\"brand-copy\">\r\n            <strong>Lydia Moreno</strong>\r\n            <span>Computational Neuroscience</span>\r\n          </span>\r\n        </a>\r\n        <button class=\"nav-toggle\" type=\"button\" aria-expanded=\"false\" aria-controls=\"site-nav\">\r\n          <span class=\"nav-toggle-lines\" aria-hidden=\"true\"></span>\r\n          <span class=\"sr-only\">Toggle navigation</span>\r\n        </button>\r\n        <nav class=\"site-nav\" id=\"site-nav\" aria-label=\"Primary navigation\">\r\n          <ul>\r\n            <li><a href=\"about.html\">About Me</a></li>\r\n            <li><a href=\"blog.html\">Blog</a></li>\r\n            <li><a href=\"publications.html\" aria-current=\"page\">Publications</a></li>\r\n            <li><a class=\"nav-contact\" href=\"about.html#contact\">Contact</a></li>\r\n          </ul>\r\n        </nav>\r\n      </div>\r\n    </header>\r\n\r\n    <main id=\"main-content\">\r\n      <section class=\"page-hero\" aria-labelledby=\"page-title\">\r\n        <div class=\"container\">\r\n          <p class=\"eyebrow\">Research Output</p>\r\n          <h1 id=\"page-title\">Publications</h1>\r\n          <p class=\"lead\">\r\n            Selected peer-reviewed work on neural decoding, graph learning for connectomics,\r\n            integrative single-cell atlases, and explainable AI in neuroscience.\r\n          </p>\r\n        </div>\r\n      </section>\r\n\r\n      <section class=\"section\" aria-labelledby=\"selected-publications-title\">\r\n        <div class=\"container\">\r\n          <div class=\"section-heading reveal\">\r\n            <div>\r\n              <p class=\"eyebrow\">Selected Publications</p>\r\n              <h2 id=\"selected-publications-title\">Methods for understanding complex neural systems.</h2>\r\n              <p>Citations follow the format used in the curriculum vitae.</p>\r\n            </div>\r\n            <a class=\"btn btn--ghost\" href=\"info.md\" download>Download CV</a>\r\n          </div>\r\n\r\n          <ol class=\"publication-list\">\r\n            <li class=\"publication reveal\">\r\n              <div class=\"pub-year\">2024</div>\r\n              <div class=\"pub-body\">\r\n                <span class=\"pub-tag\">Neural Decoding</span>\r\n                <h3>Temporal Convolutional Networks Decode Visual Stimuli from Two-Photon Signals</h3>\r\n                <p class=\"pub-authors\">Moreno, L., &amp; Patel, A.</p>\r\n                <p class=\"pub-venue\">Journal of Computational Neuroscience, 45(2), 123–137.</p>\r\n              </div>\r\n              <div class=\"pub-actions\">\r\n                <button class=\"btn btn--ghost btn--small\" type=\"button\"\r\n                  data-copy-citation=\"Moreno, L., &amp; Patel, A. (2024). Temporal Convolutional Networks Decode Visual Stimuli from Two-Photon Signals. Journal\r\nof Computational Neuroscience, 45(2), 123–137.\"\r\n                  data-status-target=\"copy-status-2024\">Copy citation</button>\r\n                <span class=\"copy-status\" id=\"copy-status-2024\" role=\"status\" aria-live=\"polite\"></span>\r\n              </div>\r\n            </li>\r\n\r\n            <li class=\"publication reveal\">\r\n              <div class=\"pub"]
[258.044181, "o", "-year\">2023</div>\r\n              <div class=\"pub-body\">\r\n                <span class=\"pub-tag\">Connectomics</span>\r\n                <h3>Graph Embedding Techniques Reveal Synaptic Motifs in EM Datasets</h3>\r\n                <p class=\"pub-authors\">Moreno, L., Zhang, W., &amp; Singh, R.</p>\r\n                <p class=\"pub-venue\">Neuroinformatics, 21(4), 299–312.</p>\r\n              </div>\r\n              <div class=\"pub-actions\">\r\n                <button class=\"btn btn--ghost btn--small\" type=\"button\"\r\n                  data-copy-citation=\"Moreno, L., Zhang, W., &amp; Singh, R. (2023). Graph Embedding Techniques Reveal Synaptic Motifs in EM Datasets. \r\nNeuroinformatics, 21(4), 299–312.\"\r\n                  data-status-target=\"copy-status-2023\">Copy citation</button>\r\n                <span class=\"copy-status\" id=\"copy-status-2023\" role=\"status\" aria-live=\"polite\"></span>\r\n              </div>\r\n            </li>\r\n\r\n            <li class=\"publication reveal\">\r\n              <div class=\"pub-year\">2022</div>\r\n              <div class=\"pub-body\">\r\n                <span class=\"pub-tag\">Single-Cell Omics</span>\r\n                <h3>Integrative Single-Cell Atlas of Human Cerebral Organoids</h3>\r\n                <p class=\"pub-authors\">Moreno, L., et al.</p>\r\n                <p class=\"pub-venue\">Cell Systems, 9(1), 67–82.</p>\r\n              </div>\r\n              <div class=\"pub-actions\">\r\n                <button class=\"btn btn--ghost btn--small\" type=\"button\"\r\n                  data-copy-citation=\"Moreno, L., et al. (2022). Integrative Single-Cell Atlas of Human Cerebral Organoids. Cell Systems, 9(1), 67–82.\"\r\n                  data-status-target=\"copy-status-2022\">Copy citation</button>\r\n                <span class=\"copy-status\" id=\"copy-status-2022\" role=\"status\" aria-live=\"polite\"></span>\r\n              </div>\r\n            </li>\r\n\r\n            <li class=\"publication reveal\">\r\n              <div class=\"pub-year\">2021</div>\r\n              <div class=\"pub-body\">\r\n                <span class=\"pub-tag\">Explainable AI</span>\r\n                <h3>Explainable AI Techniques in Neural Decoding</h3>\r\n                <p class=\"pub-authors\">Chen, J., Moreno, L., &amp; Russo, M.</p>\r\n                <p class=\"pub-venue\">Frontiers in Neuroscience, 15, 756843.</p>\r\n              </div>\r\n              <div class=\"pub-actions\">\r\n                <button class=\"btn btn--ghost btn--small\" type=\"button\"\r\n                  data-copy-citation=\"Chen, J., Moreno, L., &amp; Russo, M. (2021). Explainable AI Techniques in Neural Decoding. Frontiers in Neuroscience, 15,\r\n756843.\"\r\n                  data-status-target=\"copy-status-2021\">Copy citation</button>\r\n                <span class=\"copy-status\" id=\"copy-status-2021\" role=\"status\" aria-live=\"polite\"></span>\r\n              </div>\r\n            </li>\r\n          </ol>\r\n        </div>\r\n      </section>\r\n\r\n      <section class=\"section section--tinted\" aria-labelledby=\"publication-context-title\">\r\n        <div class=\"container about-grid\">\r\n          <div class=\"reveal\">\r\n            <p class=\"eyebrow\">Research Context</p>\r\n            <h2 id=\"publication-context-title\">From signal to structure to interpretation.</h2>\r\n            <div class=\"prose\">\r\n              <p>\r\n                These papers track a common goal: extracting stable, interpretable structure\r\n                from high-dimensional measurements of neural and cellular systems.\r\n              </p>\r\n              <p>\r\n                The work spans temporal models for calcium imaging, graph representations of\r\n                synaptic connectivity, integrative pipelines for single-cell atlases, and\r\n                attribution methods for neural decoders.\r\n              </p>\r\n            </div>\r\n          </div>\r\n          <aside class=\"fact-card reveal\" aria-label=\"Publication topics\">\r\n            <h3>Topics represented</h3>\r\n            <ul class=\"tag-list\">\r\n              <li>Neural decoding</li>\r\n              <li>Two-photon imaging</li>\r\n              <li>Graph neural networks</li>\r\n              <li>Connectomics</li>\r\n              <li"]
[258.044289, "o", ">Single-cell genomics</li>\r\n              <li>Explainable AI</li>\r\n            </ul>\r\n          </aside>\r\n        </div>\r\n      </section>\r\n\r\n      <section class=\"section\" aria-labelledby=\"pub-contact-title\">\r\n        <div class=\"container\">\r\n          <div class=\"contact-panel reveal\">\r\n            <div>\r\n              <p class=\"eyebrow\">Collaboration</p>\r\n              <h2 id=\"pub-contact-title\">Interested in the methods or data?</h2>\r\n              <p>I'm happy to discuss collaborations, reproductions, and extensions of this work.</p>\r\n            </div>\r\n            <div class=\"contact-links\">\r\n              <a class=\"contact-link\" href=\"mailto:lydia.moreno@riverbend.edu\">\r\n                <span>Email</span><strong>lydia.moreno@riverbend.edu</strong>\r\n              </a>\r\n              <a class=\"contact-link\" href=\"about.html#contact\">\r\n                <span>More</span><strong>Contact details</strong>\r\n              </a>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </section>\r\n    </main>\r\n\r\n    <footer class=\"site-footer\">\r\n      <div class=\"container footer-inner\">\r\n        <p>© <span data-current-year>2025</span> Lydia Moreno · Computational Neuroscience</p>\r\n        <div class=\"footer-links\">\r\n          <a href=\"index.html\">Home</a>\r\n          <a href=\"about.html\">About Me</a>\r\n          <a href=\"blog.html\">Blog</a>\r\n          <a href=\"info.md\" download>CV</a>\r\n        </div>\r\n      </div>\r\n    </footer>\r\n  </body>\r\n</html>\r\nEOF\r\ncat > blog.html <<'EOF'\r\n<!doctype html>\r\n<html lang=\"en\">\r\n  <head>\r\n    <meta charset=\"utf-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\r\n    <meta name=\"description\" content=\"Notes and reflections from Dr. Lydia Moreno on interpretable machine learning, single-cell genomics, and graph neural \r\nnetworks for neuroscience.\">\r\n    <meta name=\"theme-color\" content=\"#102b3f\">\r\n    <title>Blog | Dr. Lydia Moreno</title>\r\n    <link rel=\"stylesheet\" href=\"assets/css/styles.css\">\r\n    <script src=\"assets/js/main.js\" defer></script>\r\n  </head>\r\n  <body>\r\n    <a class=\"skip-link\" href=\"#main-content\">Skip to main content</a>\r\n\r\n    <header class=\"site-header\">\r\n      <div class=\"container header-inner\">\r\n        <a class=\"brand\" href=\"index.html\" aria-label=\"Dr. Lydia Moreno — home\">\r\n          <span class=\"brand-mark\" aria-hidden=\"true\">LM</span>\r\n          <span class=\"brand-copy\">\r\n            <strong>Lydia Moreno</strong>\r\n            <span>Computational Neuroscience</span>\r\n          </span>\r\n        </a>\r\n        <button class=\"nav-toggle\" type=\"button\" aria-expanded=\"false\" aria-controls=\"site-nav\">\r\n          <span class=\"nav-toggle-lines\" aria-hidden=\"true\"></span>\r\n          <span class=\"sr-only\">Toggle navigation</span>\r\n        </button>\r\n        <nav class=\"site-nav\" id=\"site-nav\" aria-label=\"Primary navigation\">\r\n          <ul>\r\n            <li><a href=\"about.html\">About Me</a></li>\r\n            <li><a href=\"blog.html\" aria-current=\"page\">Blog</a></li>\r\n            <li><a href=\"publications.html\">Publications</a></li>\r\n            <li><a class=\"nav-contact\" href=\"about.html#contact\">Contact</a></li>\r\n          </ul>\r\n        </nav>\r\n      </div>\r\n    </header>\r\n\r\n    <main id=\"main-content\">\r\n      <section class=\"page-hero\" aria-labelledby=\"page-title\">\r\n        <div class=\"container\">\r\n          <p class=\"eyebrow\">Notes from the Lab</p>\r\n          <h1 id=\"page-title\">Blog</h1>\r\n          <p class=\"lead\">\r\n            Reflections on interpretable machine learning, reproducible pipelines, and the\r\n            craft of computational neuroscience.\r\n          </p>\r\n        </div>\r\n      </section>\r\n\r\n      <section clas