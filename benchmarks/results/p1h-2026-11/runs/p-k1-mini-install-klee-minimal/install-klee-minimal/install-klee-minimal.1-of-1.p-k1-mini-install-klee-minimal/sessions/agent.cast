[158.764763, "o", "\r\u001b[2KKLEE built and installed. Now I'll test the binary, verify the STP solver is compiled in, and inspect the installed include/runtime layout.\r\n\r\n```\r\necho '--- env for run'; /bin/bash -c 'export LD_LIBRARY_PATH=/opt/klee/lib:/opt/klee/stp/lib:/opt/klee/minisat/lib; /opt/klee/bin/klee --version'; echo '--- \r\ninstalled include top'; find /opt/klee/include -maxdepth 3 -type f | sort | head -30; echo '--- installed libs'; find /opt/klee/lib -maxdepth 3 -type f -o -type\r\nl | sort; echo '--- klee help solver'; /bin/bash -c 'export LD_LIBRARY_PATH=/opt/klee/lib:/opt/klee/stp/lib:/opt/klee/minisat/lib; /opt/klee/bin/klee --help \r\n2>&1 | grep -i -E \"solver|stp|version\" | head -30'\r\n```\r\n\u001b[32m⠦\u001b[0m Waiting for the LM to respond..."]
[158.765034, "o", "\r\u001b[2K\u001b[32m⠦\u001b[0m Waiting for the LM to respond...\r\n\u001b[?25h\r\u001b[1A\u001b[2K"]
