[158.838609, "o", "<returncode>\r\n0\r\n<output>\r\n--- env for run\r\nKLEE 3.3 (https://klee-se.org/)\r\n  Build mode: Release (Asserts: ON)\r\n  Build revision: 74f49f1d243f0e1692a00ac688a7b805b37c5646\r\n\r\nUbuntu LLVM version 16.0.6\r\n  Optimized build.\r\n--- installed include top\r\n/opt/klee/include/klee/klee.h\r\n--- installed libs\r\n/opt/klee/lib/klee/runtime/libkleeRuntimeFortify64_Debug+Asserts.bca\r\n/opt/klee/lib/klee/runtime/libkleeRuntimeFortify64_Debug.bca\r\n/opt/klee/lib/klee/runtime/libkleeRuntimeFortify64_Release+Asserts.bca\r\n/opt/klee/lib/klee/runtime/libkleeRuntimeFortify64_Release+Debug+Asserts.bca\r\n/opt/klee/lib/klee/runtime/libkleeRuntimeFortify64_Release+Debug.bca\r\n/opt/klee/lib/klee/runtime/libkleeRuntimeFortify64_Release.bca\r\n/opt/klee/lib/klee/runtime/libkleeRuntimeFreestanding64_Debug+Asserts.bca\r\n/opt/klee/lib/klee/runtime/libkleeRuntimeFreestanding64_Debug.bca\r\n/opt/klee/lib/klee/runtime/libkleeRuntimeFreestanding64_Release+Asserts.bca\r\n/opt/klee/lib/klee/runtime/libkleeRuntimeFreestanding64_Release+Debug+Asserts.bca\r\n/opt/klee/lib/klee/runtime/libkleeRuntimeFreestanding64_Release+Debug.bca\r\n/opt/klee/lib/klee/runtime/libkleeRuntimeFreestanding64_Release.bca\r\n/opt/klee/lib/klee/runtime/libkleeRuntimeIntrinsic64_Debug+Asserts.bca\r\n/opt/klee/lib/klee/runtime/libkleeRuntimeIntrinsic64_Debug.bca\r\n/opt/klee/lib/klee/runtime/libkleeRuntimeIntrinsic64_Release+Asserts.bca\r\n/opt/klee/lib/klee/runtime/libkleeRuntimeIntrinsic64_Release+Debug+Asserts.bca\r\n/opt/klee/lib/klee/runtime/libkleeRuntimeIntrinsic64_Release+Debug.bca\r\n/opt/klee/lib/klee/runtime/libkleeRuntimeIntrinsic64_Release.bca\r\n/opt/klee/lib/klee/runtime/libkleeRuntimeKLEELibc64_Debug+Asserts.bca\r\n/opt/klee/lib/klee/runtime/libkleeRuntimeKLEELibc64_Debug.bca\r\n/opt/klee/lib/klee/runtime/libkleeRuntimeKLEELibc64_Release+Asserts.bca\r\n/opt/klee/lib/klee/runtime/libkleeRuntimeKLEELibc64_Release+Debug+Asserts.bca\r\n/opt/klee/lib/klee/runtime/libkleeRuntimeKLEELibc64_Release+Debug.bca\r\n/opt/klee/lib/klee/runtime/libkleeRuntimeKLEELibc64_Release.bca\r\n/opt/klee/lib/klee/runtime/libkleeUBSan64_Debug+Asserts.bca\r\n/opt/klee/lib/klee/runtime/libkleeUBSan64_Debug.bca\r\n/opt/klee/lib/klee/runtime/libkleeUBSan64_Release+Asserts.bca\r\n/opt/klee/lib/klee/runtime/libkleeUBSan64_Release+Debug+Asserts.bca\r\n/opt/klee/lib/klee/runtime/libkleeUBSan64_Release+Debug.bca\r\n/opt/klee/lib/klee/runtime/libkleeUBSan64_Release.bca\r\n/opt/klee/lib/libkleeRuntest.so\r\n/opt/klee/lib/libkleeRuntest.so.1.0\r\n--- klee help solver\r\n  --cex-cache-superset                                    - Try substituting SAT superset counterexample before asking the SMT solver (default=false)\r\n  --cex-cache-try-all                                     - Try substituting all counterexamples before asking the SMT solver (default=false)\r\n  --debug-assignment-validating-solver                    - Debug the correctness of generated assignments (default=false)\r\n  --debug-crosscheck-core-solver=<value>                  - Specifiy a solver to use for crosschecking the results of the core solver\r\n    =stp                                                  -   STP\r\n    =dummy                                                -   Dummy solver\r\n  --debug-dump-stp-queries                                - Dump every STP query to stderr (default=false)\r\n  --debug-validate-solver                                 - Crosscheck the results of the solver chain above the core solver with the results of the core solver\r\n(default=false)\r\n  --equality-substitution                                 - Simplify equality expressions before querying the solver (default=true)\r\n  --ignore-stp-failures                                   - Ignore any STP solver failures (default=false)\r\n  --log-partial-queries-early                             - Log queries before calling the solver (default=false)\r\n  --max-solver-time=<string>                              - Maximum amount of time for a single SMT query (default=0s (off)). Enables --use-forked-solver\r\n  --solver-backend=<value>                                - Specifiy the core solver backend to use\r\n    =stp                        "]
[158.838654, "o", "                          -   STP (default)\r\n    =dummy                                                -   Dummy solver\r\n  --solver-optimize-divides                               - Optimize constant divides into add/shift/multiplies before passing them to the core SMT solver \r\n(default=false)\r\n  --stp-sat-solver=<value>                                - Set the underlying SAT solver for STP (default=cryptominisat)\r\n  --use-fast-cex-solver                                   - Enable an experimental range-based solver (default=false)\r\n  --use-forked-solver                                     - Run the core SMT solver in a forked process (default=true)\r\n  --use-independent-solver                                - Use constraint independence (default=true)\r\n    =solver:kquery                                        -   All queries reaching the solver in .kquery (KQuery) format\r\n    =solver:smt2                                          -   All queries reaching the solver in .smt2 (SMT-LIBv2) format\r\n  --use-construct-hash-stp                                - Use hash-consing during STP query construction (default=true)\r\n  --version                                               - Display the version of this program\r\n  --libc=<value>                                          - Choose libc version (none by default).\r\n  --runtime-build=<string>                                - Link with versions of the runtime library that were built with the provided configuration \r\n(default=Debug+Asserts).\r\n    =ImplicitTruncation                                   -   Implicit conversion from integer of larger bit width to smaller bit width that results in data \r\nloss\r\n    =ImplicitConversion                                   -   Implicit conversion between integer types that changes the sign of the value\r\n\r\n"]
