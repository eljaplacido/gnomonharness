[76.363296, "o", "<returncode>\r\n0\r\n<output_head>\r\n1:KLEE 3.3, 15 October 2026\r\n2-=========================\r\n3-\r\n4-Incorporating changes from 24 December 2025 to 15 October 2026.\r\n5-Maintainers during this time span: @ccadar\r\n6:Documentation at https://klee-se.org/releases/docs/v3.3\r\n7-\r\n8-== Major features and important changes ==\r\n9-- New KLEE Web version (@FinnLeh, @YiLai-qed)\r\n10-- Execute unsupported intrinsics via external calls (@operasfantom)\r\n11-\r\n12:== LLVM support ==\r\n13:- Current recommended version is LLVM 18\r\n14:- Added full support for LLVM 17-19 (@ccadar)\r\n15:- Removed support for LLVM < 15 (@ccadar)\r\n16:- KLEE 3.3 will be the last version with support for LLVM 15\r\n17-\r\n18-== Options, scripts and KLEE intrinsics added, changed or removed ==\r\n19-- Initialised the struct stats of symbolic files (A, B, ...) to fixed sane defaults. In particular, symbolic files are now regular files for which we have \r\nread and write permissions (@ccadar)\r\n20-- Added support for the llvm.load.relative intrinsic (@ccadar)\r\n21-- Added support for the llvm.ptrmask intrinsic (@ccadar)\r\n22-- Improved support for the llvm.load.relative intrinsic (@ccadar)\r\n23-\r\n24-== Other changes ==\r\n25:- Add support for the new pass manager of LLVM 17+ (@ccadar)\r\n26:- Add UBSan support for the (LLVM 17+) function type mismatch handler ABI (@operasfantom)\r\n27-- Enforced fd access mode checks for sym-file read/write operations (@dino-fan777)\r\n28-- Moved FreeBSD CI from Cirrus CI to GitHub Actions (@arrowd)\r\n29-- Fix a crash when runFunctionAsMain() is invoked multiple times, particularly when replaying multiple .ktest files (@nokitoino)\r\n30-- Recompute GEP indices instead of accumulating them across runs (@nokitoino)\r\n31-- Fixed permission checks in the POSIX runtime (@ccadar)\r\n32-- Fixed dangling pointer in utimes() for symbolic files when the second argument is NULL (@fkil)\r\n33-- Improvements to KLEE's freestanding library (@ccadar)\r\n34-- Fixed issue with leaking solver shared memory segments (@ccadar)\r\n35-- Added a UBSan tutorial (@5467845)\r\n36-- Smaller refactorings, fixes and improvements, test cases, maintenance, comments, web version, website, etc. (@12300001111, @251, @arrowd, @ccadar, \r\n@danielschemmel, @davidtr1037, @dependabot, @foxtran, @jbuening, @operasfantom)\r\n37-\r\n38-\r\n39-KLEE 3.2, 23 December 2025\r\n40-==========================\r\n41-\r\n42-Incorporating changes from 1 March 2024 to 23 December 2025.\r\n43-Maintainers during this time span: @ccadar, @MartinNowack, @251, @danielschemmel\r\n44-Documentation at https://klee-se.org/releases/docs/v3.2\r\n45-\r\n46-== Major features and important changes ==\r\n47-- KLEE acquired a new domain name: klee-se.org\r\n48-- Added an option to generate XML test cases (@misonijnik)\r\n49-- Improved the freestanding runtime (@mrexodia)\r\n50-- Fixed support for concrete objects > 2^32 bytes (@ccadar)\r\n51-\r\n52:== LLVM support ==\r\n53:- Current recommended version is LLVM 16\r\n54:- Added partial support for LLVM 17-19 (@mrexodia)\r\n55:- Removed support for LLVM < 13 (@ccadar)\r\n56:- KLEE 3.2 will be the last version with support for LLVM <15\r\n57-\r\n58-== Options, scripts and KLEE intrinsics added, changed or removed ==\r\n59-- Renamed --ignore-solver-failures to --ignore-stp-failures (@ccadar)\r\n60-\r\n61-== Other changes ==\r\n62-- Added functions for comparing versions to build scripts (@ccadar)\r\n63-- Added handler for _Exit (@fwc)\r\n64-- Reorganised tests: (@ccadar)\r\n65-- Disallow symbolic objects > 2^32 bytes, which were previously handled incorrectly (@ccadar)\r\n66-- Smaller refactorings, fixes and improvements, test cases, maintenance, comments, web version, website, etc. (@251, @ccadar, @danielschemmel, @dependabot, \r\n@homyhost, @jamacku, @jbuening, @MartinNowack, @ricardaxel, @sp1ff, @sreeshmaheshwar, @xokdvium)\r\n67-\r\n68-\r\n69-KLEE 3.1, 29 February 2024\r\n70-==========================\r\n71-\r\n72-Incorporating changes from 8 June 2023 to 29 February 2024.\r\n73-Maintainers during this time span: @ccadar, @MartinNowack, @251.\r\n74-Documentation at https://klee-se.org/releases/docs/v3.1\r\n75-\r\n76-== Major features and important changes ==\r\n77-- New execution tree implementation and klee-exec-tree tool (@251)\r\n78-- KDAlloc is now the default allocator in KLEE (KDAlloc was introduced in KLEE 3.0)\r\n79-- Resolve memory reads/writes to single objects in more cases (@tkuchta)\r\n80-- Concretize values based on seeds when available (@ccadar)\r\n81-- Fixed some interactions with external code (@ccadar, @MartinNowack, mishok2503)\r\n82-\r\n83:== LLVM support ==\r\n84:- Current recommended version is still LLVM 13\r\n85:- Added support for LLVM 15 and 16 (@MartinNowack)\r\n86:- Removed support for LLVM <11 (@danielschemmel)\r\n87:- KLEE 3.1 will be the last version with support for LLVM <13\r\n88-\r\n89-== Options, scripts and KLEE intrinsics added, changed or removed ==\r\n90-- New klee-exec-tree tool (@251)\r\n91-- New --write-exec-tree and --exec-tree-batch-size options (@251)\r\n92-- Renamed --compress-process-tree to --compress-exec-tree (@ccadar)\r\n93-- PTree is now called ExecutionTree in the code (@ccadar)\r\n94-- KDAlloc (--kdalloc) is now enabled by default (@ccadar)\r\n95-- Replaced --suppress-exter\r\n<output_tail>\r\n- package list files\r\nbuild-ci-container.py\r\nbuild.sh\r\ncommon-functions\r\n"]
[76.363398, "o", "d-klee-linux-ubuntu.inc\r\np-clang-linux-arch.inc\r\np-clang-linux-debian.inc\r\np-clang-linux-ubuntu-22.04.inc\r\np-clang-linux-ubuntu.inc\r\np-clang-linux.inc\r\np-clang-osx.inc\r\np-clang.inc\r\np-cmake-linux-ubuntu.inc\r\np-cmake-osx.inc\r\np-gtest-linux-ubuntu.inc\r\np-gtest-osx.inc\r\np-gtest.inc\r\np-klee-linux-ubuntu.inc\r\np-klee-osx.inc\r\np-klee.inc\r\np-libcxx-linux-arch.inc\r\np-libcxx-linux-debian.inc\r\np-libcxx-linux-ubuntu.inc\r\np-libcxx-osx.inc\r\np-libcxx.inc\r\np-llvm-linux-arch.inc\r\np-llvm-linux-debian.inc\r\np-llvm-linux-ubuntu.inc\r\np-llvm-osx.inc\r\np-llvm.inc\r\np-metasmt-linux-ubuntu.inc\r\np-metasmt.inc\r\np-sanitizer-linux-ubuntu.inc\r\np-sanitizer-linux.inc\r\np-sqlite-linux-ubuntu.inc\r\np-sqlite-osx.inc\r\np-sqlite.inc\r\np-stp-linux-ubuntu.inc\r\np-stp-osx.inc\r\np-stp.inc\r\np-tcmalloc-linux-ubuntu.inc\r\np-tcmalloc.inc\r\np-uclibc-linux-ubuntu.inc\r\np-uclibc.inc\r\np-z3-linux-ubuntu.inc\r\np-z3-osx.inc\r\np-z3.inc\r\npatches\r\nrun-tests.sh\r\nsanitizer\r\nv-clang.inc\r\nv-cmake.inc\r\nv-gtest.inc\r\nv-klee.inc\r\nv-libcxx.inc\r\nv-llvm.inc\r\nv-metasmt.inc\r\nv-sanitizer.inc\r\nv-sanitizer_compiler.inc\r\nv-solvers.inc\r\nv-sqlite.inc\r\nv-stp.inc\r\nv-tcmalloc.inc\r\nv-uclibc.inc\r\nv-z3.inc\r\nscripts/build/p-sanitizer-linux-ubuntu.inc:22:      with_sudo apt-get -y --no-install-recommends install \"${dependencies[@]}\"\r\nscripts/build/p-sanitizer-linux-ubuntu.inc:44:  with_sudo apt-get -y --no-install-recommends install \"${dependencies[@]}\" || return 1\r\nscripts/build/p-stp-linux-ubuntu.inc:18:  with_sudo apt -y --no-install-recommends install \"${dependencies[@]}\"\r\nscripts/build/p-libcxx-linux-debian.inc:16:  with_sudo apt -y --no-install-recommends install \"${dependencies[@]}\"\r\nscripts/build/p-gtest-linux-ubuntu.inc:12:  with_sudo apt -y --no-install-recommends install \"${dependencies[@]}\"\r\nscripts/build/p-cmake-linux-ubuntu.inc:18:      with_sudo apt -y --no-install-recommends install \"${dependencies[@]}\"\r\nscripts/build/p-cmake-linux-ubuntu.inc:33:  with_sudo apt -y --no-install-recommends install \"${dependencies[@]}\"\r\nscripts/build/p-uclibc-linux-ubuntu.inc:11:    libncurses5-dev\r\nscripts/build/p-uclibc-linux-ubuntu.inc:16:  with_sudo apt -y --no-install-recommends install \"${dependencies[@]}\"\r\nscripts/build/p-sqlite-linux-ubuntu.inc:12:  with_sudo apt -y --no-install-recommends install \"${dependencies[@]}\"\r\nscripts/build/p-sqlite-linux-ubuntu.inc:21:    libsqlite3-dev\r\nscripts/build/p-sqlite-linux-ubuntu.inc:23:  with_sudo apt -y --no-install-recommends install \"${dependencies[@]}\"\r\nscripts/build/p-sqlite-linux-ubuntu.inc:29:  [[ -f /usr/lib/x86_64-linux-gnu/libsqlite3.so ]] || return 1\r\nscripts/build/p-sqlite.inc:26:  \"${COMP}\" \"${CFLAGS[@]}\" -fPIC -o \"${SQLITE_INSTALL_PATH}\"/libsqlite3.so -DSQLITE_THREADSAFE=0 -DSQLITE_OMIT_LOAD_EXTENSION \r\n-shared sqlite3.c\r\nscripts/build/p-sqlite.inc:39:    [[ -f \"${SQLITE_INSTALL_PATH}\"/libsqlite3.so ]]\r\nscripts/build/p-z3-linux-ubuntu.inc:15:  with_sudo apt -y --no-install-recommends install \"${dependencies[@]}\"\r\nscripts/build/p-klee.inc:93:        \"-DZ3_LIBRARIES=${Z3_INSTALL_PATH}/lib/libz3.so\"\r\nscripts/build/p-metasmt-linux-ubuntu.inc:10:    libboost-dev\r\nscripts/build/p-metasmt-linux-ubuntu.inc:30:  with_sudo apt -y --no-install-recommends install \"${dependencies[@]}\"\r\nscripts/build/p-klee-linux-ubuntu.inc:24:      libboost-dev\r\nscripts/build/p-klee-linux-ubuntu.inc:36:  with_sudo apt-get -y --no-install-recommends install \"${dependencies[@]}\"\r\nscripts/build/p-libcxx-linux-ubuntu.inc:16:  with_sudo apt -y --no-install-recommends install \"${dependencies[@]}\"\r\nscripts/build/p-llvm-linux-debian.inc:27:  with_sudo apt -y --no-install-recommends install \"${dependencies[@]}\"\r\nscripts/build/p-llvm-linux-debian.inc:68:      with_sudo apt-get -y --no-install-recommends install \"${dependencies[@]}\"\r\nscripts/build/p-llvm-linux-debian.inc:91:  with_sudo apt-get -y --no-install-recommends install \"${dependencies[@]}\" || return 1\r\nscripts/build/p-clang-linux-ubuntu.inc:19:      with_sudo apt-get -y --no-install-recommends install \"${dependencies[@]}\"\r\nscripts/build/p-clang-linux-ubuntu.inc:40:  with_sudo apt-get -y --no-install-recommends install \"${dependencies[@]}\" |"]
