make -j"$(nproc)" > /tmp/stp-full-build.log 2>&1 || { tail -200 /tmp/stp-full-build.log; exit 1; }
make install > /tmp/stp-full-install.log 2>&1 || { tail -100 /tmp/stp-full-install.log; exit 1; }
echo stp-full-installed
find /opt/klee/stp-full/bin -maxdepth 1 -type f -perm -111 -printf '%f\n' | sort
LD_LIBRARY_PATH=/opt/klee/stp-full/lib:/opt/klee/minisat/lib /opt/klee/stp-full/bin/stp --version 2>&1 | head -20
