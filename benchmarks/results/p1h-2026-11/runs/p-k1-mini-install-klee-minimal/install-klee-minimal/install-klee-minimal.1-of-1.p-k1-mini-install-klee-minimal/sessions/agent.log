  echo "klee=$(command -v klee)"
  echo "stp=$(command -v stp)"
  echo "CPATH=$CPATH"
  echo "LD_LIBRARY_PATH=$LD_LIBRARY_PATH"
  test -f "${CPATH%%:*}/klee/klee.h" && echo "header=$CPATH/klee/klee.h"
  printf "#include <klee/klee.h>\nint main(void){ int x; klee_make_symbolic(&x,sizeof(x),\"x\"); return x == 0; }\n" > /tmp/final_klee_test.c
  clang-16 -emit-llvm -c -g -O0 -Xclang -disable-O0-optnone /tmp/final_klee_test.c -o /tmp/final_klee_test.bc
  rm -rf /tmp/final-klee-out
  klee --output-dir=/tmp/final-klee-out /tmp/final_klee_test.bc > /tmp/final_klee_run.log 2>&1
  grep -E "Using STP solver backend|generated tests" /tmp/final_klee_run.log
  test "$(find /tmp/final-klee-out -name "*.ktest" | wc -l)" -ge 1
  echo FINAL_VERIFICATION_OK
'
