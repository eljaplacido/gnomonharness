#if 0
"""
#endif
#include <stdio.h>
#include <stdlib.h>
#include <stdint.h>
#include <string.h>
#include <errno.h>
#include <limits.h>

#define BASE 1000000000U
#define BASE_DIGITS 9

typedef struct {
    uint32_t *d;
    size_t len;
    size_t cap;
} Big;

static int big_init(Big *x, size_t cap) {
    x->d = (uint32_t *)calloc(cap, sizeof(uint32_t));
    if (x->d == NULL) {
        return 0;
    }
    x->len = 1;
    x->cap = cap;
    x->d[0] = 0;
    return 1;
}

static int big_reserve(Big *x, size_t cap) {
    if (x->cap >= cap) {
        return 1;
    }
    uint32_t *p = (uint32_t *)realloc(x->d, cap * sizeof(uint32_t));
    if (p == NULL) {
        return 0;
    }
    memset(p + x->cap, 0, (cap - x->cap) * sizeof(uint32_t));
    x->d = p;
    x->cap = cap;
    return 1;
}

static int big_add(Big *r, const Big *a, const Big *b) {
    size_t need = (a->len > b->len ? a->len : b->len) + 1;
    if (!big_reserve(r, need)) {
        return 0;
    }
    size_t max_len = a->len > b->len ? a->len : b->len;
    uint64_t carry = 0;
    size_t i;
    for (i = 0; i < max_len; i++) {
        uint64_t sum = carry;
        if (i < a->len) {
            sum += a->d[i];
        }
        if (i < b->len) {
            sum += b->d[i];
        }
        r->d[i] = (uint32_t)(sum % BASE);
        carry = sum / BASE;
    }
    if (carry != 0) {
        r->d[max_len] = (uint32_t)carry;
        r->len = max_len + 1;
    } else {
        r->len = max_len;
    }
    return 1;
}

static void big_swap(Big *a, Big *b) {
    Big t = *a;
    *a = *b;
    *b = t;
}

static void big_print(const Big *x) {
    printf("%u", x->d[x->len - 1]);
    size_t i = x->len - 1;
    while (i > 0) {
        i--;
        printf("%09u", x->d[i]);
    }
    putchar('\n');
}

int main(int argc, char **argv) {
    if (argc != 2) {
        fprintf(stderr, "usage: %s N\n", argv[0]);
        return 1;
    }

    errno = 0;
    char *end = NULL;
    unsigned long long n = strtoull(argv[1], &end, 10);
    if (errno == ERANGE || end == argv[1] || *end != '\0') {
        fprintf(stderr, "invalid N\n");
        return 1;
    }

    if (n > (unsigned long long)(SIZE_MAX / 4)) {
        fprintf(stderr, "N is too large\n");
        return 1;
    }

    size_t cap = (size_t)(n / 20) + 4;
    Big a, b, c;
    if (!big_init(&a, cap) || !big_init(&b, cap) || !big_init(&c, cap)) {
        fprintf(stderr, "out of memory\n");
        return 1;
    }

    a.d[0] = 0;
    a.len = 1;
    b.d[0] = 1;
    b.len = 1;

    unsigned long long i;
    for (i = 0; i < n; i++) {
        if (!big_add(&c, &a, &b)) {
            fprintf(stderr, "out of memory\n");
            return 1;
        }
        big_swap(&a, &b);
        big_swap(&b, &c);
    }

    big_print(&a);

    free(a.d);
    free(b.d);
    free(c.d);
    return 0;
}
