# Insert a negative-number check right after the argument-count check.
python3 - <<'PY'
from pathlib import Path
p = Path('/app/polyglot/main.py.c')
s = p.read_text()
old = '''    if (argc != 2) {
        fprintf(stderr, "usage: %s N\\n", argv[0]);
        return 1;
    }

    errno = 0;
'''
new = '''    if (argc != 2) {
        fprintf(stderr, "usage: %s N\\n", argv[0]);
        return 1;
    }
    if (argv[1][0] == '-') {
        fprintf(stderr, "N must be non-negative\\n");
        return 1;
    }

    errno = 0;
'''
assert old in s
p.write_text(s.replace(old, new, 1))
PY
rm -f cmain
gcc -Wall -Wextra main.py.c -o cmain 2>/tmp/gcc.err
gcc_status=$?
echo "gcc status=$gcc_status"
printf '%s\n' '--- gcc stderr ---'; cat /tmp/gcc.err
printf '%s\n' '--- delimiters ---'; sed -n '1,5p;136,143p' main.py.c
printf '%s\n' '--- comparisons ---'
status=0
for n in 0 1 2 3 4 5 10 50 90 91 92 93 100 200 500 1000 5000; do
  py=$(python3 main.py.c "$n")
  c=$(./cmain "$n")
  if [ "$py" != "$c" ]; then
    echo "MISMATCH n=$n"
    status=1
  fi
done
[ "$status" -eq 0 ] && echo "all comparisons passed"
printf '%s\n' '--- negative handling ---'
python3 main.py.c -1 >/tmp/pyout 2>/tmp/pyerr; echo "python status=$? out=$(cat /tmp/pyout) err=$(cat /tmp/pyerr)"
./cmain -1 >/tmp/cout 2>/tmp/cerr; echo "c status=$? out=$(cat /tmp/cout) err=$(cat /tmp/cerr)"
