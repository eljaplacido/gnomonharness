[1025.887304, "o", "\r\u001b[2KThe adapter collapsed toward a single answer letter. I’m testing candidate-content scoring with the base model to find a more discriminative objective than \r\npredicting one letter token.\r\n\r\n```\r\ncat > /app/eval_base.py <<'PY'\r\nimport json,torch,math\r\nfrom transformers import AutoTokenizer, AutoModelForCausalLM\r\ntorch.set_num_threads(20)\r\ntok=AutoTokenizer.from_pretrained('openai-community/gpt2'); tok.pad_token=tok.eos_token; tok.padding_side='left'\r\nm=AutoModelForCausalLM.from_pretrained('openai-community/gpt2').eval()\r\nval=json.load(open('/app/data/val.json'))\r\nletters='ABCD'\r\ndef prefixes(s):\r\n opts='\\n'.join(s['options'])\r\n return {\r\n  'answercontent': [f\"Question: {s['question']}\\nAnswer: {s['options'][i]}\" for i in range(4)],\r\n  'fullprompt': [f\"Question: {s['question']}\\nOptions:\\n{opts}\\nAnswer: {s['options'][i]}\" for i in range(4)],\r\n  'theanswer': [f\"Question: {s['question']}\\nThe correct answer is: {s['options'][i]}\" for i in range(4)],\r\n  'context': [f\"{s['question']}\\n{s['options'][i]}\" for"]
[1025.887465, "o", " i in range(4)],\r\n  'optiononly': [f\"{s['options'][i]}\" for i in range(4)],\r\n }\r\ndef score_batch(texts, prefix_texts, batch=8):\r\n out=[]\r\n with torch.no_grad():\r\n  for st in range(0,len(texts),batch):\r\n   ts=texts[st:st+batch]\r\n   e=tok(ts,padding=True,truncation=True,max_length=192,return_tensors='pt')\r\n   logits=m(**e).logits\r\n   for j,t in enumerate(ts):\r\n    # find first non-pad index (left pad), then sequence labels including option\r\n    mask=e['attention_mask'][j].bool(); ids=e['input_ids'][j]\r\n    real_positions=torch.where(mask)[0]\r\n    p=prefix_texts[st+j]\r\n    plen=len(tok(p,add_special_tokens=False)['input_ids'])\r\n    nll=0.; n=0\r\n    for pos in real_positions.tolist():\r\n     if pos>0 and (pos-1)>=real_positions[0].item()+plen-1: # not exactly\r\n      pass\r\n    # compute based on right alignment: full len - plen = prefix token count in padded row\r\n    start_full=len(real_positions)-plen\r\n    starts=real_positions[start_full:].tolist()\r\n    for k,pos in enumerate(starts):\r\n     if k==0: continue\r\n   "]
[1025.887521, "o", "  target=ids[pos].item(); logp=torch.log_softmax(logits[j,pos-1],dim=-1)[target]\r\n     nll += -float(logp); n+=1\r\n    out.append((nll/n if n else 1e9,n))\r\n return out\r\nfor name in ['answercontent','fullprompt','theanswer','context','optiononly']:\r\n correct=0; scores=[]; lens=[]\r\n for s in val:\r\n  te=prefixes(s)[name]\r\n  # prefix: text minus option? easier token boundary via option\r\n  # derive prefix by removing option suffix\r\n  prefs=[]\r\n  for i,t in enumerate(te):\r\n   opt=s['options'][i]\r\n   prefs.append(t[:-len(opt)])\r\n  sc=score_batch(te,prefs)\r\n  vals=[x[0] for x in sc]\r\n  pred=vals.index(min(vals)); correct += pred==letters.index(s['answer'])\r\n  scores.append(vals); lens.append([len(tok(x,add_special_tokens=False)['input_ids']) for x in te])\r\n print(name,'acc',correct/len(val), flush=True)\r\nPY\r\ncd /app && HF_HOME=/app/.cache/huggingface nohup python -u /app/eval_base.py > /app/eval_base.log 2>&1 & echo $! > /app/eval_base.pid; echo started\r\n```\r\n\u001b[32m⠸\u001b[0m Waiting for the LM to respond...\r\u001b[2K\u001b[32m⠸\u001b"]
