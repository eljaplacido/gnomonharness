[951.381034, "o", "\r\u001b[2K\r\n\u001b[1;31mmini-swe-agent\u001b[0m\u001b[31m (step \u001b[0m\u001b[1;31m42\u001b[0m\u001b[31m, \u001b[0m\u001b[1;31m$0.00\u001b[0m\u001b[31m):\u001b[0m\r\n\u001b[32m⠋\u001b[0m Waiting for the LM to respond..."]
[951.389738, "o", "\r\u001b[2K```\r\ncd /app && python - <<'PY'\r\nimport json, torch\r\nfrom transformers import AutoTokenizer, AutoModelForCausalLM\r\nfrom peft import PeftModel\r\ntorch.set_num_threads(20)\r\ntok=AutoTokenizer.from_pretrained('/app/experiments/lora_adapter'); tok.pad_token=tok.eos_token; tok.padding_side='left'\r\nbase=AutoModelForCausalLM.from_pretrained('openai-community/gpt2')\r\nm=PeftModel.from_pretrained(base,'/app/experiments/lora_adapter'); m.eval()\r\nval=json.load(open('/app/data/val.json'))\r\ndef prompt(s): return f\"Question: {s['question']}\\nOptions:\\n\"+'\\n'.join(s['options'])+\"\\nAnswer:\"\r\nids={c:tok(' '+c,add_special_tokens=False)['input_ids'][0] for c in 'ABCD'}\r\nall_logits=[]; preds=[]\r\nwith torch.no_grad():\r\n for i in range(0,len(val),8):\r\n  ss=val[i:i+8]; e=tok([prompt(s) for s in ss],padding=True,truncation=True,max_length=256,return_tensors='pt')\r\n  lo=m(**e).logits[:,-1]\r\n  all_logits.append(lo)\r\n  for j in range(len(ss)):\r\n   p=max('ABCD', key=lambda c: float(lo[j,ids[c]])); preds.append(p)\r\nlogits=torch.cat(all"]
[951.389839, "o", "_logits)\r\nacc=sum(p==s['answer'] for p,s in zip(preds,val))/len(val)\r\nprint('acc',acc)\r\nprint('pred dist', {c:preds.count(c) for c in 'ABCD'})\r\nimport collections\r\nconf=collections.Counter((s['answer'],p) for p,s in zip(preds,val))\r\nprint('confusion truth->pred')\r\nfor a in 'ABCD': print(a, {b:conf[(a,b)] for b in 'ABCD'})\r\n# longest baseline\r\nlongpred=[]\r\nfor s in val:\r\n lens=[len(o) for o in s['options']]; longpred.append('ABCD'[max(range(4), key=lambda i:lens[i])])\r\nprint('longest acc',sum(p==s['answer'] for p,s in zip(longpred,val))/len(val), 'dist',collections.Counter(longpred))\r\n# tie choose answer prior maybe C\r\nprior=[]\r\nfor s in val:\r\n lens=[len(o) for o in s['options']]; mxl=max(lens)\r\n cand=[i for i,l in enumerate(lens) if l==mxl]\r\n # choose C if tied\r\n p='C' if 2 in cand else 'ABCD'[cand[0]]\r\n prior.append(p)\r\nprint('longest tie C',sum(p==s['answer'] for p,s in zip(prior,val))/len(val))\r\n# combine model and longest heuristics; if argmax letter's option is longest? just test fixed rule\r\nfor name, ru"]
[951.389866, "o", "le in [\r\n ('model', lambda s,p: p),\r\n ('longest', lambda s,p: 'ABCD'[max(range(4), key=lambda i:len(s['options'][i]))]),\r\n ('model if model opt within 20 chars of longest else longest', None),\r\n]:\r\n pass\r\n# probability model acc where correct is longest vs not\r\nfor islong in [True,False]:\r\n idx=[i for i,s in enumerate(val) if (max(range(4),key=lambda j:len(s['options'][j])) == 'ABCD'.index(s['answer'])) == islong]\r\n print('islong',islong,'n',len(idx),'model acc',sum(preds[i]==val[i]['answer'] for i in idx)/len(idx) if idx else \r\nNone,'longest',sum(longpred[i]==val[i]['answer'] for i in idx)/len(idx) if idx else None)\r\nPY\r\n```\r\n\u001b[32m⠋\u001b[0m Waiting for the LM to respond...\r\u001b[2K\u001b[32m⠋\u001b[0m Waiting for the LM to respond...\r\n\u001b[?25h\r\u001b[1A\u001b[2K"]
