[321.924761, "o", "\r\u001b[2K\r\n\u001b[1;31mmini-swe-agent\u001b[0m\u001b[31m (step \u001b[0m\u001b[1;31m14\u001b[0m\u001b[31m, \u001b[0m\u001b[1;31m$0.00\u001b[0m\u001b[31m):\u001b[0m\r\n\u001b[32m⠹\u001b[0m Waiting for the LM to respond..."]
[321.957248, "o", "\r\u001b[2KI’ll now create the training script using Peft LoRA on GPT-2’s `c_attn` modules. It will train answer-letter generation, validate by next-token accuracy, and \r\nsave the best adapter plus the required results JSON.\r\n\r\n```\r\ncat > /app/train_lora.py <<'PY'\r\n#!/usr/bin/env python3\r\n\"\"\"LoRA fine-tuning for biomedical multiple-choice QA with GPT-2.\r\n\r\nThe model is trained as a causal language model to produce the correct answer\r\nletter after a standardized question/options prompt.  Only the answer tokens\r\n(and EOS) contribute to the training loss.\r\n\"\"\"\r\nimport argparse\r\nimport json\r\nimport math\r\nimport os\r\nimport random\r\nimport time\r\nfrom pathlib import Path\r\n\r\nimport torch\r\nfrom peft import LoraConfig, TaskType, get_peft_model\r\nfrom transformers import AutoModelForCausalLM, AutoTokenizer\r\n\r\nBASE_MODEL = \"openai-community/gpt2\"\r\nDATA_DIR = Path(\"/app/data\")\r\nOUTPUT_DIR = Path(\"/app/experiments/lora_adapter\")\r\nRESULTS_PATH = Path(\"/app/lora_results.json\")\r\n\r\n\r\ndef set_seed(seed: int) -> None:\r\n    random.se"]
[321.958818, "o", "ed(seed)\r\n    torch.manual_seed(seed)\r\n    if torch.cuda.is_available():\r\n        torch.cuda.manual_seed_all(seed)\r\n\r\n\r\ndef make_prompt(sample: dict) -> str:\r\n    options = \"\\n\".join(sample[\"options\"])\r\n    return f\"Question: {sample['question']}\\nOptions:\\n{options}\\nAnswer:\"\r\n\r\n\r\ndef make_training_text(sample: dict) -> str:\r\n    return make_prompt(sample) + f\" {sample['answer']}\"\r\n\r\n\r\ndef encode_example(tokenizer, sample: dict, max_length: int):\r\n    \"\"\"Tokenize one example and mask all prompt positions in the labels.\"\"\"\r\n    prompt = make_prompt(sample)\r\n    text = prompt + f\" {sample['answer']}\" + tokenizer.eos_token\r\n    encoded = tokenizer(text, truncation=True, max_length=max_length,\r\n                        return_attention_mask=True)\r\n    prompt_len = len(tokenizer(prompt, add_special_tokens=False)[\"input_ids\"])\r\n    labels = list(encoded[\"input_ids\"])\r\n    for i in range(min(prompt_len, len(labels))):\r\n        labels[i] = -100\r\n    return {\r\n        \"input_ids\": encoded[\"input_ids\"],\r\n        \"atten"]
[321.958843, "o", "tion_mask\": encoded[\"attention_mask\"],\r\n        \"labels\": labels,\r\n    }\r\n\r\n\r\ndef collate(batch, pad_token_id: int):\r\n    max_len = max(len(x[\"input_ids\"]) for x in batch)\r\n    input_ids, attention_mask, labels = [], [], []\r\n    for x in batch:\r\n        pad = max_len - len(x[\"input_ids\"])\r\n        # Left padding is generation friendly and harmless for training because\r\n        # padded labels are ignored via -100.\r\n        input_ids.append([pad_token_id] * pad + x[\"input_ids\"])\r\n        attention_mask.append([0] * pad + x[\"attention_mask\"])\r\n        labels.append([-100] * pad + x[\"labels\"])\r\n    return {\r\n        \"input_ids\": torch.tensor(input_ids, dtype=torch.long),\r\n        \"attention_mask\": torch.tensor(attention_mask, dtype=torch.long),\r\n        \"labels\": torch.tensor(labels, dtype=torch.long),\r\n    }\r\n\r\n\r\n@torch.no_grad()\r\ndef evaluate_next_token(model, tokenizer, samples, max_length: int, batch_size: int):\r\n    \"\"\"Validate greedy first-token decoding of A/B/C/D.\"\"\"\r\n    model.eval()\r\n    letter_ids = {"]
[321.958849, "o", "letter: tokenizer(f\" {letter}\", add_special_tokens=False)[\"input_ids\"][0]\r\n                  for letter in \"ABCD\"}\r\n    correct = 0\r\n    total = 0\r\n    for start in range(0, len(samples), batch_size):\r\n        batch_samples = samples[start:start + batch_size]\r\n        prompts = [make_prompt(s) for s in batch_samples]\r\n        enc = tokenizer(prompts, padding=True, truncation=True,\r\n                        max_length=max_length, return_tensors=\"pt\")\r\n        logits = model(**enc).logits\r\n        lengths = enc[\"attention_mask\"].sum(dim=1).tolist()\r\n        for row, sample in enumerate(batch_samples):\r\n            # With left padding, the final real token is always the last row position.\r\n            next_logits = logits[row, -1]\r\n            pred_id = max(letter_ids.values(), key=lambda tid: float(next_logits[tid]))\r\n            pred = [k for k, v in letter_ids.items() if v == pred_id][0]\r\n            correct += int(pred == sample[\"answer\"])\r\n            total += 1\r\n    model.train()\r\n    return correct / max(t"]
