[294.410082, "o", "amp in [False,True]:\r\n  m=AutoModelForCausalLM.from_pretrained('openai-community/gpt2')\r\n  m=get_peft_model(m,LoraConfig(r=8,lora_alpha=16,target_modules=['c_attn'],task_type=TaskType.CAUSAL_LM,lora_dropout=0.05,fan_in_fan_out=True))\r\n  opt=torch.optim.AdamW([p for p in m.parameters() if p.requires_grad],lr=5e-4)\r\n  inp={k:v[:bs] for k,v in enc.items()}; lab=labels[:bs]\r\n  m.train()\r\n  for j in range(2):\r\n   t=time.time()\r\n   if amp:\r\n    with torch.autocast('cpu',dtype=torch.bfloat16):\r\n     out=m(**inp,labels=lab); loss=out.loss\r\n   else:\r\n    out=m(**inp,labels=lab); loss=out.loss\r\n   loss.backward(); opt.step(); opt.zero_grad()\r\n   print('bs',bs,'amp',amp,'step',j,'loss',float(loss.detach()),'time',round(time.time()-t,2), flush=True)\r\n  del m\r\nPY' timed out after 30 seconds\r\n"]
