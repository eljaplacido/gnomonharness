[1662.080379, "o", "\r\u001b[2KThe four-way objective is running unnecessarily slowly because it computes vocabulary logits at every sequence position. I’ll optimize it to compute the \r\nlanguage-model head only at the answer position, which should make experiments much faster.\r\n\r\n```\r\nkill $(cat /app/letter_ce.pid) 2>/dev/null || true; sleep 2; kill -9 $(cat /app/letter_ce.pid) 2>/dev/null || true; echo killed; tail -5 /app/letter_ce.log\r\ncat > /app/experiment_letter_ce_fast.py <<'PY'\r\nimport json, time, torch\r\nfrom peft import LoraConfig, TaskType, get_peft_model\r\nfrom transformers import AutoTokenizer, AutoModelForCausalLM\r\nBASE='openai-community/gpt2'\r\ntorch.set_num_threads(20)\r\ntok=AutoTokenizer.from_pretrained(BASE); tok.pad_token=tok.eos_token; tok.padding_side='left'\r\ntrain=json.load(open('/app/data/train.json')); val=json.load(open('/app/data/val.json'))\r\nletters='ABCD'; ids={c:tok(' '+c,add_special_tokens=False)['input_ids'][0] for c in letters}\r\nletter_ids=torch.tensor([ids[c] for c in letters])\r\ndef prompt(s): return f\"Qu"]
[1662.080403, "o", "estion: {s['question']}\\nOptions:\\n\"+'\\n'.join(s['options'])+\"\\nAnswer:\"\r\ndef enc(ss): return tok([prompt(s) for s in ss],padding=True,truncation=True,max_length=192,return_tensors='pt')\r\ntrain_e=enc(train); val_e=enc(val)\r\ntrain_y=torch.tensor(['ABCD'.index(s['answer']) for s in train]); val_y=torch.tensor(['ABCD'.index(s['answer']) for s in val])\r\nfreq=torch.bincount(train_y,minlength=4).float(); weights=len(train)/(4*freq); weights=weights/weights.mean(); print('weights',weights,flush=True)\r\nmodel=AutoModelForCausalLM.from_pretrained(BASE); model.config.use_cache=False\r\nmodel=get_peft_model(model,LoraConfig(r=8,lora_alpha=16,target_modules=['c_attn'],lora_dropout=0.05,bias='none',task_type=TaskType.CAUSAL_LM,fan_in_fan_out=True\r\n))\r\n# Access underlying GPT2 modules directly; LoRA layers remain active inside .transformer.\r\ncore=model.base_model.model\r\nopt=torch.optim.AdamW([p for p in model.parameters() if p.requires_grad],lr=5e-4,weight_decay=0.01)\r\nlossfn=torch.nn.CrossEntropyLoss(weight=weights)\r\ndef fwd"]
[1662.080484, "o", "(e,y):\r\n h=core.transformer(input_ids=e['input_ids'],attention_mask=e['attention_mask']).last_hidden_state[:,-1]\r\n logits=core.lm_head(h)[:,letter_ids]\r\n return lossfn(logits,y),logits.argmax(-1)\r\n@torch.no_grad()\r\ndef evalacc(bs=16):\r\n model.eval(); c=0\r\n for i in range(0,len(val),bs):\r\n  ee={k:v[i:i+bs] for k,v in val_e.items()}\r\n  _,p=fwd(ee,val_y[i:i+bs]); c+=(p==val_y[i:i+bs]).sum().item()\r\n model.train(); return c/len(val)\r\nbest=0\r\nfor epoch in range(1,11):\r\n model.train(); idx=torch.randperm(len(train)); total=0; t=time.time()\r\n for i in range(0,len(idx),8):\r\n  bi=idx[i:i+8]; ee={k:v[bi] for k,v in train_e.items()}\r\n  loss,p=fwd(ee,train_y[bi]); loss.backward(); opt.step(); opt.zero_grad()\r\n  total+=loss.item()*len(bi)\r\n acc=evalacc()\r\n print(f'epoch {epoch} loss {total/len(train):.4f} val {acc:.2%} time {time.time()-t:.1f}s',flush=True)\r\n if acc>best:\r\n  best=acc; model.save_pretrained('/app/experiments/letter_ce'); tok.save_pretrained('/app/experiments/letter_ce')\r\nprint('best',best)\r\nPY\r\ncd /app && "]
[1662.080492, "o", "rm -rf /app/experiments/letter_ce && HF_HOME=/app/.cache/huggingface nohup python -u /app/experiment_letter_ce_fast.py > /app/letter_ce.log 2>&1 & \r\necho $! > /app/letter_ce.pid; echo started\r\n```\r\n\u001b[32m⠴\u001b[0m Waiting for the LM to respond..."]
