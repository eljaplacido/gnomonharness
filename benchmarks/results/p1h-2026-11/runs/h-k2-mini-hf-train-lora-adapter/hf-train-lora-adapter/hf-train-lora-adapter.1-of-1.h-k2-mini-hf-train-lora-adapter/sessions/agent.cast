[49.140368, "o", "Required /app/lora_results.json schema:\r\n\u001b[?2004l\r\u001b[?2004h"]
[49.14038, "o", "> {\r\n\u001b[?2004l\r"]
[49.140394, "o", "\u001b[?2004h> "]
[49.140459, "o", "  \"model\": string,           // Base model name used (e.g., \"openai-community/gpt2\")\r\n\u001b[?2004l\r"]
[49.140471, "o", "\u001b[?2004h> "]
[49.140488, "o", "  \"lora_config\": {\r\n\u001b[?2004l\r"]
[49.140499, "o", "\u001b[?2004h> "]
[49.140539, "o", "    \"r\": number,            // LoRA rank (must be 8)\r\n\u001b[?2004l\r"]
