[984.402218, "o", "\r\u001b[2K\r\n\u001b[1;31mmini-swe-agent\u001b[0m\u001b[31m (step \u001b[0m\u001b[1;31m43\u001b[0m\u001b[31m, \u001b[0m\u001b[1;31m$0.00\u001b[0m\u001b[31m):\u001b[0m\r\n\u001b[32m⠸\u001b[0m Waiting for the LM to respond..."]
[984.413634, "o", "\r\u001b[2K```\r\ncd /app && python - <<'PY'\r\nimport json, torch, numpy as np\r\nfrom transformers import AutoTokenizer, AutoModelForCausalLM\r\nfrom peft import PeftModel\r\ntorch.set_num_threads(20)\r\ntok=AutoTokenizer.from_pretrained('/app/experiments/lora_adapter'); tok.pad_token=tok.eos_token; tok.padding_side='left'\r\nm=PeftModel.from_pretrained(AutoModelForCausalLM.from_pretrained('openai-community/gpt2'),'/app/experiments/lora_adapter').eval()\r\nval=json.load(open('/app/data/val.json'))\r\ndef prompt(s): return f\"Question: {s['question']}\\nOptions:\\n\"+'\\n'.join(s['options'])+\"\\nAnswer:\"\r\nids={c:tok(' '+c,add_special_tokens=False)['input_ids'][0] for c in 'ABCD'}\r\nL=[]\r\nwith torch.no_grad():\r\n for i in range(0,len(val),8):\r\n  ss=val[i:i+8]; e=tok([prompt(s) for s in ss],padding=True,truncation=True,max_length=256,return_tensors='pt')\r\n  lo=m(**e).logits[:,-1]\r\n  L.append(torch.stack([lo[:,ids[c]] for c in 'ABCD'],dim=1))\r\nL=torch.cat(L).numpy(); y=np.array(['ABCD'.index(s['answer']) for s in val])\r\nprint('mean logits', L"]
[984.41372, "o", ".mean(0))\r\ntrain=json.load(open('/app/data/train.json'))\r\nprint('train prior', np.bincount(['ABCD'.index(s['answer']) for s in train])/300)\r\n# standardize per letter using train? model trained same; use val unsupervised stats\r\nfor method, adj in [('none',np.zeros(4)),('val_mean',-L.mean(0)),('val_std',None),('train_prior_log',np.log(np.bincount([ 'ABCD'.index(s['answer']) for s in \r\ntrain])/300))]:\r\n if method=='val_std':\r\n  A=(L-L.mean(0))/L.std(0)\r\n elif method=='train_prior_log':\r\n  A=L-adj\r\n else: A=L+adj\r\n pred=A.argmax(1)\r\n print(method,'acc',(pred==y).mean(),'pred',np.bincount(pred,minlength=4))\r\n# rank of correct\r\nranks=(L>L[np.arange(len(y)),y][:,None]).sum(1)\r\nprint('ranks',np.bincount(ranks,minlength=4))\r\n# can we fit a simple per-sample length feature? top logit margin by longest?\r\nlongest=np.array([np.argmax([len(o) for o in s['options']]) for s in val])\r\nfor label,A in [('none',L),('cal',L-L.mean(0))]:\r\n pred=A.argmax(1)\r\n print('model pred==longest', (pred==longest).mean(), 'acc', (pred==y).mea"]
[984.413731, "o", "n())\r\n# Learn logistic regression (from val, optimistic) on per-option features: model logit + relative length etc\r\nfrom sklearn.linear_model import LogisticRegression\r\nPY\r\n```\r\n\u001b[32m⠸\u001b[0m Waiting for the LM to respond..."]
