[263.924804, "o", "\r\u001b[2K\r\n\u001b[1;31mmini-swe-agent\u001b[0m\u001b[31m (step \u001b[0m\u001b[1;31m13\u001b[0m\u001b[31m, \u001b[0m\u001b[1;31m$0.00\u001b[0m\u001b[31m):\u001b[0m\r\n\u001b[32m⠦\u001b[0m Waiting for the LM to respond..."]
[263.926308, "o", "\r\u001b[2K```\r\ncd /app && python - <<'PY'\r\nimport json,time,torch\r\nfrom transformers import AutoTokenizer, AutoModelForCausalLM\r\nfrom peft import LoraConfig,get_peft_model,TaskType\r\ntorch.set_num_threads(20)\r\ntok=AutoTokenizer.from_pretrained('openai-community/gpt2'); tok.pad_token=tok.eos_token\r\nd=json.load(open('/app/data/train.json'))[:32]\r\ntexts=[]\r\nfor s in d:\r\n p=f\"Question: {s['question']}\\nOptions:\\n\"+'\\n'.join(s['options'])+f\"\\nAnswer: {s['answer']}\"\r\n texts.append(p+tok.eos_token)\r\nenc=tok(texts,padding=True,truncation=True,max_length=256,return_tensors='pt')\r\nlabels=enc.input_ids.clone(); labels[enc.attention_mask==0]=-100\r\nfor i,s in enumerate(d):\r\n p=f\"Question: {s['question']}\\nOptions:\\n\"+'\\n'.join(s['options'])+\"\\nAnswer:\"\r\n plen=len(tok(p)['input_ids']); labels[i,:plen]=-100\r\nfor bs in [16,32]:\r\n for amp in [False,True]:\r\n  m=AutoModelForCausalLM.from_pretrained('openai-community/gpt2')\r\n  m=get_peft_model(m,LoraConfig(r=8,lora_alpha=16,target_modules=['c_attn'],task_type=TaskType.CAUSAL_LM,lora_d"]
[263.926339, "o", "ropout=0.05,fan_in_fan_out=True))\r\n  opt=torch.optim.AdamW([p for p in m.parameters() if p.requires_grad],lr=5e-4)\r\n  inp={k:v[:bs] for k,v in enc.items()}; lab=labels[:bs]\r\n  m.train()\r\n  for j in range(2):\r\n   t=time.time()\r\n   if amp:\r\n    with torch.autocast('cpu',dtype=torch.bfloat16):\r\n     out=m(**inp,labels=lab); loss=out.loss\r\n   else:\r\n    out=m(**inp,labels=lab); loss=out.loss\r\n   loss.backward(); opt.step(); opt.zero_grad()\r\n   print('bs',bs,'amp',amp,'step',j,'loss',float(loss.detach()),'time',round(time.time()-t,2), flush=True)\r\n  del m\r\nPY\r\n```\r\n\u001b[32m⠦\u001b[0m Waiting for the LM to respond..."]
