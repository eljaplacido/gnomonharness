[1246.635392, "o", "\r\u001b[2K\r\n\u001b[1;31mmini-swe-agent\u001b[0m\u001b[31m (step \u001b[0m\u001b[1;31m52\u001b[0m\u001b[31m, \u001b[0m\u001b[1;31m$0.00\u001b[0m\u001b[31m):\u001b[0m\r\n\u001b[32m⠋\u001b[0m Waiting for the LM to respond..."]
[1246.639739, "o", "\r\u001b[2KBase GPT-2 already reaches 42% on validation using length-normalized option-content likelihood. I’ll now test a class-balanced four-way letter objective, which \r\nshould avoid the prior collapse seen with full-vocabulary language-model loss.\r\n\r\n```\r\ncat > /app/experiment_letter_ce.py <<'PY'\r\nimport argparse, json, math, random, time\r\nfrom pathlib import Path\r\nimport torch\r\nfrom peft import LoraConfig, TaskType, get_peft_model\r\nfrom transformers import AutoTokenizer, AutoModelForCausalLM\r\n\r\nBASE='openai-community/gpt2'\r\ntok=AutoTokenizer.from_pretrained(BASE); tok.pad_token=tok.eos_token; tok.padding_side='left'\r\ntrain=json.load(open('/app/data/train.json')); val=json.load(open('/app/data/val.json'))\r\nletters='ABCD'; ids={c:tok(' '+c,add_special_tokens=False)['input_ids'][0] for c in letters}\r\ndef prompt(s): return f\"Question: {s['question']}\\nOptions:\\n\"+'\\n'.join(s['options'])+\"\\nAnswer:\"\r\n# encode prompts\r\ndef enc_prompts(ss, maxlen=192):\r\n return tok([prompt(s) for s in ss],padding=True,truncation=Tr"]
[1246.639824, "o", "ue,max_length=maxlen,return_tensors='pt')\r\ntrain_e=enc_prompts(train); val_e=enc_prompts(val)\r\ntrain_y=torch.tensor(['ABCD'.index(s['answer']) for s in train])\r\nval_y=torch.tensor(['ABCD'.index(s['answer']) for s in val])\r\nletter_ids=torch.tensor([ids[c] for c in letters])\r\n# class weights inverse train freq\r\nfreq=torch.bincount(train_y,minlength=4).float(); weights=(len(train)/ (4*freq)); weights=weights/weights.mean(); print('freq',freq,'weights',weights, \r\nflush=True)\r\n\r\ntorch.set_num_threads(20)\r\nmodel=AutoModelForCausalLM.from_pretrained(BASE); model.config.use_cache=False\r\nmodel=get_peft_model(model,LoraConfig(r=8,lora_alpha=16,target_modules=['c_attn'],lora_dropout=0.05,bias='none',task_type=TaskType.CAUSAL_LM,fan_in_fan_out=True\r\n))\r\nopt=torch.optim.AdamW([p for p in model.parameters() if p.requires_grad],lr=5e-4,weight_decay=0.01)\r\nlossfn=torch.nn.CrossEntropyLoss(weight=weights)\r\n\r\ndef batch_forward(e, y, train_mode=True):\r\n out=model(**e).logits[:,-1,:]\r\n logits=out[:,letter_ids]\r\n loss=lossfn(logi"]
[1246.639986, "o", "ts,y)\r\n pred=logits.argmax(-1)\r\n return loss,pred\r\n\r\n@torch.no_grad()\r\ndef eval_acc(e,y,bs=16):\r\n model.eval(); correct=0\r\n for i in range(0,len(y),bs):\r\n  ee={k:v[i:i+bs] for k,v in e.items()}\r\n  _,pred=batch_forward(ee,y[i:i+bs],False)\r\n  correct+=(pred==y[i:i+bs]).sum().item()\r\n model.train(); return correct/len(y)\r\n\r\nbest=0\r\nfor epoch in range(1,8):\r\n model.train(); idx=torch.randperm(len(train))\r\n total=0; n=0; t=time.time()\r\n opt.zero_grad()\r\n for i in range(0,len(idx),8):\r\n  bi=idx[i:i+8]\r\n  ee={k:v[bi] for k,v in train_e.items()}\r\n  loss,pred=batch_forward(ee,train_y[bi])\r\n  loss.backward(); opt.step(); opt.zero_grad()\r\n  total+=loss.item()*len(bi); n+=len(bi)\r\n acc=eval_acc(val_e,val_y)\r\n print(f'epoch {epoch} loss {total/n:.4f} val {acc:.2%} time {time.time()-t:.1f}s',flush=True)\r\n if acc>best:\r\n  best=acc\r\n  model.save_pretrained('/app/experiments/letter_ce')\r\n  tok.save_pretrained('/app/experiments/letter_ce')\r\nPY\r\ncd /app && rm -rf /app/experiments/letter_ce && HF_HOME=/app/.cache/huggingface noh"]
[1246.640004, "o", "up python -u /app/experiment_letter_ce.py > /app/letter_ce.log 2>&1 & echo $!\r\n> /app/letter_ce.pid; echo started\r\n```\r\n\u001b[32m⠋\u001b[0m Waiting for the LM to respond..."]
