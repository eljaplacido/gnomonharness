[64.262308, "o", "\r\u001b[2K```\r\npython - <<'PY'\r\nimport json, collections, statistics\r\nfor split in ['train','val']:\r\n    d=json.load(open(f'/app/data/{split}.json'))\r\n    print(split, len(d), 'answers', collections.Counter(x['answer'] for x in d))\r\n    print('fewshot', collections.Counter(x.get('is_few_shot') for x in d))\r\n    print('option prefixes', collections.Counter(o[:2] for x in d for o in x['options']))\r\n    print('q len', statistics.mean(len(x['question']) for x in d), max(len(x['question']) for x in d))\r\n    print('opt lens', statistics.mean(sum(len(o) for o in x['options']) for x in d), max(sum(len(o) for o in x['options']) for x in d))\r\n    print('ids', min(x['id'] for x in d), max(x['id'] for x in d))\r\n    print('first', json.dumps(d[0],indent=2)[:800])\r\nPY\r\n```\r\n\u001b[32m⠏\u001b[0m Waiting for the LM to respond..."]
