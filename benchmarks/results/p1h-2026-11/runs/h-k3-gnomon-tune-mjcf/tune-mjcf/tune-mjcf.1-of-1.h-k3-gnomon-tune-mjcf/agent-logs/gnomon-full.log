import mujoco, numpy as np, time
FULL = mujoco.mjtState.mjSTATE_FULLPHYSICS
def run(m, seed, track=False):
    d = mujoco.MjData(m)
    n = int(2.0/m.opt.timestep)
    rng = np.random.default_rng(seed)
    d.qpos += rng.normal(0,0.01,size=d.qpos.shape)
    mujoco.mj_forward(m,d)
    mx = 0
    t0=time.perf_counter()
    for _ in range(n):
        mujoco.mj_step(m,d)
        if track: mx=max(mx,int(d.solver_niter[0]))
    t=time.perf_counter()-t0
    st=np.zeros(mujoco.mj_stateSize(m,FULL)); mujoco.mj_getState(m,d,st,FULL)
    return st, t, mx
ref = mujoco.MjModel.from_xml_path("model_ref.xml")
for cand in ["cand/pgs_i100.xml","cand/d_tol0.xml","cand/pgs_dense_ls0.xml"]:
    m = mujoco.MjModel.from_xml_path(cand)
    diffs=[]; ts=[]; nits=[]
    for seed in [0,7,13,42,101,555,999,1234,4321,7777,9999]:
        st,t,nit = run(m,seed,track=True)
        sr,_,_ = run(ref,seed)
        diffs.append(np.abs(st-sr).max()); ts.append(t); nits.append(nit)
    print(f"{cand}: maxdiff={max(diffs):.2e} maxniter={max(nits)} t_mean={np.mean(ts)*1e3:.1f} t_max={max(ts)*1e3:.1f}")
