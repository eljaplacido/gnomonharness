    s = src
    if opt: s = s.replace('<compiler autolimits="true"/>', '<compiler autolimits="true"/>\n  <option %s/>'%opt)
    if flag: s = s.replace('<compiler autolimits="true"/>', '<compiler autolimits="true"/>\n  <option><flag %s/></option>'%flag)
    if geomattr: s = s.replace('<geom type="capsule"', '<geom %s type="capsule"'%geomattr).replace('<geom size=".01"/>','<geom %s size=".01"/>'%geomattr)
    p="/tmp/t.xml"; open(p,"w").write(s); return p
def bench(p, n=400, label=""):
    m = mujoco.MjModel.from_xml_path(p); d=mujoco.MjData(m)
    mujoco.mj_step(m,d)
    for t in range(15): d.timer[t].duration=0; d.timer[t].number=0
    for _ in range(n): mujoco.mj_step(m,d)
    g=lambda i: d.timer[i].duration/n*1e6
    print(f"{label:28s} step={g(0):7.2f} pos={g(3):6.2f} coll={g(9):6.2f} constr={g(6):6.2f} adv={g(7):6.2f} niter={d.solver_niter[0]}")
