def step(): mujoco.mj_step(m,d)
print("baseline step", bench(step))
# disable constraint
m.opt.disableflags |= int(mujoco.mjtDisableBit.mjDSBL_CONSTRAINT)
d2 = mujoco.MjData(m)
print("no constraint step", bench(lambda: mujoco.mj_step(m,d2)))
m.opt.disableflags &= ~int(mujoco.mjtDisableBit.mjDSBL_CONSTRAINT)
# solver variants
