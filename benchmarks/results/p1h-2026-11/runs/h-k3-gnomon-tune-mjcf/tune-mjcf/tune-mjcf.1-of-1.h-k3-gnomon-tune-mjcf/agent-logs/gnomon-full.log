import mujoco, numpy as np, time
NAMES={0:'STEP',1:'FORWARD',3:'POSITION',4:'VELOCITY',6:'CONSTRAINT',7:'ADVANCE',8:'POS_KIN',9:'POS_INERTIA',10:'POS_COLL',11:'POS_MAKE',12:'POS_PROJECT',13:'COL_BROAD',14:'COL_NARROW'}
def prof(path,n=600,label=""):
    m=mujoco.MjModel.from_xml_path(path); d=mujoco.MjData(m)
    mujoco.mj_step(m,d)
    for t in range(15): d.timer[t].duration=0; d.timer[t].number=0
    for _ in range(n): mujoco.mj_step(m,d)
    tot=d.timer[0].duration/n*1e6
    parts={NAMES.get(t,str(t)):d.timer[t].duration/d.timer[t].number*1e6 for t in range(15) if d.timer[t].number and d.timer[t].duration}
    print(f"{label:16s} tot={tot:6.1f} " + " ".join(f"{k}={v:.1f}" for k,v in parts.items() if v>0.5))
src=open("model_ref.xml").read()
def mk(name,opt):
    s=src.replace('<compiler autolimits="true"/>','<compiler autolimits="true"/>\n  <option %s/>'%opt)
    p=f"cand/{name}.xml"; open(p,"w").write(s); return p
base="solver='PGS' jacobian='dense' tolerance='0' iterations='100'"
prof(mk("f_euler", base), label="euler")
prof(mk("f_implfast", base+" integrator='implicitfast'"), label="implicitfast")
prof(mk("f_impl", base+" integrator='implicit'"), label="implicit")
prof("model_ref.xml", label="ref")
