import mujoco, numpy as np, time
NAMES = {0:'STEP',1:'FORWARD',2:'INVERSE',3:'POSITION',4:'VELOCITY',5:'ACTUATION',6:'CONSTRAINT',7:'ADVANCE',8:'POS_KIN',9:'POS_COLL',10:'POS_INERTIA',11:'POS_MAKE',12:'POS_PROJECT',13:'VEL_INERTIA',14:'VEL_REF'}
def prof(path, n=400, label=""):
    m = mujoco.MjModel.from_xml_path(path)
    d = mujoco.MjData(m)
    mujoco.mj_resetData(m,d)
    mujoco.mj_step(m,d)
    for t in range(15): d.timer[t].duration=0; d.timer[t].number=0
    nc=0
    for _ in range(n):
        mujoco.mj_step(m,d)
        nc=max(nc,d.ncon)
    print(f"--- {label} {path} ncon_max={nc} solver_niter={d.solver_niter[0]}")
    tot = d.timer[0].duration/n*1e6
    for t in range(15):
        v=d.timer[t]
        if v.number: print(f"   {NAMES[t]:12s} {v.duration/v.number*1e6:8.2f} us  frac={v.duration/v.number*1e6/tot*100:5.1f}%")
prof("model_ref.xml", label="ref")
prof("cand/c_pgs.xml", label="pgs")
prof("cand/c_dense_pgs.xml", label="dense_pgs")
