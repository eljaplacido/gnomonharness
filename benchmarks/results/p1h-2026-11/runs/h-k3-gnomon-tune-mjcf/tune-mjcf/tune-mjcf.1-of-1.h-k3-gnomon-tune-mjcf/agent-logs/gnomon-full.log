bench(mk("solver='PGS'", "contact='disable'"), label="PGS+contactdisable")
bench(mk("solver='PGS'", "", "contype='0' conaffinity='0'"), label="PGS+contype0")
bench(mk("solver='PGS' jacobian='dense'", "", "contype='0' conaffinity='0'"), label="PGS dense contype0")
# damping zero (physics change; measurement only)
s = src.replace('damping=".015"','damping="0"').replace('damping=".1"','damping="0"')
open("/tmp/nodamp.xml","w").write(s.replace('<compiler autolimits="true"/>','<compiler autolimits="true"/>\n  <option solver="PGS"/>'))
bench("/tmp/nodamp.xml", label="PGS nodamping(measure)")
