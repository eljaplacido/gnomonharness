[870.336669, "o", "\u001b[0m$ \u001b[0mcd /tmp/opencode/filebuild/berkeley_upc-2022.10.0 && ls -la dbg/upcr_getopt.pl opt/upcr_getopt.pl upcr_getopt.pl 2>&1; sed -n '1655,1670p' dbg/Makefile | cat -A | head -20\r\n-rw-r--r-- 1 root  root 62349 Nov  1 05:16 dbg/upcr_getopt.pl\r\n-rw-r--r-- 1 root  root 62349 Nov  1 05:16 opt/upcr_getopt.pl\r\n-rw-r--r-- 1 19214 5513 62349 Oct 28  2022 upcr_getopt.pl\r\nupcc: $(top_builddir)/gasnet/other/perlstart upcc.pl $(perl_libs)$\r\nupcrun: $(top_builddir)/gasnet/other/perlstart upcrun.pl $(perl_libs)$\r\n$\r\nupc_trace: force$\r\n^I@$(MAKE) -C $(top_builddir)/gasnet/other/contrib gasnet_trace$\r\n^I@rm -f $@$\r\n^Iln -s $(top_builddir)/gasnet/other/contrib/gasnet_trace $@$\r\n$(files_we_copy): force$\r\n^I@srcfile=\"$(srcdir)/`basename $@`\" ; \\$\r\n         if test ! -f \"$@\" -o \"`find $$srcfile -newer '$@' 2>&1`\" ; then \\$\r\n          echo cp -f \"$$srcfile\" . ;         \\$\r\n          cp -f \"$$srcfile\" . ;              \\$\r\n         fi$\r\n#gcc_as_cc.mak: $(srcdir)/gcc_as_cc.pl$\r\n#^I$\r\n$\r\n"]
