[710.453866, "o", "\u001b[0m$ \u001b[0mcd /tmp/opencode/berkeley_upc-2022.10.0 && grep -n \"gasnet.*configure\\|GASNET.*ARGS\\|gasnet-config\" configure | head -60\r\n3824:  eval gasnet_fn_env_argnorm $upcr_cv_configure_args\r\n3974:    eval gasnet_fn_env_helper CC cc $upcr_cv_configure_args_norm\r\n4139:    eval gasnet_fn_env_helper CFLAGS cflags $upcr_cv_configure_args_norm\r\n4304:    eval gasnet_fn_env_helper CPP cpp $upcr_cv_configure_args_norm\r\n4469:    eval gasnet_fn_env_helper CPPFLAGS cppflags $upcr_cv_configure_args_norm\r\n4634:    eval gasnet_fn_env_helper LDFLAGS ldflags $upcr_cv_configure_args_norm\r\n4799:    eval gasnet_fn_env_helper LIBS libs $upcr_cv_configure_args_norm\r\n4963:    eval gasnet_fn_env_helper PERL perl $upcr_cv_configure_args_norm\r\n7445:#           gasnet's configure dies complaining that CC wasn't set in the last\r\n8270:    eval gasnet_fn_env_helper CROSS_SIZEOF_VOID_P crosssizeofvoidp $upcr_cv_configure_args_norm\r\n9747:    eval gasnet_fn_env_helper CROSS_SIZEOF_VOID_P crosssizeofvoidp $upcr_cv_configure_args_norm\r\n16214:    eval gasnet_fn_env_helper HOST_CC hostcc $upcr_cv_configure_args_norm\r\n16370:    eval gasnet_fn_env_helper HOST_CFLAGS hostcflags $upcr_cv_configure_args_norm\r\n16526:    eval gasnet_fn_env_helper HOST_LDFLAGS hostldflags $upcr_cv_configure_args_norm\r\n16682:    eval gasnet_fn_env_helper HOST_LIBS hostlibs $upcr_cv_configure_args_norm\r\n24945:    eval gasnet_fn_env_helper CROSS_SIZEOF_VOID_P crosssizeofvoidp $upcr_cv_configure_args_norm\r\n27684:    eval gasnet_fn_env_helper CROSS_SIZEOF_LONG crosssizeoflong $upcr_cv_configure_args_norm\r\n31928:    eval gasnet_fn_env_helper CROSS_SIZEOF_CHAR crosssizeofchar $upcr_cv_configure_args_norm\r\n32671:    eval gasnet_fn_env_helper CROSS_SIZEOF_SHORT crosssizeofshort $upcr_cv_configure_args_norm\r\n33414:    eval gasnet_fn_env_helper CROSS_SIZEOF_INT crosssizeofint $upcr_cv_configure_args_norm\r\n34155:    eval gasnet_fn_env_helper CROSS_SIZEOF_LONG cross