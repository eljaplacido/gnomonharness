[220.905718, "o", "\u001b[0m← \u001b[0mEdit pgen.upc\r\nIndex: pgen.upc\r\n===================================================================\r\n--- pgen.upc\r\n+++ pgen.upc\r\n@@ -160,18 +160,21 @@\r\n         globfree(&gl);\r\n     }\r\n     upc_barrier;\r\n \r\n+    if (THREADS > MAXTHREADS) {\r\n+        fprintf(stderr, \"too many UPC threads (max %d)\\n\", MAXTHREADS);\r\n+        return 1;\r\n+    }\r\n+\r\n     fp = fopen(infile, \"r\");\r\n     if (!fp) {\r\n         fprintf(stderr, \"thread %d: cannot open %s\\n\", MYTHREAD, infile);\r\n         return 1;\r\n     }\r\n-    if (stat(infile, &st) != 0) {\r\n-        fprintf(stderr, \"thread %d: cannot stat %s\\n\", MYTHREAD, infile);\r\n-        return 1;\r\n-    }\r\n-    size = (long)st.st_size;\r\n+    fseek(fp, 0, SEEK_END);\r\n+    size = ftell(fp);\r\n+    rewind(fp);\r\n \r\n     /* All threads derive k from the first line. */\r\n     if (fgets(first, sizeof(first), fp) == NULL) {\r\n         g_K = 0;\r\n\r\n"]
