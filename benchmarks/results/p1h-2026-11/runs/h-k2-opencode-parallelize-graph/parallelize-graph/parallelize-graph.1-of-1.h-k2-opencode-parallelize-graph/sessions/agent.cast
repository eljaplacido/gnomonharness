[230.546489, "o", "\u001b[0m$ \u001b[0mupcc -version 2>&1 | tail -30; echo '---'; upcc -show-confs 2>&1 | head -40; echo '---'; ls /usr/local/opt/bin | head -30; /usr/local/opt/bin/upcrun -version 2>&1 | head -30\r\nBinary interface     | 64-bit aarch64-unknown-linux-gnu\r\n----------------------+---------------------------------------------------------\r\n Runtime interface #  | Runtime supports 3.0 -> 3.14: Translator uses 3.6\r\n----------------------+---------------------------------------------------------\r\n                      |  --- BACKEND SETTINGS (for udp network) ---\r\n----------------------+---------------------------------------------------------\r\n C compiler           | /usr/bin/gcc\r\n                      |   GNU/13.3.0/13.3.0\r\n                      |   gcc (Ubuntu 13.3.0-6ubuntu2~24.04.1) 13.3.0 Copyright\r\n                      |   (C) 2023 Free Software Foundation, Inc.\r\n----------------------+---------------------------------------------------------\r\n C compiler flags     | -O3 --param max-inline-insns-single=35000 --param\r\n                      | inline-unit-growth=10000 --param\r\n                      | large-function-growth=200000 -Wno-array-bounds\r\n                      | -Wno-stringop-overflow -Wno-dangling-pointer\r\n                      | -Wno-use-after-free -Wno-unused -Wunused-result\r\n                      | -Wno-unused-parameter -Wno-address\r\n----------------------+---------------------------------------------------------\r\n linker               | /usr/bin/g++\r\n                      |   GNU/13.3.0/13.3.0\r\n                      |   g++ (Ubuntu 13.3.0-6ubuntu2~24.04.1) 13.3.0 Copyright\r\n                      |   (C) 2023 Free Software Foundation, Inc.\r\n----------------------+---------------------------------------------------------\r\n linker flags         | -O2 -Wno-array-bounds -Wno-stringop-overflow\r\n                      | -Wno-dangling-pointer -Wno-use-after-free -Wno-unused\r\n                      | -Wunused-result -Wno-unused-parameter -Wno-address\r\n                      | -L/usr/local/opt/lib -lupcr-udp-seq -lumalloc\r\n                      | -L/usr/local/opt/lib -lgasnet-udp-seq -lamudp\r\n                      | -L/usr/lib/gcc/aarch64-linux-gnu/13 -lgcc -lm\r\n----------------------+---------------------------------------------------------\r\n---\r\nMulticonfs enabled in /usr/local/etc/multiconf.conf:\r\ndbg ;  --with-translator=\"$BUPC_TRANS\" --enable-debug  ; $opt{'g'}  ; -bupc\r\nopt ;  --with-translator=\"$BUPC_TRANS\"  ; 1  ; -bupc\r\n---\r\namudprun\r\ngasnet_trace\r\ngasnet_trace.pl\r\nupc_trace\r\nupcc\r\nupcc.pl\r\nupcdecl\r\nupcdecl.pl\r\nupcrun\r\nupcrun.pl\r\nThis is upcrun, job spawner for the Berkeley UPC compiler (https://upc.lbl.gov).\r\nupcrun version 2022.10.0\r\nNetwork conduits supported by this installation: smp udp\r\n"]
