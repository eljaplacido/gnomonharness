[685.465592, "o", "\u001b[0m$ \u001b[0mcd /app && for t in 12 16 20; do echo \"--- $t (1MB) ---\"; rm -f pgen_*.out; timeout 60 upcrun -n $t -shared-heap 1MB /app/pgen /app/test > /tmp/opencode/run${t}b.log 2>&1; echo exit=$?; head -3 /tmp/opencode/run${t}b.log; ls pgen_*.out 2>/dev/null | wc -l; cat pgen_*.out 2>/dev/null | sort > /tmp/opencode/q$t.sorted; diff -q /tmp/opencode/serial.sorted /tmp/opencode/q$t.sorted && echo MATCH$t; done\r\n--- 12 (1MB) ---\r\n/bin/bash: line 1: 34013 Aborted                 timeout 60 upcrun -n $t -shared-heap 1MB /app/pgen /app/test > /tmp/opencode/run${t}b.log 2>&1\r\nexit=134\r\n*** FATAL ERROR (proc 9): in gasnetc_init() at berkeley_upc-2022.10.0/gasnet/smp-conduit/gasnet_core.c:609: per-host segment limit 16736256 is too small to accommodate 12 aux segments, total size 25165824. You may need to adjust OS shared memory limits.\r\n*** NOTICE (proc 9): Before reporting bugs, run with GASNET_BACKTRACE=1 in the environment to generate a backtrace.\r\n*** NOTICE (proc 9): We recommend linking the debug version of GASNet to assist you in resolving this application issue.\r\n0\r\nFiles /tmp/opencode/serial.sorted and /tmp/opencode/q12.sorted differ\r\n--- 16 (1MB) ---\r\n/bin/bash: line 1: 34050 Bus error               timeout 60 upcrun -n $t -shared-heap 1MB /app/pgen /app/test > /tmp/opencode/run${t}b.log 2>&1\r\nexit=135\r\n0\r\nFiles /tmp/opencode/serial.sorted and /tmp/opencode/q16.sorted differ\r\n--- 20 (1MB) ---\r\n/bin/bash: line 1: 34091 Bus error               timeout 60 upcrun -n $t -shared-heap 1MB /app/pgen /app/test > /tmp/opencode/run${t}b.log 2>&1\r\nexit=135\r\n0\r\nFiles /tmp/opencode/serial.sorted and /tmp/opencode/q20.sorted differ\r\n"]
