[119.565003, "o", "\u001b[0m$ \u001b[0mcd /tmp/opencode/berkeley_upc-2022.10.0 && grep -rn \"upc_lock_init\\|typedef.*upc_lock_t\\|upc_all_lock_alloc\" --include=*.h --include=*.c --include=*.txt . | head -40\r\n./docs/html/system/upcr.txt:1548:    - upc_lock_init() is no longer necessary or useful and is removed\r\n./docs/html/system/upcr.txt:2108:#define upc_all_lock_alloc      upcr_all_lock_alloc\r\n./upcr.h:498:  #define upc_all_lock_alloc      upcr_all_lock_alloc\r\n./profile/gasp_upc.h:9:typedef void gasp_upc_lock_t;\r\n./upcr_locks.h:25: *   - upc_lock_init() is no longer necessary or useful and is removed\r\n./upc-tests/uts/upc_worksharing.c:280:\tcb_lock = upc_all_lock_alloc();\r\n./upc-tests/uts/upc_worksharing.c:295:\tgq_lock = upc_all_lock_alloc();\r\n./upc-tests/uts/uts_upc_enhanced.c:49:#define INIT_SINGLE_LOCK(zlk) zlk=upc_all_lock_alloc()\r\n./upc-tests/uts/uts_shm.c:79:#define INIT_SINGLE_LOCK(zlk) zlk=upc_all_lock_alloc()\r\n./upc-tests/UPC-Coll-RefImp/upc_all_reduce.c:300:\tdst_lock = upc_all_lock_alloc();\r\n./upc-tests/mupc/test_locks2.c:6:\tFunction tested: upc_global_lock_alloc, upc_lock_init, upc_lock, upc_unlock\r\n./upc-tests/mupc/test_locks2.c:9:\t- Tests the correctness of upc_global_alloc. Also test if upc_lock_init, upc_lock,\r\n./upc-tests/mupc/test_locks2.c:61:\t\tupc_lock_init(lock_1);\r\n./upc-tests/mupc/test_locks2.c:62:\t\tupc_lock_init(lock_2);\r\n./upc-tests/mupc/test_locks1.c:1:/* _test_locks1.c: test the use of upc_all_lock_alloc and other locking mechanisms.\r\n./upc-tests/mupc/test_locks1.c:6:\tFunction tested: upc_all_lock_alloc, upc_lock_init, upc_lock, upc_unlock\r\n./upc-tests/mupc/test_locks1.c:9:\t- Allocate locks using the colelctive upc_all_lock_alloc function.\r\n./upc-tests/mupc/test_locks1.c:33:\t\t    upc_all_lock_alloc() needs to be initialized explicitly \r\n./upc-tests/mupc/test_locks1.c:34:\t\t    using upc_lock_init.\r\n./upc-tests/mupc/test_locks1.c:53:\tlock1 = upc_all_lock_alloc(); /* Allocate lock using collective method */\r\n./upc-tests/mupc/test_locks1.c:55:\tupc_lock_init(lock1); /* Initialize lock */ \r\n./upc-tests/mupc/test_locks4.c:6:\tFunction tested: upc_global_lock_alloc, upc_lock_init, upc_lock, upc_unlock\r\n./upc-tests/mupc/test_locks4.c:67:\t\tupc_lock_init(lock_1);\r\n./upc-tests/mupc/test_locks3.c:6:\tFunction tested: upc_all_lock_alloc, upc_lock_init, upc_lock_attempt, upc_unlock\r\n./upc-tests/mupc/test_locks3.c:53:\tlock_1 = upc_all_lock_alloc();\r\n./upc-tests/mupc/test_locks3.c:55:\tupc_lock_init(lock_1);\r\n./upc-tests/mupc/test_int_multilocks.c:6:        Function tested: upc_all_alloc, upc_memset, up_all_lock_alloc, upc_lock_init, upc_lock, upc_unlock\r\n./upc-tests/mupc/test_int_multilocks.c:32:\t[10/3/2002] Bug reported to programmer. Problem might lie with upc_lock_init and \r\n./upc-tests/mupc/test_int_multilocks.c:35:\t\t    1st: upc_all_lock_alloc, 2nd: upc_all_alloc.\r\n./upc-tests/mupc/test_int_multilocks.c:61:\tlock_1 = upc_all_lock_alloc();\r\n./upc-tests/mupc/test_int_multilocks.c:62:\tlock_2 = upc_all_lock_alloc();\r\n./upc-tests/mupc/test_int_multilocks.c:63:\tlock_3 = upc_all_lock_alloc();\r\n./upc-tests/mupc/test_int_multilocks.c:65:\tupc_lock_init(lock_1);\r\n./upc-tests/mupc/test_int_multilocks.c:66:\tupc_lock_init(lock_2);\r\n./upc-tests/mupc/test_int_multilocks.c:67:\tupc_lock_init(lock_3);\r\n./upc-tests/mupc/test_locks5.c:1:/* _test_locks5.c: test of implied synchronization of upc_all_lock_alloc. \r\n./upc-tests/mupc/test_locks5.c:6:\tFunction tested: upc_all_lock_alloc\r\n./upc-tests/mupc/test_locks5.c:10:\t  the collective lock allocation function - upc_all_lock_alloc.\r\n./upc-tests/mupc/test_locks5.c:27:/* bug 1281: this test is invalid, because upc_all_lock_alloc is NOT specified to \r\n./upc-tests/mupc/test_locks5.c:52:\tlock_1 = upc_all_lock_alloc();\r\n"]
