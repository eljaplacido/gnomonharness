[128.936314, "o", "\u001b[0m$ \u001b[0mcd /tmp/opencode/berkeley_upc-2022.10.0 && find . -iname '*atomic*' | head -30 && grep -rn \"upc_atomic\\|shared int.*CAS\\|compare_and_swap\" docs/html/system/*.txt | head -20\r\n./upcr_atomic.h\r\n./upcr_atomic.c\r\n./gasnet/extended-ref/ratomic\r\n./gasnet/extended-ref/ratomic/gasnet_ratomic.h\r\n./gasnet/extended-ref/ratomic/gasnet_refratomic.h\r\n./gasnet/extended-ref/ratomic/gasnet_ratomic_fwd.h\r\n./gasnet/extended-ref/ratomic/gasnet_refratomic.c\r\n./gasnet/extended-ref/ratomic/gasnet_ratomic_internal.h\r\n./gasnet/tests/testratomic.c\r\n./gasnet/gasnet_atomic_bits.h\r\n./gasnet/gasnet_atomic_fwd.h\r\n./gasnet/ucx-conduit/gasnet_ratomic_fwd.h\r\n./gasnet/ucx-conduit/gasnet_ratomic.c\r\n./gasnet/aries-conduit/gasnet_ratomic_fwd.h\r\n./gasnet/aries-conduit/gasnet_ratomic.c\r\n./gasnet/gasnet_atomicops.h\r\n./upc-tests/spec1.3/atomic_s_access.upc\r\n./upc-tests/spec1.3/atomic_s_bitwise.upc\r\n./upc-tests/spec1.3/atomic_cswap_pts.upc\r\n./upc-tests/spec1.3/atomic_s_arith.upc\r\n./upc-tests/spec1.3/atomic_r_arith.upc\r\n./upc-tests/spec1.3/atomic_r_access.upc\r\n./upc-tests/spec1.3/atomic_neg_pts.upc\r\n./upc-tests/spec1.3/atomic_test.upc\r\n./upc-tests/spec1.3/atomic_r_access_pts.upc\r\n./upc-tests/spec1.3/atomic_err.upc\r\n./upc-tests/spec1.3/atomic_neg_bitwise.upc\r\n./upc-tests/spec1.3/atomic_r_bitwise.upc\r\n./upc-tests/spec1.3/atomic_neg_arith.upc\r\n./upc-tests/spec1.3/atomic_s_access_pts.upc\r\n"]
