[690.208902, "o", "\u001b[0m$ \u001b[0mcd /tmp/opencode/berkeley_upc-2022.10.0/gasnet/smp-conduit && grep -rn \"shm_open\\|/dev/shm\\|SEGMENT\\|per-host segment limit\\|GASNET.*SHM\" . | head -60\r\n./Makefile.am:65:CONDUIT_RUNCMD = @ENVCMD@ GASNET_PSHM_NODES=%N %P %A\r\n./gasnet_core.h:136:#if GASNET_PSHM\r\n./Makefile.in:324:GASNET_PSHM_CFLAGS = @GASNET_PSHM_CFLAGS@\r\n./Makefile.in:325:GASNET_PSHM_ENABLED = @GASNET_PSHM_ENABLED@\r\n./Makefile.in:326:GASNET_PSHM_LDFLAGS = @GASNET_PSHM_LDFLAGS@\r\n./Makefile.in:327:GASNET_PSHM_LIBS = @GASNET_PSHM_LIBS@\r\n./Makefile.in:562:@USE_PSHM_TRUE@CONDUIT_RUNCMD = @ENVCMD@ GASNET_PSHM_NODES=%N %P %A\r\n./gasnet_extended_fwd.h:29:#if GASNET_PSHM\r\n./gasnet_extended_fwd.h:30:#define GASNETE_COLL_CONDUIT_BARRIERS GASNETE_COLL_BARRIER_PSHM\r\n./gasnet_extended_fwd.h:31:#define GASNETE_BARRIER_DEFAULT \"PSHM\"\r\n./gasnet_extended_fwd.h:33:    if(GASNETE_ISBARRIER(\"PSHM\")) gasnete_coll_default_barrier_type = GASNETE_COLL_BARRIER_PSHM; \\\r\n./gasnet_extended_fwd.h:36:    if ((TYPE) == GASNETE_COLL_BARRIER_PSHM &&              \\\r\n./gasnet_extended_fwd.h:41:#endif /* GASNET_PSHM */\r\n./gasnet_core.c:36:  #if GASNET_PSHM\r\n./gasnet_core.c:46:  #if GASNET_PSHM\r\n./gasnet_core.c:65:  #if GASNET_PSHM\r\n./gasnet_core.c:77:#if GASNET_PSHM\r\n./gasnet_core.c:406:#if GASNET_PSHM\r\n./gasnet_core.c:442:  gex_Rank_t nodes = gasneti_getenv_int_withdefault(\"GASNET_PSHM_NODES\", 0, 0);\r\n./gasnet_core.c:445:  if (nodes > GASNETI_PSHM_MAX_NODES) { \r\n./gasnet_core.c:447:                       GASNETI_PSHM_MAX_NODES);\r\n./gasnet_core.c:449:    gasneti_console_message(\"WARNING\",\"GASNET_PSHM_NODES not specified: running with 1 process\");\r\n./gasnet_core.c:472:#if GASNET_PSHM\r\n./gasnet_core.c:495:#if GASNET_PSHM\r\n./gasnet_core.c:537:#if GASNET_PSHM\r\n./gasnet_core.c:609:      gasneti_fatalerror(\"per-host segment limit %\"PRIu64\" is too small to accommodate %i aux segments, \"\r\n./gasnet_core.c:737:#if GASNET_PSHM\r\n./gasnet_core.c:780:#if GASNET_PSHM\r\n./gasnet_core.c:802:#if GASNET_PSHM\r\n./gasnet_core.c:813:#if GASNET_PSHM \r\n./README:28:* GASNET_PSHM_NODES \r\n./README:38:* GASNET_BARRIER=PSHM (default when PSHM support is enabled)\r\n./gasnet_core_fwd.h:23:  /* GASNET_PSHM defined 1 if this conduit supports PSHM. leave undefined otherwise. */\r\n./gasnet_core_fwd.h:24:#if GASNETI_PSHM_ENABLED\r\n./gasnet_core_fwd.h:25:  #define GASNET_PSHM 1\r\n./gasnet_core_fwd.h:31:#if GASNETI_PSHM_ENABLED\r\n./gasnet_core_fwd.h:32:  #define GASNET_ALIGNED_SEGMENTS   0 /* use of PSHM prevents segment alignment */\r\n./gasnet_core_fwd.h:34:  #define GASNET_ALIGNED_SEGMENTS   1\r\n./gasnet_core_fwd.h:37:#if !GASNET_PSHM\r\n./gasnet_core_fwd.h:122://#define GASNETC_SEGMENT_EXTRA_DECLS (###)\r\n./gasnet_core_fwd.h:123://#define GASNETC_SEGMENT_INIT_HOOK(i_segment) (###)\r\n./gasnet_core_fwd.h:124://#define GASNETC_SEGMENT_FINI_HOOK(i_segment) (###)\r\n./gasnet_core_fwd.h:125://#define GASNETC_SIZEOF_SEGMENT_T() (###)\r\n./gasnet_core_fwd.h:139://#define GASNETC_SEGMENT_ATTACH_HOOK 1\r\n./gasnet_core_fwd.h:140://#define GASNETC_SEGMENT_CREATE_HOOK 1\r\n./gasnet_core_fwd.h:141://#define GASNETC_SEGMENT_DESTROY_HOOK 1\r\n./gasnet_core_fwd.h:142://#define GASNETC_EP_BINDSEGMENT_HOOK 1\r\n./gasnet_core_fwd.h:143://#define GASNETC_EP_PUBLISHBOUNDSEGMENT_HOOK 1\r\n./gasnet_core_fwd.h:162:#if GASNET_PSHM\r\n"]
