[929.891425, "o", "\u001b[0m$ \u001b[0mcd /app && make clean >/dev/null && make 2>&1 | tail -10 && ./serial ./test && for t in 4 8 16 20; do echo \"--- threads=$t ---\"; rm -f pgen_*.out; /usr/bin/time -f 'elapsed %e s' upcrun -n $t -shared-heap 256MB /app/pgen /app/test > /tmp/opencode/final$t.log 2>&1; ec=$?; echo \"exit=$ec\"; tail -1 /tmp/opencode/final$t.log; ls pgen_*.out 2>/dev/null | wc -l; cat pgen_*.out 2>/dev/null | sort > /tmp/opencode/f$t.sorted; diff -q /tmp/opencode/serial.sorted /tmp/opencode/f$t.sorted && echo MATCH$t; done\r\ngcc -O2 -Wall -o serial serial.c\r\nupcc -O -network=smp -o pgen pgen.upc\r\n--- threads=4 ---\r\nexit=0\r\nelapsed 1.06 s\r\n4\r\nMATCH4\r\n--- threads=8 ---\r\nexit=0\r\nelapsed 1.08 s\r\n8\r\nMATCH8\r\n--- threads=16 ---\r\nexit=0\r\nelapsed 1.08 s\r\n16\r\nMATCH16\r\n--- threads=20 ---\r\nexit=0\r\nelapsed 1.33 s\r\n20\r\nMATCH20\r\n"]
