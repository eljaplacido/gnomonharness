[713.318415, "o", "\u001b[0m$ \u001b[0mcd /tmp/opencode/berkeley_upc-2022.10.0 && grep -n \"gasnet/configure\\|gasnet-configure\\|configure.*gasnet\" configure | head -50; grep -rn \"GASNET_PSHM\" configure | head -30\r\n3695:    upcr_cv_configure_args=\"$_gasneti_raw_args\"\r\n44582:  { $as_echo \"$as_me:${as_lineno-$LINENO}: checking for GASNET_PSHM_ENABLED in gasnet\" >&5\r\n44583:$as_echo_n \"checking for GASNET_PSHM_ENABLED in gasnet... \" >&6; }\r\n44588:  _subconfig_extract_result=`$PERL -n -e 'if (m/^S\\[\"('GASNET_PSHM_ENABLED')\"\\]=\"(.*)\"/) { print \"$1='\"'\"'$2'\"'\"'\"; };' -e 'if (m/^s(.)\\@('GASNET_PSHM_ENABLED')\\@\\1([^\\1]*)\\1/) { my ($var,$val) = ($2,$3); $val =~ s/\\|#_!!_#\\|//g; print \"$var='\"'\"'$val'\"'\"'\"; };' $_subconfig_extract_file`\r\n44591:    { $as_echo \"$as_me:${as_lineno-$LINENO}: result: $GASNET_PSHM_ENABLED\" >&5\r\n44592:$as_echo \"$GASNET_PSHM_ENABLED\" >&6; }\r\n44596:    as_fn_error $? \"failed to extract GASNET_PSHM_ENABLED variable value from $_subconfig_extract_file\" \"$LINENO\" 5\r\n44603:PSHM_SUPPORT=\"$GASNET_PSHM_ENABLED\"\r\n"]
