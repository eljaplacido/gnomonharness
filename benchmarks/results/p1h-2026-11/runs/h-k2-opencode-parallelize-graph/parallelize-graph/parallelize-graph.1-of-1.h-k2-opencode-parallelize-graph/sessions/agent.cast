[696.646553, "o", "\u001b[0m$ \u001b[0mcd /tmp/opencode/berkeley_upc-2022.10.0/gasnet && grep -rn \"gasneti_sharedLimit\\|sharedLimit\" --include=*.c --include=*.h | head -40\r\ngasnet_internal.h:483:uint64_t gasneti_sharedLimit(void);\r\ngasnet_internal.h:485:uintptr_t gasneti_segmentLimit(uintptr_t localLimit, uint64_t sharedLimit,\r\nibv-conduit/gasnet_core.c:2280:    // Bound per-host (sharedLimit) argument to gasneti_segmentLimit()\r\nibv-conduit/gasnet_core.c:2282:    uint64_t sharedLimit = gasneti_sharedLimit();\r\nibv-conduit/gasnet_core.c:2284:    if (sharedLimit <= hostAuxSegs) {\r\nibv-conduit/gasnet_core.c:2287:                         sharedLimit, gasneti_myhost.node_count, hostAuxSegs);\r\nibv-conduit/gasnet_core.c:2289:    sharedLimit -= hostAuxSegs;\r\nibv-conduit/gasnet_core.c:2291:    mmap_limit = gasneti_segmentLimit(local_limit, sharedLimit, NULL, NULL);\r\nudp-conduit/gasnet_core.c:323:      // Bound per-host (sharedLimit) argument to gasneti_segmentLimit()\r\nudp-conduit/gasnet_core.c:325:      uint64_t sharedLimit = gasneti_sharedLimit();\r\nudp-conduit/gasnet_core.c:327:      if (sharedLimit <= hostAuxSegs) {\r\nudp-conduit/gasnet_core.c:330:                           sharedLimit, gasneti_myhost.node_count, hostAuxSegs);\r\nudp-conduit/gasnet_core.c:332:      sharedLimit -= hostAuxSegs;\r\nudp-conduit/gasnet_core.c:334:      mmap_limit = gasneti_segmentLimit((uintptr_t)-1, sharedLimit, NULL, NULL);\r\nofi-conduit/gasnet_core.c:158:    // Bound per-host (sharedLimit) argument to gasneti_segmentLimit()\r\nofi-conduit/gasnet_core.c:160:    uint64_t sharedLimit = gasneti_sharedLimit();\r\nofi-conduit/gasnet_core.c:162:    if (sharedLimit <= hostAuxSegs) {\r\nofi-conduit/gasnet_core.c:165:                         sharedLimit, gasneti_myhost.node_count, hostAuxSegs);\r\nofi-conduit/gasnet_core.c:167:    sharedLimit -= hostAuxSegs;\r\nofi-conduit/gasnet_core.c:169:    mmap_limit = gasneti_segmentLimit((uintptr_t)-1, sharedLimit, NULL, NULL);\r\ngasnet_mmap.c:1272:// gasneti_sharedLimit()\r\ngasnet_mmap.c:1290:uint64_t gasneti_sharedLimit(void) {\r\ngasnet_mmap.c:1291:  uint64_t sharedLimit;\r\ngasnet_mmap.c:1296:    sharedLimit = hostmem ? hostmem : (uint64_t)-1;\r\ngasnet_mmap.c:1319:          sharedLimit = MIN(sharedLimit, free_space);\r\ngasnet_mmap.c:1332:  return sharedLimit;\r\ngasnet_mmap.c:1340:   sharedLimit is an optional upper limit per host\r\ngasnet_mmap.c:1361:uintptr_t gasneti_segmentLimit(uintptr_t localLimit, uint64_t sharedLimit,\r\ngasnet_mmap.c:1382:  if ((uint64_t)localLimit > sharedLimit) localLimit = sharedLimit;\r\ngasnet_mmap.c:1390:    if ((sharedLimit != (uint64_t)-1) && (local_count > 1)) {\r\ngasnet_mmap.c:1391:      uint64_t tmp = sharedLimit / local_count;\r\nmpi-conduit/gasnet_core.c:241:      // Bound per-host (sharedLimit) argument to gasneti_segmentLimit()\r\nmpi-conduit/gasnet_core.c:243:      uint64_t sharedLimit = gasneti_sharedLimit();\r\nmpi-conduit/gasnet_core.c:245:      if (sharedLimit <= hostAuxSegs) {\r\nmpi-conduit/gasnet_core.c:248:                           sharedLimit, gasneti_myhost.node_count, hostAuxSegs);\r\nmpi-conduit/gasnet_core.c:250:      sharedLimit -= hostAuxSegs;\r\nmpi-conduit/gasnet_core.c:252:      mmap_limit = gasneti_segmentLimit((uintptr_t)-1, sharedLimit, NULL, NULL);\r\naries-conduit/gasnet_core.c:233:  pm_limit = MIN(gasneti_sharedLimit(), pm_limit);\r\nsmp-conduit/gasnet_core.c:604:    // Bound per-host (sharedLimit) argument to gasneti_segmentLimit()\r\nsmp-conduit/gasnet_core.c:606:    uint64_t sharedLimit = gasneti_sharedLimit();\r\n"]
