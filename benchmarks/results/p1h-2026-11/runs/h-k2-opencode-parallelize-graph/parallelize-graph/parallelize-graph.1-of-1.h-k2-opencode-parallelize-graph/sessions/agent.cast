[84.156881, "o", "\u001b[0m$ \u001b[0mcd /app && python3 - <<'EOF'\r\nkm={}\r\nwith open('test') as f:\r\n    for line in f:\r\n        a,b=line.rstrip('\\n').split('\\t')\r\n        km[a]=(b[0],b[1])\r\nprint('n',len(km))\r\nmissingR=missingL=0\r\noutd={}; ind={}\r\nedges=[]\r\nfor k,(l,r) in km.items():\r\n    if r!='F':\r\n        s=k[1:]+r\r\n        if s not in km: missingR+=1\r\n        else: edges.append((k,s))\r\n    if l!='F':\r\n        p=l+k[:-1]\r\n        if p not in km: missingL+=1\r\nprint('missingR',missingR,'missingL',missingL)\r\nfrom collections import Counter\r\nc=Counter(edges)\r\nprint('dup edges',sum(v-1 for v in c.values() if v>1))\r\nfor a,b in edges:\r\n    outd[a]=outd.get(a,0)+1; ind[b]=ind.get(b,0)+1\r\nprint('out>1',sum(v>1 for v in outd.values()),'in>1',sum(v>1 for v in ind.values()))\r\n# compare incoming from edge vs left char\r\nbad=0\r\nfor k,(l,r) in km.items():\r\n    hasin=ind.get(k,0)\r\n    if (l!='F')!=(hasin>0): bad+=1\r\nprint('left mismatches',bad)\r\n# starts\r\nstarts=[k for k,(l,r) in km.items() if ind.get(k,0)==0]\r\nprint('starts',len(starts))\r\nprint('nodes with left F',sum(l=='F' for l,r in km.values()))\r\nEOF\r\nn 10000\r\nmissingR 1 missingL 0\r\ndup edges 0\r\nout>1 0 in>1 0\r\nleft mismatches 0\r\nstarts 6\r\nnodes with left F 6\r\n"]
[84.957594, "o", "> build · deepseek-v4.1-flash\r\n"]
[87.013289, "o", "\u001b[0m$ \u001b[0mcd /app && python3 - <<'EOF'\r\nkm={}\r\nfor line in open('test'):\r\n    a,b=line.rstrip('\\n').split('\\t'); km[a]=(b[0],b[1])\r\nind={}\r\nfor k,(l,r) in km.items():\r\n    if l!='F':\r\n        p=l+k[:-1]\r\n        if p in km: ind[k]=ind.get(k,0)+1\r\nvis=set(); contigs=[]\r\nstarts=[k for k in km if ind.get(k,0)==0]\r\nfor s in starts:\r\n    seq=s; cur=s; vis.add(cur)\r\n    while True:\r\n        l,r=km[cur]\r\n        if r=='F': break\r\n        nxt=cur[1:]+r\r\n        if nxt not in km: break\r\n        seq+=r; cur=nxt\r\n        if cur in vis: break\r\n        vis.add(cur)\r\n    contigs.append(seq)\r\nleft=[k for k in km if k not in vis]\r\nprint('starts',len(starts),'left',len(left),'contigs',len(contigs),[len(c) for c in contigs])\r\n# cycles\r\nwhile left:\r\n    s=left[0]; seq=s; cur=s; vis.add(cur)\r\n    while True:\r\n        l,r=km[cur]\r\n        if r=='F': break\r\n        nxt=cur[1:]+r\r\n        if nxt not in km or nxt in vis: break\r\n        seq+=r; cur=nxt; vis.add(cur)\r\n    contigs.append(seq); left=[k for k in km if k not in vis]\r\nprint('total',len(contigs),[len(c) for c in contigs])\r\nEOF\r\nstarts 6 left 0 contigs 6 [3598, 1467, 846, 380, 3590, 227]\r\ntotal 6 [3598, 1467, 846, 380, 3590, 227]\r\n"]
