[832.101884, "o", "\u001b[0m← \u001b[0mEdit Makefile\r\nIndex: Makefile\r\n===================================================================\r\n--- Makefile\r\n+++ Makefile\r\n@@ -10,8 +10,16 @@\r\n \r\n pgen: pgen.upc\r\n \t$(UPC) $(UPCFLAGS) -o $@ $<\r\n \r\n+test: all\r\n+\t./serial ./test\r\n+\tupcrun -n 4 -shared-heap 256MB ./pgen ./test\r\n+\tcat pgen_*.out | sort > .pgen.sorted\r\n+\tsort serial.out > .serial.sorted\r\n+\tdiff -u .serial.sorted .pgen.sorted\r\n+\trm -f .pgen.sorted .serial.sorted\r\n+\r\n clean:\r\n-\trm -f serial pgen serial.out pgen_*.out\r\n+\trm -f serial pgen serial.out pgen_*.out .pgen.sorted .serial.sorted\r\n \r\n-.PHONY: all clean\r\n+.PHONY: all test clean\r\n\r\n"]
