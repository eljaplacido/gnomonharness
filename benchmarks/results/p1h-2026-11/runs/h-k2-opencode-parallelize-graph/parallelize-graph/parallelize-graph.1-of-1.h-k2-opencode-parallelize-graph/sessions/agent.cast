[236.469539, "o", "\u001b[0m$ \u001b[0mcd /app && upcc -O -network=smp -o pgen pgen.upc && upcrun -n 4 -shared-heap 256MB /app/pgen /app/test; echo exit=$?; ls -l pgen_*.out 2>/dev/null\r\nUPCR: UPC thread 3 of 4 on 91875131cfe2 (pshm node 0 of 1, process 3 of 4, pid=33242)\r\nUPCR: UPC thread 0 of 4 on 91875131cfe2 (pshm node 0 of 1, process 0 of 4, pid=33222)\r\nUPCR: UPC thread 1 of 4 on 91875131cfe2 (pshm node 0 of 1, process 1 of 4, pid=33240)\r\nUPCR: UPC thread 2 of 4 on 91875131cfe2 (pshm node 0 of 1, process 2 of 4, pid=33241)\r\nUPC Runtime warning: Requested shared memory (256 MB) > available (9 MB) on node 0 (91875131cfe2): using 9 MB per thread instead\r\nexit=0\r\n-rw-r--r-- 1 root root 5067 Nov  1 05:07 pgen_0.out\r\n-rw-r--r-- 1 root root 1228 Nov  1 05:07 pgen_1.out\r\n-rw-r--r-- 1 root root    0 Nov  1 05:07 pgen_2.out\r\n-rw-r--r-- 1 root root 3819 Nov  1 05:07 pgen_3.out\r\n"]
