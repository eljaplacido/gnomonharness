[13.356621, "o", "\u001b[0m$ \u001b[0mhead -5 /app/products.csv; echo \"---\"; head -5 /app/orders.csv; echo \"---\"; wc -l /app/products.csv /app/orders.csv\r\nproduct_id,category,product_name\r\n0,Clothing,Product_0\r\n1,Home,Product_1\r\n2,Grocery,Product_2\r\n3,Home,Product_3\r\n---\r\norder_id,product_id,customer_id,order_date,quantity,unit_price\r\n0,98,1283,2024-09-24,4,132.55\r\n1,8,1609,2024-07-11,3,490.28\r\n2,49,1001,2024-09-25,1,199.85\r\n3,32,583,2024-01-21,3,497.73\r\n---\r\n   101 /app/products.csv\r\n 10001 /app/orders.csv\r\n 10102 total\r\n"]
