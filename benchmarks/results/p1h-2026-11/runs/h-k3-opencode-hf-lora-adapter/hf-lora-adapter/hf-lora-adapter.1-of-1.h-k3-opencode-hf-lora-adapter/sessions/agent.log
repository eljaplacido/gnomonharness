"Hola, ¿cómo estás hoy?",
"Guten Tag, wie geht es Ihnen?",
"Ciao, come stai oggi?",
"Olá, como você está?",
"Привет, как дела?",
"こんにちは、お元気ですか？",
"你好，你好吗？",
"مرحبا، كيف حالك؟",
"Hello, how are you?",
]
results=[]
with torch.no_grad():
    for text in samples:
        enc=tok(text, return_tensors='pt', truncation=True, max_length=512)
        logits=model(**enc).logits[0]
        probs=torch.softmax(logits, dim=-1)
        cid=int(torch.argmax(logits).item())
        conf=float(probs[cid].item())
        results.append({"text":text,"predicted_class_id":cid,"confidence":round(conf,6)})
        print(cid, f"{conf:.4f}", text)
with open('/app/detection_results.json','w',encoding='utf-8') as f:
    json.dump(results,f,ensure_ascii=False,indent=2)
print("wrote /app/detection_results.json")
