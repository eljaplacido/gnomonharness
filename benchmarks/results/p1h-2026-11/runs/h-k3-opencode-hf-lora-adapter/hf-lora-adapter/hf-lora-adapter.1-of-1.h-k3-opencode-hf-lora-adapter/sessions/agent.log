import torch
from transformers import AutoTokenizer, AutoModelForSequenceClassification
tok=AutoTokenizer.from_pretrained('/app/merged_model')
model=AutoModelForSequenceClassification.from_pretrained('/app/merged_model').eval()
samples={
'bg':'Здравей, как си днес?',
'el':'Γεια σου, τι κάνεις σήμερα;',
'hi':'नमस्ते, आप आज कैसे हैं?',
'nl':'Hallo, hoe gaat het vandaag?',
'pl':'Cześć, jak się dzisiaj masz?',
'sw':'Habari, unaendeleaje leo?',
'th':'สวัสดี วันนี้คุณเป็นอย่างไรบ้าง',
'tr':'Merhaba, bugün nasılsın?',
'ur':'سلام، آج آپ کیسے ہیں؟',
'vi':'Xin chào, hôm nay bạn thế nào?',
}
with torch.no_grad():
    for lang,text in samples.items():
        logits=model(**tok(text,return_tensors='pt',truncation=True,max_length=512)).logits[0]
        print(lang, int(logits.argmax()), f"{torch.softmax(logits,-1).max():.3f}", text)
