[121.176326, "o", "\u001b[0m$ \u001b[0mcat /app/adapter_src/config.json; echo '--- keys ---'; python - <<'PY'\r\nimport torch\r\nsd = torch.load('/app/adapter_src/adapter_model.bin', map_location='cpu', weights_only=True)\r\nfor k,v in sd.items():\r\n    if 'classifier' in k or 'modules_to_save' in k:\r\n        print(k, tuple(v.shape))\r\nprint('total keys', len(sd))\r\nprint(list(sd)[:10])\r\nPY\r\n{\r\n  \"_name_or_path\": \"xlm-roberta-base\",\r\n  \"architectures\": [\r\n    \"XLMRobertaForSequenceClassification\"\r\n  ],\r\n  \"attention_probs_dropout_prob\": 0.1,\r\n  \"bos_token_id\": 0,\r\n  \"classifier_dropout\": null,\r\n  \"eos_token_id\": 2,\r\n  \"hidden_act\": \"gelu\",\r\n  \"hidden_dropout_prob\": 0.1,\r\n  \"hidden_size\": 768,\r\n  \"id2label\": {\r\n    \"0\": \"ar\",\r\n    \"1\": \"bg\",\r\n    \"2\": \"de\",\r\n    \"3\": \"el\",\r\n    \"4\": \"en\",\r\n    \"5\": \"es\",\r\n    \"6\": \"fr\",\r\n    \"7\": \"hi\",\r\n    \"8\": \"it\",\r\n    \"9\": \"ja\",\r\n    \"10\": \"nl\",\r\n    \"11\": \"pl\",\r\n    \"12\": \"pt\",\r\n    \"13\": \"ru\",\r\n    \"14\": \"sw\",\r\n    \"15\": \"th\",\r\n    \"16\": \"tr\",\r\n    \"17\": \"ur\",\r\n    \"18\": \"vi\",\r\n    \"19\": \"zh\"\r\n  },\r\n  \"init"]
