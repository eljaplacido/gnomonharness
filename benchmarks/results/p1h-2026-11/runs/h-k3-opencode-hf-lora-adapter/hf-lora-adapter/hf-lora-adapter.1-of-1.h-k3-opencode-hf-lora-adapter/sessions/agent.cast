[148.032475, "o", "\u001b[0m$ \u001b[0mcd /app && python - <<'PY'\r\nimport torch\r\nfrom transformers import AutoTokenizer, AutoModelForSequenceClassification\r\nfrom peft import PeftModel\r\n\r\nbase='/app/model_cache/xlm-roberta-base'\r\nadapter='/app/adapter_src'\r\ntok=AutoTokenizer.from_pretrained(base)\r\nmodel=AutoModelForSequenceClassification.from_pretrained(base)\r\nprint(\"num_labels before:\", model.config.num_labels)\r\nmodel = PeftModel.from_pretrained(model, adapter)\r\nprint(\"peft model loaded:\", type(model))\r\n# check classifier weights loaded\r\nprint(\"out_proj:\", model.base_model.model.classifier.out_proj.weight.shape)\r\nmerged = model.merge_and_unload()\r\nprint(\"merged:\", type(merged), merged.config.num_labels)\r\nmerged.save_pretrained('/app/merged_model')\r\ntok.save_pretrained('/app/merged_model')\r\nprint(\"saved merged\")\r\nPY\r\nLoading weights:   0%|          | 0/201 [00:00<?, ?it/s]\rLoading weights: 100%|██████████| 201/201 [00:00<00:00, 8425.66it/s]\r\nnum_labels before: 20\r\npeft model loaded: <class 'peft.peft_model.PeftModelFor"]
[148.032506, "o", "SequenceClassification'>\r\nout_proj: torch.Size([20, 768])\r\nmerged: <class 'transformers.models.xlm_roberta.modeling_xlm_roberta.XLMRobertaForSequenceClassification'> 20\r\n\rWriting model shards:   0%|          | 0/1 [00:00<?, ?it/s]\rWriting model shards: 100%|██████████| 1/1 [00:01<00:00,  1.39s/it]\rWriting model shards: 100%|██████████| 1/1 [00:01<00:00,  1.39s/it]\r\nsaved merged\r\n"]
