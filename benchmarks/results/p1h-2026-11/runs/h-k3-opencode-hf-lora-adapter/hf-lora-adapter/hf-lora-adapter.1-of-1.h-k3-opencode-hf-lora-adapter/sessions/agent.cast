[160.047367, "o", "\u001b[0m$ \u001b[0mcd /app && python - <<'PY'\r\nimport json, torch\r\nfrom transformers import AutoTokenizer, AutoModelForSequenceClassification\r\n\r\ntok=AutoTokenizer.from_pretrained('/app/merged_model')\r\nmodel=AutoModelForSequenceClassification.from_pretrained('/app/merged_model')\r\nmodel.eval()\r\n\r\nsamples=[\r\n\"Bonjour, comment allez-vous aujourd'hui?\",\r\n\"Hola, ¿cómo estás hoy?\",\r\n\"Guten Tag, wie geht es Ihnen?\",\r\n\"Ciao, come stai oggi?\",\r\n\"Olá, como você está?\",\r\n\"Привет, как дела?\",\r\n\"こんにちは、お元気ですか？\",\r\n\"你好，你好吗？\",\r\n\"مرحبا، كيف حالك؟\",\r\n\"Hello, how are you?\",\r\n]\r\nresults=[]\r\nwith torch.no_grad():\r\n    for text in samples:\r\n        enc=tok(text, return_tensors='pt', truncation=True, max_length=512)\r\n        logits=model(**enc).logits[0]\r\n        probs=torch.softmax(logits, dim=-1)\r\n        cid=int(torch.argmax(logits).item())\r\n        conf=float(probs[cid].item())\r\n        results.append({\"text\":text,\"predicted_class_id\":cid,\"confidence\":round(conf,6)})"]
[160.047513, "o", "\r\n        print(cid, f\"{conf:.4f}\", text)\r\nwith open('/app/detection_results.json','w',encoding='utf-8') as f:\r\n    json.dump(results,f,ensure_ascii=False,indent=2)\r\nprint(\"wrote /app/detection_results.json\")\r\nPY\r\ncat /app/detection_results.json\r\nLoading weights:   0%|          | 0/201 [00:00<?, ?it/s]\rLoading weights: 100%|██████████| 201/201 [00:00<00:00, 7744.82it/s]\r\n6 0.9753 Bonjour, comment allez-vous aujourd'hui?\r\n5 0.9890 Hola, ¿cómo estás hoy?\r\n2 0.9973 Guten Tag, wie geht es Ihnen?\r\n8 0.9888 Ciao, come stai oggi?\r\n12 0.9896 Olá, como você está?\r\n13 0.9856 Привет, как дела?\r\n9 0.9649 こんにちは、お元気ですか？\r\n19 0.9360 你好，你好吗？\r\n0 0.9880 مرحبا، كيف حالك؟\r\n4 0.9737 Hello, how are you?\r\nwrote /app/detection_results.json\r\n[\r\n  {\r\n    \"text\": \"Bonjour, comment allez-vous aujourd'hui?\",\r\n    \"predicted_class_id\": 6,\r\n    \"confidence\": 0.975284\r\n  },\r\n  {\r\n    \"text\": \"Hola, ¿cómo estás hoy?\",\r\n    \"predicted_class_id\": 5,\r"]
