[116.947985, "o", "\u001b[0m$ \u001b[0mfind /app/adapter_src -maxdepth 2 -type f -printf '%P %s\\n' | sort; echo '--- config ---'; cat /app/adapter_src/adapter_config.json\r\n.gitattributes 1528\r\n.gitignore 13\r\nREADME.md 8237\r\nadapter_config.json 321\r\nadapter_model.bin 3622413\r\nconfig.json 1395\r\n--- config ---\r\n{\r\n  \"base_model_name_or_path\": \"xlm-roberta-base\",\r\n  \"bias\": \"none\",\r\n  \"fan_in_fan_out\": false,\r\n  \"inference_mode\": true,\r\n  \"lora_alpha\": 16,\r\n  \"lora_dropout\": 0.1,\r\n  \"modules_to_save\": [\r\n    \"classifier\"\r\n  ],\r\n  \"peft_type\": \"LORA\",\r\n  \"r\": 8,\r\n  \"target_modules\": [\r\n    \"query\",\r\n    \"value\"\r\n  ],\r\n  \"task_type\": \"SEQ_CLS\"\r\n}\r\n\u001b[0m$ \u001b[0mfind /app/model_cache/xlm-roberta-base -maxdepth 1 -type f -printf '%f %s\\n' | sort; echo '--- config ---'; cat /app/model_cache/xlm-roberta-base/config.json\r\n.gitattributes 445\r\nREADME.md 5238\r\nconfig.json 615\r\nflax_model.msgpack 1113187999\r\nmodel.onnx 1881470773\r\nmodel.safetensors 1115567652\r\npytorch_model.bin 1115590446\r\nsentencepiece.bpe.model 5069051\r\ntf_model.h5 1112441536\r\ntokenizer."]
