set -e
# Use a valid local site owner for Mailman's administrative notices.
sed -i 's/^site_owner:.*/site_owner: root@local.edu/' /etc/mailman3/mailman.cfg
chown -R list:list /var/lib/mailman3 /var/log/mailman3 /run/mailman3
chmod 750 /var/log/mailman3
# Make local.edu a local delivery domain and use Mailman's generated LMTP transport map.
postconf -e 'mydestination = $myhostname, localhost, localhost.localdomain, local.edu'
postconf -e 'transport_maps = hash:/var/lib/mailman3/data/postfix_lmtp'
# Keep the generated transport map writable only by Mailman.
postconf -e 'local_recipient_maps = proxy:unix:passwd.byname $alias_maps'
service postfix start
sleep 1
service postfix status
mailman --run-as-root create -o root@local.edu reading-group@local.edu --notify 2>&1 || true
mailman --run-as-root lists 2>&1
echo '--- generated files ---'
ls -la /var/lib/mailman3/data
cat /var/lib/mailman3/data/postfix_lmtp 2>/dev/null || true
