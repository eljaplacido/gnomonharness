[61.198237, "o", "\r\n\u001b[1;32mTool\u001b[0m:\r\n"]
[61.200325, "o", "<returncode>\r\n0\r\n<output>\r\n18:# This file contains the Debian configuration for mailman.  It uses ini-style\r\n19:# formats under the lazr.config regime to define all system configuration\r\n23:[mailman]\r\n24:# This address is the \"site owner\" address.  Certain messages which must be\r\n25:# delivered to a human, but which can't be delivered to a list owner (e.g. a\r\n26:# bounce from a list owner), will be sent to this address.  It should point to\r\n28:site_owner: changeme@example.com\r\n34:noreply_address: noreply\r\n37:default_language: en\r\n44:sender_headers: from from_ reply-to sender\r\n47:email_commands_max_lines: 10\r\n51:pending_request_life: 3d\r\n54:cache_life: 7d\r\n58:pre_hook:\r\n62:post_hook:\r\n66:layout: debian\r\n68:# Can MIME filtered messages be preserved by list owners?\r\n69:filtered_messages_are_preservable: no\r\n76:html_to_plain_text_command: /usr/bin/lynx -dump $filename\r\n83:listname_chars: [-_.0-9a-z]\r\n86:[shell]\r\n93:prompt: >>>\r\n96:banner: Welcome to the GNU Mailman shell\r\n101:use_ipython: no\r\n"]
[61.200367, "o", "104:# can be as simple as $var_dir/history.py to put the file in the var directory.\r\n105:history_file:\r\n108:[paths.debian]\r\n111:# be different from a FHS layout.  Most paths are based off the var_dir, and\r\n116:# configuration variable in the paths.* section.  Substitutions are expanded\r\n122:var_dir: /var/lib/mailman3\r\n124:queue_dir: $var_dir/queue\r\n128:bin_dir: /usr/lib/mailman3/bin\r\n130:list_data_dir: $var_dir/lists\r\n132:log_dir: /var/log/mailman3\r\n134:lock_dir: $var_dir/locks\r\n136:data_dir: $var_dir/data\r\n138:cache_dir: $var_dir/cache\r\n139:# Directory for configuration files and such.\r\n140:etc_dir: /etc/mailman3\r\n142:ext_dir: $var_dir/ext\r\n144:messages_dir: $var_dir/messages\r\n147:archive_dir: $var_dir/archives\r\n149:template_dir: $var_dir/templates\r\n155:pid_file: /run/mailman3/master.pid\r\n157:lock_file: $lock_dir/master.lck\r\n160:[database]\r\n162:class: mailman.database.sqlite.SQLiteDatabase\r\n170:# 'configuration' substitutions.\r\n171:url: sqlite:///$DATA_DIR/mailman.db\r\n175:debug: no\r\n178:[logging.debian]\r\n212:format: %(asctime)s (%(process)d) %(message)s\r\n213:datefmt: %b %d %H:%M:%S %Y\r\n214:propagate: no\r\n215:level: info\r\n216:path: mailman.log\r\n218:[webservice]\r\n220:hostname: localhost\r\n223:port: 8001\r\n226:use_https: no\r\n230:show_tracebacks: yes\r\n233:api_version: 3.1\r\n236:admin_user: restadmin\r\n239:admin_pass: HtjrFZfKuq+XKKF6748Ay9BISs+63E8zkTuDVPKo35GibShq\r\n241:[mta]\r\n242:# The class defining the interface to the incoming mail transport agent.\r\n243:#incoming: mailman.mta.exim4.LMTP\r\n244:incoming: mailman.mta.postfix.LMTP\r\n249:outgoing: mailman.mta.deliver.deliver\r\n253:smtp_host: localhost\r\n254:smtp_port: 25\r\n255:smtp_user:\r\n256:smtp_pass:\r\n261:lmtp_host: 127.0.0.1\r\n262:lmtp_port: 8024\r\n264:# Where can we find the mail server specific configuration file?  The path can\r\n270:#configuration: python:mailman.config.exim4\r\n271:configuration: python:mailman.config.postfix\r\n\r\n"]
[61.200595, "o", "\r\n\u001b[1;32mTool\u001b[0m:\r\n"]
[61.203698, "o", "<returncode>\r\n1\r\n<output>\r\ntotal 124\r\ndrwxr-xr-x 29 root root 4096 Oct 31 12:15 .\r\ndrwxr-xr-x  1 root root 4096 Nov  1 00:29 ..\r\n-rw-r--r--  1 root root 1435 Jan  4  2023 __init__.py\r\ndrwxr-xr-x  2 root root 4096 Oct 31 12:15 __pycache__\r\ndrwxr-xr-x  4 root root 4096 Oct 31 12:15 app\r\ndrwxr-xr-x  4 root root 4096 Oct 31 12:15 archiving\r\ndrwxr-xr-x  4 root root 4096 Oct 31 12:15 bin\r\ndrwxr-xr-x  4 root root 4096 Oct 31 12:15 chains\r\ndrwxr-xr-x  4 root root 4096 Oct 31 12:15 commands\r\ntotal 16\r\ndrwxr-xr-x 3 list list 4096 Oct 31 12:15 .\r\ndrwxr-xr-x 1 root root 4096 Oct 31 12:15 ..\r\ndrwxrwx--- 2 list list 4096 Oct 31 12:15 data\r\n/var/lib/mailman3/data/mailman.db\r\n---aliases\r\n# See man 5 aliases for format\r\npostmaster:    root\r\n---postfix config dirs\r\ntotal 132\r\ndrwxr-xr-x 5 root root  4096 Oct 31 12:15 .\r\ndrwxr-xr-x 1 root root  4096 Nov  1 00:29 ..\r\n-rw-r--r-- 1 root root    60 Oct 31 12:15 dynamicmaps.cf\r\ndrwxr-xr-x 2 root root  4096 May  5 15:47 dynamicmaps.cf.d\r\n-rw-r--r-- 1 root root  1348 Oct 31 12:15 main.cf\r\n-rw-r--r-- 1 root root 27460 Oct 31 12:15 main.cf.proto\r\nlrwxrwxrwx 1 root root    31 Oct 31 12:15 makedefs.out -> /usr/share/postfix/makedefs.out\r\n-rw-r--r-- 1 root root  7048 Oct 31 12:15 master.cf\r\n-rw-r--r-- 1 root root  7048 Oct 31 12:15 master.cf.proto\r\n-rwxr-xr-x 1 root root 29873 May  5 15:47 post-install\r\n-rw-r--r-- 1 root root 10283 May  5 15:47 postfix-files\r\ndrwxr-xr-x 2 root root  4096 May  5 15:47 postfix-files.d\r\n-rwxr-xr-x 1 root root 11033 May  5 15:47 postfix-script\r\ndrwxr-xr-x 2 root root  4096 May  5 15:47 sasl\r\n---master\r\n12:smtp      inet  n       -       y       -       -       smtpd\r\n13:#smtp      inet  n       -       y       -       1       postscreen\r\n14:#smtpd     pass  -       -       y       -       -       smtpd\r\n18:#127.0.0.1:submission inet n -   y       -       -       smtpd\r\n19:#submission inet n       -       y       -       -       smtpd\r\n21:#  -o smtpd_tls_security_level=encrypt\r\n22:#  -o smtpd_sasl_auth_enable=yes\r\n23:#  -o smtpd_tls_auth_only=yes\r\n24:#  -o local_header_rewrite_clients=static:all\r\n25:#  -o smtpd"]
[61.203732, "o", "_reject_unlisted_recipient=no\r\n26:#     Instead of specifying complex smtpd_<xxx>_restrictions here,\r\n27:#     specify \"smtpd_<xxx>_restrictions=$mua_<xxx>_restrictions\"\r\n30:#  -o smtpd_client_restrictions=\r\n31:#  -o smtpd_helo_restrictions=\r\n32:#  -o smtpd_sender_restrictions=\r\n33:#  -o smtpd_relay_restrictions=\r\n34:#  -o smtpd_recipient_restrictions=permit_sasl_authenticated,reject\r\n37:#127.0.0.1:submissions inet n  -       y       -       -       smtpd\r\n38:#submissions     inet  n       -       y       -       -       smtpd\r\n40:#  -o smtpd_tls_wrappermode=yes\r\n41:#  -o smtpd_sasl_auth_enable=yes\r\n42:#  -o local_header_rewrite_clients=static:all\r\n43:#  -o smtpd_reject_unlisted_recipient=no\r\n44:#     Instead of specifying complex smtpd_<xxx>_restrictions here,\r\n45:#     specify \"smtpd_<xxx>_restrictions=$mua_<xxx>_restrictions\"\r\n48:#  -o smtpd_client_restrictions=\r\n49:#  -o smtpd_helo_restrictions=\r\n50:#  -o smtpd_sender_restrictions=\r\n51:#  -o smtpd_relay_restrictions=\r\n52:#  -o smtpd_recipient_restrictions=permit_sasl_authenticated,reject\r\n68:smtp      unix  -       -       y       -       -       smtp\r\n69:relay     unix  -       -       y       -       -       smtp\r\n71:#       -o smtp_helo_timeout=5 -o smtp_connect_timeout=5\r\n76:local     unix  -       n       n       -       -       local\r\n77:virtual   unix  -       n       n       -       -       virtual\r\n103:#   lmtp    cmd=\"lmtpd -a\" listen=\"localhost:lmtp\" proto=tcp4\r\n106:#  mailbox_transport = lmtp:inet:localhost\r\n107:#  virtual_transport = lmtp:inet:localhost\r\n135:#bsmtp     unix  -       n       n       -       -       pipe\r\n136:#  flags=Fq. user=bsmtp argv=/usr/lib/bsmtp/bsmtp -t$nexthop -f$sender $recipient\r\n---users\r\nlist❌38:38:Mailing List Manager:/var/list:/usr/sbin/nologin\r\npostfix❌101:103::/var/spool/postfix:/usr/sbin/nologin\r\nuid=38(list) gid=38(list) groups=38(list)\r\n\r\n"]
