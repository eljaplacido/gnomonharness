[133.475267, "o", "\r\u001b[2K```\r\nchown list:list /var/lib/mailman3/data/postfix_lmtp /var/lib/mailman3/data/postfix_lmtp.db /var/lib/mailman3/data/postfix_domains \r\n/var/lib/mailman3/data/postfix_domains.db\r\nsu -s /bin/sh list -c 'mailman -C /etc/mailman3/mailman.cfg start' 2>&1 || true\r\nsleep 2\r\nmailman --run-as-root status 2>&1 || true\r\nps aux | grep -E 'mailman|runner|lmtp' | grep -v grep || true\r\nss -ltnp | grep -E '25|8024' || true\r\ntail -50 /var/log/mailman3/mailman.log 2>/dev/null || true\r\n```\r\n\u001b[32m⠏\u001b[0m Waiting for the LM to respond..."]
