[3.26612, "o", "source /installed-agent/install-agent.sh || echo 'INSTALL_FAIL_STATUS'; tmux wait -S done\r\n\u001b[?2004l\r"]
[12.076253, "o", "ARM_VERSION=0.26.4\r\n"]
