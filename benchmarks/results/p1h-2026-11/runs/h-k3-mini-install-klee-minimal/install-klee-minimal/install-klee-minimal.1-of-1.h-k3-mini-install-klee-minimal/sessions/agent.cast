[160.346043, "o", "<returncode>\r\n0\r\n<output>\r\n   420            #pragma GCC diagnostic error \\\"-Wnonnull\\\"\r\n   421            fstatat(0, NULL, &buf, 0);\r\n   422          }\r\n   423          \"\r\n   424          FSTATAT_PATH_ACCEPTS_NULL)\r\n   425  cmake_pop_check_state()\r\n   426  \r\n   427  ################################################################################\r\n   428  # KLEE runtime support\r\n   429  ################################################################################\r\n   430  # This is set here and not in `runtime` because `config.h` needs to be generated.\r\n   431  \r\n   432  set(available_klee_runtime_build_types\r\n   433    \"Release\"\r\n   434    \"Release+Debug\"\r\n   435    \"Release+Asserts\"\r\n   436    \"Release+Debug+Asserts\"\r\n   437    \"Debug\"\r\n   438    \"Debug+Asserts\"\r\n   439  )\r\n   440  if (NOT KLEE_RUNTIME_BUILD_TYPE)\r\n   441    message(STATUS \"KLEE_RUNTIME_BUILD_TYPE is not set. Setting default\")\r\n   442    message(STATUS \"The available runtime build types are: ${available_klee_runtime_build_types}\")\r\n   443    set(KLEE_RUNTIME_BUILD_TYPE \"Debug+Asserts\" CACHE STRING\r\n   444      \"Options are ${available_klee_runtime_build_types}\"\r\n   445      FORCE)\r\n   446  endif()\r\n   447  # Provide drop down menu options in cmake-gui\r\n   448  set_property(CACHE\r\n   449    KLEE_RUNTIME_BUILD_TYPE\r\n   450    PROPERTY STRINGS ${available_klee_runtime_build_types})\r\n   451  message(STATUS \"KLEE_RUNTIME_BUILD_TYPE: ${KLEE_RUNTIME_BUILD_TYPE}\")\r\n   452  \r\n   453  # Check availability of 32bit support for platform\r\n   454  include(CheckCSourceRuns)\r\n   455  cmake_push_check_state()\r\n   456  set(CMAKE_REQUIRED_FLAGS \"-m32\")\r\n   457  check_c_source_runs(\"int main(int argc, char** argv){return 0;}\" CHECK_M32_SUPPORT)\r\n   458  cmake_pop_check_state()\r\n   459  if (NOT CHECK_M32_SUPPORT)\r\n   460    set(M32_SUPPORTED 0)\r\n   461  else()\r\n   462    set(M32_SUPPORTED 1)\r\n   463  endif()\r\n   464  \r\n   465  message(STATUS \"32bit platform supported: ${M32_SUPPORTED}\")\r\n   466  \r\n   467  set(KLEE_INSTALL_RUNTIME_DIR \"${CMAKE_INSTALL_FULL_LIBDIR}/klee/runtime\")\r\n   468  \r\n   469  # Location where KLEE will look for the built runtimes by default.\r\n   470  set(KLEE_RUNTIME_DIRECTORY \"${CMAKE_BINARY_DIR}/runtime/lib\")\r\n   471  \r\n   472  file(MAKE_DIRECTORY ${KLEE_RUNTIME_DIRECTORY})\r\n   473  \r\n   474  ################################################################################\r\n   475  # KLEE POSIX Runtime Support\r\n   476  ################################################################################\r\n   477  option(ENABLE_POSIX_RUNTIME \"Enable KLEE's POSIX runtime\" OFF)\r\n   478  if (ENABLE_POSIX_RUNTIME)\r\n   479    message(STATUS \"POSIX runtime enabled\")\r\n   480  else()\r\n   481    message(STATUS \"POSIX runtime disabled\")\r\n   482  endif()\r\n   483  \r\n   484  ################################################################################\r\n   485  # KLEE uclibc support\r\n   486  ################################################################################\r\n   487  set(KLEE_UCLIBC_PATH \"\" CACHE PATH \"Path to klee-uclibc root directory\")\r\n   488  set(KLEE_UCLIBC_BCA_NAME \"klee-uclibc.bca\")\r\n   489  if (NOT KLEE_UCLIBC_PATH STREQUAL \"\")\r\n   490    # Find the C library bitcode archive\r\n   491    set(KLEE_UCLIBC_C_BCA \"${KLEE_UCLIBC_PATH}/lib/libc.a\")\r\n   492    if (NOT EXISTS \"${KLEE_UCLIBC_C_BCA}\")\r\n   493      message(FATAL_ERROR\r\n   494        \"klee-uclibc library not found at \\\"${KLEE_UCLIBC_C_BCA}\\\". Set KLEE_UCLIBC_PATH to klee-uclibc root directory or empty string.\")\r\n   495    endif()\r\n   496    message(STATUS \"Found klee-uclibc library: \\\"${KLEE_UCLIBC_C_BCA}\\\"\")\r\n   497    # Copy KLEE_UCLIBC_C_BCA so KLEE can find it where it is expected.\r\n   498    execute_process(COMMAND ${CMAKE_COMMAND} -E copy\r\n   499      \"${KLEE_UCLIBC_C_BCA}\"\r\n   500      \"${KLEE_RUNTIME_DIRECTORY}/${KLEE_UCLIBC_BCA_NAME}\"\r\n   501    )\r\n   502  else()\r\n   503    message(STATUS \"Skipping copying of klee-uclibc runtime\")\r\n   504  endif()\r\n   505  \r\n   506  ################################################################################\r\n   507  # KLEE libc++ support\r\n   5"]
[160.346253, "o", "08  ################################################################################\r\n   509  option(ENABLE_KLEE_LIBCXX \"Enable libc++ for klee\" OFF)\r\n   510  if (ENABLE_KLEE_LIBCXX)\r\n   511    message(STATUS \"klee-libc++ support enabled\")\r\n   512    set(SUPPORT_KLEE_LIBCXX 1) # For config.h\r\n   513  \r\n   514    find_file(KLEE_LIBCXX_BC_PATH\r\n   515            NAMES libc++.bca libc++.so.bc libc++.dylib.bc\r\n   516            DOC \"Path to directory containing libc++ shared object (bitcode)\"\r\n   517            PATH_SUFFIXES \"lib\" \"lib/x86_64-unknown-linux-gnu\"\r\n   518            HINTS ${KLEE_LIBCXX_DIR}\r\n   519            REQUIRED\r\n   520    )\r\n   521  \r\n   522    if (NOT EXISTS ${KLEE_LIBCXX_BC_PATH})\r\n   523      message (FATAL_ERROR \"Could not find libc++ bitcode library\")\r\n   524    endif()\r\n   525  \r\n   526    message(STATUS \"Found libc++ library: \\\"${KLEE_LIBCXX_BC_PATH}\\\"\")\r\n   527  \r\n   528  \r\n   529    find_path(KLEE_LIBCXX_PLATFORM_INCLUDE_PATH\r\n   530            NAMES __config_site # We are searching for a platform-specific C++ library header called `__config_site`\r\n   531            DOC \"Path to platform-specific libc++ include directory\"\r\n   532            PATH_SUFFIXES \"x86_64-unknown-linux-gnu/c++/v1\" \"include/x86_64-unknown-linux-gnu/c++/v1\"\r\n   533            HINTS ${KLEE_LIBCXX_INCLUDE_DIR}\r\n   534            NO_DEFAULT_PATH # Make sure we don't pick-up the standard library's path\r\n   535    )\r\n   536  \r\n   537    find_path(KLEE_LIBCXX_INCLUDE_PATH\r\n   538            NAMES cerrno # We are searching for a C++ library header called `cerrno`\r\n   539            DOC \"Path to libc++ include directory\"\r\n   540            PATH_SUFFIXES \"c++/v1\" \"include/c++/v1\"\r\n== posix option ==\r\n/tmp/klee-src/CMakeLists.txt:477:option(ENABLE_POSIX_RUNTIME \"Enable KLEE's POSIX runtime\" OFF)\r\n/tmp/klee-src/CMakeLists.txt:478:if (ENABLE_POSIX_RUNTIME)\r\n/tmp/klee-src/runtime/CMakeLists.txt:106:if (ENABLE_POSIX_RUNTIME)\r\n== klee-uclibc badges docs ==\r\n\r\n"]
