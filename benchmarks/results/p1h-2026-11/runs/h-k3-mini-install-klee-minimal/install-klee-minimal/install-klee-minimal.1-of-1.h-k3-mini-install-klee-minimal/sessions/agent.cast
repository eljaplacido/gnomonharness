[156.967871, "o", "<returncode>\r\n0\r\n<output>\r\n    90    list(APPEND KLEE_COMPONENT_CXX_DEFINES \"-DNDEBUG\")\r\n    91  endif()\r\n    92  \r\n    93  ################################################################################\r\n    94  # KLEE timestamps\r\n    95  ################################################################################\r\n    96  option(KLEE_ENABLE_TIMESTAMP \"Add timestamps to KLEE sources\" OFF)\r\n    97  \r\n    98  ################################################################################\r\n    99  # Include useful CMake functions\r\n   100  ################################################################################\r\n   101  include(GNUInstallDirs)\r\n   102  include(CheckCSourceCompiles)\r\n   103  include(CheckCXXSymbolExists)\r\n   104  include(CheckFunctionExists)\r\n   105  include(CheckIncludeFile)\r\n   106  include(CheckIncludeFileCXX)\r\n   107  include(CheckLibraryExists)\r\n   108  include(CheckPrototypeDefinition)\r\n   109  include(CMakePushCheckState)\r\n   110  \r\n   111  ################################################################################\r\n   112  # Find LLVM\r\n   113  ################################################################################\r\n   114  find_package(LLVM REQUIRED CONFIG HINTS \"${LLVM_DIR}\")\r\n   115  message(STATUS \"LLVM directory ${LLVM_DIR}\")\r\n   116  if (LLVM_VERSION_MAJOR LESS 15)\r\n   117    message(FATAL_ERROR \"KLEE requires LLVM 15 or newer\")\r\n   118  endif()\r\n   119  set(LLVMCC \"${LLVM_TOOLS_BINARY_DIR}/clang\"\r\n   120    CACHE\r\n   121    PATH\r\n   122    \"Path to C bitcode compiler\"\r\n   123    )\r\n   124  set(LLVMCXX \"${LLVM_TOOLS_BINARY_DIR}/clang++\"\r\n   125    CACHE\r\n   126    PATH\r\n   127    \"Path to C++ bitcode compiler\"\r\n   128  )\r\n   129  \r\n   130  if (LLVM_ENABLE_ASSERTIONS)\r\n   131    # Certain LLVM debugging macros only work when LLVM was built with asserts\r\n   132    set(ENABLE_KLEE_DEBUG 1) # for config.h\r\n   133  else()\r\n   134    unset(ENABLE_KLEE_DEBUG) # for config.h\r\n   135  endif()\r\n   136  \r\n   137  # Warn about mixing build types.\r\n   138  # This is likely a bad idea because some of LLVM's header files use the NDEBUG\r\n   139  # macro which can change things like data layout.\r\n   140  if (LLVM_ENABLE_ASSERTIONS AND (NOT ENABLE_KLEE_ASSERTS))\r\n   141    message(WARNING\r\n   142      \"LLVM was built with assertions but KLEE will be built without them.\\n\"\r\n   143      \"This might lead to unexpected behaviour.\"\r\n   144    )\r\n   145  elseif ((NOT LLVM_ENABLE_ASSERTIONS) AND ENABLE_KLEE_ASSERTS)\r\n   146    message(WARNING\r\n   147      \"LLVM was built without assertions but KLEE will be built with them.\\n\"\r\n   148      \"This might lead to unexpected behaviour.\"\r\n   149    )\r\n   150  endif()\r\n   151  \r\n   152  list(APPEND KLEE_COMPONENT_CXX_DEFINES ${LLVM_DEFINITIONS})\r\n   153  list(APPEND KLEE_COMPONENT_EXTRA_INCLUDE_DIRS ${LLVM_INCLUDE_DIRS})\r\n   154  \r\n   155  # Find llvm-link\r\n   156  set(LLVM_LINK \"${LLVM_TOOLS_BINARY_DIR}/llvm-link\"\r\n   157    CACHE\r\n   158    PATH\r\n   159    \"Path to bitcode linker\"\r\n   160    )\r\n   161  if (NOT EXISTS \"${LLVM_LINK}\")\r\n   162    message(FATAL_ERROR \"Failed to find llvm-link at \\\"${LLVM_LINK}\\\"\")\r\n   163  endif()\r\n   164  \r\n   165  # Find llvm-ar\r\n   166  set(LLVM_AR \"${LLVM_TOOLS_BINARY_DIR}/llvm-ar\"\r\n   167    CACHE\r\n   168    PATH\r\n   169    \"Path to bitcode archive tool\"\r\n   170    )\r\n   171  if (NOT EXISTS \"${LLVM_AR}\")\r\n   172    message(FATAL_ERROR \"Failed to find llvm-ar at \\\"${LLVM_AR}\\\"\")\r\n   173  endif()\r\n   174  \r\n   175  # Find llvm-as\r\n   176  set(LLVM_AS \"${LLVM_TOOLS_BINARY_DIR}/llvm-as\"\r\n   177    CACHE\r\n   178    PATH\r\n   179    \"Path to bitcode assembly tool\"\r\n   180    )\r\n   181  if (NOT EXISTS \"${LLVM_AS}\")\r\n   182    message(FATAL_ERROR \"Failed to find llvm-as at \\\"${LLVM_AS}\\\"\")\r\n   183  endif()\r\n   184  \r\n   185  # Check for dynamic linking\r\n   186  if (LLVM_LINK_LLVM_DYLIB)\r\n   187    set(USE_LLVM_SHARED USE_SHARED)\r\n   188  endif()\r\n   189  \r\n   190  ################################################################################\r\n   191  # C++ version\r\n   192  ###############################################"]
[156.967913, "o", "#################################\r\n   193  set(CMAKE_CXX_STANDARD 17)\r\n   194  set(CMAKE_CXX_STANDARD_REQUIRED ON)\r\n   195  \r\n   196  ################################################################################\r\n   197  # Warnings\r\n   198  ################################################################################\r\n   199  include(${CMAKE_SOURCE_DIR}/cmake/compiler_warnings.cmake)\r\n   200  \r\n== uclibc refs ==\r\n/tmp/klee-src/CMakeLists.txt:487:set(KLEE_UCLIBC_PATH \"\" CACHE PATH \"Path to klee-uclibc root directory\")\r\n/tmp/klee-src/CMakeLists.txt:488:set(KLEE_UCLIBC_BCA_NAME \"klee-uclibc.bca\")\r\n/tmp/klee-src/CMakeLists.txt:489:if (NOT KLEE_UCLIBC_PATH STREQUAL \"\")\r\n/tmp/klee-src/CMakeLists.txt:491:  set(KLEE_UCLIBC_C_BCA \"${KLEE_UCLIBC_PATH}/lib/libc.a\")\r\n/tmp/klee-src/CMakeLists.txt:492:  if (NOT EXISTS \"${KLEE_UCLIBC_C_BCA}\")\r\n/tmp/klee-src/CMakeLists.txt:494:      \"klee-uclibc library not found at \\\"${KLEE_UCLIBC_C_BCA}\\\". Set KLEE_UCLIBC_PATH to klee-uclibc root directory or empty \r\nstring.\")\r\n/tmp/klee-src/CMakeLists.txt:496:  message(STATUS \"Found klee-uclibc library: \\\"${KLEE_UCLIBC_C_BCA}\\\"\")\r\n/tmp/klee-src/CMakeLists.txt:497:  # Copy KLEE_UCLIBC_C_BCA so KLEE can find it where it is expected.\r\n/tmp/klee-src/CMakeLists.txt:499:    \"${KLEE_UCLIBC_C_BCA}\"\r\n/tmp/klee-src/CMakeLists.txt:500:    \"${KLEE_RUNTIME_DIRECTORY}/${KLEE_UCLIBC_BCA_NAME}\"\r\n\r\n"]
