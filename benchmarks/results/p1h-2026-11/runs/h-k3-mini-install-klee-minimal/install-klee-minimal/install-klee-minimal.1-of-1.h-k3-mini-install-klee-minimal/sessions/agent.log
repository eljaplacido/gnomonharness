```
bash -lc '
set -e
python3 - <<"PY"
from pathlib import Path
p = Path.home() / ".bashrc"
text = p.read_text()
start = text.index("# KLEE environment (LLVM 16 + STP)")
end = text.index("\n\n# If not running interactively", start)
new_block = """# KLEE environment (LLVM 16 + STP)
case ":${PATH:-}:" in
  *:/usr/local/bin:*) ;;
  *) export PATH="/usr/local/bin${PATH:+:$PATH}" ;;
esac
case ":${CPATH:-}:" in
  *:/usr/local/include:*) ;;
  *) export CPATH="/usr/local/include${CPATH:+:$CPATH}" ;;
esac
