execution using the installed command and header.

```
bash -lc '
set -e
cat > /tmp/klee_env.sh <<"EOF"

# KLEE environment (LLVM 16 + STP)
export PATH="/usr/local/bin:$PATH"
export CPATH="/usr/local/include${CPATH:+:$CPATH}"
export LD_LIBRARY_PATH="/usr/local/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
EOF
if ! grep -q "KLEE environment" ~/.bashrc; then
  sed -i "3r /tmp/klee_env.sh" ~/.bashrc
fi
echo "== top of bashrc =="
nl -ba ~/.bashrc | sed -n "1,20p"
echo "== source test =="
env -i HOME=/root PATH=/usr/bin:/bin bash --noprofile --norc -c "source ~/.bashrc; echo PATH=\$PATH; echo CPATH=\$CPATH; echo LD_LIBRARY_PATH=\$LD_LIBRARY_PATH;
command -v klee; test -r /usr/local/include/klee/klee.h && echo HEADER_OK"
'
