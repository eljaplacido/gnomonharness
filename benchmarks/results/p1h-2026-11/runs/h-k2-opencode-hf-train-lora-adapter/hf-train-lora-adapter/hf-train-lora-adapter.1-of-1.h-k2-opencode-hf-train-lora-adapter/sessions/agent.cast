[9.738424, "o", "> "]
[9.738533, "o", "- /app/experiments/lora_adapter/: Directory containing the LoRA adapter weights and configuration, and can be loaded to generate responses\r\n\u001b[?2004l\r\u001b[?2004h"]
[9.738548, "o", "> "]
