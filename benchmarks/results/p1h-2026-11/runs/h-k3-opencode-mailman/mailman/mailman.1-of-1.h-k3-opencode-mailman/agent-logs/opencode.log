import os, mailbox
from time import sleep
import eval as e

def wait_for(pred, tries=20, delay=1):
    for i in range(tries):
        try:
            if pred(): return True
        except Exception:
            pass
        sleep(delay)
    return False

u = os.urandom(8).hex(); e.add_user(u)
subject = 'Exact subject ' + os.urandom(4).hex()
e.send_email(body='', subject='', from_addr=f'{u}@local.edu', to_addr=e.JOIN_LIST)
assert wait_for(lambda: any('confirm' in (m.get('From') or '') and 'join' in (m.get('Subject') or '') for m in mailbox.mbox(f'/var/mail/{u}')))
