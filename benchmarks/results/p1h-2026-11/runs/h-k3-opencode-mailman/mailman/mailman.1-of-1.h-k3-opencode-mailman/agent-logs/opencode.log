import os, mailbox
from time import sleep
import eval as e

def wait_for(pred, tries=15, delay=1):
    for i in range(tries):
        try:
            if pred(): return True
        except Exception as ex:
            pass
        sleep(delay)
    return False

u = os.urandom(8).hex()
e.add_user(u)
# join
e.send_email(body='', subject='', from_addr=f'{u}@local.edu', to_addr=e.JOIN_LIST)
assert wait_for(lambda: os.path.exists(f'/var/mail/{u}'))
assert wait_for(lambda: any('confirm' in (m.get('From') or '') and 'join' in (m.get('Subject') or '') for m in mailbox.mbox(f'/var/mail/{u}')))
e.confirm_last_reply(u, 'join')
m = e.get_mlist()
assert wait_for(lambda: m.members.get_member(f'{u}@local.edu') is not None)
print('joined', u)

# post announcement
subject = 'Announcement ' + os.urandom(4).hex()
e.send_email(body='hello everyone', subject=subject, from_addr=f'{u}@local.edu', to_addr=e.MAILING_LIST)
def got(subj):
    mb = mailbox.mbox(f'/var/mail/{u}')
    return any(x.get('Subject') == subj for x in mb)
assert wait_for(lambda: got(subject), tries=20)
print('announcement delivered')

# leave - should require confirmation
e.send_email(body='', subject='', from_addr=f'{u}@local.edu', to_addr=e.LEAVE_LIST)
sleep(2)
assert m.members.get_member(f'{u}@local.edu') is not None, 'left without confirmation!'
assert wait_for(lambda: any('confirm' in (x.get('From') or '') and 'leave' in (x.get('Subject') or '') for x in mailbox.mbox(f'/var/mail/{u}')))
print('leave confirmation pending as expected')
e.confirm_last_reply(u, 'leave')
assert wait_for(lambda: m.members.get_member(f'{u}@local.edu') is None)
print('left', u)
PY
