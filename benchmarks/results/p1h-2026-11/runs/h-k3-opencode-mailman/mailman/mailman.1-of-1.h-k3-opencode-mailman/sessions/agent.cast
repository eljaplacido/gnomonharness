[61.028891, "o", "\u001b[0m$ \u001b[0mgrep -n \"default_subscription_policy\\|subscription_policy\\|default_member_action\\|default_nonmember_action\\|unsubscription_policy\" /usr/lib/python3/dist-packages/mailman/config/schema.cfg /usr/lib/python3/dist-packages/mailman/config/mailman.cfg | head -60; echo ===; grep -rn \"default_subscription_policy\\|subscription_policy\" /usr/lib/python3/dist-packages/mailman/styles/ | head\r\n===\r\ngrep: /usr/lib/python3/dist-packages/mailman/styles/tests/__pycache__/test_styles.cpython-312.pyc: binary file matches\r\ngrep: /usr/lib/python3/dist-packages/mailman/styles/__pycache__/base.cpython-312.pyc: binary file matches\r\n/usr/lib/python3/dist-packages/mailman/styles/tests/test_styles.py:84:        self.assertEqual(self.mlist.subscription_policy,\r\n/usr/lib/python3/dist-packages/mailman/styles/base.py:75:        mlist.subscription_policy = SubscriptionPolicy.confirm\r\n/usr/lib/python3/dist-packages/mailman/styles/base.py:76:        mlist.unsubscription_policy = SubscriptionPolicy.confirm\r\n/usr/lib/python3/dist-packages/mailman/styles/base.py:212:        mlist.subscription_policy = SubscriptionPolicy.confirm_then_moderate\r\n"]
[61.774099, "o", "\u001b[0m$ \u001b[0mmailman --help 2>&1 | head -80; echo ===; ls /usr/lib/python3/dist-packages/mailman/commands/; echo ===; sed -n '1,200p' /usr/lib/python3/dist-packages/mailman/commands/cli_create.py 2>/dev/null\r\nUsage: mailman [OPTIONS] COMMAND [ARGS]...\r\n\r\n  The GNU Mailman mailing list management system Copyright 1998-2018 by the\r\n  Free Software Foundation, Inc. http://www.list.org\r\n\r\nOptions:\r\n  --version          Show the version and exit.\r\n  --run-as-root      Running mailman commands as root is not recommended and\r\n                     mailman will refuse to run as root unless this option is\r\n                     specified.\r\n  -C, --config FILE  Configuration file to use.  If not given, the environment\r\n                     variable MAILMAN_CONFIG_FILE is consulted and used if\r\n                     set.  If neither are given, a default configuration file\r\n                     is loaded.\r\n  -h, --help         Show this message and exit.\r\n\r\nCommands:\r\n  addmembers     Add all member addresses in FILENAME with delivery mode...\r\n  aliases        Regenerate the aliases appropriate for your MTA.\r\n  changeaddress  Change a user's email address from old_address to...\r\n  conf           Print the Mailman configuration.\r\n  create         Create a mailing list.\r\n  delmembers     Delete members from a mailing list.\r\n  digests        Operate on digests.\r\n  findmember     Display all memberships for a user or users with address...\r\n  gatenews       Poll the NNTP server for messages to be gatewayed to...\r\n  help           Show this help message and exit.\r\n  import21       Import Mailman 2.1 list data.\r\n  info           Information about this Mailman instance.\r\n  inject         Inject a message from a file into a mailing list's queue.\r\n  lists          List all mailing lists.\r\n  members        Display a mailing list's members.\r\n  notify         Notify list owners/moderators of pending requests.\r\n  qfile          Get information out of a queue file.\r\n  remove         Remove a mailing list.\r\n  reopen         Signal the Mailman processes to re-open their log files.\r\n  restart        Stop and restart the Mailman runner subprocesses.\r\n  shell          Operate on a mailing list.\r\n  start          Start the Mailman master and runner processes.\r\n  status         Show the current running status of the Mailman system.\r\n  stop           Stop the Mailman master and runner processes.\r\n  syncmembers    Add and delete members as necessary to syncronize a...\r\n  unshunt        Unshunt messages.\r\n  version        Display Mailman's version.\r\n  withlist       Operate on a mailing list.\r\n===\r\n__init__.py\r\n__pycache__\r\ncli_addmembers.py\r\ncli_aliases.py\r\ncli_changeaddress.py\r\ncli_conf.py\r\ncli_control.py\r\ncli_delmembers.py\r\ncli_digests.py\r\ncli_findmember.py\r\ncli_gatenews.py\r\ncli_help.py\r\ncli_import.py\r\ncli_info.py\r\ncli_inject.py\r\ncli_lists.py\r\ncli_members.py\r\ncli_notify.py\r\ncli_qfile.py\r\ncli_status.py\r\ncli_syncmembers.py\r\ncli_unshunt.py\r\ncli_version.py\r\ncli_withlist.py\r\neml_confirm.py\r\neml_echo.py\r\neml_end.py\r\neml_help.py\r\neml_membership.py\r\neml_who.py\r\ntests\r\n===\r\n"]
