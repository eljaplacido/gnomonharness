[96.977094, "o", "\u001b[0m$ \u001b[0mmailman shell --help 2>&1 | head -60; echo ===; mailman create --help 2>&1 | head -80\r\nUsage: mailman [OPTIONS] COMMAND [ARGS]...\r\nTry 'mailman -h' for help.\r\n\r\nError: If you are sure you want to run as root, specify --run-as-root.\r\n===\r\nUsage: mailman [OPTIONS] COMMAND [ARGS]...\r\nTry 'mailman -h' for help.\r\n\r\nError: If you are sure you want to run as root, specify --run-as-root.\r\n"]
[97.044903, "o", "\u001b[0m$ \u001b[0mchown -R list:list /var/lib/mailman3 /var/log/mailman3 /run/mailman3 && runuser -u list -- mailman -C /etc/mailman3/mailman.cfg info 2>&1 | head -30; echo ===; runuser -u list -- mailman -C /etc/mailman3/mailman.cfg lists 2>&1 | head -20\r\nGNU Mailman 3.3.8 (Tom Sawyer)\r\nPython 3.12.3 (main, Aug 31 2026, 10:18:26) [GCC 13.3.0]\r\nconfig file: /etc/mailman3/mailman.cfg\r\ndb url: sqlite:////var/lib/mailman3/data/mailman.db\r\ndevmode: DISABLED\r\nREST root url: http://localhost:8001/3.1/\r\nREST credentials: restadmin:HtjrFZfKuq+XKKF6748Ay9BISs+63E8zkTuDVPKo35GibShq\r\n===\r\nNo matching mailing lists found\r\n"]
