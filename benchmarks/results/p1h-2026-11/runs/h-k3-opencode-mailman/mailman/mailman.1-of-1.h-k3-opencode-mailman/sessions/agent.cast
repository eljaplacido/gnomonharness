[353.374378, "o", "\u001b[0m$ \u001b[0mrunuser -u list -- mailman -C /etc/mailman3/mailman.cfg delmembers -l reading-group@local.edu -a --no-goodbye-msg 2>&1; echo ===; runuser -u list -- mailman -C /etc/mailman3/mailman.cfg members reading-group@local.edu 2>&1; echo ===; ls -la /var/mail\r\n===\r\nreading-group.local.edu has no members\r\n===\r\ntotal 20\r\ndrwxrwsr-x 1 root mail 4096 Nov  1 09:26 .\r\ndrwxr-xr-x 1 root root 4096 Apr  4  2025 ..\r\n-rw------- 1 root mail 4802 Nov  1 09:24 root\r\n"]
