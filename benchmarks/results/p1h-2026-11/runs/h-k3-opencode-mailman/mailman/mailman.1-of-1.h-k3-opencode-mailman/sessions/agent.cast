[91.25577, "o", "\u001b[0m← \u001b[0mEdit /etc/mailman3/mailman.cfg\r\nIndex: /etc/mailman3/mailman.cfg\r\n===================================================================\r\n--- /etc/mailman3/mailman.cfg\r\n+++ /etc/mailman3/mailman.cfg\r\n@@ -24,9 +24,9 @@\r\n # This address is the \"site owner\" address.  Certain messages which must be\r\n # delivered to a human, but which can't be delivered to a list owner (e.g. a\r\n # bounce from a list owner), will be sent to this address.  It should point to\r\n # a human.\r\n-site_owner: changeme@example.com\r\n+site_owner: root@local.edu\r\n \r\n # This is the local-part of an email address used in the From field whenever a\r\n # message comes from some entity to which there is no natural reply recipient.\r\n # Mailman will append '@' and the host name of the list involved.  This\r\n\r\n"]
[91.273648, "o", "\u001b[0m← \u001b[0mEdit /etc/postfix/main.cf\r\nIndex: /etc/postfix/main.cf\r\n===================================================================\r\n--- /etc/postfix/main.cf\r\n+++ /etc/postfix/main.cf\r\n@@ -36,11 +36,20 @@\r\n smtpd_relay_restrictions = permit_mynetworks permit_sasl_authenticated defer_unauth_destination\r\n myhostname = localhost.tailf09230.ts.net\r\n alias_maps = hash:/etc/aliases\r\n alias_database = hash:/etc/aliases\r\n-mydestination = $myhostname, localhost, localhost.localdomain, , localhost\r\n+mydomain = local.edu\r\n+myorigin = $mydomain\r\n+mydestination = $myhostname, localhost, localhost.localdomain, localhost, local.edu\r\n relayhost = \r\n mynetworks = 127.0.0.0/8 [::ffff:127.0.0.0]/104 [::1]/128\r\n mailbox_size_limit = 0\r\n recipient_delimiter = +\r\n inet_interfaces = all\r\n inet_protocols = all\r\n+\r\n+# Mailman 3 integration: list addresses are delivered to Mailman's LMTP\r\n+# server, while other addresses in local.edu are delivered to local unix\r\n+# users' mboxes (/var/mail/<username>).\r\n+transport_maps = hash:/var/lib/mailman3/data/postfix_lmtp\r\n+local_recipient_maps = proxy:unix:passwd.byname $alias_maps hash:/var/lib/mailman3/data/postfix_lmtp\r\n+relay_domains = hash:/var/lib/mailman3/data/postfix_domains\r\n\r\n"]
