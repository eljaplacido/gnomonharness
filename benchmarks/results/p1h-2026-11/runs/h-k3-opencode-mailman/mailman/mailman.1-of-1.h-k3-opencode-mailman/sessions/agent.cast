[166.904041, "o", "\u001b[0m$ \u001b[0mfor f in /var/mail/*; do echo \"### $f\"; grep -a -E '^(Subject|From|To):' \"$f\" | tail -20; done\r\n### /var/mail/3704ef16c6b6a274\r\nSubject: Your confirmation is needed to join the reading-group@local.edu\r\nFrom: reading-group-confirm+6d4e9c604d07adfdc870e3652c9843a9e329f1bc@local.edu\r\nTo: 3704ef16c6b6a274@local.edu\r\nSubject: Welcome to the \"Reading-group\" mailing list\r\nFrom: reading-group-request@local.edu\r\nTo: 3704ef16c6b6a274@local.edu\r\nFrom: 3704ef16c6b6a274@local.edu\r\nTo: reading-group@local.edu\r\nSubject: [Reading-group] Announcement 9874e3b3\r\n### /var/mail/939aa543903cf7b0\r\nSubject: Direct Message\r\nFrom: tester@local.edu\r\nTo: 939aa543903cf7b0@local.edu\r\n### /var/mail/b1647eddb317c935\r\nSubject: Your confirmation is needed to join the reading-group@local.edu\r\nFrom: reading-group-confirm+af9f88939049a2a5cb97fd0ed8e4caa40260bb93@local.edu\r\nTo: b1647eddb317c935@local.edu\r\nSubject: Welcome to the \"Reading-group\" mailing list\r\nFrom: reading-group-request@local.edu\r\nTo: b1647eddb317c935@local.edu\r\nFrom: 3704ef16c6b6a274@local.edu\r\nTo: reading-group@local.edu\r\nSubject: [Reading-group] Announcement 9874e3b3\r\n"]
