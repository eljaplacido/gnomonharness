[177.459103, "o", "\u001b[0m$ \u001b[0mcd /app && python3 - <<'PY'\r\nimport os, mailbox\r\nfrom time import sleep\r\nimport eval as e\r\n\r\ndef wait_for(pred, tries=15, delay=1):\r\n    for i in range(tries):\r\n        try:\r\n            if pred(): return True\r\n        except Exception:\r\n            pass\r\n        sleep(delay)\r\n    return False\r\n\r\nu = '3704ef16c6b6a274'\r\nm = e.get_mlist()\r\nassert m.members.get_member(f'{u}@local.edu') is not None\r\ne.send_email(body='', subject='', from_addr=f'{u}@local.edu', to_addr=e.LEAVE_LIST)\r\nprint('leave request sent')\r\nsleep(2)\r\nassert m.members.get_member(f'{u}@local.edu') is not None, 'left without confirmation!'\r\nassert wait_for(lambda: any('confirm' in (x.get('From') or '') and 'leave' in (x.get('Subject') or '') for x in mailbox.mbox(f'/var/mail/{u}')))\r\nprint('leave confirmation pending as expected')\r\ne.confirm_last_reply(u, 'leave')\r\nassert wait_for(lambda: m.members.get_member(f'{u}@local.edu') is None)\r\nprint('left', u)\r\n\r\n# Also verify a non-member post is accepted/distributed (announcement use case)\r\na = 'b1647eddb317c935'  # existing member from eval\r\nsubject = 'Announce ' + os.urandom(4).hex()\r\ne.send_email(body='nonmember announcement', subject=subject, from_addr='outsider@local.edu', to_addr=e.MAILING_LIST)\r\nassert wait_for(lambda: any(( '[Reading-group] '+subject) == x.get('Subject') for x in mailbox.mbox(f'/var/mail/{a}')), tries=20)\r\nprint('nonmember announcement delivered to member')\r\nPY\r\nleave request sent\r\nleave confirmation pending as expected\r\n3704ef16c6b6a274 has 4 messages in their inbox\r\nthe subjects are as follows:\r\n['Your confirmation is needed to join the reading-group@local.edu\\n mailing list.', 'Welcome to the \"Reading-group\" mailing list', '[Reading-group] Announcement 9874e3b3', 'Your confirmation is needed to leave the reading-group@local.edu\\n mailing list.']\r\nFound 1 candidate confirmation messages\r\nMessage details:\r\n  From: reading-group-confirm+2888ef4f25d9897ef21d0b1859e82f0e364275ae@local.edu\r\n  To: 3704ef16c6b6a274@local.edu\r\n  Subject: Your confirmation is needed to leave the reading-group@local.edu\r\n mailing list.\r\n  Body: Email Address Unsubscription Confirmation\r\n\r\nHello, this is the GNU Mailman server at local.edu.\r\n\r\nWe have received an unsubscription request for the email address\r\n\r\n    3704ef16c6b6a274@local.edu\r\n\r\nBefore GNU Mailman can unsubscribe you, you must first confirm your request.\r\nYou can do this by simply replying to this message.\r\n\r\nOr you should include the following line -- and only the following\r\nline -- in a message to reading-group-request@local.edu:\r\n\r\n    confirm 2888ef4f25d9897ef21d0b1859e82f0e364275a...\r\nReply to reading-group-confirm+2888ef4f25d9897ef21d0b1859e82f0e364275ae@local.edu from 3704ef16c6b6a274@local.edu for leave\r\nleft 3704ef16c6b6a274\r\nnonmember announcement delivered to member\r\n"]
