[360.444373, "o", "\u001b[0m$ \u001b[0mss -ltnp 2>/dev/null | grep -E ':25|:8024' || true; ls -la /var/lib/mailman3/data/postfix_lmtp*\r\n-rw-rw---- 1 list list   990 Nov  1 09:26 /var/lib/mailman3/data/postfix_lmtp\r\n-rw-r----- 1 list list 12288 Nov  1 09:26 /var/lib/mailman3/data/postfix_lmtp.db\r\n"]
[361.646082, "o", "\u001b[0m$ \u001b[0mpostfix status 2>&1; runuser -u list -- mailman -C /etc/mailman3/mailman.cfg status 2>&1; echo '--- queue ---'; mailq 2>&1 | tail -3; echo '--- list ---'; runuser -u list -- mailman -C /etc/mailman3/mailman.cfg lists 2>&1; runuser -u list -- mailman -C /etc/mailman3/mailman.cfg members reading-group@local.edu 2>&1; echo '--- config ---'; grep -nE '^site_owner|^incoming:|^lmtp_host:|^lmtp_port:|^smtp_host:|^smtp_port:|^configuration:' /etc/mailman3/mailman.cfg; echo '--- postfix ---'; postconf -n | grep -E 'mydomain|mydestination|myorigin|transport_maps|local_recipient_maps|maillog_file'\r\npostfix/postlog: the Postfix mail system is running: PID: 5326\r\nGNU Mailman is running (master pid: 5133)\r\n--- queue ---\r\nMail queue is empty\r\n--- list ---\r\n1 matching mailing lists found:\r\nreading-group@local.edu\r\nreading-group.local.edu has no members\r\n--- config ---\r\n28:site_owner: root@local.edu\r\n244:incoming: mailman.mta.postfix.LMTP\r\n253:smtp_host: localhost\r\n254:smtp_port: 25\r\n261:lmtp_host: 127.0.0.1\r\n262:lmtp_port: 8024\r\n271:configuration: python:mailman.config.postfix\r\n--- postfix ---\r\nappend_dot_mydomain = no\r\nlocal_recipient_maps = proxy:unix:passwd.byname $alias_maps hash:/var/lib/mailman3/data/postfix_lmtp\r\nmaillog_file = /var/log/postfix.log\r\nmydestination = $myhostname, localhost, localhost.localdomain, localhost, local.edu\r\nmydomain = local.edu\r\nmyorigin = $mydomain\r\ntransport_maps = hash:/var/lib/mailman3/data/postfix_lmtp\r\n"]
