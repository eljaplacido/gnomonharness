[100.852667, "o", "\u001b[0m$ \u001b[0mrunuser -u list -- mailman -C /etc/mailman3/mailman.cfg create --owner root@local.edu reading-group@local.edu 2>&1; echo ===; runuser -u list -- mailman -C /etc/mailman3/mailman.cfg lists 2>&1; echo ===; ls -la /var/lib/mailman3/data; echo ===; cat /var/lib/mailman3/data/postfix_lmtp; echo ===; cat /var/lib/mailman3/data/postfix_domains\r\nCreated mailing list: reading-group@local.edu\r\n===\r\n1 matching mailing lists found:\r\nreading-group@local.edu\r\n===\r\ntotal 312\r\ndrwxrwx--- 1 list list   4096 Nov  1 09:22 .\r\ndrwxr-xr-x 1 list list   4096 Nov  1 09:21 ..\r\n-rw-rw---- 1 list list 270336 Nov  1 09:22 mailman.db\r\n-rw-rw---- 1 list list    335 Nov  1 09:22 postfix_domains\r\n-rw-r----- 1 list list  12288 Nov  1 09:22 postfix_domains.db\r\n-rw-rw---- 1 list list    990 Nov  1 09:22 postfix_lmtp\r\n-rw-r----- 1 list list  12288 Nov  1 09:22 postfix_lmtp.db\r\n===\r\n# AUTOMATICALLY GENERATED BY MAILMAN ON 2026-11-01 09:22:17\r\n#\r\n# This file is generated by Mailman, and is kept in sync with the binary hash\r\n# file.  YOU SHOULD NOT MANUALLY EDIT THIS FILE unless you know what you're\r\n# doing, and can keep the two files properly in sync.  If you screw it up,\r\n# you're on your own.\r\n    \r\n# Aliases which are visible only in the @local.edu domain.\r\nreading-group@local.edu                       lmtp:[127.0.0.1]:8024\r\nreading-group-bounces@local.edu               lmtp:[127.0.0.1]:8024\r\nreading-group-confirm@local.edu               lmtp:[127.0.0.1]:8024\r\nreading-group-join@local.edu                  lmtp:[127.0.0.1]:8024\r\nreading-group-leave@local.edu                 lmtp:[127.0.0.1]:8024\r\nreading-group-owner@local.edu                 lmtp:[127.0.0.1]:8024\r\nreading-group-request@local.edu               lmtp:[127.0.0.1]:8024\r\nreading-group-subscribe@local.edu             lmtp:[127.0.0.1]:8024\r\nreading-group-unsubscribe@local.edu           lmtp:[127.0.0.1]:8024\r\n\r\n===\r\n# AUTOMATICALLY GENERATED BY MAILMAN ON 2026-11-01 09:22:17\r\n#\r\n# This file is generated by Mailman, and is kept in sync with the binary hash\r\n# file.  YOU SHOULD NOT MANUALLY EDIT THIS FILE unless you know what you're\r\n# doing, and can keep the two files properly in sync.  If you screw it up,\r\n# you're on your own.\r\n\r\nlocal.edu local.edu\r\n"]
