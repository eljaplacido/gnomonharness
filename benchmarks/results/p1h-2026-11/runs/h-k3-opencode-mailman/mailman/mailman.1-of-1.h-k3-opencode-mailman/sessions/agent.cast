[310.720943, "o", "\u001b[0m$ \u001b[0mcd /app && python3 - <<'PY'\r\nimport os, mailbox\r\nfrom time import sleep\r\nimport eval as e\r\n\r\ndef wait_for(pred, tries=20, delay=1):\r\n    for i in range(tries):\r\n        try:\r\n            if pred(): return True\r\n        except Exception:\r\n            pass\r\n        sleep(delay)\r\n    return False\r\n\r\nu = os.urandom(8).hex(); e.add_user(u)\r\nsubject = 'Exact subject ' + os.urandom(4).hex()\r\ne.send_email(body='', subject='', from_addr=f'{u}@local.edu', to_addr=e.JOIN_LIST)\r\nassert wait_for(lambda: any('confirm' in (m.get('From') or '') and 'join' in (m.get('Subject') or '') for m in mailbox.mbox(f'/var/mail/{u}')))\r\ne.confirm_last_reply(u, 'join')\r\nm = e.get_mlist()\r\nassert wait_for(lambda: m.members.get_member(f'{u}@local.edu') is not None)\r\nprint('joined')\r\ne.send_email(body='body', subject=subject, from_addr=f'{u}@local.edu', to_addr=e.MAILING_LIST)\r\nassert wait_for(lambda: any(x.get('Subject') == subject for x in mailbox.mbox(f'/var/mail/{u}')))\r\nprint('exact list subject delivered')\r\ne.send_email(body='', subject='', from_addr=f'{u}@local.edu', to_addr=e.LEAVE_LIST)\r\nsleep(2)\r\nassert m.members.get_member(f'{u}@local.edu') is not None\r\nassert wait_for(lambda: any('confirm' in (x.get('From') or '') and 'leave' in (x.get('Subject') or '') for x in mailbox.mbox(f'/var/mail/{u}')))\r\ne.confirm_last_reply(u, 'leave')\r\nassert wait_for(lambda: m.members.get_member(f'{u}@local.edu') is None)\r\nprint('left after confirmation')\r\nPY\r\n5bae6a85aa11b1e2 added successfully.\r\n5bae6a85aa11b1e2 has 1 messages in their inbox\r\nthe subjects are as follows:\r\n['Your confirmation is needed to join the reading-group@local.edu\\n mailing list.']\r\nFound 1 candidate confirmation messages\r\nMessage details:\r\n  From: reading-group-confirm+4723586af8a5de63ca005c40838c53cca44ddc3e@local.edu\r\n  To: 5bae6a85aa11b1e2@local.edu\r\n  Subject: Your confirmation is needed to join the reading-group@local.edu\r\n mailing list.\r\n  Body: Email Address Registration Confirmation\r\n\r\nHello, this is the GNU Mailman server at local.edu.\r\n\r\nWe have received a registration request for the email address\r\n\r\n    5bae6a85aa11b1e2@local.edu\r\n\r\nBefore you can start using GNU Mailman at this site, you must first confirm\r\nthat this is your email address.  You can do this by replying to this message.\r\n\r\nOr you should include the following line -- and only the following\r\nline -- in a message to reading-group-request@local.edu:\r\n\r\n    confirm 4723586af8a5de63ca...\r\nReply to reading-group-confirm+4723586af8a5de63ca005c40838c53cca44ddc3e@local.edu from 5bae6a85aa11b1e2@local.edu for join\r\njoined\r\nexact list subject delivered\r\n5bae6a85aa11b1e2 has 4 messages in their inbox\r\nthe subjects are as follows:\r\n['Your confirmation is needed to join the reading-group@local.edu\\n mailing list.', 'Welcome to the \"Reading-group\" mailing list', 'Exact subject a4bcf7c4', 'Your confirmation is needed to leave the reading-group@local.edu\\n mailing list.']\r\nFound 1 candidate confirmation messages\r\nMessage details:\r\n  From: reading-group-confirm+ff803cf0c59f2f6696c8d6b7ac3472ce5e109dfe@local.edu\r\n  To: 5bae6a85aa11b1e2@local.edu\r\n  Subject: Your confirmation is needed to leave the reading-group@local.edu\r\n mailing list.\r\n  Body: Email Address Unsubscription Confirmation\r\n\r\nHello, this is the GNU Mailman server at local.edu.\r\n\r\nWe have received an unsubscription request for the email address\r\n\r\n    5bae6a85aa11b1e2@local.edu\r\n\r\nBefore GNU Mailman can unsubscribe you, you must first confirm your request.\r\nYou can do this by simply replying to this message.\r\n\r\nOr you should include the following line -- and only the following\r\nline -- in a message to reading-group-request@local.edu:\r\n\r\n    confirm ff803cf0c59f2f6696c8d6b7ac3472ce5e109df...\r\nReply to reading-group-confirm+ff803cf0c59f2f6696c8d6b7ac3472ce5e109dfe@local.edu from 5bae6a85aa11b1e2@local.edu for leave\r\nleft after confirmation\r\n"]
