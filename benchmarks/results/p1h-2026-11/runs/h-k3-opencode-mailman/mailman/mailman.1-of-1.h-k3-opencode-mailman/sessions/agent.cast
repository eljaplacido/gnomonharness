[365.364402, "o", "\u001b[0m$ \u001b[0mwhich ss; ss -ltn 2>&1 | head -20; echo ===; python3 - <<'PY'\r\nimport socket\r\nfor p in (25,8024):\r\n    s=socket.socket(); s.settimeout(2)\r\n    try:\r\n        s.connect(('127.0.0.1',p)); print(p,'open')\r\n    except Exception as e: print(p,'FAIL',e)\r\n    finally: s.close()\r\nPY\r\necho ===; ps -ef | grep -E 'postfix/sbin/master|mailman3/bin/master|runner.*lmtp' | grep -v grep\r\n/bin/bash: line 1: ss: command not found\r\n===\r\n25 open\r\n8024 open\r\n===\r\nlist        5133       1  0 09:22 ?        00:00:00 /usr/bin/python3 /usr/lib/mailman3/bin/master --force -C /etc/mailman3/mailman.cfg\r\nlist        5143    5133  0 09:22 ?        00:00:00 /usr/bin/python3 /usr/lib/mailman3/bin/runner -C /etc/mailman3/mailman.cfg --runner=lmtp:0:1\r\nroot        5326       1  0 09:22 ?        00:00:00 /usr/lib/postfix/sbin/master -w\r\n"]
