[369.952827, "o", "\u001b[0m$ \u001b[0mls -la /etc/init.d | grep -Ei 'postfix|mailman'; echo ===; ls -la /etc/rc*.d 2>/dev/null | grep -Ei 'postfix|mailman' | head; echo ===; which service update-rc.d\r\n-rwxr-xr-x 1 root root 4477 Aug 21  2023 mailman3\r\n-rwxr-xr-x 1 root root 3089 Mar  5  2024 postfix\r\n===\r\nlrwxrwxrwx 1 root root   18 Oct 31 12:15 K01mailman3 -> ../init.d/mailman3\r\nlrwxrwxrwx 1 root root   17 Oct 31 12:15 K01postfix -> ../init.d/postfix\r\nlrwxrwxrwx 1 root root   18 Oct 31 12:15 K01mailman3 -> ../init.d/mailman3\r\nlrwxrwxrwx 1 root root   17 Oct 31 12:15 K01postfix -> ../init.d/postfix\r\nlrwxrwxrwx 1 root root   18 Oct 31 12:15 S01mailman3 -> ../init.d/mailman3\r\nlrwxrwxrwx 1 root root   17 Oct 31 12:15 S01postfix -> ../init.d/postfix\r\nlrwxrwxrwx 1 root root   18 Oct 31 12:15 S01mailman3 -> ../init.d/mailman3\r\nlrwxrwxrwx 1 root root   17 Oct 31 12:15 S01postfix -> ../init.d/postfix\r\nlrwxrwxrwx 1 root root   18 Oct 31 12:15 S01mailman3 -> ../init.d/mailman3\r\nlrwxrwxrwx 1 root root   17 Oct 31 12:15 S01postfix -> ../init.d/postfix\r\n===\r\n/usr/sbin/service\r\n/usr/sbin/update-rc.d\r\n"]
