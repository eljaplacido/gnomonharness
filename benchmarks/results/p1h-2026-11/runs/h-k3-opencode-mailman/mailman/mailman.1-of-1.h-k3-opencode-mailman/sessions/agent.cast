[28.470944, "o", "\u001b[0m$ \u001b[0mls /usr/lib/python3/dist-packages/mailman/config/; echo ===; sed -n '1,200p' /usr/lib/python3/dist-packages/mailman/config/postfix.cfg 2>/dev/null; echo ===; find /usr/lib/python3/dist-packages/mailman -name '*postfix*'\r\n__init__.py\r\n__pycache__\r\nalembic.cfg\r\nconfig.py\r\nconfigure.zcml\r\nexim4.cfg\r\ngunicorn.cfg\r\nmail_archive.cfg\r\nmailman.cfg\r\nmhonarc.cfg\r\npasslib.cfg\r\npostfix.cfg\r\nschema.cfg\r\ntests\r\n===\r\n[postfix]\r\n# Additional configuration variables for the postfix MTA.\r\n\r\n# This variable describe the program to use for regenerating the transport map\r\n# db file, from the associated plain text files.  The file being updated will\r\n# be appended to this string (with a separating space), so it must be\r\n# appropriate for os.system().\r\npostmap_command: /usr/sbin/postmap\r\n\r\n# This variable describes the type of transport maps that will be generated by\r\n# mailman to be used with postfix for LMTP transport. By default, it is set to\r\n# hash, but mailman also supports `regex` tables.\r\ntransport_file_type: hash\r\n===\r\n/usr/lib/python3/dist-packages/mailman/mta/__pycache__/postfix.cpython-312.pyc\r\n/usr/lib/python3/dist-packages/mailman/mta/postfix.py\r\n/usr/lib/python3/dist-packages/mailman/config/postfix.cfg\r\n"]
[28.738385, "o", "\u001b[0m$ \u001b[0mdpkg -L mailman3 | grep -Ei 'postfix|alias|cfg|service|systemd|tmpfile'; echo ===; systemctl list-unit-files 2>&1 | grep -Ei 'mailman|postfix'; echo ===; ls -la /usr/lib/mailman3/bin | head -40\r\n/usr/lib/python3/dist-packages/mailman/commands/cli_aliases.py\r\n/usr/lib/python3/dist-packages/mailman/commands/tests/data/no-runners.cfg\r\n/usr/lib/python3/dist-packages/mailman/config/alembic.cfg\r\n/usr/lib/python3/dist-packages/mailman/config/exim4.cfg\r\n/usr/lib/python3/dist-packages/mailman/config/gunicorn.cfg\r\n/usr/lib/python3/dist-packages/mailman/config/mail_archive.cfg\r\n/usr/lib/python3/dist-packages/mailman/config/mailman.cfg\r\n/usr/lib/python3/dist-packages/mailman/config/mhonarc.cfg\r\n/usr/lib/python3/dist-packages/mailman/config/passlib.cfg\r\n/usr/lib/python3/dist-packages/mailman/config/postfix.cfg\r\n/usr/lib/python3/dist-packages/mailman/config/schema.cfg\r\n/usr/lib/python3/dist-packages/mailman/database/alembic/versions/dfe82cf73702_add_alias_domain.py\r\n/usr/lib/python3/dist-packages/mailman/mta/aliases.py\r\n/usr/lib/python3/dist-packages/mailman/mta/postfix.py\r\n/usr/lib/python3/dist-packages/mailman/mta/tests/test_aliases.py\r\n/usr/lib/python3/dist-packages/mailman/plugins/testing/alternate.cfg\r\n/usr/lib/python3/dist-packages/mailman/plugins/testing/hooks.cfg\r\n/usr/lib/python3/dist-packages/mailman/plugins/testing/rest.cfg\r\n/usr/lib/python3/dist-packages/mailman/testing/mail_archive.cfg\r\n/usr/lib/python3/dist-packages/mailman/testing/mhonarc.cfg\r\n/usr/lib/python3/dist-packages/mailman/testing/passlib.cfg\r\n/usr/lib/python3/dist-packages/mailman/testing/testing.cfg\r\n/usr/lib/systemd\r\n/usr/lib/systemd/system\r\n/usr/lib/systemd/system/mailman3.service\r\n/usr/lib/tmpfiles.d\r\n/usr/lib/tmpfiles.d/mailman3.conf\r\n/usr/share/mailman3/mailman.cfg.sample\r\n/usr/share/mailman3/mailman_cfg_hyperkitty_snippet.cfg\r\n===\r\npostfix-resolvconf.path                      disabled enabled\r\nmailman3.service                             enabled  enabled\r\npostfix-resolvconf.service                   disabled enabled\r\npostfix.service                              enabled  enabled\r\npostfix@.service                             disabled enabled\r\n===\r\ntotal 20\r\ndrwxr-xr-x 2 root root 4096 Oct 31 12:15 .\r\ndrwxr-xr-x 3 root root 4096 Oct 31 12:15 ..\r\n-rwxr-xr-x 1 root root  958 Aug 25  2024 mailman\r\n-rwxr-xr-x 1 root root  956 Aug 25  2024 master\r\n-rwxr-xr-x 1 root root  956 Aug 25  2024 runner\r\n"]
