[198.928636, "o", "\u001b[0m← \u001b[0mEdit /etc/postfix/main.cf\r\nIndex: /etc/postfix/main.cf\r\n===================================================================\r\n--- /etc/postfix/main.cf\r\n+++ /etc/postfix/main.cf\r\n@@ -51,5 +51,4 @@\r\n # server, while other addresses in local.edu are delivered to local unix\r\n # users' mboxes (/var/mail/<username>).\r\n transport_maps = hash:/var/lib/mailman3/data/postfix_lmtp\r\n local_recipient_maps = proxy:unix:passwd.byname $alias_maps hash:/var/lib/mailman3/data/postfix_lmtp\r\n-relay_domains = hash:/var/lib/mailman3/data/postfix_domains\r\n\r\n"]
[199.543502, "o", "\u001b[0m$ \u001b[0mrunuser -u list -- python3 - <<'PY'\r\nfrom mailman.core.initialize import initialize\r\ninitialize('/etc/mailman3/mailman.cfg')\r\nfrom mailman.interfaces.listmanager import IListManager\r\nfrom mailman.database.transaction import transaction\r\nfrom zope.component import getUtility\r\nmlist = getUtility(IListManager).get('reading-group@local.edu')\r\nwith transaction():\r\n    mlist.subject_prefix = ''\r\nprint('subject_prefix=%r' % mlist.subject_prefix)\r\nPY\r\nsubject_prefix=''\r\n"]
