[160.873777, "o", "\u001b[0m$ \u001b[0mcd /app && python3 - <<'PY'\r\nimport os, mailbox\r\nfrom time import sleep\r\nimport eval as e\r\n\r\ndef wait_for(pred, tries=15, delay=1):\r\n    for i in range(tries):\r\n        try:\r\n            if pred(): return True\r\n        except Exception as ex:\r\n            pass\r\n        sleep(delay)\r\n    return False\r\n\r\nu = os.urandom(8).hex()\r\ne.add_user(u)\r\n# join\r\ne.send_email(body='', subject='', from_addr=f'{u}@local.edu', to_addr=e.JOIN_LIST)\r\nassert wait_for(lambda: os.path.exists(f'/var/mail/{u}'))\r\nassert wait_for(lambda: any('confirm' in (m.get('From') or '') and 'join' in (m.get('Subject') or '') for m in mailbox.mbox(f'/var/mail/{u}')))\r\ne.confirm_last_reply(u, 'join')\r\nm = e.get_mlist()\r\nassert wait_for(lambda: m.members.get_member(f'{u}@local.edu') is not None)\r\nprint('joined', u)\r\n\r\n# post announcement\r\nsubject = 'Announcement ' + os.urandom(4).hex()\r\ne.send_email(body='hello everyone', subject=subject, from_addr=f'{u}@local.edu', to_addr=e.MAILING_LIST)\r\ndef got(subj):\r\n    mb = mailbox.mbox(f'/var/mail/{u}')\r\n    return any(x.get('Subject') == subj for x in mb)\r\nassert wait_for(lambda: got(subject), tries=20)\r\nprint('announcement delivered')\r\n\r\n# leave - should require confirmation\r\ne.send_email(body='', subject='', from_addr=f'{u}@local.edu', to_addr=e.LEAVE_LIST)\r\nsleep(2)\r\nassert m.members.get_member(f'{u}@local.edu') is not None, 'left without confirmation!'\r\nassert wait_for(lambda: any('confirm' in (x.get('From') or '') and 'leave' in (x.get('Subject') or '') for x in mailbox.mbox(f'/var/mail/{u}')))\r\nprint('leave confirmation pending as expected')\r\ne.confirm_last_reply(u, 'leave')\r\nassert wait_for(lambda: m.members.get_member(f'{u}@local.edu') is None)\r\nprint('left', u)\r\nPY\r\n3704ef16c6b6a274 added successfully.\r\n3704ef16c6b6a274 has 1 messages in their inbox\r\nthe subjects are as follows:\r\n['Your confirmation is needed to join the reading-group@local.edu\\n mailing list.']\r\nFound 1 candidate confirmation messages\r\nMessage details:\r\n  From: reading-group-confirm+6d4e9c604d07adfdc870e3652c9843a9e329f1bc@local.edu\r\n  To: 3704ef16c6b6a274@local.edu\r\n  Subject: Your confirmation is needed to join the reading-group@local.edu\r\n mailing list.\r\n  Body: Email Address Registration Confirmation\r\n\r\nHello, this is the GNU Mailman server at local.edu.\r\n\r\nWe have received a registration request for the email address\r\n\r\n    3704ef16c6b6a274@local.edu\r\n\r\nBefore you can start using GNU Mailman at this site, you must first confirm\r\nthat this is your email address.  You can do this by replying to this message.\r\n\r\nOr you should include the following line -- and only the following\r\nline -- in a message to reading-group-request@local.edu:\r\n\r\n    confirm 6d4e9c604d07adfdc8...\r\nReply to reading-group-confirm+6d4e9c604d07adfdc870e3652c9843a9e329f1bc@local.edu from 3704ef16c6b6a274@local.edu for join\r\njoined 3704ef16c6b6a274\r\nTraceback (most recent call last):\r\n  File \"<stdin>\", line 31, in <module>\r\nAssertionError\r\n"]
