[85.405003, "o", "\u001b[0m$ \u001b[0mgrep -n \"def aliases\\|join\\|leave\\|confirm\" /usr/lib/python3/dist-packages/mailman/mta/aliases.py | head -40; sed -n '1,140p' /usr/lib/python3/dist-packages/mailman/mta/aliases.py\r\n27:    'confirm',\r\n28:    'join',\r\n29:    'leave',\r\n42:    def aliases(self, mlist):\r\n# Copyright (C) 2011-2023 by the Free Software Foundation, Inc.\r\n#\r\n# This file is part of GNU Mailman.\r\n#\r\n# GNU Mailman is free software: you can redistribute it and/or modify it under\r\n# the terms of the GNU General Public License as published by the Free\r\n# Software Foundation, either version 3 of the License, or (at your option)\r\n# any later version.\r\n#\r\n# GNU Mailman is distributed in the hope that it will be useful, but WITHOUT\r\n# ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or\r\n# FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License for\r\n# more details.\r\n#\r\n# You should have received a copy of the GNU General Public License along with\r\n# GNU Mailman.  If not, see <https://www.gnu.org/licenses/>.\r\n\r\n\"\"\"Utility for generating all the aliases of a mailing list.\"\"\"\r\n\r\nfrom mailman.interfaces.mta import IMailTransportAgentAliases\r\nfrom public import public\r\nfrom zope.interface import implementer\r\n\r\n\r\nSUBDESTINATIONS = (\r\n    'bounces',\r\n    'confirm',\r\n    'join',\r\n    'leave',\r\n    'owner',\r\n    'request',\r\n    'subscribe',\r\n    'unsubscribe',\r\n    )\r\n\r\n\r\n@public\r\n@implementer(IMailTransportAgentAliases)\r\nclass MailTransportAgentAliases:\r\n    \"\"\"Utility for generating all the aliases of a mailing list.\"\"\"\r\n\r\n    def aliases(self, mlist):\r\n        \"\"\"See `IMailTransportAgentAliases`.\"\"\"\r\n        # Always return\r\n        yield mlist.posting_address\r\n        for destination in sorted(SUBDESTINATIONS):\r\n            yield '{}-{}@{}'.format(\r\n                mlist.list_name, destination, mlist.mail_host)\r\n\r\n    def destinations(self, mlist):\r\n        \"\"\"See `IMailTransportAgentAliases`.\"\"\"\r\n        # Always return\r\n        yield mlist.list_name\r\n        for destination in sorted(SUBDESTINATIONS):\r\n            yield '{}-{}'.format(mlist.list_name, destination)\r\n"]
[85.433122, "o", "\u001b[0m$ \u001b[0mwhich runuser su; cat /etc/aliases | tail -20; ls -la /run/mailman3 2>&1; ls -la /run | head\r\n/usr/sbin/runuser\r\n/usr/bin/su\r\n# See man 5 aliases for format\r\npostmaster:    root\r\ntotal 12\r\ndrwxr-xr-x 2 list list 4096 Oct 31 12:15 .\r\ndrwxr-xr-x 1 root root 4096 Oct 31 12:15 ..\r\ntotal 44\r\ndrwxr-xr-x 1 root root 4096 Oct 31 12:15 .\r\ndrwxr-xr-x 1 root root 4096 Nov  1 09:20 ..\r\n-rw-r--r-- 1 root root    0 Oct 31 12:15 adduser\r\ndrwxr-xr-x 3 root root 4096 Oct 31 12:15 dbus\r\ndrwxrwxrwt 1 root root 4096 Oct 31 12:15 lock\r\ndrwxr-xr-x 2 root root 4096 Oct 31 12:15 log\r\ndrwxr-xr-x 2 list list 4096 Oct 31 12:15 mailman3\r\ndrwxr-xr-x 2 root root 4096 Oct 31 12:15 sendsigs.omit.d\r\ndrwxr-xr-x 2 root root 4096 Oct 31 12:15 setrans\r\n"]
