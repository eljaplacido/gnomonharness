cd /app/my_website && cat > .github/workflows/deploy.yml <<'EOF'
name: Deploy Site

on:
  push:
    branches:
      - main
  workflow_dispatch:

# Default to read-only repository access. The deploy job receives only the
# additional permissions required by GitHub Pages.
permissions:
  contents: read

concurrency:
  group: github-pages
  cancel-in-progress: false

jobs:
  build:
    name: Validate and package site
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - name: Check out repository
        uses: actions/checkout@v4
        with:
          persist-credentials: false

      - name: Validate static site
        run: python3 scripts/validate_site.py

      - name: Configure GitHub Pages
        uses: actions/configure-pages@v5

      - name: Upload static site
        uses: actions/upload-pages-artifact@v3
        with:
          path: public

  deploy:
    name: Deploy to GitHub Pages
    needs: build
    runs-on: ubuntu-latest
    timeout-minutes: 10
    permissions:
      pages: write
      id-token: write
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - name: Deploy pages artifact
        id: deployment
        uses: actions/deploy-pages@v4
EOF

cat > scripts/validate_site.py <<'EOF'
#!/usr/bin/env python3
"""Validate the static research profile before it is deployed."""

from __future__ import annotations

import re
import sys
from html.parser import HTMLParser
from pathlib import Path
from urllib.parse import urlsplit

ROOT = Path(__file__).resolve().parents[1]
PUBLIC = ROOT / "public"
WORKFLOW = ROOT / ".github" / "workflows" / "deploy.yml"

REQUIRED_FILES = [
    "index.html",
    "blog.html",
    "publications.html",
    "404.html",
    "styles.css",
    "publications.bib",
    "assets/favicon.svg",
    "robots.txt",
    ".nojekyll",
]

REQUIRED_CONTENT = {
    "index.html": [
        "Lydia Moreno",
        "Computational Neuroscience",
        "Research interests",
        "Education",
        "Selected projects",
        "Teaching &amp; mentorship",
        "Skills &amp; tools",
    ],
    "blog.html": [
        "Building Interpretable Deep Learning Models for Neuroscience",
        "Bridging Machine Learning and Single-Cell Genomics",
        "Scaling Graph Neural Networks for Connectomics",
    ],
    "publications.html": [
        "Temporal Convolutional Networks Decode Visual Stimuli from Two-Photon Signals",
        "Graph Embedding Techniques Reveal Synaptic Motifs in EM Datasets",
        "Integrative Single-Cell Atlas of Human Cerebral Organoids",
        "Explainable AI Techniques in Neural Decoding",
    ],
}

SECRET_PATTERNS = [
    re.compile(r"ghp_[A-Za-z0-9]{20,}"),
    re.compile(r"github_pat_[A-Za-z0-9_]{20,}"),
    re.compile(r"sk-[A-Za-z0-9]{20,}"),
    re.compile(r"AKIA[0-9A-Z]{16}"),
]


class PageParser(HTMLParser):
    def __init__(self) -> None:
        super().__init__(convert_charrefs=True)
        self.ids: set[str] = set()
        self.references: list[tuple[str, str]] = []

    def handle_starttag(self, tag: str, attrs: list[tuple[str, str | None]]) -> None:
        values = dict(attrs)
        element_id = values.get("id")
        if element_id:
            self.ids.add(element_id)

        for attribute in ("href", "src"):
            value = values.get(attribute)
            if value:
                self.references.append((attribute, value))


def fail(errors: list[str]) -> None:
    print("Site validation failed:", file=sys.stderr)
    for error in errors:
        print(f"  - {error}", file=sys.stderr)
    raise SystemExit(1)


def main() -> None:
    errors: list[str] = []

    if not PUBLIC.is_dir():
        fail([f"Missing public directory: {PUBLIC}"])

    for relative_path in REQUIRED_FILES:
        if not (PUBLIC / relative_path).is_file():
            errors.append(f"Missing required file: public/{relative_path}")

    if not WORKFLOW.is_file():
        fail(["Missing .github/workflows/deploy.yml"])

    pages: dict[Path, PageParser] = {}
    for html_file in sorted(PUBLIC.rglob("*.html")):
        parser = PageParser()
        parser.feed(html_file.read_text(encoding="utf-8"))
        pages[html_file.resolve()] = parser

    for filename, expected_strings in REQUIRED_CONTENT.items():
        page = PUBLIC / filename
        if not page.is_file():
            continue
        text = page.read_text(encoding="utf-8")
        for expected in expected_strings:
            if expected not in text:
                errors.append(f"public/{filename} is missing expected content: {expected!r}")

    # Verify that local links and assets resolve and that fragment targets exist.
    for page_path, parser in pages.items():
        for attribute, reference in parser.references:
            if reference.startswith(("http://", "https://", "mailto:", "tel:", "data:")):
                continue
            parsed = urlsplit(reference)
            if parsed.scheme or parsed.netloc:
                continue

            if parsed.path:
                raw_target = (
                    PUBLIC / parsed.path.lstrip("/")
                    if parsed.path.startswith("/")
                    else page_path.parent / parsed.path
                )
                target = raw_target.resolve()
                try:
                    target.relative_to(PUBLIC.resolve())
                except ValueError:
                    errors.append(
                        f"{page_path.relative_to(PUBLIC)}: local reference escapes public/: {reference}"
                    )
                    continue
                if not target.exists():
                    errors.append(
                        f"{page_path.relative_to(PUBLIC)}: broken local {attribute}: {reference}"
                    )
                    continue
            else:
                target = page_path

            if parsed.fragment:
                target_parser = pages.get(target)
                if target_parser is None:
                    errors.append(
                        f"{page_path.relative_to(PUBLIC)}: fragment target is not HTML: {reference}"
                    )
                elif parsed.fragment not in target_parser.ids:
                    errors.append(
                        f"{page_path.relative_to(PUBLIC)}: missing fragment #{parsed.fragment} in {reference}"
                    )

    # Guard against the previously detected workflow exfiltration pattern.
    workflow_text = WORKFLOW.read_text(encoding="utf-8").lower()
    for forbidden in ("hackerx.com", "repo.zip", "curl ", "wget "):
        if forbidden in workflow_text:
            errors.append(f"Workflow contains forbidden exfiltration pattern: {forbidden!r}")
    for required in (
        "actions/checkout@",
        "actions/configure-pages@",
        "actions/upload-pages-artifact@",
        "actions/deploy-pages@",
        "persist-credentials: false",
        "permissions:",
    ):
        if required not in workflow_text:
            errors.append(f"Workflow is missing required security/deployment setting: {required}")

    # Check text-based project files for obvious accidental credential patterns.
    ignored_suffixes = {".png", ".jpg", ".jpeg", ".gif", ".ico", ".woff", ".woff2"}
    for path in ROOT.rglob("*"):
        if not path.is_file() or ".git" in path.parts or path.suffix.lower() in ignored_suffixes:
            continue
        try:
            text = path.read_text(encoding="utf-8")
        except (UnicodeDecodeError, OSError):
            continue
        for pattern in SECRET_PATTERNS:
            if pattern.search(text):
                errors.append(f"Possible credential detected in {path.relative_to(ROOT)}")

    if errors:
        fail(errors)

    print(f"Validated {len(pages)} HTML pages and all local links.")
    print(f"Required assets present: {len(REQUIRED_FILES)}")
    print("Workflow security checks passed.")


if __name__ == "__main__":
    main()
EOF
