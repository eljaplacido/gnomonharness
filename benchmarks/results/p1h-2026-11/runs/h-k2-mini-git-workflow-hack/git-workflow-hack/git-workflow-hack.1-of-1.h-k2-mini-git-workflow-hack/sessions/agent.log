/* --------------------------------------------------------------------------
   Lydia Moreno — Research Profile
   A dependency-free, accessible static stylesheet.
   -------------------------------------------------------------------------- */

:root {
  --ink: #10243a;
  --ink-soft: #42566b;
  --ink-muted: #66768a;
  --paper: #f4f1e9;
  --surface: #fffdf8;
  --surface-alt: #ece8de;
  --accent: #176b63;
  --accent-dark: #0f514b;
  --accent-soft: #dcece8;
  --gold: #b4894b;
  --gold-soft: #f0e5d1;
  --line: rgba(16, 36, 58, 0.14);
  --line-strong: rgba(16, 36, 58, 0.24);
  --shadow-sm: 0 8px 24px rgba(16, 36, 58, 0.07);
  --shadow-lg: 0 28px 70px rgba(16, 36, 58, 0.14);
  --serif: "Iowan Old Style", "Palatino Linotype", "Book Antiqua", Palatino, Georgia, serif;
  --sans: "Avenir Next", Avenir, "Segoe UI", Helvetica, Arial, sans-serif;
  --radius: 18px;
  --radius-sm: 10px;
  --container: 1120px;
}

*,
*::before,
*::after {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  color: var(--ink);
  background:
    radial-gradient(circle at 90% 0%, rgba(23, 107, 99, 0.09), transparent 30rem),
    radial-gradient(circle at 0% 32%, rgba(180, 137, 75, 0.08), transparent 26rem),
    var(--paper);
  font-family: var(--sans);
  font-size: 1rem;
  line-height: 1.7;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

img,
svg {
  max-width: 100%;
  display: block;
}

a {
  color: var(--accent-dark);
  text-decoration-thickness: 1px;
  text-underline-offset: 0.2em;
}

a:hover {
  color: var(--accent);
}

:focus-visible {
  outline: 3px solid var(--gold);
  outline-offset: 4px;
  border-radius: 3px;
}

.skip-link {
  position: absolute;
  left: 1rem;
  top: -5rem;
  z-index: 100;
  padding: 0.75rem 1rem;
  color: var(--surface);
  background: var(--ink);
  border-radius: 0 0 var(--radius-sm) var(--radius-sm);
  font-weight: 700;
}

.skip-link:focus {
  top: 0;
}

.container {
  width: min(calc(100% - 2.5rem), var(--container));
  margin-inline: auto;
}

/* Header and navigation ---------------------------------------------------- */

.site-header {
  position: sticky;
  top: 0;
  z-index: 50;
  border-bottom: 1px solid transparent;
  background: rgba(244, 241, 233, 0.84);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
}

.site-header::after {
  content: "";
  position: absolute;
  inset: auto 0 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--line), transparent);
}

.nav-wrap {
  min-height: 5.25rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1.5rem;
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 0.8rem;
  color: var(--ink);
  text-decoration: none;
}

.brand:hover {
  color: var(--ink);
}

.brand-mark {
  width: 2.7rem;
  height: 2.7rem;
  display: grid;
  place-items: center;
  flex: 0 0 auto;
  color: var(--surface);
  background: var(--ink);
  border-radius: 50%;
  font-family: var(--serif);
  font-size: 0.98rem;
  letter-spacing: 0.04em;
  box-shadow: 0 0 0 5px rgba(16, 36, 58, 0.06);
}

.brand-text {
  display: grid;
  line-height: 1.15;
}

.brand-text strong {
  font-family: var(--serif);
  font-size: 1.1rem;
  font-weight: 700;
  letter-spacing: 0.01em;
}

.brand-text small {
  margin-top: 0.2rem;
  color: var(--ink-muted);
  font-size: 0.68rem;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.site-nav {
  display: flex;
  align-items: center;
  gap: 0.3rem;
}

.site-nav a {
  position: relative;
  padding: 0.55rem 0.85rem;
  color: var(--ink-soft);
  border-radius: 999px;
  font-size: 0.9rem;
  font-weight: 650;
  text-decoration: none;
  transition: color 160ms ease, background-color 160ms ease;
}

.site-nav a:hover {
  color: var(--ink);
  background: rgba(16, 36, 58, 0.06);
}

.site-nav a[aria-current="page"] {
  color: var(--surface);
  background: var(--ink);
}

/* Reusable elements ------------------------------------------------------- */

.eyebrow {
  display: flex;
  align-items: center;
  gap: 0.65rem;
  margin: 0 0 1rem;
  color: var(--accent-dark);
  font-size: 0.72rem;
  font-weight: 750;
  letter-spacing: 0.17em;
  text-transform: uppercase;
}

.eyebrow::before {
  content: "";
  width: 1.9rem;
  height: 2px;
  background: var(--gold);
}

.section {
  padding-block: clamp(4rem, 8vw, 6.5rem);
}

.section-tight {
  padding-block: clamp(3rem, 6vw, 4.5rem);
}

.section-header {
  max-width: 720px;
  margin-bottom: 2.5rem;
}

.section-header h2 {
  margin: 0;
  font-family: var(--serif);
  font-size: clamp(2rem, 4vw, 3.25rem);
  font-weight: 700;
  line-height: 1.08;
  letter-spacing: -0.025em;
}

.section-header p {
  margin: 1rem 0 0;
  color: var(--ink-soft);
  font-size: 1.08rem;
}

.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.55rem;
  min-height: 3rem;
  padding: 0.75rem 1.25rem;
  color: var(--surface);
  background: var(--accent-dark);
  border: 1px solid var(--accent-dark);
  border-radius: 999px;
  font-size: 0.9rem;
  font-weight: 700;
  text-decoration: none;
  box-shadow: 0 10px 24px rgba(15, 81, 75, 0.18);
  transition: transform 160ms ease, box-shadow 160ms ease, background-color 160ms ease;
}

.button:hover {
  color: var(--surface);
  background: var(--accent);
  transform: translateY(-2px);
  box-shadow: 0 14px 30px rgba(15, 81, 75, 0.23);
}

.button.secondary {
  color: var(--ink);
  background: transparent;
  border-color: var(--line-strong);
  box-shadow: none;
}

.button.secondary:hover {
  background: rgba(16, 36, 58, 0.05);
}

.text-link {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  color: var(--accent-dark);
  font-size: 0.9rem;
  font-weight: 700;
  text-decoration: none;
}

.text-link::after {
  content: "→";
  transition: transform 160ms ease;
}

.text-link:hover::after {
  transform: translateX(3px);
}

/* Home hero --------------------------------------------------------------- */

.hero {
  position: relative;
  display: grid;
  grid-template-columns: minmax(0, 1.45fr) minmax(290px, 0.7fr);
  gap: clamp(2rem, 6vw, 5rem);
  align-items: center;
  min-height: calc(100vh - 5.25rem);
  padding-block: clamp(3.5rem, 8vw, 7rem);
}

.hero-copy h1 {
  max-width: 760px;
  margin: 0;
  font-family: var(--serif);
  font-size: clamp(3.1rem, 7.2vw, 6.2rem);
  font-weight: 700;
  line-height: 0.94;
  letter-spacing: -0.05em;
}

.hero-role {
  margin: 1.1rem 0 0;
  color: var(--ink-soft);
  font-size: clamp(1rem, 1.6vw, 1.16rem);
  font-weight: 650;
}

.hero-lead {
  max-width: 650px;
  margin: 1.35rem 0 0;
  color: var(--ink-soft);
  font-family: var(--serif);
  font-size: clamp(1.15rem, 2vw, 1.38rem);
  line-height: 1.62;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.8rem;
  margin-top: 2rem;
}

.profile-card {
  position: relative;
  overflow: hidden;
  padding: 1.65rem;
  color: var(--surface);
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.05), transparent 45%),
    var(--ink);
  border-radius: calc(var(--radius) + 6px);
  box-shadow: var(--shadow-lg);
}

.profile-card::before {
  content: "";
  position: absolute;
  width: 12rem;
  height: 12rem;
  right: -5rem;
  top: -5rem;
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 50%;
  box-shadow: 0 0 0 2.5rem rgba(255, 255, 255, 0.03), 0 0 0 5rem rgba(255, 255, 255, 0.025);
  pointer-events: none;
}

.portrait {
  position: relative;
  min-height: 12rem;
  display: grid;
  place-items: center;
  overflow: hidden;
  margin-bottom: 1.35rem;
  background:
    radial-gradient(circle at 50% 36%, rgba(255, 255, 255, 0.18), transparent 28%),
    linear-gradient(135deg, #24526a, #122b42 58%, #0f2234);
  border: 1px solid rgba(255, 255, 255, 0.14);
  border-radius: var(--radius);
}

.portrait::before,
.portrait::after {
  content: "";
  position: absolute;
  border: 1px solid rgba(240, 229, 209, 0.27);
  border-radius: 50%;
}

.portrait::before {
  width: 8rem;
  height: 8rem;
}

.portrait::after {
  width: 13rem;
  height: 13rem;
}

.portrait span {
  position: relative;
  z-index: 1;
  font-family: var(--serif);
  font-size: 3.8rem;
  letter-spacing: 0.04em;
}

.profile-card .card-kicker {
  margin: 0;
  color: #a9d4cc;
  font-size: 0.68rem;
  font-weight: 750;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.profile-card h2 {
  margin: 0.35rem 0 1rem;
  font-family: var(--serif);
  font-size: 1.65rem;
  line-height: 1.2;
}

.profile-facts {
  display: grid;
  gap: 0.75rem;
  margin: 0;
  padding: 1rem 0 0;
  border-top: 1px solid rgba(255, 255, 255, 0.14);
}

.profile-facts div {
  display: grid;
  grid-template-columns: 4.8rem 1fr;
  gap: 0.7rem;
  align-items: baseline;
}

.profile-facts dt {
  color: rgba(255, 253, 248, 0.58);
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.profile-facts dd {
  margin: 0;
  color: var(--surface);
  font-size: 0.88rem;
  line-height: 1.45;
}

.profile-facts a {
  color: #b7e1d9;
}

/* Research interests ------------------------------------------------------ */

.interest-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1rem;
}

.interest-card {
  position: relative;
  padding: 1.6rem;
  background: rgba(255, 253, 248, 0.72);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;
}

.interest-card:hover {
  transform: translateY(-4px);
  border-color: rgba(23, 107, 99, 0.35);
  box-shadow: var(--shadow-sm);
}

.interest-card .number {
  display: block;
  margin-bottom: 1.35rem;
  color: var(--gold);
  font-family: var(--serif);
  font-size: 0.85rem;
  font-weight: 700;
  letter-spacing: 0.12em;
}

.interest-card h3 {
  margin: 0;
  font-family: var(--serif);
  font-size: 1.28rem;
  line-height: 1.25;
}

.interest-card p {
  margin: 0.65rem 0 0;
  color: var(--ink-soft);
  font-size: 0.94rem;
  line-height: 1.65;
}

/* Education timeline ------------------------------------------------------ */

.timeline {
  position: relative;
  display: grid;
  gap: 0;
  max-width: 850px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.timeline::before {
  content: "";
  position: absolute;
  left: 0.4rem;
  top: 0.6rem;
  bottom: 0.6rem;
  width: 1px;
  background: var(--line-strong);
}

.timeline li {
  position: relative;
  padding: 0 0 2.3rem 2.15rem;
}

.timeline li:last-child {
  padding-bottom: 0;
}

.timeline li::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0.45rem;
  width: 0.82rem;
  height: 0.82rem;
  background: var(--paper);
  border: 2px solid var(--accent-dark);
  border-radius: 50%;
}

.timeline .year {
  color: var(--accent-dark);
  font-size: 0.72rem;
  font-weight: 750;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.timeline h3 {
  margin: 0.3rem 0 0;
  font-family: var(--serif);
  font-size: 1.35rem;
  line-height: 1.3;
}

.timeline .institution {
  margin: 0.1rem 0 0;
  color: var(--ink-soft);
  font-weight: 650;
}

.timeline .detail {
  margin: 0.45rem 0 0;
  color: var(--ink-soft);
  font-size: 0.94rem;
}

/* Projects ---------------------------------------------------------------- */

.project-grid {
  display: grid;
  gap: 1rem;
}

.project-card {
  display: grid;
  grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
  gap: clamp(1rem, 4vw, 3rem);
  padding: clamp(1.4rem, 3vw, 2rem);
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  box-shadow: var(--shadow-sm);
}

.project-card h3 {
  margin: 0;
  font-family: var(--serif);
  font-size: clamp(1.35rem, 2.4vw, 1.75rem);
  line-height: 1.2;
}

.project-role {
  display: inline-block;
  margin-top: 0.75rem;
  padding: 0.28rem 0.6rem;
  color: var(--accent-dark);
  background: var(--accent-soft);
  border-radius: 999px;
  font-size: 0.72rem;
  font-weight: 750;
  letter-spacing: 0.02em;
}

.project-card ul {
  margin: 0;
  padding-left: 1.15rem;
  color: var(--ink-soft);
}

.project-card li + li {
  margin-top: 0.65rem;
}

/* Two-column detail panels ------------------------------------------------ */

.detail-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1rem;
}

.detail-panel {
  padding: clamp(1.4rem, 3vw, 2rem);
  background: rgba(255, 253, 248, 0.72);
  border: 1px solid var(--line);
  border-radius: var(--radius);
}

.detail-panel h2,
.detail-panel h3 {
  margin: 0;
  font-family: var(--serif);
  font-size: 1.5rem;
  line-height: 1.25;
}

.detail-panel > p {
  margin: 0.75rem 0 0;
  color: var(--ink-soft);
  font-size: 0.95rem;
}

.clean-list {
  display: grid;
  gap: 0.7rem;
  margin: 1.2rem 0 0;
  padding: 0;
  list-style: none;
}

.clean-list li {
  padding-top: 0.7rem;
  border-top: 1px solid var(--line);
  color: var(--ink-soft);
  font-size: 0.94rem;
}

.clean-list strong {
  color: var(--ink);
}

.skill-list {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin: 1.2rem 0 0;
  padding: 0;
  list-style: none;
}

.skill-list li {
  padding: 0.38rem 0.66rem;
  color: var(--ink-soft);
  background: var(--surface-alt);
  border: 1px solid rgba(16, 36, 58, 0.08);
  border-radius: 999px;
  font-size: 0.8rem;
  font-weight: 650;
}

/* Contact panel ----------------------------------------------------------- */

.contact-panel {
  display: grid;
  grid-template-columns: 1.2fr 0.8fr;
  gap: 2rem;
  align-items: end;
  padding: clamp(1.8rem, 5vw, 3.5rem);
  color: var(--surface);
  background:
    radial-gradient(circle at 100% 0%, rgba(183, 225, 217, 0.16), transparent 24rem),
    var(--ink);
  border-radius: calc(var(--radius) + 8px);
  box-shadow: var(--shadow-lg);
}

.contact-panel .eyebrow {
  color: #b7e1d9;
}

.contact-panel h2 {
  margin: 0;
  font-family: var(--serif);
  font-size: clamp(2rem, 4vw, 3.2rem);
  line-height: 1.08;
  letter-spacing: -0.02em;
}

.contact-panel p {
  max-width: 590px;
  margin: 1rem 0 0;
  color: rgba(255, 253, 248, 0.72);
}

.contact-links {
  display: grid;
  gap: 0.8rem;
  justify-items: start;
}

.contact-links a {
  color: var(--surface);
  font-weight: 650;
  text-decoration-color: rgba(255, 255, 255, 0.38);
}

.contact-links a:hover {
  color: #b7e1d9;
}

/* Interior page hero ------------------------------------------------------ */

.page-hero {
  padding-block: clamp(4rem, 9vw, 7.5rem) clamp(2.5rem, 5vw, 4.5rem);
}

.page-hero h1 {
  max-width: 850px;
  margin: 0;
  font-family: var(--serif);
  font-size: clamp(2.8rem, 6vw, 5.25rem);
  font-weight: 700;
  line-height: 0.98;
  letter-spacing: -0.045em;
}

.page-hero .intro {
  max-width: 670px;
  margin: 1.3rem 0 0;
  color: var(--ink-soft);
  font-family: var(--serif);
  font-size: clamp(1.1rem, 2vw, 1.35rem);
  line-height: 1.62;
}

/* Publications ------------------------------------------------------------ */

.publication-list {
  display: grid;
  gap: 1rem;
  margin: 0;
  padding: 0;
  list-style: none;
}

.publication-card {
  display: grid;
  grid-template-columns: 5rem minmax(0, 1fr);
  gap: clamp(1.1rem, 3vw, 2rem);
  padding: clamp(1.4rem, 3vw, 2.1rem);
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  box-shadow: var(--shadow-sm);
}

.pub-year {
  color: var(--gold);
  font-family: var(--serif);
  font-size: 1.4rem;
  font-weight: 700;
  line-height: 1.1;
}

.pub-body {
  min-width: 0;
}

.pub-type {
  display: inline-block;
  margin-bottom: 0.7rem;
  color: var(--accent-dark);
  font-size: 0.68rem;
  font-weight: 750;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.pub-body h2 {
  margin: 0;
  font-family: var(--serif);
  font-size: clamp(1.3rem, 2.5vw, 1.7rem);
  line-height: 1.3;
}

.pub-authors {
  margin: 0.7rem 0 0;
  color: var(--ink-soft);
  font-size: 0.94rem;
}

.pub-authors strong {
  color: var(--ink);
}

.pub-venue {
  margin: 0.4rem 0 0;
  color: var(--ink-muted);
  font-size: 0.9rem;
  font-style: italic;
}

details {
  margin-top: 1rem;
  border-top: 1px solid var(--line);
}

summary {
  width: fit-content;
  padding-top: 0.8rem;
  color: var(--accent-dark);
  font-size: 0.82rem;
  font-weight: 700;
  cursor: pointer;
}

pre {
  max-width: 100%;
  overflow-x: auto;
  margin: 0.8rem 0 0;
  padding: 1rem;
  color: #dcece8;
  background: var(--ink);
  border-radius: var(--radius-sm);
  font-size: 0.78rem;
  line-height: 1.55;
}

.pub-toolbar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  margin-bottom: 1.5rem;
}

.pub-toolbar p {
  margin: 0;
  color: var(--ink-muted);
  font-size: 0.9rem;
}

/* Blog -------------------------------------------------------------------- */

.blog-layout {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 290px;
  gap: clamp(1.5rem, 5vw, 4rem);
  align-items: start;
}

.post-list {
  display: grid;
  gap: 1rem;
}

.post-card {
  padding: clamp(1.35rem, 3vw, 2rem);
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  box-shadow: var(--shadow-sm);
}

.post-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.65rem;
  margin-bottom: 0.75rem;
  color: var(--ink-muted);
  font-size: 0.74rem;
  font-weight: 700;
  letter-spacing: 0.09em;
  text-transform: uppercase;
}

.post-meta .dot {
  width: 3px;
  height: 3px;
  background: var(--gold);
  border-radius: 50%;
}

.post-card h2 {
  margin: 0;
  font-family: var(--serif);
  font-size: clamp(1.4rem, 2.7vw, 1.9rem);
  line-height: 1.25;
}

.post-card p {
  margin: 0.8rem 0 0;
  color: var(--ink-soft);
  font-size: 0.95rem;
}

.post-card .post-note {
  margin-top: 1rem;
  padding-top: 1rem;
  border-top: 1px solid var(--line);
  color: var(--ink-muted);
  font-size: 0.85rem;
  font-style: italic;
}

.blog-sidebar {
  position: sticky;
  top: 6.5rem;
  display: grid;
  gap: 1rem;
}

.sidebar-card {
  padding: 1.4rem;
  background: rgba(255, 253, 248, 0.75);
  border: 1px solid var(--line);
  border-radius: var(--radius);
}

.sidebar-card h2 {
  margin: 0;
  font-family: var(--serif);
  font-size: 1.25rem;
}

.sidebar-card p {
  margin: 0.6rem 0 0;
  color: var(--ink-soft);
  font-size: 0.9rem;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
  margin: 0.9rem 0 0;
  padding: 0;
  list-style: none;
}

.tag-list li {
  padding: 0.28rem 0.55rem;
  color: var(--accent-dark);
  background: var(--accent-soft);
  border-radius: 999px;
  font-size: 0.72rem;
  font-weight: 700;
}

.sidebar-card .text-link {
  margin-top: 0.9rem;
}

/* Footer ------------------------------------------------------------------ */

.site-footer {
  margin-top: clamp(2rem, 5vw, 4rem);
  padding-block: 2.5rem;
  border-top: 1px solid var(--line);
}

.footer-inner {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 1.5rem;
}

.footer-inner p {
  margin: 0;
  color: var(--ink-muted);
  font-size: 0.82rem;
}

.footer-links {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
}

.footer-links a {
  color: var(--ink-soft);
  font-size: 0.82rem;
  font-weight: 650;
  text-decoration: none;
}

.footer-links a:hover {
  color: var(--accent-dark);
  text-decoration: underline;
  text-underline-offset: 0.2em;
}

/* Responsive -------------------------------------------------------------- */

@media (max-width: 860px) {
  .hero {
    grid-template-columns: 1fr;
    min-height: auto;
  }

  .profile-card {
    max-width: 430px;
  }

  .project-card,
  .contact-panel,
  .blog-layout {
    grid-template-columns: 1fr;
  }

  .blog-sidebar {
    position: static;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 680px) {
  .container {
    width: min(calc(100% - 1.5rem), var(--container));
  }

  .nav-wrap {
    min-height: 4.6rem;
    align-items: flex-start;
    flex-direction: column;
    justify-content: center;
    gap: 0.35rem;
    padding-block: 0.75rem;
  }

  .brand-text small {
    display: none;
  }

  .site-nav {
    width: 100%;
    gap: 0.1rem;
  }

  .site-nav a {
    flex: 1;
    padding: 0.4rem 0.3rem;
    text-align: center;
    font-size: 0.8rem;
  }

  .hero {
    padding-top: 3rem;
  }

  .interest-grid,
  .detail-grid,
  .blog-sidebar {
    grid-template-columns: 1fr;
  }

  .publication-card {
    grid-template-columns: 1fr;
    gap: 0.5rem;
  }

  .pub-year {
    font-size: 0.8rem;
    letter-spacing: 0.12em;
  }

  .footer-inner {
    flex-direction: column;
  }
}

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }

  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}
