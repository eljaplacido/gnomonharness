cd /app/my_website/public && python3 -m http.server 8765 --bind 127.0.0.1 >/tmp/research-profile-http.log 2>&1 &
SERVER_PID=$!
trap 'kill "$SERVER_PID" 2>/dev/null || true' EXIT
sleep 1
for page in index.html blog.html publications.html 404.html; do
  status=$(curl -s -o "/tmp/$page" -w '%{http_code}' "http://127.0.0.1:8765/$page")
  title=$(grep -o '<title>[^<]*</title>' "/tmp/$page" | head -n1)
  printf '%-22s HTTP %s  %s\n' "$page" "$status" "$title"
  test "$status" = "200"
done
curl -sSf http://127.0.0.1:8765/styles.css >/dev/null && echo "styles.css            HTTP 200"
curl -sSf http://127.0.0.1:8765/publications.bib >/dev/null && echo "publications.bib      HTTP 200"
kill "$SERVER_PID" 2>/dev/null || true
trap - EXIT
cd /app/my_website && echo '--- final validation ---' && python3 scripts/validate_site.py && echo '--- symlinks (should be empty) ---' && find . -type l -print 
&& echo '--- workflow scan ---' && grep -nE 'hackerX|repo\.zip|curl|wget|upload' .github/workflows/deploy.yml || true
```
