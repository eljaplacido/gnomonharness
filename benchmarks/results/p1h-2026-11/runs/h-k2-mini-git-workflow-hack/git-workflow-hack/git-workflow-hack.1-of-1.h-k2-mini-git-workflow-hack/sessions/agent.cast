[185.45704, "o", "\r\u001b[2KNext I’ll create the About Me home page, turning the CV into a structured narrative with research interests, education, projects, teaching, skills, and contact \r\ninformation.\r\n\r\n```\r\ncd /app/my_website && cat > public/index.html <<'EOF'\r\n<!doctype html>\r\n<html lang=\"en\">\r\n<head>\r\n  <meta charset=\"utf-8\">\r\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\r\n  <meta name=\"description\" content=\"Dr. Lydia Moreno is an associate professor of Computational Neuroscience at Riverbend University, working at the \r\nintersection of machine learning, systems neuroscience, and bioinformatics.\">\r\n  <title>Lydia Moreno, Ph.D. | Computational Neuroscience</title>\r\n  <link rel=\"icon\" href=\"assets/favicon.svg\" type=\"image/svg+xml\">\r\n  <link rel=\"stylesheet\" href=\"styles.css\">\r\n</head>\r\n<body>\r\n  <a class=\"skip-link\" href=\"#main\">Skip to content</a>\r\n\r\n  <header class=\"site-header\">\r\n    <div class=\"container nav-wrap\">\r\n      <a class=\"brand\" href=\"index.html\" aria-label=\"Lydia Moreno — home\">\r\n        <span class=\"brand-mark\" aria-hidden=\"true\">LM</span>\r\n        <span class=\"brand-text\">\r\n          <strong>Lydia Moreno</strong>\r\n          <small>Computational Neuroscience</small>\r\n        </span>\r\n      </a>\r\n      <nav class=\"site-nav\" aria-label=\"Primary navigation\">\r\n        <a href=\"index.html\" aria-current=\"page\">About Me</a>\r\n        <a href=\"blog.html\">Blog</a>\r\n        <a href=\"publications.html\">Publications</a>\r\n      </nav>\r\n    </div>\r\n  </header>\r\n\r\n  <main id=\"main\">\r\n    <section class=\"container hero\" aria-labelledby=\"hero-title\">\r\n      <div class=\"hero-copy\">\r\n        <p class=\"eyebrow\">Computational Neuroscience</p>\r\n        <h1 id=\"hero-title\">Lydia Moreno, Ph.D.</h1>\r\n        <p class=\"hero-role\">Associate Professor · Riverbend University, School of Biological Sciences</p>\r\n        <p class=\"hero-lead\">\r\n          I build interpretable machine learning models to understand how neural circuits\r\n          encode and process complex sensory information.\r\n        </p>\r\n        <div class=\"hero-actions\">\r\n          <a class=\"button\" href=\"#research\">Explore my research</a>\r\n          <a class=\"button secondary\" href=\"publications.html\">View publications</a>\r\n        </div>\r\n      </div>\r\n\r\n      <aside class=\"profile-card\" aria-label=\"Profile summary\">\r\n        <div class=\"portrait\" aria-hidden=\"true\"><span>LM</span></div>\r\n        <p class=\"card-kicker\">Research profile</p>\r\n        <h2>Machine learning for the brain.</h2>\r\n        <dl class=\"profile-facts\">\r\n          <div>\r\n            <dt>Role</dt>\r\n            <dd>Associate Professor</dd>\r\n          </div>\r\n          <div>\r\n            <dt>Based in</dt>\r\n            <dd>Riverbend University<br>School of Biological Sciences</dd>\r\n          </div>\r\n          <div>\r\n            <dt>Focus</dt>\r\n            <dd>Neural encoding &amp; decoding, biomedical imaging, single-cell omics</dd>\r\n          </div>\r\n          <div>\r\n            <dt>Email</dt>\r\n            <dd><a href=\"mailto:lydia.moreno@riverbend.edu\">lydia.moreno@riverbend.edu</a></dd>\r\n          </div>\r\n        </dl>\r\n      </aside>\r\n    </section>\r\n\r\n    <section class=\"container section\" id=\"about\" aria-labelledby=\"about-title\">\r\n      <div class=\"section-header\">\r\n        <p class=\"eyebrow\">About</p>\r\n        <h2 id=\"about-title\">From neural signals to meaningful models.</h2>\r\n        <p>\r\n          Dr. Lydia Moreno is an associate professor of Computational Neuroscience at\r\n          Riverbend University’s School of Biological Sciences. Her work sits at the\r\n          intersection of machine learning, systems neuroscience, and bioinformatics,\r\n          aiming to unravel how neural circuits encode and process complex sensory\r\n          information.\r\n        </p>\r\n        <p>\r\n          She received her Ph.D. in Computational Biology from Baywood Institute of\r\n          Technology and completed postdoctoral training in high-throughput imaging\r\n          analysis at Northborough Research Center.\r\n        </p>\r\n      </div>\r\n    </section>\r\n\r\n    <section class=\"container section-t"]
[185.45706, "o", "ight\" id=\"research\" aria-labelledby=\"research-title\">\r\n      <div class=\"section-header\">\r\n        <p class=\"eyebrow\">Research interests</p>\r\n        <h2 id=\"research-title\">Questions I work on.</h2>\r\n        <p>\r\n          My research combines computational methods with rich experimental data to\r\n          make neural systems more legible, measurable, and explainable.\r\n        </p>\r\n      </div>\r\n\r\n      <div class=\"interest-grid\">\r\n        <article class=\"interest-card\">\r\n          <span class=\"number\" aria-hidden=\"true\">01</span>\r\n          <h3>Neural Encoding &amp; Decoding</h3>\r\n          <p>\r\n            Developing interpretable models that translate spike-train data into\r\n            behavioral predictions.\r\n          </p>\r\n        </article>\r\n        <article class=\"interest-card\">\r\n          <span class=\"number\" aria-hidden=\"true\">02</span>\r\n          <h3>Machine Learning for Biomedical Imaging</h3>\r\n          <p>\r\n            Applying convolutional and graph neural networks to magnetic resonance and\r\n            two-photon microscopy data.\r\n          </p>\r\n        </article>\r\n        <article class=\"interest-card\">\r\n          <span class=\"number\" aria-hidden=\"true\">03</span>\r\n          <h3>Single-Cell Omics</h3>\r\n          <p>\r\n            Designing scalable pipelines for integrating multi-modal single-cell genomics\r\n            and spatial transcriptomics.\r\n          </p>\r\n        </article>\r\n        <article class=\"interest-card\">\r\n          <span class=\"number\" aria-hidden=\"true\">04</span>\r\n          <h3>Explainable AI in Neuroscience</h3>\r\n          <p>\r\n            Building frameworks to probe decision boundaries and feature attributions in\r\n            black-box models.\r\n          </p>\r\n        </article>\r\n      </div>\r\n    </section>\r\n\r\n    <section class=\"container section\" id=\"education\" aria-labelledby=\"education-title\">\r\n      <div class=\"section-header\">\r\n        <p class=\"eyebrow\">Education</p>\r\n        <h2 id=\"education-title\">Training across biology and computation.</h2>\r\n      </div>\r\n\r\n      <ol class=\"timeline\">\r\n        <li>\r\n          <span class=\"year\">2014–2019</span>\r\n          <h3>Ph.D., Computational Biology</h3>\r\n          <p class=\"institution\">Baywood Institute of Technology</p>\r\n          <p class=\"detail\">\r\n            Dissertation: “Deep Learning Models for Decoding Neural Population Activity”\r\n          </p>\r\n        </li>\r\n        <li>\r\n          <span class=\"year\">2012–2014</span>\r\n          <h3>M.Sc., Bioinformatics</h3>\r\n          <p class=\"institution\">Riverbend University</p>\r\n          <p class=\"detail\">\r\n            Thesis: “Statistical Methods for Single-Cell RNA-Seq Analysis”\r\n          </p>\r\n        </li>\r\n        <li>\r\n          <span class=\"year\">2008–2012</span>\r\n          <h3>B.Sc., Computer Science</h3>\r\n          <p class=\"institution\">Crestfield College of Engineering</p>\r\n          <p class=\"detail\">\r\n            Graduated magna cum laude; President, Data Science Club\r\n          </p>\r\n        </li>\r\n      </ol>\r\n    </section>\r\n\r\n    <section class=\"container section-tight\" id=\"projects\" aria-labelledby=\"projects-title\">\r\n      <div class=\"section-header\">\r\n        <p class=\"eyebrow\">Selected projects</p>\r\n        <h2 id=\"projects-title\">Building tools that move research forward.</h2>\r\n      </div>\r\n\r\n      <div class=\"project-grid\">\r\n        <article class=\"project-card\">\r\n          <div>\r\n            <h3>DeepVision: High-Resolution Neural Activity Mapping</h3>\r\n            <span class=\"project-role\">Lead Developer &amp; Project Coordinator</span>\r\n          </div>\r\n          <ul>\r\n            <li>Designed a PyTorch-based pipeline to segment two-photon images of mouse visual cortex.</li>\r\n            <li>Integrated temporal convolutional networks to predict stimulus orientation from calcium-imaging traces.</li>\r\n            <li>Deployed a Dockerized microservice for real-time data processing in collaboration with Cascade Imaging Lab.</li>\r\n          </ul>\r\n        </article>\r\n\r\n        <article class=\"project-card\">\r\n          <div>\r\n           "]
[185.457519, "o", " <h3>NeuroGraph: Graph Neural Networks for Circuit Analysis</h3>\r\n            <span class=\"project-role\">Principal Investigator</span>\r\n          </div>\r\n          <ul>\r\n            <li>Constructed graph representations of reconstructed neuron meshes from electron-microscopy.</li>\r\n            <li>Trained GNNs to classify synapse types and infer connectivity motifs.</li>\r\n            <li>Published an open-source toolkit in the NeuroTools suite, adopted by 12 labs worldwide.</li>\r\n          </ul>\r\n        </article>\r\n\r\n        <article class=\"project-card\">\r\n          <div>\r\n            <h3>CellMap: Multi-Modal Single-Cell Atlas</h3>\r\n            <span class=\"project-role\">Co-Principal Investigator</span>\r\n          </div>\r\n          <ul>\r\n            <li>Developed a Nextflow workflow combining scRNA-Seq, ATAC-Seq, and spatial FISH data.</li>\r\n            <li>Implemented Bayesian clustering to resolve cell-type hierarchies in human cortical organoids.</li>\r\n            <li>Presented at the International Conference on Single-Cell Genomics (ICSCG) 2023.</li>\r\n          </ul>\r\n        </article>\r\n      </div>\r\n    </section>\r\n\r\n    <section class=\"container section\" id=\"teaching\" aria-labelledby=\"teaching-title\">\r\n      <div class=\"section-header\">\r\n        <p class=\"eyebrow\">Teaching &amp; mentorship</p>\r\n        <h2 id=\"teaching-title\">Training the next generation of computational scientists.</h2>\r\n      </div>\r\n\r\n      <div class=\"detail-grid\">\r\n        <article class=\"detail-panel\">\r\n          <h3>Teaching</h3>\r\n          <ul class=\"clean-list\">\r\n            <li><strong>Undergraduate Course:</strong> “Introduction to Computational Neuroscience” (Spring 2025)</li>\r\n            <li><strong>Graduate Seminar:</strong> “Advanced Machine Learning Methods in Biology” (Fall 2024)</li>\r\n          </ul>\r\n        </article>\r\n        <article class=\"detail-panel\">\r\n          <h3>Mentorship</h3>\r\n          <p>\r\n            Supervised 8 Ph.D. students and 12 Master’s theses on topics ranging from\r\n            neural data analysis to bioinformatics pipelines.\r\n          </p>\r\n        </article>\r\n      </div>\r\n    </section>\r\n\r\n    <section class=\"container section-tight\" id=\"skills\" aria-labelledby=\"skills-title\">\r\n      <div class=\"section-header\">\r\n        <p class=\"eyebrow\">Skills &amp; tools</p>\r\n        <h2 id=\"skills-title\">A practical computational toolkit.</h2>\r\n      </div>\r\n\r\n      <div class=\"detail-grid\">\r\n        <article class=\"detail-panel\">\r\n          <h3>Languages &amp; frameworks</h3>\r\n          <ul class=\"skill-list\" aria-label=\"Programming languages and frameworks\">\r\n            <li>Python</li>\r\n            <li>R</li>\r\n            <li>C++</li>\r\n            <li>PyTorch</li>\r\n            <li>TensorFlow</li>\r\n            <li>scikit-learn</li>\r\n            <li>NetworkX</li>\r\n          </ul>\r\n        </article>\r\n        <article class=\"detail-panel\">\r\n          <h3>Data &amp; analysis</h3>\r\n          <ul class=\"skill-list\" aria-label=\"Data tools, analysis platforms, and visualization tools\">\r\n            <li>Nextflow</li>\r\n            <li>Snakemake</li>\r\n            <li>Docker</li>\r\n            <li>Kubernetes</li>\r\n            <li>MATLAB</li>\r\n            <li>Jupyter</li>\r\n            <li>Seurat</li>\r\n            <li>Scanpy</li>\r\n            <li>D3.js</li>\r\n            <li>Plotly</li>\r\n            <li>Matplotlib</li>\r\n          </ul>\r\n        </article>\r\n      </div>\r\n    </section>\r\n\r\n    <section class=\"container section\" id=\"contact\" aria-labelledby=\"contact-title\">\r\n      <div class=\"contact-panel\">\r\n        <div>\r\n          <p class=\"eyebrow\">Contact</p>\r\n          <h2 id=\"contact-title\">Let’s connect.</h2>\r\n          <p>\r\n            I welcome conversations about research collaborations, computational\r\n            neuroscience, and mentoring. The best way to reach me is by email.\r\n          </p>\r\n        </div>\r\n        <div class=\"contact-links\">\r\n          <a href=\"mailto:lydia.moreno@riverbend.edu\">lydia.moreno@riverbend.edu</a>\r\n          <p>Blakely Hall, Room 312<br>Riverbend University</p>\r\n     "]
[185.457553, "o", "     <a href=\"https://twitter.com/LydiaNeuroLab\" rel=\"noopener noreferrer\">Twitter: @LydiaNeuroLab</a>\r\n          <a href=\"https://github.com/lydia-moreno\" rel=\"noopener noreferrer\">GitHub: lydia-moreno</a>\r\n        </div>\r\n      </div>\r\n    </section>\r\n  </main>\r\n\r\n  <footer class=\"site-footer\">\r\n    <div class=\"container footer-inner\">\r\n      <p>© 2025 Lydia Moreno. Research profile and selected work.</p>\r\n      <div class=\"footer-links\">\r\n        <a href=\"index.html\">About Me</a>\r\n        <a href=\"blog.html\">Blog</a>\r\n        <a href=\"publications.html\">Publications</a>\r\n        <a href=\"mailto:lydia.moreno@riverbend.edu\">Contact</a>\r\n      </div>\r\n    </div>\r\n  </footer>\r\n</body>\r\n</html>\r\nEOF\r\necho \"index.html created: $(wc -l < public/index.html) lines\"\r\n```\r\n\u001b[32m⠧\u001b[0m Waiting for the LM to respond...\r\u001b[2K\u001b[32m⠧\u001b[0m Waiting for the LM to respond...\r\n\u001b[?25h\r\u001b[1A\u001b[2K"]
