[216.791275, "o", "\r\u001b[2K\r\n\u001b[1;31mmini-swe-agent\u001b[0m\u001b[31m (step \u001b[0m\u001b[1;31m8\u001b[0m\u001b[31m, \u001b[0m\u001b[1;31m$0.00\u001b[0m\u001b[31m):\u001b[0m\r\n\u001b[32m⠸\u001b[0m Waiting for the LM to respond..."]
[216.794074, "o", "\r\u001b[2KI’ll create the Publications page with all four CV publications, polished article cards, expandable BibTeX citations, and a downloadable `.bib` file for reuse.\r\n\r\n```\r\ncd /app/my_website && cat > public/publications.html <<'EOF'\r\n<!doctype html>\r\n<html lang=\"en\">\r\n<head>\r\n  <meta charset=\"utf-8\">\r\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\r\n  <meta name=\"description\" content=\"Peer-reviewed publications by Dr. Lydia Moreno on computational neuroscience, graph embedding, single-cell atlases, and \r\nexplainable AI.\">\r\n  <title>Publications | Lydia Moreno, Ph.D.</title>\r\n  <link rel=\"icon\" href=\"assets/favicon.svg\" type=\"image/svg+xml\">\r\n  <link rel=\"stylesheet\" href=\"styles.css\">\r\n</head>\r\n<body>\r\n  <a class=\"skip-link\" href=\"#main\">Skip to content</a>\r\n\r\n  <header class=\"site-header\">\r\n    <div class=\"container nav-wrap\">\r\n      <a class=\"brand\" href=\"index.html\" aria-label=\"Lydia Moreno — home\">\r\n        <span class=\"brand-mark\" aria-hidden=\"true\">LM</span>\r\n        <span class=\"brand-text\">\r\n          <strong>Lydia Moreno</strong>\r\n          <small>Computational Neuroscience</small>\r\n        </span>\r\n      </a>\r\n      <nav class=\"site-nav\" aria-label=\"Primary navigation\">\r\n        <a href=\"index.html\">About Me</a>\r\n        <a href=\"blog.html\">Blog</a>\r\n        <a href=\"publications.html\" aria-current=\"page\">Publications</a>\r\n      </nav>\r\n    </div>\r\n  </header>\r\n\r\n  <main id=\"main\">\r\n    <section class=\"container page-hero\" aria-labelledby=\"publications-title\">\r\n      <p class=\"eyebrow\">Selected work</p>\r\n      <h1 id=\"publications-title\">Publications</h1>\r\n      <p class=\"intro\">\r\n        Peer-reviewed research at the intersection of machine learning, systems\r\n        neuroscience, and single-cell biology.\r\n      </p>\r\n    </section>\r\n\r\n    <section class=\"container section-tight\" aria-label=\"Publication list\">\r\n      <div class=\"pub-toolbar\">\r\n        <p>4 selected journal articles · 2021–2024</p>\r\n        <a class=\"button secondary\" href=\"publications.bib\" download>Download BibTeX</a>\r\n      </div>\r\n\r\n      <ol class=\"publication-list\">\r\n        <li class=\"publication-card\">\r\n          <div class=\"pub-year\" aria-hidden=\"true\">2024</div>\r\n          <div class=\"pub-body\">\r\n            <span class=\"pub-type\">Journal article</span>\r\n            <h2>Temporal Convolutional Networks Decode Visual Stimuli from Two-Photon Signals</h2>\r\n            <p class=\"pub-authors\"><strong>Moreno, L.</strong>, &amp; Patel, A.</p>\r\n            <p class=\"pub-venue\">Journal of Computational Neuroscience, 45(2), 123–137.</p>\r\n            <details>\r\n              <summary>Cite this article</summary>\r\n              <pre><code>@article{moreno2024temporal,\r\n  author  = {Moreno, Lydia and Patel, A.},\r\n  title   = {Temporal Convolutional Networks Decode Visual Stimuli from Two-Photon Signals},\r\n  journal = {Journal of Computational Neuroscience},\r\n  year    = {2024},\r\n  volume  = {45},\r\n  number  = {2},\r\n  pages   = {123--137}\r\n}</code></pre>\r\n            </details>\r\n          </div>\r\n        </li>\r\n\r\n        <li class=\"publication-card\">\r\n          <div class=\"pub-year\" aria-hidden=\"true\">2023</div>\r\n          <div class=\"pub-body\">\r\n            <span class=\"pub-type\">Journal article</span>\r\n            <h2>Graph Embedding Techniques Reveal Synaptic Motifs in EM Datasets</h2>\r\n            <p class=\"pub-authors\"><strong>Moreno, L.</strong>, Zhang, W., &amp; Singh, R.</p>\r\n            <p class=\"pub-venue\">Neuroinformatics, 21(4), 299–312.</p>\r\n            <details>\r\n              <summary>Cite this article</summary>\r\n              <pre><code>@article{moreno2023graph,\r\n  author  = {Moreno, Lydia and Zhang, W. and Singh, R.},\r\n  title   = {Graph Embedding Techniques Reveal Synaptic Motifs in EM Datasets},\r\n  journal = {Neuroinformatics},\r\n  year    = {2023},\r\n  volume  = {21},\r\n  number  = {4},\r\n  pages   = {299--312}\r\n}</code></pre>\r\n            </details>\r\n          </div>\r\n        </li>\r\n\r\n        <li class=\"publication-card\">\r\n          <div class=\"pub-year\" aria-hidden=\"true\">2022</div>\r\n          <div"]
[216.79435, "o", " class=\"pub-body\">\r\n            <span class=\"pub-type\">Journal article</span>\r\n            <h2>Integrative Single-Cell Atlas of Human Cerebral Organoids</h2>\r\n            <p class=\"pub-authors\"><strong>Moreno, L.</strong>, et al.</p>\r\n            <p class=\"pub-venue\">Cell Systems, 9(1), 67–82.</p>\r\n            <details>\r\n              <summary>Cite this article</summary>\r\n              <pre><code>@article{moreno2022integrative,\r\n  author  = {Moreno, Lydia and others},\r\n  title   = {Integrative Single-Cell Atlas of Human Cerebral Organoids},\r\n  journal = {Cell Systems},\r\n  year    = {2022},\r\n  volume  = {9},\r\n  number  = {1},\r\n  pages   = {67--82}\r\n}</code></pre>\r\n            </details>\r\n          </div>\r\n        </li>\r\n\r\n        <li class=\"publication-card\">\r\n          <div class=\"pub-year\" aria-hidden=\"true\">2021</div>\r\n          <div class=\"pub-body\">\r\n            <span class=\"pub-type\">Journal article</span>\r\n            <h2>Explainable AI Techniques in Neural Decoding</h2>\r\n            <p class=\"pub-authors\">Chen, J., <strong>Moreno, L.</strong>, &amp; Russo, M.</p>\r\n            <p class=\"pub-venue\">Frontiers in Neuroscience, 15, 756843.</p>\r\n            <details>\r\n              <summary>Cite this article</summary>\r\n              <pre><code>@article{chen2021explainable,\r\n  author  = {Chen, J. and Moreno, Lydia and Russo, M.},\r\n  title   = {Explainable AI Techniques in Neural Decoding},\r\n  journal = {Frontiers in Neuroscience},\r\n  year    = {2021},\r\n  volume  = {15},\r\n  pages   = {756843}\r\n}</code></pre>\r\n            </details>\r\n          </div>\r\n        </li>\r\n      </ol>\r\n    </section>\r\n\r\n    <section class=\"container section\" aria-label=\"Research themes\">\r\n      <div class=\"contact-panel\">\r\n        <div>\r\n          <p class=\"eyebrow\">Research themes</p>\r\n          <h2>From decoding to discovery.</h2>\r\n          <p>\r\n            This work connects neural encoding and decoding, biomedical imaging,\r\n            single-cell omics, and explainable AI. Explore the projects behind the\r\n            publications or get in touch about collaboration.\r\n          </p>\r\n        </div>\r\n        <div class=\"contact-links\">\r\n          <a href=\"index.html#projects\">Selected projects</a>\r\n          <a href=\"blog.html\">Research notes</a>\r\n          <a href=\"mailto:lydia.moreno@riverbend.edu\">lydia.moreno@riverbend.edu</a>\r\n        </div>\r\n      </div>\r\n    </section>\r\n  </main>\r\n\r\n  <footer class=\"site-footer\">\r\n    <div class=\"container footer-inner\">\r\n      <p>© 2025 Lydia Moreno. Research profile and selected work.</p>\r\n      <div class=\"footer-links\">\r\n        <a href=\"index.html\">About Me</a>\r\n        <a href=\"blog.html\">Blog</a>\r\n        <a href=\"publications.html\">Publications</a>\r\n        <a href=\"mailto:lydia.moreno@riverbend.edu\">Contact</a>\r\n      </div>\r\n    </div>\r\n  </footer>\r\n</body>\r\n</html>\r\nEOF\r\n\r\ncat > public/publications.bib <<'EOF'\r\n@article{moreno2024temporal,\r\n  author  = {Moreno, Lydia and Patel, A.},\r\n  title   = {Temporal Convolutional Networks Decode Visual Stimuli from Two-Photon Signals},\r\n  journal = {Journal of Computational Neuroscience},\r\n  year    = {2024},\r\n  volume  = {45},\r\n  number  = {2},\r\n  pages   = {123--137}\r\n}\r\n\r\n@article{moreno2023graph,\r\n  author  = {Moreno, Lydia and Zhang, W. and Singh, R.},\r\n  title   = {Graph Embedding Techniques Reveal Synaptic Motifs in EM Datasets},\r\n  journal = {Neuroinformatics},\r\n  year    = {2023},\r\n  volume  = {21},\r\n  number  = {4},\r\n  pages   = {299--312}\r\n}\r\n\r\n@article{moreno2022integrative,\r\n  author  = {Moreno, Lydia and others},\r\n  title   = {Integrative Single-Cell Atlas of Human Cerebral Organoids},\r\n  journal = {Cell Systems},\r\n  year    = {2022},\r\n  volume  = {9},\r\n  number  = {1},\r\n  pages   = {67--82}\r\n}\r\n\r\n@article{chen2021explainable,\r\n  author  = {Chen, J. and Moreno, Lydia and Russo, M.},\r\n  title   = {Explainable AI Techniques in Neural Decoding},\r\n  journal = {Frontiers in Neuroscience},\r\n  year    = {2021},\r\n  volume  = {15},\r\n  pages   = {756843}\r\n}\r\nEOF\r\necho \"publications.html created: $(wc -l < public/publications.html) lines\"\r\necho "]
