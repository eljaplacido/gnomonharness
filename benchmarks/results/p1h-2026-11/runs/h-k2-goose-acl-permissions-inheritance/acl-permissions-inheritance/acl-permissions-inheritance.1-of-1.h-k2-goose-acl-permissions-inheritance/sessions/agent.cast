[19.363791, "o", "    \u001b[2mtotal 8\u001b[0m\r\n    \u001b[2mdrwxr-xr-x 1 root root 4096 Nov  1 03:21 .\u001b[0m\r\n    \u001b[2mdrwxr-xr-x 1 root root 4096 Nov  1 03:20 ..\u001b[0m\r\n"]
[24.540312, "o", "\r\n  \u001b[2m────────────────────────────────────────\u001b[0m\r\n  \u001b[2m▸\u001b[0m \u001b[2mshell\u001b[0m\r\n    \u001b[2mcommand\u001b[0m: \u001b[32mset -e\r\nmkdir -p /srv/shared\r\nchown root:research /srv/shared\r\nchmod 2770 /srv/shared\r\n\r\nsetfacl -m \"u::rwx,g::rwx,m::rwx,o::---\" /srv/shared\r\nsetfacl...\u001b[0m\r\n\r\n"]
[24.563929, "o", "    \u001b[2m=== getfacl ===\u001b[0m\r\n    \u001b[2mgetfacl: Removing leading '/' from absolute path names\u001b[0m\r\n    \u001b[2m# file: srv/shared\u001b[0m\r\n    \u001b[2m# owner: root\u001b[0m\r\n    \u001b[2m# group: research\u001b[0m\r\n    \u001b[2m# flags: -s-\u001b[0m\r\n    \u001b[2muser::rwx\u001b[0m\r\n    \u001b[2muser:alice:rwx\u001b[0m\r\n    \u001b[2muser:bob:rwx\u001b[0m\r\n    \u001b[2mgroup::rwx\u001b[0m\r\n    \u001b[2m\u001b[3m... (4 lines hidden, /toggle to show all)\u001b[0m\r\n    \u001b[2mdefault:user:alice:rwx\u001b[0m\r\n    \u001b[2mdefault:user:bob:rwx\u001b[0m\r\n    \u001b[2mdefault:group::rwx\u001b[0m\r\n    \u001b[2mdefault:group:research:rwx\u001b[0m\r\n    \u001b[2mdefault:mask::rwx\u001b[0m\r\n    \u001b[2mdefault:other::---\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2m=== ls -ld ===\u001b[0m\r\n    \u001b[2mdrwxrws---+ 2 root research 4096 Nov  1 03:21 /srv/shared\u001b[0m\r\n    \u001b[2mdrwxrws--- root research 2770\u001b[0m\r\n"]
[28.444879, "o", "\r\n  \u001b[2m────────────────────────────────────────\u001b[0m\r\n  \u001b[2m▸\u001b[0m \u001b[2mshell\u001b[0m\r\n    \u001b[2mcommand\u001b[0m: \u001b[32mset -e\r\n# Replicate the exact ACL config in a scratch dir to verify inheritance without polluting /srv/shared\r\nrm -rf /tmp/repl && mkdir -p /tmp/r...\u001b[0m\r\n\r\n"]
[28.498871, "o", "    \u001b[2muser::rwx\u001b[0m\r\n    \u001b[2muser:alice:rwx\u001b[0m\r\n    \u001b[2muser:bob:rwx\u001b[0m\r\n    \u001b[2mgroup::rwx\u001b[0m\r\n    \u001b[2mgroup:research:rwx\u001b[0m\r\n    \u001b[2mmask::rwx\u001b[0m\r\n    \u001b[2mother::---\u001b[0m\r\n    \u001b[2mdefault:user::rwx\u001b[0m\r\n    \u001b[2mdefault:user:alice:rwx\u001b[0m\r\n    \u001b[2mdefault:user:bob:rwx\u001b[0m\r\n    \u001b[2m\u001b[3m... (49 lines hidden, /toggle to show all)\u001b[0m\r\n    \u001b[2mmask::rw-\u001b[0m\r\n    \u001b[2mother::---\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2m=== bob reads alice's file ===\u001b[0m\r\n    \u001b[2mhi\u001b[0m\r\n    \u001b[2mdeep\u001b[0m\r\n    \u001b[2mbob-write-ok\u001b[0m\r\n    \u001b[2m=== others (nobody) access ===\u001b[0m\r\n    \u001b[2mls: cannot open directory '/tmp/repl': Permission denied\u001b[0m\r\n    \u001b[2mcat: /tmp/repl/a.txt: Permission denied\u001b[0m\r\n"]
[31.039867, "o", "\r\n  \u001b[2m────────────────────────────────────────\u001b[0m\r\n  \u001b[2m▸\u001b[0m \u001b[2mshell\u001b[0m\r\n    \u001b[2mcommand\u001b[0m: \u001b[32mrm -rf /tmp/repl\r\nls -la /srv/shared   # must be empty\r\nstat -c 'mode=%a owner=%U group=%G type=%F' /srv/shared\r\ngetfacl -p /srv/shared 2>/dev/null\u001b[0m\r\n\r\n"]
[31.054939, "o", "    \u001b[2mtotal 12\u001b[0m\r\n    \u001b[2mdrwxrws---+ 2 root research 4096 Nov  1 03:21 .\u001b[0m\r\n    \u001b[2mdrwxr-xr-x  1 root root     4096 Nov  1 03:21 ..\u001b[0m\r\n    \u001b[2mmode=2770 owner=root group=research type=directory\u001b[0m\r\n    \u001b[2m# file: /srv/shared\u001b[0m\r\n    \u001b[2m# owner: root\u001b[0m\r\n    \u001b[2m# group: research\u001b[0m\r\n    \u001b[2m# flags: -s-\u001b[0m\r\n    \u001b[2muser::rwx\u001b[0m\r\n    \u001b[2muser:alice:rwx\u001b[0m\r\n    \u001b[2m\u001b[3m... (2 lines hidden, /toggle to show all)\u001b[0m\r\n    \u001b[2mgroup:research:rwx\u001b[0m\r\n    \u001b[2mmask::rwx\u001b[0m\r\n    \u001b[2mother::---\u001b[0m\r\n    \u001b[2mdefault:user::rwx\u001b[0m\r\n    \u001b[2mdefault:user:alice:rwx\u001b[0m\r\n    \u001b[2mdefault:user:bob:rwx\u001b[0m\r\n    \u001b[2mdefault:group::rwx\u001b[0m\r\n    \u001b[2mdefault:group:research:rwx\u001b[0m\r\n    \u001b[2mdefault:mask::rwx\u001b[0m\r\n    \u001b[2mdefault:other::---\u001b[0m\r\n"]
