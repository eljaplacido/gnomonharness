[17.003661, "o", "\r\n  \u001b[2m────────────────────────────────────────\u001b[0m\r\n  \u001b[2m▸\u001b[0m \u001b[2mshell\u001b[0m\r\n"]
[17.003917, "o", "    \u001b[2mcommand\u001b[0m: \u001b[32mid; echo \"---\"; cat /etc/os-release | head -3; echo \"---\"; getent group research; echo \"---\"; getent passwd alice bob; echo \"---\"; which setfacl...\u001b[0m\r\n\r\n"]
[17.028114, "o", "    \u001b[2muid=0(root) gid=0(root) groups=0(root)\u001b[0m\r\n    \u001b[2m---\u001b[0m\r\n    \u001b[2mPRETTY_NAME=\"Ubuntu 24.04.2 LTS\"\u001b[0m\r\n    \u001b[2mNAME=\"Ubuntu\"\u001b[0m\r\n    \u001b[2mVERSION_ID=\"24.04\"\u001b[0m\r\n    \u001b[2m---\u001b[0m\r\n    \u001b[2mresearch:x:1001:alice,bob\u001b[0m\r\n    \u001b[2m---\u001b[0m\r\n    \u001b[2malice:x:1001:1002::/home/alice:/bin/bash\u001b[0m\r\n    \u001b[2mbob:x:1002:1003::/home/bob:/bin/bash\u001b[0m\r\n    \u001b[2m---\u001b[0m\r\n    \u001b[2m/usr/bin/setfacl\u001b[0m\r\n    \u001b[2m/usr/bin/getfacl\u001b[0m\r\n    \u001b[2m---\u001b[0m\r\n    \u001b[2mtotal 8\u001b[0m\r\n    \u001b[2mdrwxr-xr-x 2 root root 4096 Apr  4  2025 .\u001b[0m\r\n    \u001b[2mdrwxr-xr-x 1 root root 4096 Nov  1 03:20 ..\u001b[0m\r\n"]
