import os, sys, mailbox, time
sys.path.insert(0, '/app')
import eval as E

def mbox_has(user, subject):
    m = mailbox.mbox(f"/var/mail/{user}")
    return any(msg.get('Subject','') == subject for msg in m)

def assert_exists(u):
    assert os.path.exists(f'/var/mail/{u}'), 'mailbox missing'

def assert_member(u, want=True):
    m = E.get_mlist().members.get_member(f'{u}@local.edu')
    assert (m is not None) == want, f'membership for {u} != {want}'

u1 = os.urandom(6).hex(); u2 = os.urandom(6).hex()
E.add_user(u1); E.add_user(u2)
for u in (u1,u2):
    E.send_email(body='', subject='', from_addr=f'{u}@local.edu', to_addr=E.JOIN_LIST)
    E.retry(lambda u=u: assert_exists(u))
    E.retry(lambda u=u: E.confirm_last_reply(u, 'join'))
    E.retry(lambda u=u: assert_member(u, True))
print('both joined')

subject='Test Announcement 12345'
E.send_email(body='hello everyone', subject=subject, from_addr=f'{u1}@local.edu', to_addr=E.MAILING_LIST)
E.retry(lambda: mbox_has(u2, subject))
print('announcement delivered')
assert mbox_has(u1, subject), 'sender did not get own post'

E.send_email(body='', subject='', from_addr=f'{u2}@local.edu', to_addr=E.LEAVE_LIST)
E.retry(lambda u2=u2: E.confirm_last_reply(u2, 'leave'))
E.retry(lambda: assert_member(u2, False))
print('leave works')

subject2='After Leave Announcement 67890'
E.send_email(body='bye', subject=subject2, from_addr=f'{u1}@local.edu', to_addr=E.MAILING_LIST)
time.sleep(6)
assert not mbox_has(u2, subject2), 'left user still got post'
print('left user no longer receives posts')
PY
