import eval as E

def subjects(user):
    return [str(m.get('Subject','')) for m in mailbox.mbox(f'/var/mail/{user}')]

def assert_exists(u):
    assert os.path.exists(f'/var/mail/{u}'), 'mailbox missing'

def assert_member(u, want=True):
    m = E.get_mlist().members.get_member(f'{u}@local.edu')
    assert (m is not None) == want, f'membership for {u} != {want}'

def assert_has(u, subj):
    ss = subjects(u)
    assert any(subj in s for s in ss), f'{subj!r} not in {ss}'

def assert_not_has(u, subj):
    ss = subjects(u)
    assert not any(subj in s for s in ss), f'{subj!r} unexpectedly in {ss}'

u1 = os.urandom(6).hex(); u2 = os.urandom(6).hex()
