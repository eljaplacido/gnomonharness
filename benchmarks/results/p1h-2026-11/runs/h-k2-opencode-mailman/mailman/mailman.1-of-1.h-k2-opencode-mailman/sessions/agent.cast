[331.252868, "o", "\u001b[0m$ \u001b[0mcat > /tmp/check2.py <<'PY'\r\nfrom mailman.core.initialize import initialize\r\nfrom mailman.interfaces.listmanager import IListManager\r\nfrom zope.component import getUtility\r\ninitialize('/etc/mailman3/mailman.cfg')\r\nm = getUtility(IListManager).get('reading-group@local.edu')\r\nprint('subscription_policy:', m.subscription_policy)\r\nprint('unsubscription_policy:', m.unsubscription_policy)\r\nprint('default_member_action:', m.default_member_action)\r\nprint('default_nonmember_action:', m.default_nonmember_action)\r\nprint('fqdn:', m.fqdn_listname, 'host:', m.mail_host)\r\nprint('members:', [x.email for x in m.members.addresses])\r\nPY\r\nsu list -s /bin/bash -c 'python3 /tmp/check2.py'\r\nsubscription_policy: SubscriptionPolicy.open\r\nunsubscription_policy: SubscriptionPolicy.confirm\r\ndefault_member_action: Action.accept\r\ndefault_nonmember_action: Action.accept\r\nfqdn: reading-group@local.edu host: local.edu\r\nmembers: []\r\n"]
