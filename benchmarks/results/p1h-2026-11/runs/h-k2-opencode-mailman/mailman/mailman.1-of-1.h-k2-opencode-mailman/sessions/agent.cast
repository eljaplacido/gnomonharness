[326.961119, "o", "\u001b[0m$ \u001b[0mdiff -u /etc/mailman3/mailman.cfg.bak /etc/mailman3/mailman.cfg | head -40; echo \"===\"; postconf -n | grep -E 'mydestination|transport_maps|local_recipient_maps|maillog_file'; echo \"===\"; ls -l /var/lib/mailman3/data/postfix_lmtp*\r\n--- /etc/mailman3/mailman.cfg.bak\t2026-11-01 03:37:27.648044944 +0000\r\n+++ /etc/mailman3/mailman.cfg\t2026-11-01 03:37:27.673627541 +0000\r\n@@ -25,7 +25,7 @@\r\n # delivered to a human, but which can't be delivered to a list owner (e.g. a\r\n # bounce from a list owner), will be sent to this address.  It should point to\r\n # a human.\r\n-site_owner: changeme@example.com\r\n+site_owner: postmaster@local.edu\r\n \r\n # This is the local-part of an email address used in the From field whenever a\r\n # message comes from some entity to which there is no natural reply recipient.\r\n===\r\nlocal_recipient_maps = proxy:unix:passwd.byname $alias_maps hash:/var/lib/mailman3/data/postfix_lmtp\r\nmaillog_file = /var/log/mail.log\r\nmydestination = $myhostname, localhost, localhost.localdomain, local.edu, localhost\r\ntransport_maps = hash:/var/lib/mailman3/data/postfix_lmtp\r\n===\r\n-rw-rw---- 1 list list   990 Nov  1 03:37 /var/lib/mailman3/data/postfix_lmtp\r\n-rw-r----- 1 list list 12288 Nov  1 03:37 /var/lib/mailman3/data/postfix_lmtp.db\r\n"]
