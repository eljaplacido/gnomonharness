[248.69793, "o", "\u001b[0m$ \u001b[0mgrep -n \"def remove\\|def unregister\\|def unsubscribe\" -A 5 /usr/lib/python3/dist-packages/mailman/interfaces/member.py /usr/lib/python3/dist-packages/mailman/model/member.py /usr/lib/python3/dist-packages/mailman/interfaces/mailinglist.py | head -60\r\n/usr/lib/python3/dist-packages/mailman/interfaces/member.py:210:    def unsubscribe():\r\n/usr/lib/python3/dist-packages/mailman/interfaces/member.py-211-        \"\"\"Unsubscribe (and delete) this member from the mailing list.\"\"\"\r\n/usr/lib/python3/dist-packages/mailman/interfaces/member.py-212-\r\n/usr/lib/python3/dist-packages/mailman/interfaces/member.py-213-    acknowledge_posts = Attribute(\r\n/usr/lib/python3/dist-packages/mailman/interfaces/member.py-214-        \"\"\"Send an acknowledgment for every posting?\r\n/usr/lib/python3/dist-packages/mailman/interfaces/member.py-215-\r\n--\r\n/usr/lib/python3/dist-packages/mailman/model/member.py:225:    def unsubscribe(self, store):\r\n/usr/lib/python3/dist-packages/mailman/model/member.py-226-        \"\"\"See `IMember`.\"\"\"\r\n/usr/lib/python3/dist-packages/mailman/model/member.py-227-        # Yes, this must get triggered before self is deleted.\r\n/usr/lib/python3/dist-packages/mailman/model/member.py-228-        notify(UnsubscriptionEvent(self.mailing_list, self))\r\n/usr/lib/python3/dist-packages/mailman/model/member.py-229-        store.delete(self.preferences)\r\n/usr/lib/python3/dist-packages/mailman/model/member.py-230-        store.delete(self)\r\n--\r\n/usr/lib/python3/dist-packages/mailman/interfaces/mailinglist.py:805:    def remove(alias):\r\n/usr/lib/python3/dist-packages/mailman/interfaces/mailinglist.py-806-        \"\"\"Remove the given address as an acceptable aliases for posting.\r\n/usr/lib/python3/dist-packages/mailman/interfaces/mailinglist.py-807-\r\n/usr/lib/python3/dist-packages/mailman/interfaces/mailinglist.py-808-        :param alias: The email address to no longer accept as a recipient for\r\n/usr/lib/python3/dist-packages/mailman/interfaces/mailinglist.py-809-            implicit destination posting purposes.\r\n/usr/lib/python3/dist-packages/mailman/interfaces/mailinglist.py-810-        :type alias: string\r\n--\r\n/usr/lib/python3/dist-packages/mailman/interfaces/mailinglist.py:933:    def remove(header, pattern):\r\n/usr/lib/python3/dist-packages/mailman/interfaces/mailinglist.py-934-        \"\"\"Remove the given rule from this mailing list's header match list.\r\n/usr/lib/python3/dist-packages/mailman/interfaces/mailinglist.py-935-\r\n/usr/lib/python3/dist-packages/mailman/interfaces/mailinglist.py-936-        :param header: The email header part of the rule to be removed.\r\n/usr/lib/python3/dist-packages/mailman/interfaces/mailinglist.py-937-        :type header: string\r\n/usr/lib/python3/dist-packages/mailman/interfaces/mailinglist.py-938-        :param pattern: The regular expression part of the rule to be removed.\r\n"]
