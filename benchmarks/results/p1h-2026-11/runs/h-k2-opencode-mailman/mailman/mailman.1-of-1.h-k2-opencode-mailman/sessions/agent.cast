[290.641118, "o", "\u001b[0m$ \u001b[0msu list -s /bin/bash -c '/usr/lib/mailman3/bin/mailman restart' 2>&1; sleep 4; su list -s /bin/bash -c '/usr/lib/mailman3/bin/mailman status' 2>&1; echo \"===\"; cd /app && python3 eval.py 2>&1 | tail -50; echo \"EXIT:${PIPESTATUS[0]}\"\r\nRestarting the Mailman runners\r\nGNU Mailman is running (master pid: 5141)\r\n===\r\n38d1203fd7e6506d added successfully.\r\nRetrying in 2 seconds...\r\nDirect delivery to 38d1203fd7e6506d works: Direct Message\r\n0c0537ae96ce3f09 added successfully.\r\n0c0537ae96ce3f09 sends a join request\r\n0c0537ae96ce3f09 has not yet confirmed their subscription\r\nRetrying in 2 seconds...\r\n0c0537ae96ce3f09 has 1 messages in their inbox\r\nthe subjects are as follows:\r\n['Your confirmation is needed to join the reading-group@local.edu\\n mailing list.']\r\nFound 1 candidate confirmation messages\r\nMessage details:\r\n  From: reading-group-confirm+bf54356632727bd8770783c85c399ea352f510b1@local.edu\r\n  To: 0c0537ae96ce3f09@local.edu\r\n  Subject: Your confirmation is needed to join the reading-group@local.edu\r\n mailing list.\r\n  Body: Email Address Registration Confirmation\r\n\r\nHello, this is the GNU Mailman server at local.edu.\r\n\r\nWe have received a registration request for the email address\r\n\r\n    0c0537ae96ce3f09@local.edu\r\n\r\nBefore you can start using GNU Mailman at this site, you must first confirm\r\nthat this is your email address.  You can do this by replying to this message.\r\n\r\nOr you should include the following line -- and only the following\r\nline -- in a message to reading-group-request@local.edu:\r\n\r\n    confirm bf54356632727bd877...\r\nReply to reading-group-confirm+bf54356632727bd8770783c85c399ea352f510b1@local.edu from 0c0537ae96ce3f09@local.edu for join\r\nRetrying in 2 seconds...\r\n0c0537ae96ce3f09 has confirmed their subscription\r\nEXIT:0\r\n"]
