[217.048981, "o", "\u001b[0m$ \u001b[0mcat > /tmp/test_full.py <<'PY'\r\nimport os, sys, mailbox, time\r\nsys.path.insert(0, '/app')\r\nimport eval as E\r\n\r\ndef mbox_has(user, subject):\r\n    m = mailbox.mbox(f\"/var/mail/{user}\")\r\n    return any(msg.get('Subject','') == subject for msg in m)\r\n\r\ndef assert_exists(u):\r\n    assert os.path.exists(f'/var/mail/{u}'), 'mailbox missing'\r\n\r\ndef assert_member(u, want=True):\r\n    m = E.get_mlist().members.get_member(f'{u}@local.edu')\r\n    assert (m is not None) == want, f'membership for {u} != {want}'\r\n\r\nu1 = os.urandom(6).hex(); u2 = os.urandom(6).hex()\r\nE.add_user(u1); E.add_user(u2)\r\nfor u in (u1,u2):\r\n    E.send_email(body='', subject='', from_addr=f'{u}@local.edu', to_addr=E.JOIN_LIST)\r\n    E.retry(lambda u=u: assert_exists(u))\r\n    E.retry(lambda u=u: E.confirm_last_reply(u, 'join'))\r\n    E.retry(lambda u=u: assert_member(u, True))\r\nprint('both joined')\r\n\r\nsubject='Test Announcement 12345'\r\nE.send_email(body='hello everyone', subject=subject, from_addr=f'{u1}@local.edu', to_addr=E.MAILING_LIST)\r\nE.retry(lambda: mbox_has(u2, subject))\r\nprint('announcement delivered')\r\nassert mbox_has(u1, subject), 'sender did not get own post'\r\n\r\nE.send_email(body='', subject='', from_addr=f'{u2}@local.edu', to_addr=E.LEAVE_LIST)\r\nE.retry(lambda u2=u2: E.confirm_last_reply(u2, 'leave'))\r\nE.retry(lambda: assert_member(u2, False))\r\nprint('leave works')\r\n\r\nsubject2='After Leave Announcement 67890'\r\nE.send_email(body='bye', subject=subject2, from_addr=f'{u1}@local.edu', to_addr=E.MAILING_LIST)\r\ntime.sleep(6)\r\nassert not mbox_has(u2, subject2), 'left user still got post'\r\nprint('left user no longer receives posts')\r\nPY\r\ncd /app && python3 /tmp/test_full.py 2>&1 | tail -60; echo \"EXIT:${PIPESTATUS[0]}\"\r\nff0eaa3066d1 has 1 messages in their inbox\r\nthe subjects are as follows:\r\n['Your confirmation is needed to join the reading-group@local.edu\\n mailing list.']\r\nFound 1 candidate confirmation messages\r\nMessage details:\r\n  From: reading-group-confirm+059159b2553e163b5982bba807a2c2c066fc155c@local.edu\r\n  To: ff0eaa3066d1@local.edu\r\n  Subject: Your confirmation is needed to join the reading-group@local.edu\r\n mailing list.\r\n  Body: Email Address Registration Confirmation\r\n\r\nHello, this is the GNU Mailman server at local.edu.\r\n\r\nWe have received a registration request for the email address\r\n\r\n    ff0eaa3066d1@local.edu\r\n\r\nBefore you can start using GNU Mailman at this site, you must first confirm\r\nthat this is your email address.  You can do this by replying to this message.\r\n\r\nOr you should include the following line -- and only the following\r\nline -- in a message to reading-group-request@local.edu:\r\n\r\n    confirm 059159b2553e163b5982bb...\r\nReply to reading-group-confirm+059159b2553e163b5982bba807a2c2c066fc155c@local.edu from ff0eaa3066d1@local.edu for join\r\nRetrying in 2 seconds...\r\nRetrying in 2 seconds...\r\n3c6de43e3320 has 1 messages in their inbox\r\nthe subjects are as follows:\r\n['Your confirmation is needed to join the reading-group@local.edu\\n mailing list.']\r\nFound 1 candidate confirmation messages\r\nMessage details:\r\n  From: reading-group-confirm+e5d2d141c3e11178fa9c0e09ff6b7602ebb1b3ff@local.edu\r\n  To: 3c6de43e3320@local.edu\r\n  Subject: Your confirmation is needed to join the reading-group@local.edu\r\n mailing list.\r\n  Body: Email Address Registration Confirmation\r\n\r\nHello, this is the GNU Mailman server at local.edu.\r\n\r\nWe have received a registration request for the email address\r\n\r\n    3c6de43e3320@local.edu\r\n\r\nBefore you can start using GNU Mailman at this site, you must first confirm\r\nthat this is your email address.  You can do this by replying to this message.\r\n\r\nOr you should include the following line -- and only the following\r\nline -- in a message to reading-group-request@local.edu:\r\n\r\n    confirm e5d2d141c3e11178fa9c0e...\r\nReply to reading-group-confirm+e5d2d141c3e11178fa9c0e09ff6b7602ebb1b3ff@local.edu from 3c6de43e3320@local.edu for join\r\nRetrying in 2 seconds...\r\nboth joined\r\nannouncement delivered\r\nTraceback (most recent call last):\r\n  File \"/tmp/test_full.py\", line 29, in <module>\r\n    assert mbox_has(u1, subject), 'sen"]
