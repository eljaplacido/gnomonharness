[50.676898, "o", "\u001b[0m$ \u001b[0mmkdir -p /run/mailman3 && chown list:list /run/mailman3 && chmod 755 /run/mailman3 && chown -R list:list /var/log/mailman3 /var/lib/mailman3 && echo done; ls -ld /run/mailman3 /var/log/mailman3 /var/lib/mailman3\r\ndone\r\ndrwxr-xr-x 1 list list 4096 Oct 31 12:15 /run/mailman3\r\ndrwxr-xr-x 1 list list 4096 Nov  1 03:37 /var/lib/mailman3\r\ndrwxr-xr-x 1 list list 4096 Nov  1 03:37 /var/log/mailman3\r\n"]
[50.729303, "o", "\u001b[0m$ \u001b[0mcd /etc/mailman3 && cp mailman.cfg mailman.cfg.bak && python3 - <<'PY'\r\nimport re\r\np='/etc/mailman3/mailman.cfg'\r\ns=open(p).read()\r\ns=s.replace('site_owner: changeme@example.com','site_owner: postmaster@local.edu')\r\nopen(p,'w').write(s)\r\nPY\r\ngrep -n \"site_owner\\|incoming:\\|lmtp_host\\|lmtp_port\\|configuration:\" /etc/mailman3/mailman.cfg\r\n28:site_owner: postmaster@local.edu\r\n243:#incoming: mailman.mta.exim4.LMTP\r\n244:incoming: mailman.mta.postfix.LMTP\r\n261:lmtp_host: 127.0.0.1\r\n262:lmtp_port: 8024\r\n270:#configuration: python:mailman.config.exim4\r\n271:configuration: python:mailman.config.postfix\r\n"]
