[64.768654, "o", "\u001b[0m$ \u001b[0mpostconf -e 'mydestination = $myhostname, localhost, localhost.localdomain, local.edu, localhost'\r\npostconf -e 'transport_maps = hash:/var/lib/mailman3/data/postfix_lmtp'\r\npostconf -e 'local_recipient_maps = proxy:unix:passwd.byname $alias_maps hash:/var/lib/mailman3/data/postfix_lmtp'\r\npostconf -e 'maillog_file = /var/log/mail.log'\r\npostfix check 2>&1; echo \"CHECK:$?\"; /usr/sbin/postmap /etc/aliases; echo \"ALIASES:$?\"; postconf -n | grep -E 'mydestination|transport_maps|local_recipient_maps'\r\nCHECK:0\r\npostmap: warning: /etc/aliases, line 2: record is in \"key: value\" format; is this an alias file?\r\nALIASES:0\r\nlocal_recipient_maps = proxy:unix:passwd.byname $alias_maps hash:/var/lib/mailman3/data/postfix_lmtp\r\nmydestination = $myhostname, localhost, localhost.localdomain, local.edu, localhost\r\ntransport_maps = hash:/var/lib/mailman3/data/postfix_lmtp\r\n"]
