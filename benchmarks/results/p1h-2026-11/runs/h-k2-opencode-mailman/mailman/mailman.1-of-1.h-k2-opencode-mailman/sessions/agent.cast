[255.242875, "o", "\u001b[0m$ \u001b[0mgrep -rn \"def unregister\" -A 30 /usr/lib/python3/dist-packages/mailman/app/subscriptions.py | head -80; echo \"===\"; grep -rn \"config.db\" /usr/lib/python3/dist-packages/mailman/commands/cli_delmembers.py /usr/lib/python3/dist-packages/mailman/app/*.py | head\r\n587:    def unregister(self, subscriber=None, *,\r\n588-                   pre_confirmed=False, pre_approved=False):\r\n589-        workflow = UnSubscriptionWorkflow(\r\n590-            self._mlist, subscriber,\r\n591-            pre_confirmed=pre_confirmed,\r\n592-            pre_approved=pre_approved)\r\n593-        list(workflow)\r\n594-        return workflow.token, workflow.token_owner, workflow.member\r\n595-\r\n596-    def confirm(self, token):\r\n597-        if token is None:\r\n598-            raise LookupError\r\n599-        pendable = getUtility(IPendings).confirm(token, expunge=False)\r\n600-        if pendable is None:\r\n601-            raise LookupError\r\n602-        workflow_type = pendable.get('type')\r\n603-        assert workflow_type in (PendableSubscription.PEND_TYPE,\r\n604-                                 PendableUnsubscription.PEND_TYPE)\r\n605-        workflow = (SubscriptionWorkflow\r\n606-                    if workflow_type == PendableSubscription.PEND_TYPE\r\n607-                    else UnSubscriptionWorkflow)(self._mlist)\r\n608-        workflow.token = token\r\n609-        workflow.restore()\r\n610-        # In order to just run the whole workflow, all we need to do\r\n611-        # is iterate over the workflow object. On calling the __next__\r\n612-        # over the workflow iterator it automatically executes the steps\r\n613-        # that needs to be done.\r\n614-        list(workflow)\r\n615-        return workflow.token, workflow.token_owner, workflow.member\r\n616-\r\n617-    def discard(self, token):\r\n===\r\n"]
