[251.291998, "o", "\u001b[0m$ \u001b[0mgrep -rn \"class MemberRoster\" -A 80 /usr/lib/python3/dist-packages/mailman/model/roster.py | head -120; echo \"===\"; grep -rn \"def unsubscribe\" -A 15 /usr/lib/python3/dist-packages/mailman/model/mailinglist.py | head -60\r\n145:class MemberRoster(AbstractRoster):\r\n146-    \"\"\"Return all the members of a list.\"\"\"\r\n147-\r\n148-    name = 'member'\r\n149-    role = MemberRole.member\r\n150-\r\n151-\r\n152-@public\r\n153-class NonmemberRoster(AbstractRoster):\r\n154-    \"\"\"Return all the nonmembers of a list.\"\"\"\r\n155-\r\n156-    name = 'nonmember'\r\n157-    role = MemberRole.nonmember\r\n158-\r\n159-\r\n160-@public\r\n161-class OwnerRoster(AbstractRoster):\r\n162-    \"\"\"Return all the owners of a list.\"\"\"\r\n163-\r\n164-    name = 'owner'\r\n165-    role = MemberRole.owner\r\n166-\r\n167-\r\n168-@public\r\n169-class ModeratorRoster(AbstractRoster):\r\n170-    \"\"\"Return all the moderators of a list.\"\"\"\r\n171-\r\n172-    name = 'moderator'\r\n173-    role = MemberRole.moderator\r\n174-\r\n175-\r\n176-@public\r\n177-class AdministratorRoster(AbstractRoster):\r\n178-    \"\"\"Return all the administrators of a list.\"\"\"\r\n179-\r\n180-    name = 'administrator'\r\n181-\r\n182-    @dbconnection\r\n183-    def _query(self, store):\r\n184-        return store.query(Member).filter(\r\n185-            Member.list_id == self._mlist.list_id,\r\n186-            or_(Member.role == MemberRole.owner,\r\n187-                Member.role == MemberRole.moderator))\r\n188-\r\n189-    @dbconnection\r\n190-    def get_member(self, store, email):\r\n191-        \"\"\"See `IRoster`.\"\"\"\r\n192-        members = store.query(Member).filter(\r\n193-            Member.list_id == self._mlist.list_id,\r\n194-            or_(Member.role == MemberRole.moderator,\r\n195-                Member.role == MemberRole.owner),\r\n196-            Address.email == email,\r\n197-            Member.address_id == Address.id).all()\r\n198-        if len(members) == 0:\r\n199-            return None\r\n200-        for member in members:\r\n201-            if member.role == MemberRole.owner:\r\n202-                return member\r\n203-        assert len(members) == 1, 'mlist.administrators has too many members'\r\n204-        return members[0]\r\n205-\r\n206-\r\n207-@public\r\n208-class DeliveryMemberRoster(AbstractRoster):\r\n209-    \"\"\"Return all the members having a particular kind of delivery.\"\"\"\r\n210-\r\n211-    role = MemberRole.member\r\n212-\r\n213-    @property\r\n214-    def member_count(self):\r\n215-        \"\"\"See `IRoster`.\"\"\"\r\n216-        # XXX 2012-03-15 BAW: It would be nice to make this more efficient.\r\n217-        # The problem is that you'd have to change the loop in _get_members()\r\n218-        # checking the delivery mode to a query parameter.\r\n219-        return len(tuple(self.members))\r\n220-\r\n221-    @dbconnection\r\n222-    def _get_members(self, store, *delivery_modes):\r\n223-        \"\"\"The set of members for a mailing list, filter by delivery mode.\r\n224-\r\n225-        :param delivery_modes: The modes to filter on.\r\n===\r\n328:    def unsubscribe_address(self):\r\n329-        \"\"\"See `IMailingList`.\"\"\"\r\n330-        return '{}-unsubscribe@{}'.format(self.list_name, self.mail_host)\r\n331-\r\n332-    def confirm_address(self, cookie):\r\n333-        \"\"\"See `IMailingList`.\"\"\"\r\n334-        local_part = expand(config.mta.verp_confirm_format, self, dict(\r\n335-            address='{}-confirm'.format(self.list_name),\r\n336-            cookie=cookie))\r\n337-        return '{}@{}'.format(local_part, self.mail_host)\r\n338-\r\n339-    @property\r\n340-    def preferred_language(self):\r\n341-        \"\"\"See `IMailingList`.\"\"\"\r\n342-        return getUtility(ILanguageManager)[self._preferred_language]\r\n343-\r\n"]
