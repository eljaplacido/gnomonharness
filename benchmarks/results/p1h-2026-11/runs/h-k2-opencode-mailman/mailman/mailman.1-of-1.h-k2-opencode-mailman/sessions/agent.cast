[20.256951, "o", "\u001b[0m$ \u001b[0mls -la /usr/lib/mailman3/bin/; echo \"---\"; python3 -c \"import mailman; print(mailman.__version__, mailman.__file__)\"; echo \"---\"; ls -la /var/lib/mailman3/ 2>/dev/null; ls -la /var/lib/mailman3/lists 2>/dev/null; echo \"---\"; cat /etc/postfix/master.cf | grep -v '^#' | grep -v '^$' | tail -40\r\ntotal 20\r\ndrwxr-xr-x 2 root root 4096 Oct 31 12:15 .\r\ndrwxr-xr-x 3 root root 4096 Oct 31 12:15 ..\r\n-rwxr-xr-x 1 root root  958 Aug 25  2024 mailman\r\n-rwxr-xr-x 1 root root  956 Aug 25  2024 master\r\n-rwxr-xr-x 1 root root  956 Aug 25  2024 runner\r\n---\r\nTraceback (most recent call last):\r\n  File \"<string>\", line 1, in <module>\r\nAttributeError: module 'mailman' has no attribute '__version__'\r\n---\r\ntotal 16\r\ndrwxr-xr-x 3 list list 4096 Oct 31 12:15 .\r\ndrwxr-xr-x 1 root root 4096 Oct 31 12:15 ..\r\ndrwxrwx--- 2 list list 4096 Oct 31 12:15 data\r\n---\r\nsmtp      inet  n       -       y       -       -       smtpd\r\npickup    unix  n       -       y       60      1       pickup\r\ncleanup   unix  n       -       y       -       0       cleanup\r\nqmgr      unix  n       -       n       300     1       qmgr\r\ntlsmgr    unix  -       -       y       1000?   1       tlsmgr\r\nrewrite   unix  -       -       y       -       -       trivial-rewrite\r\nbounce    unix  -       -       y       -       0       bounce\r\ndefer     unix  -       -       y       -       0       bounce\r\ntrace     unix  -       -       y       -       0       bounce\r\nverify    unix  -       -       y       -       1       verify\r\nflush     unix  n       -       y       1000?   0       flush\r\nproxymap  unix  -       -       n       -       -       proxymap\r\nproxywrite unix -       -       n       -       1       proxymap\r\nsmtp      unix  -       -       y       -       -       smtp\r\nrelay     unix  -       -       y       -       -       smtp\r\n        -o syslog_name=postfix/$service_name\r\nshowq     unix  n       -       y       -       -       showq\r\nerror     unix  -       -       y       -       -       error\r\nretry     unix  -       -       y       -       -       error\r\ndiscard   unix  -       -       y       -       -       discard\r\nlocal     unix  -       n       n       -       -       local\r\nvirtual   unix  -       n       n       -       -       virtual\r\nlmtp      unix  -       -       y       -       -       lmtp\r\nanvil     unix  -       -       y       -       1       anvil\r\nscache    unix  -       -       y       -       1       scache\r\npostlog   unix-dgram n  -       n       -       1       postlogd\r\nuucp      unix  -       n       n       -       -       pipe\r\n  flags=Fqhu user=uucp argv=uux -r -n -z -a$sender - $nexthop!rmail ($recipient)\r\n"]
