[39.810265, "o", "\u001b[0m$ \u001b[0mgrep -rn \"domain\" /usr/lib/python3/dist-packages/mailman/commands/cli_create.py /usr/lib/python3/dist-packages/mailman/commands/cli_lists.py 2>/dev/null | head -20; grep -rln \"class.*Create\" /usr/lib/python3/dist-packages/mailman/ | head\r\n/usr/lib/python3/dist-packages/mailman/commands/cli_lists.py:33:from mailman.interfaces.domain import (\r\n/usr/lib/python3/dist-packages/mailman/commands/cli_lists.py:71:    '--domain', 'domains',\r\n/usr/lib/python3/dist-packages/mailman/commands/cli_lists.py:74:    List only those mailing lists hosted on the given domain, which\r\n/usr/lib/python3/dist-packages/mailman/commands/cli_lists.py:78:def lists(ctx, advertised, names, descriptions, quiet, domains):\r\n/usr/lib/python3/dist-packages/mailman/commands/cli_lists.py:85:        if len(domains) > 0 and mlist.mail_host not in domains:\r\n/usr/lib/python3/dist-packages/mailman/commands/cli_lists.py:130:    list is required.  It must be a valid email address and the domain must be\r\n/usr/lib/python3/dist-packages/mailman/commands/cli_lists.py:157:    '--domain/--no-domain', '-d/-D', 'create_domain',\r\n/usr/lib/python3/dist-packages/mailman/commands/cli_lists.py:160:    Register the mailing list's domain if not yet registered.  This is\r\n/usr/lib/python3/dist-packages/mailman/commands/cli_lists.py:162:    compatibility.  With -D do not register the mailing list's domain.\"\"\"))\r\n/usr/lib/python3/dist-packages/mailman/commands/cli_lists.py:165:def create(ctx, language, owners, notify, quiet, create_domain, fqdn_listname):\r\n/usr/lib/python3/dist-packages/mailman/commands/cli_lists.py:171:    # Check to see if the domain exists or not.\r\n/usr/lib/python3/dist-packages/mailman/commands/cli_lists.py:172:    listname, at, domain = fqdn_listname.partition('@')\r\n/usr/lib/python3/dist-packages/mailman/commands/cli_lists.py:173:    domain_manager = getUtility(IDomainManager)\r\n/usr/lib/python3/dist-packages/mailman/commands/cli_lists.py:174:    if domain_manager.get(domain) is None and create_domain:\r\n/usr/lib/python3/dist-packages/mailman/commands/cli_lists.py:175:        domain_manager.add(domain)\r\n/usr/lib/python3/dist-packages/mailman/commands/cli_lists.py:193:    except BadDomainSpecificationError as domain:              # noqa: F841\r\n/usr/lib/python3/dist-packages/mailman/commands/cli_lists.py:194:        ctx.fail(_('Undefined domain: ${domain}'))\r\n/usr/lib/python3/dist-packages/mailman/commands/cli_lists.py:205:            'domain:admin:notice:new-list', mlist)\r\n/usr/lib/python3/dist-packages/mailman/commands/tests/test_cli_create.py\r\n/usr/lib/python3/dist-packages/mailman/commands/cli_lists.py\r\n/usr/lib/python3/dist-packages/mailman/interfaces/listmanager.py\r\n/usr/lib/python3/dist-packages/mailman/interfaces/domain.py\r\n"]
[40.341838, "o", "\u001b[0m$ \u001b[0mgrep -rln \"class Create\\|@cli.command\" /usr/lib/python3/dist-packages/mailman/commands/ | head; echo \"===\"; grep -rn \"def create\" /usr/lib/python3/dist-packages/mailman/commands/ | head; echo \"===\"; /usr/lib/mailman3/bin/mailman --run-as-root create --help 2>&1 | head -50\r\n/usr/lib/python3/dist-packages/mailman/commands/cli_lists.py\r\n===\r\n/usr/lib/python3/dist-packages/mailman/commands/cli_lists.py:165:def create(ctx, language, owners, notify, quiet, create_domain, fqdn_listname):\r\n===\r\nUsage: mailman create [OPTIONS] LISTNAME\r\n\r\n  Create a mailing list.\r\n\r\n  The 'fully qualified list name', i.e. the posting address of the mailing\r\n  list is required.  It must be a valid email address and the domain must be\r\n  registered with Mailman.  List names are forced to lower case.\r\n\r\nOptions:\r\n  --language CODE                 Set the list's preferred language to CODE,\r\n                                  which must be a registered two letter\r\n                                  language code.\r\n  -o, --owner OWNER               Specify a list owner email address.  If the\r\n                                  address is not currently registered with\r\n                                  Mailman, the address is registered and\r\n                                  linked to a user. Mailman will send a\r\n                                  confirmation message to the address, but it\r\n                                  will also send a list creation notice to the\r\n                                  address.  More than one owner can be\r\n                                  specified.\r\n  -n, --notify / -no-notify, -N   Notify the list owner by email that their\r\n                                  mailing list has been created.\r\n  -q, --quiet                     Print less output.\r\n  -d, --domain / -D, --no-domain  Register the mailing list's domain if not\r\n                                  yet registered.  This is the default\r\n                                  behavior, but these options are provided for\r\n                                  backward compatibility.  With -D do not\r\n                                  register the mailing list's domain.\r\n  -h, --help                      Show this message and exit.\r\n"]
