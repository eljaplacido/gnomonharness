[43.357769, "o", "\u001b[0m$ \u001b[0mgrep -rn \"class SubscriptionPolicy\" -A 60 /usr/lib/python3/dist-packages/mailman/interfaces/mailinglist.py; echo \"===\"; grep -rn \"SubscriptionPolicy.open\\|subscription_policy\" /usr/lib/python3/dist-packages/mailman/workflows/subscription.py /usr/lib/python3/dist-packages/mailman/model/mailinglist.py | head -40\r\n80:class SubscriptionPolicy(Enum):\r\n81-    \"\"\"All subscription/unsubscription policies for a mailing list.\"\"\"\r\n82-    # Neither confirmation, nor moderator approval is required.\r\n83-    open = 0\r\n84-    # The user must confirm the subscription.\r\n85-    confirm = 1\r\n86-    # The moderator must approve the subscription.\r\n87-    moderate = 2\r\n88-    # The user must first confirm their subscription, and then if that is\r\n89-    # successful, the moderator must also approve it.\r\n90-    confirm_then_moderate = 3\r\n91-\r\n92-\r\n93-@public\r\n94-class ArchiveRenderingMode(Enum):\r\n95-    \"\"\"Email rendering mode in Archiver.\"\"\"\r\n96-    # Default text.\r\n97-    text = 1\r\n98-    # Render emails as markdown text.\r\n99-    markdown = 2\r\n100-\r\n101-\r\n102-@public\r\n103-class IMailingList(Interface):\r\n104-    \"\"\"A mailing list.\"\"\"\r\n105-\r\n106-    # List identity\r\n107-\r\n108-    created_at = Attribute(\r\n109-        \"\"\"The date and time that the mailing list was created.\"\"\")\r\n110-\r\n111-    list_name = Attribute(\"\"\"\\\r\n112-        The read-only short name of the mailing list.  Note that where a\r\n113-        Mailman installation supports multiple domains, this short name may\r\n114-        not be unique.  Use the fqdn_listname attribute for a guaranteed\r\n115-        unique id for the mailing list.  This short name is always the local\r\n116-        part of the posting email address.  For example, if messages are\r\n117-        posted to mylist@example.com, then the list_name is 'mylist'.\r\n118-        \"\"\")\r\n119-\r\n120-    mail_host = Attribute(\"\"\"\\\r\n121-        The read-only domain name 'hosting' this mailing list.  This is always\r\n122-        the domain name part of the posting email address, and it may bear no\r\n123-        relationship to the web url used to access this mailing list.  For\r\n124-        example, if messages are posted to mylist@example.com, then the\r\n125-        mail_host is 'example.com'.\r\n126-        \"\"\")\r\n127-\r\n128-    list_id = Attribute(\"\"\"\\\r\n129-        The identity of the mailing list.  This value will never change.  It\r\n130-        is defined in RFC 2369.\r\n131-        \"\"\")\r\n132-\r\n133-    fqdn_listname = Attribute(\"\"\"\\\r\n134-        The read-only fully qualified name of the mailing list.  This is the\r\n135-        guaranteed unique id for the mailing list, and it is always the\r\n136-        address to which messages are posted, e.g. mylist@example.com.  It is\r\n137-        always comprised of the list_name + '@' + mail_host.\r\n138-        \"\"\")\r\n139-\r\n140-    domain = Attribute(\r\n===\r\ngrep: /usr/lib/python3/dist-packages/mailman/workflows/subscription.py: No such file or directory\r\n/usr/lib/python3/dist-packages/mailman/model/mailinglist.py:214:    subscription_policy = Column(Enum(SubscriptionPolicy))\r\n/usr/lib/python3/dist-packages/mailman/model/mailinglist.py:218:    unsubscription_policy = Column(Enum(SubscriptionPolicy))\r\n"]
