[318.905432, "o", "\u001b[0m$ \u001b[0mcat > /tmp/test_full2.py <<'PY'\r\nimport os, sys, mailbox, time\r\nsys.path.insert(0, '/app')\r\nimport eval as E\r\n\r\ndef subjects(user):\r\n    return [str(m.get('Subject','')) for m in mailbox.mbox(f'/var/mail/{user}')]\r\n\r\ndef assert_exists(u):\r\n    assert os.path.exists(f'/var/mail/{u}'), 'mailbox missing'\r\n\r\ndef assert_member(u, want=True):\r\n    m = E.get_mlist().members.get_member(f'{u}@local.edu')\r\n    assert (m is not None) == want, f'membership for {u} != {want}'\r\n\r\ndef assert_has(u, subj):\r\n    ss = subjects(u)\r\n    assert any(subj in s for s in ss), f'{subj!r} not in {ss}'\r\n\r\ndef assert_not_has(u, subj):\r\n    ss = subjects(u)\r\n    assert not any(subj in s for s in ss), f'{subj!r} unexpectedly in {ss}'\r\n\r\nu1 = os.urandom(6).hex(); u2 = os.urandom(6).hex()\r\nE.add_user(u1); E.add_user(u2)\r\nfor u in (u1,u2):\r\n    E.send_email(body='', subject='', from_addr=f'{u}@local.edu', to_addr=E.JOIN_LIST)\r\n    E.retry(lambda u=u: assert_exists(u))\r\n    E.retry(lambda u=u: E.confirm_last_reply(u, 'join'))\r\n    E.retry(lambda u=u: assert_member(u, True))\r\nprint('both joined')\r\n\r\nsubj1='Announcement Before Leave 111'\r\nE.send_email(body='hello', subject=subj1, from_addr=f'{u1}@local.edu', to_addr=E.MAILING_LIST)\r\nE.retry(lambda: assert_has(u1, subj1))\r\nE.retry(lambda: assert_has(u2, subj1))\r\nprint('announcement delivered to both')\r\n\r\nE.send_email(body='', subject='', from_addr=f'{u2}@local.edu', to_addr=E.LEAVE_LIST)\r\nE.retry(lambda u2=u2: assert_exists(u2))\r\nE.retry(lambda u2=u2: E.confirm_last_reply(u2, 'leave'))\r\nE.retry(lambda: assert_member(u2, False))\r\nprint('leave works')\r\n\r\nsubj2='Announcement After Leave 222'\r\nE.send_email(body='bye', subject=subj2, from_addr=f'{u1}@local.edu', to_addr=E.MAILING_LIST)\r\nE.retry(lambda: assert_has(u1, subj2))\r\ntime.sleep(5)\r\nassert_not_has(u2, subj2)\r\nprint('left user no longer receives posts')\r\nPY\r\ncd /app && python3 /tmp/test_full2.py 2>&1 | tail -50; echo \"EXIT:${PIPESTATUS[0]}\"\r\nOr you should include the following line -- and only the following\r\nline -- in a message to reading-group-request@local.edu:\r\n\r\n    confirm 773ddde5671dec6b6eddeb...\r\nReply to reading-group-confirm+773ddde5671dec6b6eddebb02e42e7be3fe2a047@local.edu from 196ed6d15977@local.edu for join\r\nRetrying in 2 seconds...\r\nboth joined\r\nRetrying in 2 seconds...\r\nannouncement delivered to both\r\n196ed6d15977 has 3 messages in their inbox\r\nthe subjects are as follows:\r\n['Your confirmation is needed to join the reading-group@local.edu\\n mailing list.', 'Welcome to the \"Reading-group\" mailing list', '[Reading-group] Announcement Before Leave 111']\r\nFound 0 candidate confirmation messages\r\nRetrying in 2 seconds...\r\n196ed6d15977 has 3 messages in their inbox\r\nthe subjects are as follows:\r\n['Your confirmation is needed to join the reading-group@local.edu\\n mailing list.', 'Welcome to the \"Reading-group\" mailing list', '[Reading-group] Announcement Before Leave 111']\r\nFound 0 candidate confirmation messages\r\nRetrying in 4 seconds...\r\n196ed6d15977 has 4 messages in their inbox\r\nthe subjects are as follows:\r\n['Your confirmation is needed to join the reading-group@local.edu\\n mailing list.', 'Welcome to the \"Reading-group\" mailing list', '[Reading-group] Announcement Before Leave 111', 'Your confirmation is needed to leave the reading-group@local.edu\\n mailing list.']\r\nFound 1 candidate confirmation messages\r\nMessage details:\r\n  From: reading-group-confirm+1645ea2df9ab52db66e2c0a5232569bcb8756c7b@local.edu\r\n  To: 196ed6d15977@local.edu\r\n  Subject: Your confirmation is needed to leave the reading-group@local.edu\r\n mailing list.\r\n  Body: Email Address Unsubscription Confirmation\r\n\r\nHello, this is the GNU Mailman server at local.edu.\r\n\r\nWe have received an unsubscription request for the email address\r\n\r\n    196ed6d15977@local.edu\r\n\r\nBefore GNU Mailman can unsubscribe you, you must first confirm your request.\r\nYou can do this by simply replying to this message.\r\n\r\nOr you should include the following line -- and only the following\r\nline -- in a message to reading-group-request@local.edu:\r\n\r\n    confirm 1645ea2df9ab52db66e2c0a5232569bcb87"]
[318.905552, "o", "56c7b\r\n\r\nN...\r\nReply to reading-group-confirm+1645ea2df9ab52db66e2c0a5232569bcb8756c7b@local.edu from 196ed6d15977@local.edu for leave\r\nRetrying in 2 seconds...\r\nleave works\r\nRetrying in 2 seconds...\r\nleft user no longer receives posts\r\nEXIT:0\r\n"]
