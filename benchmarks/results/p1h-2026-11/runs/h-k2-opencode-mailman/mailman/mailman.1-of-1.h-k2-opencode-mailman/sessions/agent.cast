[121.83854, "o", "\u001b[0m$ \u001b[0mcat > /tmp/test_full.py <<'PY'\r\nimport os, sys, mailbox\r\nsys.path.insert(0, '/app')\r\nimport eval as E\r\n\r\ndef mbox_has(user, subject):\r\n    m = mailbox.mbox(f\"/var/mail/{user}\")\r\n    return any(msg.get('Subject','') == subject for msg in m)\r\n\r\nu1 = os.urandom(6).hex(); u2 = os.urandom(6).hex()\r\nE.add_user(u1); E.add_user(u2)\r\nfor u in (u1,u2):\r\n    E.send_email(body='', subject='', from_addr=f'{u}@local.edu', to_addr=E.JOIN_LIST)\r\n    E.retry(lambda: os.path.exists(f'/var/mail/{u}'))\r\n    E.retry(lambda u=u: E.confirm_last_reply(u, 'join'))\r\n    E.retry(lambda u=u: (_ for _ in ()).throw(AssertionError('not member')) if E.get_mlist().members.get_member(f'{u}@local.edu') is None else None)\r\nprint('both joined')\r\n\r\nsubject='Test Announcement 12345'\r\nE.send_email(body='hello everyone', subject=subject, from_addr=f'{u1}@local.edu', to_addr=E.MAILING_LIST)\r\nE.retry(lambda: mbox_has(u2, subject))\r\nprint('announcement delivered')\r\nassert mbox_has(u1, subject), 'sender did not get own post (may be acceptable)'\r\n\r\nE.send_email(body='', subject='', from_addr=f'{u2}@local.edu', to_addr=E.LEAVE_LIST)\r\nE.retry(lambda u2=u2: E.confirm_last_reply(u2, 'leave'))\r\nE.retry(lambda: (_ for _ in ()).throw(AssertionError('still member')) if E.get_mlist().members.get_member(f'{u2}@local.edu') is not None else None)\r\nprint('leave works')\r\n\r\nsubject2='After Leave Announcement 67890'\r\nE.send_email(body='bye', subject=subject2, from_addr=f'{u1}@local.edu', to_addr=E.MAILING_LIST)\r\nimport time\r\ntime.sleep(5)\r\nassert not mbox_has(u2, subject2), 'left user still got post'\r\nprint('left user no longer receives posts')\r\nPY\r\ncd /app && python3 /tmp/test_full.py 2>&1 | tail -60; echo \"EXIT:${PIPESTATUS[0]}\"\r\nc40a7ea78ec3 added successfully.\r\nb9ee9b55ab35 added successfully.\r\nc40a7ea78ec3 has 0 messages in their inbox\r\nthe subjects are as follows:\r\n[]\r\nFound 0 candidate confirmation messages\r\nRetrying in 2 seconds...\r\nc40a7ea78ec3 has 0 messages in their inbox\r\nthe subjects are as follows:\r\n[]\r\nFound 0 candidate confirmation messages\r\nRetrying in 4 seconds...\r\nc40a7ea78ec3 has 0 messages in their inbox\r\nthe subjects are as follows:\r\n[]\r\nFound 0 candidate confirmation messages\r\nRetrying in 8 seconds...\r\nc40a7ea78ec3 has 0 messages in their inbox\r\nthe subjects are as follows:\r\n[]\r\nFound 0 candidate confirmation messages\r\nRetrying in 16 seconds...\r\nc40a7ea78ec3 has 0 messages in their inbox\r\nthe subjects are as follows:\r\n[]\r\nFound 0 candidate confirmation messages\r\nTraceback (most recent call last):\r\n  File \"/tmp/test_full.py\", line 14, in <module>\r\n    E.retry(lambda u=u: E.confirm_last_reply(u, 'join'))\r\n  File \"/app/eval.py\", line 49, in retry\r\n    raise e\r\n  File \"/app/eval.py\", line 45, in retry\r\n    return func()\r\n           ^^^^^^\r\n  File \"/tmp/test_full.py\", line 14, in <lambda>\r\n    E.retry(lambda u=u: E.confirm_last_reply(u, 'join'))\r\n                        ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\r\n  File \"/app/eval.py\", line 114, in confirm_last_reply\r\n    assert candidate_msgs, \"No 'reading-group-confirm' messages found\"\r\n           ^^^^^^^^^^^^^^\r\nAssertionError: No 'reading-group-confirm' messages found\r\nEXIT:1\r\n"]
