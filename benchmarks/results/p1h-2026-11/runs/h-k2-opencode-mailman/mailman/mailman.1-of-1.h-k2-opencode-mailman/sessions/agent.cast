[246.942671, "o", "\u001b[0m$ \u001b[0mcat > /tmp/clean.py <<'PY'\r\nfrom mailman.core.initialize import initialize\r\nfrom mailman.interfaces.listmanager import IListManager\r\nfrom zope.component import getUtility\r\ninitialize('/etc/mailman3/mailman.cfg')\r\nm = getUtility(IListManager).get('reading-group@local.edu')\r\nfor member in list(m.members.members):\r\n    print('removing', member.address.email)\r\n    m.members.unregister(member.address.email)\r\nprint('members now:', [x.email for x in m.members.addresses])\r\nprint('owner:', [x.email for x in m.owners.addresses])\r\nprint('policy:', m.subscription_policy, m.unsubscription_policy)\r\nPY\r\nsu list -s /bin/bash -c 'python3 /tmp/clean.py' 2>&1\r\nremoving 639b0dba536de13c@local.edu\r\nTraceback (most recent call last):\r\n  File \"/tmp/clean.py\", line 8, in <module>\r\n    m.members.unregister(member.address.email)\r\n    ^^^^^^^^^^^^^^^^^^^^\r\nAttributeError: 'MemberRoster' object has no attribute 'unregister'\r\n"]
