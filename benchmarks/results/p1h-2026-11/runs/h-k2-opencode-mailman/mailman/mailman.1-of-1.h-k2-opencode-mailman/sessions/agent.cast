[167.600548, "o", "\u001b[0m$ \u001b[0mgrep -R \"CREATE_MAIL_SPOOL\\|MAIL_FILE\\|MAIL_DIR\" /etc/default/useradd /etc/login.defs /etc/adduser.conf 2>/dev/null; echo \"---\"; u=zzz$RANDOM; useradd $u; sleep 0.2; stat /var/mail/$u 2>&1 | head -8; userdel -r $u 2>/dev/null; true\r\n/etc/default/useradd:# CREATE_MAIL_SPOOL=no\r\n/etc/login.defs:# Three items must be defined:  MAIL_DIR, ENV_SUPATH, and ENV_PATH.\r\n/etc/login.defs:#   home directory.  If you _do_ define MAIL_DIR and MAIL_FILE,\r\n/etc/login.defs:#   MAIL_DIR takes precedence.\r\n/etc/login.defs:#      - MAIL_DIR defines the location of users mail spool files\r\n/etc/login.defs:#        (for mbox use) by appending the username to MAIL_DIR as defined\r\n/etc/login.defs:#      - MAIL_FILE defines the location of the users mail spool files as the\r\n/etc/login.defs:#        directory before $MAIL_FILE\r\n/etc/login.defs:MAIL_DIR        /var/mail\r\n/etc/login.defs:#MAIL_FILE      .mail\r\n/etc/login.defs:# QMAIL_DIR\r\n---\r\nstat: cannot statx '/var/mail/zzz27372': No such file or directory\r\n"]
