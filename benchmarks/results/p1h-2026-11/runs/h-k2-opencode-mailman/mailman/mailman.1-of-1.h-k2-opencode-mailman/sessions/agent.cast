[222.097873, "o", "\u001b[0m$ \u001b[0mgrep -E \"ff0eaa3066d1|3c6de43e3320\" /var/log/mail.log | tail -40; echo \"===\"; grep -n \"Test Announcement\" -r /var/log/mailman3/ || true; echo \"===\"; ls -la /var/mail/ff0eaa3066d1 /var/mail/3c6de43e3320; echo \"===\"; python3 - <<'PY'\r\nimport sys; sys.path.insert(0,'/app'); import eval as E, mailbox\r\nm=E.get_mlist()\r\nprint('members', [str(x) for x in m.members.addresses])\r\nfor u in ('ff0eaa3066d1','3c6de43e3320'):\r\n    mb=mailbox.mbox(f'/var/mail/{u}')\r\n    print(u, [str(x.get('Subject')) for x in mb])\r\nPY\r\nNov 01 03:40:05 localhost postfix/qmgr[5249]: 5E13428C2C03: from=<ff0eaa3066d1@local.edu>, size=487, nrcpt=1 (queue active)\r\nNov 01 03:40:07 localhost postfix/local[5292]: 2578F28C2C09: to=<ff0eaa3066d1@local.edu>, relay=local, delay=0.01, delays=0/0/0/0, dsn=2.0.0, status=sent (delivered to mailbox)\r\nNov 01 03:40:07 localhost postfix/qmgr[5249]: 5F63828C2C03: from=<ff0eaa3066d1@local.edu>, size=575, nrcpt=1 (queue active)\r\nNov 01 03:40:09 localhost postfix/local[5292]: 2882328C2C09: to=<ff0eaa3066d1@local.edu>, relay=local, delay=0.01, delays=0/0/0/0, dsn=2.0.0, status=sent (delivered to mailbox)\r\nNov 01 03:40:09 localhost postfix/qmgr[5249]: B50AC28C2C03: from=<3c6de43e3320@local.edu>, size=487, nrcpt=1 (queue active)\r\nNov 01 03:40:11 localhost postfix/local[5292]: 2C0D828C2C09: to=<3c6de43e3320@local.edu>, relay=local, delay=0.01, delays=0/0/0/0, dsn=2.0.0, status=sent (delivered to mailbox)\r\nNov 01 03:40:11 localhost postfix/qmgr[5249]: B663028C2C03: from=<3c6de43e3320@local.edu>, size=575, nrcpt=1 (queue active)\r\nNov 01 03:40:13 localhost postfix/local[5292]: 2F0E828C2C09: to=<3c6de43e3320@local.edu>, relay=local, delay=0.01, delays=0/0/0/0, dsn=2.0.0, status=sent (delivered to mailbox)\r\nNov 01 03:40:13 localhost postfix/qmgr[5249]: B8FC728C2C03: from=<ff0eaa3066d1@local.edu>, size=516, nrcpt=1 (queue active)\r\nNov 01 03:40:14 localhost postfix/local[5292]: 37FA528C2682: to=<3c6de