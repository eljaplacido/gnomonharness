[160.23801, "o", "\u001b[0m$ \u001b[0mcat > /tmp/race.py <<'PY'\r\nimport os, sys, time, subprocess, mailbox\r\nsys.path.insert(0, '/app')\r\nimport eval as E\r\nu = os.urandom(6).hex()\r\nE.add_user(u)\r\nprint('user', u)\r\nE.send_email(body='', subject='', from_addr=f'{u}@local.edu', to_addr=E.JOIN_LIST)\r\nfor i in range(100):\r\n    p=f'/var/mail/{u}'\r\n    if os.path.exists(p):\r\n        st=os.stat(p)\r\n        print(f'{i*0.1:.1f}s exists size={st.st_size} uid={st.st_uid} gid={st.st_gid} mode={oct(st.st_mode)}')\r\n        if st.st_uid != 0:\r\n            break\r\n    else:\r\n        if i%5==0: print(f'{i*0.1:.1f}s missing')\r\n    time.sleep(0.1)\r\nprint('final stat', os.stat(f'/var/mail/{u}') if os.path.exists(f'/var/mail/{u}') else None)\r\nPY\r\ncd /app && python3 /tmp/race.py 2>&1 | tail -40\r\n8e79d1eab0e5 added successfully.\r\nuser 8e79d1eab0e5\r\n0.0s missing\r\n0.5s missing\r\n1.0s missing\r\n1.5s missing\r\n1.8s exists size=1935 uid=1005 gid=8 mode=0o100600\r\nfinal stat os.stat_result(st_mode=33152, st_ino=42740752, st_dev=42, st_nlink=1, st_uid=1005, st_gid=8, st_size=1935, st_atime=1793504357, st_mtime=1793504357, st_ctime=1793504357)\r\n"]
