[31.411862, "o", "\u001b[0m$ \u001b[0mcat /usr/lib/python3/dist-packages/mailman/config/postfix.cfg; echo \"===\"; sed -n '1,120p' /usr/lib/python3/dist-packages/mailman/commands/cli_create.py\r\n[postfix]\r\n# Additional configuration variables for the postfix MTA.\r\n\r\n# This variable describe the program to use for regenerating the transport map\r\n# db file, from the associated plain text files.  The file being updated will\r\n# be appended to this string (with a separating space), so it must be\r\n# appropriate for os.system().\r\npostmap_command: /usr/sbin/postmap\r\n\r\n# This variable describes the type of transport maps that will be generated by\r\n# mailman to be used with postfix for LMTP transport. By default, it is set to\r\n# hash, but mailman also supports `regex` tables.\r\ntransport_file_type: hash\r\n===\r\nsed: can't read /usr/lib/python3/dist-packages/mailman/commands/cli_create.py: No such file or directory\r\n"]
[31.435899, "o", "\u001b[0m$ \u001b[0mls -la /run/ | grep -i mail; ls -la /var/log/mailman3 2>/dev/null; echo \"===\"; cat /etc/mailman3/mailman.cfg | grep -n \"layout\\|mta\\|incoming\\|configuration\\|var_dir\" \r\ndrwxr-xr-x 2 list list 4096 Oct 31 12:15 mailman3\r\ntotal 12\r\ndrwxr-xr-x 1 list list 4096 Nov  1 03:37 .\r\ndrwxr-xr-x 1 root root 4096 Oct 31 12:15 ..\r\n-rw-rw---- 1 root root    0 Nov  1 03:37 bounce.log\r\n-rw-rw---- 1 root root    0 Nov  1 03:37 debug.log\r\n-rw-rw---- 1 root root    0 Nov  1 03:37 mailman.log\r\n-rw-rw---- 1 root root    0 Nov  1 03:37 plugins.log\r\n-rw-rw---- 1 root root    0 Nov  1 03:37 smtp.log\r\n===\r\n18:# This file contains the Debian configuration for mailman.  It uses ini-style\r\n19:# formats under the lazr.config regime to define all system configuration\r\n64:# Which paths.* file system layout to use.\r\n66:layout: debian\r\n104:# can be as simple as $var_dir/history.py to put the file in the var directory.\r\n110:# different layouts can be supported.   For example, a developer layout would\r\n111:# be different from a FHS layout.  Most paths are based off the var_dir, and\r\n116:# configuration variable in the paths.* section.  Substitutions are expanded\r\n122:var_dir: /var/lib/mailman3\r\n124:queue_dir: $var_dir/queue\r\n130:list_data_dir: $var_dir/lists\r\n134:lock_dir: $var_dir/locks\r\n136:data_dir: $var_dir/data\r\n138:cache_dir: $var_dir/cache\r\n139:# Directory for configuration files and such.\r\n142:ext_dir: $var_dir/ext\r\n144:messages_dir: $var_dir/messages\r\n147:archive_dir: $var_dir/archives\r\n149:template_dir: $var_dir/templates\r\n170:# 'configuration' substitutions.\r\n241:[mta]\r\n242:# The class defining the interface to the incoming mail transport agent.\r\n243:#incoming: mailman.mta.exim4.LMTP\r\n244:incoming: mailman.mta.postfix.LMTP\r\n249:outgoing: mailman.mta.deliver.deliver\r\n264:# Where can we find the mail server specific configuration file?  The path can\r\n270:#configuration: python:mailman.config.exim4\r\n271:configuration: python:mailman.config.postfix\r\n"]
