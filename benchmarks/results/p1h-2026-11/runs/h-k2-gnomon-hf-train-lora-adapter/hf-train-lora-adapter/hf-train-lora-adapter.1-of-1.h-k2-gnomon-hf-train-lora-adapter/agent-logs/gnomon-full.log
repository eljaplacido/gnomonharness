from transformers import AutoModelForCausalLM
from peft import LoraConfig, TaskType, get_peft_model
import torch.nn.functional as F
bs, sl, threads = int(sys.argv[1]), int(sys.argv[2]), int(sys.argv[3])
torch.set_num_threads(threads)
m=get_peft_model(AutoModelForCausalLM.from_pretrained("openai-community/gpt2"),
   LoraConfig(r=8,lora_alpha=16,target_modules=["c_attn"],lora_dropout=0.05,bias="none",task_type=TaskType.CAUSAL_LM))
m.train(); m.config.use_cache=False
base=m.base_model.model
opt=torch.optim.AdamW([p for p in m.parameters() if p.requires_grad], lr=1e-3)
def step():
    ids=torch.randint(0,50257,(bs,sl)); am=torch.ones_like(ids); lab=torch.full((bs,sl),-100); lab[:,-3:]=torch.randint(0,50257,(bs,3))
    with torch.autocast("cpu", dtype=torch.bfloat16):
        h=base.transformer(input_ids=ids, attention_mask=am).last_hidden_state
        sel=(lab!=-100).nonzero(as_tuple=False)
        logits=base.lm_head(h[sel[:,0], sel[:,1]]).float()
        loss=F.cross_entropy(logits, lab[sel[:,0], sel[:,1]])
    loss.backward(); opt.step(); opt.zero_grad()
step()
t=time.time()
for _ in range(3): step()
dt=(time.time()-t)/3
print(f"short bs{bs} sl{sl} th{threads}: {dt:.2f}s/step {bs*sl/dt:.0f} tok/s peak {resource.getrusage(resource.RUSAGE_SELF).ru_maxrss/1e6:.2f}GB")
