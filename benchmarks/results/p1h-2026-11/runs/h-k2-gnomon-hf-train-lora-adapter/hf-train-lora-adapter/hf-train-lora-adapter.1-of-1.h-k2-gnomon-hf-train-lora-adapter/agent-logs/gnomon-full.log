import sys, time, torch, resource
from transformers import AutoModelForCausalLM
from peft import LoraConfig, TaskType, get_peft_model
bs, sl, threads, iters = int(sys.argv[1]), int(sys.argv[2]), int(sys.argv[3]), int(sys.argv[4])
torch.set_num_threads(threads)
t0=time.time()
m=get_peft_model(AutoModelForCausalLM.from_pretrained("openai-community/gpt2"),
   LoraConfig(r=8,lora_alpha=16,target_modules=["c_attn"],lora_dropout=0.05,bias="none",task_type=TaskType.CAUSAL_LM))
m.train(); m.config.use_cache=False
print(f"load {time.time()-t0:.1f}s rss {resource.getrusage(resource.RUSAGE_SELF).ru_maxrss/1e6:.2f}GB")
opt=torch.optim.AdamW([p for p in m.parameters() if p.requires_grad], lr=1e-3)
for i in range(iters):
    ids=torch.randint(0,50257,(bs,sl)); am=torch.ones_like(ids); lab=ids.clone(); lab[:, :-2]=-100
    t=time.time()
    loss=m(input_ids=ids,attention_mask=am,labels=lab).loss
    loss.backward(); opt.step(); opt.zero_grad()
    print(f" iter{i} {time.time()-t:.2f}s peak {resource.getrusage(resource.RUSAGE_SELF).ru_maxrss/1e6:.2f}GB", flush=True)
EOF
