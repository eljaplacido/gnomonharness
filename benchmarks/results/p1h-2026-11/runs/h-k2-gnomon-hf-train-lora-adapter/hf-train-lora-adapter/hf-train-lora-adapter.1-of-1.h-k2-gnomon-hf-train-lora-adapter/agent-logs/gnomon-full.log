m=get_peft_model(AutoModelForCausalLM.from_pretrained("openai-community/gpt2"),
   LoraConfig(r=8,lora_alpha=16,target_modules=["c_attn"],lora_dropout=0.05,bias="none",task_type=TaskType.CAUSAL_LM))
m.train(); m.config.use_cache=False
opt=torch.optim.AdamW([p for p in m.parameters() if p.requires_grad], lr=1e-3)
def step():
    ids=torch.randint(0,50257,(bs,sl)); am=torch.ones_like(ids); lab=ids.clone(); lab[:, :-2]=-100
    if mode=="bf16":
        with torch.autocast("cpu", dtype=torch.bfloat16):
            loss=m(input_ids=ids,attention_mask=am,labels=lab).loss
    else:
        loss=m(input_ids=ids,attention_mask=am,labels=lab).loss
    loss.backward(); opt.step(); opt.zero_grad()
step()  # warmup
t=time.time()
for _ in range(3): step()
dt=(time.time()-t)/3
print(f"{mode} bs{bs} sl{sl} th{threads}: {dt:.2f}s/step {bs*sl/dt:.0f} tok/s peak {resource.getrusage(resource.RUSAGE_SELF).ru_maxrss/1e6:.2f}GB")
