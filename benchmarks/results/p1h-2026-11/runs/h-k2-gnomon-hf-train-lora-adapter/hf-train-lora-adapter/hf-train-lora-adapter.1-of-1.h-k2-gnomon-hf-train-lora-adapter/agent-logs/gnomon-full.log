import sys, time, torch, resource
from transformers import AutoModelForCausalLM
from peft import LoraConfig, TaskType, get_peft_model
bs, sl, mode, threads = int(sys.argv[1]), int(sys.argv[2]), sys.argv[3], int(sys.argv[4])
torch.set_num_threads(threads)
m=get_peft_model(AutoModelForCausalLM.from_pretrained("openai-community/gpt2"),
   LoraConfig(r=8,lora_alpha=16,target_modules=["c_attn"],lora_dropout=0.05,bias="none",task_type=TaskType.CAUSAL_LM))
m.train(); m.config.use_cache=False
if mode=="ckpt": m.gradient_checkpointing_enable()
base=m.base_model.model
ids=torch.randint(0,50257,(bs,sl)); am=torch.ones_like(ids); lab=ids.clone()
lab[:, :-2] = -100
t=time.time()
if mode=="short":
    h=base.transformer(input_ids=ids, attention_mask=am).last_hidden_state
    sel=(lab!=-100).nonzero(as_tuple=False)
    logits=base.lm_head(h[sel[:,0], sel[:,1]]).float()
    loss=torch.nn.functional.cross_entropy(logits, lab[sel[:,0], sel[:,1]])
else:
    loss=m(input_ids=ids,attention_mask=am,labels=lab).loss
loss.backward()
print(f"bs{bs} sl{sl} {mode} th{threads}: {time.time()-t:.2f}s loss {loss.item():.3f} peak {resource.getrusage(resource.RUSAGE_SELF).ru_maxrss/1e6:.2f}GB")
EOF
