[43.71162, "o", "    \u001b[2m=== file ===\u001b[0m\r\n    \u001b[2mRequire Import Arith.\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2mTheorem plus_comm : forall n m : nat,\u001b[0m\r\n    \u001b[2m  n + m = m + n.\u001b[0m\r\n    \u001b[2mProof.\u001b[0m\r\n    \u001b[2m  intros n m.\u001b[0m\r\n    \u001b[2m  induction n as [|n' IHn'].\u001b[0m\r\n    \u001b[2m  - (* Base case: 0 + m = m + 0 *)\u001b[0m\r\n    \u001b[2m    simpl.\u001b[0m\r\n    \u001b[2m\u001b[3m... (18 lines hidden, /toggle to show all)\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2mCoq < \u001b[0m\r\n    \u001b[2mCoq < Fetching opaque proofs from disk for plus_comm\u001b[0m\r\n    \u001b[2mFetching opaque proofs from disk for Coq.Init.Peano\u001b[0m\r\n    \u001b[2mClosed under the global context\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2mCoq < plus_comm\u001b[0m\r\n    \u001b[2m     : forall n m : nat, n + m = m + n\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2mCoq < \u001b[0m\r\n"]
