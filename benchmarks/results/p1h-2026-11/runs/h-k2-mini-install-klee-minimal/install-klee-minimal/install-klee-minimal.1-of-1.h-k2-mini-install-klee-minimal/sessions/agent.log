from pathlib import Path
p = Path.home() / ".bashrc"
text = p.read_text()
old = 'export CPATH="/usr/local/include${CPATH:+:${CPATH}}"\n'
new = 'export CPATH="/usr/local/include:/usr/local/include/klee${CPATH:+:${CPATH}}"\n'
if old not in text:
