set -eux; python3 - <<'PY'
from pathlib import Path
p = Path.home() / ".bashrc"
text = p.read_text()
marker = "# KLEE installation environment"
if marker not in text:
    block = '''# KLEE installation environment
# Make KLEE binaries and headers available to all shells.
export PATH="/usr/local/bin:${PATH}"
export CPATH="/usr/local/include${CPATH:+:${CPATH}}"
export LD_LIBRARY_PATH="/usr/local/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
export KLEE_INCLUDE_DIR="/usr/local/include"

'''
    # Must be before Ubuntu's non-interactive-shell early return.
    p.write_text(block + text)
PY
nl -ba ~/.bashrc | sed -n '1,20p'; echo '--- fresh noninteractive source'; bash -c 'source ~/.bashrc; echo PATH="$PATH"; echo CPATH="$CPATH"; echo 
LD_LIBRARY_PATH="$LD_LIBRARY_PATH"; echo KLEE_INCLUDE_DIR="$KLEE_INCLUDE_DIR"; command -v klee; command -v stp; klee --version'
```
