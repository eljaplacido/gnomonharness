[113.761065, "o", "\r\u001b[2KMiniSat installed successfully. I'll inspect KLEE's STP discovery logic and then configure/build STP to match.\r\n\r\n```\r\nset -x; cat /opt/src/klee/cmake/find_stp.cmake; echo '--- stp cmake options'; grep -n -i 'option\\|MINISAT\\|BUILD_SHARED\\|INSTALL' /opt/src/stp/CMakeLists.txt | \r\nhead -100; echo '--- deps'; ls -la /usr/local/lib/cmake/minisat; grep -n . /usr/local/lib/cmake/minisat/minisatConfig.cmake | head\r\n```\r\n\u001b[32m⠸\u001b[0m Waiting for the LM to respond..."]
[113.761323, "o", "\r\u001b[2K\u001b[32m⠸\u001b[0m Waiting for the LM to respond...\r\n\u001b[?25h\r\u001b[1A\u001b[2K"]
[113.770974, "o", "\r\n\u001b[1;32mTool\u001b[0m:\r\n"]
[113.776252, "o", "<returncode>\r\n0\r\n<output>\r\n+ cat /opt/src/klee/cmake/find_stp.cmake\r\n#===------------------------------------------------------------------------===#\r\n#\r\n#                     The KLEE Symbolic Virtual Machine\r\n#\r\n# This file is distributed under the University of Illinois Open Source\r\n# License. See LICENSE.TXT for details.\r\n#\r\n#===------------------------------------------------------------------------===#\r\n# STP: Use CMake facility to detect. The user can pass `-DSTP_DIR=` to force\r\n# a particular directory.\r\n\r\n# Although find_package() will set `STP_DIR` for us add it here so that\r\n# is displayed in `ccmake` and `cmake-gui`.\r\nset(STP_DIR \"\" CACHE PATH \"Path to directory containing STPConfig.cmake\")\r\nfind_package(STP CONFIG)\r\n\r\n# Set the default so that if the following is true:\r\n# * STP was found\r\n# * ENABLE_SOLVER_STP is not already set as a cache variable\r\n#\r\n# then the default is set to `ON`. Otherwise set the default to `OFF`.\r\n# A consequence of this is if we fail to detect STP the first time\r\n"]
[113.776268, "o", "# subsequent calls to CMake will not change the default.\r\nif (STP_FOUND)\r\n  set(ENABLE_SOLVER_STP_DEFAULT ON)\r\nelse()\r\n  set(ENABLE_SOLVER_STP_DEFAULT OFF)\r\nendif()\r\noption(ENABLE_SOLVER_STP \"Enable STP solver support\" ${ENABLE_SOLVER_STP_DEFAULT})\r\n\r\nif (ENABLE_SOLVER_STP)\r\n  message(STATUS \"STP solver support enabled\")\r\n  if (STP_FOUND)\r\n    message(STATUS \"Found STP version ${STP_VERSION}\")\r\n    # Try the STP shared library first\r\n    if (\"${STP_SHARED_LIBRARY}\" STREQUAL \"\")\r\n      # Try the static library instead\r\n      if (\"${STP_STATIC_LIBRARY}\" STREQUAL \"\")\r\n        message(FATAL_ERROR \"Couldn't find STP shared or static library\")\r\n      endif()\r\n      message(STATUS \"Using STP static library\")\r\n      list(APPEND KLEE_SOLVER_LIBRARIES \"${STP_STATIC_LIBRARY}\")\r\n    else()\r\n      message(STATUS \"Using STP shared library\")\r\n      list(APPEND KLEE_SOLVER_LIBRARIES \"${STP_SHARED_LIBRARY}\")\r\n    endif()\r\n    list(APPEND KLEE_SOLVER_INCLUDE_DIRS ${STP_INCLUDE_DIRS})\r\n    message(STATUS \"STP_DIR: ${STP_DIR}\")\r\n    set(ENABLE_STP 1) # For config.h\r\n  else()\r\n    message(FATAL_ERROR \"STP not found. Try setting `-DSTP_DIR=/path` where\"\r\n      \" `/path` is the directory containing `STPConfig.cmake`\")\r\n  endif()\r\nelse()\r\n  message(STATUS \"STP solver support disabled\")\r\n  set(ENABLE_STP 0) # For config.h\r\nendif()\r\n+ echo --- stp cmake options\r\n--- stp cmake options\r\n+ grep -n -i option\\|MINISAT\\|BUILD_SHARED\\|INSTALL /opt/src/stp/CMakeLists.txt\r\n+ head -100\r\n39:    # Allow to override options via regular variables\r\n49:include(GNUInstallDirs)\r\n56:list(APPEND CMAKE_PREFIX_PATH \"${PROJECT_SOURCE_DIR}/deps/install\")\r\n70:      message(STATUS \"You can choose the type of build, options are: ${build_types}\")\r\n72:          \"Options are ${build_types}\""]
[113.776289, "o", "\r\n76:      # Provide drop down menu options in cmake-gui\r\n82:# Option to enable/disable assertions\r\n101:option(ENABLE_ASSERTIONS \"Build with assertions enabled\" ON)\r\n124:option(SANITIZE \"Use Clang sanitizers\" OFF)\r\n147:option(BUILD_SHARED_LIBS \"Build the shared library\" ON)\r\n148:option(STATICCOMPILE \"Compile static library and executable\" OFF)\r\n150:    set(BUILD_SHARED_LIBS OFF)\r\n155:if ((${CMAKE_SYSTEM_NAME} MATCHES \"Windows\") OR (NOT BUILD_SHARED_LIBS))\r\n157:    set(Minisat_USE_STATIC_LIBS ON)\r\n160:if (NOT BUILD_SHARED_LIBS)\r\n180:    # when building, don't use the install RPATH already\r\n181:    # (but later on when installing)\r\n182:    SET(CMAKE_BUILD_WITH_INSTALL_RPATH FALSE)\r\n184:    SET(CMAKE_INSTALL_RPATH \"${CMAKE_INSTALL_LIBDIR}\")\r\n187:    # which point to directories outside the build tree to the install RPATH\r\n188:    SET(CMAKE_INSTALL_RPATH_USE_LINK_PATH TRUE)\r\n190:    # the RPATH to be used when installing, but only if it's not a system directory\r\n191:    LIST(FIND CMAKE_PLATFORM_IMPLICIT_LINK_DIRECTORIES \"${CMAKE_INSTALL_LIBDIR}\" isSystemDir)\r\n193:        SET(CMAKE_INSTALL_RPATH \"${CMAKE_INSTALL_LIBDIR}\")\r\n198:      set(CMAKE_INSTALL_RPATH \"@loader_path/../lib\")\r\n203:option(SUPPRESS_WARNINGS \"Silence all warnings\" OFF)\r\n206:    add_compile_options( -g)\r\n207:    add_compile_options( -pthread )\r\n209:    add_compile_options(\"$<$<CONFIG:RELWITHDEBINFO>:-O2>\")\r\n211:    add_comp"]
[113.776302, "o", "ile_options(\"$<$<CONFIG:RELEASE>:-O2>\")\r\n212:    add_compile_options(\"$<$<CONFIG:RELEASE>:-g0>\")\r\n214:    add_compile_options(\"$<$<CONFIG:DEBUG>:-O0>\")\r\n225:    add_compile_options(\"$<$<CONFIG:RELWITHDEBINFO>:/O2>\")\r\n226:    add_compile_options(\"$<$<CONFIG:RELWITHDEBINFO>:/ZI>\")\r\n228:    add_compile_options(\"$<$<CONFIG:RELEASE>:/O2>\")\r\n229:    add_compile_options(\"$<$<CONFIG:RELEASE>:/D>\")\r\n230:    add_compile_options(\"$<$<CONFIG:RELEASE>:/NDEBUG>\")\r\n232:    add_compile_options(\"$<$<CONFIG:DEBUG>:/Od>\")\r\n234:    if (NOT BUILD_SHARED_LIBS)\r\n253:        add_compile_options(/MT)\r\n257:    add_compile_options(/GS)\r\n261:        add_compile_options(/W0)\r\n263:        add_compile_options(/W1)\r\n267:    add_compile_options(/wd4251)\r\n268:    add_compile_options(/D_CRT_SECURE_NO_WARNINGS)\r\n272:    # add_compile_options(/Wall)\r\n277:    # add_compile_options(/Za)\r\n279:    add_compile_options(/fp:precise)\r\n283:    add_compile_options(/EHsc)\r\n291:    set(DEF_INSTALL_CMAKE_DIR CMake)\r\n369:option(TUNE_NATIVE \"Use -mtune=native\" OFF)\r\n374:option(COVERAGE \"Build with coverage check\" OFF)\r\n379:option(WERROR \"Build with warnings as errors\" OFF)\r\n391:option(USE_THREAD_LOCAL \"Use thread-local storage when available\" ON)\r\n452:option(ONLY_SIMPLE \"Only build very simplistic executable -- no Boost needed\" OFF)\r\n454:  find_package( Boost 1.46 COMPONENTS program_options)\r\n460:add_feature_info(SimpleOptions ONLY_SIMPLE \"Simplifies command-line interface, only a few command-line options will be available\")\r\n465:option(USE_RISS \"Try to use Riss\" OFF)\r\n475:# Find CryptoMiniSat\r\n477:option(NOCRYPTOMINISAT \"Don't try to use cryptominisat\" OFF)\r\n479:if (NOT NOCRYPTOMINISAT)\r\n480:  set(cryptominisat5_DIR \"\" CACHE PATH \"Path to directory containing cryptominisat5Config.cmake\")\r\n486:  find_package(cryptominisat5 CONFIG)\r\n487:  if (cryptominisat5_FOUND AND HAVE_FLAG_STD_CPP11 AND (NOT NOCRYPTOMINISAT))\r\n488:    message(STATUS \"CryptoMiniSat5 dynamic lib: ${CRYPTOMINISAT5_LIBRARIES}\")\r\n489:    message(STATUS \"CryptoMiniSat5 static lib:  ${CRYPTOMINISAT5_STATIC_LIBRARIES}\")\r\n490:    message(S"]
[113.776319, "o", "TATUS \"CryptoMiniSat5 static lib deps: ${CRYPTOMINISAT5_STATIC_LIBRARIES_DEPS}\")\r\n491:    message(STATUS \"CryptoMiniSat5 include dirs: ${CRYPTOMINISAT5_INCLUDE_DIRS}\")\r\n492:    add_definitions(-DUSE_CRYPTOMINISAT)\r\n493:    set(USE_CRYPTOMINISAT ON)\r\n497:add_feature_info(CryptoMiniSat USE_CRYPTOMINISAT \"Enables CryptoMiniSat solver, allows --cryptominisat5 option\")\r\n499:option(FORCE_CMS \"Must build with CryptoMiniSat\" OFF)\r\n500:if (FORCE_CMS AND NOT USE_CRYPTOMINISAT)\r\n501:    message(FATAL_ERROR \"CryptoMiniSat 5.x was not found but it was requested. Exiting.\")\r\n505:# Find ZLIB (needed for MiniSat)\r\n507:# thanks to MiniSat include-ing it n the header\r\n511:include_directories(${minisat_SOURCE_DIR})\r\n528:                ARGS  --name=\"Simple Theorem Prover SMT solver\" --version-string=${STP_FULL_VERSION} --help-option=\"--help\" $<TARGET_FILE:stp-bin> -o \r\n${CMAKE_CURRENT_BINARY_DIR}/stp.1\r\n531:            INSTALL(\r\n533:                DESTINATION ${CMAKE_INSTALL_PREFIX}/man/man1)\r\n534:            message(STATUS \"Manpage will be created and installed\")\r\n545:# Find Minisat\r\n548:find_package(minisat)\r\n549:set(MINISAT_INCLUDE_DIR \"\" CACHE PATH \"MiniSat include directory\")\r\n550:set(MINISAT_LIBRARY \"\" CACHE PATH \"MiniSat library directory\")\r\n552:if (minisat_FOUND)\r\n553:    message(STATUS \"OK, found Minisat library under ${MINISAT_LIBRARIES} and Minisat include dirs under ${MINISAT_INCLUDE_DIRS}\")\r\n555:    message(STATUS \"Not found using installed MiniSat, looking for built MiniSat\")\r\n556:    find_package(minisat CONFIG)\r\n558:    if (minisat_FOUND)\r\n"]
[113.776332, "o", "559:        message(STATUS \"OK, found Minisat library under ${MINISAT_LIBRARIES} and Minisat include dirs under ${MINISAT_INCLUDE_DIRS}\")\r\n561:        message(FATAL_ERROR \"You must install minisat from https://github.com/stp/minisat\")\r\n565:include_directories(SYSTEM ${MINISAT_INCLUDE_DIRS})\r\n566:set(LIBS ${LIBS} ${MINISAT_LIBRARIES})\r\n582:        message(STATUS \"Found Bison keg installed by Homebrew at ${BREW_BISON_PREFIX}\")\r\n593:        message(STATUS \"Found Flex keg installed by Homebrew at ${BREW_FLEX_PREFIX}\")\r\n621:# Setup library build path (this is **not** the library install path)\r\n"]
[113.776346, "o", "658:# Testing and Python interface options\r\n661:option(ENABLE_TESTING \"Enable testing\" OFF)\r\n667:    if(PYTHON_EXECUTABLE AND BUILD_SHARED_LIBS)\r\n+ echo --- deps\r\n--- deps\r\n+ ls -la /usr/local/lib/cmake/minisat\r\ntotal 20\r\ndrwxr-xr-x 2 root root 4096 Nov  1 03:04 .\r\ndrwxr-xr-x 3 root root 4096 Nov  1 03:04 ..\r\n-rw-r--r-- 1 root root  701 Nov  1 03:04 minisatConfig.cmake\r\n-rw-r--r-- 1 root root 1703 Nov  1 03:04 minisatTargets-release.cmake\r\n-rw-r--r-- 1 root root 3947 Nov  1 03:04 minisatTargets.cmake\r\n+ grep -n . /usr/local/lib/cmake/minisat/minisatConfig.cmake\r\n+ head\r\n1:# Config file for the installed cryptominisat Package\r\n2:# It defines the following variables\r\n3:#  MINISAT_INCLUDE_DIRS - include directories for minisat\r\n4:#  MINISAT_LIBRARIES    - libraries to link against\r\n5:#  MINISAT_EXECUTABLE   - the cryptominisat executable\r\n7:# Compute paths\r\n8:get_filename_component(MINISAT_CMAKE_DIR \"${CMAKE_CURRENT_LIST_FILE}\" PATH)\r\n9:set(MINISAT_INCLUDE_DIRS \"/opt/src/minisat/\")\r\n11:# Our library dependencies (contains definitions for IMPORTED targets)\r\n12:include(\"${MINISAT_CMAKE_DIR}/minisatTargets.cmake\")\r\n\r\n"]
