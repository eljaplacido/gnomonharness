[130.391088, "o", "<returncode>\r\n0\r\n<output>\r\n+ grep -n -i uclibc\\|ENABLE_SOLVER_STP\\|ENABLE_Z3\\|ENABLE_METASMT\\|RTTI\\|ENABLE_EH\\|LLVM_CONFIG /opt/src/klee/CMakeLists.txt\r\n+ head -120\r\n211:if ((NOT ${ENABLE_Z3}) AND (NOT ${ENABLE_STP}) AND (NOT ${ENABLE_METASMT}))\r\n215:    \"\\\"-DENABLE_SOLVER_STP=ON\\\"\\n\"\r\n223:if (NOT LLVM_ENABLE_EH)\r\n232:# RTTI\r\n234:if (NOT LLVM_ENABLE_RTTI)\r\n235:  if (ENABLE_SOLVER_METASMT AND metaSMT_REQUIRE_RTTI)\r\n237:      \"RTTI cannot be disabled because metaSMT uses them.\"\r\n239:      \"You should recompile LLVM with RTTI enabled.\")\r\n241:    list(APPEND KLEE_COMPONENT_CXX_FLAGS \"-fno-rtti\")\r\n483:# KLEE uclibc support\r\n485:set(KLEE_UCLIBC_PATH \"\" CACHE PATH \"Path to klee-uclibc root directory\")\r\n486:set(KLEE_UCLIBC_BCA_NAME \"klee-uclibc.bca\")\r\n487:if (NOT KLEE_UCLIBC_PATH STREQUAL \"\")\r\n489:  set(KLEE_UCLIBC_C_BCA \"${KLEE_UCLIBC_PATH}/lib/libc.a\")\r\n490:  if (NOT EXISTS \"${KLEE_UCLIBC_C_BCA}\")\r\n492:      \"klee-uclibc library not found at \\\"${KLEE_UCLIBC_C_BCA}\\\". Set KLEE_UCLIBC_PATH to klee-uclibc root directory or empty string.\")\r\n494:  message(STATUS \"Found klee-uclibc library: \\\"${KLEE_UCLIBC_C_BCA}\\\"\")\r\n495:  # Copy KLEE_UCLIBC_C_BCA so KLEE can find it where it is expected.\r\n497:    \"${KLEE_UCLIBC_C_BCA}\"\r\n498:    \"${KLEE_RUNTIME_DIRECTORY}/${KLEE_UCLIBC_BCA_NAME}\"\r\n501:  message(STATUS \"Skipping copying of klee-uclibc runtime\")\r\n+ echo --- options files\r\n--- options files\r\n+ grep -Rni ENABLE_KLEE_UCLIBC\\|UCLIBC /opt/src/klee/cmake /opt/src/klee/CMakeLists.txt\r\n+ head -80\r\n/opt/src/klee/CMakeLists.txt:483:# KLEE uclibc support\r\n/opt/src/klee/CMakeLists.txt:485:set(KLEE_UCLIBC_PATH \"\" CACHE PATH \"Path to klee-uclibc root directory\")\r\n/opt/src/klee/CMakeLists.txt:486:set(KLEE_UCLIBC_BCA_NAME \"klee-uclibc.bca\")\r\n/opt/src/klee/CMakeLists.txt:487:if (NOT KLEE_UCLIBC_PATH STREQUAL \"\")\r\n/opt/src/klee/CMakeLists.txt:489:  set(KLEE_UCLIBC_C_BCA \"${KLEE_UCLIBC_PATH}/lib/libc.a\")\r\n/opt/src/klee/CMakeLists.txt:490:  if (NOT EXISTS \"${KLEE_UCLIBC_C_BCA}\")\r\n/opt/src/klee/CMakeLists.txt:492:      \"klee-uclibc library not found at \\\"${KLEE_UCLIBC_C_BCA}\\\". Set KLEE_UCLIBC_PATH to klee-uclibc root directory or empty \r\nstring.\")\r\n/opt/src/klee/CMakeLists.txt:494:  message(STATUS \"Found klee-uclibc library: \\\"${KLEE_UCLIBC_C_BCA}\\\"\")\r\n/opt/src/klee/CMakeLists.txt:495:  # Copy KLEE_UCLIBC_C_BCA so KLEE can find it where it is expected.\r\n/opt/src/klee/CMakeLists.txt:497:    \"${KLEE_UCLIBC_C_BCA}\"\r\n/opt/src/klee/CMakeLists.txt:498:    \"${KLEE_RUNTIME_DIRECTORY}/${KLEE_UCLIBC_BCA_NAME}\"\r\n/opt/src/klee/CMakeLists.txt:501:  message(STATUS \"Skipping copying of klee-uclibc runtime\")\r\n+ echo --- readme build\r\n--- readme build\r\n+ grep -n -i -A8 -B4 cmake.*ENABLE_SOLVER_STP\\|ENABLE_KLEE_UCLIBC\\|LLVM_CONFIG /opt/src/klee/README.md\r\n+ head -200\r\n+ echo --- llvm config\r\n--- llvm config\r\n+ llvm-config-16 --cmakedir"]
[130.3911, "o", "\r\n/usr/lib/llvm-16/lib/cmake/llvm\r\n+ llvm-config-16 --has-rtti\r\nYES\r\n+ llvm-config-16 --assertion-mode\r\nOFF\r\n+ ls /usr/lib/llvm-16/lib/cmake/llvm/LLVMConfig.cmake\r\n/usr/lib/llvm-16/lib/cmake/llvm/LLVMConfig.cmake\r\n+ command -v clang++-16\r\n/usr/bin/clang++-16\r\n+ command -v llvm-link-16\r\n/usr/bin/llvm-link-16\r\n+ command -v llvm-ar-16\r\n/usr/bin/llvm-ar-16\r\n\r\n"]
