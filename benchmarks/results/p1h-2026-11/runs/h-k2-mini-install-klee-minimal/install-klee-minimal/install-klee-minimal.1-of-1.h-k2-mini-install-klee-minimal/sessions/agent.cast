[183.401013, "o", "\r\u001b[2KEnvironment variables load correctly in a non-interactive sourced shell. I'll run an end-to-end test using only the sourced environment (no explicit include \r\npaths) and check the default STP invocation as well as an explicit MiniSat backend.\r\n\r\n```\r\nset -eux; bash -c '\r\n  source ~/.bashrc\r\n  echo \"CPATH=$CPATH\"\r\n  printf \"#include <klee/klee.h>\\nint main(void) { int x; klee_make_symbolic(&x, sizeof(x), \\\"x\\\"); if (x == 42) klee_assert(0); return 0; }\\n\" > \r\n/tmp/klee_e2e.c\r\n  clang-16 -emit-llvm -c -g -O0 -Xclang -disable-O0-optnone /tmp/klee_e2e.c -o /tmp/klee_e2e.bc\r\n  rm -rf /tmp/klee-e2e-default\r\n  klee --solver-backend=stp --output-dir=/tmp/klee-e2e-default /tmp/klee_e2e.bc\r\n  echo \"default invocation output:\"; grep -E \"Using .* solver backend|SAT solver|done:\" /tmp/klee-e2e-default/messages.txt\r\n  rm -rf /tmp/klee-e2e-minisat\r\n  klee --solver-backend=stp --stp-sat-solver=minisat --output-dir=/tmp/klee-e2e-minisat /tmp/klee_e2e.bc\r\n  echo \"minisat invocation output:\"; grep -E \"Using .* solver backend|SAT solver|done:\" /tmp/klee-e2e-minisat/messages.txt\r\n  echo \"KTESTS:\"; ls /tmp/klee-e2e-default/*.ktest\r\n'; echo END_TO_END_OK\r\n```\r\n\u001b[32m⠹\u001b[0m Waiting for the LM to respond..."]
