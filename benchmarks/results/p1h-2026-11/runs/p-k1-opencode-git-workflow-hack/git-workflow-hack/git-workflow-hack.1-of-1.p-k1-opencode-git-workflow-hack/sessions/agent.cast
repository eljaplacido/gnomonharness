[1118.692214, "o", "\u001b[0m← \u001b[0mEdit my_website/scripts/templates.py\r\nIndex: my_website/scripts/templates.py\r\n===================================================================\r\n--- my_website/scripts/templates.py\r\n+++ my_website/scripts/templates.py\r\n@@ -121,10 +121,9 @@\r\n     )\r\n     csp = (\r\n         \"default-src 'self'; img-src 'self' data:; style-src 'self'; \"\r\n         \"script-src 'self'; font-src 'self'; connect-src 'none'; \"\r\n-        \"object-src 'none'; base-uri 'self'; form-action 'self'; \"\r\n-        \"frame-ancestors 'none'\"\r\n+        \"object-src 'none'; base-uri 'self'; form-action 'self'\"\r\n     )\r\n     year = date.today().year\r\n     built = date.today().strftime(\"%B %Y\")\r\n     body_class = f\"page {page_class}\".strip()\r\n\r\n"]
