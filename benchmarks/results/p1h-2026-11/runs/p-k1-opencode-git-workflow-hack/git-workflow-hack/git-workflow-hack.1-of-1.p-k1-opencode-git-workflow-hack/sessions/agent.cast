[1013.072826, "o", "\u001b[0m$ \u001b[0mmkdir -p /tmp/opencode/actionlint && cd /tmp/opencode/actionlint && curl -fsSL -o actionlint.tar.gz https://github.com/rhysd/actionlint/releases/download/v1.7.12/actionlint_1.7.12_linux_arm64.tar.gz && curl -fsSL -o checksums.txt https://github.com/rhysd/actionlint/releases/download/v1.7.12/actionlint_1.7.12_checksums.txt && grep 'linux_arm64' checksums.txt && sha256sum actionlint.tar.gz && tar -xzf actionlint.tar.gz && ./actionlint -version\r\n325e971b6ba9bfa504672e29be93c24981eeb1c07576d730e9f7c8805afff0c6  actionlint_1.7.12_linux_arm64.tar.gz\r\n325e971b6ba9bfa504672e29be93c24981eeb1c07576d730e9f7c8805afff0c6  actionlint.tar.gz\r\n1.7.12\r\ninstalled by downloading from release page\r\nbuilt with go1.26.1 compiler for linux/arm64\r\n"]
