  for (i=MYTHREAD;i<100000;i+=THREADS){
    int b = i % nl;
    upc_lock(lks[b]);
    uint64_t old = slots[b];
    slots[b] = old + 1;
    upc_unlock(lks[b]);
  }
  upc_barrier;
  if (MYTHREAD==0){
    uint64_t t=0; for(i=0;i<nl;i++) t+=slots[i];
    printf("total=%llu (expect 100000)\n",(unsigned long long)t);
  }
  return 0;
}
