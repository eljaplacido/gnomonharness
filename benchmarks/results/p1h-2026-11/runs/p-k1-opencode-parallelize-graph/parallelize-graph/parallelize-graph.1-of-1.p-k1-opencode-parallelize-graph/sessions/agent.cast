 g_stride + g_klen] = '\\0';\r\n    36\t    sh_left[idx] = l;\r\n    37\t    sh_right[idx] = r;\r\n    38\t\r\n    39\t    h = fnv1a(kmer, g_klen) % (uint64_t)g_buckets;\r\n    40\t\r\n    41\t    upc_lock(&sh_locks[h]);\r\n    42\t    sh_next[idx] = sh_heads[h];\r\n    43\t    sh_heads[h] = idx;\r\n    44\t    upc_unlock(&sh_locks[h]);\r\n    45\t}\r\n    46\t\r\n    47\t/* Return the index of key in the distributed table, or -1. */\r\n    48\tstatic int ht_lookup(const char *key)\r\n    49\t{\r\n    50\t    uint64_t h = fnv1a(key, g_klen) % (uint64_t)g_buckets;\r\n    51\t    int p = sh_heads[h];\r\n    52\t\r\n    53\t    while (p != -1) {\r\n---upc.h lock decl---\r\n"]
