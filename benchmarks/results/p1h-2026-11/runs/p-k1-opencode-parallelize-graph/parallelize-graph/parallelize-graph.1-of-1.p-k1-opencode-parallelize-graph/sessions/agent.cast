[155.948948, "o", "\u001b[0m$ \u001b[0mgrep -rn \"upc_all_alloc.*sizeof(upc_lock_t)\\|upc_all_lock_alloc\" /usr/local/opt /tmp/berkeley_upc-2022.10.0 --include=*.c --include=*.upc --include=*.h 2>/dev/null | head -20\r\n/usr/local/opt/include/upcr.h:498:  #define upc_all_lock_alloc      upcr_all_lock_alloc\r\n/usr/local/opt/include/upcr_preinclude/upc.h:86:extern upc_lock_t *upc_all_lock_alloc (void);\r\n/tmp/berkeley_upc-2022.10.0/upcr.h:498:  #define upc_all_lock_alloc      upcr_all_lock_alloc\r\n/tmp/berkeley_upc-2022.10.0/upc-tests/bugzilla/bug550.upc:9:        l=upc_all_lock_alloc();\r\n/tmp/berkeley_upc-2022.10.0/upc-tests/bugzilla/bug2791a.upc:11:  lock = upc_all_lock_alloc();\r\n/tmp/berkeley_upc-2022.10.0/upc-tests/bugzilla/bug2791a.upc:12:  printf(\"Thread %d completed upc_all_lock_alloc() call\\n\", MYTHREAD);\r\n/tmp/berkeley_upc-2022.10.0/upc-tests/bugzilla/bug1578.upc:610:\tlock = upc_all_lock_alloc();\r\n/tmp/berkeley_upc-2022.10.0/upc-tests/bugzilla/locktest.upc:66:  upc_lock_t *alllock = upc_all_lock_alloc();\r\n/tmp/berkeley_upc-2022.10.0/upc-tests/bugzilla/locktest.upc:115:    upc_lock_t *alock = upc_all_lock_alloc();\r\n/tmp/berkeley_upc-2022.10.0/upc-tests/bugzilla/locktest.upc:131:    upc_lock_t *alock = upc_all_lock_alloc();\r\n/tmp/berkeley_upc-2022.10.0/upc-tests/bugzilla/locktest.upc:179:    upc_lock_t *alock = upc_all_lock_alloc();\r\n/tmp/berkeley_upc-2022.10.0/upc-tests/bugzilla/locktest.upc:189:    upc_lock_t *lock1 = upc_all_lock_alloc();\r\n/tmp/berkeley_upc-2022.10.0/upc-tests/bugzilla/locktest.upc:192:      upc_lock_t *lock2 = upc_all_lock_alloc();\r\n/tmp/berkeley_upc-2022.10.0/upc-tests/bugzilla/locktest.upc:196:      lock1 = upc_all_lock_alloc();\r\n/tmp/berkeley_upc-2022.10.0/upc-tests/bugzilla/locktest.upc:208:    upc_lock_t *alock = upc_all_lock_alloc();\r\n/tmp/berkeley_upc-2022.10.0/upc-tests/bugzilla/locktest.upc:218:    upc_lock_t *alock = upc_all_lock_alloc();\r\n/tmp/berkeley_upc-2022.10.0/upc-tests/bugzilla/locktest.upc:229:    upc_lock_t *lock = upc_all_lock_alloc();\r\n/tmp/berkeley_upc-2022.10.0/upc-tests/bugzilla/all_free_test.upc:66:    upc_lock_t *lp = upc_all_lock_alloc();\r\n/tmp/berkeley_upc-2022.10.0/upc-tests/bugzilla/bug1531.upc:14:  l = upc_all_lock_alloc();\r\n/tmp/berkeley_upc-2022.10.0/upc-tests/bugzilla/bug874.upc:88:  lock = upc_all_lock_alloc();\r\n"]
