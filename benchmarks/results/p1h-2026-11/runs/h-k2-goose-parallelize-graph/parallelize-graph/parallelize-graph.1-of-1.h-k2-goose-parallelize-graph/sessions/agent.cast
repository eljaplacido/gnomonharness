[482.832846, "o", "\r\n  \u001b[2m────────────────────────────────────────\u001b[0m\r\n  \u001b[2m▸\u001b[0m \u001b[2mshell\u001b[0m\r\n    \u001b[2mcommand\u001b[0m: \u001b[32mls /usr/local/opt/*.conf /usr/local/etc/*.conf 2>/dev/null; grep -rn \"conduits\\|default_network\\|network\" /usr/local/opt/upcc.conf 2>/dev/null |...\u001b[0m\r\n\r\n"]
