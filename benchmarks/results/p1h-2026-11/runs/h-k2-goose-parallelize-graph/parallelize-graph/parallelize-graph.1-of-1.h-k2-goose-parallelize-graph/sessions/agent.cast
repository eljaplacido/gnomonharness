[14.848289, "o", "\r\n  \u001b[2m────────────────────────────────────────\u001b[0m\r\n  \u001b[2m▸\u001b[0m \u001b[2mshell\u001b[0m\r\n    \u001b[2mcommand\u001b[0m: \u001b[32mpwd && ls -la /app && echo \"---\" && head -5 /app/test && echo \"---\" && wc -l /app/test\u001b[0m\r\n\r\n\r\n  \u001b[2m────────────────────────────────────────\u001b[0m\r\n  \u001b[2m▸\u001b[0m \u001b[2mshell\u001b[0m\r\n    \u001b[2mcommand\u001b[0m: \u001b[32mcat /etc/os-release; echo \"---\"; nproc; echo \"---\"; which gcc g++ make upc upcc 2>&1\u001b[0m\r\n\r\n"]
[14.872868, "o", "    \u001b[2mPRETTY_NAME=\"Ubuntu 24.04.2 LTS\"\u001b[0m\r\n    \u001b[2mNAME=\"Ubuntu\"\u001b[0m\r\n    \u001b[2mVERSION_ID=\"24.04\"\u001b[0m\r\n    \u001b[2mVERSION=\"24.04.2 LTS (Noble Numbat)\"\u001b[0m\r\n    \u001b[2mVERSION_CODENAME=noble\u001b[0m\r\n    \u001b[2mID=ubuntu\u001b[0m\r\n    \u001b[2mID_LIKE=debian\u001b[0m\r\n    \u001b[2mHOME_URL=\"https://www.ubuntu.com/\"\u001b[0m\r\n    \u001b[2mSUPPORT_URL=\"https://help.ubuntu.com/\"\u001b[0m\r\n    \u001b[2mBUG_REPORT_URL=\"https://bugs.launchpad.net/ubuntu/\"\u001b[0m\r\n    \u001b[2m\u001b[3m... (1 lines hidden, /toggle to show all)\u001b[0m\r\n    \u001b[2mUBUNTU_CODENAME=noble\u001b[0m\r\n    \u001b[2mLOGO=ubuntu-logo\u001b[0m\r\n    \u001b[2m---\u001b[0m\r\n    \u001b[2m20\u001b[0m\r\n    \u001b[2m---\u001b[0m\r\n    \u001b[2m/usr/bin/gcc\u001b[0m\r\n    \u001b[2m/usr/bin/g++\u001b[0m\r\n    \u001b[2m/usr/bin/make\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2mCommand exited with code 1\u001b[0m\r\n    \u001b[2m/app\u001b[0m\r\n    \u001b[2mtotal 236\u001b[0m\r\n    \u001b[2mdrwxr-xr-x 1 root root   4096 Nov  1 04:43 .\u001b[0m\r\n    \u001b[2mdrwxr-xr-x 1 root root   4096 Nov  1 04:43 ..\u001b[0m\r\n    \u001b[2m-rw-rw-r-- 1 root root 230000 Oct 31 09:48 test\u001b[0m\r\n    \u001b[2m---\u001b[0m\r\n    \u001b[2mATAGCCAGTGCCTGATACT\tFG\u001b[0m\r\n    \u001b[2mTAGCCAGTGCCTGATACTG\tAG\u001b[0m\r\n    \u001b[2mAGCCAGTGCCTGATACTGG\tTC\u001b[0m\r\n    \u001b[2mGCCAGTGCCTGATACTGGC\tAT\u001b[0m\r\n    \u001b[2mCCAGTGCCTGATACTGGCT\tGG\u001b[0m\r\n    \u001b[2m---\u001b[0m\r\n    \u001b[2m10000 /app/test\u001b[0m\r\n"]
