[475.211047, "o", "\r\n  \u001b[2m────────────────────────────────────────\u001b[0m\r\n  \u001b[2m▸\u001b[0m \u001b[2mshell\u001b[0m\r\n    \u001b[2mcommand\u001b[0m: \u001b[32mcd /app && time upcrun -n 4 -shared-heap 256MB ./pgen test 2>&1 | head -20; echo \"=== files:\"; ls -la /app/pgen*.out\u001b[0m\r\n\r\n"]
