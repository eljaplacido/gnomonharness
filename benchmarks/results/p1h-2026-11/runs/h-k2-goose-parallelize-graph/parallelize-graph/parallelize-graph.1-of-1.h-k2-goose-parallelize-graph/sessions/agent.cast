[484.349313, "o", "\r\n  \u001b[2m────────────────────────────────────────\u001b[0m\r\n  \u001b[2m▸\u001b[0m \u001b[2mshell\u001b[0m\r\n    \u001b[2mcommand\u001b[0m: \u001b[32mcat /usr/local/etc/multiconf.conf; echo \"=== find conf files:\"; find /usr/local -name \"*.conf\" | head; \u001b[0m\r\n\r\n"]
[484.358905, "o", "    \u001b[2m# Configuration file for Berkeley UPC multiplexing compiler driver\u001b[0m\r\n    \u001b[2m#\u001b[0m\r\n    \u001b[2m# Berkeley UPC supports a wide variety of mutually-exclusive configure\u001b[0m\r\n    \u001b[2m# time settings (eg debug vs ndebug mode, performance instrumentation vs not, etc).\u001b[0m\r\n    \u001b[2m# It is often desirable to install multiple such configurations on one system and select\u001b[0m\r\n    \u001b[2m# between them at application compile time based on the provided compilation options.\u001b[0m\r\n    \u001b[2m# This file specifies the different configurations of Berkeley UPC\u001b[0m\r\n    \u001b[2m# to create during the multiconf configure process, and the logic for choosing\u001b[0m\r\n    \u001b[2m# between the configurations at application compile time.\u001b[0m\r\n    \u001b[2m#\u001b[0m\r\n    \u001b[2m\u001b[3m... (177 lines hidden, /toggle to show all)\u001b[0m\r\n    \u001b[2m   -cupc2c            Use the clang-upc2c translator\u001b[0m\r\n    \u001b[2m   -g                 Enable system-wide debugging symbols and assertions\u001b[0m\r\n    \u001b[2m   -trace             Enable communication tracing & statistics for use with upc_trace\u001b[0m\r\n    \u001b[2m   -inst              Enable GASP-compliant instrumentation for 3rd party performance tools\u001b[0m\r\n    \u001b[2m=== find conf files:\u001b[0m\r\n    \u001b[2m/usr/local/etc/multiconf.conf\u001b[0m\r\n    \u001b[2m/usr/local/dbg/etc/upcc.conf\u001b[0m\r\n    \u001b[2m/usr/local/dbg/etc/upcrun.conf\u001b[0m\r\n    \u001b[2m/usr/local/opt/etc/upcc.conf\u001b[0m\r\n    \u001b[2m/usr/local/opt/etc/upcrun.conf\u001b[0m\r\n"]
[486.186771, "o", "\r\n  \u001b[2m────────────────────────────────────────\u001b[0m\r\n  \u001b[2m▸\u001b[0m \u001b[2mshell\u001b[0m\r\n    \u001b[2mcommand\u001b[0m: \u001b[32mgrep -n \"conduits\\|network\\|default_\" /usr/local/opt/etc/upcc.conf | head -20; echo \"=== upcrun.conf:\"; cat /usr/local/opt/etc/upcrun.conf | hea...\u001b[0m\r\n\r\n"]
[486.194494, "o", "    \u001b[2m10:default_network     = udp\u001b[0m\r\n    \u001b[2m58:default_options     =\u001b[0m\r\n    \u001b[2m172:# available networks\u001b[0m\r\n    \u001b[2m173:conduits            = smp udp\u001b[0m\r\n    \u001b[2m185:default_pthreads    = 2\u001b[0m\r\n    \u001b[2m220:# Which conduits are not compatible w/ MPI?\u001b[0m\r\n    \u001b[2m=== upcrun.conf:\u001b[0m\r\n    \u001b[2m######################################################################\u001b[0m\r\n    \u001b[2m#  Config settings for the Berkeley UPC compiler upcrun job spawner\u001b[0m\r\n    \u001b[2m#\u001b[0m\r\n    \u001b[2m\u001b[3m... (26 lines hidden, /toggle to show all)\u001b[0m\r\n    \u001b[2mucx_options  = \u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2m######################################################################\u001b[0m\r\n    \u001b[2m#  Site-wide default cpu's per node.\u001b[0m\r\n    \u001b[2m#\u001b[0m\r\n    \u001b[2m#  If unset or 0, the underlying parallel job spawner will be allowed\u001b[0m\r\n    \u001b[2m#  to map UPC threads to nodes using its default behavior (which might\u001b[0m\r\n    \u001b[2m#  be one UPC thread per node, regardless of the CPU count per node).\u001b[0m\r\n    \u001b[2m######################################################################\u001b[0m\r\n    \u001b[2mdefault_cpus_per_node = 0\u001b[0m\r\n"]
