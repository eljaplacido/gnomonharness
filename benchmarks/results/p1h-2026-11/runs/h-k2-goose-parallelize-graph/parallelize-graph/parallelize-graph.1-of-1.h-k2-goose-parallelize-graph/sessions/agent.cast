[478.387827, "o", "\r\n  \u001b[2m────────────────────────────────────────\u001b[0m\r\n  \u001b[2m▸\u001b[0m \u001b[2mshell\u001b[0m\r\n    \u001b[2mcommand\u001b[0m: \u001b[32mcd /app && upcc -show 2>&1 | head -20; echo \"=== upcrun help:\"; upcrun 2>&1 | head -30\u001b[0m\r\n\r\n"]
[478.499375, "o", "    \u001b[2mUsage: upcc [options] foo.upc [ bar.c someobject.o ... ] \u001b[0m\r\n    \u001b[2mFor detailed documentation, please see man upcc(1) or https://upc.lbl.gov/docs/\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2mStandard C compiler options:\u001b[0m\r\n    \u001b[2m   -c                 Compile source files, but do not link.\u001b[0m\r\n    \u001b[2m   -DFOO[=bar]        Define preprocessor symbol FOO [to optional value].\u001b[0m\r\n    \u001b[2m   -E                 Preprocess source files (output sent to stdout).\u001b[0m\r\n    \u001b[2m   -g                 Generate debug objects/executables \u001b[0m\r\n    \u001b[2m   -I path            Add path to directories searched for header files.\u001b[0m\r\n    \u001b[2m   -lfoo              Link executable with libfoo.a.\u001b[0m\r\n    \u001b[2m\u001b[3m... (31 lines hidden, /toggle to show all)\u001b[0m\r\n    \u001b[2m            but must agree with the compiled-in setting if present.\u001b[0m\r\n    \u001b[2m            (-np is a synonym for -n)\u001b[0m\r\n    \u001b[2m    -N -nodes <num>\u001b[0m\r\n    \u001b[2m            Specifies the number of compute nodes to use for\u001b[0m\r\n    \u001b[2m            execution. See the THREAD LAYOUT section of the man page\u001b[0m\r\n    \u001b[2m            for more details.\u001b[0m\r\n    \u001b[2m    -c -cpus-per-node <num>\u001b[0m\r\n    \u001b[2m            Specifies the number of UPC threads to execute on each\u001b[0m\r\n    \u001b[2m            compute node. See the THREAD LAYOUT section of the man\u001b[0m\r\n    \u001b[2m            page for more details.\u001b[0m\r\n"]
[480.751495, "o", "\r\n  \u001b[2m────────────────────────────────────────\u001b[0m\r\n  \u001b[2m▸\u001b[0m \u001b[2mshell\u001b[0m\r\n    \u001b[2mcommand\u001b[0m: \u001b[32mcd /app && upcrun -network=smp -n 4 -shared-heap 256MB ./pgen test 2>&1 | head -20; echo \"=== files:\"; ls -la /app/pgen*.out 2>/dev/null\u001b[0m\r\n\r\n"]
