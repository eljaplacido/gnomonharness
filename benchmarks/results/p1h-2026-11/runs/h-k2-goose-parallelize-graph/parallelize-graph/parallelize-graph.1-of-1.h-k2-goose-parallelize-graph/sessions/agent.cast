[18.978129, "o", "\r\n  \u001b[2m────────────────────────────────────────\u001b[0m\r\n  \u001b[2m▸\u001b[0m \u001b[2mshell\u001b[0m\r\n    \u001b[2mcommand\u001b[0m: \u001b[32mcd /tmp && (nohup curl -sSL -o berkeley_upc-2022.10.0.tar.gz https://upc.lbl.gov/download/release/berkeley_upc-2022.10.0.tar.gz > /tmp/dl.log 2>...\u001b[0m\r\n\r\n\r\n  \u001b[2m────────────────────────────────────────\u001b[0m\r\n  \u001b[2m▸\u001b[0m \u001b[2mshell\u001b[0m\r\n    \u001b[2mcommand\u001b[0m: \u001b[32mcd /app && awk -F'\\t' '{print length($1), length($2)}' test | sort | uniq -c | head; echo \"--- unique kmers:\"; cut -f1 test | sort -u | wc -l; e...\u001b[0m\r\n\r\n"]
[23.999944, "o", "    \u001b[2m  10000 19 2\u001b[0m\r\n    \u001b[2m--- unique kmers:\u001b[0m\r\n    \u001b[2m10000\u001b[0m\r\n    \u001b[2m--- ext chars:\u001b[0m\r\n    \u001b[2m   5203 A\u001b[0m\r\n    \u001b[2m   4876 C\u001b[0m\r\n    \u001b[2m     11 F\u001b[0m\r\n    \u001b[2m   4981 G\u001b[0m\r\n    \u001b[2m   4929 T\u001b[0m\r\n    \u001b[2m--- sample:\u001b[0m\r\n    \u001b[2m\u001b[3m... (16 lines hidden, /toggle to show all)\u001b[0m\r\n    \u001b[2mACTGGCTGGAGAAGAGATA\tTA\u001b[0m\r\n    \u001b[2mCTGGCTGGAGAAGAGATAA\tAT\u001b[0m\r\n    \u001b[2mTGGCTGGAGAAGAGATAAT\tCG\u001b[0m\r\n    \u001b[2mGGCTGGAGAAGAGATAATG\tTA\u001b[0m\r\n    \u001b[2m--- tail:\u001b[0m\r\n    \u001b[2mTGCCACTGACCGGAACAGC\tGG\u001b[0m\r\n    \u001b[2mGCCACTGACCGGAACAGCG\tTT\u001b[0m\r\n    \u001b[2mCCACTGACCGGAACAGCGT\tGT\u001b[0m\r\n    \u001b[2mCACTGACCGGAACAGCGTT\tCT\u001b[0m\r\n    \u001b[2mACTGACCGGAACAGCGTTT\tCA\u001b[0m\r\n    \u001b[2m-rw-r--r-- 1 root root 5980624 Nov  1 04:43 /tmp/berkeley_upc-2022.10.0.tar.gz\u001b[0m\r\n"]
