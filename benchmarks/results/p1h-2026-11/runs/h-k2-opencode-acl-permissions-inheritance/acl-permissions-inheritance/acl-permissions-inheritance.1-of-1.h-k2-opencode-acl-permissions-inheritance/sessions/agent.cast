[17.370543, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[17.370603, "o", "3. The ACL configuration must ensure that:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[17.370697, "o", "   - Any file created by alice or bob in /srv/shared is accessible by both users\r\n\u001b[?2004l\r\u001b[?2004h> "]
