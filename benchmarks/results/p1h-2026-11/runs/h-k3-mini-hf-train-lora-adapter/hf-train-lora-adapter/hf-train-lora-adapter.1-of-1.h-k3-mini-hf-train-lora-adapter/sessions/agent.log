cd /app && cat > train_lora.py <<'PY'
#!/usr/bin/env python3
"""LoRA fine-tuning of GPT-2 for biomedical multiple-choice QA.

The model is trained as a causal language model.  Each example is formatted as
a question followed by the four lettered choices and an "Answer:" cue.  Loss is
computed only on the answer letter (and EOS), which makes the adapter focus on
selecting the correct choice while keeping training fast on CPU.

Usage:
    python train_lora.py
"""

import argparse
import json
import os
import random
import re
import time
from pathlib import Path

import torch
from peft import LoraConfig, PeftModel, TaskType, get_peft_model
from torch.optim import AdamW
from torch.utils.data import DataLoader, Dataset
from transformers import AutoModelForCausalLM, AutoTokenizer

BASE_MODEL = "openai-community/gpt2"
DATA_DIR = Path("/app/data")
OUTPUT_DIR = Path("/app/experiments/lora_adapter")
RESULTS_PATH = Path("/app/lora_results.json")
LETTERS = list("ABCD")


def set_seed(seed: int) -> None:
    random.seed(seed)
    os.environ["PYTHONHASHSEED"] = str(seed)
    torch.manual_seed(seed)
    if torch.cuda.is_available():
        torch.cuda.manual_seed_all(seed)


def format_prompt(sample: dict) -> str:
    """Canonical prompt used both for training and generation/evaluation."""
    options = "\n".join(str(option).strip() for option in sample["options"])
    return f"Question: {sample['question'].strip()}\n{options}\nAnswer:"


def format_target(answer: str, eos_token: str) -> str:
    # The leading space is important: GPT-2 encodes " A" as a single token.
    return f" {answer.strip().upper()}{eos_token}"


class MCQDataset(Dataset):
    def __init__(self, samples, tokenizer, max_length=256):
        self.samples = samples
        self.tokenizer = tokenizer
        self.max_length = max_length
        self.encoded = [self._encode(sample) for sample in samples]

    def _encode(self, sample):
        prompt = format_prompt(sample)
        prompt_ids = self.tokenizer(prompt, add_special_tokens=False)["input_ids"]
        eos = self.tokenizer.eos_token or ""
        target_ids = self.tokenizer(
            format_target(sample["answer"], eos), add_special_tokens=False
        )["input_ids"]

        input_ids = prompt_ids + target_ids
        labels = [-100] * len(prompt_ids) + target_ids
        if len(input_ids) > self.max_length:
            # Keep the answer target and the end of the prompt.  Extra prompt
            # context is removed from the left, which keeps the "Answer:" cue.
            overflow = len(input_ids) - self.max_length
            input_ids = input_ids[overflow:]
            labels = labels[overflow:]
        return {
            "input_ids": input_ids,
            "attention_mask": [1] * len(input_ids),
            "labels": labels,
        }

    def __len__(self):
        return len(self.encoded)

    def __getitem__(self, idx):
        return self.encoded[idx]


class CausalCollator:
    def __init__(self, tokenizer):
        self.pad_token_id = tokenizer.pad_token_id
        assert self.pad_token_id is not None

    def __call__(self, features):
        max_len = max(len(f["input_ids"]) for f in features)
        input_ids, attention_mask, labels = [], [], []
        for f in features:
            n_pad = max_len - len(f["input_ids"])
            input_ids.append(f["input_ids"] + [self.pad_token_id] * n_pad)
            attention_mask.append(f["attention_mask"] + [0] * n_pad)
            labels.append(f["labels"] + [-100] * n_pad)
        return {
            "input_ids": torch.tensor(input_ids, dtype=torch.long),
            "attention_mask": torch.tensor(attention_mask, dtype=torch.long),
            "labels": torch.tensor(labels, dtype=torch.long),
        }


class AnswerLetterScorer:
    """Score the four answer-letter tokens at the final prompt position."""

    def __init__(self, tokenizer):
        self.tokenizer = tokenizer
        self.letter_ids = []
        for letter in LETTERS:
            ids = tokenizer(f" {letter}", add_special_tokens=False)["input_ids"]
            # All four labels should tokenize to a single token for GPT-2.
            self.letter_ids.append(ids[0])

    @torch.no_grad()
    def predict_batch(self, model, batch):
        outputs = model(
            input_ids=batch["input_ids"], attention_mask=batch["attention_mask"]
        )
        logits = outputs.logits
        positions = batch["attention_mask"].sum(dim=1) - 1
        batch_indices = torch.arange(logits.size(0), device=logits.device)
        last_logits = logits[batch_indices, positions]
        scores = last_logits[:, self.letter_ids]
        return scores.argmax(dim=-1).cpu().tolist(), scores.cpu().tolist()


def extract_answer(text: str):
    text = text.strip()
    match = re.search(r"\b([ABCD])\b", text, flags=re.IGNORECASE)
    if match:
        return match.group(1).upper()
    match = re.search(r"[ABCD]", text, flags=re.IGNORECASE)
    return match.group(0).upper() if match else None


def evaluate(model, dataset, collator, scorer, batch_size=16):
    model.eval()
    loader = DataLoader(dataset, batch_size=batch_size, shuffle=False, collate_fn=collator)
    correct = 0
    total = 0
    for batch in loader:
        preds, _ = scorer.predict_batch(model, batch)
        labels = batch["labels"]
        for pred, row_labels in zip(preds, labels):
            valid = row_labels[row_labels != -100]
            if len(valid) == 0:
                continue
            gold_id = valid[0].item()
            gold_letter = scorer.tokenizer.decode([gold_id]).strip().upper()
            if gold_letter and gold_letter[0] == LETTERS[pred]:
                correct += 1
            total += 1
    return correct / total if total else 0.0


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--model_name", default=BASE_MODEL)
    parser.add_argument("--epochs", type=int, default=10)
    parser.add_argument("--batch_size", type=int, default=8)
    parser.add_argument("--learning_rate", type=float, default=5e-4)
    parser.add_argument("--weight_decay", type=float, default=0.01)
    parser.add_argument("--max_length", type=int, default=256)
    parser.add_argument("--seed", type=int, default=42)
    parser.add_argument("--patience", type=int, default=3)
    parser.add_argument("--output_dir", default=str(OUTPUT_DIR))
    parser.add_argument("--results_path", default=str(RESULTS_PATH))
    args = parser.parse_args()

    set_seed(args.seed)
    # Use all available CPU cores; cap at 20 to avoid excessive thread overhead.
    torch.set_num_threads(min(20, os.cpu_count() or 1))
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    print(f"Using device: {device}", flush=True)

    with open(DATA_DIR / "train.json", "r", encoding="utf-8") as f:
        train_samples = json.load(f)
    with open(DATA_DIR / "val.json", "r", encoding="utf-8") as f:
        val_samples = json.load(f)
    print(f"Loaded {len(train_samples)} train / {len(val_samples)} validation samples", flush=True)

    tokenizer = AutoTokenizer.from_pretrained(args.model_name)
    if tokenizer.pad_token is None:
        tokenizer.pad_token = tokenizer.eos_token
    tokenizer.padding_side = "right"

    model = AutoModelForCausalLM.from_pretrained(args.model_name)
    model.config.pad_token_id = tokenizer.pad_token_id

    lora_config = LoraConfig(
        r=8,
        lora_alpha=16,
        target_modules=["c_attn"],
        lora_dropout=0.05,
        bias="none",
        task_type=TaskType.CAUSAL_LM,
    )
    model = get_peft_model(model, lora_config)
    model.to(device)
    model.print_trainable_parameters()

    train_dataset = MCQDataset(train_samples, tokenizer, args.max_length)
    val_dataset = MCQDataset(val_samples, tokenizer, args.max_length)
    collator = CausalCollator(tokenizer)
    scorer = AnswerLetterScorer(tokenizer)

    train_loader = DataLoader(
        train_dataset,
        batch_size=args.batch_size,
        shuffle=True,
        collate_fn=collator,
        drop_last=False,
    )
    optimizer = AdamW(
        [p for p in model.parameters() if p.requires_grad],
        lr=args.learning_rate,
        weight_decay=args.weight_decay,
    )
    num_training_steps = len(train_loader) * args.epochs
    scheduler = torch.optim.lr_scheduler.LambdaLR(
        optimizer,
        lambda step: min(1.0, (step + 1) / max(1, int(0.1 * num_training_steps))),
    )

    output_dir = Path(args.output_dir)
    output_dir.mkdir(parents=True, exist_ok=True)
    best_val_acc = -1.0
    best_epoch = 0
    epochs_without_improvement = 0
    history = []

    for epoch in range(1, args.epochs + 1):
        model.train()
        epoch_start = time.time()
        running_loss = 0.0
        num_batches = 0
        for step, batch in enumerate(train_loader, start=1):
            batch = {k: v.to(device) for k, v in batch.items()}
            outputs = model(**batch)
            loss = outputs.loss
            loss.backward()
            torch.nn.utils.clip_grad_norm_(
                [p for p in model.parameters() if p.requires_grad], 1.0
            )
            optimizer.step()
            scheduler.step()
            optimizer.zero_grad(set_to_none=True)
            running_loss += loss.item()
            num_batches += 1
            if step % 10 == 0:
                print(
                    f"epoch {epoch} step {step}/{len(train_loader)} "
                    f"loss={running_loss / num_batches:.4f}",
                    flush=True,
                )

        train_loss = running_loss / max(1, num_batches)
        val_acc = evaluate(model, val_dataset, collator, scorer)
        elapsed = time.time() - epoch_start
        history.append(
            {"epoch": epoch, "train_loss": train_loss, "val_accuracy": val_acc}
        )
        print(
            f"epoch {epoch}: train_loss={train_loss:.4f} val_acc={val_acc:.4f} "
            f"time={elapsed:.1f}s",
            flush=True,
        )

        if val_acc > best_val_acc:
            best_val_acc = val_acc
            best_epoch = epoch
            epochs_without_improvement = 0
            model.save_pretrained(output_dir, safe_serialization=True)
            tokenizer.save_pretrained(output_dir)
            print(f"Saved new best adapter (val_acc={val_acc:.4f}) to {output_dir}", flush=True)
        else:
            epochs_without_improvement += 1

        if epochs_without_improvement >= args.patience:
            print(f"Early stopping after epoch {epoch}", flush=True)
            break

    # Guarantee that a complete, loadable adapter and tokenizer exist even if
    # validation accuracy never improved after initialization.
    if not (output_dir / "adapter_model.safetensors").exists():
        model.save_pretrained(output_dir, safe_serialization=True)
        tokenizer.save_pretrained(output_dir)

    # Save a small training-history sidecar for inspection.  The required
    # /app/lora_results.json below contains exactly the requested schema.
    with open(output_dir / "training_history.json", "w", encoding="utf-8") as f:
        json.dump(history, f, indent=2)

    results = {
        "model": args.model_name,
        "lora_config": {
            "r": 8,
            "alpha": 16,
            "epochs": best_epoch if best_epoch else args.epochs,
        },
        "training_samples": len(train_samples),
        "validation_samples": len(val_samples),
    }
    with open(args.results_path, "w", encoding="utf-8") as f:
        json.dump(results, f, indent=2)
    print(f"Best validation accuracy: {best_val_acc:.4f} at epoch {best_epoch}", flush=True)
    print(f"Wrote results to {args.results_path}", flush=True)


if __name__ == "__main__":
    main()
PY
