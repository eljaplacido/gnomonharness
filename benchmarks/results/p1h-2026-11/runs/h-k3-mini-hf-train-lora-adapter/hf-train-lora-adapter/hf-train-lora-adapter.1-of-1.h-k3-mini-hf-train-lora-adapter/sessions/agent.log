import json, torch, re
from collections import Counter
from transformers import AutoTokenizer, AutoModelForCausalLM
from peft import PeftModel
tok=AutoTokenizer.from_pretrained('/app/experiments/lora_adapter')
base=AutoModelForCausalLM.from_pretrained('openai-community/gpt2')
model=PeftModel.from_pretrained(base,'/app/experiments/lora_adapter'); model.eval()
va=json.load(open('/app/data/val.json'))
ids=[tok(' '+x, add_special_tokens=False).input_ids[0] for x in 'ABCD']
preds=[]; gold=[]
for s in va:
 p='Question: '+s['question']+'\n'+'\n'.join(s['options'])+'\nAnswer:'
 enc=tok(p, return_tensors='pt', truncation=True, max_length=128)
 with torch.no_grad(): out=model(**enc)
 logits=out.logits[0,-1,ids]
 pred='ABCD'[int(logits.argmax())]
 preds.append(pred); gold.append(s['answer'])
print('acc',sum(a==b for a,b in zip(preds,gold))/len(gold))
print('preds',Counter(preds))
print('gold',Counter(gold))
print('confusion')
for a in 'ABCD':
 print(a, {b:sum(1 for x,y in zip(gold,preds) if x==a and y==b) for b in 'ABCD'})
PY
OMP_NUM_THREADS=2 nohup python /app/diag.py > /app/diag.log 2>&1 & echo $! > /app/diag.pid; echo diag_started
