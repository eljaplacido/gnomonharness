```
cd /app && python - <<'PY'
import torch, time, json
from transformers import AutoTokenizer, AutoModelForCausalLM
torch.set_num_threads(20)
tok=AutoTokenizer.from_pretrained('openai-community/gpt2'); tok.pad_token=tok.eos_token
model=AutoModelForCausalLM.from_pretrained('openai-community/gpt2')
samples=json.load(open('data/train.json'))
def prompt(s):
    opts='\n'.join(s['options'])
    return f"Question: {s['question']}\n{opts}\nAnswer:"
lens=[len(tok(prompt(s)+' '+s['answer']).input_ids) for s in samples]
import numpy as np
print('token lengths min/mean/p95/max',min(lens),sum(lens)/len(lens),np.percentile(lens,95),max(lens))
for bs in [4,8,16]:
    batch=[tok(prompt(s)+' '+s['answer'], padding='max_length', max_length=192, truncation=True, return_tensors='pt') for s in samples[:bs]]
    ids=torch.stack([b.input_ids[0] for b in batch]); mask=torch.stack([b.attention_mask[0] for b in batch])
    labels=ids.clone()
    model.train(); t=time.time(); out=model(input_ids=ids, attention_mask=mask, labels=labels); loss=out.loss; loss.backward(); dt=time.time()-t
    print('bs',bs,'time',round(dt,2),'loss',loss.item())
