cd /app && python - <<'PY'
from transformers import AutoTokenizer, AutoModelForCausalLM
import time, torch
name='openai-community/gpt2'
t=time.time(); tok=AutoTokenizer.from_pretrained(name); print('tok loaded',time.time()-t)
t=time.time(); model=AutoModelForCausalLM.from_pretrained(name); print('model loaded',time.time()-t, sum(p.numel() for p in model.parameters())/1e6)
tok.pad_token=tok.eos_token
text='Question: What is hemoglobin?\nA. Transport oxygen\nB. Fight infections\nC. Clot blood\nD. Digest food\nAnswer: A'
enc=tok(text, return_tensors='pt')
print(enc.input_ids.shape, tok.convert_ids_to_tokens(enc.input_ids[0][-5:]))
model.train()
t=time.time()
out=model(**enc, labels=enc.input_ids)
out.loss.backward()
print('fwd+bwd sec', time.time()-t)
