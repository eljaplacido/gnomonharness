cd /app && kill $(cat train_lora.pid) 2>/dev/null || true; sleep 2; if [ -d /proc/$(cat train_lora.pid) ]; then kill -9 $(cat train_lora.pid) 2>/dev/null || 
true; fi; echo killed; cat /proc/cpuinfo | grep -m1 'model name' || true; grep -c ^processor /proc/cpuinfo; cat > /app/bench.py <<'PY'
import os, time, json, torch
from transformers import AutoTokenizer, AutoModelForCausalLM
from peft import LoraConfig, get_peft_model
print('torch', torch.__version__, 'cpus', os.cpu_count(), flush=True)
tok=AutoTokenizer.from_pretrained('openai-community/gpt2'); tok.pad_token=tok.eos_token
model=AutoModelForCausalLM.from_pretrained('openai-community/gpt2')
cfg=LoraConfig(r=8,lora_alpha=16,target_modules=['c_attn'],lora_dropout=0.05,bias='none',task_type='CAUSAL_LM')
model=get_peft_model(model,cfg); model.train()
samples=json.load(open('data/train.json'))
def prompt(s): return 'Question: '+s['question']+'\n'+'\n'.join(s['options'])+'\nAnswer:'
for maxlen in [96,128,192]:
  # fixed batches with right padding
  encs=[]
  for s in samples[:8]:
    ids=tok(prompt(s)+' '+s['answer']+tok.eos_token, max_length=maxlen, truncation=True, return_tensors=None)['input_ids']
    encs.append(ids)
  n=max(len(x) for x in encs)
  ids=torch.tensor([x+[tok.pad_token_id]*(n-len(x)) for x in encs])
  mask=(ids!=tok.pad_token_id).long()
  for nt in [1,2,4,8,20]:
    torch.set_num_threads(nt)
    model.zero_grad(set_to_none=True)
    t=time.time(); out=model(input_ids=ids, attention_mask=mask, labels=ids); out.loss.backward(); dt=time.time()-t
    print('maxlen',maxlen,'threads',nt,'bs8 time',round(dt,2), flush=True)
PY
nohup python /app/bench.py > /app/bench.log 2>&1 & echo $! > /app/bench.pid; echo bench_started
