[44.449283, "o", "  \"model\": string,           // Base model name used (e.g., \"openai-community/gpt2\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[44.449314, "o", ">   \"lora_config\": {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.449367, "o", "    \"r\": number,            // LoRA rank (must be 8)\r\n\u001b[?2004l\r\u001b[?2004h> "]
