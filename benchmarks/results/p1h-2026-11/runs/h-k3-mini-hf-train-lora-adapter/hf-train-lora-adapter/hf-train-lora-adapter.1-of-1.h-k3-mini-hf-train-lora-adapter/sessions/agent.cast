[1161.67459, "o", "\r\u001b[2KI found the issue: validation was scoring the logits after the appended training answer/EOS tokens, not at the `Answer:` prompt position. The saved adapter \r\nactually predicts `C` for all examples (35% accuracy). I’ll fix validation to score the correct prompt position and rerun training.\r\n\r\n```\r\ncd /app && python - <<'PY'\r\np='train_lora.py'\r\ns=open(p).read()\r\ns=s.replace(\r\n'''        input_ids = prompt_ids + target_ids\r\n        labels = [-100] * len(prompt_ids) + target_ids\r\n        if len(input_ids) > self.max_length:\r\n            # Keep the answer target and the end of the prompt.  Extra prompt\r\n            # context is removed from the left, which keeps the \"Answer:\" cue.\r\n            overflow = len(input_ids) - self.max_length\r\n            input_ids = input_ids[overflow:]\r\n            labels = labels[overflow:]\r\n        return {\r\n            \"input_ids\": input_ids,\r\n            \"attention_mask\": [1] * len(input_ids),\r\n            \"labels\": labels,\r\n        }''',\r\n'''        prompt_len = len(prompt"]
[1161.674676, "o", "_ids)\r\n        input_ids = prompt_ids + target_ids\r\n        labels = [-100] * len(prompt_ids) + target_ids\r\n        if len(input_ids) > self.max_length:\r\n            # Keep the answer target and the end of the prompt.  Extra prompt\r\n            # context is removed from the left, which keeps the \"Answer:\" cue.\r\n            overflow = len(input_ids) - self.max_length\r\n            input_ids = input_ids[overflow:]\r\n            labels = labels[overflow:]\r\n            prompt_len = max(0, prompt_len - overflow)\r\n        # Position of the final prompt token.  Evaluation must take next-token\r\n        # logits here, not after the appended answer/EOS target tokens.\r\n        prompt_last_idx = max(0, min(prompt_len - 1, len(input_ids) - 1))\r\n        return {\r\n            \"input_ids\": input_ids,\r\n            \"attention_mask\": [1] * len(input_ids),\r\n            \"labels\": labels,\r\n            \"prompt_last_idx\": prompt_last_idx,\r\n        }''')\r\ns=s.replace(\r\n'''        input_ids, attention_mask, labels = [], [], []\r\n        "]
[1161.674685, "o", "for f in features:\r\n            n_pad = max_len - len(f[\"input_ids\"])\r\n            input_ids.append(f[\"input_ids\"] + [self.pad_token_id] * n_pad)\r\n            attention_mask.append(f[\"attention_mask\"] + [0] * n_pad)\r\n            labels.append(f[\"labels\"] + [-100] * n_pad)\r\n        return {\r\n            \"input_ids\": torch.tensor(input_ids, dtype=torch.long),\r\n            \"attention_mask\": torch.tensor(attention_mask, dtype=torch.long),\r\n            \"labels\": torch.tensor(labels, dtype=torch.long),\r\n        }''',\r\n'''        input_ids, attention_mask, labels, prompt_last_idx = [], [], [], []\r\n        for f in features:\r\n            n_pad = max_len - len(f[\"input_ids\"])\r\n            input_ids.append(f[\"input_ids\"] + [self.pad_token_id] * n_pad)\r\n            attention_mask.append(f[\"attention_mask\"] + [0] * n_pad)\r\n            labels.append(f[\"labels\"] + [-100] * n_pad)\r\n            prompt_last_idx.append(f[\"prompt_last_idx\"])\r\n        return {\r\n            \"input_ids\": torch.tensor(input_ids, dtype=torch.long),\r"]
[1161.674697, "o", "\n            \"attention_mask\": torch.tensor(attention_mask, dtype=torch.long),\r\n            \"labels\": torch.tensor(labels, dtype=torch.long),\r\n            \"prompt_last_idx\": torch.tensor(prompt_last_idx, dtype=torch.long),\r\n        }''')\r\ns=s.replace(\r\n'''        positions = batch[\"attention_mask\"].sum(dim=1) - 1\r\n        batch_indices = torch.arange(logits.size(0), device=logits.device)''',\r\n'''        positions = batch[\"prompt_last_idx\"].to(logits.device)\r\n        batch_indices = torch.arange(logits.size(0), device=logits.device)''')\r\nopen(p,'w').write(s)\r\nPY\r\npython -m py_compile train_lora.py && grep -n \"prompt_last_idx\" train_lora.py && echo OK\r\n```\r\n\u001b[32m⠹\u001b[0m Waiting for the LM to respond...\r\u001b[2K\u001b[32m⠹\u001b[0m Waiting for the LM to respond...\r\n\u001b[?25h\r\u001b[1A\u001b[2K"]
