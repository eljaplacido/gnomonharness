[1110.761506, "o", "\r\u001b[2K```\r\nsleep 25; cd /app; if [ -d /proc/$(cat diag.pid) ]; then echo RUNNING; else echo DONE; fi; cat diag.log\r\n```\r\n\u001b[32m⠧\u001b[0m Waiting for the LM to respond..."]
[1110.764497, "o", "\r\u001b[2K\u001b[32m⠧\u001b[0m Waiting for the LM to respond...\r\u001b[2K\u001b[32m⠧\u001b[0m Waiting for the LM to respond...\r\n\u001b[?25h\r\u001b[1A\u001b[2K"]
[1135.777827, "o", "\r\n\u001b[1;32mTool\u001b[0m:\r\n"]
