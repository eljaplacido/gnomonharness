[373.522945, "o", "\r\u001b[2KI’ll now write a self-contained training script that: formats multiple-choice prompts, masks loss to the answer token, applies LoRA to `c_attn`, validates each \r\nepoch, saves the best adapter, and writes the required results JSON.\r\n\r\n```\r\ncd /app && cat > train_lora.py <<'PY'\r\n#!/usr/bin/env python3\r\n\"\"\"LoRA fine-tuning of GPT-2 for biomedical multiple-choice QA.\r\n\r\nThe model is trained as a causal language model.  Each example is formatted as\r\na question followed by the four lettered choices and an \"Answer:\" cue.  Loss is\r\ncomputed only on the answer letter (and EOS), which makes the adapter focus on\r\nselecting the correct choice while keeping training fast on CPU.\r\n\r\nUsage:\r\n    python train_lora.py\r\n\"\"\"\r\n\r\nimport argparse\r\nimport json\r\nimport os\r\nimport random\r\nimport re\r\nimport time\r\nfrom pathlib import Path\r\n\r\nimport torch\r\nfrom peft import LoraConfig, PeftModel, TaskType, get_peft_model\r\nfrom torch.optim import AdamW\r\nfrom torch.utils.data import DataLoader, Dataset\r\nfrom transformers import Auto"]
[373.523146, "o", "ModelForCausalLM, AutoTokenizer\r\n\r\nBASE_MODEL = \"openai-community/gpt2\"\r\nDATA_DIR = Path(\"/app/data\")\r\nOUTPUT_DIR = Path(\"/app/experiments/lora_adapter\")\r\nRESULTS_PATH = Path(\"/app/lora_results.json\")\r\nLETTERS = list(\"ABCD\")\r\n\r\n\r\ndef set_seed(seed: int) -> None:\r\n    random.seed(seed)\r\n    os.environ[\"PYTHONHASHSEED\"] = str(seed)\r\n    torch.manual_seed(seed)\r\n    if torch.cuda.is_available():\r\n        torch.cuda.manual_seed_all(seed)\r\n\r\n\r\ndef format_prompt(sample: dict) -> str:\r\n    \"\"\"Canonical prompt used both for training and generation/evaluation.\"\"\"\r\n    options = \"\\n\".join(str(option).strip() for option in sample[\"options\"])\r\n    return f\"Question: {sample['question'].strip()}\\n{options}\\nAnswer:\"\r\n\r\n\r\ndef format_target(answer: str, eos_token: str) -> str:\r\n    # The leading space is important: GPT-2 encodes \" A\" as a single token.\r\n    return f\" {answer.strip().upper()}{eos_token}\"\r\n\r\n\r\nclass MCQDataset(Dataset):\r\n    def __init__(self, samples, tokenizer, max_length=256):\r\n        self.samples = sampl"]
[373.523161, "o", "es\r\n        self.tokenizer = tokenizer\r\n        self.max_length = max_length\r\n        self.encoded = [self._encode(sample) for sample in samples]\r\n\r\n    def _encode(self, sample):\r\n        prompt = format_prompt(sample)\r\n        prompt_ids = self.tokenizer(prompt, add_special_tokens=False)[\"input_ids\"]\r\n        eos = self.tokenizer.eos_token or \"\"\r\n        target_ids = self.tokenizer(\r\n            format_target(sample[\"answer\"], eos), add_special_tokens=False\r\n        )[\"input_ids\"]\r\n\r\n        input_ids = prompt_ids + target_ids\r\n        labels = [-100] * len(prompt_ids) + target_ids\r\n        if len(input_ids) > self.max_length:\r\n            # Keep the answer target and the end of the prompt.  Extra prompt\r\n            # context is removed from the left, which keeps the \"Answer:\" cue.\r\n            overflow = len(input_ids) - self.max_length\r\n            input_ids = input_ids[overflow:]\r\n            labels = labels[overflow:]\r\n        return {\r\n            \"input_ids\": input_ids,\r\n            \"attention_mask\":"]
[373.523171, "o", " [1] * len(input_ids),\r\n            \"labels\": labels,\r\n        }\r\n\r\n    def __len__(self):\r\n        return len(self.encoded)\r\n\r\n    def __getitem__(self, idx):\r\n        return self.encoded[idx]\r\n\r\n\r\nclass CausalCollator:\r\n    def __init__(self, tokenizer):\r\n        self.pad_token_id = tokenizer.pad_token_id\r\n        assert self.pad_token_id is not None\r\n\r\n    def __call__(self, features):\r\n        max_len = max(len(f[\"input_ids\"]) for f in features)\r\n        input_ids, attention_mask, labels = [], [], []\r\n        for f in features:\r\n            n_pad = max_len - len(f[\"input_ids\"])\r\n            input_ids.append(f[\"input_ids\"] + [self.pad_token_id] * n_pad)\r\n            attention_mask.append(f[\"attention_mask\"] + [0] * n_pad)\r\n            labels.append(f[\"labels\"] + [-100] * n_pad)\r\n        return {\r\n            \"input_ids\": torch.tensor(input_ids, dtype=torch.long),\r\n            \"attention_mask\": torch.tensor(attention_mask, dtype=torch.long),\r\n            \"labels\": torch.tensor(labels, dtype=torch.long),\r\n  "]
[373.523188, "o", "      }\r\n\r\n\r\nclass AnswerLetterScorer:\r\n    \"\"\"Score the four answer-letter tokens at the final prompt position.\"\"\"\r\n\r\n    def __init__(self, tokenizer):\r\n        self.tokenizer = tokenizer\r\n        self.letter_ids = []\r\n        for letter in LETTERS:\r\n            ids = tokenizer(f\" {letter}\", add_special_tokens=False)[\"input_ids\"]\r\n            # All four labels should tokenize to a single token for GPT-2.\r\n            self.letter_ids.append(ids[0])\r\n\r\n    @torch.no_grad()\r\n    def predict_batch(self, model, batch):\r\n        outputs = model(\r\n            input_ids=batch[\"input_ids\"], attention_mask=batch[\"attention_mask\"]\r\n        )\r\n        logits = outputs.logits\r\n        positions = batch[\"attention_mask\"].sum(dim=1) - 1\r\n        batch_indices = torch.arange(logits.size(0), device=logits.device)\r\n        last_logits = logits[batch_indices, positions]\r\n        scores = last_logits[:, self.letter_ids]\r\n        return scores.argmax(dim=-1).cpu().tolist(), scores.cpu().tolist()\r\n\r\n\r\ndef extract_answer(text: st"]
[373.523194, "o", "r):\r\n    text = text.strip()\r\n    match = re.search(r\"\\b([ABCD])\\b\", text, flags=re.IGNORECASE)\r\n    if match:\r\n        return match.group(1).upper()\r\n    match = re.search(r\"[ABCD]\", text, flags=re.IGNORECASE)\r\n    return match.group(0).upper() if match else None\r\n\r\n\r\ndef evaluate(model, dataset, collator, scorer, batch_size=16):\r\n    model.eval()\r\n    loader = DataLoader(dataset, batch_size=batch_size, shuffle=False, collate_fn=collator)\r\n    correct = 0\r\n    total = 0\r\n    for batch in loader:\r\n        preds, _ = scorer.predict_batch(model, batch)\r\n        labels = batch[\"labels\"]\r\n        for pred, row_labels in zip(preds, labels):\r\n            valid = row_labels[row_labels != -100]\r\n            if len(valid) == 0:\r\n                continue\r\n            gold_id = valid[0].item()\r\n            gold_letter = scorer.tokenizer.decode([gold_id]).strip().upper()\r\n            if gold_letter and gold_letter[0] == LETTERS[pred]:\r\n                correct += 1\r\n            total += 1\r\n    return correct / total if to"]
[373.523201, "o", "tal else 0.0\r\n\r\n\r\ndef main():\r\n    parser = argparse.ArgumentParser()\r\n    parser.add_argument(\"--model_name\", default=BASE_MODEL)\r\n    parser.add_argument(\"--epochs\", type=int, default=10)\r\n    parser.add_argument(\"--batch_size\", type=int, default=8)\r\n    parser.add_argument(\"--learning_rate\", type=float, default=5e-4)\r\n    parser.add_argument(\"--weight_decay\", type=float, default=0.01)\r\n    parser.add_argument(\"--max_length\", type=int, default=256)\r\n    parser.add_argument(\"--seed\", type=int, default=42)\r\n    parser.add_argument(\"--patience\", type=int, default=3)\r\n    parser.add_argument(\"--output_dir\", default=str(OUTPUT_DIR))\r\n    parser.add_argument(\"--results_path\", default=str(RESULTS_PATH))\r\n    args = parser.parse_args()\r\n\r\n    set_seed(args.seed)\r\n    # Use all available CPU cores; cap at 20 to avoid excessive thread overhead.\r\n    torch.set_num_threads(min(20, os.cpu_count() or 1))\r\n    device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\r\n    print(f\"Using device: {device}\", flush"]
[373.523208, "o", "=True)\r\n\r\n    with open(DATA_DIR / \"train.json\", \"r\", encoding=\"utf-8\") as f:\r\n        train_samples = json.load(f)\r\n    with open(DATA_DIR / \"val.json\", \"r\", encoding=\"utf-8\") as f:\r\n        val_samples = json.load(f)\r\n    print(f\"Loaded {len(train_samples)} train / {len(val_samples)} validation samples\", flush=True)\r\n\r\n    tokenizer = AutoTokenizer.from_pretrained(args.model_name)\r\n    if tokenizer.pad_token is None:\r\n        tokenizer.pad_token = tokenizer.eos_token\r\n    tokenizer.padding_side = \"right\"\r\n\r\n    model = AutoModelForCausalLM.from_pretrained(args.model_name)\r\n    model.config.pad_token_id = tokenizer.pad_token_id\r\n\r\n    lora_config = LoraConfig(\r\n        r=8,\r\n        lora_alpha=16,\r\n        target_modules=[\"c_attn\"],\r\n        lora_dropout=0.05,\r\n        bias=\"none\",\r\n        task_type=TaskType.CAUSAL_LM,\r\n    )\r\n    model = get_peft_model(model, lora_config)\r\n    model.to(device)\r\n    model.print_trainable_parameters()\r\n\r\n    train_dataset = MCQDataset(train_samples, tokenizer, args.max_lengt"]
[373.523218, "o", "h)\r\n    val_dataset = MCQDataset(val_samples, tokenizer, args.max_length)\r\n    collator = CausalCollator(tokenizer)\r\n    scorer = AnswerLetterScorer(tokenizer)\r\n\r\n    train_loader = DataLoader(\r\n        train_dataset,\r\n        batch_size=args.batch_size,\r\n        shuffle=True,\r\n        collate_fn=collator,\r\n        drop_last=False,\r\n    )\r\n    optimizer = AdamW(\r\n        [p for p in model.parameters() if p.requires_grad],\r\n        lr=args.learning_rate,\r\n        weight_decay=args.weight_decay,\r\n    )\r\n    num_training_steps = len(train_loader) * args.epochs\r\n    scheduler = torch.optim.lr_scheduler.LambdaLR(\r\n        optimizer,\r\n        lambda step: min(1.0, (step + 1) / max(1, int(0.1 * num_training_steps))),\r\n    )\r\n\r\n    output_dir = Path(args.output_dir)\r\n    output_dir.mkdir(parents=True, exist_ok=True)\r\n    best_val_acc = -1.0\r\n    best_epoch = 0\r\n    epochs_without_improvement = 0\r\n    history = []\r\n\r\n    for epoch in range(1, args.epochs + 1):\r\n        model.train()\r\n        epoch_start = time.time()\r"]
[373.523242, "o", "\n        running_loss = 0.0\r\n        num_batches = 0\r\n        for step, batch in enumerate(train_loader, start=1):\r\n            batch = {k: v.to(device) for k, v in batch.items()}\r\n            outputs = model(**batch)\r\n            loss = outputs.loss\r\n            loss.backward()\r\n            torch.nn.utils.clip_grad_norm_(\r\n                [p for p in model.parameters() if p.requires_grad], 1.0\r\n            )\r\n            optimizer.step()\r\n            scheduler.step()\r\n            optimizer.zero_grad(set_to_none=True)\r\n            running_loss += loss.item()\r\n            num_batches += 1\r\n            if step % 10 == 0:\r\n                print(\r\n                    f\"epoch {epoch} step {step}/{len(train_loader)} \"\r\n                    f\"loss={running_loss / num_batches:.4f}\",\r\n                    flush=True,\r\n                )\r\n\r\n        train_loss = running_loss / max(1, num_batches)\r\n        val_acc = evaluate(model, val_dataset, collator, scorer)\r\n        elapsed = time.time() - epoch_start\r\n        history."]
[373.523247, "o", "append(\r\n            {\"epoch\": epoch, \"train_loss\": train_loss, \"val_accuracy\": val_acc}\r\n        )\r\n        print(\r\n            f\"epoch {epoch}: train_loss={train_loss:.4f} val_acc={val_acc:.4f} \"\r\n            f\"time={elapsed:.1f}s\",\r\n            flush=True,\r\n        )\r\n\r\n        if val_acc > best_val_acc:\r\n            best_val_acc = val_acc\r\n            best_epoch = epoch\r\n            epochs_without_improvement = 0\r\n            model.save_pretrained(output_dir, safe_serialization=True)\r\n            tokenizer.save_pretrained(output_dir)\r\n            print(f\"Saved new best adapter (val_acc={val_acc:.4f}) to {output_dir}\", flush=True)\r\n        else:\r\n            epochs_without_improvement += 1\r\n\r\n        if epochs_without_improvement >= args.patience:\r\n            print(f\"Early stopping after epoch {epoch}\", flush=True)\r\n            break\r\n\r\n    # Guarantee that a complete, loadable adapter and tokenizer exist even if\r\n    # validation accuracy never improved after initialization.\r\n    if not (output_dir / \"ad"]
[373.523437, "o", "apter_model.safetensors\").exists():\r\n        model.save_pretrained(output_dir, safe_serialization=True)\r\n        tokenizer.save_pretrained(output_dir)\r\n\r\n    # Save a small training-history sidecar for inspection.  The required\r\n    # /app/lora_results.json below contains exactly the requested schema.\r\n    with open(output_dir / \"training_history.json\", \"w\", encoding=\"utf-8\") as f:\r\n        json.dump(history, f, indent=2)\r\n\r\n    results = {\r\n        \"model\": args.model_name,\r\n        \"lora_config\": {\r\n            \"r\": 8,\r\n            \"alpha\": 16,\r\n            \"epochs\": best_epoch if best_epoch else args.epochs,\r\n        },\r\n        \"training_samples\": len(train_samples),\r\n        \"validation_samples\": len(val_samples),\r\n    }\r\n    with open(args.results_path, \"w\", encoding=\"utf-8\") as f:\r\n        json.dump(results, f, indent=2)\r\n    print(f\"Best validation accuracy: {best_val_acc:.4f} at epoch {best_epoch}\", flush=True)\r\n    print(f\"Wrote results to {args.results_path}\", flush=True)\r\n\r\n\r\nif __name__ == \"__mai"]
