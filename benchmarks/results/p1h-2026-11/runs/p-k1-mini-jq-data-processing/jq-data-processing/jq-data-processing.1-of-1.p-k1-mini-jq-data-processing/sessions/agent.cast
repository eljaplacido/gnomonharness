[43.657947, "o", "**Note on examples below**: In the following Data Schema sections, all content following the '\"'\"'#'\"'\"' symbol is just explanatory commentary and will NOT appear in the actual JSON files. These comments are only provided to clarify the structure and requirements.\r\n\u001b[?2004l\r"]
[43.657961, "o", "\u001b[?2004h> "]
[43.657975, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[43.657989, "o", "> "]
[43.658039, "o", "**Input Data Schema**:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[43.65818, "o", "The input JSON file '\"'\"'/app/users.json'\"'\"' is an array of user objects with the following structure:\r\n\u001b[?2004l\r"]
[43.658194, "o", "\u001b[?2004h> [\r\n\u001b[?2004l\r"]
[43.65821, "o", "\u001b[?2004h> "]
[43.658231, "o", "  {\r\n\u001b[?2004l\r"]
[43.658244, "o", "\u001b[?2004h> "]
[43.658333, "o", "    \"id\": 1,                  # Unique numeric identifier for the user\r\n\u001b[?2004l\r"]
[43.658361, "o", "\u001b[?2004h> "]
[43.658449, "o", "    \"username\": \"john_doe\",   # User'\"'\"'s unique username (string)\r\n\u001b[?2004l\r"]
[43.658463, "o", "\u001b[?2004h> "]
[43.658564, "o", "    \"email\": \"john@example.com\",  # User'\"'\"'s email address (string)\r\n\u001b[?2004l\r"]
[43.658579, "o", "\u001b[?2004h> "]
[43.658695, "o", "    \"status\": \"active\",       # User status: '\"'\"'active'\"'\"' or '\"'\"'inactive'\"'\"'\r\n\u001b[?2004l\r"]
[43.658704, "o", "\u001b[?2004h"]
[43.658744, "o", "> "]
[43.658841, "o", "    \"last_login\": \"2024-10-02T20:59:10.109812Z\",  # ISO 8601 timestamp (UTC) of the last login\r\n\u001b[?2004l\r"]
[43.65885, "o", "\u001b[?2004h"]
[43.658889, "o", "> "]
[43.658982, "o", "    \"roles\": [\"admin\", \"editor\"]  # Array of roles assigned to the user (may be empty)\r\n\u001b[?2004l\r"]
[43.658998, "o", "\u001b[?2004h> "]
[43.659043, "o", "  },\r\n\u001b[?2004l\r\u001b[?2004h>   ...\r\n\u001b[?2004l\r\u001b[?2004h"]
[43.659061, "o", "> ]\r\n"]
[43.659085, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[43.659103, "o", "\u001b[?2004h> "]
[43.659122, "o", "**Output Data Schema**:\r\n\u001b[?2004l\r"]
[43.659141, "o", "\u001b[?2004h> "]
[43.659301, "o", "The output JSON file '\"'\"'/app/active_users_report.json'\"'\"' must be an array of objects with the following structure:\r\n\u001b[?2004l\r"]
[43.659332, "o", "\u001b[?2004h> [\r\n\u001b[?2004l\r"]
[43.659361, "o", "\u001b[?2004h>   {\r\n\u001b[?2004l\r"]
[43.659386, "o", "\u001b[?2004h> "]
[43.659459, "o", "    \"user_id\": 1,                 # Derived from '\"'\"'id'\"'\"' in input \r\n\u001b[?2004l\r"]
[43.659474, "o", "\u001b[?2004h> "]
[43.659553, "o", "    \"username\": \"john_doe\",       # Retained from input \r\n\u001b[?2004l\r"]
[43.659572, "o", "\u001b[?2004h"]
[43.659626, "o", "> "]
[43.659657, "o", "    \"email\": \"john@example.com\",  # Retained from input \r\n\u001b[?2004l\r"]
[43.659721, "o", "\u001b[?2004h> "]
[43.659777, "o", "    \"last_login\": \"2024-10-02\",   # Formatted from '\"'\"'last_login'\"'\"' in input\r\n\u001b[?2004l\r"]
[43.659801, "o", "\u001b[?2004h"]
[43.659824, "o", "> "]
[43.659949, "o", "    \"role_count\": 2,              # Count of '\"'\"'roles'\"'\"' from input\r\n\u001b[?2004l\r"]
[43.660005, "o", "\u001b[?2004h> "]
[43.660102, "o", "    \"primary_role\": \"admin\"       # If '\"'\"'roles'\"'\"' is empty, this must be null (JSON null, not \"null\")\r\n\u001b[?2004l\r"]
[43.660127, "o", "\u001b[?2004h"]
