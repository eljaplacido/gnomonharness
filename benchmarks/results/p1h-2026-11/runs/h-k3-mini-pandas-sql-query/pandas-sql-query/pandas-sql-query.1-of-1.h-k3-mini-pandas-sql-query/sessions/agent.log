import duckdb, pandas as pd
from pathlib import Path
products = pd.read_csv('products.csv')
orders = pd.read_csv('orders.csv', parse_dates=['order_date'])
q4 = orders[(orders.order_date >= '2024-10-01') & (orders.order_date < '2025-01-01')]
joined = q4.merge(products, on='product_id')
joined['sales'] = joined.quantity * joined.unit_price
expected = (joined.groupby(['category','product_id']).sales.sum().reset_index()
            .sort_values(['category','sales','product_id'], ascending=[True,False,True])
            .groupby('category').head(3))
con = duckdb.connect(); con.register('products', products); con.register('orders', orders)
actual = con.execute(Path('answer.sql').read_text()).df().sort_values(['category','total_sales','product_id'], 
ascending=[True,False,True]).reset_index(drop=True)
expected = expected.sort_values(['category','sales','product_id'], ascending=[True,False,True]).reset_index(drop=True)
print('matches pandas:', actual[['category','product_id']].equals(expected[['category','product_id']]))
print('all revenue matches:', abs(actual.total_sales - expected.sales).max() < 1e-9)
print('boundary rows:', int((orders.order_date.isin(['2024-10-01','2024-12-31'])).sum()))
