[10.780486, "i", "\\n- \\\"\\u4F60\\u597D\\uFF0C\\u4F60\\u597D\\u5417\\uFF1F\\\"\\n-\\\n  \\ \\\"\\u0645\\u0631\\u062D\\u0628\\u0627\\u060C \\u0643\\u064A\\u0641 \\u062D\\u0627\\u0644\\u0643\\\n  \\u061F\\\"\\n- \\\"Hello, how are you?\\\"\\n\\nExpected output format in detection_results.json:\\n\\\n  ```json\\n[\\n  {\\n    \\\"text\\\": \\\"input text\\\",\\n    \\\"predicted_class_id\\\": 0,\\n\\\n  \\    \\\"confidence\\\": 0.95\\n  }\\n]\\n```\"\ntitle: terminal-bench\nversion: 1.0.0\nEOF\r"]
