[45.092413, "o", "\r\u001b[2K```\r\ncd /app && cp model_ref.xml model.xml && python - <<'PY'\r\nimport mujoco, time, numpy as np\r\nm=mujoco.MjModel.from_xml_path('model_ref.xml')\r\nprint('mujoco',mujoco.__version__)\r\nfor attr in ['nbody','nq','nv','njnt','neq','nu','ngeom','nmesh','ntendon','nsensor','nplugin','nmat','nuserdata']:\r\n print(attr,getattr(m,attr,None))\r\nprint('timestep',m.opt.timestep,'integrator',m.opt.integrator,'solver',m.opt.solver,'iterations',m.opt.iterations,'ls_iterations',m.opt.ls_iterations,'tolerance\r\n',m.opt.tolerance,'ls_tolerance',m.opt.ls_tolerance,'gravity',m.opt.gravity,'cone',m.opt.cone,'jacobian',m.opt.jacobian,'noslip',m.opt.noslip_iterations)\r\nprint('impratio',m.opt.impratio,'o_margin',m.opt.o_margin,'o_solref',m.opt.o_solref,'o_solimp',m.opt.o_solimp)\r\nprint('nconmax',m.nconmax,'njmax',m.njmax,'memory',m.narena)\r\nprint('dof damping',m.dof_damping[:10], m.dof_damping.min(),m.dof_damping.max())\r\nprint('bodies')\r\nfor i in range(m.nbody): print(i,m.body(i).name,m.body_mass[i])\r\nprint('plugins',[m.plugin(i).n"]
[45.092419, "o", "ame for i in range(m.nplugin)])\r\nPY\r\n```\r\n\u001b[32m⠼\u001b[0m Waiting for the LM to respond..."]
