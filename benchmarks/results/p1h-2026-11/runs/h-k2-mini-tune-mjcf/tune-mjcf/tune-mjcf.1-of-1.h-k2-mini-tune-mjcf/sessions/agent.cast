[65.479016, "o", "\r\u001b[2K```\r\ncd /app && python - <<'PY'\r\nimport mujoco, numpy as np, time\r\nm=mujoco.MjModel.from_xml_path('model_ref.xml'); d=mujoco.MjData(m)\r\nrng=np.random.default_rng(0); d.qpos += rng.normal(0,0.01,size=d.qpos.shape); mujoco.mj_forward(m,d)\r\nfuncs=['mj_fwdPosition','mj_fwdVelocity','mj_fwdActuation','mj_fwdAcceleration','mj_fwdConstraint','mj_Euler','mj_step1','mj_step2','mj_step','mj_forward']\r\nfor f in funcs:\r\n fn=getattr(mujoco,f); t=time.perf_counter()\r\n for i in range(1000): fn(m,d)\r\n print(f,time.perf_counter()-t)\r\nPY\r\n```\r\n\u001b[32m⠏\u001b[0m Waiting for the LM to respond..."]
[65.479333, "o", "\r\u001b[2K\u001b[32m⠏\u001b[0m Waiting for the LM to respond...\r\n\u001b[?25h\r\u001b[1A\u001b[2K"]
