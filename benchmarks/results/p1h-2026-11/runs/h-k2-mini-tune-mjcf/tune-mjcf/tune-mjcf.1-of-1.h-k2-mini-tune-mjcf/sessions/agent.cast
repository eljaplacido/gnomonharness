[179.417395, "o", "\r\u001b[2K```\r\ncd /app && python - <<'PY'\r\nimport mujoco, numpy as np, time, hashlib\r\nfull=mujoco.mjtState.mjSTATE_FULLPHYSICS\r\nmr=mujoco.MjModel.from_xml_path('model_ref.xml')\r\nmm=mujoco.MjModel.from_xml_path('model.xml')\r\ndef sim(m,seed):\r\n d=mujoco.MjData(m)\r\n rng=np.random.default_rng(seed)\r\n d.qpos += rng.normal(0,0.01,size=d.qpos.shape)\r\n mujoco.mj_forward(m,d)\r\n for _ in range(int(2.0/m.opt.timestep)):\r\n  mujoco.mj_step(m,d)\r\n s=np.zeros(mujoco.mj_stateSize(m,full)); mujoco.mj_getState(m,d,s,full)\r\n return s\r\nmx=0.0; worst=None; nonfinite=0\r\nfor seed in range(100):\r\n a=sim(mr,seed); b=sim(mm,seed)\r\n if not np.isfinite(b).all(): nonfinite+=1; continue\r\n m=np.max(np.abs(a-b))\r\n if m>mx: mx=m; worst=seed\r\nprint('100 seeds: max elementwise abs diff = %.3e at seed %s, nonfinite=%d' % (mx,worst,nonfinite))\r\nprint('ref sha256',hashlib.sha256(open('model_ref.xml','rb').read()).hexdigest())\r\nprint('model.xml option line:', [l.strip() for l in open('model.xml') if '<option' in l])\r\nPY\r\n```\r\n\u001b[32m⠏\u001b[0m Waiting for t"]
