[76.137219, "o", "\r\u001b[2K\r\n\u001b[1;31mmini-swe-agent\u001b[0m\u001b[31m (step \u001b[0m\u001b[1;31m7\u001b[0m\u001b[31m, \u001b[0m\u001b[1;31m$0.00\u001b[0m\u001b[31m):\u001b[0m\r\n\u001b[32m⠏\u001b[0m Waiting for the LM to respond..."]
[76.138007, "o", "\r\u001b[2K```\r\ncd /app && python - <<'PY'\r\nimport mujoco, numpy as np, time, itertools\r\nxml='model_ref.xml'\r\nfull=mujoco.mjtState.mjSTATE_FULLPHYSICS\r\ndef sim(m, seed=1234):\r\n d=mujoco.MjData(m)\r\n rng=np.random.default_rng(seed); d.qpos += rng.normal(0,0.01,size=d.qpos.shape)\r\n mujoco.mj_forward(m,d)\r\n t=time.perf_counter()\r\n for _ in range(int(2.0/m.opt.timestep)):\r\n  mujoco.mj_step(m,d)\r\n dt=time.perf_counter()-t\r\n s=np.zeros(mujoco.mj_stateSize(m,full)); mujoco.mj_getState(m,d,s,full)\r\n return s,dt,d\r\n# ref\r\nmr=mujoco.MjModel.from_xml_path(xml); sr,tr,dr=sim(mr)\r\nprint('ref',tr,'solver',mr.opt.solver,'jac',mr.opt.jacobian)\r\nresults=[]\r\nfor solver in [mujoco.mjtSolver.mjSOL_PGS,mujoco.mjtSolver.mjSOL_CG,mujoco.mjtSolver.mjSOL_NEWTON]:\r\n for jac in [mujoco.mjtJacobian.mjJAC_DENSE,mujoco.mjtJacobian.mjJAC_SPARSE,mujoco.mjtJacobian.mjJAC_AUTO]:\r\n  m=mujoco.MjModel.from_xml_path(xml)\r\n  m.opt.solver=solver; m.opt.jacobian=jac\r\n  try:\r\n   s,t,d=sim(m)\r\n   diff=np.linalg.norm(s-sr)\r\n   mx=np.max(np.abs(s-sr))\r\n   prin"]
[76.138029, "o", "t('solver',solver,'jac',jac,'time',t,'ratio',t/tr,'diff',diff,'max',mx,'niter',d.solver_niter[0])\r\n   results.append((t,solver,jac,diff,mx))\r\n  except Exception as e:\r\n   print('ERR',solver,jac,e)\r\nprint('best',sorted(results)[:5])\r\nPY\r\n```\r\n\u001b[32m⠏\u001b[0m Waiting for the LM to respond..."]
