[54.963452, "o", "\r\u001b[2K```\r\ncd /app && python - <<'PY'\r\nimport mujoco, numpy as np, time\r\nm=mujoco.MjModel.from_xml_path('model_ref.xml')\r\nd=mujoco.MjData(m)\r\nprint([x for x in dir(d) if 'iter' in x.lower() or 'solver' in x.lower()])\r\n# one sim, collect niter stats\r\nrng=np.random.default_rng(0)\r\nd.qpos += rng.normal(0,0.01,size=d.qpos.shape)\r\nmujoco.mj_forward(m,d)\r\nnit=[]\r\nt=time.perf_counter()\r\nfor i in range(int(2.0/m.opt.timestep)):\r\n    mujoco.mj_step(m,d)\r\n    nit.append(d.solver_niter[0])\r\nprint('time',time.perf_counter()-t,'niter unique',np.unique(nit,return_counts=True),'max',max(nit),'mean',np.mean(nit))\r\nprint('nefc',d.nefc,'ncon',d.ncon)\r\n# sample maybe warning? \r\nPY\r\n```\r\n\u001b[32m⠋\u001b[0m Waiting for the LM to respond...\r\u001b[2K\u001b[32m⠋\u001b[0m Waiting for the LM to respond...\r\n\u001b[?25h\r\u001b[1A\u001b[2K"]
