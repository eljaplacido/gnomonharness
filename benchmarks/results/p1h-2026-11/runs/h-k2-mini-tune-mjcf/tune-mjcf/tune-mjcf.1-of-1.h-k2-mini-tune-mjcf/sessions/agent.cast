[95.781795, "o", "\r\u001b[2K```\r\ncd /app && python - <<'PY'\r\nimport mujoco, numpy as np, time\r\nfull=mujoco.mjtState.mjSTATE_FULLPHYSICS\r\nmodels=[]\r\nfor p in ['model_ref.xml','model.xml']:\r\n m=mujoco.MjModel.from_xml_path(p); models.append(m)\r\ndef sim(m,seed):\r\n d=mujoco.MjData(m)\r\n rng=np.random.default_rng(seed); d.qpos += rng.normal(0,0.01,size=d.qpos.shape)\r\n mujoco.mj_forward(m,d)\r\n for _ in range(int(2.0/m.opt.timestep)): mujoco.mj_step(m,d)\r\n s=np.zeros(mujoco.mj_stateSize(m,full)); mujoco.mj_getState(m,d,s,full)\r\n return s\r\nmx=0.; mxnorm=0.; worst=None\r\nfor seed in range(50):\r\n a=sim(models[0],seed); b=sim(models[1],seed)\r\n if not np.isfinite(b).all(): print('NONFINITE',seed); break\r\n diff=np.abs(a-b); n=np.linalg.norm(a-b); m=diff.max()\r\n if m>mx: mx=m; worst=seed\r\n mxnorm=max(mxnorm,n)\r\n print(seed, 'norm %.3e max %.3e'%(n,m)) if seed<5 else None\r\nprint('FINAL maxabs %.6e maxnorm %.6e worstseed %s'%(mx,mxnorm,worst))\r\nPY\r\n```\r\n\u001b[32m⠦\u001b[0m Waiting for the LM to respond..."]
