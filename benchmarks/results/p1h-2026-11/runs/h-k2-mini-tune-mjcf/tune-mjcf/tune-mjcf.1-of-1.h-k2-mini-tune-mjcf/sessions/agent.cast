[123.18494, "o", "\r\u001b[2K\r\n\u001b[1;31mmini-swe-agent\u001b[0m\u001b[31m (step \u001b[0m\u001b[1;31m10\u001b[0m\u001b[31m, \u001b[0m\u001b[1;31m$0.00\u001b[0m\u001b[31m):\u001b[0m\r\n\u001b[32m⠧\u001b[0m Waiting for the LM to respond..."]
[123.18542, "o", "\r\u001b[2K```\r\ncd /app && python - <<'PY'\r\nimport mujoco, numpy as np, time\r\nfull=mujoco.mjtState.mjSTATE_FULLPHYSICS\r\ndef sim(m,seed=5):\r\n d=mujoco.MjData(m); rng=np.random.default_rng(seed); d.qpos += rng.normal(0,0.01,size=d.qpos.shape); mujoco.mj_forward(m,d)\r\n t=time.perf_counter()\r\n for _ in range(1000): mujoco.mj_step(m,d)\r\n dt=time.perf_counter()-t\r\n s=np.zeros(mujoco.mj_stateSize(m,full)); mujoco.mj_getState(m,d,s,full)\r\n return s,dt,d\r\nmr=mujoco.MjModel.from_xml_path('model_ref.xml'); sr,tr,dr=sim(mr)\r\nprint('ref',tr)\r\nconfigs=[]\r\nfor solver in ['PGS','CG','NEWTON']:\r\n for tol in [1e-8,1e-10,1e-12,0.0]:\r\n  for it in [1,2,4,10,100]:\r\n   configs.append((solver,tol,it))\r\nfor solver,tol,it in configs:\r\n m=mujoco.MjModel.from_xml_path('model_ref.xml')\r\n m.opt.solver=getattr(mujoco.mjtSolver,'mjSOL_'+solver); m.opt.jacobian=mujoco.mjtJacobian.mjJAC_DENSE\r\n m.opt.tolerance=tol; m.opt.iterations=it\r\n try:\r\n  s,t,d=sim(m)\r\n  diff=np.abs(s-sr); print(f'{solver:6s} tol={tol:.0e} it={it:3d} t={t:.4f} r={t/tr:.3f} ni"]
[123.185446, "o", "ter={d.solver_niter[0]:3d} max={diff.max():.2e} \r\nnorm={np.linalg.norm(diff):.2e} finite={np.isfinite(s).all()}')\r\n except Exception as e: print('ERR',solver,tol,it,e)\r\nPY\r\n```\r\n\u001b[32m⠧\u001b[0m Waiting for the LM to respond..."]
