cd /app && python - <<'PY'
import mujoco, numpy as np, time, hashlib
full=mujoco.mjtState.mjSTATE_FULLPHYSICS
mr=mujoco.MjModel.from_xml_path('model_ref.xml')
mm=mujoco.MjModel.from_xml_path('model.xml')
def sim(m,seed):
 d=mujoco.MjData(m)
 rng=np.random.default_rng(seed)
 d.qpos += rng.normal(0,0.01,size=d.qpos.shape)
 mujoco.mj_forward(m,d)
 for _ in range(int(2.0/m.opt.timestep)):
  mujoco.mj_step(m,d)
 s=np.zeros(mujoco.mj_stateSize(m,full)); mujoco.mj_getState(m,d,s,full)
 return s
mx=0.0; worst=None; nonfinite=0
for seed in range(100):
 a=sim(mr,seed); b=sim(mm,seed)
 if not np.isfinite(b).all(): nonfinite+=1; continue
 m=np.max(np.abs(a-b))
 if m>mx: mx=m; worst=seed
print('100 seeds: max elementwise abs diff = %.3e at seed %s, nonfinite=%d' % (mx,worst,nonfinite))
print('ref sha256',hashlib.sha256(open('model_ref.xml','rb').read()).hexdigest())
print('model.xml option line:', [l.strip() for l in open('model.xml') if '<option' in l])
