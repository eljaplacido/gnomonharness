import mujoco, numpy as np, time
full=mujoco.mjtState.mjSTATE_FULLPHYSICS
def sim(m,seed=5):
 d=mujoco.MjData(m); rng=np.random.default_rng(seed); d.qpos += rng.normal(0,0.01,size=d.qpos.shape); mujoco.mj_forward(m,d)
 t=time.perf_counter()
 for _ in range(1000): mujoco.mj_step(m,d)
 dt=time.perf_counter()-t
 s=np.zeros(mujoco.mj_stateSize(m,full)); mujoco.mj_getState(m,d,s,full)
 return s,dt,d
mr=mujoco.MjModel.from_xml_path('model_ref.xml'); sr,tr,dr=sim(mr)
print('ref',tr)
configs=[]
for solver in ['PGS','CG','NEWTON']:
 for tol in [1e-8,1e-10,1e-12,0.0]:
  for it in [1,2,4,10,100]:
   configs.append((solver,tol,it))
for solver,tol,it in configs:
 m=mujoco.MjModel.from_xml_path('model_ref.xml')
 m.opt.solver=getattr(mujoco.mjtSolver,'mjSOL_'+solver); m.opt.jacobian=mujoco.mjtJacobian.mjJAC_DENSE
 m.opt.tolerance=tol; m.opt.iterations=it
 try:
  s,t,d=sim(m)
  diff=np.abs(s-sr); print(f'{solver:6s} tol={tol:.0e} it={it:3d} t={t:.4f} r={t/tr:.3f} niter={d.solver_niter[0]:3d} max={diff.max():.2e} 
norm={np.linalg.norm(diff):.2e} finite={np.isfinite(s).all()}')
 except Exception as e: print('ERR',solver,tol,it,e)
