import mujoco, numpy as np, time
m=mujoco.MjModel.from_xml_path('model_ref.xml')
d=mujoco.MjData(m)
print([x for x in dir(d) if 'iter' in x.lower() or 'solver' in x.lower()])
# one sim, collect niter stats
rng=np.random.default_rng(0)
d.qpos += rng.normal(0,0.01,size=d.qpos.shape)
mujoco.mj_forward(m,d)
nit=[]
t=time.perf_counter()
for i in range(int(2.0/m.opt.timestep)):
    mujoco.mj_step(m,d)
    nit.append(d.solver_niter[0])
print('time',time.perf_counter()-t,'niter unique',np.unique(nit,return_counts=True),'max',max(nit),'mean',np.mean(nit))
print('nefc',d.nefc,'ncon',d.ncon)
# sample maybe warning? 
