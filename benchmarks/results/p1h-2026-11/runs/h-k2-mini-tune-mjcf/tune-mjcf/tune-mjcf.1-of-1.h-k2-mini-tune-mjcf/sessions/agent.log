cd /app && python - <<'PY'
import mujoco, numpy as np, time
full=mujoco.mjtState.mjSTATE_FULLPHYSICS
models=[]
for p in ['model_ref.xml','model.xml']:
 m=mujoco.MjModel.from_xml_path(p); models.append(m)
def sim(m,seed):
 d=mujoco.MjData(m)
 rng=np.random.default_rng(seed); d.qpos += rng.normal(0,0.01,size=d.qpos.shape)
 mujoco.mj_forward(m,d)
 for _ in range(int(2.0/m.opt.timestep)): mujoco.mj_step(m,d)
 s=np.zeros(mujoco.mj_stateSize(m,full)); mujoco.mj_getState(m,d,s,full)
 return s
mx=0.; mxnorm=0.; worst=None
for seed in range(50):
 a=sim(models[0],seed); b=sim(models[1],seed)
 if not np.isfinite(b).all(): print('NONFINITE',seed); break
 diff=np.abs(a-b); n=np.linalg.norm(a-b); m=diff.max()
 if m>mx: mx=m; worst=seed
 mxnorm=max(mxnorm,n)
 print(seed, 'norm %.3e max %.3e'%(n,m)) if seed<5 else None
print('FINAL maxabs %.6e maxnorm %.6e worstseed %s'%(mx,mxnorm,worst))
