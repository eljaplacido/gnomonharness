cd /app && python - <<'PY'
import mujoco, numpy as np, time, itertools
xml='model_ref.xml'
full=mujoco.mjtState.mjSTATE_FULLPHYSICS
def sim(m, seed=1234):
 d=mujoco.MjData(m)
 rng=np.random.default_rng(seed); d.qpos += rng.normal(0,0.01,size=d.qpos.shape)
 mujoco.mj_forward(m,d)
 t=time.perf_counter()
 for _ in range(int(2.0/m.opt.timestep)):
  mujoco.mj_step(m,d)
 dt=time.perf_counter()-t
 s=np.zeros(mujoco.mj_stateSize(m,full)); mujoco.mj_getState(m,d,s,full)
 return s,dt,d
# ref
mr=mujoco.MjModel.from_xml_path(xml); sr,tr,dr=sim(mr)
print('ref',tr,'solver',mr.opt.solver,'jac',mr.opt.jacobian)
results=[]
for solver in [mujoco.mjtSolver.mjSOL_PGS,mujoco.mjtSolver.mjSOL_CG,mujoco.mjtSolver.mjSOL_NEWTON]:
 for jac in [mujoco.mjtJacobian.mjJAC_DENSE,mujoco.mjtJacobian.mjJAC_SPARSE,mujoco.mjtJacobian.mjJAC_AUTO]:
  m=mujoco.MjModel.from_xml_path(xml)
  m.opt.solver=solver; m.opt.jacobian=jac
  try:
   s,t,d=sim(m)
   diff=np.linalg.norm(s-sr)
   mx=np.max(np.abs(s-sr))
   print('solver',solver,'jac',jac,'time',t,'ratio',t/tr,'diff',diff,'max',mx,'niter',d.solver_niter[0])
   results.append((t,solver,jac,diff,mx))
  except Exception as e:
   print('ERR',solver,jac,e)
print('best',sorted(results)[:5])
