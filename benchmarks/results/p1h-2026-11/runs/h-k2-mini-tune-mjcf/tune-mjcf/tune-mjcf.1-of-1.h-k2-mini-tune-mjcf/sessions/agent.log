import cProfile,pstats,io,mujoco,numpy as np
m=mujoco.MjModel.from_xml_path('model_ref.xml'); d=mujoco.MjData(m)
rng=np.random.default_rng(0); d.qpos += rng.normal(0,0.01,size=d.qpos.shape); mujoco.mj_forward(m,d)
def run():
 for i in range(1000): mujoco.mj_step(m,d)
pr=cProfile.Profile(); pr.enable(); run(); pr.disable()
s=io.StringIO(); pstats.Stats(pr,stream=s).sort_stats('cumtime').print_stats(40); print(s.getvalue())
