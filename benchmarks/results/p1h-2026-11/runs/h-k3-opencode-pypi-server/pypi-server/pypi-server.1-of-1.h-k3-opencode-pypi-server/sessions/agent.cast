[118.459669, "o", "\u001b[0m← \u001b[0mEdit pypi_server.py\r\nIndex: pypi_server.py\r\n===================================================================\r\n--- pypi_server.py\r\n+++ pypi_server.py\r\n@@ -99,9 +99,9 @@\r\n         self._hash_cache[path] = (stat.st_mtime_ns, value)\r\n         return value\r\n \r\n \r\n-def make_handler(index: PackageIndex, dist_dir: Path):\r\n+def make_handler(index: PackageIndex):\r\n     class SimpleHandler(BaseHTTPRequestHandler):\r\n         server_version = \"vectorops-pypi/1.0\"\r\n         protocol_version = \"HTTP/1.1\"\r\n \r\n\r\n"]
[118.489273, "o", "\u001b[0m← \u001b[0mEdit pypi_server.py\r\nIndex: pypi_server.py\r\n===================================================================\r\n--- pypi_server.py\r\n+++ pypi_server.py\r\n@@ -257,9 +257,9 @@\r\n     index = PackageIndex(dist_dir)\r\n     if not index.projects:\r\n         print(f\"warning: no distributions found in {dist_dir}\", file=sys.stderr)\r\n \r\n-    handler = make_handler(index, dist_dir)\r\n+    handler = make_handler(index)\r\n     server = ThreadingHTTPServer((args.host, args.port), handler)\r\n     server.daemon_threads = True\r\n \r\n     if args.pid_file:\r\n\r\n"]
