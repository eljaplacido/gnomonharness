[113.555187, "o", "\u001b[0m$ \u001b[0mcd /app && python3 - <<'PY'\r\nimport hashlib, re, urllib.request\r\npage = urllib.request.urlopen(\"http://localhost:8080/simple/vectorops/\").read().decode()\r\nfor m in re.finditer(r'href=\"([^\"#]+)#sha256=([0-9a-f]+)\"', page):\r\n    path, digest = m.groups()\r\n    data = urllib.request.urlopen(\"http://localhost:8080\" + path).read()\r\n    actual = hashlib.sha256(data).hexdigest()\r\n    print(path, \"hash ok\" if actual == digest else \"HASH MISMATCH\")\r\nPY\r\n/packages/vectorops-0.1.0-py3-none-any.whl hash ok\r\n/packages/vectorops-0.1.0.tar.gz hash ok\r\n"]
