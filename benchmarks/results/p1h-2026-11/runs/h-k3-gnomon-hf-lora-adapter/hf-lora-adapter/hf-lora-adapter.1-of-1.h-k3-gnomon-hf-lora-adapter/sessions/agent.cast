[21.871257, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[21.871314, "o", "Expected output format in detection_results.json:\r\n\u001b[?2004l\r\u001b[?2004h> ```json\r\n\u001b[?2004l\r\u001b[?2004h> [\r\n\u001b[?2004l\r\u001b[?2004h>   {\r\n\u001b[?2004l\r"]
[21.871345, "o", "\u001b[?2004h> "]
[21.87137, "o", "    \"text\": \"input text\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[21.87139, "o", "    \"predicted_class_id\": 0,\r\n\u001b[?2004l\r\u001b[?2004h"]
[21.871415, "o", ">     \"confidence\": 0.95\r\n\u001b[?2004l\r"]
[21.871442, "o", "\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> ]\r\n\u001b[?2004l\r"]
