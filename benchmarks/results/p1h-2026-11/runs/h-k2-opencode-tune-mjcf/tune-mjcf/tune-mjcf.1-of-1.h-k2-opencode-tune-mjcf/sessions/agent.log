import mujoco, numpy as np, time
base=open('model_ref.xml').read()
def variant(name, opt):
    s=base.replace('</mujoco>', f'<option {opt}/></mujoco>')
    open(name,'w').write(s)

configs={
 'v_dense.xml':'jacobian="dense"',
 'v_cg.xml':'solver="CG"',
 'v_dense_cg.xml':'jacobian="dense" solver="CG"',
 'v_dense_cg_it10.xml':'jacobian="dense" solver="CG" iterations="10" tolerance="1e-8"',
 'v_pgs.xml':'solver="PGS"',
 'v_dense_pgs.xml':'jacobian="dense" solver="PGS"',
}
for n,o in configs.items(): variant(n,o)

def sim(path, seed=3, nstep=1000):
    m=mujoco.MjModel.from_xml_path(path); d=mujoco.MjData(m)
    rng=np.random.default_rng(seed); d.qpos += rng.normal(0,0.01,size=d.qpos.shape)
    mujoco.mj_forward(m,d)
    t0=time.perf_counter()
    for _ in range(nstep): mujoco.mj_step(m,d)
    t=time.perf_counter()-t0
    st=np.zeros(mujoco.mj_stateSize(m,mujoco.mjtState.mjSTATE_FULLPHYSICS))
    mujoco.mj_getState(m,d,st,mujoco.mjtState.mjSTATE_FULLPHYSICS)
    return t,st,m,d
tr,sr,mr,dr=sim('model_ref.xml')
print('ref',tr)
for p in configs:
    t,s,m,d=sim(p)
    print(f'{p:24s} time {t:.4f} ratio {t/tr:.3f} maxdiff {np.abs(s-sr).max():.2e} niter {d.solver_niter[0]}')
