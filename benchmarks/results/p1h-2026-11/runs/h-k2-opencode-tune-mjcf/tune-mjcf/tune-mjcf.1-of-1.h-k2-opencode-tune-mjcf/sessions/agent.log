import mujoco, numpy as np, time
base=open('model_ref.xml').read()

def make(name, extra_option='', extra_compiler='', extra_top=''):
    s=base.replace('<compiler autolimits="true"/>','<compiler autolimits="true"%s/>'%extra_compiler)
    s=s.replace('</mujoco>', extra_option+extra_top+'</mujoco>')
    open(name,'w').write(s)

make('v_sparse.xml', '<option jacobian="sparse"/>')
make('v_sparse_cg.xml', '<option jacobian="sparse" solver="CG"/>')
make('v_noact.xml','', '', '')
EOF
cd /app && python - <<'EOF'
import mujoco, numpy as np, time
def sim(path, seed=3, nstep=1000):
    m=mujoco.MjModel.from_xml_path(path); d=mujoco.MjData(m)
    rng=np.random.default_rng(seed); d.qpos += rng.normal(0,0.01,size=d.qpos.shape)
    mujoco.mj_forward(m,d)
    t0=time.perf_counter()
    for _ in range(nstep): mujoco.mj_step(m,d)
    t=time.perf_counter()-t0
    st=np.zeros(mujoco.mj_stateSize(m,mujoco.mjtState.mjSTATE_FULLPHYSICS))
    mujoco.mj_getState(m,d,st,mujoco.mjtState.mjSTATE_FULLPHYSICS)
    return t,st,m
tr,sr,mr=sim('model_ref.xml')
for p in ['v_sparse.xml','v_sparse_cg.xml']:
    t,s,m=sim(p)
    print(p,'time',t,'ratio',t/tr,'maxdiff',np.abs(s-sr).max(),'norm',np.linalg.norm(s-sr),'nnz',mujoco.MjData(m).solver_nnz[0])
