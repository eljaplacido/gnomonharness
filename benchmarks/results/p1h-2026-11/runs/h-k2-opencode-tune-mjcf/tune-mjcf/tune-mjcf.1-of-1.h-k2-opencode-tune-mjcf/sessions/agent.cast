[57.495692, "o", "\u001b[0m$ \u001b[0mcd /app && python - <<'EOF'\r\nimport mujoco, numpy as np, time\r\nprint([x for x in dir(mujoco.mjtJacobian)])\r\nprint('dense',int(mujoco.mjtJacobian.mjJAC_DENSE),'sparse',int(mujoco.mjtJacobian.mjJAC_SPARSE),'auto',int(mujoco.mjtJacobian.mjJAC_AUTO))\r\nm=mujoco.MjModel.from_xml_path('model.xml')\r\nprint('jac',m.opt.jacobian)\r\nprint([x for x in dir(mujoco.MjData) if 'solver' in x.lower() or 'iter' in x.lower()])\r\nprint('state size full',mujoco.mj_stateSize(m,mujoco.mjtState.mjSTATE_FULLPHYSICS))\r\nprint('state spec',mujoco.mjtState.mjSTATE_FULLPHYSICS)\r\nEOF\r\n['__add__', '__and__', '__class__', '__delattr__', '__dir__', '__doc__', '__entries', '__eq__', '__floordiv__', '__format__', '__ge__', '__getattribute__', '__getstate__', '__gt__', '__hash__', '__index__', '__init__', '__init_subclass__', '__int__', '__le__', '__lshift__', '__lt__', '__members__', '__mod__', '__module__', '__mul__', '__ne__', '__neg__', '__new__', '__or__', '__radd__', '__rand__', '__reduce__', '__reduce_ex__', '__repr__', '__rfloordiv"]
