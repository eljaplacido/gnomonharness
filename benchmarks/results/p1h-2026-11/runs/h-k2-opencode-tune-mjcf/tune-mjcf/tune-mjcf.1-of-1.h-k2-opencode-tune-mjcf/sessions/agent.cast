[63.956372, "o", "\u001b[0m$ \u001b[0mcd /app && python - <<'EOF'\r\nimport mujoco, numpy as np, time\r\nbase=open('model_ref.xml').read()\r\n\r\ndef make(name, extra_option='', extra_compiler='', extra_top=''):\r\n    s=base.replace('<compiler autolimits=\"true\"/>','<compiler autolimits=\"true\"%s/>'%extra_compiler)\r\n    s=s.replace('</mujoco>', extra_option+extra_top+'</mujoco>')\r\n    open(name,'w').write(s)\r\n\r\nmake('v_sparse.xml', '<option jacobian=\"sparse\"/>')\r\nmake('v_sparse_cg.xml', '<option jacobian=\"sparse\" solver=\"CG\"/>')\r\nmake('v_noact.xml','', '', '')\r\nEOF\r\ncd /app && python - <<'EOF'\r\nimport mujoco, numpy as np, time\r\ndef sim(path, seed=3, nstep=1000):\r\n    m=mujoco.MjModel.from_xml_path(path); d=mujoco.MjData(m)\r\n    rng=np.random.default_rng(seed); d.qpos += rng.normal(0,0.01,size=d.qpos.shape)\r\n    mujoco.mj_forward(m,d)\r\n    t0=time.perf_counter()\r\n    for _ in range(nstep): mujoco.mj_step(m,d)\r\n    t=time.perf_counter()-t0\r\n    st=np.zeros(mujoco.mj_stateSize(m,mujoco.mjtState.mjSTATE_FULLPHYSICS))\r\n    mujoco.mj_getState(m,d,st,muj"]
[63.956551, "o", "oco.mjtState.mjSTATE_FULLPHYSICS)\r\n    return t,st,m\r\ntr,sr,mr=sim('model_ref.xml')\r\nfor p in ['v_sparse.xml','v_sparse_cg.xml']:\r\n    t,s,m=sim(p)\r\n    print(p,'time',t,'ratio',t/tr,'maxdiff',np.abs(s-sr).max(),'norm',np.linalg.norm(s-sr),'nnz',mujoco.MjData(m).solver_nnz[0])\r\nEOF\r\nv_sparse.xml time 0.2638778969994746 ratio 0.9984451404875827 maxdiff 0.0 norm 0.0 nnz 0\r\nv_sparse_cg.xml time 0.21712888701586053 ratio 0.8215590792770907 maxdiff 2.9838631565581863e-13 norm 6.912712159971883e-13 nnz 0\r\n"]
