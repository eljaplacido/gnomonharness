[94.967225, "o", "\u001b[0m$ \u001b[0mcd /app && python - <<'EOF'\r\nimport mujoco, numpy as np\r\nm=mujoco.MjModel.from_xml_path('model_ref.xml'); d=mujoco.MjData(m)\r\nrng=np.random.default_rng(1); d.qpos += rng.normal(0,0.01,size=d.qpos.shape); mujoco.mj_forward(m,d)\r\nprint('isSparse',mujoco.mj_isSparse(m))\r\nM=d.qM.reshape(m.nv,m.nv)\r\nprint('M nonzero', (M!=0).sum(), 'density', (M!=0).mean())\r\n# print sparsity pattern by blocks\r\nimport sys\r\nnp.set_printoptions(threshold=10000,linewidth=250)\r\nblocks=np.zeros((40,40),dtype=int)\r\nfor i in range(40):\r\n  for j in range(40):\r\n    blocks[i,j]=(M[3*i:3*i+3,3*j:3*j+3]!=0).sum()\r\nprint(blocks)\r\nprint('parent',m.body_parentid[:10])\r\nEOF\r\nisSparse 1\r\nTraceback (most recent call last):\r\n  File \"<stdin>\", line 5, in <module>\r\nValueError: cannot reshape array of size 6904 into shape (118,118)\r\n"]
