[90.572714, "o", "\u001b[0m$ \u001b[0mwhich perf valgrind gprof 2>/dev/null; cd /app && python - <<'EOF'\r\nimport mujoco, numpy as np\r\nprint([x for x in dir(mujoco) if 'sparse' in x.lower() or 'Sparse' in x])\r\nfor p in ['model_ref.xml','v_sparse.xml']:\r\n    m=mujoco.MjModel.from_xml_path(p); d=mujoco.MjData(m)\r\n    rng=np.random.default_rng(1); d.qpos += rng.normal(0,0.01,size=d.qpos.shape); mujoco.mj_forward(m,d)\r\n    for _ in range(10): mujoco.mj_step(m,d)\r\n    print(p,'opt.jac',m.opt.jacobian,'solver_nnz',d.solver_nnz[0],'niter',d.solver_niter[0])\r\nEOF\r\n['mj_isSparse', 'mju_dense2sparse', 'mju_printMatSparse', 'mju_sparse2dense']\r\nmodel_ref.xml opt.jac 2 solver_nnz 20946 niter 1\r\nv_sparse.xml opt.jac 1 solver_nnz 20946 niter 1\r\n"]
