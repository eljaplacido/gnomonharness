[97.713451, "o", "\u001b[0m$ \u001b[0mcd /app && python - <<'EOF'\r\nimport mujoco, numpy as np\r\nm=mujoco.MjModel.from_xml_path('model_ref.xml'); d=mujoco.MjData(m)\r\nrng=np.random.default_rng(1); d.qpos += rng.normal(0,0.01,size=d.qpos.shape); mujoco.mj_forward(m,d)\r\nM=np.zeros((m.nv,m.nv)); mujoco.mj_fullM(m,M,d.qM)\r\nprint('M nonzero',(M!=0).sum(),'of',m.nv**2)\r\nprint('isSparse',mujoco.mj_isSparse(m))\r\n# band structure: max offset\r\nnz=np.argwhere(M!=0)\r\nprint('max |i-j|',np.abs(nz[:,0]-nz[:,1]).max())\r\nprint('parents first',m.body_parentid[:8])\r\nEOF\r\nM nonzero 13690 of 13924\r\nisSparse 1\r\nmax |i-j| 116\r\nparents first [0 0 1 2 3 4 5 6]\r\n"]
