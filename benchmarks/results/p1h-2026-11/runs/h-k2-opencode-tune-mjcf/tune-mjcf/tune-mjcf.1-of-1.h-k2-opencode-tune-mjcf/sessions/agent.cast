[299.119146, "o", "\u001b[0m$ \u001b[0mcd /app && python - <<'EOF'\r\nimport mujoco, numpy as np, time\r\nbase=open('model_ref.xml').read()\r\ncand=base.replace('</mujoco>','<option jacobian=\"dense\" solver=\"PGS\" tolerance=\"1e-12\"/></mujoco>')\r\nopen('v_final_candidate.xml','w').write(cand)\r\n\r\ndef sim(path, seed, want_data=False):\r\n    m=mujoco.MjModel.from_xml_path(path); d=mujoco.MjData(m)\r\n    rng=np.random.default_rng(seed); d.qpos += rng.normal(0,0.01,size=d.qpos.shape)\r\n    mujoco.mj_forward(m,d)\r\n    for _ in range(int(2.0/m.opt.timestep)): mujoco.mj_step(m,d)\r\n    st=np.zeros(mujoco.mj_stateSize(m,mujoco.mjtState.mjSTATE_FULLPHYSICS))\r\n    mujoco.mj_getState(m,d,st,mujoco.mjtState.mjSTATE_FULLPHYSICS)\r\n    return (st,d,m) if want_data else st\r\n\r\nm=mujoco.MjModel.from_xml_path('v_final_candidate.xml')\r\nprint('opt',m.opt.jacobian,m.opt.solver,m.opt.tolerance)\r\n# many seeds\r\nseeds=list(range(1000,1200))\r\nmx=0; bad=0\r\nfor s in seeds:\r\n    a=sim('v_final_candidate.xml',s); b=sim('model_ref.xml',s)\r\n    diff=np.abs(a-b).max(); mx=max(mx,diff)\r"]
[299.119177, "o", "\n    if not (np.allclose(a,b,atol=1e-5) and np.isfinite(a).all()): bad+=1\r\nprint('200 seeds: maxdiff',mx,'bad',bad)\r\n\r\n# timing like eval\r\ndef timing(path,n=20):\r\n    ts=[]\r\n    for _ in range(n):\r\n        s=int(np.random.randint(0,10000)); t0=time.perf_counter(); sim(path,s); ts.append(time.perf_counter()-t0)\r\n    return np.array(ts)\r\nfor rep in range(3):\r\n    tc=timing('v_final_candidate.xml'); tr=timing('model_ref.xml')\r\n    print('rep',rep,'cand',tc.mean(),'ref',tr.mean(),'ratio',(tc/tr).mean())\r\n# timers\r\n_,d,_=sim('v_final_candidate.xml',123,want_data=True)\r\nprint('timers us/step:')\r\nnames=['STEP','FORWARD','INVERSE','POSITION','VELOCITY','ACTUATION','CONSTRAINT','ADVANCE','POS_KINEMATICS','POS_INERTIA','POS_COLLISION','POS_MAKE','POS_PROJECT','COL_BROAD','COL_NARROW']\r\nfor i,n in enumerate(names):\r\n    t=d.timer[i]\r\n    print(f'  {n:16s} {t.duration/t.number*1e6 if t.number else 0:8.2f}')\r\nprint('niter',d.solver_niter[0])\r\nEOF\r\nopt 0 0 1e-12\r\n200 seeds: maxdiff 4.3837395057727546e-08 bad 0\r\nrep 0 cand "]
