[39.181383, "o", "\u001b[0m$ \u001b[0mcd /app && python - <<'EOF'\r\nimport mujoco, numpy as np\r\nm=mujoco.MjModel.from_xml_path('model.xml')\r\nd=mujoco.MjData(m)\r\nprint('nbody',m.nbody,'njnt',m.njnt,'ngeom',m.ngeom,'neq',m.neq,'nv',m.nv,'nq',m.nq)\r\nprint('opt',m.opt.timestep, 'integrator',m.opt.integrator, 'solver',m.opt.solver,'iterations',m.opt.iterations,'tolerance',m.opt.tolerance,'ls_iterations',m.opt.ls_iterations)\r\nprint('jacobian',m.opt.jacobian,'cone',m.opt.cone,'impratio',m.opt.impratio)\r\nprint('joint types',np.unique(m.jnt_type,return_counts=True))\r\nprint('jnt qposadr',m.jnt_qposadr[:5],'dofadr',m.jnt_dofadr[:5])\r\nprint('geom condim',np.unique(m.geom_condim,return_counts=True))\r\nprint('geom contype',np.unique(m.geom_contype),np.unique(m.geom_conaffinity))\r\nprint('body names', [m.body(i).name for i in range(min(5,m.nbody))], m.body(m.nbody-1).name)\r\nprint('neq',m.eq_type, m.eq_obj1id, m.eq_obj2id, m.eq_data[:neq] if (neq:=m.neq) else '')\r\nprint('memory',m.narena)\r\nprint('body mass range',m.body_mass[1:].min(),m.body_mass[1:].max("]
