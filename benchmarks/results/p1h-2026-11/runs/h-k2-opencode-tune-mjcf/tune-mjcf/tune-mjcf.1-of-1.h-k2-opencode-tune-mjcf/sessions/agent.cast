[42.550326, "o", "\u001b[0m$ \u001b[0mcd /app && python - <<'EOF'\r\nimport mujoco, numpy as np, time\r\nm=mujoco.MjModel.from_xml_path('model.xml')\r\nd=mujoco.MjData(m)\r\nrng=np.random.default_rng(0)\r\nd.qpos += rng.normal(0,0.01,size=d.qpos.shape)\r\nmujoco.mj_forward(m,d)\r\nprint('ncon initial', d.ncon)\r\nmx=0\r\nt0=time.perf_counter()\r\nfor i in range(1000):\r\n    mujoco.mj_step(m,d)\r\n    mx=max(mx,d.ncon)\r\nprint('time per step us',(time.perf_counter()-t0)/1000*1e6,'max ncon',mx)\r\nprint('nefc',d.nefc,'solver iters?',d.solver_iter if hasattr(d,'solver_iter') else None)\r\nprint('qvel max',np.abs(d.qvel).max(),'qpos range',d.qpos.min(),d.qpos.max())\r\nEOF\r\nncon initial 0\r\ntime per step us 264.69899399671704 max ncon 0\r\nnefc 3 solver iters? None\r\nqvel max 0.06640154679240827 qpos range -0.5239041205955899 0.9999982189721367\r\n"]
