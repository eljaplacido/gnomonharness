[47.860462, "o", "\u001b[0m$ \u001b[0mcd /app && python - <<'EOF'\r\nimport mujoco, numpy as np, time\r\nm=mujoco.MjModel.from_xml_path('model.xml')\r\nd=mujoco.MjData(m)\r\nrng=np.random.default_rng(0)\r\nd.qpos += rng.normal(0,0.01,size=d.qpos.shape)\r\nmujoco.mj_forward(m,d)\r\nN=2000\r\ndef bench(fn,label):\r\n    t0=time.perf_counter()\r\n    for _ in range(N): fn()\r\n    print(label,(time.perf_counter()-t0)/N*1e6,'us')\r\nbench(lambda: mujoco.mj_step1(m,d),'step1')\r\n# continue state\r\nbench(lambda: mujoco.mj_step2(m,d),'step2')\r\nbench(lambda: mujoco.mj_step(m,d),'step full')\r\nbench(lambda: mujoco.mj_forward(m,d),'forward')\r\nbench(lambda: mujoco.mj_kinematics(m,d),'kinematics')\r\nbench(lambda: mujoco.mj_comPos(m,d),'comPos')\r\nbench(lambda: mujoco.mj_crb(m,d),'crb')\r\nbench(lambda: mujoco.mj_factorM(m,d),'factorM')\r\nbench(lambda: mujoco.mj_solveM(m,d,d.qacc),'solveM')\r\nbench(lambda: mujoco.mj_fwdPosition(m,d),'fwdPosition')\r\nbench(lambda: mujoco.mj_fwdVelocity(m,d),'fwdVelocity')\r\nbench(lambda: mujoco.mj_fwdActuation(m,d),'fwdActuation')\r\nbench(lambda: mujoc"]
