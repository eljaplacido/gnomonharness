[120.151704, "o", "\u001b[0m$ \u001b[0mcd /app && python - <<'EOF'\r\nimport mujoco, numpy as np, time\r\nbase=open('model_ref.xml').read()\r\ndef variant(name, opt):\r\n    s=base.replace('</mujoco>', f'<option {opt}/></mujoco>')\r\n    open(name,'w').write(s)\r\n\r\nconfigs={\r\n 'v_dense.xml':'jacobian=\"dense\"',\r\n 'v_cg.xml':'solver=\"CG\"',\r\n 'v_dense_cg.xml':'jacobian=\"dense\" solver=\"CG\"',\r\n 'v_dense_cg_it10.xml':'jacobian=\"dense\" solver=\"CG\" iterations=\"10\" tolerance=\"1e-8\"',\r\n 'v_pgs.xml':'solver=\"PGS\"',\r\n 'v_dense_pgs.xml':'jacobian=\"dense\" solver=\"PGS\"',\r\n}\r\nfor n,o in configs.items(): variant(n,o)\r\n\r\ndef sim(path, seed=3, nstep=1000):\r\n    m=mujoco.MjModel.from_xml_path(path); d=mujoco.MjData(m)\r\n    rng=np.random.default_rng(seed); d.qpos += rng.normal(0,0.01,size=d.qpos.shape)\r\n    mujoco.mj_forward(m,d)\r\n    t0=time.perf_counter()\r\n    for _ in range(nstep): mujoco.mj_step(m,d)\r\n    t=time.perf_counter()-t0\r\n    st=np.zeros(mujoco.mj_stateSize(m,mujoco.mjtState.mjSTATE_FULLPHYSICS))\r\n    mujoco.mj_getState(m,d,st,mujoco.mjtState.mjSTATE_FULLP"]
[120.151734, "o", "HYSICS)\r\n    return t,st,m,d\r\ntr,sr,mr,dr=sim('model_ref.xml')\r\nprint('ref',tr)\r\nfor p in configs:\r\n    t,s,m,d=sim(p)\r\n    print(f'{p:24s} time {t:.4f} ratio {t/tr:.3f} maxdiff {np.abs(s-sr).max():.2e} niter {d.solver_niter[0]}')\r\nEOF\r\nref 0.27739655997720547\r\nv_dense.xml              time 0.2243 ratio 0.809 maxdiff 4.92e-15 niter 1\r\nv_cg.xml                 time 0.2171 ratio 0.783 maxdiff 2.98e-13 niter 4\r\nv_dense_cg.xml           time 0.2128 ratio 0.767 maxdiff 1.74e-13 niter 4\r\nv_dense_cg_it10.xml      time 0.2132 ratio 0.769 maxdiff 1.74e-13 niter 4\r\nv_pgs.xml                time 0.1317 ratio 0.475 maxdiff 7.08e-07 niter 3\r\nv_dense_pgs.xml          time 0.1218 ratio 0.439 maxdiff 7.08e-07 niter 3\r\n"]
[121.369995, "o", "> build · deepseek-v4.1-flash\r\n"]
[143.569288, "o", "\u001b[0m$ \u001b[0mcd /app && python - <<'EOF'\r\nimport mujoco, numpy as np, time\r\nbase=open('model_ref.xml').read()\r\ndef variant(name, opt):\r\n    open(name,'w').write(base.replace('</mujoco>', f'<option {opt}/></mujoco>'))\r\nvariant('v_pgs_dense_tol.xml','jacobian=\"dense\" solver=\"PGS\" tolerance=\"1e-12\"')\r\nvariant('v_pgs_dense_it50.xml','jacobian=\"dense\" solver=\"PGS\" iterations=\"50\" tolerance=\"1e-12\"')\r\n\r\ndef sim(path, seed):\r\n    m=mujoco.MjModel.from_xml_path(path); d=mujoco.MjData(m)\r\n    rng=np.random.default_rng(seed); d.qpos += rng.normal(0,0.01,size=d.qpos.shape)\r\n    mujoco.mj_forward(m,d)\r\n    for _ in range(int(2.0/m.opt.timestep)): mujoco.mj_step(m,d)\r\n    st=np.zeros(mujoco.mj_stateSize(m,mujoco.mjtState.mjSTATE_FULLPHYSICS))\r\n    mujoco.mj_getState(m,d,st,mujoco.mjtState.mjSTATE_FULLPHYSICS)\r\n    return st\r\n\r\nseeds=list(range(300,360))\r\nrefs={s:sim('model_ref.xml',s) for s in seeds}\r\nfor p in ['v_pgs_dense.xml','v_pgs_dense_tol.xml','v_pgs_dense_it50.xml']:\r\n    diffs=[]\r\n    for s in seeds:\r\n        st=sim"]
[143.569393, "o", "(p,s)\r\n        diffs.append(np.abs(st-refs[s]).max())\r\n    diffs=np.array(diffs)\r\n    print(p,'max',diffs.max(),'mean',diffs.mean(),'p95',np.percentile(diffs,95),'fail>1e-5',(diffs>1e-5).sum())\r\nEOF\r\nTraceback (most recent call last):\r\n  File \"<stdin>\", line 22, in <module>\r\n  File \"<stdin>\", line 9, in sim\r\nValueError: ParseXML: Error opening file 'v_pgs_dense.xml': No such file or directory\r\n"]
