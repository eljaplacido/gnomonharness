[456.459362, "o", "\u001b[0m$ \u001b[0mcd /app && python - <<'EOF'\r\nimport mujoco, numpy as np\r\ndef sim(path, seed):\r\n    m=mujoco.MjModel.from_xml_path(path); d=mujoco.MjData(m)\r\n    rng=np.random.default_rng(seed); d.qpos += rng.normal(0,0.01,size=d.qpos.shape)\r\n    mujoco.mj_forward(m,d)\r\n    for _ in range(int(2.0/m.opt.timestep)): mujoco.mj_step(m,d)\r\n    st=np.zeros(mujoco.mj_stateSize(m,mujoco.mjtState.mjSTATE_FULLPHYSICS))\r\n    mujoco.mj_getState(m,d,st,mujoco.mjtState.mjSTATE_FULLPHYSICS)\r\n    return st\r\nmx=0; bad=0\r\nfor s in range(2000,2300):\r\n    a=sim('model.xml',s); b=sim('model_ref.xml',s)\r\n    if not np.isfinite(a).all(): bad+=1\r\n    d=np.abs(a-b).max(); mx=max(mx,d)\r\n    if not np.allclose(a,b,atol=1e-5): bad+=1\r\nprint('300 seeds: max abs diff',mx,'failures',bad)\r\nEOF\r\nrm -f /app/v_*.xml\r\nls -la /app\r\n300 seeds: max abs diff 4.250833942481824e-08 failures 0\r\ntotal 24\r\ndrwxr-xr-x 1 root root 4096 Nov  1 07:00 .\r\ndrwxr-xr-x 1 root root 4096 Nov  1 06:53 ..\r\n-rw-r--r-- 1 root root  120 Nov  1 06:53 MUJOCO_LOG.TXT\r\n-rw-rw-r--"]
[456.459395, "o", " 1 root root 3112 Oct 31 09:48 eval.py\r\n-rw-r--r-- 1 root root 1684 Nov  1 06:58 model.xml\r\n-rw-rw-r-- 1 root root 1254 Oct 31 09:48 model_ref.xml\r\n"]
[457.653764, "o", "> build · deepseek-v4.1-flash\r\n"]
