[27.936028, "o", "\u001b[0m$ \u001b[0mcd /app && python - <<'EOF'\r\nimport mujoco, numpy as np, time\r\nm=mujoco.MjModel.from_xml_path('model_ref.xml')\r\nd=mujoco.MjData(m)\r\nmujoco.mj_forward(m,d)\r\n# time 1000 steps\r\nN=1000\r\nt=time.perf_counter()\r\nfor _ in range(N): mujoco.mj_step(m,d)\r\nt1=time.perf_counter()\r\nprint('step ms', (t1-t)/N*1e3)\r\n# step1/step2 split\r\nd2=mujoco.MjData(m); mujoco.mj_forward(m,d2)\r\nt=time.perf_counter()\r\nfor _ in range(N):\r\n    mujoco.mj_step1(m,d2); mujoco.mj_step2(m,d2)\r\nt2=time.perf_counter()\r\nprint('step1+2 ms',(t2-t)/N*1e3)\r\n# forward only?\r\nt=time.perf_counter()\r\nfor _ in range(N): mujoco.mj_forward(m,d2)\r\nt3=time.perf_counter()\r\nprint('forward ms',(t3-t)/N*1e3)\r\n# check nefc, ncon\r\nprint('nefc',d.nefc,'ncon',d.ncon)\r\nprint('OPTIONS')\r\nprint('solver',m.opt.solver,'jac',m.opt.jacobian,'it',m.opt.iterations)\r\nEOF\r\nstep ms 0.25891244199010544\r\nstep1+2 ms 0.25813837198074907\r\nforward ms 0.21657629701076075\r\nnefc 3 ncon 0\r\nOPTIONS\r\nsolver 2 jac 2 it 100\r\n"]
[28.84023, "o", "> build · deepseek-v4.1-flash\r\n"]
[35.907281, "o", "\u001b[0m$ \u001b[0mcd /app && python - <<'EOF'\r\nimport mujoco, numpy as np, time\r\nm=mujoco.MjModel.from_xml_path('model_ref.xml')\r\nd=mujoco.MjData(m)\r\nmujoco.mj_forward(m,d)\r\nN=2000\r\ndef bench(name, fn):\r\n    t=time.perf_counter()\r\n    for _ in range(N): fn()\r\n    dt=(time.perf_counter()-t)/N*1e3\r\n    print(f'{name:28s} {dt:.4f} ms')\r\nbench('mj_fwdPosition', lambda: mujoco.mj_fwdPosition(m,d))\r\nbench('mj_fwdVelocity', lambda: mujoco.mj_fwdVelocity(m,d))\r\nbench('mj_fwdActuation', lambda: mujoco.mj_fwdActuation(m,d))\r\nbench('mj_fwdAcceleration', lambda: mujoco.mj_fwdAcceleration(m,d))\r\nbench('mj_fwdConstraint', lambda: mujoco.mj_fwdConstraint(m,d))\r\nbench('mj_step', lambda: mujoco.mj_step(m,d))\r\n# tangent/derivatives\r\nbench('mj_forward', lambda: mujoco.mj_forward(m,d))\r\nEOF\r\n"]
[35.907384, "o", "mj_fwdPosition               0.0532 ms\r\nmj_fwdVelocity               0.0105 ms\r\nmj_fwdActuation              0.0004 ms\r\nmj_fwdAcceleration           0.0027 ms\r\nmj_fwdConstraint             0.1496 ms\r\nmj_step                      0.2589 ms\r\nmj_forward                   0.2148 ms\r\n"]
[36.781164, "o", "> build · deepseek-v4.1-flash\r\n"]
[46.854016, "o", "\u001b[0m$ \u001b[0mcd /app && cat > /tmp/exp.py <<'EOF'\r\nimport mujoco, numpy as np, time, re, sys\r\n\r\nREF='model_ref.xml'\r\nFULL=mujoco.mjtState.mjSTATE_FULLPHYSICS\r\n\r\ndef simulate(model, seed, total=2.0):\r\n    d=mujoco.MjData(model)\r\n    nstep=int(total/model.opt.timestep)\r\n    rng=np.random.default_rng(seed)\r\n    d.qpos += rng.normal(0,0.01,size=d.qpos.shape)\r\n    mujoco.mj_forward(model,d)\r\n    for _ in range(nstep): mujoco.mj_step(model,d)\r\n    s=np.zeros(mujoco.mj_stateSize(model,FULL))\r\n    mujoco.mj_getState(model,d,s,FULL)\r\n    return s\r\n\r\nref_model=mujoco.MjModel.from_xml_path(REF)\r\nseeds=list(range(10))\r\nt=time.perf_counter()\r\nref_states={s:simulate(ref_model,s) for s in seeds}\r\nprint('ref gen time',time.perf_counter()-t)\r\n\r\ndef make_xml(opt):\r\n    xml=open(REF).read()\r\n    attrs=' '.join(f'{k}=\"{v}\"' for k,v in opt.items())\r\n    xml=xml.replace('<compiler autolimits=\"true\"/>', '<compiler autolimits=\"true\"/>\\n  <option '+attrs+'/>')\r\n    return xml\r\n\r\ndef test(name, opt, seeds=seeds):\r\n    xml=make_xml(opt)\r\n"]
[46.854279, "o", "    m=mujoco.MjModel.from_xml_path(xml)\r\n    diffs=[]; t=time.perf_counter()\r\n    for s in seeds:\r\n        try:\r\n            st=simulate(m,s)\r\n        except Exception as e:\r\n            print(f'{name:45s} ERROR {e}'); return\r\n        diffs.append(np.max(np.abs(st-ref_states[s])))\r\n    dt=(time.perf_counter()-t)/len(seeds)\r\n    # timing separately on seed 1234 repeated a few\r\n    print(f'{name:45s} maxdiff={max(diffs):.3e} time={dt*1e3:.1f}ms ts={m.opt.timestep}')\r\n\r\ntest('ref', {})\r\nfor it in [1,2,5,10,20,50]:\r\n    test(f'iterations {it}', {'iterations':it})\r\nfor tol in [1e-4,1e-6,1e-7]:\r\n    test(f'tol {tol}', {'tolerance':tol})\r\nfor ls in [5,10,20]:\r\n    test(f'ls {ls}', {'ls_iterations':ls})\r\ntest('jac sparse', {'jacobian':1})\r\ntest('jac auto', {'jacobian':2})\r\nfor sol in [0,1,2]:\r\n    test(f'solver {sol}', {'solver':sol})\r\nfor ts in [0.0025,0.004,0.005,0.01]:\r\n    test(f'timestep {ts}', {'timestep':ts})\r\ntest('implicit', {'integrator':1})\r\ntest('implicitfast', {'integrator':3})\r\nEOF\r\npython /tmp/exp.py\r\n"]
