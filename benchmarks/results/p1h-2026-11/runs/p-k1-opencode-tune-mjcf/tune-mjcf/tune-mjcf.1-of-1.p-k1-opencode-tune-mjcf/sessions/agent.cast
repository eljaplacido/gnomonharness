[447.967193, "o", "\u001b[0m$ \u001b[0mcd /app && cat > /tmp/bench.py <<'EOF'\r\nimport mujoco, numpy as np, time\r\nFULL=mujoco.mjtState.mjSTATE_FULLPHYSICS\r\ndef simulate(model, seed, total=2.0):\r\n    d=mujoco.MjData(model); nstep=int(total/model.opt.timestep)\r\n    rng=np.random.default_rng(seed); d.qpos += rng.normal(0,0.01,size=d.qpos.shape)\r\n    mujoco.mj_forward(model,d)\r\n    for _ in range(nstep): mujoco.mj_step(model,d)\r\n    s=np.zeros(mujoco.mj_stateSize(model,FULL)); mujoco.mj_getState(model,d,s,FULL); return s\r\ndef make_xml(opt):\r\n    xml=open('model_ref.xml').read()\r\n    attrs=' '.join(f'{k}=\"{v}\"' for k,v in opt.items())\r\n    return xml.replace('<compiler autolimits=\"true\"/>', '<compiler autolimits=\"true\"/>\\n  <option '+attrs+'/>')\r\nref=mujoco.MjModel.from_xml_path('model_ref.xml')\r\n\r\ndef timeit(m,n=20):\r\n    ts=[]\r\n    for _ in range(n):\r\n        s=np.random.randint(0,10000); t=time.perf_counter(); simulate(m,s); ts.append(time.perf_counter()-t)\r\n    return np.array(ts)\r\n\r\ncands={\r\n 'PGS tol1e-12 dense':{'solver':'PGS','jacobian"]
[447.967294, "o", "':'dense','tolerance':'1e-12'},\r\n 'PGS tol1e-12 auto':{'solver':'PGS','tolerance':'1e-12'},\r\n 'PGS tol1e-10 dense':{'solver':'PGS','jacobian':'dense','tolerance':'1e-10'},\r\n 'PGS tol1e-8 dense':{'solver':'PGS','jacobian':'dense','tolerance':'1e-8'},\r\n 'PGS tol1e-12 dense it50':{'solver':'PGS','jacobian':'dense','tolerance':'1e-12','iterations':50},\r\n}\r\n# baseline ref times interleaved\r\nfor name,opt in cands.items():\r\n    m=mujoco.MjModel.from_xml_string(make_xml(opt))\r\n    tm=timeit(m); tr=timeit(ref)\r\n    print(f'{name:28s} model={tm.mean()*1e3:.1f}ms ref={tr.mean()*1e3:.1f}ms ratio={tm.mean()/tr.mean():.3f}')\r\n# pure ref\r\ntr=timeit(ref,n=20); print('ref only',tr.mean()*1e3)\r\nEOF\r\npython /tmp/bench.py\r\nPGS tol1e-12 dense           model=122.4ms ref=267.6ms ratio=0.457\r\nPGS tol1e-12 auto            model=132.2ms ref=267.6ms ratio=0.494\r\nPGS tol1e-10 dense           model=123.0ms ref=267.8ms ratio=0.459\r\nPGS tol1e-8 dense            model=123.0ms ref=269.0ms ratio=0.457\r\nPGS tol1e-12 dense it50      model=123."]
