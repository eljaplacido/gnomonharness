[259.963197, "o", "\u001b[0m$ \u001b[0mcd /app && cat > /tmp/exp3.py <<'EOF'\r\nexec(open('/tmp/exp.py').read().split(\"test('ref'\")[0])\r\nseeds2=list(range(100,160))\r\nref2={s:simulate(ref_model,s) for s in seeds2}\r\nprint('ref2 done')\r\ndef test2(name,opt,seeds=seeds2):\r\n    m=mujoco.MjModel.from_xml_string(make_xml(opt))\r\n    diffs=[]\r\n    for s in seeds:\r\n        try: st=simulate(m,s)\r\n        except Exception as e:\r\n            print(name,'ERR',e);return\r\n        diffs.append(np.max(np.abs(st-ref2[s])))\r\n    print(f'{name:55s} maxdiff={max(diffs):.3e} p99={np.percentile(diffs,99):.3e}')\r\ntest2('PGS dense', {'solver':'PGS','jacobian':'dense'})\r\nfor it in [5,10,20,50,100]:\r\n    test2(f'PGS dense it{it}', {'solver':'PGS','jacobian':'dense','iterations':it})\r\nfor tol in ['1e-6','1e-7','1e-8','1e-9','1e-10','1e-12']:\r\n    test2(f'PGS dense tol{tol}', {'solver':'PGS','jacobian':'dense','tolerance':tol})\r\ntest2('CG dense', {'solver':'CG','jacobian':'dense'})\r\ntest2('Newton dense', {'solver':'Newton','jacobian':'dense'})\r\nEOF\r\npython /tmp/exp3.py\r"]
