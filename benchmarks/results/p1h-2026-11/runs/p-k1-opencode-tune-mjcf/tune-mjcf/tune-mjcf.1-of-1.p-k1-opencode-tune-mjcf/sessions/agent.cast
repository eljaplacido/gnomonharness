[18.264133, "o", "\u001b[0m$ \u001b[0mcd /app && python - <<'EOF'\r\nimport mujoco, numpy as np\r\nm=mujoco.MjModel.from_xml_path('model_ref.xml')\r\nprint('nbody',m.nbody,'njnt',m.njnt,'nq',m.nq,'nv',m.nv,'neq',m.neq,'ngeom',m.ngeom,'nu',m.nu)\r\nprint('timestep',m.opt.timestep,'integrator',m.opt.integrator,'solver',m.opt.solver,'it',m.opt.iterations,'lsit',m.opt.ls_iterations,'tol',m.opt.tolerance)\r\nprint('njmax',m.njmax,'nconmax',m.nconmax)\r\nprint('memory',m.narena)\r\nprint('dof damping',m.dof_damping)\r\nprint('body mass',m.body_mass[:5])\r\nprint('opt',m.opt)\r\nEOF\r\nnbody 42 njnt 40 nq 157 nv 118 neq 1 ngeom 41 nu 1\r\ntimestep 0.002 integrator 0 solver 2 it 100 lsit 50 tol 1e-08\r\nnjmax -1 nconmax -1\r\nmemory 2097152\r\ndof damping [0.015 0.015 0.015 0.015 0.015 0.015 0.015 0.015 0.015 0.015 0.015 0.015\r\n 0.015 0.015 0.015 0.015 0.015 0.015 0.015 0.015 0.015 0.015 0.015 0.015\r\n 0.015 0.015 0.015 0.015 0.015 0.015 0.015 0.015 0.015 0.015 0.015 0.015\r\n 0.015 0.015 0.015 0.015 0.015 0.015 0.015 0.015 0.015 0.015 0.015 0.015\r\n 0.015 0.015 0.015 0.015 0.0"]
