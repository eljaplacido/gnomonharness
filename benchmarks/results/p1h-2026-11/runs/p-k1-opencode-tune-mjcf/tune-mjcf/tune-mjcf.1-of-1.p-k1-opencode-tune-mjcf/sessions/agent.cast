[132.647946, "o", "\u001b[0m$ \u001b[0mcd /app && cat > /tmp/exp2.py <<'EOF'\r\nexec(open('/tmp/exp.py').read().split(\"test('ref'\")[0])\r\ntest('jac sparse', {'jacobian':'sparse'})\r\ntest('jac dense', {'jacobian':'dense'})\r\nfor sol in ['PGS','CG','Newton']:\r\n    test(f'solver {sol}', {'solver':sol})\r\nfor ts in [0.0025,0.004,0.005,0.01]:\r\n    test(f'timestep {ts}', {'timestep':ts})\r\ntest('implicit', {'integrator':'implicit'})\r\ntest('implicitfast', {'integrator':'implicitfast'})\r\ntest('rk4', {'integrator':'RK4'})\r\nEOF\r\npython /tmp/exp2.py\r\nref gen time 2.691395523987012\r\njac sparse                                    maxdiff=0.000e+00 time=268.9ms ts=0.002\r\njac dense                                     maxdiff=6.051e-15 time=225.9ms ts=0.002\r\nsolver PGS                                    maxdiff=3.718e-06 time=133.4ms ts=0.002\r\nsolver CG                                     maxdiff=8.142e-06 time=218.2ms ts=0.002\r\nsolver Newton                                 maxdiff=0.000e+00 time=270.7ms ts=0.002\r\ntimestep 0.0025                               m"]
