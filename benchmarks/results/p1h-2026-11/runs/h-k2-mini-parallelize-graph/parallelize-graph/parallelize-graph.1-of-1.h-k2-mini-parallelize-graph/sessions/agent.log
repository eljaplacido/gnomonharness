cat > /app/pgen.upc <<'EOF'
#include <upc.h>
#include <upc_collective.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>

#define MAXK 256
#define LOCK_STRIPES 256

/* Shared scalars used to broadcast the input metadata. */
shared int g_nlines;
shared int g_klen;

/* All per-k-mer arrays below live in the UPC shared heap.  Node ids are
   exactly the input line numbers, which is valid because the input contains
   unique k-mers (and assigning ids this way avoids a serial node allocator). */
shared char *keys;       /* cap * MAXK characters */
shared int  *key_lens;   /* cap */
shared char *left_ext;   /* cap */
shared char *right_ext;  /* cap */
shared int  *next_node;  /* cap; next node in a hash bucket */
shared int  *visited;    /* cap */
shared int  *heads;      /* nbuckets */

static int nbuckets;
static uint32_t bucket_mask;

static upc_lock_t **bucket_locks;

static uint32_t hash_key(const char *key, int klen) {
    uint64_t h = 1469598103934665603ULL;
    for (int i = 0; i < klen; ++i) {
        h ^= (unsigned char)key[i];
        h *= 1099511628211ULL;
    }
    return (uint32_t)((h ^ (h >> 32)) & bucket_mask);
}

static int lookup_key(const char *key, int klen) {
    uint32_t b = hash_key(key, klen);
    for (int i = heads[b]; i >= 0; i = next_node[i]) {
        if (key_lens[i] != klen) continue;
        int same = 1;
        for (int j = 0; j < klen; ++j) {
            if (keys[(long)i * MAXK + j] != key[j]) { same = 0; break; }
        }
        if (same) return i;
    }
    return -1;
}

static void insert_node(int idx) {
    int klen = key_lens[idx];
    char key[MAXK + 1];
    for (int j = 0; j < klen; ++j) key[j] = keys[(long)idx * MAXK + j];
    key[klen] = '\0';

    uint32_t b = hash_key(key, klen);
    upc_lock_t *lock = bucket_locks[b & (LOCK_STRIPES - 1)];
    upc_lock(lock);
    next_node[idx] = heads[b];
    heads[b] = idx;
    upc_unlock(lock);
}

/* Parse "KMER<TAB>LR".  Return 0 for a malformed line. */
static int parse_line(char *line, char *key, int *klen,
                      char *left, char *right) {
    char *tab = strchr(line, '\t');
    if (!tab) return 0;
    *tab = '\0';
    int n = (int)strlen(line);
    if (n <= 0 || n > MAXK) return 0;
    if (tab[1] == '\0' || tab[2] == '\0') return 0;
    memcpy(key, line, (size_t)n);
    key[n] = '\0';
    *klen = n;
    *left = tab[1];
    *right = tab[2];
    return 1;
}

static void emit_contig(FILE *out, int start) {
    int cap = 1024;
    int k = key_lens[start];
    int len = k;
    char *contig = (char *)malloc((size_t)cap);
    char key[MAXK + 1];
    if (!contig) { perror("malloc"); exit(1); }
    for (int j = 0; j < k; ++j) {
        key[j] = keys[(long)start * MAXK + j];
        contig[j] = key[j];
    }
    key[k] = '\0';

    int cur = start;
    visited[cur] = 1;
    while (right_ext[cur] != 'F') {
        char r = right_ext[cur];
        if (len + 2 > cap) {
            cap *= 2;
            char *tmp = (char *)realloc(contig, (size_t)cap);
            if (!tmp) { perror("realloc"); exit(1); }
            contig = tmp;
        }
        contig[len++] = r;

        memmove(key, key + 1, (size_t)(k - 1));
        key[k - 1] = r;
        key[k] = '\0';
        int nxt = lookup_key(key, k);
        if (nxt < 0 || visited[nxt]) break;
        cur = nxt;
        visited[cur] = 1;
    }
    contig[len] = '\0';
    fprintf(out, "%s\n", contig);
    free(contig);
}

static int next_power_of_two(int x) {
    int p = 1;
    while (p < x) p <<= 1;
    return p;
}

int main(int argc, char **argv) {
    const char *input = (argc > 1) ? argv[1] : "/app/test";
    const char *outdir = "/app";

    if (MYTHREAD == 0) {
        FILE *f = fopen(input, "r");
        if (!f) { perror(input); exit(1); }
        char line[MAXK + 512];
        int n = 0;
        int first_k = 0;
        while (fgets(line, sizeof(line), f)) {
            char *tab = strchr(line, '\t');
            if (tab && tab != line && tab[1] != '\0' && tab[2] != '\0') {
                if (n == 0) first_k = (int)(tab - line);
                ++n;
            }
        }
        fclose(f);
        g_nlines = n;
        g_klen = first_k;
    }
    upc_barrier;

    if (g_nlines <= 0) {
        if (MYTHREAD == 0) fprintf(stderr, "No valid input records found\n");
        return 0;
    }

    int cap = g_nlines + 8;
    nbuckets = next_power_of_two(cap * 2 + 16);
    bucket_mask = (uint32_t)(nbuckets - 1);

    /* These are collective allocations: every thread executes them in the
       same order. */
    keys       = upc_all_alloc((size_t)cap * MAXK, sizeof(char));
    key_lens   = upc_all_alloc(cap, sizeof(int));
    left_ext   = upc_all_alloc(cap, sizeof(char));
    right_ext  = upc_all_alloc(cap, sizeof(char));
    next_node  = upc_all_alloc(cap, sizeof(int));
    visited    = upc_all_alloc(cap, sizeof(int));
    heads      = upc_all_alloc(nbuckets, sizeof(int));

    /* Allocate a fixed set of striped locks collectively. */
    bucket_locks = (upc_lock_t **)malloc((size_t)LOCK_STRIPES * sizeof(upc_lock_t *));
    if (!bucket_locks) { perror("malloc"); exit(1); }
    for (int i = 0; i < LOCK_STRIPES; ++i) {
        bucket_locks[i] = upc_all_lock_alloc();
    }

    if (!keys || !key_lens || !left_ext || !right_ext ||
        !next_node || !visited || !heads) {
        if (MYTHREAD == 0) fprintf(stderr, "Shared allocation failed\n");
        return 1;
    }

    if (MYTHREAD == 0) {
        for (int i = 0; i < nbuckets; ++i) heads[i] = -1;
        for (int i = 0; i < cap; ++i) {
            key_lens[i] = 0;
            left_ext[i] = 'F';
            right_ext[i] = 'F';
            next_node[i] = -1;
            visited[i] = 0;
        }
    }
    upc_barrier;

    /* Construction phase: all threads parse and hash their own records. */
    FILE *in = fopen(input, "r");
    if (!in) { perror(input); exit(1); }
    char line[MAXK + 512];
    long line_no = 0;
    while (fgets(line, sizeof(line), in)) {
        if ((line_no % THREADS) == MYTHREAD) {
            char key[MAXK + 1];
            int klen;
            char l, r;
            if (parse_line(line, key, &klen, &l, &r)) {
                long idx = line_no;
                for (int j = 0; j < klen; ++j)
                    keys[idx * MAXK + j] = key[j];
                key_lens[idx] = klen;
                left_ext[idx] = l;
                right_ext[idx] = r;
                insert_node((int)idx);
            }
        }
        ++line_no;
    }
    fclose(in);
    upc_barrier;

    /* Clean old output files before creating this run's files. */
    if (MYTHREAD == 0) {
        char cmd[512];
        snprintf(cmd, sizeof(cmd), "rm -f %s/pgen_*.out", outdir);
        if (system(cmd) != 0) { /* not fatal */ }
    }
    upc_barrier;

    char outpath[512];
    snprintf(outpath, sizeof(outpath), "%s/pgen_%d.out", outdir, MYTHREAD);
    FILE *out = fopen(outpath, "w");
    if (!out) { perror(outpath); exit(1); }

    /* Traversal phase: source nodes are distributed round-robin.  Components
       are disjoint paths in the normal de Bruijn graph, so no two threads
       traverse the same component. */
    for (int i = MYTHREAD; i < cap; i += THREADS) {
        if (key_lens[i] > 0 && left_ext[i] == 'F' && !visited[i])
            emit_contig(out, i);
    }
    upc_barrier;

    /* Defensive, deterministic cleanup of source-less/cyclic components. */
    if (MYTHREAD == 0) {
        for (int i = 0; i < cap; ++i) {
            if (key_lens[i] > 0 && !visited[i]) emit_contig(out, i);
        }
    }
    upc_barrier;

    fclose(out);

    /* upc_all_lock_free must be called collectively. */
    for (int i = 0; i < LOCK_STRIPES; ++i) {
        upc_all_lock_free(bucket_locks[i]);
    }
    free(bucket_locks);
    return 0;
}
