cat > /app/serial.c <<'EOF'
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>

typedef struct {
    char *key;
    int klen;
    char left;
    char right;
    int next;       /* next node in hash bucket */
    int visited;
} Node;

static Node *nodes;
static int node_count;
static int *heads;
static int nbuckets;
static uint32_t bucket_mask;

static uint32_t hash_key(const char *key, int klen) {
    uint64_t h = 1469598103934665603ULL;
    for (int i = 0; i < klen; ++i) {
        h ^= (unsigned char)key[i];
        h *= 1099511628211ULL;
    }
    /* Mix the low and high halves before truncating. */
    return (uint32_t)((h ^ (h >> 32)) & bucket_mask);
}

static int key_equal(int idx, const char *key, int klen) {
    if (nodes[idx].klen != klen) return 0;
    return memcmp(nodes[idx].key, key, (size_t)klen) == 0;
}

static int lookup(const char *key, int klen) {
    uint32_t b = hash_key(key, klen);
    for (int i = heads[b]; i >= 0; i = nodes[i].next) {
        if (key_equal(i, key, klen)) return i;
    }
    return -1;
}

static void insert_node(int idx) {
    uint32_t b = hash_key(nodes[idx].key, nodes[idx].klen);
    nodes[idx].next = heads[b];
    heads[b] = idx;
}

static int next_power_of_two(int x) {
    int p = 1;
    while (p < x) p <<= 1;
    return p;
}

static int parse_line(char *line, char **key_out, int *klen_out,
                      char *left_out, char *right_out) {
    char *tab = strchr(line, '\t');
    if (!tab) return 0;
    *tab = '\0';
    char *k = line;
    int n = (int)strlen(k);
    if (n == 0) return 0;
    if (tab[1] == '\0' || tab[2] == '\0') return 0;
    *key_out = k;
    *klen_out = n;
    *left_out = tab[1];
    *right_out = tab[2];
    return 1;
}

static void emit_contig(FILE *out, int start) {
    int cap = 1024;
    int len = nodes[start].klen;
    char *contig = (char *)malloc((size_t)cap);
    if (!contig) { perror("malloc"); exit(1); }
    memcpy(contig, nodes[start].key, (size_t)len);

    int cur = start;
    nodes[cur].visited = 1;
    while (nodes[cur].right != 'F') {
        char r = nodes[cur].right;
        if (len + 2 > cap) {
            cap *= 2;
            char *tmp = (char *)realloc(contig, (size_t)cap);
            if (!tmp) { perror("realloc"); exit(1); }
            contig = tmp;
        }
        contig[len++] = r;

        int k = nodes[cur].klen;
        char *nk = (char *)malloc((size_t)k + 1);
        if (!nk) { perror("malloc"); exit(1); }
        memcpy(nk, nodes[cur].key + 1, (size_t)(k - 1));
        nk[k - 1] = r;
        nk[k] = '\0';
        int nxt = lookup(nk, k);
        free(nk);
        if (nxt < 0 || nodes[nxt].visited) break;
        cur = nxt;
        nodes[cur].visited = 1;
    }
    contig[len] = '\0';
    fprintf(out, "%s\n", contig);
    free(contig);
}

int main(int argc, char **argv) {
    const char *input = (argc > 1) ? argv[1] : "/app/test";
    FILE *in = fopen(input, "r");
    if (!in) { perror(input); return 1; }

    int cap = 1024;
    nodes = (Node *)calloc((size_t)cap, sizeof(Node));
    if (!nodes) { perror("calloc"); return 1; }

    char *line = NULL;
    size_t line_cap = 0;
    ssize_t got;
    while ((got = getline(&line, &line_cap, in)) >= 0) {
        (void)got;
        char *key;
        int klen;
        char l, r;
        if (!parse_line(line, &key, &klen, &l, &r)) continue;
        if (node_count == cap) {
            cap *= 2;
            Node *tmp = (Node *)realloc(nodes, (size_t)cap * sizeof(Node));
            if (!tmp) { perror("realloc"); return 1; }
            nodes = tmp;
            memset(nodes + node_count, 0, (size_t)(cap - node_count) * sizeof(Node));
        }
        nodes[node_count].key = (char *)malloc((size_t)klen + 1);
        if (!nodes[node_count].key) { perror("malloc"); return 1; }
        memcpy(nodes[node_count].key, key, (size_t)klen + 1);
        nodes[node_count].klen = klen;
        nodes[node_count].left = l;
        nodes[node_count].right = r;
        nodes[node_count].next = -1;
        nodes[node_count].visited = 0;
        ++node_count;
    }
    fclose(in);
    free(line);

    nbuckets = next_power_of_two(node_count * 2 + 16);
    bucket_mask = (uint32_t)(nbuckets - 1);
    heads = (int *)malloc((size_t)nbuckets * sizeof(int));
    if (!heads) { perror("malloc"); return 1; }
    for (int i = 0; i < nbuckets; ++i) heads[i] = -1;
    for (int i = 0; i < node_count; ++i) insert_node(i);

    FILE *out = fopen("/app/serial.out", "w");
    if (!out) { perror("/app/serial.out"); return 1; }

    /* Every component in a normal de Bruijn graph has a unique source
       (left extension == F).  Traverse those first. */
    for (int i = 0; i < node_count; ++i) {
        if (nodes[i].left == 'F' && !nodes[i].visited) emit_contig(out, i);
    }
    /* Defensive fallback for cyclic or otherwise source-less components. */
    for (int i = 0; i < node_count; ++i) {
        if (!nodes[i].visited) emit_contig(out, i);
    }

    fclose(out);
    for (int i = 0; i < node_count; ++i) free(nodes[i].key);
    free(nodes);
    free(heads);
    return 0;
}
EOF
cat > /app/Makefile <<'EOF'
CC      = gcc
UPC     = upc
CFLAGS  = -O2 -Wall -Wextra -std=c11
UPCFLAGS = -O2

all: serial pgen

serial: serial.c
        $(CC) $(CFLAGS) -o $@ $<

pgen: pgen.upc
        $(UPC) $(UPCFLAGS) -o $@ $<

clean:
        rm -f serial pgen /app/serial.out /app/pgen_*.out

.PHONY: all clean
EOF
