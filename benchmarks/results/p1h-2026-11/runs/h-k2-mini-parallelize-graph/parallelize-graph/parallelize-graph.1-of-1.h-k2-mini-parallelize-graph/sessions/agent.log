python3 - <<'PY'
lines=[]
with open('test') as f:
    for ln in f:
        k,e=ln.rstrip('\n').split('\t'); lines.append((k,e))
kmers={k:e for k,e in lines}
k=len(lines[0][0])
print('k',k)
# consistency next
bad=0
nexts={}
for kmer,e in lines:
    l,r=e
    if r!='F':
        nk=kmer[1:]+r
        if nk not in kmers:
            bad+=1
            if bad<5: print('missing next',kmer,r,nk)
        else:
            nexts[kmer]=nk
            # check prev ext equiv
            if kmers[nk][0] != kmer[0]:
                print('inconsistent left',kmer,e,nk,kmers[nk])
    if l!='F':
        pk=l+kmer[:-1]
        if pk not in kmers:
            bad+=1
            if bad<5: print('missing prev',kmer,l,pk)
        else:
            if kmers[pk][1] != kmer[-1]:
                print('inconsistent right',kmer,e,pk,kmers[pk])
print('bad',bad,'nexts',len(nexts))
starts=[k for k,e in lines if e[0]=='F']
print('starts',len(starts))
# check all nodes typed
for s in starts:
    seq=s; cur=s; seen=set()
    while True:
        if cur in seen: print('cycle');break
        seen.add(cur)
        e=kmers[cur]; typ=e[1]
        if typ=='F': break
        nk=cur[1:]+typ
        if nk not in kmers: print('void');break
        seq+=typ; cur=nk
    print('contig len',len(seq),seq[:50],seq[-20:])
# detect nodes with no predecessor and uncovered
preds=set()
for k,e in lines:
    if e[1]!='F': preds.add(k[1:]+e[1])
uncovered=[k for k,e in lines if k not in preds]
print('uncovered',len(uncovered))
# indegrees?
from collections import Counter
out=Counter(); inn=Counter()
for k,e in lines:
    if e[1]!='F': out[k]+=1; inn[k[1:]+e[1]]+=1
print('out max',max(out.values()),'in max',max(inn.values()))
print('nodes with out0', sum(1 for k,e in lines if e[1]=='F'))
print('nodes with in0', len(uncovered))
