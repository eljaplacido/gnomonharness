[290.183905, "o", "<returncode>\r\n2\r\n<output>\r\n+ scriptname=/usr/local/bin/upcc\r\n+ perl=/usr/bin/perl\r\n+ perlopts=-Mbytes\r\n+ readlink=/usr/bin/readlink\r\n+ dirname=/usr/bin/dirname\r\n+ basename=/usr/bin/basename\r\n+ pwd_prog=/usr/bin/pwd\r\n+ awk=mawk\r\n+ /usr/bin/readlink /\r\n+ test -x /usr/bin/readlink -a  = \r\n+ /usr/bin/readlink /usr/local/bin/upcc\r\n+ link=upcc_multi\r\n+ dirname foo/bar\r\n+ test ! -x /usr/bin/dirname -o foo != foo\r\n+ basename foo/bar\r\n+ test ! -x /usr/bin/basename -o bar != bar\r\n+ /usr/bin/pwd\r\n+ test ! -x /usr/bin/pwd -o  != \r\n+ /usr/bin/perl -v\r\n+ test ! -x /usr/bin/perl -o  != \r\n+ test upcc_multi\r\n+ /usr/bin/dirname /usr/local/bin/upcc\r\n+ /usr/bin/basename /usr/local/bin/upcc\r\n+ /usr/bin/dirname /usr/local/bin/upcc\r\n+ dir=/usr/local/bin\r\n+ newpath=upcc_multi\r\n+ /usr/bin/dirname upcc_multi\r\n+ newdir=.\r\n+ /usr/bin/basename upcc_multi\r\n+ newname=upcc_multi\r\n+ cd /usr/local/bin\r\n+ cd .\r\n+ /usr/bin/pwd\r\n+ dir=/usr/local/bin"]
