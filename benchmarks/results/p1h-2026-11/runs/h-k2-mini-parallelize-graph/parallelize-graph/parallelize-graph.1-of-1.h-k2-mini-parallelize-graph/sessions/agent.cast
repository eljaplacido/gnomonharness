[287.079046, "o", "<returncode>\r\n0\r\n<output>\r\n#!/bin/sh\r\n# other/perlstart.  Generated from perlstart.in by configure.\r\n#   $Source: bitbucket.org:berkeleylab/gasnet.git/other/perlstart.in $\r\n# Description: \r\n# Copyright 2004,  Dan Bonachea <bonachea@cs.berkeley.edu>\r\n# Terms of use are as specified in license.txt\r\n#\r\n# Purpose of this utility:\r\n#\r\n# Perlstart does the \"right thing\" to start a sane perl environment on any\r\n#!/usr/bin/env perl\r\n\r\n################################################################################\r\n################################################################################\r\n##  'upcc'  driver script for the Berkeley UPC compiler \r\n################################################################################\r\n################################################################################\r\n\r\n\r\nrequire 5.005;\r\n/bin/sh: 1: file: not found\r\n30:my (@hidden_networks) = qw//; # currently empty\r\n320:      $network_str =~ s/(, )?$_//;\r\n324:    $network_str  =~ s/\\s+$//; # trim trailing w/s\r\n343:For detailed documentation, please see man upcc(1) or https://upc.lbl.gov/docs/\r\n421:                      http://upc-translator.lbl.gov/upcc-nightly.cgi\r\n452:                      http://upc-translator.lbl.gov/upcc-stable.cgi\r\n485:                      http://upc-translator.lbl.gov/upcc-yesterday.cgi\r\n524:      $val =~ s/\\\"\\s+\\\"//g;\r\n525:      $val =~ s/^\\\"//g;\r\n530:      $t =~ s/^\\s*//g; $t =~ s/\\s*$//g;\r\n\r\n"]
[287.08307, "o", "\u001b[92m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\r\n"]
