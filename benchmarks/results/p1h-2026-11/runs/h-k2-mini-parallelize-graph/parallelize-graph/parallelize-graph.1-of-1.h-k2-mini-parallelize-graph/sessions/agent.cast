[306.029759, "o", "\r\n\u001b[1;32mTool\u001b[0m:\r\n"]
[306.031394, "o", "<returncode>\r\n2\r\n<output_head>\r\nRunning as: /usr/local/bin/upcc_multi.pl -v -O '-network=smp' -o pgen 'pgen.upc'\r\nReading multiconf spec file [/usr/local/etc/multiconf.conf]\r\nSetting CONFIGURE_OPTIONS=''\r\nSetting FORCED_OPTIONS=''\r\nSetting ENABLED_CONFS='dbg opt'\r\nSetting BUPC_TRANS='http://upc-translator.lbl.gov/upcc-2022.10.0.cgi'\r\nSetting GUPC_TRANS='/usr/local/upc/bin/upc'\r\nSetting CUPC_TRANS='/usr/local/upc/bin/clang-upc'\r\nSetting CUPC2C_TRANS='/usr/local/upc/bin/clang-upc2c'\r\nSetting PROHIBITED_ENABLE_OPTIONS='debug,trace,stats,inst'\r\nSetting PROHIBITED_WITH_OPTIONS='gupc,cupc,clang-upc2c,translator'\r\nFinal ENABLED_CONFS=dbg opt\r\nRead enabled conf: error ;  the -g flag is incompatibile with the -inst* flags ; $opt{'g'} && ( $opt{'inst'} || $opt{'inst-functions'} || $opt{'inst-local'} || \r\n$opt{'inst-toolname'} )  ; \r\nRead enabled conf: error ;  the -bupc and -gccupc flags are mutually exclusive ; $opt{'bupc'} && $opt{'gccupc'}  ; \r\nRead enabled conf: error ;  the -bupc and -gupc flags are mutually exclusive ; $opt{'bupc'} && $opt{'gupc'}  ; \r\nRead enabled conf: error ;  the -cupc2c and -gccupc flags are mutually exclusive ; $opt{'cupc2c'} && $opt{'gccupc'}  ; \r\nRead enabled conf: error ;  the -cupc2c and -gupc flags are mutually exclusive ; $opt{'cupc2c'} && $opt{'gupc'}  ; \r\nRead enabled conf: error ;  the -cupc2c and -bupc flags are mutually exclusive ; $opt{'cupc2c'} && $opt{'bupc'}  ; \r\nRead enabled conf: error ;  the -cupc and -gccupc flags are mutually exclusive ; $opt{'cupc'} && $opt{'gccupc'}  ; \r\nRead enabled conf: error ;  the -cupc and -gupc flags are mutually exclusive ; $opt{'cupc'} && $opt{'gupc'}  ; \r\nRead enabled conf: error ;  the -cupc and -bupc flags are mutually exclusive ; $opt{'cupc'} && $opt{'bupc'}  ; \r\nRead enabled conf: error ;  the -cupc and -cupc2c flags are mutually exclusive ; $opt{'cupc'} && $opt{'cupc2c'}  ; \r\nRead disabled conf: dbg_gupc ;  --with-gupc=\"${G