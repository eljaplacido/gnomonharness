[51.374145, "o", "\r\u001b[2K\r\n\u001b[1;31mmini-swe-agent\u001b[0m\u001b[31m (step \u001b[0m\u001b[1;31m4\u001b[0m\u001b[31m, \u001b[0m\u001b[1;31m$0.00\u001b[0m\u001b[31m):\u001b[0m\r\n\u001b[32m⠧\u001b[0m Waiting for the LM to respond..."]
[51.375606, "o", "\r\u001b[2K```\r\npython3 - <<'PY'\r\nlines=[]\r\nwith open('test') as f:\r\n    for ln in f:\r\n        k,e=ln.rstrip('\\n').split('\\t'); lines.append((k,e))\r\nkmers={k:e for k,e in lines}\r\nk=len(lines[0][0])\r\nprint('k',k)\r\n# consistency next\r\nbad=0\r\nnexts={}\r\nfor kmer,e in lines:\r\n    l,r=e\r\n    if r!='F':\r\n        nk=kmer[1:]+r\r\n        if nk not in kmers:\r\n            bad+=1\r\n            if bad<5: print('missing next',kmer,r,nk)\r\n        else:\r\n            nexts[kmer]=nk\r\n            # check prev ext equiv\r\n            if kmers[nk][0] != kmer[0]:\r\n                print('inconsistent left',kmer,e,nk,kmers[nk])\r\n    if l!='F':\r\n        pk=l+kmer[:-1]\r\n        if pk not in kmers:\r\n            bad+=1\r\n            if bad<5: print('missing prev',kmer,l,pk)\r\n        else:\r\n            if kmers[pk][1] != kmer[-1]:\r\n                print('inconsistent right',kmer,e,pk,kmers[pk])\r\nprint('bad',bad,'nexts',len(nexts))\r\nstarts=[k for k,e in lines if e[0]=='F']\r\nprint('starts',len(starts))\r\n# check all nodes typed\r\nfor s in starts:\r\n    seq=s; cur=s; seen=set()\r\n    while True:\r\n        if cur in seen: print('cycle');break\r\n        seen.add(cur)\r\n        e=kmers[cur]; typ=e[1]\r\n        if typ=='F': break\r\n        nk=cur[1:]+typ\r\n        if nk not in kmers: print('void');break\r\n        seq+=typ; cur=nk\r\n    print('contig len',len(seq),seq[:50],seq[-20:])\r\n# detect nodes with no predecessor and uncovered\r\npreds=set()\r\nfor k,e in lines:\r\n    if e[1]!='F': preds.add(k[1:]+e[1])\r\nuncovered=[k for k,e in lines if k not in preds]\r\nprint('uncovered',len(uncovered))\r\n# indegrees?\r\nfrom collections import Counter\r\nout=Counter(); inn=Counter()\r\nfor k,e in lines:\r\n    if e[1]!='F': out[k]+=1; inn[k[1:]+e[1]]+=1\r\nprint('out max',max(out.values()),'in max',max(inn.values()))\r\nprint('nodes with out0', sum(1 for k,e in lines if e[1]=='F'))\r\nprint('nodes with in0', len(uncovered))\r\nPY\r\n```\r\n\u001b[32m⠧\u001b[0m Waiting for the LM to respond..."]
