[111.812336, "o", "\u001b[37m```\u001b[0m\u001b[38;5;9msparql\u001b[0m\r\n\u001b[37mPREFIX uni: <http://university.org/ontology/>\u001b[0m\r\n\u001b[37mPREFIX xsd: <http://www.w3.org/2001/XMLSchema#>\u001b[0m\r\n\r\n\u001b[37mSELECT ?professorName (GROUP_CONCAT(DISTINCT ?country; separator=\", \") AS ?countries)\u001b[0m\r\n\u001b[37mWHERE {\u001b[0m\r\n\u001b[37m  # 1) full professors\u001b[0m\r\n\u001b[37m  { SELECT DISTINCT ?professor WHERE {\u001b[0m\r\n\u001b[37m      ?professor a uni:Person ; uni:role ?role .\u001b[0m\r\n\u001b[37m      FILTER(ISLITERAL(?role))\u001b[0m\r\n\u001b[37m      FILTER(STRSTARTS(STR(?role), \"Professor\"))\u001b[0m\r\n\u001b[37m      FILTER(!CONTAINS(LCASE(STR(?role)), \"assistant\"))\u001b[0m\r\n\u001b[37m      FILTER(!CONTAINS(LCASE(STR(?role)), \"associate\"))\u001b[0m\r\n\u001b[37m      FILTER(!CONTAINS(LCASE(STR(?role)), \"adjunct\"))\u001b[0m\r\n\u001b[37m      FILTER(!CONTAINS(LCASE(STR(?role)), \"emeritus\"))\u001b[0m\r\n\u001b[37m  } }\u001b[0m\r\n\r\n"]
[111.812497, "o", "\u001b[37m  # 2) at least one department of a university in an EU member state\u001b[0m\r\n\u001b[37m  { SELECT DISTINCT ?professor WHERE {\u001b[0m\r\n\u001b[37m      ?professor a uni:Person ; uni:role ?role ; uni:worksIn ?euDepartment .\u001b[0m\r\n\u001b[37m      FILTER(ISLITERAL(?role)) FILTER(STRSTARTS(STR(?role), \"Professor\"))\u001b[0m\r\n\u001b[37m      ?euDepartment uni:belongsTo/uni:locatedInCountry ?euCountry .\u001b[0m\r\n\u001b[37m      VALUES ?euCountry { \"AT\" \"BE\" \"BG\" \"HR\" \"CY\" \"CZ\" \"DK\" \"EE\" \"FI\" \"FR\" \"DE\" \"GR\"\u001b[0m\r\n\u001b[37m                          \"HU\" \"IE\" \"IT\" \"LV\" \"LT\" \"LU\" \"MT\" \"NL\" \"PL\" \"PT\" \"RO\" \"SK\"\u001b[0m\r\n"]
[111.812588, "o", "\u001b[37m                          \"SI\" \"ES\" \"SE\" }\u001b[0m\r\n\u001b[37m  } }\u001b[0m\r\n\r\n\u001b[37m  # 3) one of their departments has >10 currently enrolled students\u001b[0m\r\n\u001b[37m  { SELECT ?professor WHERE {\u001b[0m\r\n\u001b[37m      ?professor uni:worksIn ?bigDepartment .\u001b[0m\r\n\u001b[37m      ?course uni:isTaughtIn ?bigDepartment .\u001b[0m\r\n\u001b[37m      ?student uni:isEnrolledIn ?course .\u001b[0m\r\n\u001b[37m      FILTER NOT EXISTS { ?student uni:hasEnrollmentDate ?e . FILTER(?e > \"2025-08-16\"^^xsd:date) }\u001b[0m\r\n\u001b[37m      FILTER NOT EXISTS { ?student uni:hasGraduationDate ?gd . FILTER(?gd <= \"2025-08-16\"^^xsd:date) }\u001b[0m\r\n\u001b[37m    } GROUP BY ?professor ?bigDepartment\u001b[0m\r\n\u001b[37m      HAVING (COUNT(DISTINCT ?student) > 10) }\u001b[0m\r\n\r\n\u001b[37m  ?professor uni:hasName ?professorName ; uni:worksIn ?department .\u001b[0m\r\n\u001b[37m  ?department uni:belongsTo/uni:locatedInCountry ?country .\u001b[0m\r\n"]
[111.812708, "o", "\u001b[37m}\u001b[0m\r\n\u001b[37mGROUP BY ?professorName\u001b[0m\r\n\u001b[37mORDER BY ?professorName\u001b[0m\r\n\u001b[37m```\u001b[0m\r\n\r\n"]
[111.872979, "o", "\u001b[34m##\u001b[0m\u001b[37m \u001b[0m\u001b[34mResult\u001b[0m\r\n\r\n"]
[112.14004, "o", "\u001b[37m|\u001b[0m\u001b[37m professorName    \u001b[0m\u001b[37m|\u001b[0m\u001b[37m countries \u001b[0m\u001b[37m|\u001b[0m\r\n"]
[112.140518, "o", "\u001b[37m|\u001b[0m\u001b[37m------------------\u001b[0m\u001b[37m|\u001b[0m\u001b[37m-----------\u001b[0m\u001b[37m|\u001b[0m\r\n\u001b[37m|\u001b[0m\u001b[37m Aristotle Tympas \u001b[0m\u001b[37m|\u001b[0m\u001b[37m GR        \u001b[0m\u001b[37m|\u001b[0m\r\n\u001b[37m|\u001b[0m\u001b[37m Orfeas Menis     \u001b[0m\u001b[37m|\u001b[0m\u001b[37m GR, US    \u001b[0m\u001b[37m|\u001b[0m\r\n\u001b[37m|\u001b[0m\u001b[37m Pepe Attanasio   \u001b[0m\u001b[37m|\u001b[0m\u001b[37m PT, GR    \u001b[0m\u001b[37m|\u001b[0m\r\n\u001b[37mKey reasoning points\u001b[0m"]
