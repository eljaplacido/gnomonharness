[175.474773, "o", "    \u001b[2mPython 3.12.3\u001b[0m\r\n    \u001b[2mgcc (Ubuntu 13.3.0-6ubuntu2~24.04.1) 13.3.0\u001b[0m\r\n    \u001b[2m--- exact commands ---\u001b[0m\r\n    \u001b[2m55\u001b[0m\r\n    \u001b[2m55\u001b[0m\r\n    \u001b[2m--- with -Wall -Wextra ---\u001b[0m\r\n    \u001b[2mno warnings above\u001b[0m\r\n    \u001b[2m#if 0\u001b[0m\r\n    \u001b[2m\"\"\"\"\u001b[0m\r\n    \u001b[2m#endif\u001b[0m\r\n    \u001b[2m\u001b[3m... (2 lines hidden, /toggle to show all)\u001b[0m\r\n    \u001b[2mdef main():\u001b[0m\r\n    \u001b[2m    if len(sys.argv) < 2:\u001b[0m\r\n    \u001b[2m        return 1\u001b[0m\r\n    \u001b[2m    n = int(sys.argv[1])\u001b[0m\r\n    \u001b[2m    sys.stdout.write(str(fib(n)) + chr(10))\u001b[0m\r\n    \u001b[2m    return 0\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2msys.exit(main())\u001b[0m\r\n    \u001b[2m#endif\u001b[0m\r\n"]
