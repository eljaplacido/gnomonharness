[183.178406, "o", "\u001b[32m`\u001b[0m\u001b[32mf(5000)\u001b[0m\u001b[32m`\u001b[0m\u001b[37m, md5 match).\u001b[0m\r\n\u001b[37m-\u001b[0m"]
