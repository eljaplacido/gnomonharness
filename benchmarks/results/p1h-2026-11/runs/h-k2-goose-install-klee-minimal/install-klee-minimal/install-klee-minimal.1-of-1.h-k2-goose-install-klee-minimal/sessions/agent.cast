[69.7977, "o", "\r\n  \u001b[2m────────────────────────────────────────\u001b[0m\r\n  \u001b[2m▸\u001b[0m \u001b[2mshell\u001b[0m\r\n    \u001b[2mcommand\u001b[0m: \u001b[32mcd /app && git ls-remote --tags https://github.com/stp/stp.git 2>/dev/null | tail -12\u001b[0m\r\n\r\n\r\n  \u001b[2m────────────────────────────────────────\u001b[0m\r\n  \u001b[2m▸\u001b[0m \u001b[2mshell\u001b[0m\r\n    \u001b[2mcommand\u001b[0m: \u001b[32mcd /app/klee && grep -n \"LLVM_VERSION\\|find_package(LLVM\\|MIN_LLVM\" CMakeLists.txt | head -20; ls; grep -rn \"uClibc\" CMakeLists.txt lib/CMakeLis...\u001b[0m\r\n\r\n"]
[70.23622, "o", "    \u001b[2m114:find_package(LLVM REQUIRED CONFIG HINTS \"${LLVM_DIR}\")\u001b[0m\r\n    \u001b[2mCMakeLists.txt\u001b[0m\r\n    \u001b[2mDockerfile\u001b[0m\r\n    \u001b[2mLICENSE.TXT\u001b[0m\r\n    \u001b[2mNEWS\u001b[0m\r\n    \u001b[2mREADME-CMake.md\u001b[0m\r\n    \u001b[2mREADME.md\u001b[0m\r\n    \u001b[2mcmake\u001b[0m\r\n    \u001b[2mdocs\u001b[0m\r\n    \u001b[2mexamples\u001b[0m\r\n    \u001b[2minclude\u001b[0m\r\n    \u001b[2mlib\u001b[0m\r\n    \u001b[2mruntime\u001b[0m\r\n    \u001b[2mscripts\u001b[0m\r\n    \u001b[2mtest\u001b[0m\r\n    \u001b[2mtools\u001b[0m\r\n    \u001b[2munittests\u001b[0m\r\n    \u001b[2mutils\u001b[0m\r\n    \u001b[2m3ae3e92b29b9551cd146a2382d8391a6c89ef102\trefs/tags/2.1.0\u001b[0m\r\n    \u001b[2m1fdabf26b8f329d077f65facd116bf12fe8d72dd\trefs/tags/2.1.1\u001b[0m\r\n    \u001b[2m9c22ea1682eed439577fb1ebc89dd1047d365d7f\trefs/tags/2.1.2\u001b[0m\r\n    \u001b[2m15943d7fa821106c350a367d83aaf143d4720023\trefs/tags/2.3.1\u001b[0m\r\n    \u001b[2ma58a4ab2f42a334854c7e7485593e33cd4b4ee53\trefs/tags/2.3.2\u001b[0m\r\n    \u001b[2m7a3fd493ae6f0a524f853946308f4f3c3ddcbe76\trefs/tags/2.3.3\u001b[0m\r\n    \u001b[2md70085462f07c8a5a2f1225f727cda3ef505b141\trefs/tags/2.3.4\u001b[0m\r\n    \u001b[2m207c63a88c67a4ec673da519039ce1212565c49c\trefs/tags/2.3.4_cadical\u001b[0m\r\n    \u001b[2m8c1af1c2e34dd9e9d2087ef8d3ac7ca703b1c472\trefs/tags/2.4.0\u001b[0m\r\n    \u001b[2m295953fc1f7424cc4822a02f5c7964e0aafbdf10\trefs/tags/2.4.1\u001b[0m\r\n    \u001b[2mac1b92b181c293a00360a028857cb76a6cc8b191\trefs/tags/smtcomp2020\u001b[0m\r\n    \u001b[2m9b9021b28bf95c3851835e0c836a05cb5baa4670\trefs/tags/stp-2.2.0\u001b[0m\r\n"]
[72.841702, "o", "\r\n  \u001b[2m────────────────────────────────────────\u001b[0m\r\n  \u001b[2m▸\u001b[0m \u001b[2mshell\u001b[0m\r\n    \u001b[2mcommand\u001b[0m: \u001b[32mcd /app/klee && grep -rn \"16\\|LLVM_VERSION_MAJOR\" CMakeLists.txt | head -30\u001b[0m\r\n\r\n\r\n  \u001b[2m────────────────────────────────────────\u001b[0m\r\n  \u001b[2m▸\u001b[0m \u001b[2mshell\u001b[0m\r\n    \u001b[2mcommand\u001b[0m: \u001b[32mcd /app && git clone -q --depth 1 -b 2.3.4 https://github.com/stp/stp.git stp && echo STP_OK && cd stp && ls && cat deps/CMakeLists.txt 2>/dev/n...\u001b[0m\r\n\r\n"]
[74.220545, "o", "    \u001b[2m13:cmake_minimum_required(VERSION 3.16.0)\u001b[0m\r\n    \u001b[2mNote: switching to 'd70085462f07c8a5a2f1225f727cda3ef505b141'.\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2mYou are in 'detached HEAD' state. You can look around, make experimental\u001b[0m\r\n    \u001b[2mchanges and commit them, and you can discard any commits you make in this\u001b[0m\r\n    \u001b[2mstate without impacting any branches by switching back to a branch.\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2mIf you want to create a new branch to retain commits you create, you may\u001b[0m\r\n    \u001b[2mdo so (now or later) by using -c with the switch command. Example:\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2m  git switch -c <new-branch-name>\u001b[0m\r\n    \u001b[2m\u001b[3m... (21 lines hidden, /toggle to show all)\u001b[0m\r\n    \u001b[2mdocs\u001b[0m\r\n    \u001b[2mexamples\u001b[0m\r\n    \u001b[2minclude\u001b[0m\r\n    \u001b[2mlib\u001b[0m\r\n    \u001b[2mpapers\u001b[0m\r\n    \u001b[2mscripts\u001b[0m\r\n    \u001b[2mtests\u001b[0m\r\n    \u001b[2mtools\u001b[0m\r\n    \u001b[2mutils\u001b[0m\r\n    \u001b[2mwindows\u001b[0m\r\n"]
[77.21698, "o", "\r\n  \u001b[2m────────────────────────────────────────\u001b[0m\r\n  \u001b[2m▸\u001b[0m \u001b[2mshell\u001b[0m\r\n    \u001b[2mcommand\u001b[0m: \u001b[32mcd /app/stp && ls cmake; grep -rn \"MINISAT\\|MiniSAT\" CMakeLists.txt | head -20\u001b[0m\r\n\r\n\r\n  \u001b[2m────────────────────────────────────────\u001b[0m\r\n  \u001b[2m▸\u001b[0m \u001b[2mshell\u001b[0m\r\n    \u001b[2mcommand\u001b[0m: \u001b[32mcd /app/klee && grep -rn \"LLVM_VERSION\" cmake/*.cmake CMakeLists.txt | head -20; echo ---; grep -rn \"STP\" CMakeLists.txt | head -20\u001b[0m\r\n\r\n"]
[77.235063, "o", "    \u001b[2mCOPYING-CMAKE-SCRIPTS\u001b[0m\r\n    \u001b[2mREADME\u001b[0m\r\n    \u001b[2mmodules\u001b[0m\r\n    \u001b[2m477:option(NOCRYPTOMINISAT \"Don't try to use cryptominisat\" OFF)\u001b[0m\r\n    \u001b[2m479:if (NOT NOCRYPTOMINISAT)\u001b[0m\r\n    \u001b[2m487:  if (cryptominisat5_FOUND AND HAVE_FLAG_STD_CPP11 AND (NOT NOCRYPTOMINISAT))\u001b[0m\r\n    \u001b[2m488:    message(STATUS \"CryptoMiniSat5 dynamic lib: ${CRYPTOMINISAT5_LIBRARIES}\")\u001b[0m\r\n    \u001b[2m489:    message(STATUS \"CryptoMiniSat5 static lib:  ${CRYPTOMINISAT5_STATIC_LIBRARIES}\")\u001b[0m\r\n    \u001b[2m490:    message(STATUS \"CryptoMiniSat5 static lib deps: ${CRYPTOMINISAT5_STATIC_LIBRARIES_DEPS}\")\u001b[0m\r\n    \u001b[2m491:    message(STATUS \"CryptoMiniSat5 include dirs: ${CRYPTOMINISAT5_INCLUDE_DIRS}\")\u001b[0m\r\n    \u001b[2m492:    add_definitions(-DUSE_CRYPTOMINISAT)\u001b[0m\r\n    \u001b[2m493:    set(USE_CRYPTOMINISAT ON)\u001b[0m\r\n    \u001b[2m497:add_feature_info(CryptoMiniSat USE_CRYPTOMINISAT \"Enables CryptoMiniSat solver, allows --cryptominisat5 option\")\u001b[0m\r\n    \u001b[2m500:if (FORCE_CMS AND NOT USE_CRYPTOMINISAT)\u001b[0m\r\n    \u001b[2m549:set(MINISAT_INCLUDE_DIR \"\" CACHE PATH \"MiniSat include directory\")\u001b[0m\r\n    \u001b[2m550:set(MINISAT_LIBRARY \"\" CACHE PATH \"MiniSat library directory\")\u001b[0m\r\n    \u001b[2m553:    message(STATUS \"OK, found Minisat library under ${MINISAT_LIBRARIES} and Minisat include dirs under ${MINISAT_INCLUDE_DIRS}\")\u001b[0m\r\n    \u001b[2m559:        message(STATUS \"OK, found Minisat library under ${MINISAT_LIBRARIES} and Minisat include dirs under ${MINISAT_INCLUDE_DIRS}\")\u001b[0m\r\n    \u001b[2m565:include_directories(SYSTEM ${MINISAT_INCLUDE_DIRS})\u001b[0m\r\n    \u001b[2m566:set(LIBS ${LIBS} ${MINISAT_LIBRARIES})\u001b[0m\r\n    \u001b[2m---\u001b[0m\r\n    \u001b[2m201:# STP\u001b[0m\r\n    \u001b[2m208:if ((NOT ${ENABLE_Z3}) AND (NOT ${ENABLE_STP}) AND (NOT ${ENABLE_METASMT}))\u001b[0m\r\n    \u001b[2m212:    \"\\\"-DENABLE_SOLVER_STP=ON\\\"\\n\"\u001b[0m\r\n"]
[78.953725, "o", "\r\n  \u001b[2m────────────────────────────────────────\u001b[0m\r\n  \u001b[2m▸\u001b[0m \u001b[2mshell\u001b[0m\r\n    \u001b[2mcommand\u001b[0m: \u001b[32mcd /app/stp && sed -n 540,580p CMakeLists.txt; echo ---; cat cmake/modules/FindMiniSAT.cmake 2>/dev/null | head -40\u001b[0m\r\n\r\n\r\n  \u001b[2m────────────────────────────────────────\u001b[0m\r\n  \u001b[2m▸\u001b[0m \u001b[2mshell\u001b[0m\r\n    \u001b[2mcommand\u001b[0m: \u001b[32mcd /app/klee && sed -n 100,230p CMakeLists.txt\u001b[0m\r\n\r\n"]
[78.96514, "o", "    \u001b[2m################################################################################\u001b[0m\r\n    \u001b[2minclude(GNUInstallDirs)\u001b[0m\r\n    \u001b[2minclude(CheckCSourceCompiles)\u001b[0m\r\n    \u001b[2minclude(CheckCXXSymbolExists)\u001b[0m\r\n    \u001b[2minclude(CheckFunctionExists)\u001b[0m\r\n    \u001b[2minclude(CheckIncludeFile)\u001b[0m\r\n    \u001b[2minclude(CheckIncludeFileCXX)\u001b[0m\r\n    \u001b[2minclude(CheckLibraryExists)\u001b[0m\r\n    \u001b[2minclude(CheckPrototypeDefinition)\u001b[0m\r\n    \u001b[2minclude(CMakePushCheckState)\u001b[0m\r\n    \u001b[2m\u001b[3m... (111 lines hidden, /toggle to show all)\u001b[0m\r\n    \u001b[2m  if (ENABLE_SOLVER_METASMT)\u001b[0m\r\n    \u001b[2m    message(WARNING \"Not disabling exceptions because metaSMT uses them\")\u001b[0m\r\n    \u001b[2m  else()\u001b[0m\r\n    \u001b[2m    list(APPEND KLEE_COMPONENT_CXX_FLAGS \"-fno-exceptions\")\u001b[0m\r\n    \u001b[2m  endif()\u001b[0m\r\n"]
[78.965246, "o", "    \u001b[2mendif()\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2m###############################################################################\u001b[0m\r\n    \u001b[2m# RTTI\u001b[0m\r\n    \u001b[2m###############################################################################\u001b[0m\r\n    \u001b[2m    MESSAGE(STATUS \"Not on Linux, not creating manpage\")\u001b[0m\r\n"]
[78.965316, "o", "    \u001b[2mendif()\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2m# -----------------------------------------------------------------------------\u001b[0m\r\n    \u001b[2m# Find Minisat\u001b[0m\r\n"]
[78.965381, "o", "    \u001b[2m# -----------------------------------------------------------------------------\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2mfind_package(minisat)\u001b[0m\r\n    \u001b[2mset(MINISAT_INCLUDE_DIR \"\" CACHE PATH \"MiniSat include directory\")\u001b[0m\r\n    \u001b[2m\u001b[3m... (22 lines hidden, /toggle to show all)\u001b[0m\r\n    \u001b[2m# On macOS, search Homebrew for keg-only versions of Bison and Flex. Xcode does\u001b[0m\r\n    \u001b[2m# not provide new enough versions for us to use.\u001b[0m\r\n    \u001b[2mif (CMAKE_HOST_SYSTEM_NAME MATCHES \"Darwin\")\u001b[0m\r\n    \u001b[2m    execute_process(\u001b[0m\r\n    \u001b[2m        COMMAND brew --prefix bison \u001b[0m\r\n    \u001b[2m        RESULT_VARIABLE BREW_BISON\u001b[0m\r\n    \u001b[2m        OUTPUT_VARIABLE BREW_BISON_PREFIX\u001b[0m\r\n    \u001b[2m        OUTPUT_STRIP_TRAILING_WHITESPACE\u001b[0m\r\n    \u001b[2m    )\u001b[0m\r\n    \u001b[2m---\u001b[0m\r\n"]
[83.133754, "o", "\r\n  \u001b[2m────────────────────────────────────────\u001b[0m\r\n  \u001b[2m▸\u001b[0m \u001b[2mshell\u001b[0m\r\n    \u001b[2mcommand\u001b[0m: \u001b[32mcd /app/stp && ls cmake/modules; cat cmake/modules/Findminisat.cmake 2>/dev/null | head -40\u001b[0m\r\n\r\n\r\n  \u001b[2m────────────────────────────────────────\u001b[0m\r\n  \u001b[2m▸\u001b[0m \u001b[2mshell\u001b[0m\r\n    \u001b[2mcommand\u001b[0m: \u001b[32mcd /app/klee && cat cmake/find_stp.cmake; grep -rn \"LLVM\" docs/build-* 2>/dev/null | head -20\u001b[0m\r\n\r\n"]
[83.14189, "o", "    \u001b[2m#===------------------------------------------------------------------------===#\u001b[0m\r\n    \u001b[2m#\u001b[0m\r\n    \u001b[2m#                     The KLEE Symbolic Virtual Machine\u001b[0m\r\n    \u001b[2m#\u001b[0m\r\n    \u001b[2m# This file is distributed under the University of Illinois Open Source\u001b[0m\r\n    \u001b[2m# License. See LICENSE.TXT for details.\u001b[0m\r\n    \u001b[2m#\u001b[0m\r\n    \u001b[2m#===------------------------------------------------------------------------===#\u001b[0m\r\n    \u001b[2m# STP: Use CMake facility to detect. The user can pass `-DSTP_DIR=` to force\u001b[0m\r\n    \u001b[2m# a particular directory.\u001b[0m\r\n    \u001b[2m\u001b[3m... (37 lines hidden, /toggle to show all)\u001b[0m\r\n    \u001b[2m    message(STATUS \"STP_DIR: ${STP_DIR}\")\u001b[0m\r\n    \u001b[2m    set(ENABLE_STP 1) # For config.h\u001b[0m\r\n    \u001b[2m  else()\u001b[0m\r\n    \u001b[2m    message(FATAL_ERROR \"STP not found. Try setting `-DSTP_DIR=/path` where\"\u001b[0m\r\n    \u001b[2m      \" `/path` is the directory containing `STPConfig.cmake`\")\u001b[0m\r\n    \u001b[2m  endif()\u001b[0m\r\n    \u001b[2melse()\u001b[0m\r\n    \u001b[2m  message(STATUS \"STP solver support disabled\")\u001b[0m\r\n    \u001b[2m  set(ENABLE_STP 0) # For config.h\u001b[0m\r\n    \u001b[2mendif()\u001b[0m\r\n    \u001b[2mAddGTestSuite.cmake\u001b[0m\r\n    \u001b[2mAddSTPGTest.cmake\u001b[0m\r\n    \u001b[2mFindGMP.cmake\u001b[0m\r\n    \u001b[2mFindminisat.cmake\u001b[0m\r\n    \u001b[2mGetGitRevisionDescription.cmake\u001b[0m\r\n    \u001b[2mGetGitRevisionDescription.cmake.in\u001b[0m\r\n    \u001b[2mMacroPushRequiredVars.cmake\u001b[0m\r\n    \u001b[2mcmake_uninstall.cmake.in\u001b[0m\r\n    \u001b[2m# AUTHORS: Dan Liew, Ryan Gvostes, Mate Soos\u001b[0m\r\n    \u001b[2m#\u001b[0m\r\n"]
[83.141942, "o", "    \u001b[2m\u001b[3m... (28 lines hidden, /toggle to show all)\u001b[0m\r\n    \u001b[2mmessage(STATUS \"looking at:  ${MINISAT_INCLUDE_DIRS}\")\u001b[0m\r\n    \u001b[2mfind_path(MINISAT_INCLUDE_DIR minisat/core/Solver.h\u001b[0m\r\n    \u001b[2m          HINTS ${MINISAT_INCLUDE_DIRS}\u001b[0m\r\n    \u001b[2m          PATH_SUFFIXES minisat minisat2 )\u001b[0m\r\n    \u001b[2mmessage(STATUS \"found: MINISAT_INCLUDE_DIR: ${MINISAT_INCLUDE_DIR}\")\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2mmessage(STATUS \"Finding minisat libs...\")\u001b[0m\r\n    \u001b[2mmessage(STATUS \"looking at:  ${MINISAT_LIBDIR}\")\u001b[0m\r\n    \u001b[2mfind_library(MINISAT_LIBRARY NAMES minisat minisat2\u001b[0m\r\n    \u001b[2m         HINTS ${MINISAT_LIBDIR} ${MINISAT_LIBDIR}/lib ${MINISAT_LIBRARY_DIRS} )\u001b[0m\r\n"]
[92.523188, "o", "\r\n  \u001b[2m────────────────────────────────────────\u001b[0m\r\n  \u001b[2m▸\u001b[0m \u001b[2mshell\u001b[0m\r\n    \u001b[2mcommand\u001b[0m: \u001b[32mcd /app/klee && ls runtime; grep -rn \"LIBCXX\\|libcxx\\|musl\\|uclibc\" CMakeLists.txt runtime/CMakeLists.txt | head -30; echo ---; ls scripts/build...\u001b[0m\r\n\r\n\r\n  \u001b[2m────────────────────────────────────────\u001b[0m\r\n  \u001b[2m▸\u001b[0m \u001b[2mshell\u001b[0m\r\n    \u001b[2mcommand\u001b[0m: \u001b[32mcd /app/klee && cat NEWS | head -40; grep -rn \"LLVM 16\\|16\" docs/build-*.md 2>/dev/null | head; ls docs\u001b[0m\r\n\r\n"]
[92.534145, "o", "    \u001b[2mKLEE 3.1, 29 February 2024\u001b[0m\r\n    \u001b[2m==========================\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2mIncorporating changes from 8 June 2023 to 29 February 2024.\u001b[0m\r\n    \u001b[2mMaintainers during this time span: @ccadar, @MartinNowack, @251.\u001b[0m\r\n    \u001b[2mDocumentation at http://klee.github.io/releases/docs/v3.1\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2m== Major features and important changes ==\u001b[0m\r\n    \u001b[2m- New execution tree implementation and klee-exec-tree tool (@251)\u001b[0m\r\n    \u001b[2m- KDAlloc is now the default allocator in KLEE (KDAlloc was introduced in KLEE 3.0)\u001b[0m\r\n    \u001b[2m\u001b[3m... (25 lines hidden, /toggle to show all)\u001b[0m\r\n"]
[92.534159, "o", "    \u001b[2m- Smaller refactorings, fixes and improvements, test cases, maintenance, comments, web version, website, etc. (@251, @ccadar, @dependabot, @danielschemmel, @davidtr1037, @jbuening, @marco6, @MartinNowack, @McSinyx, @sp1ff)\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2mKLEE 3.0, 7 June 2023\u001b[0m\r\n    \u001b[2m=====================\u001b[0m\r\n    \u001b[2mCMakeLists.txt\u001b[0m\r\n    \u001b[2mSMT-COMP\u001b[0m\r\n    \u001b[2mdoxygen.cfg.in\u001b[0m\r\n    \u001b[2mintro\u001b[0m\r\n    \u001b[2moverview\u001b[0m\r\n"]
