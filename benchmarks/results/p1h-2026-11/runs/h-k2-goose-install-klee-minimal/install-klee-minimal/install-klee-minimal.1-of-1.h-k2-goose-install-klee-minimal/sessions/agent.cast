[98.624977, "o", "\r\n  \u001b[2m────────────────────────────────────────\u001b[0m\r\n  \u001b[2m▸\u001b[0m \u001b[2mshell\u001b[0m\r\n    \u001b[2mcommand\u001b[0m: \u001b[32mcd /app/klee && sed -n 1,80p runtime/CMakeLists.txt; echo ====; sed -n 1,60p runtime/POSIX/CMakeLists.txt\u001b[0m\r\n\r\n\r\n  \u001b[2m────────────────────────────────────────\u001b[0m\r\n  \u001b[2m▸\u001b[0m \u001b[2mshell\u001b[0m\r\n    \u001b[2mcommand\u001b[0m: \u001b[32mcd /app/klee && cat scripts/build/p-libcxx.inc | head -80\u001b[0m\r\n\r\n"]
[98.632446, "o", "    \u001b[2m# Build scripts for libc++\u001b[0m\r\n    \u001b[2msetup_build_variables_libcxx() {\u001b[0m\r\n    \u001b[2m  LIBCXX_SRC=\"${BASE}/llvm-${LLVM_VERSION_SHORT}\"\u001b[0m\r\n    \u001b[2m  LIBCXX_BUILD=\"${BASE}/libc++-build-${LLVM_VERSION_SHORT}\"\u001b[0m\r\n    \u001b[2m  LIBCXX_INSTALL=\"${BASE}/libc++-install-${LLVM_VERSION_SHORT}\"\u001b[0m\r\n    \u001b[2m}\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2mdownload_libcxx() {\u001b[0m\r\n    \u001b[2m  # Skip step if we already checked out code\u001b[0m\r\n    \u001b[2m  [[ -f \"${LIBCXX_SRC}/.src_checked_out\" ]] && return 0\u001b[0m\r\n    \u001b[2m\u001b[3m... (60 lines hidden, /toggle to show all)\u001b[0m\r\n    \u001b[2m  cd \"${LIBCXX_BUILD}\"\u001b[0m\r\n    \u001b[2m  (\u001b[0m\r\n    \u001b[2m    export CC=wllvm\u001b[0m\r\n    \u001b[2m    export CXX=wllvm++\u001b[0m\r\n    \u001b[2m    export LLVM_COMPILER=clang\u001b[0m\r\n    \u001b[2m    export LLVM_COMPILER_PATH=\"$(dirname \"${BITCODE_CC}\")\"\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2m    if [[ \"${LLVM_VERSION_SHORT}\" -ge \"140\" ]]; then\u001b[0m\r\n    \u001b[2m      cd \"${LIBCXX_BUILD}/runtimes\" || return 1\u001b[0m\r\n    \u001b[2m      make install || return 1\u001b[0m\r\n"]
[98.632593, "o", "    \u001b[2m#===------------------------------------------------------------------------===#\u001b[0m\r\n    \u001b[2m#\u001b[0m\r\n    \u001b[2m#                     The KLEE Symbolic Virtual Machine\u001b[0m\r\n    \u001b[2m#\u001b[0m\r\n    \u001b[2m# This file is distributed under the University of Illinois Open Source\u001b[0m\r\n    \u001b[2m# License. See LICENSE.TXT for details.\u001b[0m\r\n    \u001b[2m#\u001b[0m\r\n    \u001b[2m#===------------------------------------------------------------------------===#\u001b[0m\r\n    \u001b[2m# Handle binaries\u001b[0m\r\n    \u001b[2madd_subdirectory(Runtest)\u001b[0m\r\n    \u001b[2m\u001b[3m... (87 lines hidden, /toggle to show all)\u001b[0m\r\n    \u001b[2m        klee_init_env.c\u001b[0m\r\n    \u001b[2m        misc.c\u001b[0m\r\n    \u001b[2m        selinux.c\u001b[0m\r\n    \u001b[2m        stubs.c\u001b[0m\r\n    \u001b[2m        )\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2m# Build it\u001b[0m\r\n    \u001b[2minclude(\"${CMAKE_SOURCE_DIR}/cmake/compile_bitcode_library.cmake\")\u001b[0m\r\n    \u001b[2mprefix_with_path(\"${SRC_FILES}\" \"${CMAKE_CURRENT_SOURCE_DIR}/\" prefixed_files)\u001b[0m\r\n    \u001b[2madd_bitcode_library_targets(\"${LIB_PREFIX}\" \"${prefixed_files}\" \"-std=gnu89\" \"\")\u001b[0m\r\n"]
