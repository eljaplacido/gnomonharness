    GROUP BY p.category, p.product_id
),
ranked AS (
    SELECT category, product_id, sales,
           ROW_NUMBER() OVER (PARTITION BY category
                              ORDER BY sales DESC, product_id) AS sales_rank
    FROM q4_sales
)
SELECT category, product_id, sales
FROM ranked WHERE sales_rank <= 3
ORDER BY category, sales DESC, product_id;
