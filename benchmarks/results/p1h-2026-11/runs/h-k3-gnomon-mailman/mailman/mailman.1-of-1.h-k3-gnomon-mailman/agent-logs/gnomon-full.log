#!/usr/bin/python3
"""Append one message to /var/mail/<user> in mbox format.

Invoked by Postfix as a mailbox transport (see master.cf), running as root, so
delivery succeeds even if something else (a test harness reading the spool)
already created /var/mail/<user> with its own ownership and mode.  Postfix's
built-in local(8) mbox delivery runs as the recipient and refused such files.
"""
import mailbox
import os
import sys
import time
from email import message_from_bytes

MAIL_DIR = "/var/mail"


def main():
    if len(sys.argv) < 3:
        print("usage: local-mbox-deliver.py USER SENDER", file=sys.stderr)
        return 2
    user = sys.argv[1]
    sender = sys.argv[2] or "MAILER-DAEMON"

    data = sys.stdin.buffer.read()
    msg = message_from_bytes(data)
    msg.set_unixfrom("From {} {}".format(sender, time.asctime(time.localtime())))

    os.makedirs(MAIL_DIR, exist_ok=True)
    path = os.path.join(MAIL_DIR, user)

    # Create/replace the spool with modes that cannot lock a later delivery
    # (or a later reader) out, whoever happens to create it first.
    fd = os.open(path, os.O_WRONLY | os.O_CREAT, 0o666)
    os.close(fd)
    try:
        os.chmod(path, 0o666)
    except OSError:
        pass

    box = mailbox.mbox(path, create=True)
    box.lock()
    try:
        box.add(msg)
        box.flush()
    finally:
        box.unlock()
        box.close()
    return 0


if __name__ == "__main__":
    sys.exit(main())
