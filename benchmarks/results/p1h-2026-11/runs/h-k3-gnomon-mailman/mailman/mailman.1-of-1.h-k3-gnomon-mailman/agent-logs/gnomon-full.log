#!/usr/bin/env python3
"""End-to-end checks for join / post / leave beyond what eval.py covers."""
import mailbox
import os
import sys
import time

sys.path.insert(0, "/app")
import eval as ev  # noqa: E402  (helpers + config path live there)


def subjects(user):
    box = mailbox.mbox(f"/var/mail/{user}")
    return [m.get("Subject", "") for m in box]


def join(user):
    ev.send_email(body="", subject="", from_addr=f"{user}@{ev.DOMAIN_NAME}",
                  to_addr=ev.JOIN_LIST)
    ev.retry(lambda: os.path.exists(f"/var/mail/{user}"))
    ev.retry(lambda: ev.confirm_last_reply(user, "join"))
    ev.retry(lambda: ev.get_mlist().members.get_member(
        f"{user}@{ev.DOMAIN_NAME}"))
    print(f"[ok] {user} joined")


def leave(user):
    ev.send_email(body="", subject="", from_addr=f"{user}@{ev.DOMAIN_NAME}",
                  to_addr=ev.LEAVE_LIST)
    ev.retry(lambda: ev.confirm_last_reply(user, "leave"))
    ev.retry(lambda: _assert_not_member(user))
    print(f"[ok] {user} left")


def _assert_not_member(user):
    assert ev.get_mlist().members.get_member(f"{user}@{ev.DOMAIN_NAME}") is None


def main():
    ev.test_mlist_exists()
    users = [os.urandom(8).hex() for _ in range(2)]
    for user in users:
        ev.add_user(user)
    for user in users:
        join(user)

    poster = users[0]
    subject = "Announcement " + os.urandom(4).hex()
    ev.send_email(body="The reading group meets on Thursday.",
                  subject=subject,
                  from_addr=f"{poster}@{ev.DOMAIN_NAME}",
                  to_addr=ev.MAILING_LIST)

    def fanout():
        for user in users:
            assert subject in subjects(user), (user, subjects(user))

    ev.retry(fanout)
    print(f"[ok] announcement delivered to all {len(users)} subscribers")

    leave(poster)
    assert subject not in []  # nothing

    # After leaving, the poster must no longer receive announcements.
    subject2 = "Announcement2 " + os.urandom(4).hex()
    ev.send_email(body="second post", subject=subject2,
                  from_addr=f"{users[1]}@{ev.DOMAIN_NAME}",
                  to_addr=ev.MAILING_LIST)
    ev.retry(lambda: (subject2 in subjects(users[1]))
             or (_ for _ in ()).throw(AssertionError(
                 ("not delivered", subjects(users[1])))))
    for _ in range(10):
        time.sleep(1)
        assert subject2 not in subjects(poster), "left user still receives mail"
    print("[ok] ex-subscriber no longer receives list mail")

    # Leave flow for the remaining member, so the test leaves no members.
    leave(users[1])
    print("members now:",
          [m.address.email for m in ev.get_mlist().members.members])
    print("ALL FLOWS PASSED")


main()
