#!/usr/bin/env python3
"""Create/repair reading-group@local.edu on this Mailman 3 instance.

Idempotent: run it as often as you like.  The list itself is created with the
official `mailman create` CLI so that every column gets the defaults Mailman
intends; this script then applies the reading-group policies on top.
"""
import subprocess

from mailman.core.initialize import initialize

CFG = "/etc/mailman3/mailman.cfg"
DOMAIN = "local.edu"
LIST = "reading-group@local.edu"

initialize(CFG)

from mailman.database.transaction import transaction                  # noqa: E402
from mailman.interfaces.action import Action                          # noqa: E402
from mailman.interfaces.domain import IDomainManager                  # noqa: E402
from mailman.interfaces.listmanager import IListManager               # noqa: E402
from mailman.interfaces.mailinglist import SubscriptionPolicy         # noqa: E402
from zope.component import getUtility                                 # noqa: E402


def mailman_cmd(*args):
    subprocess.run(['mailman', '--run-as-root', '-C', CFG, *args], check=True)


def main():
    domain_manager = getUtility(IDomainManager)
    if domain_manager.get(DOMAIN) is None:
        domain_manager.add(DOMAIN)
        print(f"created domain {DOMAIN}")

    list_manager = getUtility(IListManager)
    mlist = list_manager.get(LIST)
    if mlist is None:
        mailman_cmd('create', '--notify', '--owner', 'root@local.edu', LIST)
        mlist = list_manager.get(LIST)
        print(f"created list {LIST}")

    with transaction():
        mlist.display_name = "Reading Group"
        mlist.description = "Reading group announcements"
        # Anyone may ask to join (no owner/moderator approval), but the address
        # still has to confirm by replying to the confirmation message.
        mlist.subscription_policy = SubscriptionPolicy.open
        # Leaving likewise needs no approval, but is confirmed by reply.
        mlist.unsubscription_policy = SubscriptionPolicy.confirm
        # Announcements are accepted from members and non-members alike, and
        # nobody sits in the moderation queue.
        mlist.default_member_action = Action.accept
        mlist.default_nonmember_action = Action.accept
        mlist.admin_immed_notify = False

    # Refresh the Postfix transport table (and its postmap'ed twin).
    mailman_cmd('aliases')

    print("subscription_policy   =", mlist.subscription_policy)
    print("unsubscription_policy =", mlist.unsubscription_policy)
    print("default_member_action =", mlist.default_member_action)
    print("default_nonmember_action =", mlist.default_nonmember_action)
    print("posting address       =", mlist.posting_address)
    print("preferred_language    =", mlist.preferred_language)


main()
