#!/usr/bin/env python3
"""Edge cases: non-member posting, duplicate join, leave when not a member."""
import mailbox, os, sys
sys.path.insert(0, "/app")
import eval as ev

def subs(u):
    return [m.get("Subject", "") for m in mailbox.mbox(f"/var/mail/{u}")]

def joined(user):
    return ev.get_mlist().members.get_member(f"{user}@{ev.DOMAIN_NAME}") is not None

def leave(user):
    ev.send_email(body="", subject="", from_addr=f"{user}@{ev.DOMAIN_NAME}",
                  to_addr=ev.LEAVE_LIST)
    ev.retry(lambda: ev.confirm_last_reply(user, "leave"))
    ev.retry(lambda: not joined(user))

member = os.urandom(8).hex(); outsider = os.urandom(8).hex()
ev.add_user(member); ev.add_user(outsider)

# member joins
ev.send_email(body="", subject="", from_addr=f"{member}@{ev.DOMAIN_NAME}",
              to_addr=ev.JOIN_LIST)
ev.retry(lambda: ev.confirm_last_reply(member, "join"))
ev.retry(lambda: joined(member))
print("[ok] member joined")

# 1) non-member (never joined) posts -> must reach the subscriber
s1 = "outsider-post-" + os.urandom(4).hex()
ev.send_email(body="hello from outside", subject=s1,
              from_addr=f"{outsider}@{ev.DOMAIN_NAME}", to_addr=ev.MAILING_LIST)
ev.retry(lambda: any(s1 in x for x in subs(member)) or
         (_ for _ in ()).throw(AssertionError(subs(member))))
print("[ok] non-member post delivered to subscriber")

# 2) duplicate join is answered, list intact
before = len(list(ev.get_mlist().members.members))
ev.send_email(body="", subject="", from_addr=f"{member}@{ev.DOMAIN_NAME}",
              to_addr=ev.JOIN_LIST)
ev.retry(lambda: any("join" in (m.get("Subject","") + str(m.get_payload())).lower()
                     for m in mailbox.mbox(f"/var/mail/{member}")))
assert len(list(ev.get_mlist().members.members)) == before
print("[ok] duplicate join answered, membership unchanged")

# 3) leave when not a member is answered, no crash
ev.send_email(body="", subject="", from_addr=f"{outsider}@{ev.DOMAIN_NAME}",
              to_addr=ev.LEAVE_LIST)
ev.retry(lambda: any("leave" in (m.get("Subject","") + str(m.get_payload())).lower()
                     or "not" in str(m.get_payload()).lower()
                     for m in mailbox.mbox(f"/var/mail/{outsider}")))
print("[ok] leave from non-member answered")

# 4) list still posts afterwards
s2 = "post-after-" + os.urandom(4).hex()
ev.send_email(body="still working", subject=s2,
              from_addr=f"{outsider}@{ev.DOMAIN_NAME}", to_addr=ev.MAILING_LIST)
ev.retry(lambda: any(s2 in x for x in subs(member)) or
         (_ for _ in ()).throw(AssertionError(subs(member))))
print("[ok] list still posts after edge cases")

leave(member)
print("[ok] member left cleanly")
print("EDGE CASES PASSED")
