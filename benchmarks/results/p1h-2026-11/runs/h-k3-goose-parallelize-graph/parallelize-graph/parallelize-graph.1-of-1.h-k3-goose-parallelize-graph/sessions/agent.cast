[178.783701, "o", "    \u001b[2mUsage: upcc [options] foo.upc [ bar.c someobject.o ... ] \u001b[0m\r\n    \u001b[2mFor detailed documentation, please see man upcc(1) or https://upc.lbl.gov/docs/\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2mStandard C compiler options:\u001b[0m\r\n    \u001b[2m   -c                 Compile source files, but do not link.\u001b[0m\r\n    \u001b[2m   -DFOO[=bar]        Define preprocessor symbol FOO [to optional value].\u001b[0m\r\n    \u001b[2m   -E                 Preprocess source files (output sent to stdout).\u001b[0m\r\n    \u001b[2m   -g                 Generate debug objects/executables \u001b[0m\r\n    \u001b[2m   -I path            Add path to directories searched for header files.\u001b[0m\r\n    \u001b[2m   -lfoo              Link executable with libfoo.a.\u001b[0m\r\n    \u001b[2m\u001b[3m... (39 lines hidden, /toggle to show all)\u001b[0m\r\n    \u001b[2m   -h -? -help        Print this message.\u001b[0m\r\n    \u001b[2m   -conf=FILE         Read FILE instead of $HOME/.upccrc configuration file.\u001b[0m\r\n    \u001b[2m   -norc              Do not read $HOME/.upccrc configuration file.  \u001b[0m\r\n    \u001b[2m                      This can also be achieved by setting the UPCC_NORC\u001b[0m\r\n    \u001b[2m                      environment variable.  Overrides -conf.\u001b[0m\r\n    \u001b[2m   -smart-output      Output file name will be auto-generated based on first \u001b[0m\r\n    \u001b[2m                      .c/.upc/.o file on command line (ignored if -o passed).\u001b[0m\r\n    \u001b[2m   -V -version        Show version information.\u001b[0m\r\n    \u001b[2m   -v                 Verbose: display programs invoked by compiler.\u001b[0m\r\n    \u001b[2m   -vv                Extra verbose: pass verbose flag to programs invoked.\u001b[0m\r\n"]
[181.66648, "o", "\r\n  \u001b[2m────────────────────────────────────────\u001b[0m\r\n  \u001b[2m▸\u001b[0m \u001b[2mshell\u001b[0m\r\n    \u001b[2mcommand\u001b[0m: \u001b[32mcd /tmp && upcc -O -o h h.upc && upcrun -n 4 -shared-heap 256MB ./h; echo \"exit=$?\"; upcc -version 2>&1|head -20\u001b[0m\r\n\r\n"]
[184.022928, "o", "    \u001b[2mupcrun: nodes not specified!  See RUNNING UDP-BASED UPC JOBS in 'man upcrun'\u001b[0m\r\n    \u001b[2mexit=255\u001b[0m\r\n    \u001b[2mThis is upcc (the Berkeley Unified Parallel C compiler), v. 2022.10.0\u001b[0m\r\n    \u001b[2m  (getting remote translator settings...)\u001b[0m\r\n    \u001b[2m----------------------+---------------------------------------------------------\u001b[0m\r\n    \u001b[2m UPC Runtime          | v. 2022.10.0, built on Nov  1 2026 at 07:26:37\u001b[0m\r\n    \u001b[2m----------------------+---------------------------------------------------------\u001b[0m\r\n    \u001b[2m UPC-to-C translator  | v. 2.28.4, built on Oct 27 2022 at 22:40:34\u001b[0m\r\n    \u001b[2m                      | host 140-211-168-66-openstack.osuosl.org\u001b[0m\r\n    \u001b[2m                      | linux-powerpc/64\u001b[0m\r\n    \u001b[2m\u001b[3m... (2 lines hidden, /toggle to show all)\u001b[0m\r\n    \u001b[2m Translator location  | http://upc-translator.lbl.gov/upcc-2022.10.0.cgi\u001b[0m\r\n    \u001b[2m----------------------+---------------------------------------------------------\u001b[0m\r\n    \u001b[2m networks supported   | smp udp\u001b[0m\r\n    \u001b[2m----------------------+---------------------------------------------------------\u001b[0m\r\n    \u001b[2m default network      | udp\u001b[0m\r\n    \u001b[2m----------------------+---------------------------------------------------------\u001b[0m\r\n    \u001b[2m pthreads support     | available (if used, default is 2 pthreads per process)\u001b[0m\r\n    \u001b[2m----------------------+---------------------------------------------------------\u001b[0m\r\n    \u001b[2m Configured with      | '--with-translator=http://upc-translator.lbl.gov/upcc-2\u001b[0m\r\n    \u001b[2m                      | 022.10.0.cgi' '--disable-mpi' '--enable-smp'\u001b[0m\r\n"]
[196.028133, "o", "\r\n  \u001b[2m────────────────────────────────────────\u001b[0m\r\n  \u001b[2m▸\u001b[0m \u001b[2mshell\u001b[0m\r\n    \u001b[2mcommand\u001b[0m: \u001b[32mcd /tmp && upcc -O -network=smp -o h2 h.upc && echo built; upcrun -n 4 -shared-heap 256MB ./h2; echo \"exit=$?\"\u001b[0m\r\n\r\n"]
[198.398158, "o", "    \u001b[2mbuilt\u001b[0m\r\n    \u001b[2mUPCR: UPC thread 0 of 4 on ef574e37916b (pshm node 0 of 1, process 0 of 4, pid=28383)\u001b[0m\r\n    \u001b[2mUPCR: UPC thread 1 of 4 on ef574e37916b (pshm node 0 of 1, process 1 of 4, pid=28401)\u001b[0m\r\n    \u001b[2mUPCR: UPC thread 3 of 4 on ef574e37916b (pshm node 0 of 1, process 3 of 4, pid=28403)\u001b[0m\r\n    \u001b[2mUPCR: UPC thread 2 of 4 on ef574e37916b (pshm node 0 of 1, process 2 of 4, pid=28402)\u001b[0m\r\n    \u001b[2mUPC Runtime warning: Requested shared memory (256 MB) > available (9 MB) on node 0 (ef574e37916b): using 9 MB per thread instead\u001b[0m\r\n    \u001b[2m0 1 2 3 \u001b[0m\r\n    \u001b[2mexit=0\u001b[0m\r\n"]
[204.08933, "o", "\r\n  \u001b[2m────────────────────────────────────────\u001b[0m\r\n  \u001b[2m▸\u001b[0m \u001b[2mshell\u001b[0m\r\n    \u001b[2mcommand\u001b[0m: \u001b[32mupcrun --help 2>&1 | head -50; echo ===; df -h /dev/shm; echo ===; ls /usr/local/upc 2>/dev/null | head\u001b[0m\r\n\r\n"]
[204.148927, "o", "    \u001b[2mUsage: upcrun [options] program-name [ program-arguments ... ] \u001b[0m\r\n    \u001b[2mFor detailed documentation, please see man upcrun(1)\u001b[0m\r\n    \u001b[2mor visit https://upc.lbl.gov/docs/\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2mOptions:\u001b[0m\r\n    \u001b[2m    -h -? -help\u001b[0m\r\n    \u001b[2m            See this message\u001b[0m\r\n    \u001b[2m    -help-gasnet [network_name]\u001b[0m\r\n    \u001b[2m            See the GASNet documentation, or the GASNet documentation\u001b[0m\r\n    \u001b[2m            for a particular network conduit.\u001b[0m\r\n    \u001b[2m\u001b[3m... (34 lines hidden, /toggle to show all)\u001b[0m\r\n    \u001b[2m            which will be different if pthreads is also in use.\u001b[0m\r\n    \u001b[2m            A value of 0 (the default) means no limit is imposed.\u001b[0m\r\n    \u001b[2m            A value of 1 essentially disables PSHM.\u001b[0m\r\n    \u001b[2m    -bind-threads\u001b[0m\r\n    \u001b[2m            Bind (aka pin) UPC threads to processors.\u001b[0m\r\n    \u001b[2m            (Silently ignored on unsupported platforms).\u001b[0m\r\n    \u001b[2m===\u001b[0m\r\n    \u001b[2mFilesystem      Size  Used Avail Use% Mounted on\u001b[0m\r\n    \u001b[2mshm              64M   24K   64M   1% /dev/shm\u001b[0m\r\n    \u001b[2m===\u001b[0m\r\n"]
[213.803684, "o", "\r\n  \u001b[2m────────────────────────────────────────\u001b[0m\r\n  \u001b[2m▸\u001b[0m \u001b[2mshell\u001b[0m\r\n    \u001b[2mcommand\u001b[0m: \u001b[32mupcc --help 2>&1 | grep -i -A3 pthread; echo ===; mount -o remount,size=2G /dev/shm 2>&1; df -h /dev/shm\u001b[0m\r\n\r\n"]
[213.864598, "o", "    \u001b[2m                      threads.  (Available only for '-network=smp -pthreads')\u001b[0m\r\n    \u001b[2m\t\t      If available, on by default if -T passed a power-of-two value.\u001b[0m\r\n    \u001b[2m   -opt-enable=OPT1[,OPT2]\u001b[0m\r\n    \u001b[2m   -opt-disable=OPT3[,OPT4]\u001b[0m\r\n    \u001b[2m--\u001b[0m\r\n    \u001b[2m   -[no]link-cache    Disable the use of the pthread-link cache directory used \u001b[0m\r\n    \u001b[2m                      to speed up linking of multi-file pthread applications.\u001b[0m\r\n    \u001b[2m   -link-with <PROG>  Use PROG to as the back-end linker.  Use to combine\u001b[0m\r\n    \u001b[2m                      UPC code with external C++ and/or MPI code.\u001b[0m\r\n    \u001b[2m   -nightly           Use nightly build of UPC-to-C translator at\u001b[0m\r\n    \u001b[2m\u001b[3m... (9 lines hidden, /toggle to show all)\u001b[0m\r\n    \u001b[2m                      UPC_PTHREADS_MAP environment variables).  A value of\u001b[0m\r\n    \u001b[2m                      N=0 disables creation of a pthreaded executable.\u001b[0m\r\n    \u001b[2m   -[no]require-size  Die at startup if amount of shared memory available is\u001b[0m\r\n    \u001b[2m                      less than requested: off by default. Can be overridden at \u001b[0m\r\n    \u001b[2m                      startup by setting the UPC_REQUIRE_SHARED_SIZE \u001b[0m\r\n    \u001b[2m===\u001b[0m\r\n    \u001b[2mmount: /dev/shm: permission denied.\u001b[0m\r\n    \u001b[2m       dmesg(1) may have more information after failed mount system call.\u001b[0m\r\n    \u001b[2mFilesystem      Size  Used Avail Use% Mounted on\u001b[0m\r\n    \u001b[2mshm              64M   24K   64M   1% /dev/shm\u001b[0m\r\n"]
