[927.70695, "o", "    \u001b[2mrm -f serial pgen pgen_*.out serial.out\u001b[0m\r\n    \u001b[2mcc -O2 -Wall -o serial serial.c \u001b[0m\r\n    \u001b[2mupcc -O -network=smp -pthreads=32 -o pgen pgen.upc\u001b[0m\r\n    \u001b[2m=== serial ===\u001b[0m\r\n    \u001b[2mserial: 10000 k-mers, k=19 -> /app/serial.out\u001b[0m\r\n    \u001b[2m=== parallel (8 threads) ===\u001b[0m\r\n    \u001b[2mUPC Runtime warning: Requested shared memory (2048 MB) > available (56 MB) on node 0 (ef574e37916b): using 7 MB per thread instead\u001b[0m\r\n    \u001b[2mthread 7: 1251 nodes, 0 contigs -> /app/pgen_7.out\u001b[0m\r\n    \u001b[2mthread 6: 1233 nodes, 0 contigs -> /app/pgen_6.out\u001b[0m\r\n    \u001b[2mthread 5: 1223 nodes, 2 contigs -> /app/pgen_5.out\u001b[0m\r\n    \u001b[2m\u001b[3m... (8 lines hidden, /toggle to show all)\u001b[0m\r\n    \u001b[2m10108 total bases\u001b[0m\r\n    \u001b[2m-rw-r--r-- 1 root root  1468 Nov  1 07:40 /app/pgen_0.out\u001b[0m\r\n    \u001b[2m-rw-r--r-- 1 root root  3591 Nov  1 07:40 /app/pgen_1.out\u001b[0m\r\n    \u001b[2m-rw-r--r-- 1 root root     0 Nov  1 07:40 /app/pgen_2.out\u001b[0m\r\n    \u001b[2m-rw-r--r-- 1 root root   381 Nov  1 07:40 /app/pgen_3.out\u001b[0m\r\n    \u001b[2m-rw-r--r-- 1 root root   228 Nov  1 07:40 /app/pgen_4.out\u001b[0m\r\n    \u001b[2m-rw-r--r-- 1 root root  4446 Nov  1 07:40 /app/pgen_5.out\u001b[0m\r\n    \u001b[2m-rw-r--r-- 1 root root     0 Nov  1 07:40 /app/pgen_6.out\u001b[0m\r\n    \u001b[2m-rw-r--r-- 1 root root     0 Nov  1 07:40 /app/pgen_7.out\u001b[0m\r\n    \u001b[2m-rw-r--r-- 1 root root 10114 Nov  1 07:40 /app/serial.out\u001b[0m\r\n"]
