[890.494664, "o", "    \u001b[2m/*\u001b[0m\r\n    \u001b[2m * Parallel (UPC) de Bruijn graph construction and traversal for genome\u001b[0m\r\n    \u001b[2m * assembly.\u001b[0m\r\n    \u001b[2m *\u001b[0m\r\n    \u001b[2m *   input : one line per unique k-mer:  <KMER>\\t<LEFT_EXT><RIGHT_EXT>\u001b[0m\r\n    \u001b[2m *           extension characters in {A,C,G,T}, 'F' meaning \"no extension\".\u001b[0m\r\n    \u001b[2m *   output: /app/pgen_<MYTHREAD>.out -- one DNA contig per line.\u001b[0m\r\n    \u001b[2m *\u001b[0m\r\n    \u001b[2m * Parallelisation strategy (following Georganas et al., SC'14):\u001b[0m\r\n    \u001b[2m *\u001b[0m\r\n    \u001b[2m\u001b[3m... (100 lines hidden, /toggle to show all)\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2mstatic inline int owner_of_bucket(long b) { return (int)(b / buckPerThread); }\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2m/* --------------------------- table lookups ----------------------------- */\u001b[0m\r\n    \u001b[2mstatic int32_t lookup(uint64_t kmer)\u001b[0m\r\n    \u001b[2m{\u001b[0m\r\n    \u001b[2m    long b = bucket_of(kmer);\u001b[0m\r\n    \u001b[2m    for (int32_t i = s_buckets[b]; i >= 0; i = s_next[i])\u001b[0m\r\n    \u001b[2m        if (s_kmer[i] == kmer)\u001b[0m\r\n    \u001b[2m            return i;\u001b[0m\r\n"]
[891.975701, "o", "\r\n  \u001b[2m────────────────────────────────────────\u001b[0m\r\n  \u001b[2m▸\u001b[0m \u001b[2mshell\u001b[0m\r\n    \u001b[2mcommand\u001b[0m: \u001b[32mcd /app && sed -n '120,300p' pgen.upc\u001b[0m\r\n\r\n"]
[891.991196, "o", "    \u001b[2m            return i;\u001b[0m\r\n    \u001b[2m    return -1;\u001b[0m\r\n    \u001b[2m}\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2mstatic int32_t successor(int32_t i)\u001b[0m\r\n    \u001b[2m{\u001b[0m\r\n    \u001b[2m    char r = s_rext[i];\u001b[0m\r\n    \u001b[2m    if (r == 'F')\u001b[0m\r\n    \u001b[2m        return -1;\u001b[0m\r\n    \u001b[2m    uint64_t mask = ((uint64_t)1 << (2 * (K - 1))) - 1ULL;\u001b[0m\r\n    \u001b[2m\u001b[3m... (161 lines hidden, /toggle to show all)\u001b[0m\r\n    \u001b[2m        long b = bucket_of(lkey[i]);\u001b[0m\r\n    \u001b[2m        int  d = owner_of_bucket(b);\u001b[0m\r\n    \u001b[2m        long idx = (long)d * localMax + base[d] + used[d]++;\u001b[0m\r\n    \u001b[2m        s_kmer[idx] = lkey[i];\u001b[0m\r\n    \u001b[2m        s_lext[idx] = (char)llex[i];\u001b[0m\r\n    \u001b[2m        s_rext[idx] = (char)lrex[i];\u001b[0m\r\n    \u001b[2m        s_next[idx] = -1;\u001b[0m\r\n    \u001b[2m    }\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2m    upc_barrier;\u001b[0m\r\n"]
[899.817687, "o", "\r\n  \u001b[2m────────────────────────────────────────\u001b[0m\r\n  \u001b[2m▸\u001b[0m \u001b[2mshell\u001b[0m\r\n    \u001b[2mcommand\u001b[0m: \u001b[32mcd /app && sed -n '300,420p' pgen.upc\u001b[0m\r\n\r\n"]
[899.838244, "o", "    \u001b[2m    upc_barrier;\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2m    /* ---- build the chains of my own buckets (purely local) ----------- */\u001b[0m\r\n    \u001b[2m    myBegin = (long)MYTHREAD * localMax;\u001b[0m\r\n    \u001b[2m    myCnt   = sh_tot[MYTHREAD];\u001b[0m\r\n    \u001b[2m    for (long i = myBegin; i < myBegin + myCnt; i++) {\u001b[0m\r\n    \u001b[2m        long b = bucket_of(s_kmer[i]);\u001b[0m\r\n    \u001b[2m        s_next[i] = s_buckets[b];\u001b[0m\r\n    \u001b[2m        s_buckets[b] = (int32_t)i;\u001b[0m\r\n    \u001b[2m    }\u001b[0m\r\n    \u001b[2m\u001b[3m... (100 lines hidden, /toggle to show all)\u001b[0m\r\n    \u001b[2m    upc_barrier;\u001b[0m\r\n    \u001b[2m    /* all threads agree on k (it is a property of the input) */\u001b[0m\r\n    \u001b[2m    {\u001b[0m\r\n    \u001b[2m        shared int *sh_k = (shared int *)upc_all_alloc(1, sizeof(int));\u001b[0m\r\n    \u001b[2m        if (MYTHREAD == 0) *sh_k = K;\u001b[0m\r\n    \u001b[2m        upc_barrier;\u001b[0m\r\n    \u001b[2m        K = *sh_k;\u001b[0m\r\n    \u001b[2m        upc_barrier;\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2m    }\u001b[0m\r\n"]
