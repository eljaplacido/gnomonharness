[14.957556, "o", "\r\n  \u001b[2m────────────────────────────────────────\u001b[0m\r\n  \u001b[2m▸\u001b[0m \u001b[2mshell\u001b[0m\r\n"]
[14.957694, "o", "    \u001b[2mcommand\u001b[0m: \u001b[32mpwd; ls -la /app; echo \"---\"; head -5 /app/test; echo \"---\"; wc -l /app/test\u001b[0m\r\n\r\n\r\n  \u001b[2m────────────────────────────────────────\u001b[0m\r\n  \u001b[2m▸\u001b[0m \u001b[2mshell\u001b[0m\r\n    \u001b[2mcommand\u001b[0m: \u001b[32mwhich upc gcc g++ make gfortran perl 2>/dev/null; echo \"---\"; cat /etc/os-release | head -3; echo \"---\"; nproc; free -g | head -2\u001b[0m\r\n\r\n"]
[14.982154, "o", "    \u001b[2m/app\u001b[0m\r\n    \u001b[2mtotal 236\u001b[0m\r\n    \u001b[2mdrwxr-xr-x 1 root root   4096 Nov  1 07:25 .\u001b[0m\r\n    \u001b[2mdrwxr-xr-x 1 root root   4096 Nov  1 07:25 ..\u001b[0m\r\n    \u001b[2m-rw-rw-r-- 1 root root 230000 Oct 31 09:48 test\u001b[0m\r\n    \u001b[2m---\u001b[0m\r\n    \u001b[2mATAGCCAGTGCCTGATACT\tFG\u001b[0m\r\n    \u001b[2mTAGCCAGTGCCTGATACTG\tAG\u001b[0m\r\n    \u001b[2mAGCCAGTGCCTGATACTGG\tTC\u001b[0m\r\n    \u001b[2mGCCAGTGCCTGATACTGGC\tAT\u001b[0m\r\n    \u001b[2mCCAGTGCCTGATACTGGCT\tGG\u001b[0m\r\n    \u001b[2m---\u001b[0m\r\n    \u001b[2m10000 /app/test\u001b[0m\r\n    \u001b[2m/usr/bin/gcc\u001b[0m\r\n    \u001b[2m/usr/bin/g++\u001b[0m\r\n    \u001b[2m/usr/bin/make\u001b[0m\r\n    \u001b[2m/usr/bin/perl\u001b[0m\r\n    \u001b[2m---\u001b[0m\r\n    \u001b[2mPRETTY_NAME=\"Ubuntu 24.04.2 LTS\"\u001b[0m\r\n    \u001b[2mNAME=\"Ubuntu\"\u001b[0m\r\n    \u001b[2mVERSION_ID=\"24.04\"\u001b[0m\r\n"]
[14.982194, "o", "    \u001b[2m---\u001b[0m\r\n    \u001b[2m20\u001b[0m\r\n    \u001b[2m               total        used        free      shared  buff/cache   available\u001b[0m\r\n    \u001b[2mMem:             121          56          36           0          30          65\u001b[0m\r\n"]
[17.566692, "o", "\r\n  \u001b[2m────────────────────────────────────────\u001b[0m\r\n  \u001b[2m▸\u001b[0m \u001b[2mshell\u001b[0m\r\n    \u001b[2mcommand\u001b[0m: \u001b[32mcd /app; awk -F'\\t' '{print length($1)}' test | sort -u; echo \"---\"; awk -F'\\t' '{print $2}' test | sort | uniq -c; echo \"---\"; sort test | uniq...\u001b[0m\r\n\r\n\r\n  \u001b[2m────────────────────────────────────────\u001b[0m\r\n  \u001b[2m▸\u001b[0m \u001b[2mshell\u001b[0m\r\n    \u001b[2mcommand\u001b[0m: \u001b[32mcd /tmp && timeout 60 curl -sI https://upc.lbl.gov/download/release/berkeley_upc-2022.10.0.tar.gz | head -20\u001b[0m\r\n\r\n"]
[17.62926, "o", "    \u001b[2m19\u001b[0m\r\n    \u001b[2m---\u001b[0m\r\n    \u001b[2m    664 AA\u001b[0m\r\n    \u001b[2m    685 AC\u001b[0m\r\n    \u001b[2m      2 AF\u001b[0m\r\n    \u001b[2m    618 AG\u001b[0m\r\n    \u001b[2m    627 AT\u001b[0m\r\n    \u001b[2m    620 CA\u001b[0m\r\n    \u001b[2m    577 CC\u001b[0m\r\n    \u001b[2m      1 CF\u001b[0m\r\n    \u001b[2m\u001b[3m... (8 lines hidden, /toggle to show all)\u001b[0m\r\n    \u001b[2m    620 GG\u001b[0m\r\n    \u001b[2m    626 GT\u001b[0m\r\n    \u001b[2m    676 TA\u001b[0m\r\n    \u001b[2m    577 TC\u001b[0m\r\n    \u001b[2m      1 TF\u001b[0m\r\n    \u001b[2m    615 TG\u001b[0m\r\n    \u001b[2m    600 TT\u001b[0m\r\n    \u001b[2m---\u001b[0m\r\n    \u001b[2m--- dup count:\u001b[0m\r\n    \u001b[2m0\u001b[0m\r\n"]
