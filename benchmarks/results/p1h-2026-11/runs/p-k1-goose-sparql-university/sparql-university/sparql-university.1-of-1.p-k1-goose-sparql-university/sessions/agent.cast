[71.257592, "o", "    \u001b[2m['professorName', 'countries']\u001b[0m\r\n    \u001b[2mAristotle Tympas | GR\u001b[0m\r\n    \u001b[2mOrfeas Menis | GR, US\u001b[0m\r\n    \u001b[2mPepe Attanasio | PT, GR\u001b[0m\r\n    \u001b[2m---- file ----\u001b[0m\r\n    \u001b[2mPREFIX uni: <http://university.org/ontology/>\u001b[0m\r\n    \u001b[2mPREFIX xsd: <http://www.w3.org/2001/XMLSchema#>\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2m# Reference date (\"today\"): 2025-08-16\u001b[0m\r\n    \u001b[2m#\u001b[0m\r\n    \u001b[2m# Criteria:\u001b[0m\r\n    \u001b[2m#  1. Full professors (\"Professor of ...\" and not \"Assistant/Associate Professor of ...\")\u001b[0m\r\n    \u001b[2m#  2. Work in at least one department of a university located in an EU member state\u001b[0m\r\n    \u001b[2m#     (official EU members as of 2025-08-16 -> the 27 ISO alpha-2 codes below)\u001b[0m\r\n    \u001b[2m#  3. At least one of the departments they work in has more than 10 students\u001b[0m\r\n    \u001b[2m#     CURRENTLY enrolled in classes taught in that department\u001b[0m\r\n    \u001b[2m#     (enrolled on or before today and not yet graduated as of today)\u001b[0m\r\n"]
[72.304693, "o", "\u001b[37mThe query is saved to \u001b[0m"]
[72.349075, "o", "\u001b[32m`\u001b[0m\u001b[32m/app/solution.sparql\u001b[0m\u001b[32m`\u001b[0m\u001b[37m and verified against\u001b[0m"]
[72.385078, "o", "\u001b[37m the graph\u001b[0m"]
[72.408659, "o", "\u001b[37m with\u001b[0m"]
[72.45496, "o", "\u001b[37m rdflib.\u001b[0m\r\n\r\n"]
[72.501155, "o", "\u001b[34m##\u001b[0m\u001b[37m \u001b[0m\u001b[34mQuery\u001b[0m\r\n"]
[74.918236, "o", "\r\n"]
[74.918784, "o", "\u001b[37m```\u001b[0m\u001b[38;5;9msparql\u001b[0m\r\n\u001b[37mSELECT ?professorName (GROUP_CONCAT(DISTINCT ?country; separator=\", \") AS ?countries)\u001b[0m\r\n\u001b[37mWHERE {\u001b[0m\r\n\u001b[37m  ?professor a uni:Person ;\u001b[0m\r\n\u001b[37m             uni:hasName ?professorName ;\u001b[0m\r\n\u001b[37m             uni:role ?role ;\u001b[0m\r\n"]
[74.918845, "o", "\u001b[37m             uni:worksIn ?dept .\u001b[0m\r\n\r\n\u001b[37m  # 1. full professor (excludes \"Assistant/Associate Professor ...\")\u001b[0m\r\n\u001b[37m  FILTER(STRSTARTS(?role, \"Professor\"))\u001b[0m\r\n\r\n\u001b[37m  ?dept uni:belongsTo ?university .\u001b[0m\r\n\u001b[37m  ?university uni:locatedInCountry ?country .\u001b[0m\r\n"]
[74.918883, "o", "\r\n\u001b[37m  # 2. at least one department of a university in an EU member state (27 codes as of 2025-08-16)\u001b[0m\r\n\u001b[37m  FILTER EXISTS {\u001b[0m\r\n\u001b[37m    ?professor uni:worksIn ?euDept .\u001b[0m\r\n"]
[74.918918, "o", "\u001b[37m    ?euDept uni:belongsTo ?euUniversity .\u001b[0m\r\n\u001b[37m    ?euUniversity uni:locatedInCountry ?euCountry .\u001b[0m\r\n\u001b[37m    VALUES ?euCountry { \"AT\" \"BE\" \"BG\" \"HR\" \"CY\" \"CZ\" \"DK\" \"EE\" \"FI\" \"FR\" \"DE\" \"GR\"\u001b[0m\r\n\u001b[37m                        \"HU\" \"IE\" \"IT\" \"LV\" \"LT\" \"LU\" \"MT\" \"NL\" \"PL\" \"PT\" \"RO\" \"SK\"\u001b[0m\r\n\u001b[37m                        \"SI\" \"ES\" \"SE\" }\u001b[0m\r\n"]
[74.918945, "o", "\u001b[37m  }\u001b[0m\r\n\r\n"]
[74.919069, "o", "\u001b[37m  # 3. some department of the professor has > 10 currently enrolled students\u001b[0m\r\n\u001b[37m  FILTER EXISTS {\u001b[0m\r\n\u001b[37m    ?professor uni:worksIn ?bigDept .\u001b[0m\r\n\u001b[37m    {\u001b[0m\r\n\u001b[37m      SELECT ?bigDept (COUNT(DISTINCT ?student) AS ?enrolledCount)\u001b[0m\r\n\u001b[37m      WHERE {\u001b[0m\r\n\u001b[37m        ?offeredCourse uni:isTaughtIn ?bigDept .\u001b[0m\r\n\u001b[37m        ?student uni:isEnrolledIn ?offeredCourse ;\u001b[0m\r\n\u001b[37m                 uni:hasEnrollmentDate ?enrollmentDate .\u001b[0m\r\n\u001b[37m        FILTER(?enrollmentDate <= \"2025-08-16\"^^xsd:date)\u001b[0m\r\n\u001b[37m        OPTIONAL { ?student uni:hasGraduationDate ?graduationDate }\u001b[0m\r\n\u001b[37m        FILTER(!BOUND(?graduationDate) || ?graduationDate > \"2025-08-16\"^^xsd:date)\u001b[0m\r\n\u001b[37m      }\u001b[0m\r\n\u001b[37m      GROUP BY ?bigDept\u001b[0m\r\n\u001b[37m      HAVING (COUNT(DISTINCT ?student) > 10)\u001b[0m\r\n\u001b[37m    }\u001b[0m\r\n\u001b[37m  }\u001b[0m\r\n"]
[74.919101, "o", "\u001b[37m}\u001b[0m\r\n\u001b[37mGROUP BY ?professorName\u001b[0m\r\n\u001b[37mORDER BY ?professorName\u001b[0m\r\n"]
[74.91914, "o", "\u001b[37m```\u001b[0m\r\n\r\n"]
[74.956041, "o", "\u001b[34m##\u001b[0m\u001b[37m \u001b[0m\u001b[34mKey design points\u001b[0m\r\n\r\n"]
