[34m##[0m[37m [0m[34mQuery[0m

[37m```[0m[38;5;9msparql[0m
[37mSELECT ?professorName (GROUP_CONCAT(DISTINCT ?country; separator=", ") AS ?countries)[0m
[37mWHERE {[0m
[37m  ?professor a uni:Person ;[0m
[37m             uni:hasName ?professorName ;[0m
[37m             uni:role ?role ;[0m
[37m             uni:worksIn ?dept .[0m

[37m  # 1. full professor (excludes "Assistant/Associate Professor ...")[0m
[37m  FILTER(STRSTARTS(?role, "Professor"))[0m

[37m  ?dept uni:belongsTo ?university .[0m
[37m  ?university uni:locatedInCountry ?country .[0m

[37m  # 2. at least one department of a university in an EU member state (27 codes as of 2025-08-16)[0m
[37m  FILTER EXISTS {[0m
[37m    ?professor uni:worksIn ?euDept .[0m
[37m    ?euDept uni:belongsTo ?euUniversity .[0m
[37m    ?euUniversity uni:locatedInCountry ?euCountry .[0m
[37m    VALUES ?euCountry { "AT" "BE" "BG" "HR" "CY" "CZ" "DK" "EE" "FI" "FR" "DE" "GR"[0m
[37m                        "HU" "IE" "IT" "LV" "LT" "LU" "MT" "NL" "PL" "PT" "RO" "SK"[0m
[37m                        "SI" "ES" "SE" }[0m
[37m  }[0m

[37m  # 3. some department of the professor has > 10 currently enrolled students[0m
[37m  FILTER EXISTS {[0m
[37m    ?professor uni:worksIn ?bigDept .[0m
[37m    {[0m
[37m      SELECT ?bigDept (COUNT(DISTINCT ?student) AS ?enrolledCount)[0m
[37m      WHERE {[0m
[37m        ?offeredCourse uni:isTaughtIn ?bigDept .[0m
[37m        ?student uni:isEnrolledIn ?offeredCourse ;[0m
[37m                 uni:hasEnrollmentDate ?enrollmentDate .[0m
[37m        FILTER(?enrollmentDate <= "2025-08-16"^^xsd:date)[0m
[37m        OPTIONAL { ?student uni:hasGraduationDate ?graduationDate }[0m
[37m        FILTER(!BOUND(?graduationDate) || ?graduationDate > "2025-08-16"^^xsd:date)[0m
[37m      }[0m
[37m      GROUP BY ?bigDept[0m
[37m      HAVING (COUNT(DISTINCT ?student) > 10)[0m
[37m    }[0m
[37m  }[0m
[37m}[0m
[37mGROUP BY ?professorName[0m
[37mORDER BY ?professorName[0m
