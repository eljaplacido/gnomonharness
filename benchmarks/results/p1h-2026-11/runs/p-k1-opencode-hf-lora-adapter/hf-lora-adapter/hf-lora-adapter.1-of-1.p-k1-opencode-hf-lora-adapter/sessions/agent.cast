[159.766797, "o", "\u001b[0m$ \u001b[0mcd /app && cp /app/base_download/sentencepiece.bpe.model /app/model_cache/xlm-roberta-base/ && cp /app/base_download/sentencepiece.bpe.model /app/merged_model/\r\npython3 - <<'EOF'\r\nimport json, os\r\nstm = {\"bos_token\": \"<s>\", \"eos_token\": \"</s>\", \"unk_token\": \"<unk>\", \"sep_token\": \"</s>\", \"pad_token\": \"<pad>\", \"cls_token\": \"<s>\", \"mask_token\": \"<mask>\"}\r\nfor d in [\"/app/model_cache/xlm-roberta-base\", \"/app/merged_model\"]:\r\n    with open(os.path.join(d, \"special_tokens_map.json\"), \"w\") as f:\r\n        json.dump(stm, f, indent=2)\r\nprint(os.listdir(\"/app/merged_model\"))\r\nEOF\r\n['sentencepiece.bpe.model', 'model.safetensors', 'config.json', 'tokenizer_config.json', 'tokenizer.json', 'special_tokens_map.json']\r\n"]
[161.156174, "o", "> build · deepseek-v4.1-flash\r\n"]
[179.381666, "o", "\u001b[0m$ \u001b[0mcd /app && python3 - <<'EOF' 2>&1 | grep -v \"Loading weights\"\r\nimport json, torch\r\nfrom transformers import AutoTokenizer, XLMRobertaForSequenceClassification\r\nfor d in [\"/app/model_cache/xlm-roberta-base\", \"/app/merged_model\"]:\r\n    tok = AutoTokenizer.from_pretrained(d)\r\n    tok_slow = AutoTokenizer.from_pretrained(d, use_fast=False)\r\n    m = XLMRobertaForSequenceClassification.from_pretrained(d).eval()\r\n    print(d, \"| labels:\", m.config.num_labels, \"| tokenizers ok:\", tok(\"hi\")[\"input_ids\"] == tok_slow(\"hi\")[\"input_ids\"], \"| params:\", sum(p.numel() for p in m.parameters()))\r\nres = json.load(open(\"/app/detection_results.json\"))\r\ntok = AutoTokenizer.from_pretrained(\"/app/merged_model\")\r\nm = XLMRobertaForSequenceClassification.from_pretrained(\"/app/merged_model\").eval()\r\nok = True\r\nfor r in res:\r\n    with torch.no_grad():\r\n        lg = m(**tok(r[\"text\"], return_tensors=\"pt\")).logits\r\n    cid = int(lg.argmax(-1)); conf = float(torch.softmax(lg,-1)[0,cid])\r\n    match = cid == r[\"predicted_class_id\"] "]
[179.381781, "o", "and abs(conf - r[\"confidence\"]) < 1e-4\r\n    ok &= match\r\nprint(\"results reproduce:\", ok, \"| entries:\", len(res), \"| keys:\", sorted(res[0]))\r\nEOF\r\n/app/model_cache/xlm-roberta-base | labels: 20 | tokenizers ok: True | params: 278059028\r\n/app/merged_model | labels: 20 | tokenizers ok: True | params: 278059028\r\nresults reproduce: True | entries: 10 | keys: ['confidence', 'predicted_class_id', 'text']\r\n"]
[180.483123, "o", "> build · deepseek-v4.1-flash\r\n"]
