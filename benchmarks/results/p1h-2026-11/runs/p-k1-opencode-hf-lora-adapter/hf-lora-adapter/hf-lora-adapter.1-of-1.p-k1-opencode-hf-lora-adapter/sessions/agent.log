ok = True
for r in res:
    with torch.no_grad():
        lg = m(**tok(r["text"], return_tensors="pt")).logits
    cid = int(lg.argmax(-1)); conf = float(torch.softmax(lg,-1)[0,cid])
    match = cid == r["predicted_class_id"] and abs(conf - r["confidence"]) < 1e-4
    ok &= match
print("results reproduce:", ok, "| entries:", len(res), "| keys:", sorted(res[0]))
