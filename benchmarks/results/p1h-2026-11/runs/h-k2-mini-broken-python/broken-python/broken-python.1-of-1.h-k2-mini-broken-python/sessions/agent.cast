[81.012865, "o", "<returncode>\r\n0\r\n<output>\r\n/tmp/testpkg-0.0.1-py3-none-any.whl\r\n--- pip health ---\r\npip 24.3.1 from /usr/local/lib/python3.13/site-packages/pip (python 3.13)\r\nenv_var:\r\n  PIP_PROGRESS_BAR='off'\r\nenv:\r\nglobal:\r\n  /etc/xdg/pip/pip.conf, exists: False\r\n  /etc/pip.conf, exists: False\r\nsite:\r\n  /usr/local/pip.conf, exists: False\r\nuser:\r\n  /root/.pip/pip.conf, exists: False\r\n  /root/.config/pip/pip.conf, exists: False\r\n--- install wheel ---\r\nProcessing /tmp/testpkg-0.0.1-py3-none-any.whl\r\nInstalling collected packages: testpkg\r\nSuccessfully installed testpkg-0.0.1\r\nWARNING: Running pip as the 'root' user can result in broken permissions and conflicting behaviour with the system package manager, possibly rendering your \r\nsystem unusable.It is recommended to use a virtual environment instead: https://pip.pypa.io/warnings/venv. Use the --root-user-action option if you know what \r\nyou are doing and want to suppress this warning.\r\n--- import installed package ---\r\npip repair verified\r\nName: testpkg\r\nVersion: 0.0.1\r\nSumm"]
[81.012891, "o", "ary: Local verification package\r\nHome-page: \r\nAuthor: \r\nAuthor-email: \r\nLicense: \r\nLocation: /usr/local/lib/python3.13/site-packages\r\nRequires: \r\nRequired-by: \r\n--- uninstall test package ---\r\nFound existing installation: testpkg 0.0.1\r\nUninstalling testpkg-0.0.1:\r\n  Successfully uninstalled testpkg-0.0.1\r\nWARNING: Running pip as the 'root' user can result in broken permissions and conflicting behaviour with the system package manager, possibly rendering your \r\nsystem unusable.It is recommended to use a virtual environment instead: https://pip.pypa.io/warnings/venv. Use the --root-user-action option if you know what \r\nyou are doing and want to suppress this warning.\r\ntest package successfully uninstalled\r\n\r\n"]
