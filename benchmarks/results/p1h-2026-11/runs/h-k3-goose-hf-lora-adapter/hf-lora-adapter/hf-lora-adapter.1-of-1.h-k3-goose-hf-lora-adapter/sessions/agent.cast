[16.847165, "o", "    \u001b[2mcommand\u001b[0m: \u001b[32mpwd; ls -la /app; python3 -c \"import torch, transformers; print(torch.__version__, transformers.__version__)\" 2>&1 | head -5; nvidia-smi 2>&1 | ...\u001b[0m\r\n\r\n\r\n  \u001b[2m────────────────────────────────────────\u001b[0m\r\n  \u001b[2m▸\u001b[0m \u001b[2mshell\u001b[0m\r\n    \u001b[2mcommand\u001b[0m: \u001b[32mpython3 -c \"import peft; print(peft.__version__)\" 2>&1; df -h /app | tail -2; ls ~/.cache/huggingface 2>&1\u001b[0m\r\n\r\n"]
[16.961331, "o", "    \u001b[2mTraceback (most recent call last):\u001b[0m\r\n    \u001b[2m  File \"<string>\", line 1, in <module>\u001b[0m\r\n    \u001b[2m    import peft; print(peft.__version__)\u001b[0m\r\n    \u001b[2m    ^^^^^^^^^^^\u001b[0m\r\n    \u001b[2mModuleNotFoundError: No module named 'peft'\u001b[0m\r\n    \u001b[2mFilesystem      Size  Used Avail Use% Mounted on\u001b[0m\r\n    \u001b[2moverlay         1.8T  1.6T  199G  89% /\u001b[0m\r\n    \u001b[2mls: cannot access '/root/.cache/huggingface': No such file or directory\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2mCommand exited with code 2\u001b[0m\r\n    \u001b[2m/app\u001b[0m\r\n    \u001b[2mtotal 8\u001b[0m\r\n    \u001b[2mdrwxr-xr-x 1 root root 4096 Nov  1 07:09 .\u001b[0m\r\n    \u001b[2mdrwxr-xr-x 1 root root 4096 Nov  1 07:09 ..\u001b[0m\r\n    \u001b[2mTraceback (most recent call last):\u001b[0m\r\n    \u001b[2m  File \"<string>\", line 1, in <module>\u001b[0m\r\n    \u001b[2m    import torch, transformers; print(torch.__version__, transformers.__version__)\u001b[0m\r\n    \u001b[2m    ^^^^^^^^^^^^^^^^^^^^^^^^^^\u001b[0m\r\n    \u001b[2mModuleNotFoundError: No module named 'torch'\u001b[0m\r\n    \u001b[2mbash: line 1: nvidia-smi: command not found\u001b[0m\r\n"]
