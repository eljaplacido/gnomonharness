[21.009282, "o", "\r\n  \u001b[2m────────────────────────────────────────\u001b[0m\r\n  \u001b[2m▸\u001b[0m \u001b[2mshell\u001b[0m\r\n    \u001b[2mcommand\u001b[0m: \u001b[32mcd /app && pip --version && timeout 60 pip download --no-deps --dest /tmp/piptest transformers==4.44.2 2>&1 | tail -3\u001b[0m\r\n    \u001b[2mtimeout_secs\u001b[0m: \u001b[33m120\u001b[0m\r\n\r\n\r\n  \u001b[2m────────────────────────────────────────\u001b[0m\r\n  \u001b[2m▸\u001b[0m \u001b[2mshell\u001b[0m\r\n    \u001b[2mcommand\u001b[0m: \u001b[32mtimeout 30 curl -sI https://huggingface.co/FacebookAI/xlm-roberta-base/resolve/main/config.json | head -5; echo \"---\"; env | grep -i -E \"hf_|pro...\u001b[0m\r\n    \u001b[2mtimeout_secs\u001b[0m: \u001b[33m60\u001b[0m\r\n\r\n"]
