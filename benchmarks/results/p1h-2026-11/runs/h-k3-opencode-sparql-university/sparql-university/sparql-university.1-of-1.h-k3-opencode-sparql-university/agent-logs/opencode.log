import re, datetime
from collections import defaultdict
txt=open('university_graph.ttl').read()
# remove prefix lines
txt=re.sub(r'@prefix[^\n]*\n','',txt)
# split statements by '.'
# crude: use regex per line groups
course_dept={}
for m in re.finditer(r'uni:(\w+)\s+a\s+uni:Course\s*;\s*uni:isTaughtIn\s+uni:(\w+)',txt):
    course_dept[m.group(1)]=m.group(2)
# enroll blocks
enroll=defaultdict(set); enroll_date={}; grad={}
for m in re.finditer(r'uni:(\w+)\s+uni:isEnrolledIn\s+([^;]+);\s*uni:hasEnrollmentDate\s+"([^"]+)"\^\^xsd:date\s*(?:;\s*uni:hasGraduationDate\s+"([^"]+)"\^\^xsd:date)?\s*\.',txt):
    s=m.group(1); courses=[c.strip().split(':')[1] for c in m.group(2).split(',')]
    ed=m.group(3); gd=m.group(4)
    for c in courses: enroll[c].add(s)
    enroll_date[s]=ed; grad[s]=gd
ref='2025-08-16'
print("courses:", course_dept)
# dept -> students current
dept_students=defaultdict(set)
for c,sset in enroll.items():
    d=course_dept.get(c)
    if not d: continue
    for s in sset:
        if enroll_date.get(s,ref)<=ref and (grad.get(s) is None or grad[s]>ref):
            dept_students[d].add(s)
for d,ss in sorted(dept_students.items()):
    print(d,len(ss),sorted(ss))
