import sys; sys.path.insert(0,'/tmp/w')
from common import *
import mujoco, numpy as np, time, re
src = open('/app/model_ref.xml').read()

def mk(name, transform):
    xml = transform(src)
    p = f'/tmp/w/{name}.xml'
    open(p,'w').write(xml)
    return p

def bench_model(path, n=200):
    m = load(path)
    d = mujoco.MjData(m)
    rng=np.random.default_rng(0); d.qpos += rng.normal(0,0.01,size=d.qpos.shape); mujoco.mj_forward(m,d)
    def b(fn):
        t=time.perf_counter()
        for _ in range(n): fn()
        return (time.perf_counter()-t)/n*1e6
    return dict(step=b(lambda: mujoco.mj_step(m,d)), fwdcon=b(lambda: mujoco.mj_fwdConstraint(m,d)),
                euler=b(lambda: mujoco.mj_Euler(m,d)), nefc=d.nefc)

base = mk('base', lambda s: s)
print('base', {k:(round(v,1) if isinstance(v,float) else v) for k,v in bench_model(base).items()})
noeq = mk('noeq', lambda s: s.replace('<equality>','<equality><connect name="x2" body1="B_last" body2="slider" anchor=".025 0 0"/><!--').replace('</connect>','</connect>--></connect>') if False else s)
# simpler: remove equality block
noeq = mk('noeq', lambda s: re.sub(r'<equality>.*?</equality>', '', s, flags=re.S))
print('noeq', {k:(round(v,1) if isinstance(v,float) else v) for k,v in bench_model(noeq).items()})
