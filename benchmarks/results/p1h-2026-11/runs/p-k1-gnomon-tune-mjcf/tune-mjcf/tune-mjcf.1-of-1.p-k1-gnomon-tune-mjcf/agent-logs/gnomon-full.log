import sys; sys.path.insert(0,'/tmp/w')
from common import *
import mujoco, numpy as np, re

src = open('/app/model_ref.xml').read()
def mk(dt, extra=''):
    xml = src.replace('<compiler autolimits="true"/>', '<compiler autolimits="true"/>')
    xml = src.replace('<size memory="2M"/>', f'<size memory="2M"/>\n<option timestep="{dt}">{extra}</option>')
    p = f'/tmp/w/dt_{dt}.xml'
    open(p,'w').write(xml)
    return p

ref = load(REF)
seeds = [0,1,2,3,4]
ref_states = {s: final_state(ref, s) for s in seeds}
for dt in [0.002, 0.001, 0.0005, 0.004, 0.005, 0.01, 0.02]:
    p = mk(dt)
    try:
        m = load(p)
    except Exception as e:
        print(dt, 'LOAD FAIL', e); continue
    diffs=[]
    for s in seeds:
        st = final_state(m, s)
        diffs.append((np.abs(st-ref_states[s]).max(), np.linalg.norm(st-ref_states[s])))
    d = np.array(diffs)
    print(f'dt={dt}: nstep={int(2.0/dt):5d} maxabs={d[:,0].max():.3e} norm_min={d[:,1].min():.3e} norm_max={d[:,1].max():.3e}')
EOF
