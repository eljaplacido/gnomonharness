import mujoco, numpy as np, time
REF = '/app/model_ref.xml'
TOTAL = 2.0

def load(path):
    return mujoco.MjModel.from_xml_path(path)

def final_state(model, seed):
    d = mujoco.MjData(model)
    nstep = int(TOTAL / model.opt.timestep)
    rng = np.random.default_rng(seed)
    d.qpos += rng.normal(0, 0.01, size=d.qpos.shape)
    mujoco.mj_forward(model, d)
    for _ in range(nstep):
        mujoco.mj_step(model, d)
    s = np.zeros(mujoco.mj_stateSize(model, mujoco.mjtState.mjSTATE_FULLPHYSICS))
    mujoco.mj_getState(model, d, s, mujoco.mjtState.mjSTATE_FULLPHYSICS)
    return s

def timeit(model, n=7, seed=1):
    d = mujoco.MjData(model)
    nstep = int(TOTAL / model.opt.timestep)
    ts = []
    for _ in range(n):
        rng = np.random.default_rng(seed)
        d.qpos[:] = model.qpos0
        d.qvel[:] = 0
        d.qpos += rng.normal(0, 0.01, size=d.qpos.shape)
        mujoco.mj_forward(model, d)
        t0 = time.perf_counter()
        for _ in range(nstep):
            mujoco.mj_step(model, d)
        ts.append(time.perf_counter() - t0)
    return float(np.median(ts))
