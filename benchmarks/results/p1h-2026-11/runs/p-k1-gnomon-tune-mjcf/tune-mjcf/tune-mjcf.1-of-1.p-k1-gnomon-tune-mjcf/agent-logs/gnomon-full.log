import sys; sys.path.insert(0,'/tmp/w')
from common import *
import mujoco, numpy as np, re, itertools

src = open('/app/model_ref.xml').read()

def build(opts):
    # opts: dict of option attributes
    xml = src
    attr = ' '.join(f'{k}="{v}"' for k,v in opts.items())
    xml = xml.replace('<size memory="2M"/>', f'<size memory="2M"/>\n<option {attr}/>')
    return xml

def analyze(name, xml, seeds=(0,1,2), ref_states=None, ref_time=None):
    p = f'/tmp/w/v_{name}.xml'
    open(p,'w').write(xml)
    try:
        m = mujoco.MjModel.from_xml_path(p)
    except Exception as e:
        print(f'{name:28s} LOADFAIL {str(e)[:60]}'); return
    diffs = []
    for s in seeds:
        st = final_state(m, s)
        if np.isnan(st).any() or np.isinf(st).any():
            print(f'{name:28s} NaN/Inf'); return
        diffs.append(np.abs(st - ref_states[s]).max())
    t = timeit(m, n=5)
    print(f'{name:28s} t={t*1e3:7.1f}ms  ratio={t/ref_time:5.3f}  maxabs={max(diffs):.3e}')

ref = load(REF)
seeds = (0,1,2)
ref_states = {s: final_state(ref, s) for s in seeds}
rt = timeit(ref, n=5)
print(f'reference t={rt*1e3:.1f}ms')

variants = {
 'base': {},
 'jac_dense': {'jacobian':'dense'},
 'jac_sparse': {'jacobian':'sparse'},
 'solver_pgs': {'solver':'PGS'},
 'solver_cg': {'solver':'CG'},
 'iter1': {'iterations':'1'},
 'tol1e6': {'tolerance':'1e-6'},
 'nocon': {'integrator':'Euler'},
 'implicitfast': {'integrator':'implicitfast'},
 'implicit': {'integrator':'implicit'},
 'noslip': {'noslip_iterations':'2'},
}
for k,v in variants.items():
    analyze(k, build(v), seeds, ref_states, rt)
