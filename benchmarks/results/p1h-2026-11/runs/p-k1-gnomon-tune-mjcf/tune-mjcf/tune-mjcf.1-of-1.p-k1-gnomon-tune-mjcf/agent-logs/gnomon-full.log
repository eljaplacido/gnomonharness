import mujoco, numpy as np, time
def b(fn,n=500):
    t=time.perf_counter()
    for _ in range(n): fn()
    return (time.perf_counter()-t)/n*1e6

def chain(n):
    bodies=[]
    for i in range(n):
        bodies.append(f'<body name="b{i}" pos="0 0 {0.02*(i+1)}"><joint name="j{i}" type="hinge" axis="1 0 0" pos="0 0 {-0.02 if i else 0}"/><geom size=".005"/></body>')
    # nest them
    inner = ''
    for i in range(n-1, -1, -1):
        if i == n-1:
            inner = bodies[i]
        else:
            inner = bodies[i].replace('/>', '/>') 
    # simple: build nested manually
    xml = '<mujoco><worldbody>'
    open_ = []
    for i in range(n):
        xml += f'<body name="b{i}" pos="0 0 {0.02}"><joint name="j{i}" type="hinge" axis="1 0 0"/><geom size=".005"/>'
        open_.append(i)
    xml += '</body>'*n + '</worldbody>'
    xml += f'<equality><connect body1="b{n-1}" body2="world" anchor="0 0 0"/></equality>'
    xml += '</mujoco>'
    return xml

for n in [5, 10, 20, 40]:
    xml = chain(n)
    m = mujoco.MjModel.from_xml_string(xml)
    d = mujoco.MjData(m)
    mujoco.mj_forward(m,d)
    print(f'nv={m.nv:4d} nefc={d.nefc:3d}  step={b(lambda: mujoco.mj_step(m,d)):7.1f}us  fwdcon={b(lambda: mujoco.mj_fwdConstraint(m,d)):7.1f}us  euler={b(lambda: mujoco.mj_Euler(m,d)):6.1f}us fwdPos={b(lambda: mujoco.mj_fwdPosition(m,d)):6.1f}us')
