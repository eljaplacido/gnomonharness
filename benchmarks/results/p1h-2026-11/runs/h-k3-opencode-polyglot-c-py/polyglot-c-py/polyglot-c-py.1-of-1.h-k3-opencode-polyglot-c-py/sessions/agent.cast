[57.927502, "o", "\u001b[0m← \u001b[0mEdit polyglot/main.py.c\r\nIndex: polyglot/main.py.c\r\n===================================================================\r\n--- polyglot/main.py.c\r\n+++ polyglot/main.py.c\r\n@@ -1,7 +1,7 @@\r\n-#if 0\r\n+# /*\r\n \"\"\"\r\n-#endif\r\n+# */\r\n \r\n #include <stdio.h>\r\n #include <stdlib.h>\r\n \r\n\r\n"]
