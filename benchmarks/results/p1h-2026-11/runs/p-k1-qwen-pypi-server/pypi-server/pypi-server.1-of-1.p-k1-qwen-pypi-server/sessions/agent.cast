[10.903257, "o", "The dotproduct function should be present in the __init__.py file at the root such that a user could do `from vectorops import dotproduct; assert 1 == dotproduct([1,1], [0,1])`.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
