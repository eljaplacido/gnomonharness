import oxigraph from 'oxigraph';
import { readFileSync } from 'fs';
const QUERY = readFileSync('/app/solution.sparql','utf8');
const BASE = readFileSync('/app/university_graph.ttl','utf8');

function run(ttl) {
  const store = new oxigraph.Store();
  store.load(ttl, {format:'text/turtle'});
  const rows = store.query(QUERY);
  const out = {};
  for (const b of rows) {
    const cs = b.get('countries').value.split(/,\s*/).sort();
    out[b.get('professorName').value] = cs;
  }
  return out;
}
const norm = o => JSON.stringify(Object.fromEntries(Object.entries(o).sort()));
const eq = (a,b) => norm(a)===norm(b);
let fail = 0;
function check(label, actual, expected) {
  const ok = eq(actual, expected);
  if (!ok) fail++;
  console.log((ok?'PASS':'FAIL') + ' — ' + label);
  if (!ok) console.log('   expected ' + norm(expected) + '\n   actual   ' + norm(actual));
}

// T1: baseline
check('baseline: 3 full profs (EU + crowded dept >10 current students)',
  run(BASE),
  {'Aristotle Tympas':['GR'], 'Orfeas Menis':['GR','US'], 'Pepe Attanasio':['GR','PT']});

// T2: NTUA moved to non-EU country (CH) -> crowded dept no longer EU, PT dept not crowded
check('criterion 2: NTUA -> CH drops Menis & Attanasio (crowded dept not in EU)',
  run(BASE.replace('uni:locatedInCountry "GR" .\n\nuni:NKUA', 'uni:locatedInCountry "CH" .\n\nuni:NKUA')),
  {'Aristotle Tympas':['GR']});

// T3: all graduation dates moved past today -> Math201 = 14 current students -> Dubois qualifies
const ttl3 = BASE.replace(/uni:hasGraduationDate "2025-[0-9]{2}-[0-9]{2}"\^\^xsd:date/g,
                           'uni:hasGraduationDate "2026-09-01"^^xsd:date');
check('criterion 3/graduation filter: no graduations yet -> Marie Dubois (FR) qualifies',
  run(ttl3),
  {'Aristotle Tympas':['GR'], 'Orfeas Menis':['GR','US'], 'Pepe Attanasio':['GR','PT'], 'Marie Dubois':['FR']});

// T4: exactly 10 current students must NOT match (strictly more than 10)
const ttl4 = BASE.replace('uni:Student8 uni:isEnrolledIn uni:CS101, uni:STS101;', 'uni:Student8 uni:isEnrolledIn uni:CS101;')
                  .replace('uni:Student12 uni:isEnrolledIn uni:CS101, uni:STS101;', 'uni:Student12 uni:isEnrolledIn uni:CS101;');
check('criterion 3 boundary: STS101 down to 10 current students -> Tympas excluded (needs >10)',
  run(ttl4),
  {'Orfeas Menis':['GR','US'], 'Pepe Attanasio':['GR','PT']});

// T5: assistant professor promoted to full professor -> now matches
check('criterion 1: promoting Voulodimos to full professor adds him',
  run(BASE.replace('"Assistant Professor of Computer Science"', '"Professor of Computer Science"')),
  {'Aristotle Tympas':['GR'], 'Orfeas Menis':['GR','US'], 'Pepe Attanasio':['GR','PT'],
   'Athanasios Voulodimos':['GR']});

// T6: assistant professors must never appear, even if their dept is crowded & EU
check('criterion 1: Assistant Professor Voulodimos and Mueller excluded',
  Object.keys(run(BASE)).includes('Athanasios Voulodimos') || Object.keys(run(BASE)).includes('Stefan Mueller') ? {'bad':1} : {},
  {});

// T7: John Smith (US only) and Marie Dubois (FR, small dept) excluded
check('criteria 2+3: John Smith (US) and Marie Dubois (6 students) excluded',
  Object.keys(run(BASE)).filter(n=>['John Smith','Marie Dubois','Stefan Mueller'].includes(n)),
  []);

// T8: EU-27 list is honoured — a professor working only in a non-EU European country fails
check('EU list: CH/UK/NO etc. are not EU (ETH physics prof has 0 students anyway, GR keeps Menis)',
  run(BASE.replace('uni:Sloan_MIT a uni:Department ;\n    uni:belongsTo uni:MIT .','uni:Sloan_MIT a uni:Department ;\n    uni:belongsTo uni:MIT .'))['Orfeas Menis'],
  ['GR','US']);

console.log(fail === 0 ? '\nALL TESTS PASSED' : `\n${fail} TEST(S) FAILED`);
process.exit(fail === 0 ? 0 : 1);
EOF
