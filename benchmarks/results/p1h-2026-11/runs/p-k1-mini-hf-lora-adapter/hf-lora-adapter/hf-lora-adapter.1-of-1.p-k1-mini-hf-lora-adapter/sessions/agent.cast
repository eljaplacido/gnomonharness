[229.252751, "o", "ですか？\",\r\n    \"predicted_class_id\": 9,\r\n    \"confidence\": 0.96494\r\n  },\r\n  {\r\n    \"text\": \"你好，你好吗？\",\r\n    \"predicted_class_id\": 19,\r\n    \"confidence\": 0.935988\r\n  },\r\n  {\r\n    \"text\": \"مرحبا، كيف حالك؟\",\r\n    \"predicted_class_id\": 0,\r\n    \"confidence\": 0.988026\r\n  },\r\n  {\r\n    \"text\": \"Hello, how are you?\",\r\n    \"predicted_class_id\": 4,\r\n    \"confidence\": 0.973709\r\n  }\r\n]\r\n--- configs\r\n/app/model_cache/xlm-roberta-base/config.json\r\n architectures: ['XLMRobertaForSequenceClassification']\r\n num_labels: None\r\n id2label: {'0': 'LABEL_0', '1': 'LABEL_1', '2': 'LABEL_2', '3': 'LABEL_3', '4': 'LABEL_4', '5': 'LABEL_5', '6': 'LABEL_6', '7': 'LABEL_7', '8': 'LABEL_8', '9':\r\n'LABEL_9', '10': 'LABEL_10', '11': 'LABEL_11', '12': 'LABEL_12', '13': 'LABEL_13', '14': 'LABEL_14', '15': 'LABEL_15', '16': 'LABEL_16', '17': 'LABEL_17', '18':\r\n'LABEL_18', '19': 'LABEL_19'}\r\n label2id: {'LABEL_0': 0, 'LABEL_1': 1, 'LABEL_10': 10, 'LABEL_11': 11, 'LABEL_12': 12, 'LABEL_13': 13, 'LABEL_14': 14, 'LA"]
