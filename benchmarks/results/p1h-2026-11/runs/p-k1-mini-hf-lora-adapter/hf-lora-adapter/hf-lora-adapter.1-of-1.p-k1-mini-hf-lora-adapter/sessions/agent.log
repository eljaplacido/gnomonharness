import json
import torch
from transformers import AutoConfig, AutoTokenizer, AutoModelForSequenceClassification
from peft import PeftModel

for p in ['/app/model_cache/xlm-roberta-base','/app/merged_model']:
    cfg=AutoConfig.from_pretrained(p)
    print(p, 'num_labels=',cfg.num_labels, 'id2label_len=',len(cfg.id2label), 'arch=',cfg.architectures)

texts=[
    "Bonjour, comment allez-vous aujourd'hui?",
    "Hola, ¿cómo estás hoy?",
    "Guten Tag, wie geht es Ihnen?",
    "Ciao, come stai oggi?",
    "Olá, como você está?",
    "Привет, как дела?",
    "こんにちは、お元気ですか？",
    "你好，你好吗？",
    "مرحبا، كيف حالك؟",
    "Hello, how are you?",
]

tok=AutoTokenizer.from_pretrained('/app/model_cache/xlm-roberta-base')
base=AutoModelForSequenceClassification.from_pretrained('/app/model_cache/xlm-roberta-base')
adapter=PeftModel.from_pretrained(base,'/app/downloads/adapter').eval()
merged=AutoModelForSequenceClassification.from_pretrained('/app/merged_model').eval()
print('model num_labels:', adapter.config.num_labels, merged.config.num_labels)
print('classifier out:', adapter.base_model.model.classifier.out_proj.out_features, merged.classifier.out_proj.out_features)

all_ok=True
with torch.inference_mode():
    for text in texts:
        inputs=tok(text,return_tensors='pt',truncation=True,max_length=512)
        la=adapter(**inputs).logits
        lm=merged(**inputs).logits
        same=torch.allclose(la,lm,atol=1e-5,rtol=1e-4)
        same_arg=int(la.argmax(-1)) == int(lm.argmax(-1))
        maxdiff=float((la-lm).abs().max())
        print('same_logits=',same,'same_argmax=',same_arg,'maxdiff=',maxdiff,'adapter_argmax=',int(la.argmax(-1)))
        all_ok = all_ok and same and same_arg
print('ALL_OK', all_ok)
assert all_ok
PY
cd /app && nohup python /app/validate.py > /app/validate.log 2>&1 & echo $! > /app/validate.pid; sleep 5; tail -20 /app/validate.log
