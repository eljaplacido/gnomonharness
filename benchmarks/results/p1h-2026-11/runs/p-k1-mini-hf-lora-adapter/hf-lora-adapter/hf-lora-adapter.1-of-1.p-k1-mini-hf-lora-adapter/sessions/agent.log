```
cat > /app/build_and_test.py <<'PY'
import json
import os
import shutil

import torch
from transformers import AutoTokenizer, AutoModelForSequenceClassification
from peft import PeftModel

BASE_SOURCE = "/app/downloads/base"
ADAPTER_SOURCE = "/app/downloads/adapter"
CONFIGURED_BASE_OUT = "/app/model_cache/xlm-roberta-base"
MERGED_OUT = "/app/merged_model"
RESULTS_OUT = "/app/detection_results.json"

os.makedirs(CONFIGURED_BASE_OUT, exist_ok=True)
os.makedirs(MERGED_OUT, exist_ok=True)

print("Loading tokenizer...", flush=True)
tokenizer = AutoTokenizer.from_pretrained(BASE_SOURCE)

print("Loading base model configured for 20 language classes...", flush=True)
# The base checkpoint is a masked-LM checkpoint. Loading it through the sequence
# classification class creates a fresh classifier head with exactly 20 labels.
base_model = AutoModelForSequenceClassification.from_pretrained(
    BASE_SOURCE,
    num_labels=20,
)
assert base_model.config.num_labels == 20
assert base_model.classifier.out_proj.out_features == 20

print("Saving configured base model and tokenizer...", flush=True)
base_model.save_pretrained(CONFIGURED_BASE_OUT, safe_serialization=True)
tokenizer.save_pretrained(CONFIGURED_BASE_OUT)

print("Applying LoRA adapter...", flush=True)
peft_model = PeftModel.from_pretrained(base_model, ADAPTER_SOURCE)
peft_model.eval()
assert peft_model.base_model.model.classifier.out_proj.out_features == 20

print("Merging LoRA adapter into base model...", flush=True)
merged_model = peft_model.merge_and_unload()
merged_model.eval()
assert merged_model.config.num_labels == 20
assert merged_model.classifier.out_proj.out_features == 20

print("Saving merged model and tokenizer...", flush=True)
merged_model.save_pretrained(MERGED_OUT, safe_serialization=True)
tokenizer.save_pretrained(MERGED_OUT)

samples = [
    "Bonjour, comment allez-vous aujourd'hui?",
    "Hola, ¿cómo estás hoy?",
    "Guten Tag, wie geht es Ihnen?",
    "Ciao, come stai oggi?",
    "Olá, como você está?",
    "Привет, как дела?",
    "こんにちは、お元気ですか？",
    "你好，你好吗？",
    "مرحبا، كيف حالك؟",
    "Hello, how are you?",
]

print("Running language detection...", flush=True)
results = []
with torch.inference_mode():
    for text in samples:
        inputs = tokenizer(
            text,
            return_tensors="pt",
            truncation=True,
            max_length=512,
        )
        logits = merged_model(**inputs).logits
        if not torch.isfinite(logits).all():
            raise RuntimeError(f"Non-finite logits for: {text}")
        probs = torch.softmax(logits, dim=-1)
        confidence, predicted = torch.max(probs, dim=-1)
        results.append(
            {
                "text": text,
                "predicted_class_id": int(predicted.item()),
                "confidence": round(float(confidence.item()), 6),
            }
        )
        print(results[-1], flush=True)

with open(RESULTS_OUT, "w", encoding="utf-8") as f:
    json.dump(results, f, ensure_ascii=False, indent=2)

print(f"Wrote {len(results)} results to {RESULTS_OUT}", flush=True)
print("DONE", flush=True)
PY
cd /app && nohup python /app/build_and_test.py > /app/build.log 2>&1 & echo $! > /app/build.pid; sleep 5; tail -30 /app/build.log
