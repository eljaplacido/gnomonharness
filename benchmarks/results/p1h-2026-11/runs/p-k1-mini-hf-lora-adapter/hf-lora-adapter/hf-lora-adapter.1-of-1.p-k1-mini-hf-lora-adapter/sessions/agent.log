    raw=json.load(open(p+'/config.json',encoding='utf-8'))
    cfg=AutoConfig.from_pretrained(p)
    print(p,'raw_num_labels',raw.get('num_labels'),'config_num_labels',cfg.num_labels,'id2label_len',len(cfg.id2label))
    assert raw.get('num_labels')==20 and cfg.num_labels==20 and len(cfg.id2label)==20

fast=AutoTokenizer.from_pretrained(base_path)
slow=XLMRobertaTokenizer.from_pretrained(base_path)
assert fast('Hello, how are you?')['input_ids']==slow('Hello, how are you?')['input_ids']
print('Fast/slow tokenizer parity OK')

# Published adapter mapping, used only to validate that adapter weights landed correctly.
adapter_cfg=json.load(open('/app/downloads/adapter/config.json',encoding='utf-8'))
label2id=adapter_cfg['label2id']
tests={
 'ar':'مرحبا، كيف حالك؟',
 'bg':'Здравей, как си?',
 'de':'Guten Tag, wie geht es Ihnen?',
 'el':'Γεια σου, τι κάνεις;',
 'en':'Hello, how are you?',
 'es':'Hola, ¿cómo estás hoy?',
 'fr':'Bonjour, comment allez-vous aujourd’hui ?',
 'hi':'नमस्ते, आप कैसे हैं?',
 'it':'Ciao, come stai oggi?',
 'ja':'こんにちは、お元気ですか？',
 'nl':'Hallo, hoe gaat het met je?',
 'pl':'Cześć, jak się masz?',
 'pt':'Olá, como você está?',
 'ru':'Привет, как дела?',
 'sw':'Habari, unaendeleaje?',
 'th':'สวัสดี สบายดีไหม',
 'tr':'Merhaba, nasılsın?',
 'ur':'ہیلو، آپ کیسے ہیں؟',
 'vi':'Xin chào, bạn khỏe không?',
 'zh':'你好，你好吗？',
}
model=AutoModelForSequenceClassification.from_pretrained(merged_path).eval()
correct=0
per=defaultdict(list)
with torch.inference_mode():
    for lang,text in tests.items():
        inputs=fast(text,return_tensors='pt',truncation=True,max_length=512)
        logits=model(**inputs).logits
        pid=int(logits.argmax(-1))
        ok=pid==label2id[lang]
        correct+=ok; per[lang].append(ok)
        print(f'{lang}: pred={pid} expected={label2id[lang]} ok={ok} conf={torch.softmax(logits,-1).max().item():.4f}')
print('accuracy',correct,'/',len(tests))
assert correct==len(tests)

# Confirm recorded results correspond to a fresh merged-model pass.
saved=json.load(open('/app/detection_results.json',encoding='utf-8'))
with torch.inference_mode():
    for row in saved:
        inputs=fast(row['text'],return_tensors='pt',truncation=True,max_length=512)
        logits=model(**inputs).logits
        assert int(logits.argmax(-1))==row['predicted_class_id']
        conf=float(torch.softmax(logits,-1).max())
        assert abs(conf-row['confidence'])<1e-5
print('detection_results.json consistency OK')
print('ALL_FINAL_VALIDATIONS_PASSED')
