[288.499751, "o", "\r\u001b[2K\u001b[32m⠹\u001b[0m Waiting for the LM to respond..."]
[288.580661, "o", "\r\u001b[2K\u001b[32m⠸\u001b[0m Waiting for the LM to respond..."]
