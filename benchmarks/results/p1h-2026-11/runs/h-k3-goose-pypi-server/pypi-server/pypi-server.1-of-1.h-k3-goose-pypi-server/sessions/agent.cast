[38.484767, "o", "\r\n  \u001b[2m────────────────────────────────────────\u001b[0m\r\n  \u001b[2m▸\u001b[0m \u001b[2mwrite\u001b[0m\r\n    \u001b[2mpath\u001b[0m \u001b[2m/app/start_pypiserver.sh\u001b[0m\r\n    \u001b[2mcontent\u001b[0m: \u001b[32m#!/usr/bin/env bash\r\n# Start a local PyPI server (pypiserver) on port 8080 hosting /app/dist.\r\nset -euo pipefail\r\n\r\nPKG_DIR=\"${PKG_DIR:-/app/dist}\"\r\n...\u001b[0m\r\n\r\n\r\n  \u001b[2m────────────────────────────────────────\u001b[0m\r\n  \u001b[2m▸\u001b[0m \u001b[2mshell\u001b[0m\r\n    \u001b[2mcommand\u001b[0m: \u001b[32mpypi-server --help 2>&1 | head -40; echo ---; pypi-server run --help 2>&1 | head -60\u001b[0m\r\n\r\n"]
[38.628668, "o", "    \u001b[2mCreated /app/start_pypiserver.sh (28 lines)\u001b[0m\r\n    \u001b[2musage: pypi-server [-h] [-v] [--log-file FILE] [--log-stream STREAM]\u001b[0m\r\n    \u001b[2m                   [--log-frmt FORMAT] [--hash-algo HASH_ALGO]\u001b[0m\r\n    \u001b[2m                   [--backend {auto,simple-dir,cached-dir}] [--version]\u001b[0m\r\n    \u001b[2m                   {run,update} ...\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2mstart PyPI compatible package server serving packages from PACKAGES_DIRECTORY. If PACKAGES_DIRECTORY is not given on the command line, it uses the default ~/packages. pypiserver scans this directory recursively for packages. It skips packages and directories starting with a dot. Multiple package directories may be specified.\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2mpositional arguments:\u001b[0m\r\n    \u001b[2m  {run,update}\u001b[0m\r\n    \u001b[2m    run                 Run pypiserver, serving packages from\u001b[0m\r\n    \u001b[2m\u001b[3m... (78 lines hidden, /toggle to show all)\u001b[0m\r\n    \u001b[2m                        To disable authentication, use:\u001b[0m\r\n    \u001b[2m                         \u001b[0m\r\n "]
[38.628711, "o", "   \u001b[2m                          pypi-server -a . -P .\u001b[0m\r\n    \u001b[2m                         \u001b[0m\r\n    \u001b[2m                        See the `-P` option for configuring users and\u001b[0m\r\n    \u001b[2m                        passwords.\u001b[0m\r\n    \u001b[2m                         \u001b[0m\r\n    \u001b[2m                        Note that when uploads are not protected, the\u001b[0m\r\n    \u001b[2m                        `register` command is not necessary, but `~/.pypirc`\u001b[0m\r\n    \u001b[2m                        still needs username and password fields, even if\u001b[0m\r\n"]
[40.759064, "o", "\r\n  \u001b[2m────────────────────────────────────────\u001b[0m\r\n  \u001b[2m▸\u001b[0m \u001b[2mshell\u001b[0m\r\n    \u001b[2mcommand\u001b[0m: \u001b[32mcd /app && chmod +x start_pypiserver.sh && ./start_pypiserver.sh && sleep 3 && tail -5 /var/log/pypiserver.log\u001b[0m\r\n\r\n"]
