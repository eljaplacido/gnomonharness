[17.022596, "o", "\u001b[0m$ \u001b[0mls -la /workspace; which coqc; coqc --version 2>&1 | head -5\r\ntotal 12\r\ndrwxr-xr-x 1 root root 4096 Oct 31 15:11 .\r\ndrwxr-xr-x 1 root root 4096 Nov  1 07:47 ..\r\n-rw-rw-r-- 1 root root  277 Oct 31 09:48 plus_comm.v\r\n/usr/bin/coqc\r\nThe Coq Proof Assistant, version 8.18.0\r\ncompiled with OCaml 4.14.1\r\n"]
