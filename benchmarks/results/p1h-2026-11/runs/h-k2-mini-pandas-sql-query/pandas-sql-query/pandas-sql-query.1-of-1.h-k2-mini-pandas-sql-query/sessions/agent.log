cd /app && .venv/bin/python - <<'PY'
import duckdb
import pandas as pd
from pathlib import Path

products = pd.read_csv("products.csv")
orders = pd.read_csv("orders.csv", parse_dates=["order_date"])

# Independent pandas calculation of Q4 2024 revenue per product/category.
q4 = orders[(orders["order_date"] >= "2024-10-01") & (orders["order_date"] < "2025-01-01")]
q4 = q4.merge(products, on="product_id", how="inner")
sales = (q4.assign(revenue=q4["quantity"] * q4["unit_price"])
           .groupby(["category", "product_id"], as_index=False)["revenue"].sum())
sales["rank"] = sales.groupby("category")["revenue"].rank(method="first", ascending=False)
expected = (sales[sales["rank"] <= 3]
            .sort_values(["category", "rank"])
            .groupby("category")["product_id"].apply(list).to_dict())

con = duckdb.connect()
con.register("products", products)
con.register("orders", orders)
actual = con.execute(Path("answer.sql").read_text()).df().groupby("category")["product_id"].apply(list).to_dict()
assert {k: sorted(v) for k, v in actual.items()} == {k: sorted(v) for k, v in expected.items()}, (actual, expected)
print("Validated against independent pandas result:", actual)
