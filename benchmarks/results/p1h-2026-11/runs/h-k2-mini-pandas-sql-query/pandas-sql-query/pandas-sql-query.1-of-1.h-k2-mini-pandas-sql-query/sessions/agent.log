), ranked AS (
  SELECT *, ROW_NUMBER() OVER (PARTITION BY category ORDER BY total_sales DESC, product_id) rn
  FROM product_sales
)
SELECT * FROM ranked ORDER BY category, rn
'''
print(con.execute(q).df().to_string())
