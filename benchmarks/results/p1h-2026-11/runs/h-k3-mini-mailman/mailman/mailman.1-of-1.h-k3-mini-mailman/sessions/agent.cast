[87.776189, "o", "<returncode>\r\n0\r\n<output>\r\n23:[mailman]\r\n28:site_owner: changeme@example.com\r\n34:noreply_address: noreply\r\n62:post_hook:\r\n66:layout: debian\r\n86:[shell]\r\n108:[paths.debian]\r\n122:var_dir: /var/lib/mailman3\r\n124:queue_dir: $var_dir/queue\r\n128:bin_dir: /usr/lib/mailman3/bin\r\n132:log_dir: /var/log/mailman3\r\n134:lock_dir: $var_dir/locks\r\n136:data_dir: $var_dir/data\r\n140:etc_dir: /etc/mailman3\r\n147:archive_dir: $var_dir/archives\r\n155:pid_file: /run/mailman3/master.pid\r\n160:[database]\r\n162:class: mailman.database.sqlite.SQLiteDatabase\r\n171:url: sqlite:///$DATA_DIR/mailman.db\r\n178:[logging.debian]\r\n216:path: mailman.log\r\n218:[webservice]\r\n220:hostname: localhost\r\n223:port: 8001\r\n236:admin_user: restadmin\r\n239:admin_pass: HtjrFZfKuq+XKKF6748Ay9BISs+63E8zkTuDVPKo35GibShq\r\n241:[mta]\r\n244:incoming: mailman.mta.postfix.LMTP\r\n249:outgoing: mailman.mta.deliver.deliver\r\n253:smtp_host: localhost\r\n254:smtp_port: 25\r\n255:smtp_user:\r\n256:smtp_pass:\r\n--- cfg size\r\n271 /etc/mailman3/mailman.cfg\r\n--- full\r\n   100  # that any import errors will be displayed to stderr.\r\n   101  use_ipython: no\r\n   102  \r\n   103  # Set this to allow for command line history if readline is available.  This\r\n   104  # can be as simple as $var_dir/history.py to put the file in the var directory.\r\n   105  history_file:\r\n   106  \r\n   107  \r\n   108  [paths.debian]\r\n   109  # Important directories for Mailman operation.  These are defined here so that\r\n   110  # different layouts can be supported.   For example, a developer layout would\r\n   111  # be different from a FHS layout.  Most paths are based off the var_dir, and\r\n   112  # often just setting that will do the right thing for all the other paths.\r\n   113  # You might also have to set spool_dir though.\r\n   114  #\r\n   115  # Substitutions are allowed, but must be of the form $var where 'var' names a\r\n   116  # configuration variable in the paths.* section.  Substitutions are expanded\r\n   117  # recursively until no more $-variables are present.  Beware of infinite\r\n   118  # expansion loops!\r\n   119  #\r\n   120  # This is the root of the directory structure that Mailman will use to store\r\n   121  # its run-time data.\r\n   122  var_dir: /var/lib/mailman3\r\n   123  # This is where the Mailman queue files directories will be created.\r\n   124  queue_dir: $var_dir/queue\r\n   125  # This is the directory containing the Mailman 'runner' and 'master' commands\r\n   126  # if set to the string '$argv', it will be taken as the directory containing\r\n   127  # the 'mailman' command.\r\n   128  bin_dir: /usr/lib/mailman3/bin\r\n   129  # All list-specific data.\r\n   130  list_data_dir: $var_dir/lists\r\n   131  # Directory where log files go.\r\n   132  log_dir: /var/log/mailman3\r\n   133  # Directory for system-wide locks.\r\n   134  lock_dir: $var_dir/locks\r\n   135  # Directory for system-wide data.\r\n   136  data_dir: $var_dir/data\r\n   137  # Cache files.\r\n   138  cache_dir: $var_dir/cache\r\n   139  # Directory for configuration files and such.\r\n   140  etc_dir: /etc/mailman3\r\n   141  # Directory containing Mailman plugins.\r\n   142  ext_dir: $var_dir/ext\r\n   143  # Directory where the default IMessageStore puts its messages.\r\n   144  messages_dir: $var_dir/messages\r\n   145  # Directory for archive backends to store their messages in.  Archivers should\r\n   146  # create a subdirectory in here to store their files.\r\n   147  archive_dir: $var_dir/archives\r\n   148  # Root directory for site-specific template override files.\r\n   149  template_dir: $var_dir/templates\r\n   150  # There are also a number of paths to specific file locations that can be\r\n   151  # defined.  For these, the directory containing the file must already exist,\r\n   152  # or be one of the directories created by Mailman as per above.\r\n   153  #\r\n   154  # This is where PID file for the master runner is stored.\r\n   155  pid_file: /run/mailman3/master.pid\r\n   156  # Lock file.\r\n   157  lock_file: $lock_dir/master.lck\r\n   158  \r\n   159  \r\n   160  [database]\r\n   161  # The class implementing the IDatabase.\r\n   162  class: mailman.database.sqlite.SQLiteDatabase\r\n   163  #class: mailma"]
[87.776361, "o", "n.database.mysql.MySQLDatabase\r\n   164  #class: mailman.database.postgresql.PostgreSQLDatabase\r\n   165  \r\n   166  # Use this to set the Storm database engine URL.  You generally have one\r\n   167  # primary database connection for all of Mailman.  List data and most rosters\r\n   168  # will store their data in this database, although external rosters may access\r\n   169  # other databases in their own way.  This string supports standard\r\n   170  # 'configuration' substitutions.\r\n   171  url: sqlite:///$DATA_DIR/mailman.db\r\n   172  #url: mysql+pymysql://mailman3:mmpass@localhost/mailman3?charset=utf8&use_unicode=1\r\n   173  #url: postgresql://mailman3:mmpass@localhost/mailman3\r\n   174  \r\n   175  debug: no\r\n   176  \r\n   177  \r\n   178  [logging.debian]\r\n   179  # This defines various log settings.  The options available are:\r\n   180  #\r\n   181  # - level     -- Overrides the default level; this may be any of the\r\n   182  #                standard Python logging levels, case insensitive.\r\n   183  # - format    -- Overrides the default format string\r\n   184  # - datefmt   -- Overrides the default date format string\r\n   185  # - path      -- Overrides the default logger path.  This may be a relative\r\n   186  #                path name, in which case it is relative to Mailman's LOG_DIR,\r\n   187  #                or it may be an absolute path name.  You cannot change the\r\n   188  #                handler class that will be used.\r\n   189  # - propagate -- Boolean specifying whether to propagate log message from this\r\n   190  #                logger to the root \"mailman\" logger.  You cannot override\r\n   191  #                settings for the root logger.\r\n   192  #\r\n   193  # In this section, you can define defaults for all loggers, which will be\r\n   194  # prefixed by 'mailman.'.  Use subsections to override settings for specific\r\n   195  # loggers.  The names of the available loggers are:\r\n   196  #\r\n   197  # - archiver        --  All archiver output\r\n   198  # - bounce          --  All bounce processing logs go here\r\n   199  # - config          --  Configuration issues\r\n   200  # - database        --  Database logging (SQLAlchemy and Alembic)\r\n   201  # - debug           --  Only used for development\r\n   202  # - error           --  All exceptions go to this log\r\n   203  # - fromusenet      --  Information related to the Usenet to Mailman gateway\r\n   204  # - http            --  Internal wsgi-based web interface\r\n   205  # - locks           --  Lock state changes\r\n   206  # - mischief        --  Various types of hostile activity\r\n   207  # - runner          --  Runner process start/stops\r\n   208  # - smtp            --  Successful SMTP activity\r\n   209  # - smtp-failure    --  Unsuccessful SMTP activity\r\n   210  # - subscribe       --  Information about leaves/joins\r\n   211  # - vette           --  Message vetting information\r\n   212  format: %(asctime)s (%(process)d) %(message)s\r\n   213  datefmt: %b %d %H:%M:%S %Y\r\n   214  propagate: no\r\n   215  level: info\r\n   216  path: mailman.log\r\n   217  \r\n   218  [webservice]\r\n   219  # The hostname at which admin web service resources are exposed.\r\n   220  hostname: localhost\r\n   221  \r\n   222  # The port at which the admin web service resources are exposed.\r\n   223  port: 8001\r\n   224  \r\n   225  # Whether or not requests to the web service are secured through SSL.\r\n   226  use_https: no\r\n   227  \r\n   228  # Whether or not to show tracebacks in an HTTP response for a request that\r\n   229  # raised an exception.\r\n   230  show_tracebacks: yes\r\n   231  \r\n   232  # The API version number for the current (highest) API.\r\n   233  api_version: 3.1\r\n   234  \r\n   235  # The administrative username.\r\n   236  admin_user: restadmin\r\n   237  \r\n   238  # The administrative password.\r\n   239  admin_pass: HtjrFZfKuq+XKKF6748Ay9BISs+63E8zkTuDVPKo35GibShq\r\n   240  \r\n   241  [mta]\r\n   242  # The class defining the interface to the incoming mail transport agent.\r\n   243  #incoming: mailman.mta.exim4.LMTP\r\n   244  incoming: mailman.mta.postfix.LMTP\r\n   245  \r\n   246  # The callable implementing delivery to the"]
[87.776382, "o", " outgoing mail transport agent.\r\n   247  # This must accept three arguments, the mailing list, the message, and the\r\n   248  # message metadata dictionary.\r\n   249  outgoing: mailman.mta.deliver.deliver\r\n   250  \r\n   251  # How to connect to the outgoing MTA.  If smtp_user and smtp_pass is given,\r\n   252  # then Mailman will attempt to log into the MTA when making a new connection.\r\n   253  smtp_host: localhost\r\n   254  smtp_port: 25\r\n   255  smtp_user:\r\n   256  smtp_pass:\r\n   257  \r\n   258  # Where the LMTP server listens for connections.  Use 127.0.0.1 instead of\r\n   259  # localhost for Postfix integration, because Postfix only consults DNS\r\n   260  # (e.g. not /etc/hosts).\r\n   261  lmtp_host: 127.0.0.1\r\n   262  lmtp_port: 8024\r\n   263  \r\n   264  # Where can we find the mail server specific configuration file?  The path can\r\n   265  # be either a file system path or a Python import path.  If the value starts\r\n   266  # with python: then it is a Python import path, otherwise it is a file system\r\n   267  # path.  File system paths must be absolute since no guarantees are made about\r\n   268  # the current working directory.  Python paths should not include the trailing\r\n   269  # .cfg, which the file must end with.\r\n   270  #configuration: python:mailman.config.exim4\r\n   271  configuration: python:mailman.config.postfix\r\n\r\n"]
