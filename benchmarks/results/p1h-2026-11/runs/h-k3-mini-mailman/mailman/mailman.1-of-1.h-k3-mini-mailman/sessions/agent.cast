[78.743522, "o", "<returncode>\r\n0\r\n<output>\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    test_simple_local_delivery()\r\n    test_mlist_exists()\r\n    test_join_flow()\r\n--- installed\r\nii  dbconfig-sqlite3                2.0.24                            all          dbconfig-common SQLite3 support\r\nii  gnupg                           2.4.4-2ubuntu17.6                 all          GNU privacy guard - a free PGP replacement\r\nii  gnupg-l10n                      2.4.4-2ubuntu17.6                 all          GNU privacy guard - localization files\r\nii  gnupg-utils                     2.4.4-2ubuntu17.6                 arm64        GNU privacy guard - utility programs\r\nii  libassuan0:arm64                2.5.6-1build1                     arm64        IPC library for the GnuPG components\r\nii  libgpg-error0:arm64             1.47-3build2.1                    arm64        GnuPG development runtime library\r\nii  libmysqlclient21:arm64          8.0.46-0ubuntu0.24.04.4           arm64        MySQL database client library\r\nii  libsqlite3-0:arm64              3.45.1-1ubuntu2.8                 arm64        SQLite 3 shared library\r\nii  mailman3                        3.3.8-3.1ubuntu0.1                all          Mailing list management system\r\nii  mysql-common                    5.8+1.1.0build1                   all          MySQL database common files, e.g. /etc/mysql/my.cnf\r\nii  pinentry-curses                 1.2.1-3ubuntu5                    arm64        curses-based PIN or pass-phrase entry dialog for GnuPG\r\nii  postfix                         3.8.6-1ubuntu0.1                  arm64        High-performance mail transport agent\r\nii  sqlite3                         3.45.1-1ubuntu2.8                 arm64        Command line interface for SQLite 3\r\nii  ubuntu-keyring                  2023.11.28.1                      all          GnuPG keys of the Ubuntu archive\r\n--- configs\r\n/etc/mailman3:\r\ntotal 24\r\ndrwxr-xr-x 2 root root  4096 Oct 31 12:15 .\r\ndrwxr-xr-x 1 root root  4096 Nov  1 09:06 ..\r\n-rw-r----- 1 root list 11115 Oct 31 12:15 mailman.cfg\r\n\r\n/etc/postfix:\r\ntotal 132\r\ndrwxr-xr-x 5 root root  4096 Oct 31 12:15 .\r\ndrwxr-xr-x 1 root root  4096 Nov  1 09:06 ..\r\n-rw-r--r-- 1 root root    60 Oct 31 12:15 dynamicmaps.cf\r\ndrwxr-xr-x 2 root root  4096 May  5 15:47 dynamicmaps.cf.d\r\n-rw-r--r-- 1 root root  1348 Oct 31 12:15 main.cf\r\n-rw-r--r-- 1 root root 27460 Oct 31 12:15 main.cf.proto\r\nlrwxrwxrwx 1 root root    31 Oct 31 12:15 makedefs.out -> /usr/share/postfix/makedefs.out\r\n-rw-r--r-- 1 root root  7048 Oct 31 12:15 master.cf\r\n-rw-r--r-- 1 root root  7048 Oct 31 12:15 master.cf.proto\r\n-rwxr-xr-x 1 root root 29873 May  5 15:47 post-install\r\n-rw-r--r-- 1 root root 10283 May  5 15:47 postfix-files\r\ndrwxr-xr-x 2 root root  4096 May  5 15:47 postfix-files.d\r\n-rwxr-xr-x 1 root root 11033 May  5 15:47 postfix-script\r\ndrwxr-xr-x 2 root root  4096 May  5 15:47 sasl\r\n--- mailman\r\n/usr/bin/mailman\r\n/usr/sbin/postfix\r\nGNU Mailman 3.3.8 (Tom Sawyer)\r\nmail_version = 3.8.6\r\n\r\n"]
