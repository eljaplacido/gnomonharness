[162.710171, "o", "<returncode>\r\n0\r\n<output>\r\n+ service postfix start\r\npostfix/postlog: starting the Postfix mail system\r\n   ...done.\r\n+ service postfix status\r\n * postfix is running\r\n+ postfix check\r\n+ runuser -u list -- mailman -C /etc/mailman3/mailman.cfg create reading-group@local.edu -o postmaster@local.edu --notify\r\nCreated mailing list: reading-group@local.edu\r\n+ mailman --run-as-root -C /etc/mailman3/mailman.cfg lists\r\n1 matching mailing lists found:\r\nreading-group@local.edu\r\n+ ls -l /var/lib/mailman3/data\r\ntotal 296\r\n-rw-rw---- 1 list list 270336 Nov  1 09:08 mailman.db\r\n-rw-rw---- 1 list list    335 Nov  1 09:08 postfix_domains\r\n-rw-r----- 1 list list  12288 Nov  1 09:08 postfix_domains.db\r\n-rw-rw---- 1 list list    990 Nov  1 09:08 postfix_lmtp\r\n-rw-r----- 1 list list  12288 Nov  1 09:08 postfix_lmtp.db\r\n\r\n"]
