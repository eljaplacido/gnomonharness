[314.069265, "o", "\r\u001b[2K```\r\ncd /app && cat > /tmp/check_solver_states.py <<'PY'\r\nimport mujoco, numpy as np\r\nfrom pathlib import Path\r\nref=Path('/app/model_ref.xml').read_text(); ins='<compiler autolimits=\"true\"/>'\r\ncases=[('ref',''),('pgs','solver=\"PGS\"'),('pgs1','solver=\"PGS\" iterations=\"1\"'),('pgs10','solver=\"PGS\" iterations=\"10\"'),('pgs1000','solver=\"PGS\" \r\niterations=\"1000\"'),\r\n('cg','solver=\"CG\"'),('cg1','solver=\"CG\" iterations=\"1\"'),('cg10','solver=\"CG\" iterations=\"10\"'),('cg1000','solver=\"CG\" iterations=\"1000\"'),\r\n('newton','solver=\"Newton\"'),('newton1','solver=\"Newton\" iterations=\"1\"')]\r\ndef states(p,seeds):\r\n    m=mujoco.MjModel.from_xml_path(str(p)); out=[]\r\n    for seed in seeds:\r\n        d=mujoco.MjData(m); rng=np.random.default_rng(seed); d.qpos += rng.normal(0,0.01,size=d.qpos.shape); mujoco.mj_forward(m,d)\r\n        bad=False\r\n        try:\r\n            for _ in range(int(2.0/m.opt.timestep)): mujoco.mj_step(m,d)\r\n        except Exception as e: bad=True\r\n        st=np.zeros(mujoco.mj_stateSize(m,mujoco.mjtState.m"]
[314.069283, "o", "jSTATE_FULLPHYSICS)); mujoco.mj_getState(m,d,st,mujoco.mjtState.mjSTATE_FULLPHYSICS)\r\n        out.append((st,bad,np.isnan(st).any() or np.isinf(st).any()))\r\n    return m,out\r\nseeds=list(range(5))\r\n_,refout=states('/app/model_ref.xml',seeds)\r\nrefst=np.array([x[0] for x in refout])\r\nfor name,opts in cases:\r\n    x=ref.replace(ins,ins+f'\\n  <option {opts}/>'); p=Path('/tmp')/f'{name}.xml'; p.write_text(x)\r\n    m,out=states(p,seeds)\r\n    st=np.array([x[0] for x in out])\r\n    md=np.max(np.abs(st-refst))\r\n    print(name,'maxdiff',f'{md:.3e}','allclose',np.allclose(st,refst,atol=1e-5),'nan',[x[2] for x in out], flux=flush=True)\r\nPY\r\npython /tmp/check_solver_states.py\r\n```\r\n\u001b[32m⠏\u001b[0m Waiting for the LM to respond..."]
