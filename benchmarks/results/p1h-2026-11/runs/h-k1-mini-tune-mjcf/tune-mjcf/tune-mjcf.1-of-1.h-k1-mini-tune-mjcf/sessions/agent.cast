[340.794209, "o", "\r\u001b[2K\r\n\u001b[1;31mmini-swe-agent\u001b[0m\u001b[31m (step \u001b[0m\u001b[1;31m23\u001b[0m\u001b[31m, \u001b[0m\u001b[1;31m$0.00\u001b[0m\u001b[31m):\u001b[0m\r\n\u001b[32m⠹\u001b[0m Waiting for the LM to respond..."]
[340.794461, "o", "\r\u001b[2K```\r\ncd /app && cat > /tmp/robust_pgs.py <<'PY'\r\nimport mujoco, numpy as np, time, warnings\r\nfrom pathlib import Path\r\nref=Path('/app/model_ref.xml').read_text(); ins='<compiler autolimits=\"true\"/>'\r\nx=ref.replace(ins,ins+'\\n  <option solver=\"PGS\" iterations=\"100\"/>'); Path('/tmp/pgs.xml').write_text(x)\r\nmr=mujoco.MjModel.from_xml_path('/app/model_ref.xml'); mp=mujoco.MjModel.from_xml_path('/tmp/pgs.xml')\r\nmaxd=0; worst=None; nbad=0; warns=0\r\nstart=time.time()\r\nfor seed in range(200):\r\n    outs=[]\r\n    for m in (mr,mp):\r\n        d=mujoco.MjData(m); rng=np.random.default_rng(seed); d.qpos += rng.normal(0,0.01,size=d.qpos.shape); mujoco.mj_forward(m,d)\r\n        bad=False\r\n        for _ in range(int(2.0/m.opt.timestep)):\r\n            mujoco.mj_step(m,d)\r\n        st=np.zeros(mujoco.mj_stateSize(m,mujoco.mjtState.mjSTATE_FULLPHYSICS)); mujoco.mj_getState(m,d,st,mujoco.mjtState.mjSTATE_FULLPHYSICS)\r\n        outs.append(st)\r\n    diff=np.max(np.abs(outs[0]-outs[1]))\r\n    if diff>maxd: maxd=diff; worst=seed\r\n    "]
[340.794468, "o", "if not np.allclose(outs[0],outs[1],atol=1e-5): nbad+=1; print('BAD seed',seed,'diff',diff,flush=True)\r\n    if np.isnan(outs[1]).any() or np.isinf(outs[1]).any(): print('NONFINITE seed',seed,flush=True)\r\n    if seed%20==0: print('seed',seed,'maxd_so_far',maxd,'worst',worst,'elapsed',time.time()-start,flush=True)\r\nprint('DONE maxd',maxd,'worst',worst,'nbad',nbad,'elapsed',time.time()-start)\r\nPY\r\nnohup python -u /tmp/robust_pgs.py > /tmp/robust_pgs.out 2>&1 & echo $!\r\n```\r\n\u001b[32m⠹\u001b[0m Waiting for the LM to respond..."]
