[119.078158, "o", "\r\u001b[2K```\r\ncd /app && cat > /tmp/sweep_opts.py <<'PY'\r\nimport mujoco, numpy as np, time, re\r\nfrom pathlib import Path\r\nref=Path('/app/model_ref.xml').read_text()\r\ninsert='<compiler autolimits=\"true\"/>'\r\ndef mk(name, opts):\r\n    x=ref.replace(insert, insert+'\\n  <option '+opts+'/>')\r\n    p=Path('/tmp')/f'{name}.xml'; p.write_text(x); return p\r\n# cases\r\ncases=[('ref',''),('iter1','iterations=\"1\"'),('iter2','iterations=\"2\"'),('iter5','iterations=\"5\"'),('iter10','iterations=\"10\"'),('iter20','iterations=\"20\"'),('i\r\nter50','iterations=\"50\"'),\r\n('ls1','ls_iterations=\"1\"'),('ls5','ls_iterations=\"5\"'),('ls10','ls_iterations=\"10\"'),('ls20','ls_iterations=\"20\"'),\r\n('tol1e-6','tolerance=\"1e-6\"'),('tol1e-5','tolerance=\"1e-5\"'),('tol1e-4','tolerance=\"1e-4\"'),\r\n('euler_iter5','iterations=\"5\" ls_iterations=\"5\" tolerance=\"1e-6\"')]\r\n# store ref states for seeds\r\ndef run(p,seeds):\r\n    m=mujoco.MjModel.from_xml_path(str(p))\r\n    states=[]\r\n    for seed in seeds:\r\n        d=mujoco.MjData(m); rng=np.random.default_rng(seed); d.qpo"]
[119.078182, "o", "s += rng.normal(0,0.01,size=d.qpos.shape); mujoco.mj_forward(m,d)\r\n        n=int(2.0/m.opt.timestep)\r\n        for _ in range(n): mujoco.mj_step(m,d)\r\n        st=np.zeros(mujoco.mj_stateSize(m,mujoco.mjtState.mjSTATE_FULLPHYSICS)); mujoco.mj_getState(m,d,st,mujoco.mjtState.mjSTATE_FULLPHYSICS); \r\nstates.append(st)\r\n    return m,np.array(states)\r\nseeds=list(range(10))\r\nmodels={}\r\nrefstates=None\r\nfor name,opts in cases:\r\n    p=mk(name,opts) if opts else Path('/app/model_ref.xml')\r\n    m,st=run(p,seeds)\r\n    models[name]=m\r\n    if refstates is None: refstates=st\r\n    md=np.max(np.abs(st-refstates)) if st.shape==refstates.shape else np.inf\r\n    allok=np.allclose(st,refstates,atol=1e-5)\r\n    # time 20 runs same seed chain\r\n    times=[]\r\n    m=mujoco.MjModel.from_xml_path(str(p))\r\n    for seed in range(20):\r\n        d=mujoco.MjData(m); rng=np.random.default_rng(seed); d.qpos += rng.normal(0,0.01,size=d.qpos.shape); mujoco.mj_forward(m,d)\r\n        t=time.perf_counter()\r\n        for _ in range(int(2.0/m.opt.timestep))"]
[119.078189, "o", ": mujoco.mj_step(m,d)\r\n        times.append(time.perf_counter()-t)\r\n    print(f'{name:15s} time {np.mean(times):.5f} maxdiff {md:.3e} allok {allok}')\r\nPY\r\npython /tmp/sweep_opts.py\r\n```\r\n\u001b[32m⠸\u001b[0m Waiting for the LM to respond..."]
