[79.074347, "o", "\r\u001b[2K```\r\ncd /app && python - <<'PY'\r\nimport mujoco, numpy as np, time\r\nm=mujoco.MjModel.from_xml_path('model_ref.xml')\r\nd=mujoco.MjData(m)\r\nprint('joints:')\r\nfor j in range(m.njnt):\r\n    print(j, mujoco.mj_id2name(m,mujoco.mjtObj.mjOBJ_JOINT,j), 'type',m.jnt_type[j], 'body',m.jnt_bodyid[j], 'qposadr',m.jnt_qposadr[j], \r\n'dofadr',m.jnt_dofadr[j], 'axis',m.jnt_axis[j])\r\nprint('geoms contype',np.unique(m.geom_contype), 'conaff', np.unique(m.geom_conaffinity), 'condim', np.unique(m.geom_condim), 'group',np.unique(m.geom_group))\r\nprint('opt', m.opt)\r\n# sim baseline tracking max contacts\r\nrng=np.random.default_rng(0); d.qpos += rng.normal(0,0.01,size=d.qpos.shape); mujoco.mj_forward(m,d)\r\nmaxn=0; ncontacts=[]\r\nfor i in range(1000):\r\n    mujoco.mj_step(m,d)\r\n    n=d.ncon; maxn=max(maxn,n); ncontacts.append(n)\r\nprint('max contacts',maxn,'counts',np.unique(ncontacts,return_counts=True))\r\n# time pieces? just full timings\r\nfor label, fn in [('step',lambda: mujoco.mj_step(m,d))]:\r\n    t=time.perf_counter()\r\n    for _ in"]
[79.07442, "o", " range(2000): fn()\r\n    print(label,(time.perf_counter()-t)/2000)\r\nPY\r\n```\r\n\u001b[32m⠏\u001b[0m Waiting for the LM to respond..."]
