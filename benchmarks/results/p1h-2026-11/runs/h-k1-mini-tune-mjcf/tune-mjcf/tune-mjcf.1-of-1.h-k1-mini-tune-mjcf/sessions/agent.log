cd /app && cat > /tmp/sweep_dt.py <<'PY'
import mujoco, numpy as np, time
from pathlib import Path
ref=Path('/app/model_ref.xml').read_text(); ins='<compiler autolimits="true"/>'
def mk(dt, extra=''):
    return Path('/tmp')/f'dt{dt}.xml'
def run(p,seed):
    m=mujoco.MjModel.from_xml_path(str(p)); d=mujoco.MjData(m); rng=np.random.default_rng(seed); d.qpos += rng.normal(0,0.01,size=d.qpos.shape); 
mujoco.mj_forward(m,d)
    n=int(2.0/m.opt.timestep)
    for _ in range(n): mujoco.mj_step(m,d)
    st=np.zeros(mujoco.mj_stateSize(m,mujoco.mjtState.mjSTATE_FULLPHYSICS)); mujoco.mj_getState(m,d,st,mujoco.mjtState.mjSTATE_FULLPHYSICS); return st
for dt in [0.002,0.001,0.0005,0.0025,0.004,0.005,0.008,0.01,0.02,0.04]:
    x=ref.replace(ins,ins+f'\n  <option timestep="{dt}"/>')
    p=mk(dt); p.write_text(x)
    st0=run('/app/model_ref.xml',0)
    st=run(p,0)
    print(f'dt={dt}, n={int(2/dt)}, maxdiff={np.max(np.abs(st-st0)):.3e}, allclose={np.allclose(st,st0,atol=1e-5)}, time_diff={st[0]-st0[0]}')
