cd /app && cat > /tmp/sweep_opts.py <<'PY'
import mujoco, numpy as np, time, re
from pathlib import Path
ref=Path('/app/model_ref.xml').read_text()
insert='<compiler autolimits="true"/>'
def mk(name, opts):
    x=ref.replace(insert, insert+'\n  <option '+opts+'/>')
    p=Path('/tmp')/f'{name}.xml'; p.write_text(x); return p
# cases
cases=[('ref',''),('iter1','iterations="1"'),('iter2','iterations="2"'),('iter5','iterations="5"'),('iter10','iterations="10"'),('iter20','iterations="20"'),('i
ter50','iterations="50"'),
('ls1','ls_iterations="1"'),('ls5','ls_iterations="5"'),('ls10','ls_iterations="10"'),('ls20','ls_iterations="20"'),
('tol1e-6','tolerance="1e-6"'),('tol1e-5','tolerance="1e-5"'),('tol1e-4','tolerance="1e-4"'),
('euler_iter5','iterations="5" ls_iterations="5" tolerance="1e-6"')]
# store ref states for seeds
def run(p,seeds):
    m=mujoco.MjModel.from_xml_path(str(p))
    states=[]
    for seed in seeds:
        d=mujoco.MjData(m); rng=np.random.default_rng(seed); d.qpos += rng.normal(0,0.01,size=d.qpos.shape); mujoco.mj_forward(m,d)
        n=int(2.0/m.opt.timestep)
        for _ in range(n): mujoco.mj_step(m,d)
        st=np.zeros(mujoco.mj_stateSize(m,mujoco.mjtState.mjSTATE_FULLPHYSICS)); mujoco.mj_getState(m,d,st,mujoco.mjtState.mjSTATE_FULLPHYSICS); 
states.append(st)
    return m,np.array(states)
seeds=list(range(10))
models={}
refstates=None
for name,opts in cases:
    p=mk(name,opts) if opts else Path('/app/model_ref.xml')
    m,st=run(p,seeds)
    models[name]=m
    if refstates is None: refstates=st
    md=np.max(np.abs(st-refstates)) if st.shape==refstates.shape else np.inf
    allok=np.allclose(st,refstates,atol=1e-5)
    # time 20 runs same seed chain
    times=[]
    m=mujoco.MjModel.from_xml_path(str(p))
    for seed in range(20):
        d=mujoco.MjData(m); rng=np.random.default_rng(seed); d.qpos += rng.normal(0,0.01,size=d.qpos.shape); mujoco.mj_forward(m,d)
        t=time.perf_counter()
        for _ in range(int(2.0/m.opt.timestep)): mujoco.mj_step(m,d)
        times.append(time.perf_counter()-t)
    print(f'{name:15s} time {np.mean(times):.5f} maxdiff {md:.3e} allok {allok}')
