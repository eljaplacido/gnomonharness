cd /app && python - <<'PY'
import mujoco, numpy as np, time
m=mujoco.MjModel.from_xml_path('model_ref.xml')
d=mujoco.MjData(m)
print('joints:')
for j in range(m.njnt):
    print(j, mujoco.mj_id2name(m,mujoco.mjtObj.mjOBJ_JOINT,j), 'type',m.jnt_type[j], 'body',m.jnt_bodyid[j], 'qposadr',m.jnt_qposadr[j], 
'dofadr',m.jnt_dofadr[j], 'axis',m.jnt_axis[j])
print('geoms contype',np.unique(m.geom_contype), 'conaff', np.unique(m.geom_conaffinity), 'condim', np.unique(m.geom_condim), 'group',np.unique(m.geom_group))
print('opt', m.opt)
# sim baseline tracking max contacts
rng=np.random.default_rng(0); d.qpos += rng.normal(0,0.01,size=d.qpos.shape); mujoco.mj_forward(m,d)
maxn=0; ncontacts=[]
for i in range(1000):
    mujoco.mj_step(m,d)
    n=d.ncon; maxn=max(maxn,n); ncontacts.append(n)
print('max contacts',maxn,'counts',np.unique(ncontacts,return_counts=True))
# time pieces? just full timings
for label, fn in [('step',lambda: mujoco.mj_step(m,d))]:
    t=time.perf_counter()
    for _ in range(2000): fn()
    print(label,(time.perf_counter()-t)/2000)
