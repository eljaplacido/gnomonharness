cd /app && cat > /tmp/pgs_tol.py <<'PY'
import mujoco, numpy as np, time
from pathlib import Path
ref=Path('/app/model_ref.xml').read_text(); ins='<compiler autolimits="true"/>'
def st(p,seed=0):
    m=mujoco.MjModel.from_xml_path(str(p)); d=mujoco.MjData(m); rng=np.random.default_rng(seed); d.qpos += rng.normal(0,0.01,size=d.qpos.shape); 
mujoco.mj_forward(m,d)
    for _ in range(1000): mujoco.mj_step(m,d)
    s=np.zeros(276); mujoco.mj_getState(m,d,s,mujoco.mjtState.mjSTATE_FULLPHYSICS); return s
refst=st('/app/model_ref.xml')
cases=[('pgs','solver="PGS"'),('pgs_t1e-8','solver="PGS" tolerance="1e-8"'),('pgs_t1e-9','solver="PGS" tolerance="1e-9"'),('pgs_t1e-10','solver="PGS" 
tolerance="1e-10"'),('pgs_t1e-12','solver="PGS" tolerance="1e-12"'),('pgs_i10000','solver="PGS" iterations="10000"'),('pgs_i10000t1e-12','solver="PGS" 
iterations="10000" tolerance="1e-12"'),
('cg_t1e-12','solver="CG" tolerance="1e-12"'),('newton_t1e-12','solver="Newton" tolerance="1e-12"')]
for name,opts in cases:
    x=ref.replace(ins,ins+f'\n  <option {opts}/>'); p=Path('/tmp')/f'{name}.xml'; p.write_text(x)
    s=st(p); md=np.max(np.abs(s-refst))
    m=mujoco.MjModel.from_xml_path(str(p)); times=[]
    for seed in range(5):
        d=mujoco.MjData(m); rng=np.random.default_rng(seed); d.qpos += rng.normal(0,0.01,size=d.qpos.shape); mujoco.mj_forward(m,d)
        t=time.perf_counter()
        for _ in range(1000): mujoco.mj_step(m,d)
        times.append(time.perf_counter()-t)
    print(f'{name:20s} diff {md:.3e} time {np.mean(times):.5f}',flush=True)
