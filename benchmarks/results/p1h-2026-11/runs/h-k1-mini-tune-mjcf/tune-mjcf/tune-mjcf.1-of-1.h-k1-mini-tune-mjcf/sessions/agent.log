cd /app && cat > /tmp/check_solver_states.py <<'PY'
import mujoco, numpy as np
from pathlib import Path
ref=Path('/app/model_ref.xml').read_text(); ins='<compiler autolimits="true"/>'
cases=[('ref',''),('pgs','solver="PGS"'),('pgs1','solver="PGS" iterations="1"'),('pgs10','solver="PGS" iterations="10"'),('pgs1000','solver="PGS" 
iterations="1000"'),
('cg','solver="CG"'),('cg1','solver="CG" iterations="1"'),('cg10','solver="CG" iterations="10"'),('cg1000','solver="CG" iterations="1000"'),
('newton','solver="Newton"'),('newton1','solver="Newton" iterations="1"')]
def states(p,seeds):
    m=mujoco.MjModel.from_xml_path(str(p)); out=[]
    for seed in seeds:
        d=mujoco.MjData(m); rng=np.random.default_rng(seed); d.qpos += rng.normal(0,0.01,size=d.qpos.shape); mujoco.mj_forward(m,d)
        bad=False
        try:
            for _ in range(int(2.0/m.opt.timestep)): mujoco.mj_step(m,d)
        except Exception as e: bad=True
        st=np.zeros(mujoco.mj_stateSize(m,mujoco.mjtState.mjSTATE_FULLPHYSICS)); mujoco.mj_getState(m,d,st,mujoco.mjtState.mjSTATE_FULLPHYSICS)
        out.append((st,bad,np.isnan(st).any() or np.isinf(st).any()))
    return m,out
seeds=list(range(5))
_,refout=states('/app/model_ref.xml',seeds)
refst=np.array([x[0] for x in refout])
for name,opts in cases:
    x=ref.replace(ins,ins+f'\n  <option {opts}/>'); p=Path('/tmp')/f'{name}.xml'; p.write_text(x)
    m,out=states(p,seeds)
    st=np.array([x[0] for x in out])
    md=np.max(np.abs(st-refst))
    print(name,'maxdiff',f'{md:.3e}','allclose',np.allclose(st,refst,atol=1e-5),'nan',[x[2] for x in out], flux=flush=True)
