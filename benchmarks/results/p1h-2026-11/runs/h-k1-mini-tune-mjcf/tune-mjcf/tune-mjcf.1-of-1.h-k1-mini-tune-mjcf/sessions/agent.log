cd /app && cat > /tmp/robust_pgs.py <<'PY'
import mujoco, numpy as np, time, warnings
from pathlib import Path
ref=Path('/app/model_ref.xml').read_text(); ins='<compiler autolimits="true"/>'
x=ref.replace(ins,ins+'\n  <option solver="PGS" iterations="100"/>'); Path('/tmp/pgs.xml').write_text(x)
mr=mujoco.MjModel.from_xml_path('/app/model_ref.xml'); mp=mujoco.MjModel.from_xml_path('/tmp/pgs.xml')
maxd=0; worst=None; nbad=0; warns=0
start=time.time()
for seed in range(200):
    outs=[]
    for m in (mr,mp):
        d=mujoco.MjData(m); rng=np.random.default_rng(seed); d.qpos += rng.normal(0,0.01,size=d.qpos.shape); mujoco.mj_forward(m,d)
        bad=False
        for _ in range(int(2.0/m.opt.timestep)):
            mujoco.mj_step(m,d)
        st=np.zeros(mujoco.mj_stateSize(m,mujoco.mjtState.mjSTATE_FULLPHYSICS)); mujoco.mj_getState(m,d,st,mujoco.mjtState.mjSTATE_FULLPHYSICS)
        outs.append(st)
    diff=np.max(np.abs(outs[0]-outs[1]))
    if diff>maxd: maxd=diff; worst=seed
    if not np.allclose(outs[0],outs[1],atol=1e-5): nbad+=1; print('BAD seed',seed,'diff',diff,flush=True)
    if np.isnan(outs[1]).any() or np.isinf(outs[1]).any(): print('NONFINITE seed',seed,flush=True)
    if seed%20==0: print('seed',seed,'maxd_so_far',maxd,'worst',worst,'elapsed',time.time()-start,flush=True)
print('DONE maxd',maxd,'worst',worst,'nbad',nbad,'elapsed',time.time()-start)
