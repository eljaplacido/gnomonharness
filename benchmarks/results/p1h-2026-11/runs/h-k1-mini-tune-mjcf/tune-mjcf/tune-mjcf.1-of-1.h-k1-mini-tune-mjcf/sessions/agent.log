cd /app && cat > /tmp/sweep_solver.py <<'PY'
import mujoco, numpy as np, time
from pathlib import Path
ref=Path('/app/model_ref.xml').read_text(); ins='<compiler autolimits="true"/>'
def state(p,seed=0):
    m=mujoco.MjModel.from_xml_path(str(p)); d=mujoco.MjData(m); rng=np.random.default_rng(seed); d.qpos += rng.normal(0,0.01,size=d.qpos.shape); 
mujoco.mj_forward(m,d)
    for _ in range(int(2.0/m.opt.timestep)): mujoco.mj_step(m,d)
    st=np.zeros(mujoco.mj_stateSize(m,mujoco.mjtState.mjSTATE_FULLPHYSICS)); mujoco.mj_getState(m,d,st,mujoco.mjtState.mjSTATE_FULLPHYSICS); return st
refst=state('/app/model_ref.xml')
cases=[('iter1','iterations="1"'),('iter2','iterations="2"'),('iter3','iterations="3"'),('iter4','iterations="4"'),('iter5','iterations="5"'),('iter10','iterati
ons="10"'),('iter20','iterations="20"'),('iter30','iterations="30"'),('iter50','iterations="50"'),('iter80','iterations="80"'),
('ls1','ls_iterations="1"'),('ls5','ls_iterations="5"'),('ls10','ls_iterations="10"'),('ls20','ls_iterations="20"'),('ls30','ls_iterations="30"'),('ls40','ls_it
erations="40"'),
('tol1e-3','tolerance="1e-3"'),('tol1e-4','tolerance="1e-4"'),('tol1e-5','tolerance="1e-5"'),('tol1e-6','tolerance="1e-6"'),('tol1e-7','tolerance="1e-7"'),
('all5','iterations="5" ls_iterations="5" tolerance="1e-6"'),
('jac1','jacobian="1"'),('jac0','jacobian="0"')]
for name,opts in cases:
    x=ref.replace(ins,ins+f'\n  <option {opts}/>')
    p=Path('/tmp')/f'{name}.xml'; p.write_text(x)
    try:
        st=state(p); md=np.max(np.abs(st-refst)); ok=np.allclose(st,refst,atol=1e-5)
        print(f'{name:10s} maxdiff {md:.3e} allok {ok}')
    except Exception as e: print(name,'ERR',e)
