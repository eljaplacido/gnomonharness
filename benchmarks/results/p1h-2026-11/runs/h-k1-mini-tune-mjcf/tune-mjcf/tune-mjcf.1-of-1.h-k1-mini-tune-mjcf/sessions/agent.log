cd /app && cat > /tmp/bench_variants.py <<'PY'
import mujoco, numpy as np, time, sys
from pathlib import Path
from lxml import etree

ref = Path('/app/model_ref.xml').read_text()

def variant(name, xml):
    p=Path('/tmp')/(name+'.xml'); p.write_text(xml); return p

variants={}
variants['ref']=variant('ref',ref)
# option contact disable
variants['nocontactflag']=variant('nocontact',ref.replace('<compiler autolimits="true"/>','<compiler autolimits="true"/>\n  <option><flag 
contact="disable"/></option>'))
# contype=0 for all geoms
x=ref.replace('<geom type="capsule" size=".005" rgba=".8 .2 .1 1" condim="1"/>','<geom type="capsule" size=".005" rgba=".8 .2 .1 1" condim="1" contype="0" 
conaffinity="0"/>').replace('<geom size=".01"/>','<geom size=".01" contype="0" conaffinity="0"/>')
variants['nocon']=variant('nocon',x)
# compiler default? maybe disc?
# disable collision via global? 
for name,p in variants.items():
    m=mujoco.MjModel.from_xml_path(str(p))
    d=mujoco.MjData(m)
    # seed 123, exact steps
    rng=np.random.default_rng(123); d.qpos += rng.normal(0,0.01,size=d.qpos.shape); mujoco.mj_forward(m,d)
    for _ in range(1000): mujoco.mj_step(m,d)
    st=np.zeros(mujoco.mj_stateSize(m,mujoco.mjtState.mjSTATE_FULLPHYSICS)); mujoco.mj_getState(m,d,st,mujoco.mjtState.mjSTATE_FULLPHYSICS)
    # timing many
    times=[]
    for seed in range(20):
        d=mujoco.MjData(m); rng=np.random.default_rng(seed); d.qpos += rng.normal(0,0.01,size=d.qpos.shape); mujoco.mj_forward(m,d)
        t=time.perf_counter()
        for _ in range(1000): mujoco.mj_step(m,d)
        times.append(time.perf_counter()-t)
    print(name, 'mean',np.mean(times),'state hash sum',st.sum(), 'ncon?', d.ncon, 'disableflags',m.opt.disableflags)
    np.save('/tmp/'+name+'.npy', st)
# compare
r=np.load('/tmp/ref.npy')
for name in variants:
    if name=='ref': continue
    s=np.load('/tmp/'+name+'.npy'); print('diff',name,np.max(np.abs(r-s)),np.linalg.norm(r-s),np.allclose(r,s,atol=1e-5))
