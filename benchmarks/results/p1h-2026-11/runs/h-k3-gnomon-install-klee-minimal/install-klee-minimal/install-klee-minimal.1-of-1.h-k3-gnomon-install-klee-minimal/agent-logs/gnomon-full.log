check "klee --libc=klee --posix-runtime exit status" "$?" "0"
for sysc in access open stat lstat chmod utimes readlink; do
  if grep -q "calling external: ${sysc}(" posix.log; then
    note "POSIX model handled $sysc()" "FAIL (fell through to host)"; fail=1
  else
    note "POSIX model handled $sysc()" "PASS"
  fi
done

echo
echo "=== 5. no uClibc dependency, correct toolchain ==="
if [ -e /usr/local/lib/klee/runtime/klee-uclibc.bca ]; then
  note "uClibc is not installed" "FAIL (klee-uclibc.bca present)"; fail=1
else
  note "uClibc is not installed" "PASS"
fi
check "klee linked against STP" "$(ldd "$(command -v klee)" | grep -c libstp)" "1"
check "klee linked against LLVM 16" "$(ldd "$(command -v klee)" | grep -c libLLVM-16)" "1"

echo
if [ "$fail" -eq 0 ]; then echo "ALL CHECKS PASSED"; else echo "SOME CHECKS FAILED"; fi
exit "$fail"
