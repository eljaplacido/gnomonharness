if clang-16 -E "$tmp/hdr.c" >/dev/null 2>&1; then
  note "#include <klee/klee.h> resolves via CPATH" "PASS"
else
  note "#include <klee/klee.h> resolves via CPATH" "FAIL"; fail=1
fi

