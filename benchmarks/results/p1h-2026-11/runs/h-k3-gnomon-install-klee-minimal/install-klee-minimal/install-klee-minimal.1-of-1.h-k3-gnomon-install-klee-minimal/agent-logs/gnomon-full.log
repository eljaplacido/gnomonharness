grep -q "SAT solver: MiniSat" klee.log && note "STP is backed by MiniSat" "PASS" || note "STP is backed by MiniSat" "WARN"

n_tests=$(ls out/*.ktest 2>/dev/null | wc -l)
[ "$n_tests" -ge 2 ] && note "multiple paths explored ($n_tests tests generated)" "PASS" || { note "multiple paths explored ($n_tests tests)" "FAIL"; fail=1; }
ls out/*.assert.err >/dev/null 2>&1 && note "assertion violation found" "PASS" || { note "assertion violation found" "FAIL"; fail=1; }

klee-stats out >stats.txt 2>&1 && note "klee-stats works on the output" "PASS" || { note "klee-stats works on the output" "FAIL"; fail=1; }
ktest-tool out/test000001.ktest >/dev/null 2>&1 && note "ktest-tool reads a test case" "PASS" || { note "ktest-tool reads a test case" "FAIL"; fail=1; }

echo
echo "=== 4. POSIX runtime model (patched syscalls) ==="
cat > posix.c <<'EOF'
#include <klee/klee.h>
#include <stdio.h>
#include <string.h>
#include <sys/stat.h>
#include <sys/time.h>
#include <unistd.h>

int main(void) {
  char buf[4];
  klee_make_symbolic(buf, sizeof(buf), "buf");
  buf[3] = '\0';
  FILE *f = fopen("out.txt", "w");
  if (!f) return 1;
  fputs(buf, f);
  fclose(f);
  struct stat st;
  stat("out.txt", &st);
  lstat("out.txt", &st);
  access("out.txt", 0);
  chmod("out.txt", 0644);
  utimes("out.txt", NULL);
  char lb[64];
  readlink("out.txt", lb, sizeof(lb));
  return 0;
}
EOF
