 * __NR_readlink, __NR_select, __NR_utimes or __NR_futimesat), so map each call
 * onto the equivalent available syscall.  On architectures that do provide the
 * original numbers the behaviour is unchanged.
\*===----------------------------------------------------------------------===*/

static int klee_sys_access(const char *path, int mode) {
#ifdef __NR_access
  return syscall(__NR_access, path, mode);
#else
  return syscall(__NR_faccessat, AT_FDCWD, path, mode, 0);
#endif
}

static int klee_sys_open(const char *path, int flags, mode_t mode) {
#ifdef __NR_open
  return syscall(__NR_open, path, flags, mode);
#else
  return syscall(__NR_openat, AT_FDCWD, path, flags, mode);
#endif
}

static void klee_timeval_to_timespec(const struct timeval in[2],
                                     struct timespec out[2]) {
  out[0].tv_sec = in[0].tv_sec;
  out[0].tv_nsec = 1000L * in[0].tv_usec;
  out[1].tv_sec = in[1].tv_sec;
  out[1].tv_nsec = 1000L * in[1].tv_usec;
}

static int klee_sys_utimes(const char *path, const struct timeval times[2]) {
#ifdef __NR_utimes
  return syscall(__NR_utimes, path, times);
#else
  struct timespec ts[2];
  if (!times)
    return syscall(__NR_utimensat, AT_FDCWD, path, NULL, 0);
  klee_timeval_to_timespec(times, ts);
  return syscall(__NR_utimensat, AT_FDCWD, path, ts, 0);
#endif
}

static int klee_sys_futimesat(int fd, const char *path,
                              const struct timeval times[2]) {
#ifdef __NR_futimesat
  return syscall(__NR_futimesat, (long)fd, path, times);
#else
  struct timespec ts[2];
  if (!times)
    return syscall(__NR_utimensat, fd, path, NULL, 0);
  klee_timeval_to_timespec(times, ts);
  return syscall(__NR_utimensat, fd, path, ts, 0);
#endif
}

static int klee_sys_stat(const char *path, struct stat64 *buf) {
#if defined(__NR_stat)
  return syscall(__NR_stat, path, buf);
#else
  return syscall(__NR_newfstatat, AT_FDCWD, path, buf, 0);
#endif
}

static int klee_sys_lstat(const char *path, struct stat64 *buf) {
#if defined(__NR_lstat)
  return syscall(__NR_lstat, path, buf);
#else
  return syscall(__NR_newfstatat, AT_FDCWD, path, buf, AT_SYMLINK_NOFOLLOW);
#endif
}

static int klee_sys_chmod(const char *path, mode_t mode) {
#ifdef __NR_chmod
  return syscall(__NR_chmod, path, mode);
#else
  return syscall(__NR_fchmodat, AT_FDCWD, path, mode, 0);
#endif
}

static int klee_sys_chown(const char *path, uid_t owner, gid_t group) {
#ifdef __NR_chown
  return syscall(__NR_chown, path, owner, group);
#else
  return syscall(__NR_fchownat, AT_FDCWD, path, owner, group, 0);
#endif
}

static ssize_t klee_sys_readlink(const char *path, char *buf, size_t bufsize) {
#ifdef __NR_readlink
  return syscall(__NR_readlink, path, buf, bufsize);
#else
  return syscall(__NR_readlinkat, AT_FDCWD, path, buf, bufsize);
#endif
}

static int klee_sys_select(int nfds, fd_set *readfds, fd_set *writefds,
                           fd_set *exceptfds, struct timeval *timeout) {
#ifdef __NR_select
  return syscall(__NR_select, nfds, readfds, writefds, exceptfds, timeout);
#else
  struct timespec ts, *tsp = NULL;
  if (timeout) {
    ts.tv_sec = timeout->tv_sec;
    ts.tv_nsec = 1000L * timeout->tv_usec;
    tsp = &ts;
  }
  return syscall(__NR_pselect6, nfds, readfds, writefds, exceptfds, tsp, NULL);
#endif
}

