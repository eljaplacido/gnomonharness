cd /app; python3 - <<'PY'
from collections import defaultdict, Counter
kmers={}
for line in open('test'):
  k,e=line.rstrip('\n').split('\t'); kmers[k]=e
edges={}
missing=[]
for k,e in kmers.items():
  l,r=e
  if r!='F':
    s=k[1:]+r
    if s in kmers: edges[k]=s
    else: missing.append((k,e,s))
  else: edges[k]=None
ind=Counter(); outd=Counter()
for a,b in edges.items():
  if b: outd[a]+=1; ind[b]+=1
starts=[k for k in kmers if ind[k]==0]
ends=[k for k in kmers if outd[k]==0]
print('starts',len(starts),starts[:20])
print('ends',len(ends),ends[:20])
print('missing',missing)
# components follow edges among nodes considering starts
seen=set(); comps=[]
for s in starts:
  if s in seen: continue
  path=[]; x=s
  while x is not None and x not in seen:
    seen.add(x); path.append(x); x=edges.get(x)
  comps.append(path)
# remaining cycles/unvisited
for s in kmers:
  if s not in seen:
    path=[]; x=s
    while x is not None and x not in seen:
      seen.add(x); path.append(x); x=edges.get(x)
    comps.append(path)
print('components',len(comps),[len(c) for c in comps])
for c in comps[:10]: print(len(c), c[0][:20], '...' , c[-1][:20])
# lengths of sequence assembled for each comp = k + edges
print('total edges in comps',sum(len(c)-1 for c in comps))
# inspect ends extensions
for x in ends[:20]: print('end',x,kmers[x])
for x in starts[:20]: print('start',x,kmers[x])
