```
cat > /app/Makefile <<'EOF'
# Build the serial and Berkeley UPC parallel de Bruijn graph assemblers.
CC       = gcc
CFLAGS   = -O2 -Wall -Wextra
UPCC     ?= /usr/local/bin/upcc
UPCRUN   ?= /usr/local/bin/upcrun
UPCFLAGS = -network=smp -O
THREADS  ?= 4

.PHONY: all clean run verify

all: serial pgen

serial: serial.c
        $(CC) $(CFLAGS) -o $@ $<

pgen: pgen.upc
        $(UPCC) $(UPCFLAGS) -o $@ $<

run: all
        ./serial test
        rm -f /app/pgen_*.out
        $(UPCRUN) -n $(THREADS) -shared-heap 256MB ./pgen test

verify: run
        @if cmp -s /app/serial.out /app/pgen_0.out; then \
                echo "SUCCESS: serial.out and pgen_0.out are identical"; \
        else \
                echo "FAILURE: outputs differ"; \
                diff -u /app/serial.out /app/pgen_0.out | head -80; \
                exit 1; \
        fi

clean:
        rm -f serial pgen serial.out pgen_*.out
EOF
cd /app
make clean
make 2>&1 | tee /tmp/make.log
echo '--- build status ---'; ls -l /app/serial /app/pgen /app/Makefile
make verify 2>&1 | tee /tmp/verify.log
echo '--- final artifacts ---'; ls -l /app/serial.out /app/pgen_0.out; wc -l /app/serial.out /app/pgen_0.out; cmp -s /app/serial.out /app/pgen_0.out && echo 
EXACT_MATCH
```
