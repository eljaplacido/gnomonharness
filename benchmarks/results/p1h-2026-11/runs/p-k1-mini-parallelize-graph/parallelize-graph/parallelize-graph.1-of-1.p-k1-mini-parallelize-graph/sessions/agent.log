export PATH=/usr/local/bin:$PATH
cd /app
for t in 1 2 3 8; do
  echo "=== threads $t ==="
  rm -f /app/pgen*.out
  timeout 60 upcrun -n $t -shared-heap 256MB /app/pgen /app/test > /tmp/pgen_$t.log 2>&1
  rc=$?
  count=$(wc -l < /app/pgen_0.out 2>/dev/null || echo missing)
  if cmp -s /app/serial.out /app/pgen_0.out; then eq=IDENTICAL; else eq=DIFFER; fi
  echo "rc=$rc lines=$count $eq"
  grep -E 'warning|error|ERROR' /tmp/pgen_$t.log | head -3
done
