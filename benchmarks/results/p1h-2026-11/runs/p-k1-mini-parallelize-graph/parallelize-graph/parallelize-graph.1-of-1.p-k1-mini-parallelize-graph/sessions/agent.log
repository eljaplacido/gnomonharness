cat > /app/serial.c <<'EOF'
#define _GNU_SOURCE
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>

typedef struct {
    char *kmer;
    char left;
    char right;
    int next;      /* successor node index, -1 if none */
    int indeg;
    int outdeg;
    int visited;
} Node;

static uint64_t hash_string(const char *s) {
    uint64_t h = 1469598103934665603ULL;
    while (*s) {
        h ^= (unsigned char)(*s++);
        h *= 1099511628211ULL;
    }
    return h;
}

static int compare_contigs(const void *a, const void *b) {
    const char *sa = *(const char * const *)a;
    const char *sb = *(const char * const *)b;
    return strcmp(sa, sb);
}

int main(int argc, char **argv) {
    const char *input_path = (argc > 1) ? argv[1] : "test";
    FILE *in = fopen(input_path, "r");
    if (!in) {
        fprintf(stderr, "serial: cannot open input file '%s'\n", input_path);
        return 1;
    }

    size_t cap = 1024;
    int n = 0;
    Node *nodes = (Node *)malloc(cap * sizeof(Node));
    if (!nodes) { fclose(in); return 1; }

    int table_size = 1;
    while (table_size < 2048) table_size <<= 1;
    int *buckets = (int *)malloc((size_t)table_size * sizeof(int));
    if (!buckets) { free(nodes); fclose(in); return 1; }
    for (int i = 0; i < table_size; i++) buckets[i] = -1;

    char *line = NULL;
    size_t line_cap = 0;
    ssize_t got;
    int k = -1;

    while ((got = getline(&line, &line_cap, in)) >= 0) {
        while (got > 0 && (line[got - 1] == '\n' || line[got - 1] == '\r')) line[--got] = '\0';
        if (got == 0) continue;

        char *tab = strchr(line, '\t');
        if (!tab) continue;
        *tab = '\0';
        char *kmer = line;
        char *ext = tab + 1;
        if (ext[0] == '\0' || ext[1] == '\0') continue;
        int klen = (int)strlen(kmer);
        if (klen == 0) continue;
        if (k == -1) k = klen;

        if ((size_t)n == cap) {
            cap *= 2;
            Node *tmp = (Node *)realloc(nodes, cap * sizeof(Node));
            if (!tmp) { fprintf(stderr, "serial: out of memory\n"); return 1; }
            nodes = tmp;
        }

        /* Keep the input k-mers unique. */
        uint64_t h = hash_string(kmer);
        int b = (int)(h & (uint64_t)(table_size - 1));
        int found = -1;
        for (int p = buckets[b]; p >= 0; p = nodes[p].next) {
            if (strcmp(nodes[p].kmer, kmer) == 0) { found = p; break; }
        }
        if (found >= 0) {
            if (nodes[found].left == 'F' && ext[0] != 'F') nodes[found].left = ext[0];
            if (nodes[found].right == 'F' && ext[1] != 'F') nodes[found].right = ext[1];
            continue;
        }

        nodes[n].kmer = strdup(kmer);
        if (!nodes[n].kmer) { fprintf(stderr, "serial: out of memory\n"); return 1; }
        nodes[n].left = ext[0];
        nodes[n].right = ext[1];
        nodes[n].next = -1;
        nodes[n].indeg = 0;
        nodes[n].outdeg = 0;
        nodes[n].visited = 0;
        nodes[n].next = buckets[b];
        buckets[b] = n;
        n++;
    }
    free(line);
    fclose(in);
    if (n == 0) {
        FILE *out = fopen("/app/serial.out", "w");
        if (out) fclose(out);
        free(buckets);
        free(nodes);
        return 0;
    }

    /* Rebuild a hash table large enough for the final number of vertices. */
    int new_size = 1;
    while (new_size < 2 * n) new_size <<= 1;
    if (new_size != table_size) {
        int *new_buckets = (int *)malloc((size_t)new_size * sizeof(int));
        if (!new_buckets) { fprintf(stderr, "serial: out of memory\n"); return 1; }
        for (int i = 0; i < new_size; i++) new_buckets[i] = -1;
        for (int i = 0; i < n; i++) {
            uint64_t h = hash_string(nodes[i].kmer);
            int b = (int)(h & (uint64_t)(new_size - 1));
            nodes[i].next = new_buckets[b];
            new_buckets[b] = i;
        }
        free(buckets);
        buckets = new_buckets;
        table_size = new_size;
    }

    /* Construct graph edges using right extensions. */
    for (int i = 0; i < n; i++) {
        nodes[i].indeg = 0;
        nodes[i].outdeg = 0;
        nodes[i].next = -1;
    }
    for (int i = 0; i < n; i++) {
        char r = nodes[i].right;
        if (r == 'F') continue;
        size_t klen = strlen(nodes[i].kmer);
        char *succ = (char *)malloc(klen + 2);
        if (!succ) { fprintf(stderr, "serial: out of memory\n"); return 1; }
        memcpy(succ, nodes[i].kmer + 1, klen - 1);
        succ[klen - 1] = r;
        succ[klen] = '\0';

        uint64_t h = hash_string(succ);
        int b = (int)(h & (uint64_t)(table_size - 1));
        int target = -1;
        for (int p = buckets[b]; p >= 0; p = nodes[p].next) {
            if (strcmp(nodes[p].kmer, succ) == 0) { target = p; break; }
        }
        free(succ);
        if (target >= 0) {
            nodes[i].next = target;
            nodes[i].outdeg = 1;
            nodes[target].indeg++;
        }
    }

    char **contigs = (char **)malloc((size_t)n * sizeof(char *));
    if (!contigs) { fprintf(stderr, "serial: out of memory\n"); return 1; }
    int contig_count = 0;
    size_t max_len = (size_t)n + (size_t)k + 2;

    /* First seed at every vertex whose indegree is not exactly one. */
    for (int start = 0; start < n; start++) {
        if (nodes[start].visited || nodes[start].indeg == 1) continue;
        char *s = (char *)malloc(max_len);
        if (!s) { fprintf(stderr, "serial: out of memory\n"); return 1; }
        strcpy(s, nodes[start].kmer);
        size_t len = strlen(s);
        int cur = start;
        nodes[cur].visited = 1;
        while (nodes[cur].next >= 0 &&
               nodes[cur].outdeg == 1 &&
               nodes[nodes[cur].next].indeg == 1 &&
               !nodes[nodes[cur].next].visited) {
            cur = nodes[cur].next;
            nodes[cur].visited = 1;
            s[len++] = nodes[cur].kmer[k - 1];
            s[len] = '\0';
        }
        contigs[contig_count++] = s;
    }

    /* Remaining unvisited vertices belong to cycles or to tails following a
       branch.  They are handled in the same deterministic vertex order. */
    for (int start = 0; start < n; start++) {
        if (nodes[start].visited) continue;
        char *s = (char *)malloc(max_len);
        if (!s) { fprintf(stderr, "serial: out of memory\n"); return 1; }
        strcpy(s, nodes[start].kmer);
        size_t len = strlen(s);
        int cur = start;
        nodes[cur].visited = 1;
        while (nodes[cur].next >= 0 &&
               nodes[cur].outdeg == 1 &&
               nodes[nodes[cur].next].indeg == 1 &&
               !nodes[nodes[cur].next].visited) {
            cur = nodes[cur].next;
            nodes[cur].visited = 1;
            s[len++] = nodes[cur].kmer[k - 1];
            s[len] = '\0';
        }
        contigs[contig_count++] = s;
    }

    qsort(contigs, (size_t)contig_count, sizeof(char *), compare_contigs);

    FILE *out = fopen("/app/serial.out", "w");
    if (!out) {
        fprintf(stderr, "serial: cannot write /app/serial.out\n");
        return 1;
    }
    for (int i = 0; i < contig_count; i++) {
        fprintf(out, "%s\n", contigs[i]);
        free(contigs[i]);
    }
    fclose(out);

    free(contigs);
    free(buckets);
    for (int i = 0; i < n; i++) free(nodes[i].kmer);
    free(nodes);
    return 0;
}
