cd /app; python3 - <<'PY'
from collections import defaultdict, Counter
kmers={}
with open('test') as f:
  for line in f:
    k,e=line.rstrip('\n').split('\t')
    kmers[k]=e
print('n',len(kmers))
missingR=Counter(); missingL=Counter(); both=0
edges=[]
for k,e in kmers.items():
    l,r=e
    if r!='F':
      succ=k[1:]+r
      if succ not in kmers: missingR[(k,e)]=succ
      else: edges.append((k,succ))
    if l!='F':
      pred=l+k[:-1]
      if pred not in kmers: missingL[(k,e)]=pred
print('right ext edges',sum(1 for e in kmers.values() if e[1]!='F'),'missing',len(missingR))
print('left ext edges',sum(1 for e in kmers.values() if e[0]!='F'),'missing',len(missingL))
# compare inferred edges sets: left link at Y should be edge X->Y where X=left(Y)+Y[:-1]
inferred=set()
for k,e in kmers.items():
    l,r=e
    if l!='F': inferred.add((l+k[:-1],k))
direct=set(edges)
print('direct',len(direct),'inferred',len(inferred),'same',direct==inferred,'d-i',len(direct-inferred),'i-d',len(inferred-direct))
# degrees
ind=Counter(); outd=Counter()
for a,b in direct:
  outd[a]+=1; ind[b]+=1
print('outdeg',Counter(outd.values()),'indeg',Counter(ind.values()))
print('nodes with both0-ish',sum(1 for k in kmers if ind[k]==0 and outd[k]==0))
print('components/path starts')
