[297.79702, "o", "\r\u001b[2K\r\n\u001b[1;31mmini-swe-agent\u001b[0m\u001b[31m (step \u001b[0m\u001b[1;31m20\u001b[0m\u001b[31m, \u001b[0m\u001b[1;31m$0.00\u001b[0m\u001b[31m):\u001b[0m\r\n\u001b[32m⠴\u001b[0m Waiting for the LM to respond...\r\u001b[2K```\r\nexport PATH=/usr/local/bin:$PATH\r\nupcrun --help 2>&1 | grep -i -A3 -B2 'network\\|smp\\|udp'; echo '--- env'; env | grep -i upc || true; echo '--- config files'; ls -la ~/.upcrunrc \r\n/usr/local/etc/upcrunrc /usr/local/share/upcrunrc 2>/dev/null || true; find /usr/local -name '*upcrunrc*' 2>/dev/null | head\r\n```\r\n\u001b[32m⠴\u001b[0m Waiting for the LM to respond..."]
