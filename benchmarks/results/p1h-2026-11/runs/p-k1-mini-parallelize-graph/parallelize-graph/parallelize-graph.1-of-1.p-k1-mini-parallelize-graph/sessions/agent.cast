[393.470289, "o", "\r\u001b[2K```\r\nexport PATH=/usr/local/bin:$PATH\r\nfor decl in \"shared [THREADS] int A[100];\" \"shared [1] int A[10*THREADS];\" \"shared [] int A[100];\" \"shared [THREADS] int A[100*THREADS];\"; do\r\n  echo \"=== $decl\"\r\n  cat > /tmp/st.upc <<EOF\r\n#include <upc.h>\r\n#include <stdio.h>\r\n$decl\r\nint main(void){ A[MYTHREAD]=1; upc_barrier; if(MYTHREAD==0) printf(\"%d\\n\",A[0]); return 0; }\r\nEOF\r\n  upcc -network=smp -o /tmp/st /tmp/st.upc 2>&1 | head -10\r\n  echo status=${PIPESTATUS[0]}\r\ndone\r\n```\r\n\u001b[32m⠙\u001b[0m Waiting for the LM to respond..."]
[393.471585, "o", "\r\u001b[2K\u001b[32m⠙\u001b[0m Waiting for the LM to respond...\r\n\u001b[?25h\r\u001b[1A\u001b[2K"]
