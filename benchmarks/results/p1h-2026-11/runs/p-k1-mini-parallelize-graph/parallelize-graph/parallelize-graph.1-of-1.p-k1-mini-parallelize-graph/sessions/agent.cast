[297.845081, "o", "<returncode>\r\n0\r\n<output>\r\n    -h -? -help\r\n            See this message\r\n    -help-gasnet [network_name]\r\n            See the GASNet documentation, or the GASNet documentation\r\n            for a particular network conduit.\r\n    -conf=FILE\r\n            Read FILE instead of the $HOME/.upcrunrc configuration file.\r\n    -norc\r\n--- env\r\n--- config files\r\n\r\n"]
