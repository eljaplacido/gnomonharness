[387.477676, "o", "\r\u001b[2K```\r\nexport PATH=/usr/local/bin:$PATH\r\ncat > /tmp/static_test.upc <<'EOF'\r\n#include <upc.h>\r\n#include <stdio.h>\r\nshared [1] int A[100];\r\nshared int B[100];\r\nint main(void) {\r\n  A[MYTHREAD] = 42;\r\n  B[MYTHREAD] = 7;\r\n  upc_barrier;\r\n  if (MYTHREAD == 0) printf(\"A=%d B=%d THREADS=%d\\n\", A[1], B[1], THREADS);\r\n  return 0;\r\n}\r\nEOF\r\nupcc -network=smp -o /tmp/static_test /tmp/static_test.upc 2>&1 | head -40; echo EXIT=${PIPESTATUS[0]}\r\n```\r\n\u001b[32m⠹\u001b[0m Waiting for the LM to respond..."]
