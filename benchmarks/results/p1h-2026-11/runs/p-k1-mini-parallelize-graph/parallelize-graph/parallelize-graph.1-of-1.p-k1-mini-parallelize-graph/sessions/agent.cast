[55.535667, "o", "<returncode>\r\n0\r\n<output>\r\nn 10000\r\nright ext edges 9995 missing 1\r\nleft ext edges 9994 missing 0\r\ndirect 9994 inferred 9994 same True d-i 0 i-d 0\r\noutdeg Counter({1: 9994}) indeg Counter({1: 9994})\r\nnodes with both0-ish 0\r\ncomponents/path starts\r\n\r\n"]
