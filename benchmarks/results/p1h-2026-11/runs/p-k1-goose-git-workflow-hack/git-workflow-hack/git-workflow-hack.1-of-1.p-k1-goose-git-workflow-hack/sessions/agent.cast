[111.310474, "o", "\r\n  \u001b[2m────────────────────────────────────────\u001b[0m\r\n  \u001b[2m▸\u001b[0m \u001b[2medit\u001b[0m\r\n    \u001b[2mpath\u001b[0m \u001b[2m/app/my_website/scripts/build.py\u001b[0m\r\n    \u001b[2mbefore\u001b[0m: \u001b[32mdef pretty_date(iso: str) -> str:\r\n    return date.fromisoformat(iso).strftime(\"%B %-d, %Y\") if False else _pretty(iso)\r\n\r\n\r\ndef _pretty(iso: str) ->...\u001b[0m\r\n    \u001b[2mafter\u001b[0m: \u001b[32mdef _pretty(iso: str) -> str:\r\n    \"\"\"Cross-platform 'Month D, YYYY' formatting.\"\"\"\r\n    d = date.fromisoformat(iso)\r\n    return f\"{d.strftime('%B')}...\u001b[0m\r\n\r\n\r\n  \u001b[2m────────────────────────────────────────\u001b[0m\r\n  \u001b[2m▸\u001b[0m \u001b[2mwrite\u001b[0m\r\n    \u001b[2mpath\u001b[0m \u001b[2m/app/my_website/src/content/about.html\u001b[0m\r\n    \u001b[2mcontent\u001b[0m: \u001b[32m    <div class=\"wrap\">\r\n\r\n      <!-- Hero -->\r\n      <section class=\"hero\">\r\n        <div class=\"hero__text\">\r\n          <p class=\"eyebrow\">Associate...\u001b[0m\r\n\r\n\r\n  \u001b[2m────────────────────────────────────────\u001b[0m\r\n  \u001b[2m▸\u001b[0m \u001b[2mwrite\u001b[0m\r\n    \u001b[2mpath\u001b[0m \u001b[2m/app/my_website/src/content/blog.html\u001b[0m\r\n    \u001b[2mcontent\u001b[0m: \u001b[32m    <div class=\"wrap wrap--narrow\">\r\n      <header class=\"page-head\">\r\n        <p class=\"eyebrow\">Writing</p>\r\n        <h1 class=\"page-title\">Blog<...\u001b[0m\r\n\r\n"]
