[12.57986, "o", "3. Configure the base model with 20 language classes (not the default 2)\r\n\u001b[?2004l\r"]
[12.57989, "o", "\u001b[?2004h> "]
[12.579971, "o", "4. Save the configured model and tokenizer to '\"'\"'/app/model_cache/xlm-roberta-base'\"'\"'\r\n\u001b[?2004l\r\u001b[?2004h"]
