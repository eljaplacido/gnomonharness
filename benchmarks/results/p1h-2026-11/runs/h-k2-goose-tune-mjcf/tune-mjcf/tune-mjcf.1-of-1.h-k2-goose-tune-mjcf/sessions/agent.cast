[561.256482, "o", "\u001b[37m the default\u001b[0m"]
[561.282811, "o", "\u001b[37m \u001b[0m"]
[561.328681, "o", "\u001b[32m`\u001b[0m\u001b[32mmjSOL_NEWTON\u001b[0m\u001b[32m`\u001b[0m\u001b[37m path\u001b[0m"]
[561.354559, "o", "\u001b[37m burns\u001b[0m"]
