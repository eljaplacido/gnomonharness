[561.06913, "o", "\u001b[37m|\u001b[0m\u001b[37m---------------\u001b[0m\u001b[37m|\u001b[0m\u001b[37m---------\u001b[0m\u001b[37m|\u001b[0m\u001b[37m-----------------------------------\u001b[0m\u001b[37m|\u001b[0m\r\n\u001b[37m|\u001b[0m\u001b[37m \u001b[0m\u001b[32m`\u001b[0m\u001b[32mconstraint\u001b[0m\u001b[32m`\u001b[0m\u001b[37m  \u001b[0m\u001b[37m|\u001b[0m\u001b[37m \u001b[0m\u001b[1;33m**\u001b[0m\u001b[1;33m155\u001b[0m\u001b[1;33m**\u001b[0m\u001b[37m \u001b[0m\u001b[37m|\u001b[0m\u001b[37m Newton solve dominates (59%)      \u001b[0m\u001b[37m|\u001b[0m\r\n\u001b[37m|\u001b[0m\u001b[37m \u001b[0m\u001b[32m`\u001b[0m\u001b[32mpos_inertia\u001b[0m\u001b[32m`\u001b[0m\u001b[37m \u001b[0m\u001b[37m|\u001b[0m\u001b[37m 48      \u001b[0m\u001b[37m|\u001b[0m\u001b[37m M assembly/factorization          \u001b[0m\u001b[37m|\u001b[0m\r\n"]
