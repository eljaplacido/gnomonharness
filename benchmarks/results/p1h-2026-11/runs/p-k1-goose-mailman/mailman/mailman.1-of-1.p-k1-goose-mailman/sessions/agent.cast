[64.381698, "o", "    \u001b[2m[postfix]\u001b[0m\r\n    \u001b[2m# Additional configuration variables for the postfix MTA.\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2m# This variable describe the program to use for regenerating the transport map\u001b[0m\r\n    \u001b[2m# db file, from the associated plain text files.  The file being updated will\u001b[0m\r\n    \u001b[2m# be appended to this string (with a separating space), so it must be\u001b[0m\r\n    \u001b[2m# appropriate for os.system().\u001b[0m\r\n    \u001b[2mpostmap_command: /usr/sbin/postmap\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2m# This variable describes the type of transport maps that will be generated by\u001b[0m\r\n    \u001b[2m\u001b[3m... (49 lines hidden, /toggle to show all)\u001b[0m\r\n    \u001b[2m        for destination in sorted(SUBDESTINATIONS):\u001b[0m\r\n    \u001b[2m            yield '{}-{}@{}'.format(\u001b[0m\r\n    \u001b[2m                mlist.list_name, destination, mlist.mail_host)\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2m    def destinations(self, mlist):\u001b[0m\r\n    \u001b[2m        \"\"\"See `IMailTransportAgentAliases`.\"\"\"\u001b[0m\r\n    \u001b[2m        # Always return\u001b[0m\r\n    \u001b[2m        yield mlist.list_name\u001b[0m\r\n    \u001b[2m        for destination in sorted(SUBDESTINATIONS):\u001b[0m\r\n    \u001b[2m            yield '{}-{}'.format(mlist.list_name, destination)\u001b[0m\r\n"]
