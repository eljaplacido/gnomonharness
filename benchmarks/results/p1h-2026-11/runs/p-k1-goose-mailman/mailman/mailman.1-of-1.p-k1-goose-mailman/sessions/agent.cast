[19.040286, "o", "\r\n  \u001b[2m────────────────────────────────────────\u001b[0m\r\n  \u001b[2m▸\u001b[0m \u001b[2mshell\u001b[0m\r\n    \u001b[2mcommand\u001b[0m: \u001b[32mcat /app/eval.py\u001b[0m\r\n\r\n\r\n  \u001b[2m────────────────────────────────────────\u001b[0m\r\n  \u001b[2m▸\u001b[0m \u001b[2mshell\u001b[0m\r\n    \u001b[2mcommand\u001b[0m: \u001b[32mcat /etc/mailman3/mailman.cfg; cat /etc/postfix/main.cf 2>/dev/null | head -60; mailman --version\u001b[0m\r\n\r\n"]
[19.183115, "o", "    \u001b[2mimport mailbox\u001b[0m\r\n    \u001b[2mimport os\u001b[0m\r\n    \u001b[2mimport smtplib\u001b[0m\r\n    \u001b[2mimport subprocess\u001b[0m\r\n    \u001b[2mfrom email.mime.text import MIMEText\u001b[0m\r\n    \u001b[2mfrom functools import partial as bind\u001b[0m\r\n    \u001b[2mfrom time import sleep\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2mfrom mailman.core.initialize import initialize\u001b[0m\r\n    \u001b[2mfrom mailman.interfaces.listmanager import IListManager\u001b[0m\r\n    \u001b[2m\u001b[3m... (185 lines hidden, /toggle to show all)\u001b[0m\r\n    \u001b[2m    retry(_assert_mailbox_exists)\u001b[0m\r\n    \u001b[2m    retry(bind(confirm_last_reply, user, \"join\"))\u001b[0m\r\n    \u001b[2m    retry(_assert_member)\u001b[0m\r\n    \u001b[2m    print(f\"{user} has confirmed their subscription\")\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2mif __name__ == \"__main__\":\u001b[0m\r\n    \u001b[2m    test_simple_local_delivery()\u001b[0m\r\n    \u001b[2m    test_mlist_exists()\u001b[0m\r\n    \u001b[2m    test_join_flow()\u001b[0m\r\n    \u001b[2m# Copyright (C) 2008-2017 by the Free Software Foundation, Inc.\u001b[0m\r\n    \u001b[2m#\u001b[0m\r\n    \u001b[2m# This file is part of GNU Mailman.\u001b[0m\r\n    \u001b[2m#\u001b[0m\r\n    \u001b[2m# GNU Mailman is free software: you can redistribute it and/or modify it under\u001b[0m\r\n    \u001b[2m# the terms of the GNU General Public License as published by the Free\u001b[0m\r\n    \u001b[2m# Software Foundation, either version 3 of the License, or (at your option)\u001b[0m\r\n    \u001b[2m# any later version.\u001b[0m\r\n    \u001b[2m#\u001b[0m\r\n    \u001b[2m# GNU Mailman is distributed in the hope that it will be useful, but WITHOUT\u001b[0m\r\n    \u001b[2m\u001b[3m... (298 lines hidden, /toggle to show all)\u001b[0m\r\n    \u001b[2malias_maps = hash:/etc/aliases\u001b[0m\r\n    \u001b[2malias_database = hash:/etc/aliases\u001b[0m\r\n    \u001b[2mmydestination = $myhostname, localhost, localhost.localdomain, , localhost\u001b[0m\r\n    \u001b[2mrelayhost = \u001b[0m\r\n    \u001b[2mmynetworks = 127.0.0.0/8 [::ffff:127.0.0.0]/104 [::1]/128\u001b[0m\r\n    \u001b[2mmailbox_size_limit = 0\u001b[0m\r\n    \u001b[2mrecipient_delimiter = +\u001b[0m\r\n    \u001b[2minet_interfaces = all\u001b[0m\r\n    \u001b[2minet_protocols = all\u001b[0m\r\n    \u001b[2mGNU Mailman 3.3.8 (Tom Sawyer)\u001b[0m\r\n"]
[21.679324, "o", "\r\n  \u001b[2m────────────────────────────────────────\u001b[0m\r\n  \u001b[2m▸\u001b[0m \u001b[2mshell\u001b[0m\r\n    \u001b[2mcommand\u001b[0m: \u001b[32mpostfix status 2>&1; ls /var/lib/mailman3; ls /var/lib/mailman3/lists 2>/dev/null; cat /etc/aliases; postconf -n\u001b[0m\r\n\r\n\r\n  \u001b[2m────────────────────────────────────────\u001b[0m\r\n  \u001b[2m▸\u001b[0m \u001b[2mshell\u001b[0m\r\n    \u001b[2mcommand\u001b[0m: \u001b[32mls /etc/postfix; cat /etc/postfix/master.cf | grep -v '^#' | grep -v '^$'; ls /var/log/mailman3 2>/dev/null; ls /var/lib/mailman3/data 2>/dev/nu...\u001b[0m\r\n\r\n"]
[21.73214, "o", "    \u001b[2mpostfix/postlog: the Postfix mail system is not running\u001b[0m\r\n    \u001b[2mdata\u001b[0m\r\n    \u001b[2m# See man 5 aliases for format\u001b[0m\r\n    \u001b[2mpostmaster:    root\u001b[0m\r\n    \u001b[2malias_database = hash:/etc/aliases\u001b[0m\r\n    \u001b[2malias_maps = hash:/etc/aliases\u001b[0m\r\n    \u001b[2mappend_dot_mydomain = no\u001b[0m\r\n    \u001b[2mbiff = no\u001b[0m\r\n    \u001b[2mcompatibility_level = 3.6\u001b[0m\r\n    \u001b[2minet_interfaces = all\u001b[0m\r\n    \u001b[2m\u001b[3m... (6 lines hidden, /toggle to show all)\u001b[0m\r\n    \u001b[2mrecipient_delimiter = +\u001b[0m\r\n    \u001b[2mrelayhost =\u001b[0m\r\n    \u001b[2msmtp_tls_CApath = /etc/ssl/certs\u001b[0m\r\n    \u001b[2msmtp_tls_security_level = may\u001b[0m\r\n    \u001b[2msmtp_tls_session_cache_database = btree:${data_directory}/smtp_scache\u001b[0m\r\n    \u001b[2msmtpd_banner = $myhostname ESMTP $mail_name (Ubuntu)\u001b[0m\r\n    \u001b[2msmtpd_relay_restrictions = permit_mynetworks permit_sasl_authenticated defer_unauth_destination\u001b[0m\r\n    \u001b[2msmtpd_tls_cert_file = /etc/ssl/certs/ssl-cert-snakeoil.pem\u001b[0m\r\n    \u001b[2msmtpd_tls_key_file = /etc/ssl/private/ssl-cert-snakeoil.key\u001b[0m\r\n    \u001b[2msmtpd_tls_security_level = may\u001b[0m\r\n    \u001b[2mdynamicmaps.cf\u001b[0m\r\n    \u001b[2mdynamicmaps.cf.d\u001b[0m\r\n    \u001b[2mmain.cf\u001b[0m\r\n    \u001b[2mmain.cf.proto\u001b[0m\r\n    \u001b[2mmakedefs.out\u001b[0m\r\n    \u001b[2mmaster.cf\u001b[0m\r\n    \u001b[2mmaster.cf.proto\u001b[0m\r\n    \u001b[2mpost-install\u001b[0m\r\n    \u001b[2mpostfix-files\u001b[0m\r\n    \u001b[2mpostfix-files.d\u001b[0m\r\n    \u001b[2m\u001b[3m... (22 lines hidden, /toggle to show all)\u001b[0m\r\n    \u001b[2mlocal     unix  -       n       n       -       -       local\u001b[0m\r\n    \u001b[2mvirtual   unix  -       n       n       -       -       virtual\u001b[0m\r\n    \u001b[2mlmtp      unix  -       - 