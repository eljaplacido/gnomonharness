[61.061126, "o", "    \u001b[2mUsage: mailman [OPTIONS] COMMAND [ARGS]...\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2m  The GNU Mailman mailing list management system Copyright 1998-2018 by the\u001b[0m\r\n    \u001b[2m  Free Software Foundation, Inc. http://www.list.org\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2mOptions:\u001b[0m\r\n    \u001b[2m  --version          Show the version and exit.\u001b[0m\r\n    \u001b[2m  --run-as-root      Running mailman commands as root is not recommended and\u001b[0m\r\n    \u001b[2m                     mailman will refuse to run as root unless this option is\u001b[0m\r\n    \u001b[2m                     specified.\u001b[0m\r\n    \u001b[2m\u001b[3m... (25 lines hidden, /toggle to show all)\u001b[0m\r\n    \u001b[2m  reopen         Signal the Mailman processes to re-open their log files.\u001b[0m\r\n    \u001b[2m  restart        Stop and restart the Mailman runner subprocesses.\u001b[0m\r\n    \u001b[2m  shell          Operate on a mailing list.\u001b[0m\r\n    \u001b[2m  start          Start the Mailman master and runner processes.\u001b[0m\r\n    \u001b[2m  status         Show the current running status of the Mailman system.\u001b[0m\r\n    \u001b[2mmailman.cfg.sample\u001b[0m\r\n    \u001b[2mmailman_cfg_hyperkitty_snippet.cfg\u001b[0m\r\n    \u001b[2mmailman\u001b[0m\r\n    \u001b[2mmaster\u001b[0m\r\n    \u001b[2mrunner\u001b[0m\r\n"]
