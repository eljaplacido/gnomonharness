[174.846259, "o", "    \u001b[2m    print()\u001b[0m\r\n    \u001b[2m    print(_(\"\"\"\\\u001b[0m\r\n    \u001b[2mProgrammatically, you can write a function to operate on a mailing list, and\u001b[0m\r\n    \u001b[2mthis script will take care of the housekeeping (see below for examples).  In\u001b[0m\r\n    \u001b[2mthat case, the general usage syntax is:\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2m% mailman withlist [options] -l listspec [args ...]\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2mwhere `listspec` is either the posting address of the mailing list\u001b[0m\r\n    \u001b[2m(e.g. ant@example.com), or the List-ID (e.g. ant.example.com).\"\"\"))\u001b[0m\r\n    \u001b[2m\u001b[3m... (95 lines hidden, /toggle to show all)\u001b[0m\r\n    \u001b[2m            banner = _(\"The variable 'm' is the ${listspec} mailing list\")\u001b[0m\r\n    \u001b[2m    # All other processing is finished; maybe go into interactive mode.\u001b[0m\r\n    \u001b[2m    if interactive:\u001b[0m\r\n    \u001b[2m        do_interactive(ctx, banner)\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2m@public\u001b[0m\r\n    \u001b[2m@implementer(ICLISubCommand)\u001b[0m\r\n    \u001b[2mclass Withlist:\u001b[0m\r\n    \u001b[2m    name = 'withlist'\u001b[0m\r\n"]
