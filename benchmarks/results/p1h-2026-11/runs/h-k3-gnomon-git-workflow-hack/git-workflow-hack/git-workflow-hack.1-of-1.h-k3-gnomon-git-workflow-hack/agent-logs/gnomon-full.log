  if (empty) issues.push(`${empty} empty elements`);
  if (issues.length) { console.log(`  ${f.replace('/app/my_website/public/','')}: ${issues.join('; ')}`); bad++; }
}
console.log(bad? `✗ ${bad} files with structural issues` : '✓ all pages structurally sound (single h1, main landmark, nav, heading order)');
