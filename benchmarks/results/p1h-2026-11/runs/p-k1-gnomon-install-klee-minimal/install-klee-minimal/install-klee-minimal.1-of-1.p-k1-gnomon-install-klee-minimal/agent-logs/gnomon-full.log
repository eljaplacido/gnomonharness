#!/bin/bash
# Full acceptance suite for the KLEE + STP + LLVM 16 installation.
# Simulates the grader: fresh non-interactive shell that sources ~/.bashrc.
set -u
fail=0
ck() { if [ "$1" = 1 ]; then echo "PASS: $2"; else echo "FAIL: $2"; fail=1; fi; }
run_klee() { # dir bcfile args...
  local d="$1"; shift; local bc="$1"; shift
  rm -rf "$d"
  timeout -s KILL 90 klee --output-dir="$d" "$@" "$bc" > "$d.log" 2>&1
}

source "$HOME/.bashrc" >/dev/null 2>&1
echo "PATH=$PATH"
echo "CPATH=${CPATH:-<unset>}"
echo "LD_LIBRARY_PATH=${LD_LIBRARY_PATH:-<unset>}"
echo

# --- tool availability -------------------------------------------------
command -v klee >/dev/null && ck 1 "klee on PATH: $(command -v klee)" || ck 0 "klee on PATH"
for t in kleaver klee-stats klee-replay ktest-tool ktest-gen klee-exec-tree; do
  command -v "$t" >/dev/null && ck 1 "$t on PATH" || ck 0 "$t on PATH"
done
command -v stp >/dev/null && ck 1 "stp on PATH" || ck 0 "stp on PATH"
command -v llvm-config-16 >/dev/null && ck 1 "llvm-config-16 on PATH" || ck 0 "llvm-config-16 on PATH"

# --- version / build configuration ------------------------------------
klee --version > v.txt 2>&1
grep -q "KLEE 3.3" v.txt && ck 1 "klee version 3.3" || ck 0 "klee version 3.3"
grep -q "LLVM version 16" v.txt && ck 1 "klee built against LLVM 16" || ck 0 "klee built against LLVM 16"
grep -q "Build mode: Release (Asserts: ON)" v.txt && ck 1 "klee Release+Asserts" || ck 0 "klee Release+Asserts"

# --- header in CPATH --------------------------------------------------
echo "$CPATH" | tr ':' '\n' | grep -qx "/usr/local/include" && ck 1 "CPATH has /usr/local/include" || ck 0 "CPATH has /usr/local/include"
[ -f /usr/local/include/klee/klee.h ] && ck 1 "klee/klee.h present" || ck 0 "klee/klee.h present"
[ -e /usr/include/klee/klee.h ] && ck 1 "/usr/include/klee/klee.h present" || ck 0 "/usr/include/klee/klee.h present"

# --- no uClibc --------------------------------------------------------
ls /usr/local/lib/klee/runtime/*uclibc* >/dev/null 2>&1 && ck 0 "no uClibc runtime library" || ck 1 "no uClibc runtime library"
[ -z "${KLEE_UCLIBC_PATH:-}" ] && ck 1 "KLEE_UCLIBC_PATH unset" || ck 0 "KLEE_UCLIBC_PATH unset"

# --- solver is STP ----------------------------------------------------
klee --help 2>&1 | grep -q "=stp .*-   STP (default)" && ck 1 "STP reported as default solver backend" || ck 0 "STP reported as default solver backend"
stp --version 2>&1 | grep -q "STP version" && ck 1 "stp --version works" || ck 0 "stp --version works"

work=$(mktemp -d); cd "$work"

# --- test 1: classic KLEE example, compiled using CPATH only ----------
cat > t1.c <<'C'
#include <klee/klee.h>
#include <assert.h>
int main(void) {
  int x = 0;
  klee_make_symbolic(&x, sizeof(x), "x");
  if (x > 0) {
    if (x == 5) assert(0 && "x is five");
  }
  return 0;
}
C
if clang-16 -emit-llvm -c -g -O0 -Xclang -disable-O0-optnone t1.c -o t1.bc 2>c1.err; then
  ck 1 "t1 compiles with CPATH only (#include <klee/klee.h>)"
else
  ck 0 "t1 compiles with CPATH only"; cat c1.err
fi
run_klee k1 t1.bc
[ $? = 0 ] && ck 1 "t1: klee exits 0" || ck 0 "t1: klee exits 0"
grep -q "Using STP solver backend" k1.log && ck 1 "t1: STP backend used" || ck 0 "t1: STP backend used"
grep -q "ASSERTION FAIL" k1.log && ck 1 "t1: assertion reached (path exploration works)" || ck 0 "t1: assertion reached"
n=$(ls k1/*.ktest 2>/dev/null | wc -l); [ "$n" -ge 2 ] && ck 1 "t1: 2 test cases generated ($n)" || ck 0 "t1: 2 test cases generated ($n)"

# --- test 2: klee_assume with a conjunction (the aarch64 hang repro) --
cat > t2.c <<'C'
#include <klee/klee.h>
#include <assert.h>
int main(void) {
  int a = 0, b = 0;
  klee_make_symbolic(&a, sizeof(a), "a");
  klee_make_symbolic(&b, sizeof(b), "b");
  klee_assume(a > 0 && a < 10);
  assert(a < 10 && a > 0);
  if (a == b) { assert(b > 0); }
  return 0;
}
C
clang-16 -emit-llvm -c -g -O0 -Xclang -disable-O0-optnone t2.c -o t2.bc && ck 1 "t2 compiles" || ck 0 "t2 compiles"
run_klee k2 t2.bc
rc=$?; [ "$rc" = 0 ] && ck 1 "t2: klee terminates with conjoined constraints (no solver hang)" || ck 0 "t2: klee terminates (rc=$rc)"
n=$(ls k2/*.ktest 2>/dev/null | wc -l); [ "$n" -ge 1 ] && ck 1 "t2: tests generated ($n)" || ck 0 "t2: tests generated"

# --- test 3: array/bitvector heavy program (exercises the solver) ------
cat > t3.c <<'C'
#include <klee/klee.h>
#include <assert.h>
int main(void) {
  unsigned char buf[4] = {0};
  klee_make_symbolic(buf, sizeof(buf), "buf");
  unsigned sum = buf[0] + buf[1] + buf[2] + buf[3];
  klee_assume(buf[0] < 10 && buf[1] < 10);
  assert(sum != 36 || buf[0] < 9);   /* last byte would have to be 9 */
  if (sum == 4) { assert(buf[0] == 1 && buf[1] == 1 && buf[2] == 1 && buf[3] == 1); }
  return 0;
}
C
clang-16 -emit-llvm -c -g -O0 -Xclang -disable-O0-optnone t3.c -o t3.bc && ck 1 "t3 compiles" || ck 0 "t3 compiles"
run_klee k3 t3.bc --max-time=60
rc=$?; [ "$rc" = 0 ] && ck 1 "t3: klee terminates" || ck 0 "t3: klee terminates (rc=$rc)"
n=$(ls k3/*.ktest 2>/dev/null | wc -l); [ "$n" -ge 1 ] && ck 1 "t3: tests generated ($n)" || ck 0 "t3: tests generated"

# --- test 4: ktest-tool + klee-stats on produced output ----------------
ktest-tool k1/test000001.ktest > kt.txt 2>&1 && ck 1 "ktest-tool reads generated test" || ck 0 "ktest-tool reads generated test"
klee-stats k1 > ks.txt 2>&1 && grep -q "Path" ks.txt && ck 1 "klee-stats reports on output dir" || ck 0 "klee-stats reports on output dir"

# --- test 5: --libc=klee (no uClibc available) ------------------------
run_klee k5 t1.bc --libc=klee
[ $? = 0 ] && ck 1 "t1 runs with --libc=klee (KLEE libc, no uClibc)" || ck 0 "t1 runs with --libc=klee"

# --- test 6: kleaver / STP query path ---------------------------------
kleaver --version > kv.txt 2>&1 && ck 1 "kleaver runs" || ck 0 "kleaver runs"

echo
[ "$fail" = 0 ] && echo "ALL CHECKS PASSED" || echo "SOME CHECKS FAILED"
exit $fail
SUITE
