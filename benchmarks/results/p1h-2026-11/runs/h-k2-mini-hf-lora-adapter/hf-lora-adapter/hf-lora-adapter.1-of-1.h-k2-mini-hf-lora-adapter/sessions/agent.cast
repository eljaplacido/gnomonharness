[264.72659, "o", "\r\u001b[2K\r\n\u001b[1;31mmini-swe-agent\u001b[0m\u001b[31m (step \u001b[0m\u001b[1;31m17\u001b[0m\u001b[31m, \u001b[0m\u001b[1;31m$0.00\u001b[0m\u001b[31m):\u001b[0m\r\n\u001b[32m⠋\u001b[0m Waiting for the LM to respond..."]
[264.727577, "o", "\r\u001b[2KI’ve confirmed the adapter contains LoRA weights for all 12 layers plus the full 20-class classifier head. I’ll now create the required artifacts and run \r\ninference using only the argmax of output logits.\r\n\r\n```\r\ncat > /app/setup_language_detection.py <<'PY'\r\nimport json\r\nimport os\r\n\r\nimport torch\r\nfrom peft import PeftConfig, PeftModel\r\nfrom transformers import AutoModelForSequenceClassification, AutoTokenizer\r\n\r\nBASE_DIR = \"/app/downloads/base\"\r\nADAPTER_DIR = \"/app/downloads/adapter\"\r\nCONFIGURED_DIR = \"/app/model_cache/xlm-roberta-base\"\r\nMERGED_DIR = \"/app/merged_model\"\r\nRESULTS_PATH = \"/app/detection_results.json\"\r\nNUM_LANGUAGES = 20\r\n\r\nTEST_SAMPLES = [\r\n    \"Bonjour, comment allez-vous aujourd'hui?\",\r\n    \"Hola, ¿cómo estás hoy?\",\r\n    \"Guten Tag, wie geht es Ihnen?\",\r\n    \"Ciao, come stai oggi?\",\r\n    \"Olá, como você está?\",\r\n    \"Привет, как дела?\",\r\n    \"こんにちは、お元気ですか？\",\r\n    \"你好，你好吗？\",\r\n    \"مرحبا، كيف حالك؟\",\r\n    \"Hell"]
[264.727589, "o", "o, how are you?\",\r\n]\r\n\r\nos.makedirs(CONFIGURED_DIR, exist_ok=True)\r\nos.makedirs(MERGED_DIR, exist_ok=True)\r\n\r\n# 1. Load the downloaded base model/tokenizer and configure a classification\r\n# head with all 20 language classes.\r\nprint(\"Loading base model and tokenizer...\", flush=True)\r\ntokenizer = AutoTokenizer.from_pretrained(BASE_DIR)\r\nbase_model = AutoModelForSequenceClassification.from_pretrained(\r\n    BASE_DIR,\r\n    num_labels=NUM_LANGUAGES,\r\n    ignore_mismatched_sizes=True,\r\n)\r\n\r\n# 4. Save the configured base model and tokenizer.\r\nprint(f\"Saving configured base model to {CONFIGURED_DIR}...\", flush=True)\r\nbase_model.save_pretrained(CONFIGURED_DIR)\r\ntokenizer.save_pretrained(CONFIGURED_DIR)\r\n\r\n# 5. Apply the LoRA adapter. PeftModel loads the adapter's classifier head\r\n# (`modules_to_save=[\"classifier\"]`) on top of the 20-class base.\r\nprint(\"Applying LoRA adapter...\", flush=True)\r\npeft_config = PeftConfig.from_pretrained(ADAPTER_DIR)\r\npeft_model = PeftModel.from_pretrained(base_model, ADAPTER_DIR)\r\npeft_mode"]
[264.727594, "o", "l.eval()\r\n\r\n# 6. Merge LoRA weights into the base model and save the standalone model.\r\nprint(f\"Merging adapter and saving model to {MERGED_DIR}...\", flush=True)\r\nmerged_model = peft_model.merge_and_unload()\r\nmerged_model.eval()\r\nmerged_model.save_pretrained(MERGED_DIR, safe_serialization=True)\r\ntokenizer.save_pretrained(MERGED_DIR)\r\n\r\n# Confirm the merged checkpoint is usable as a plain transformers model.\r\nprint(\"Reloading merged model for inference...\", flush=True)\r\ninference_model = AutoModelForSequenceClassification.from_pretrained(MERGED_DIR)\r\ninference_model.eval()\r\nassert inference_model.config.num_labels == NUM_LANGUAGES, inference_model.config.num_labels\r\n\r\n# 7. Run language detection. The predicted class is strictly the argmax of\r\n# the logits; no label IDs are inferred or hardcoded.\r\nresults = []\r\nwith torch.no_grad():\r\n    for text in TEST_SAMPLES:\r\n        inputs = tokenizer(\r\n            text,\r\n            return_tensors=\"pt\",\r\n            truncation=True,\r\n            max_length=512,\r\n        "]
[264.727597, "o", ")\r\n        logits = inference_model(**inputs).logits\r\n        probabilities = torch.softmax(logits, dim=-1)\r\n        confidence, predicted_class_id = torch.max(probabilities, dim=-1)\r\n        results.append(\r\n            {\r\n                \"text\": text,\r\n                \"predicted_class_id\": int(predicted_class_id.item()),\r\n                \"confidence\": float(confidence.item()),\r\n            }\r\n        )\r\n\r\nwith open(RESULTS_PATH, \"w\", encoding=\"utf-8\") as f:\r\n    json.dump(results, f, ensure_ascii=False, indent=2)\r\n\r\nprint(json.dumps(results, ensure_ascii=False, indent=2))\r\nprint(f\"Wrote {RESULTS_PATH}\")\r\nPY\r\ncd /app && python /app/setup_language_detection.py 2>&1 | tee /app/setup.log; test ${PIPESTATUS[0]} -eq 0\r\n```\r\n\u001b[32m⠋\u001b[0m Waiting for the LM to respond..."]
