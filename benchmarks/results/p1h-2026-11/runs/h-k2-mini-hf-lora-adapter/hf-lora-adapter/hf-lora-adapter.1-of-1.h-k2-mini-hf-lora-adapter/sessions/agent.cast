[279.682805, "o", "fidence\": 0.9649397134780884\r\n  },\r\n  {\r\n    \"text\": \"你好，你好吗？\",\r\n    \"predicted_class_id\": 19,\r\n    \"confidence\": 0.935988187789917\r\n  },\r\n  {\r\n    \"text\": \"مرحبا، كيف حالك؟\",\r\n    \"predicted_class_id\": 0,\r\n    \"confidence\": 0.9880263805389404\r\n  },\r\n  {\r\n    \"text\": \"Hello, how are you?\",\r\n    \"predicted_class_id\": 4,\r\n    \"confidence\": 0.9737093448638916\r\n  }\r\n]\r\nWrote /app/detection_results.json\r\n/bin/sh: 95: Bad substitution\r\n\r\n"]
