[76.502595, "o", "\r\u001b[2K```\r\nset -e\r\nprintf '%s\\n' '--- Directory metadata ---'\r\nstat -c 'path=%n mode=%a (%A) owner=%U group=%G' /srv/shared\r\nprintf '%s\\n' '--- ACL review ---'\r\ngetfacl -p /srv/shared\r\nprintf '%s\\n' '--- Contents check (must be empty) ---'\r\nfind /srv/shared -mindepth 1 -print\r\nprintf '%s\\n' 'ACL setup verified.'\r\n```\r\n\u001b[32m⠦\u001b[0m Waiting for the LM to respond..."]
[76.502708, "o", "\r\u001b[2K\u001b[32m⠦\u001b[0m Waiting for the LM to respond...\r\n\u001b[?25h\r\u001b[1A\u001b[2K"]
