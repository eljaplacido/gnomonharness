for it in [100,150,200]:
    o=f'<option solver="PGS" iterations="{it}" tolerance="1e-10"/>'
    open('/tmp/cand.xml','w').write(mk(o))
    m=mujoco.MjModel.from_xml_path('/tmp/cand.xml')
    diffs=[np.max(np.abs(sim(m,s)-sim(mref,s))) for s in range(60)]
    ts=timed(m,10)
    print(f'it={it} maxdiff={max(diffs):.3e} mean={np.mean(diffs):.3e} pctg={ts.mean()/timed(mref,10).mean():.3f}')
