import mujoco, numpy as np, time, sys

REF='model_ref.xml'
mref=mujoco.MjModel.from_xml_path(REF)
FP=mujoco.mjtState.mjSTATE_FULLPHYSICS

def sim(model, seed, t=2.0):
    d=mujoco.MjData(model)
    n=int(t/model.opt.timestep)
    rng=np.random.default_rng(seed)
    d.qpos += rng.normal(0,0.01,size=d.qpos.shape)
    mujoco.mj_forward(model,d)
    for _ in range(n):
        mujoco.mj_step(model,d)
    s=np.zeros(mujoco.mj_stateSize(model,FP))
    mujoco.mj_getState(model,d,s,FP)
    return s

def timed(model,n=10):
    ts=[]
    for i in range(n):
        t0=time.perf_counter(); sim(model,1000+i); ts.append(time.perf_counter()-t0)
    return np.array(ts)

def evaluate(xml, label, seeds=range(5), ntime=10):
    open('/tmp/cand.xml','w').write(xml)
    m=mujoco.MjModel.from_xml_path('/tmp/cand.xml')
    diffs=[]; bad=False
    for s in seeds:
        a=sim(m,s); b=sim(mref,s)
        if not np.all(np.isfinite(a)): bad=True
        diffs.append(np.max(np.abs(a-b)))
    ts=timed(m,ntime); tr=timed(mref,ntime)
    print(f'{label:40s} maxdiff={max(diffs):.3e} pctg={ts.mean()/tr.mean():.3f} t={ts.mean():.4f} bad={bad}')
    return m

if __name__=='__main__':
    print('ref time', timed(mref,10).mean())
