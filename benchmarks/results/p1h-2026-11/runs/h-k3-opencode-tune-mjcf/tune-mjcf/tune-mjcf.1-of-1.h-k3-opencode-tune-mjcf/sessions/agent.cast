[225.077898, "o", "\u001b[0m$ \u001b[0mcd /app && python - <<'EOF'\r\nimport mujoco,numpy as np,time\r\nm=mujoco.MjModel.from_xml_path('model_ref.xml')\r\nd=mujoco.MjData(m)\r\nrng=np.random.default_rng(0); d.qpos+=rng.normal(0,0.01,size=d.qpos.shape); mujoco.mj_forward(m,d)\r\ndef bench(fn,n=5000):\r\n    t0=time.perf_counter()\r\n    for _ in range(n): fn(m,d)\r\n    return (time.perf_counter()-t0)/n*1e6\r\nprint('fwdPosition us',bench(mujoco.mj_fwdPosition))\r\nprint('fwdVelocity us',bench(mujoco.mj_fwdVelocity))\r\nprint('fwdActuation us',bench(mujoco.mj_fwdActuation))\r\nprint('fwdAcceleration us',bench(mujoco.mj_fwdAcceleration))\r\nprint('fwdConstraint us',bench(mujoco.mj_fwdConstraint))\r\nprint('step us',bench(mujoco.mj_step,2000))\r\nprint('forward us',bench(mujoco.mj_forward,2000))\r\nprint('step1 us',bench(mujoco.mj_step1,2000))\r\nprint('step2 us',bench(mujoco.mj_step2,2000))\r\nEOF\r\nfwdPosition us 56.33622080204077\r\nfwdVelocity us 12.572421797085553\r\nfwdActuation us 0.39628460071980953\r\nfwdAcceleration us 4.3458069965709\r\nfwdConstraint us 160.94777980470099\r\n"]
[225.077948, "o", "step us 275.36538999993354\r\nforward us 231.68910350068472\r\nstep1 us 69.07942949328572\r\nstep2 us 206.67749950371217\r\n"]
