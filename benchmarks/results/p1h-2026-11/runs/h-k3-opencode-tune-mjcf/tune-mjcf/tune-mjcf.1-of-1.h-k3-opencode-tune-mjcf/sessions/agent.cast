[215.16818, "o", "\u001b[0m$ \u001b[0mcd /app && python - <<'EOF'\r\nexec(open('/tmp/tune.py').read().split(\"if __name__\")[0])\r\nimport mujoco,numpy as np\r\nd=mujoco.MjData(mref); mujoco.mj_forward(mref,d)\r\nprint('ncon init',d.ncon)\r\nmx=0\r\nrng=np.random.default_rng(0); d.qpos += rng.normal(0,0.01,size=d.qpos.shape); mujoco.mj_forward(mref,d)\r\nfor i in range(1000):\r\n    mujoco.mj_step(mref,d)\r\n    mx=max(mx,d.ncon)\r\nprint('max ncon',mx,'final ncon',d.ncon)\r\nEOF\r\nncon init 0\r\nmax ncon 0 final ncon 0\r\n"]
