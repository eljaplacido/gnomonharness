[269.336913, "o", "\u001b[0m$ \u001b[0mcd /app && python - <<'EOF'\r\nexec(open('/tmp/tune.py').read().split(\"if __name__\")[0])\r\nbase=open('model_ref.xml').read()\r\ndef mk(opts):\r\n    return base.replace('<compiler autolimits=\"true\"/>', opts+'<compiler autolimits=\"true\"/>')\r\ncands={\r\n 'PGS': '<option solver=\"PGS\"/>',\r\n 'PGS iters=50': '<option solver=\"PGS\" iterations=\"50\"/>',\r\n 'CG iters=20': '<option solver=\"CG\" iterations=\"20\"/>',\r\n 'CG tol1e-6': '<option solver=\"CG\" tolerance=\"1e-6\"/>',\r\n 'CG tol1e-4': '<option solver=\"CG\" tolerance=\"1e-4\"/>',\r\n 'nocol': '<option><flag contact=\"disable\"/></option>',\r\n 'nocol+jac': '<option jacobian=\"sparse\"><flag contact=\"disable\"/></option>',\r\n}\r\nfor k,o in cands.items():\r\n    try: evaluate(mk(o),k,seeds=range(4),ntime=6)\r\n    except Exception as e: print(k,'ERR',str(e)[:200])\r\nEOF\r\nPGS                                      maxdiff=1.160e-06 pctg=0.498 t=0.1361 bad=False\r\nPGS iters=50                             maxdiff=1.160e-06 pctg=0.500 t=0.1360 bad=False\r\nCG iters=20                              max"]
[269.336981, "o", "diff=1.617e-06 pctg=0.812 t=0.2207 bad=False\r\nCG tol1e-6                               maxdiff=4.362e-04 pctg=0.763 t=0.2112 bad=False\r\nCG tol1e-4                               maxdiff=6.661e-03 pctg=0.698 t=0.1930 bad=False\r\nnocol                                    maxdiff=0.000e+00 pctg=0.990 t=0.2742 bad=False\r\nnocol+jac                                maxdiff=0.000e+00 pctg=0.985 t=0.2728 bad=False\r\n"]
[270.290357, "o", "> build · deepseek-v4.1-flash\r\n"]
[344.277158, "o", "\u001b[0m$ \u001b[0mcd /app && python - <<'EOF'\r\nexec(open('/tmp/tune.py').read().split(\"if __name__\")[0])\r\nbase=open('model_ref.xml').read()\r\ndef mk(o): return base.replace('<compiler autolimits=\"true\"/>', o+'<compiler autolimits=\"true\"/>')\r\nfor it in [100,50,30,20,10,5]:\r\n    xml=mk(f'<option solver=\"PGS\" iterations=\"{it}\"/>')\r\n    open('/tmp/cand.xml','w').write(xml)\r\n    m=mujoco.MjModel.from_xml_path('/tmp/cand.xml')\r\n    diffs=[]\r\n    for s in range(20):\r\n        a=sim(m,s); b=sim(mref,s)\r\n        diffs.append(np.max(np.abs(a-b)))\r\n    ts=timed(m,8); tr=timed(mref,8)\r\n    print(f'PGS it={it:3d} maxdiff={max(diffs):.3e} mean={np.mean(diffs):.3e} pctg={ts.mean()/tr.mean():.3f}')\r\nEOF\r\nPGS it=100 maxdiff=3.718e-06 mean=7.560e-07 pctg=0.485\r\nPGS it= 50 maxdiff=3.718e-06 mean=7.560e-07 pctg=0.493\r\nPGS it= 30 maxdiff=3.718e-06 mean=7.560e-07 pctg=0.503\r\nPGS it= 20 maxdiff=3.718e-06 mean=7.560e-07 pctg=0.495\r\nPGS it= 10 maxdiff=9.471e-06 mean=1.570e-06 pctg=0.498\r\nPGS it=  5 maxdiff=2.693e-04 mean=5.807e-05 pctg=0.503\r\n"]
[345.414501, "o", "> build · deepseek-v4.1-flash\r\n"]
[439.565052, "o", "\u001b[0m$ \u001b[0mcd /app && python - <<'EOF'\r\nexec(open('/tmp/tune.py').read().split(\"if __name__\")[0])\r\nbase=open('model_ref.xml').read()\r\ndef mk(o): return base.replace('<compiler autolimits=\"true\"/>', o+'<compiler autolimits=\"true\"/>')\r\ncands={\r\n 'PGS tol1e-10 it200':'<option solver=\"PGS\" iterations=\"200\" tolerance=\"1e-10\"/>',\r\n 'PGS tol1e-8 it50':'<option solver=\"PGS\" iterations=\"50\" tolerance=\"1e-8\"/>',\r\n 'PGS lsiter=10':'<option solver=\"PGS\" iterations=\"100\" ls_iterations=\"10\"/>',\r\n 'CG+PGS? no':'<option solver=\"PGS\"/>',\r\n}\r\nmref_t=timed(mref,5).mean()\r\nfor k,o in cands.items():\r\n    xml=mk(o); open('/tmp/cand.xml','w').write(xml)\r\n    m=mujoco.MjModel.from_xml_path('/tmp/cand.xml')\r\n    diffs=[np.max(np.abs(sim(m,s)-sim(mref,s))) for s in range(50)]\r\n    ts=timed(m,8)\r\n    print(f'{k:28s} maxdiff={max(diffs):.3e} pctg={ts.mean()/mref_t:.3f}')\r\nEOF\r\nPGS tol1e-10 it200           maxdiff=3.899e-07 pctg=0.494\r\nPGS tol1e-8 it50             maxdiff=3.718e-06 pctg=0.491\r\nPGS lsiter=10                maxdiff=3.718e-0"]
[439.565087, "o", "6 pctg=0.490\r\nCG+PGS? no                   maxdiff=3.718e-06 pctg=0.491\r\n"]
