[15.448824, "o", "\u001b[0m$ \u001b[0mcd /app && python -c \"import mujoco; print(mujoco.__version__)\" && ls -la\r\n3.3.5\r\ntotal 16\r\ndrwxr-xr-x 1 root root 4096 Oct 31 15:22 .\r\ndrwxr-xr-x 1 root root 4096 Nov  1 08:24 ..\r\n-rw-rw-r-- 1 root root 3112 Oct 31 09:48 eval.py\r\n-rw-rw-r-- 1 root root 1254 Oct 31 09:48 model_ref.xml\r\n"]
