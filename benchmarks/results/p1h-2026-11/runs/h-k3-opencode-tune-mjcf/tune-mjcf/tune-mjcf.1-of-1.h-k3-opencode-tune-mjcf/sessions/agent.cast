[212.898938, "o", "\u001b[0m$ \u001b[0mcd /app && python - <<'EOF'\r\nimport mujoco\r\nprint([x for x in dir(mujoco) if 'timer' in x.lower() or 'profile' in x.lower()])\r\nprint([x for x in dir(mujoco) if x.startswith('mj_') and ('step' in x or 'forward' in x or 'fwd' in x)])\r\nprint(mujoco.mjTIMER_ADDRESS if hasattr(mujoco,'mjTIMER_ADDRESS') else 'no timer addr')\r\nEOF\r\n['MjTimerStat', 'mjTIMERSTRING', 'mjtTimer']\r\n['mj_forward', 'mj_forwardSkip', 'mj_fwdAcceleration', 'mj_fwdActuation', 'mj_fwdConstraint', 'mj_fwdPosition', 'mj_fwdVelocity', 'mj_step', 'mj_step1', 'mj_step2']\r\nno timer addr\r\n"]
