[95.738296, "o", "<returncode>\r\n0\r\n<output>\r\nTriples: 289\r\nRows: 3\r\n(rdflib.term.Literal('Aristotle Tympas'), rdflib.term.Literal('GR'))\r\n(rdflib.term.Literal('Orfeas Menis'), rdflib.term.Literal('GR, US'))\r\n(rdflib.term.Literal('Pepe Attanasio'), rdflib.term.Literal('PT, GR'))\r\n\r\n"]
