#include <stdio.h>
#include <string.h>
typedef struct { char s[64]; } key_t;
shared [1] key_t *gk;
shared [1] int *gn;
shared [1] upc_lock_t *gl;
shared int gsum;
int main(void){
  int N = 16;
  gk = (shared [1] key_t *) upc_all_alloc(N, sizeof(key_t));
  gn = (shared [1] int *) upc_all_alloc(N, sizeof(int));
  gl = (shared [1] upc_lock_t *) upc_all_alloc(THREADS, sizeof(upc_lock_t));
  upc_lock_init(&gl[MYTHREAD]);
  upc_barrier;
  int i;
  for (i=MYTHREAD;i<N;i+=THREADS){
    key_t t; memset(&t,0,sizeof t); sprintf(t.s,"node-%d",i);
    upc_memput(&gk[i], &t, sizeof(key_t));
    gn[i] = i*7;
  }
  upc_barrier;
  key_t r; int bad=0;
  for(i=0;i<N;i++){
    upc_memget(&r,&gk[i],sizeof(key_t));
    char exp[64]; sprintf(exp,"node-%d",i);
    if(strcmp(r.s,exp)) bad++;
    if(gn[i]!=i*7) bad++;
  }
  /* lock test: increments under lock */
  if(MYTHREAD==0) gsum=0;
  upc_barrier;
  for(i=0;i<100;i++){ upc_lock(&gl[i%THREADS]); int v=gsum; gsum=v+1; upc_unlock(&gl[i%THREADS]); }
  upc_barrier;
  printf("t%d bad=%d sum=%d (expect 100*%d)\n",(int)MYTHREAD,bad,(int)gsum,(int)THREADS);
  upc_barrier;
  if(MYTHREAD==0) printf("DONE\n");
  return 0;
}
EOF
