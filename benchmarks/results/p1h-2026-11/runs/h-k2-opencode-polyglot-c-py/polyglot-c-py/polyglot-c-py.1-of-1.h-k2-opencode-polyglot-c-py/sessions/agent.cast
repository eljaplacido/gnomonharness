[101.442597, "o", "\u001b[0m$ \u001b[0mgcc -std=c11 -Wall -Wextra -pedantic /app/polyglot/main.py.c -o /app/polyglot/cmain && for n in 0 1 2 3 4 5 10 20 50 100 300 1000; do p=$(python3 /app/polyglot/main.py.c \"$n\"); c=$(/app/polyglot/cmain \"$n\"); if [ \"$p\" != \"$c\" ]; then echo \"MISMATCH $n: py=$p c=$c\"; else echo \"$n ok ${#p} digits\"; fi; done\r\n/app/polyglot/main.py.c:2:3: warning: missing terminating ' character\r\n    2 | '''\r\n      |   ^\r\n/app/polyglot/main.py.c:121:3: warning: missing terminating ' character\r\n  121 | '''\r\n      |   ^\r\n0 ok 1 digits\r\n1 ok 1 digits\r\n2 ok 1 digits\r\n3 ok 1 digits\r\n4 ok 1 digits\r\n5 ok 1 digits\r\n10 ok 2 digits\r\n20 ok 4 digits\r\n50 ok 11 digits\r\n100 ok 21 digits\r\n300 ok 63 digits\r\n1000 ok 209 digits\r\n"]
