[214.01023, "o", "\u001b[0m$ \u001b[0mfor n in 1234 10000 50000; do p=$(python3 /app/polyglot/main.py.c \"$n\"); c=$(/app/polyglot/cmain \"$n\"); if [ \"$p\" != \"$c\" ]; then echo \"MISMATCH $n\"; else echo \"$n ok ${#p} digits\"; fi; done\r\n1234 ok 258 digits\r\n10000 ok 2090 digits\r\nTraceback (most recent call last):\r\n  File \"/app/polyglot/main.py.c\", line 145, in <module>\r\n    main()\r\n  File \"/app/polyglot/main.py.c\", line 141, in main\r\n    print(fib(int(text)))\r\nValueError: Exceeds the limit (4300 digits) for integer string conversion; use sys.set_int_max_str_digits() to increase the limit\r\nMISMATCH 50000\r\n"]
