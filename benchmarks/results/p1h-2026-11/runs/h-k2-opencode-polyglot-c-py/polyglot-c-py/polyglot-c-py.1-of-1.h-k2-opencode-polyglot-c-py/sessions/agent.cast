[217.74164, "o", "\u001b[0m← \u001b[0mEdit polyglot/main.py.c\r\nIndex: polyglot/main.py.c\r\n===================================================================\r\n--- polyglot/main.py.c\r\n+++ polyglot/main.py.c\r\n@@ -123,9 +123,12 @@\r\n #endif */\r\n \r\n import sys\r\n \r\n+if hasattr(sys, \"set_int_max_str_digits\"):\r\n+    sys.set_int_max_str_digits(0)\r\n \r\n+\r\n def fib(n):\r\n     a, b = 0, 1\r\n     for _ in range(n):\r\n         a, b = b, a + b\r\n\r\n"]
