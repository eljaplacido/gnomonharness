[233.732046, "o", "\u001b[0m← \u001b[0mEdit polyglot/main.py.c\r\nIndex: polyglot/main.py.c\r\n===================================================================\r\n--- polyglot/main.py.c\r\n+++ polyglot/main.py.c\r\n@@ -143,9 +143,9 @@\r\n def main():\r\n     if len(sys.argv) != 2:\r\n         raise SystemExit(1)\r\n     text = sys.argv[1]\r\n-    if not text.isdigit():\r\n+    if not text.isascii() or not text.isdigit():\r\n         raise SystemExit(1)\r\n     print(fib(int(text)))\r\n \r\n \r\n\r\n"]
