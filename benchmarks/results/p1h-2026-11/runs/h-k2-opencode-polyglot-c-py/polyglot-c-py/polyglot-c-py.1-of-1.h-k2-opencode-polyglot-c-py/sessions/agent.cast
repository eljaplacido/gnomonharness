[236.577811, "o", "\u001b[0m$ \u001b[0mgcc -std=c11 -Wall -Wextra -pedantic /app/polyglot/main.py.c -o /app/polyglot/cmain && for n in 0 1 2 3 5 10 100 1000 50000; do p=$(python3 /app/polyglot/main.py.c \"$n\"); c=$(/app/polyglot/cmain \"$n\"); if [ \"$p\" != \"$c\" ]; then echo \"MISMATCH $n\"; else echo \"$n ok ${#p} digits\"; fi; done\r\nfor arg in \"\" \"-1\" \"+1\" \" 1\" \"1x\" \"١\"; do python3 /app/polyglot/main.py.c \"$arg\" >/dev/null 2>&1; py=$?; /app/polyglot/cmain \"$arg\" >/dev/null 2>&1; c=$?; echo \"arg=[$arg] py=$py c=$c\"; done\r\n0 ok 1 digits\r\n1 ok 1 digits\r\n2 ok 1 digits\r\n3 ok 1 digits\r\n5 ok 1 digits\r\n10 ok 2 digits\r\n100 ok 21 digits\r\n1000 ok 209 digits\r\n50000 ok 10450 digits\r\narg=[] py=1 c=1\r\narg=[-1] py=1 c=1\r\narg=[+1] py=1 c=1\r\narg=[ 1] py=1 c=1\r\narg=[1x] py=1 c=1\r\narg=[١] py=1 c=1\r\n"]
