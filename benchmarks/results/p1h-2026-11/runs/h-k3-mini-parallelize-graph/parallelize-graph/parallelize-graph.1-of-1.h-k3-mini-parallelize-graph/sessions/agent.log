cat > /app/serial.c <<'EOF'
#define _GNU_SOURCE
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>
#include <ctype.h>

typedef struct {
    char *kmer;
    char left;
    char right;
    int next;       /* next node in the same hash bucket */
} KmerNode;

static int g_k = 0;
static int g_n = 0;
static KmerNode *g_nodes = NULL;

static uint64_t hash_bytes(const char *s, int len)
{
    uint64_t h = 1469598103934665603ULL;
    int i;
    for (i = 0; i < len; ++i) {
        h ^= (unsigned char)s[i];
        h *= 1099511628211ULL;
    }
    return h;
}

static int is_prime(int x)
{
    int d;
    if (x < 2) return 0;
    if ((x & 1) == 0) return x == 2;
    for (d = 3; (long long)d * d <= x; d += 2)
        if (x % d == 0) return 0;
    return 1;
}

static int next_prime(int x)
{
    if (x <= 2) return 2;
    if ((x & 1) == 0) ++x;
    while (!is_prime(x)) x += 2;
    return x;
}

static int lookup_kmer(const char *key, int *buckets, int hsize)
{
    int b = (int)(hash_bytes(key, g_k) % (uint64_t)hsize);
    int i = buckets[b];
    while (i != -1) {
        if (strcmp(g_nodes[i].kmer, key) == 0) return i;
        i = g_nodes[i].next;
    }
    return -1;
}

/* Return the node reached by following the stored right extension. */
static int successor_of(int idx, int *buckets, int hsize)
{
    char *key;
    int nxt;
    if (g_nodes[idx].right == 'F') return -1;
    key = (char *)malloc((size_t)g_k + 1);
    if (!key) return -1;
    memcpy(key, g_nodes[idx].kmer + 1, (size_t)g_k - 1);
    key[g_k - 1] = g_nodes[idx].right;
    key[g_k] = '\0';
    nxt = lookup_kmer(key, buckets, hsize);
    free(key);
    return nxt;
}

static int predecessor_of(int idx, int *buckets, int hsize)
{
    char *key;
    int prv;
    if (g_nodes[idx].left == 'F') return -1;
    key = (char *)malloc((size_t)g_k + 1);
    if (!key) return -1;
    key[0] = g_nodes[idx].left;
    memcpy(key + 1, g_nodes[idx].kmer, (size_t)g_k - 1);
    key[g_k] = '\0';
    prv = lookup_kmer(key, buckets, hsize);
    free(key);
    return prv;
}

static void emit_path(FILE *out, int start, int is_cycle, int *buckets, int hsize,
                      unsigned char *visited, char *buf)
{
    int cur = start;
    size_t pos = 0;

    /* If this is a maximal path whose left neighbour is unknown, the stored
       left extension is still a known base and belongs in the contig. */
    if (!is_cycle && g_nodes[start].left != 'F')
        buf[pos++] = g_nodes[start].left;
    memcpy(buf + pos, g_nodes[start].kmer, (size_t)g_k);
    pos += (size_t)g_k;

    for (;;) {
        int nxt;
        visited[cur] = 1;
        if (g_nodes[cur].right == 'F') break;

        nxt = successor_of(cur, buckets, hsize);
        if (nxt < 0) {
            /* The next k-mer is not in the data (e.g. the input was cut at
               the end of a contig), but the extension base itself is known. */
            buf[pos++] = g_nodes[cur].right;
            break;
        }
        if (is_cycle && nxt == start) break;
        if (visited[nxt]) break;      /* safety for malformed/non-unique input */
        buf[pos++] = g_nodes[cur].right;
        cur = nxt;
    }
    buf[pos] = '\0';
    if (pos > 0) {
        fputs(buf, out);
        fputc('\n', out);
    }
}

int main(int argc, char **argv)
{
    const char *input = (argc > 1) ? argv[1] : "test";
    FILE *in = NULL, *out = NULL;
    char *line = NULL;
    size_t linecap = 0;
    ssize_t linelen;
    int cap = 0;
    int i, hsize, *buckets = NULL;
    unsigned char *visited = NULL;
    char *buf = NULL;

    in = fopen(input, "r");
    if (!in) {
        perror(input);
        return 1;
    }

    while ((linelen = getline(&line, &linecap, in)) >= 0) {
        char *tab, *km;
        if (linelen == 0) continue;
        tab = strchr(line, '\t');
        if (!tab) continue;
        *tab = '\0';
        km = line;
        if (g_k == 0) g_k = (int)strlen(km);
        if ((int)strlen(km) != g_k || g_k <= 0) {
            fprintf(stderr, "Inconsistent k-mer length in input\n");
            return 1;
        }
        if (g_n == cap) {
            int newcap = cap ? cap * 2 : 1024;
            KmerNode *tmp = (KmerNode *)realloc(g_nodes, (size_t)newcap * sizeof(*g_nodes));
            if (!tmp) { perror("realloc"); return 1; }
            g_nodes = tmp;
            cap = newcap;
        }
        g_nodes[g_n].kmer = strdup(km);
        if (!g_nodes[g_n].kmer) { perror("strdup"); return 1; }
        g_nodes[g_n].left = tab[1] ? tab[1] : 'F';
        g_nodes[g_n].right = tab[2] ? tab[2] : 'F';
        g_nodes[g_n].next = -1;
        ++g_n;
    }
    free(line);
    fclose(in);

    if (g_n == 0) {
        out = fopen("/app/serial.out", "w");
        if (out) fclose(out);
        return 0;
    }

    hsize = next_prime(2 * g_n + 1);
    buckets = (int *)malloc((size_t)hsize * sizeof(int));
    visited = (unsigned char *)calloc((size_t)g_n, 1);
    buf = (char *)malloc((size_t)g_n + (size_t)g_k + 4);
    if (!buckets || !visited || !buf) { perror("malloc"); return 1; }
    for (i = 0; i < hsize; ++i) buckets[i] = -1;

    /* Build separate-chaining hash table. */
    for (i = 0; i < g_n; ++i) {
        int b = (int)(hash_bytes(g_nodes[i].kmer, g_k) % (uint64_t)hsize);
        g_nodes[i].next = buckets[b];
        buckets[b] = i;
    }

    out = fopen("/app/serial.out", "w");
    if (!out) { perror("/app/serial.out"); return 1; }

    /* Maximal paths start where no predecessor exists. */
    for (i = 0; i < g_n; ++i) {
        if (!visited[i] && predecessor_of(i, buckets, hsize) < 0)
            emit_path(out, i, 0, buckets, hsize, visited, buf);
    }

    /* Any remaining component is a cycle.  Break each cycle at its
       smallest array index so output is deterministic. */
    for (i = 0; i < g_n; ++i) {
        if (!visited[i])
            emit_path(out, i, 1, buckets, hsize, visited, buf);
    }

    fclose(out);
    for (i = 0; i < g_n; ++i) free(g_nodes[i].kmer);
    free(g_nodes);
    free(buckets);
    free(visited);
    free(buf);
    return 0;
}
EOF
