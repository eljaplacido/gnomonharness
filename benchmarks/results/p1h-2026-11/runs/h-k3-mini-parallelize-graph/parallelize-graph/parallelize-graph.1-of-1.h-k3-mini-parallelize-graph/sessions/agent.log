comparison.

```
cd /app
set -u
./serial test || exit 1
sort /app/serial.out > /tmp/serial.sorted
echo "serial contigs: $(wc -l < /app/serial.out)"
for t in 1 2 3 4 5 8; do
  ./verify.sh "$t" >/tmp/final_verify_$t.log 2>&1
  rc=$?
  echo "threads=$t rc=$rc $(tail -1 /tmp/final_verify_$t.log)"
  [ $rc -eq 0 ] || { cat /tmp/final_verify_$t.log; exit 1; }
done
echo '--- two-thread stress'
for i in $(seq 1 15); do
  rm -f /app/pgen_*.out
  upcrun -n 2 -shared-heap 256MB ./pgen test >/tmp/stress2.log 2>&1 || { echo "stress failed at $i"; cat /tmp/stress2.log; exit 1; }
done
cat /app/pgen_*.out | sort > /tmp/pgen_stress.sorted
diff -u /tmp/serial.sorted /tmp/pgen_stress.sorted >/dev/null || { echo stress_mismatch; exit 1; }
echo 'stress: 15/15 passed'
echo '--- validation'
if grep -n -v '^[ACGT][ACGT]*$' /app/serial.out /app/pgen_*.out; then echo 'invalid bases'; exit 1; fi
echo 'all outputs contain only A/C/G/T'
echo '--- final outputs'
ls -l /app/serial.out /app/pgen_*.out
wc -l /app/serial.out /app/pgen_*.out
```
