agreement across several thread counts.

```
cd /app
python3 - <<'PY'
import random, os
random.seed(7)
os.makedirs('/tmp/rnd', exist_ok=True)
for case in range(8):
    k=random.choice([5,9,13,19,23])
    paths=[]
    used=set()
    for p in range(random.randint(1,5)):
        while True:
            L=random.randint(k+5,300)
            s=''.join(random.choice('ACGT') for _ in range(L))
            ks=[s[i:i+k] for i in range(L-k+1)]
            if len(set(ks))==len(ks) and not (set(ks)&used): break
        used.update(ks)
        recs=[]
        for i,km in enumerate(ks):
            left='F' if i==0 else s[i-1]
            right='F' if i==len(ks)-1 else s[i+k]
            recs.append((km,left+right,s))
        paths.append((s,recs))
    recs=[r for s,rr in paths for r in rr]
    random.shuffle(recs)
    with open(f'/tmp/rnd/in{case}','w') as f:
        for km,e,_ in recs: f.write(km+'\t'+e+'\n')
    with open(f'/tmp/rnd/expect{case}','w') as f:
        for s,_ in paths: f.write(s+'\n')
print('generated')
PY
for t in 2 4 7; do
  echo "=== threads $t ==="
  for c in $(seq 0 7); do
    rm -f /app/pgen_*.out
    ./serial /tmp/rnd/in$c
    sort /app/serial.out > /tmp/rnd/s
    sort /tmp/rnd/expect$c > /tmp/rnd/e
    diff -u /tmp/rnd/e /tmp/rnd/s >/tmp/rnd/d1 || { echo "case $c serial-vs-expected mismatch"; head -20 /tmp/rnd/d1; exit 1; }
    upcrun -n $t -shared-heap 256MB ./pgen /tmp/rnd/in$c >/tmp/rnd/log 2>&1 || { echo "case $c pgen crash"; cat /tmp/rnd/log; exit 1; }
    cat /app/pgen_*.out | sort > /tmp/rnd/p
    diff -u /tmp/rnd/s /tmp/rnd/p >/tmp/rnd/d2 || { echo "case $c serial-vs-parallel mismatch"; cat /tmp/rnd/d2; exit 1; }
  done
  echo "all random cases passed"
done
