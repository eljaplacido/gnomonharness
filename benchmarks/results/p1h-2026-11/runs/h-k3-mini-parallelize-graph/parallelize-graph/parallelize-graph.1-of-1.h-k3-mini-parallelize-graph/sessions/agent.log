very short k-mers, comparing serial and UPC outputs.

```
cd /app
mkdir -p /tmp/edge
cat > /tmp/edge/cycle <<'EOF'
ACG     TT
CGT     AA
GTA     CC
TAC     GG
EOF
cat > /tmp/edge/single <<'EOF'
ACGT    FF
EOF
cat > /tmp/edge/truncated <<'EOF'
ACGT    FC
CGTA    GA
GTAC    TF
EOF
cat > /tmp/edge/k1 <<'EOF'
A       FC
C       GA
G       TF
T       FF
EOF
for f in cycle single truncated k1; do
  echo "===== $f ====="
  rm -f /app/pgen_*.out
  ./serial "/tmp/edge/$f"
  cp /app/serial.out "/tmp/edge/$f.serial"
  /usr/local/bin/upcrun -n 3 -shared-heap 64MB ./pgen "/tmp/edge/$f" >/tmp/edge/run.log 2>&1
  rc=$?
  echo "pgen_rc=$rc"
  cat /app/pgen_*.out | sort > "/tmp/edge/$f.pgen"
  sort "/tmp/edge/$f.serial" > "/tmp/edge/$f.serial.sorted"
  echo 'serial:'; cat "/tmp/edge/$f.serial"
  echo 'pgen combined:'; cat /app/pgen_*.out
  diff -u "/tmp/edge/$f.serial.sorted" "/tmp/edge/$f.pgen" && echo OK || echo MISMATCH
done
```
