d={k:e for k,e in rows}
nextmap={}
for k,e in rows:
    if e[1]!='F':
        nxt=k[1:]+e[1]
        if nxt in d: nextmap[k]=nxt
prev={b:a for a,b in nextmap.items()}
roots=[i for i,(k,e) in enumerate(rows) if k not in prev]
# path membership
for ri,s in enumerate(roots):
    ids=[]; cur=s
    while True:
        ids.append(next(i for i,(k,e) in enumerate(rows) if k==cur))
        if cur not in nextmap: break
        cur=nextmap[cur]
    print('path',ri+1,'line range',min(ids)+1,max(ids)+1,'count',len(ids),'start',rows[min(ids)][0],rows[min(ids)][1],'end',rows[max(ids)][0],rows[max(ids)][1])
