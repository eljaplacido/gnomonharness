cd /app
python3 - <<'PY'
from collections import defaultdict, Counter
rows=[]
with open('test') as f:
    for line in f:
        k,e=line.rstrip('\n').split('\t')
        rows.append((k,e[0],e[1]))
keys=set(k for k,l,r in rows)
print('n',len(rows),'unique',len(keys))
mindeg=Counter(); maxdeg=Counter()
missing=Counter()
edges=[]
for k,l,r in rows:
    if r!='F':
        nxt=k[1:]+r
        if nxt in keys:
            edges.append((k,nxt))
        else:
            missing['right']+=1
    if l!='F':
        prv=l+k[:-1]
        if prv not in keys:
            missing['left']+=1
print('missing',missing,'edges',len(edges))
out=Counter(a for a,b in edges); inn=Counter(b for a,b in edges)
print('outdegree distribution',Counter(out.values()))
print('indegree distribution',Counter(inn.values()))
# consistency: for each edge p->k, is k's left ext p[0]?
inconsistent=[]
for a,b in edges:
    expected=b[0] # left extension of b should be a[0]
    # find ext
    row=next(x for x in rows if x[0]==b)
    if row[1]!=expected:
        inconsistent.append((a,b,row[1],expected))
print('inconsistent left',len(inconsistent), inconsistent[:5])
# branches
print('branch out',[(k,v) for k,v in out.items() if v>1][:10])
print('branch in',[(k,v) for k,v in inn.items() if v>1][:10])
# components / path count
nextmap={a:b for a,b in edges}
prevmap={b:a for a,b in edges}
starts=[k for k,l,r in rows if k not in prevmap]
print('starts (no incoming)',len(starts))
ends=[k for k,l,r in rows if k not in nextmap]
print('ends (no outgoing)',len(ends))
# traverse starts; count lengths
seen=set(); paths=[]
for s in starts:
    p=[]; cur=s
    while cur not in seen:
        seen.add(cur); p.append(cur)
        if cur not in nextmap: break
        cur=nextmap[cur]
    paths.append(p)
unseen=keys-seen
print('paths from starts',len(paths),'lengths',Counter(map(len,paths)).most_common(20))
print('unseen',len(unseen))
# traverse unseen cycles
cyc=[]
while unseen:
    s=next(iter(unseen)); p=[]; cur=s
    while cur not in seen:
        seen.add(cur); p.append(cur)
        cur=nextmap[cur]
    cyc.append(p)
print('cycles',len(cyc),Counter(map(len,cyc)))
print('total bases paths',sum(len(p)+18 for p in paths))
# validate starts correspond left F
startlf=sum(1 for s in starts if next(l for k,l,r in rows if k==s)=='F')
print('starts with left F',startlf)
# A walk sample output
for p in paths[:3]:
    seq=p[0]+''.join(nextmap[x][-1] for x in p[:-1])
    print(len(p),len(seq),seq[:80], '...')
