```
cat > /app/Makefile <<'EOF'
# Build the serial reference implementation and the UPC parallel implementation.
CC      ?= gcc
CFLAGS  ?= -O2 -std=gnu99 -Wall -Wextra
UPC     ?= $(shell if [ -x /usr/local/opt/bin/upcc ]; then echo /usr/local/opt/bin/upcc; elif command -v upcc >/dev/null 2>&1; then echo upcc; elif command -v 
upc >/dev/null 2>&1; then echo upc; else echo /usr/local/opt/bin/upcc; fi)
UPCFLAGS ?= -network=smp -O
UPRUN   ?= upcrun
THREADS ?= 4

.PHONY: all clean verify

all: serial pgen

serial: serial.c
        $(CC) $(CFLAGS) -o $@ $<

pgen: pgen.upc
        $(UPC) $(UPCFLAGS) -o $@ $<

clean:
        rm -f serial pgen /app/serial.out /app/pgen_*.out

verify: all
        ./serial test
        $(UPRUN) -n $(THREADS) -shared-heap 256MB ./pgen test
        @cat /app/pgen_*.out | sort > /tmp/pgen_sorted.txt
        @sort /app/serial.out > /tmp/serial_sorted.txt
        @diff -u /tmp/serial_sorted.txt /tmp/pgen_sorted.txt && echo "Verification: parallel and serial contigs are identical"
EOF

cat > /app/verify.sh <<'EOF'
#!/bin/sh
set -eu
cd /app
./serial test
upcrun -n "${1:-4}" -shared-heap 256MB ./pgen test
cat /app/pgen_*.out | sort > /tmp/pgen_sorted.txt
sort /app/serial.out > /tmp/serial_sorted.txt
diff -u /tmp/serial_sorted.txt /tmp/pgen_sorted.txt
printf 'Verification passed with %s UPC threads\n' "${1:-4}"
EOF
chmod +x /app/verify.sh

cd /app
make clean
make
ls -l serial pgen Makefile verify.sh
echo '--- verify 4 threads'
./verify.sh 4
```
