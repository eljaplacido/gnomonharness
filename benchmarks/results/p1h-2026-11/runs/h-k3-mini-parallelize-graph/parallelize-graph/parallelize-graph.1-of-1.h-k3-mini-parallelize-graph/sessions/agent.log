rows=[]
for l in open('/tmp/edge/cycle'):
    k,e=l.rstrip('\n').split('\t'); rows.append((k,e[0],e[1]))
d={k:(l,r) for k,l,r in rows}; K=len(rows[0][0])
nextmap={}
for km,l,r in rows:
    if r!='F':
        nxt=km[1:]+r
        nextmap[km]=nxt if nxt in d else None
print(rows,nextmap)
roots=[k for k,l,r in rows if l=='F' or (l+k[:-1] not in d)]
print('roots',roots)
start=rows[0][0]; cur=start; seq=start
for step in range(10):
    nxt=nextmap.get(cur)
    print(step,cur,'right',d[cur][1],'next',nxt)
    if nxt is None: break
    if nxt==start: break
    seq += d[cur][1]
    cur=nxt
print('seq',seq)
# print predecessor result each
for k,l,r in rows:
    prev=l+k[:-1]
    print(k,'left',l,'prev',prev,prev in d)
