cat > /app/pgen.upc <<'EOF'
#define _GNU_SOURCE
#include <upc.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>
#include <unistd.h>
#include <glob.h>

/* Values computed by thread 0 and read by all threads after a barrier. */
shared int g_n;
shared int g_k;
shared int g_stride;

static uint64_t hash_bytes(const char *s, int len)
{
    uint64_t h = 1469598103934665603ULL;
    int i;
    for (i = 0; i < len; ++i) {
        h ^= (unsigned char)s[i];
        h *= 1099511628211ULL;
    }
    return h;
}

static uint64_t hash_shared_kmer(shared char *kmers, int stride, int idx, int k)
{
    uint64_t h = 1469598103934665603ULL;
    size_t base = (size_t)idx * (size_t)stride;
    int j;
    for (j = 0; j < k; ++j) {
        h ^= (unsigned char)kmers[base + (size_t)j];
        h *= 1099511628211ULL;
    }
    return h;
}

static int is_prime(int x)
{
    int d;
    if (x < 2) return 0;
    if ((x & 1) == 0) return x == 2;
    for (d = 3; (long long)d * d <= x; d += 2)
        if (x % d == 0) return 0;
    return 1;
}

static int next_prime(int x)
{
    if (x <= 2) return 2;
    if ((x & 1) == 0) ++x;
    while (!is_prime(x)) x += 2;
    return x;
}

static int lookup_kmer(shared char *kmers, int stride, int k,
                       shared int *buckets, int hsize,
                       shared int *nexts, const char *key)
{
    int b = (int)(hash_bytes(key, k) % (uint64_t)hsize);
    int idx = buckets[b];
    while (idx != -1) {
        size_t base = (size_t)idx * (size_t)stride;
        int j = 0;
        while (j < k && kmers[base + (size_t)j] == key[j]) ++j;
        if (j == k) return idx;
        idx = nexts[idx];
    }
    return -1;
}

static int successor_of(int idx, shared char *kmers, int stride, int k,
                        shared unsigned char *rights,
                        shared int *buckets, int hsize,
                        shared int *nexts, char *keybuf)
{
    int j;
    if (rights[idx] == 'F') return -1;
    for (j = 0; j < k - 1; ++j)
        keybuf[j] = kmers[(size_t)idx * (size_t)stride + (size_t)j + 1];
    keybuf[k - 1] = (char)rights[idx];
    keybuf[k] = '\0';
    return lookup_kmer(kmers, stride, k, buckets, hsize, nexts, keybuf);
}

static int predecessor_of(int idx, shared char *kmers, int stride, int k,
                          shared unsigned char *lefts,
                          shared int *buckets, int hsize,
                          shared int *nexts, char *keybuf)
{
    int j;
    if (lefts[idx] == 'F') return -1;
    keybuf[0] = (char)lefts[idx];
    for (j = 0; j < k - 1; ++j)
        keybuf[j + 1] = kmers[(size_t)idx * (size_t)stride + (size_t)j];
    keybuf[k] = '\0';
    return lookup_kmer(kmers, stride, k, buckets, hsize, nexts, keybuf);
}

static void emit_path(FILE *out, int start, int is_cycle,
                      shared char *kmers, int stride, int k,
                      shared unsigned char *lefts,
                      shared unsigned char *rights,
                      shared int *buckets, int hsize,
                      shared int *nexts,
                      shared unsigned char *visited,
                      char *buf, char *keybuf)
{
    int cur = start;
    size_t pos = 0;
    int j;

    if (!is_cycle && lefts[start] != 'F')
        buf[pos++] = (char)lefts[start];

    for (j = 0; j < k; ++j)
        buf[pos++] = kmers[(size_t)start * (size_t)stride + (size_t)j];

    for (;;) {
        int nxt;
        visited[cur] = 1;
        if (rights[cur] == 'F') break;

        nxt = successor_of(cur, kmers, stride, k, rights,
                           buckets, hsize, nexts, keybuf);
        if (nxt < 0) {
            /* The next k-mer is absent (truncated input), but the extension
               base itself is known and therefore belongs to the contig. */
            buf[pos++] = (char)rights[cur];
            break;
        }
        if (is_cycle && nxt == start) break;
        if (visited[nxt]) break;
        buf[pos++] = (char)rights[cur];
        cur = nxt;
    }
    buf[pos] = '\0';
    if (pos > 0) {
        fputs(buf, out);
        fputc('\n', out);
    }
}

int main(int argc, char **argv)
{
    const char *input = (argc > 1) ? argv[1] : "test";
    int n, k, stride, hsize;
    int i;
    shared char *kmers;
    shared unsigned char *lefts, *rights, *visited;
    shared int *nexts, *buckets;
    char *buf = NULL;
    char *keybuf = NULL;
    char outpath[64];
    FILE *out = NULL;
    glob_t gl;

    /* Phase 1: thread 0 determines the number of k-mers and k. */
    if (MYTHREAD == 0) {
        FILE *in = fopen(input, "r");
        char *line = NULL;
        size_t linecap = 0;
        ssize_t linelen;
        int count = 0;
        int first_k = 0;

        if (!in) {
            perror(input);
            g_n = -1;
        } else {
            while ((linelen = getline(&line, &linecap, in)) >= 0) {
                char *tab;
                if (linelen == 0) continue;
                tab = strchr(line, '\t');
                if (!tab) continue;
                if (first_k == 0) first_k = (int)(tab - line);
                ++count;
            }
            free(line);
            fclose(in);
            g_n = count;
            g_k = first_k;
        }
    }
    upc_barrier;
    if (g_n < 0) return 1;

    n = g_n;
    k = g_k;
    stride = k + 1;

    if (n == 0) {
        if (MYTHREAD == 0) {
            if (glob("/app/pgen*.out", 0, NULL, &gl) == 0) {
                size_t x;
                for (x = 0; x < gl.gl_pathc; ++x) unlink(gl.gl_pathv[x]);
                globfree(&gl);
            }
            out = fopen("/app/pgen_0.out", "w");
            if (out) fclose(out);
        }
        return 0;
    }

    /* Phase 2: collectively allocate the graph in shared memory. */
    kmers = (shared char *)upc_all_alloc((size_t)n * (size_t)stride, sizeof(char));
    lefts = (shared unsigned char *)upc_all_alloc((size_t)n, sizeof(unsigned char));
    rights = (shared unsigned char *)upc_all_alloc((size_t)n, sizeof(unsigned char));
    nexts = (shared int *)upc_all_alloc((size_t)n, sizeof(int));
    visited = (shared unsigned char *)upc_all_alloc((size_t)n, sizeof(unsigned char));
    if (!kmers || !lefts || !rights || !nexts || !visited) {
        fprintf(stderr, "Thread %d: shared allocation failed\n", MYTHREAD);
        return 1;
    }

    /* Phase 3: parse the input in parallel.  Each thread scans the file but
       writes only its own strided subset of k-mer records. */
    {
        FILE *in = fopen(input, "r");
        char *line = NULL;
        size_t linecap = 0;
        ssize_t linelen;
        int idx = 0;

        if (!in) {
            perror(input);
            return 1;
        }
        while ((linelen = getline(&line, &linecap, in)) >= 0) {
            char *tab;
            int j;
            if (linelen == 0) continue;
            tab = strchr(line, '\t');
            if (!tab) continue;
            if (idx % THREADS == MYTHREAD) {
                size_t base = (size_t)idx * (size_t)stride;
                for (j = 0; j < k; ++j) kmers[base + (size_t)j] = line[j];
                kmers[base + (size_t)k] = '\0';
                lefts[idx] = (tab[1] != '\0') ? (unsigned char)tab[1] : (unsigned char)'F';
                rights[idx] = (tab[2] != '\0') ? (unsigned char)tab[2] : (unsigned char)'F';
                nexts[idx] = -1;
            }
            ++idx;
        }
        free(line);
        fclose(in);
        if (idx != n) {
            fprintf(stderr, "Thread %d: input changed while reading (%d != %d)\n",
                    MYTHREAD, idx, n);
            return 1;
        }
    }

    hsize = next_prime(2 * n + 1);
    buckets = (shared int *)upc_all_alloc((size_t)hsize, sizeof(int));
    if (!buckets) {
        fprintf(stderr, "Thread %d: bucket allocation failed\n", MYTHREAD);
        return 1;
    }

    for (i = MYTHREAD; i < hsize; i += THREADS)
        buckets[i] = -1;
    for (i = MYTHREAD; i < n; i += THREADS)
        visited[i] = 0;
    upc_barrier;

    /* Phase 4: build separate-chaining hash table in parallel.  A thread
       owns all buckets with (bucket_index % THREADS == MYTHREAD), so it is
       the only writer of those buckets and of their chain links. */
    for (i = 0; i < n; ++i) {
        int b = (int)(hash_shared_kmer(kmers, stride, i, k) % (uint64_t)hsize);
        if (b % THREADS == MYTHREAD) {
            nexts[i] = buckets[b];
            buckets[b] = i;
        }
    }
    upc_barrier;

    buf = (char *)malloc((size_t)n + (size_t)k + 8);
    keybuf = (char *)malloc((size_t)k + 1);
    if (!buf || !keybuf) {
        perror("malloc");
        return 1;
    }

    /* Remove outputs from any earlier run (including runs with a different
       number of UPC threads), then let each thread create its own file. */
    if (MYTHREAD == 0) {
        if (glob("/app/pgen*.out", 0, NULL, &gl) == 0) {
            size_t x;
            for (x = 0; x < gl.gl_pathc; ++x) unlink(gl.gl_pathv[x]);
            globfree(&gl);
        }
    }
    upc_barrier;

    snprintf(outpath, sizeof(outpath), "/app/pgen_%d.out", (int)MYTHREAD);
    out = fopen(outpath, "w");
    if (!out) {
        perror(outpath);
        return 1;
    }

    /* Phase 5: traverse the maximal paths in parallel.  Roots are assigned
       to threads by k-mer index; a root has no predecessor in the graph. */
    for (i = MYTHREAD; i < n; i += THREADS) {
        if (!visited[i] &&
            predecessor_of(i, kmers, stride, k, lefts,
                           buckets, hsize, nexts, keybuf) < 0) {
            emit_path(out, i, 0, kmers, stride, k, lefts, rights,
                      buckets, hsize, nexts, visited, buf, keybuf);
        }
    }
    upc_barrier;

    /* Cycle fallback: rare for this workload, handled by thread 0 for
       deterministic cycle entry points. */
    if (MYTHREAD == 0) {
        for (i = 0; i < n; ++i) {
            if (!visited[i])
                emit_path(out, i, 1, kmers, stride, k, lefts, rights,
                          buckets, hsize, nexts, visited, buf, keybuf);
        }
    }
    upc_barrier;

    fclose(out);
    free(buf);
    free(keybuf);

    upc_barrier;
    upc_free(kmers);
    upc_free(lefts);
    upc_free(rights);
    upc_free(nexts);
    upc_free(visited);
    upc_free(buckets);
    return 0;
}
