  /usr/local/bin/upcrun -n 2 -shared-heap 256MB ./pgen test >/tmp/stress.log 2>&1
  rc=$?
  if [ $rc -eq 0 ]; then ok=$((ok+1)); else fail=$((fail+1)); echo "FAIL run $i rc=$rc"; cat /tmp/stress.log; break; fi
done
echo "ok=$ok fail=$fail"
cat /app/pgen_*.out | sort > /tmp/pgen_sorted.txt
sort /app/serial.out > /tmp/serial_sorted.txt
diff -u /tmp/serial_sorted.txt /tmp/pgen_sorted.txt && echo IDENTICAL
