#include <upc.h>
#include <stdio.h>
#include <upc_collective.h>
shared int g_n;
int main(void) {
    if (MYTHREAD == 0) g_n = 5;
    upc_barrier;
    shared int *a = (shared int *)upc_all_alloc(g_n, sizeof(int));
    int i;
    for (i = MYTHREAD; i < g_n; i += THREADS) a[i] = i * i;
    upc_barrier;
    for (i = MYTHREAD; i < g_n; i += THREADS) printf("T%d a[%d]=%d\n", MYTHREAD, i, a[i]);
    upc_barrier;
    upc_free(a);
    return 0;
}
EOF
