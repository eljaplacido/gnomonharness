[479.97698, "o", "<returncode>\r\n0\r\n<output>\r\nrm -f serial pgen /app/serial.out /app/pgen_*.out\r\ncc -O2 -std=gnu99 -Wall -Wextra -o serial serial.c\r\n/usr/local/opt/bin/upcc -network=smp -O -o pgen pgen.upc\r\npgen.upc:1: warning: \"_GNU_SOURCE\" redefined\r\n<command-line>: note: this is the location of the previous definition\r\n-rw-r--r-- 1 root root    924 Nov  1 07:32 Makefile\r\n-rwxr-xr-x 1 root root 853872 Nov  1 07:32 pgen\r\n-rwxr-xr-x 1 root root  71392 Nov  1 07:32 serial\r\n-rwxr-xr-x 1 root root    300 Nov  1 07:32 verify.sh\r\n--- verify 4 threads\r\nUPCR: UPC thread 0 of 4 on 20583e9ac8c2 (pshm node 0 of 1, process 0 of 4, pid=46831)\r\nUPCR: UPC thread 2 of 4 on 20583e9ac8c2 (pshm node 0 of 1, process 2 of 4, pid=46850)\r\nUPCR: UPC thread 3 of 4 on 20583e9ac8c2 (pshm node 0 of 1, process 3 of 4, pid=46851)\r\nUPCR: UPC thread 1 of 4 on 20583e9ac8c2 (pshm node 0 of 1, process 1 of 4, pid=46849)\r\nUPC Runtime warning: Requested shared memory (256 MB) > available (9 MB) on node 0 (20583e9ac8c2): using 9 MB per thread instead\r\nVerification passed with 4 UPC threads\r\n\r\n"]
