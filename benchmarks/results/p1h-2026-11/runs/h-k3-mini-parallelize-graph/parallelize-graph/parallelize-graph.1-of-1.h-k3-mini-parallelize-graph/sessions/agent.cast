[710.424398, "o", "<returncode>\r\n0\r\n<output>\r\ngenerated\r\n=== threads 2 ===\r\nall random cases passed\r\n=== threads 4 ===\r\nall random cases passed\r\n=== threads 7 ===\r\nall random cases passed\r\n\r\n"]
