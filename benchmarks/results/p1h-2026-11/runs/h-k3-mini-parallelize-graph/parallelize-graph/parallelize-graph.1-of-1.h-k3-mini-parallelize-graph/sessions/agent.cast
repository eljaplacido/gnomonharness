[455.172653, "o", "\r\u001b[2K\u001b[32m⠇\u001b[0m Waiting for the LM to respond..."]
[455.253062, "o", "\r\u001b[2K\u001b[32m⠏\u001b[0m Waiting for the LM to respond..."]
[455.333793, "o", "\r\u001b[2K\u001b[32m⠋\u001b[0m Waiting for the LM to respond..."]
[455.41415, "o", "\r\u001b[2K\u001b[32m⠙\u001b[0m Waiting for the LM to respond..."]
[455.494477, "o", "\r\u001b[2K\u001b[32m⠹\u001b[0m Waiting for the LM to respond..."]
