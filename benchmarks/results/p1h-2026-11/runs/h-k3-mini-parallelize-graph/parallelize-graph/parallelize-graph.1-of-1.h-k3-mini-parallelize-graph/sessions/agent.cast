[328.772376, "o", "\r\u001b[2K```\r\n/usr/local/bin/upcrun --help 2>&1 | grep -i -A3 -B2 'network\\|smp\\|nodes' | head -80\r\necho '--- config'; cat ~/.upcrunrc 2>/dev/null || echo no-upcrunrc\r\necho '--- upcc help network'; /usr/local/opt/bin/upcc -help 2>&1 | grep -i -A2 -B2 'network' | head -40\r\n```\r\n\u001b[32m⠹\u001b[0m Waiting for the LM to respond..."]
[328.772518, "o", "\r\u001b[2K\u001b[32m⠹\u001b[0m Waiting for the LM to respond...\r\n\u001b[?25h\r\u001b[1A\u001b[2K"]
[328.849752, "o", "\r\n\u001b[1;32mTool\u001b[0m:\r\n"]
[328.85022, "o", "<returncode>\r\n0\r\n<output>\r\n    -h -? -help\r\n            See this message\r\n    -help-gasnet [network_name]\r\n            See the GASNet documentation, or the GASNet documentation\r\n            for a particular network conduit.\r\n    -conf=FILE\r\n            Read FILE instead of the $HOME/.upcrunrc configuration file.\r\n    -norc\r\n--\r\n            but must agree with the compiled-in setting if present.\r\n            (-np is a synonym for -n)\r\n    -N -nodes <num>\r\n            Specifies the number of compute nodes to use for\r\n            execution. See the THREAD LAYOUT section of the man page\r\n            for more details.\r\n    -c -cpus-per-node <num>\r\n--\r\n            a shared-memory \"supernode\".  If more than this many processes\r\n            are co-located on the same compute node, then they will become\r\n            multiple supernodes for the purpose of PSHM.\r\n            Note that this is a limit on processes, not on UPC threads,\r\n            which will be different if pthreads is also in use.\r\n            A value of 0 (the default) means no limit is imposed.\r\n--- config\r\nno-upcrunrc\r\n--- upcc help network\r\n\r\nUPC-related options:\r\n   -network=<type>    Set network API use for communication.\r\n                      Valid types include:\r\n                        mpi, udp, smp, ibv, aries, ofi, ucx\r\n--\r\n   -extern-main       Use if main() is declared in a non-UPC object or library.\r\n   -[no]fast-symptr   Use fast symmetric pointers for power-of-two static \r\n                      threads.  (Available only for '-network=smp -pthreads')\r\n                      If available, on by default if -T passed a power-of-two value.\r\n   -opt-enable=OPT1[,OPT2]\r\n\r\n"]
[328.85203, "o", "\u001b[92m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\r\n"]
