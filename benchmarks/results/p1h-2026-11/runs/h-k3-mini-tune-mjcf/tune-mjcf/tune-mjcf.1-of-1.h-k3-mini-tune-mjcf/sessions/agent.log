for a in ['nq','nv','njnt','nbody','ngeom','neq','nu','nsite','nmesh','nhfield','nmat','ntex','npair','nlight','nuser','nM','nD','nkey']:
 print(a,getattr(m,a,'NA'))
for field in 
['timestep','integrator','solver','iterations','tolerance','ls_tolerance','noslip_iterations','ccd_iterations','disableflags','enableflags','gravity','cone','ja
cobian','solver_type']:
    try: print(field, getattr(m.opt,field))
    except Exception as e: print(field,'ERR',e)
for i in range(min(45,m.nbody)):
    print(i,repr(m.body(i).name), 'mass',m.body_mass[i], 'inertia',m.body_inertia[i], 'pos',m.body_pos[i], 'jnt', m.body_jntadr[i],m.body_jntnum[i])
