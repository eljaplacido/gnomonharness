print('joints:')
for i in range(m.njnt): print(i, m.joint(i).name, m.jnt_type[i], m.jnt_qposadr[i],m.jnt_dofadr[i], m.jnt_bodyid[i], m.jnt_range[i], m.jnt_stiffness[i], 
m.dof_damping[m.jnt_dofadr[i]])
for t in [0, .1, .5, 1,2]:
 d=mujoco.MjData(m); d.qpos += np.random.default_rng(1).normal(0,.01,size=d.qpos.shape); mujoco.mj_forward(m,d)
 for _ in range(int(round(t/m.opt.timestep))): mujoco.mj_step(m,d)
 print('t',t,'qpos absmax',np.max(np.abs(d.qpos)), 'qvel max',np.max(np.abs(d.qvel)), 'qfrc_constraint',np.max(np.abs(d.qfrc_constraint)), 
'qacc',np.max(np.abs(d.qacc)), 'warn',d.warning)
 np.save(f'/tmp/state_{t}.npy', np.concatenate([d.qpos,d.qvel]))
