import mujoco, numpy as np, time
ref=mujoco.MjModel.from_xml_path('model_ref.xml')
seeds=[1,2,3,4]

def sim(m,seed):
 d=mujoco.MjData(m); rng=np.random.default_rng(seed); d.qpos += rng.normal(0,.01,size=d.qpos.shape); mujoco.mj_forward(m,d)
 for _ in range(int(2.0/m.opt.timestep)): mujoco.mj_step(m,d)
 s=np.zeros(mujoco.mj_stateSize(m,mujoco.mjtState.mjSTATE_FULLPHYSICS)); mujoco.mj_getState(m,d,s,mujoco.mjtState.mjSTATE_FULLPHYSICS); return s
refs=[sim(ref,s) for s in seeds]
configs=[(2,100,1e-8),(2,50,1e-8),(2,20,1e-8),(2,10,1e-8),(2,5,1e-8),(2,3,1e-8),(2,2,1e-8),(2,1,1e-8),(0,100,1e-8),(1,100,1e-8),(1,10,1e-8),(0,10,1e-8)]
for solver,it,tol in configs:
 m=mujoco.MjModel.from_xml_path('model_ref.xml'); m.opt.solver=solver; m.opt.iterations=it; m.opt.tolerance=tol
 t=time.perf_counter(); states=[sim(m,s) for s in seeds]; dt=time.perf_counter()-t
 errs=[np.max(np.abs(a-b)) for a,b in zip(states,refs)]
 print(f'solver={solver} it={it} tol={tol} maxerr={max(errs):.4g} errs={[f"{e:.1e}" for e in errs]} time={dt:.3f}')
