import mujoco, numpy as np, cProfile, pstats, io
m=mujoco.MjModel.from_xml_path('model_ref.xml'); d=mujoco.MjData(m)
d.qpos += np.random.default_rng(1).normal(0,.01,size=d.qpos.shape); mujoco.mj_forward(m,d)
pr=cProfile.Profile(); pr.enable()
for _ in range(2000): mujoco.mj_step(m,d)
