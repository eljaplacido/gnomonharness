cd /app && cat > /tmp/sweep.py <<'PY'
import mujoco, numpy as np, time
ref=mujoco.MjModel.from_xml_path('model_ref.xml')
seeds=[np.random.randint(0,10000) for _ in range(20)]

def sim(m,seed,full=True):
 d=mujoco.MjData(m)
 rng=np.random.default_rng(seed)
 d.qpos += rng.normal(0,.01,size=d.qpos.shape)
 mujoco.mj_forward(m,d)
 n=int(2.0/m.opt.timestep)
 for _ in range(n): mujoco.mj_step(m,d)
 s=np.zeros(mujoco.mj_stateSize(m,mujoco.mjtState.mjSTATE_FULLPHYSICS))
 mujoco.mj_getState(m,d,s,mujoco.mjtState.mjSTATE_FULLPHYSICS)
 return s

refs=[sim(ref,s) for s in seeds]
# timing ref
t=time.perf_counter()
for s in seeds: sim(ref,s)
print('ref time',time.perf_counter()-t)
configs=[]
for solver in [0,1,2]:
 for it in [100,50,30,20,10,5,3,2,1]:
  for tol in ([1e-8] if it!=100 else [1e-8,1e-6,1e-4]):
   configs.append((solver,it,tol))
for solver,it,tol in configs:
 m=mujoco.MjModel.from_xml_path('model_ref.xml')
 m.opt.solver=solver; m.opt.iterations=it; m.opt.tolerance=tol
 try:
  states=[sim(m,s) for s in seeds]
  errs=[np.linalg.norm(a-b,ord=np.inf) for a,b in zip(states,refs)]
  maxerr=max(errs)
  # time second pass
  t=time.perf_counter()
  for s in seeds: sim(m,s)
  dt=time.perf_counter()-t
  print(f'solver={solver} it={it} tol={tol} maxerr={maxerr:.3g} meanerr={np.mean(errs):.3g} time={dt:.4f} ratio={dt/(time.perf_counter()-t+dt):.3f}')
 except Exception as e:
  print('ERR',solver,it,tol,repr(e))
