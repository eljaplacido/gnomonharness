cd /app && python - <<'PY'
import mujoco, numpy as np, time
for f in ['model_ref.xml','model.xml']:
 m=mujoco.MjModel.from_xml_path(f)
 print(f,'solver',m.opt.solver,'it',m.opt.iterations,'tol',m.opt.tolerance,'ls',m.opt.ls_tolerance,'jac',m.opt.jacobian)
 d=mujoco.MjData(m); d.qpos += np.random.default_rng(1).normal(0,.01,size=d.qpos.shape); mujoco.mj_forward(m,d)
 t=time.perf_counter()
 for _ in range(1000): mujoco.mj_step(m,d)
 print('  time',time.perf_counter()-t)
# interleaved 5 repeats
models=[mujoco.MjModel.from_xml_path(f) for f in ['model_ref.xml','model.xml']]
for rep in range(3):
 for f,m in zip(['ref','cg'],models):
  seeds=[rep*10+i for i in range(5)]
  t=time.perf_counter()
  for seed in seeds:
   d=mujoco.MjData(m); d.qpos += np.random.default_rng(seed).normal(0,.01,size=d.qpos.shape); mujoco.mj_forward(m,d)
   for _ in range(int(2/m.opt.timestep)): mujoco.mj_step(m,d)
  print(rep,f,time.perf_counter()-t)
