cd /app && python - <<'PY'
import mujoco, numpy as np
m=mujoco.MjModel.from_xml_path('model_ref.xml')
d=mujoco.MjData(m)
print('version',mujoco.__version__)
print('nq nv njnt nbody ngeom neq nact nu nsite nmesh nhfield nmat ntex npair nlight 
nuser',m.nq,m.nv,m.njnt,m.nbody,m.ngeom,m.neq,m.nact,m.nu,m.nsite,m.nmesh,m.nhfield,m.nmat,m.ntex,m.npair,m.nlight,m.nuser)
print('opt',m.opt)
for field in 
['timestep','integrator','solver','iterations','tolerance','ls_tolerance','noslip_iterations','ccd_iterations','disableflags','enableflags','gravity']:
    try: print(field, getattr(m.opt,field))
    except Exception as e: print(field,e)
print('nkey',m.nkey,'nM',m.nM, 'nD',m.nD)
for i in range(min(45,m.nbody)):
    print(i,m.body(i).name, 'mass',m.body_mass[i], 'inertia',m.body_inertia[i], 'pos',m.body_pos[i], 'joint?', m.body_jntadr[i],m.body_jntnum[i])
print('eq',[(m.eq_type[i],m.eq_obj1id[i],m.eq_obj2id[i],m.eq_data[i]) for i in range(m.neq)])
# initial settle states
for t in [0, .1, .5, 1,2]:
 d=mujoco.MjData(m); d.qpos += np.random.default_rng(1).normal(0,.01,size=d.qpos.shape); mujoco.mj_forward(m,d)
 for _ in range(int(t/m.opt.timestep)): mujoco.mj_step(m,d)
 print('t',t,'qpos nz',np.max(np.abs(d.qpos)), 'qvel max',np.max(np.abs(d.qvel)), 'ctrl',d.ctrl, 'qfrc',np.max(np.abs(d.qfrc_constraint)), 
'qacc',np.max(np.abs(d.qacc)))
 np.save(f'/tmp/state_{t}.npy', np.concatenate([d.qpos,d.qvel,d.act]))
