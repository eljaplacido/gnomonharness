cd /app && python - <<'PY'
import mujoco, numpy as np, time
m=mujoco.MjModel.from_xml_path('model_ref.xml'); d=mujoco.MjData(m)
d.qpos += np.random.default_rng(1).normal(0,.01,size=d.qpos.shape); mujoco.mj_forward(m,d)
print('initial ncon',d.ncon,'nefc',d.nefc,'nJ',d.nJ)
mx=[0,0]; hist={}
for i in range(1000):
 mujoco.mj_step(m,d)
 mx[0]=max(mx[0],d.ncon); mx[1]=max(mx[1],d.nefc)
 hist[(d.ncon,d.nefc)]=hist.get((d.ncon,d.nefc),0)+1
print('max ncon nefc',mx,'hist top',sorted(hist.items(), key=lambda x:-x[1])[:10])
print('opts sensordata', m.nsensordata if hasattr(m,'nsensordata') else '?')
# model stats about arrays
for a in ['ncon','nefc','nJ','efc_J','efc_force','qfrc_constraint','qfrc_bias']:
 try: print(a, getattr(d,a).shape)
 except Exception as e: print(a,e)
# energy compare plugin on/off maybe
