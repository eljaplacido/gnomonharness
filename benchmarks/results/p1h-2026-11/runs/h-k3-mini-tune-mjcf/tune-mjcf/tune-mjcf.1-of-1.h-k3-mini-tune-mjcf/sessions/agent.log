cd /app && cat > /tmp/check_seeds.py <<'PY'
import mujoco, numpy as np, time, sys
ref=mujoco.MjModel.from_xml_path('/app/model_ref.xml')
new=mujoco.MjModel.from_xml_path('/app/model.xml')
start=int(sys.argv[1]); n=int(sys.argv[2])
seeds=np.arange(start,start+n)
def sim(m,seed):
 d=mujoco.MjData(m); rng=np.random.default_rng(int(seed)); d.qpos += rng.normal(0,.01,size=d.qpos.shape); mujoco.mj_forward(m,d)
 for _ in range(int(2.0/m.opt.timestep)): mujoco.mj_step(m,d)
 s=np.zeros(mujoco.mj_stateSize(m,mujoco.mjtState.mjSTATE_FULLPHYSICS)); mujoco.mj_getState(m,d,s,mujoco.mjtState.mjSTATE_FULLPHYSICS); return s
mx=0; mxseed=None; l2mx=0; bad=0
t=time.perf_counter()
for seed in seeds:
 a=sim(ref,seed); b=sim(new,seed)
 e=np.max(np.abs(a-b)); l2=np.linalg.norm(a-b)
 if e>mx: mx=e; mxseed=seed
 l2mx=max(l2mx,l2)
 if not np.allclose(a,b,atol=1e-5): bad+=1
print('range',start,start+n,'max_abs',mx,'seed',mxseed,'max_l2',l2mx,'bad',bad,'time',time.perf_counter()-t)
PY
