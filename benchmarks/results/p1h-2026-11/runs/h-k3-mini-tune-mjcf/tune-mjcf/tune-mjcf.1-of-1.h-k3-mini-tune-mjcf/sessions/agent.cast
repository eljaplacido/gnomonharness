[81.287854, "o", "\r\u001b[2K```\r\ncd /app && python - <<'PY'\r\nimport mujoco, numpy as np\r\nm=mujoco.MjModel.from_xml_path('model_ref.xml')\r\nd=mujoco.MjData(m)\r\nprint('version',mujoco.__version__)\r\nprint('nq nv njnt nbody ngeom neq nact nu nsite nmesh nhfield nmat ntex npair nlight \r\nnuser',m.nq,m.nv,m.njnt,m.nbody,m.ngeom,m.neq,m.nact,m.nu,m.nsite,m.nmesh,m.nhfield,m.nmat,m.ntex,m.npair,m.nlight,m.nuser)\r\nprint('opt',m.opt)\r\nfor field in \r\n['timestep','integrator','solver','iterations','tolerance','ls_tolerance','noslip_iterations','ccd_iterations','disableflags','enableflags','gravity']:\r\n    try: print(field, getattr(m.opt,field))\r\n    except Exception as e: print(field,e)\r\nprint('nkey',m.nkey,'nM',m.nM, 'nD',m.nD)\r\nfor i in range(min(45,m.nbody)):\r\n    print(i,m.body(i).name, 'mass',m.body_mass[i], 'inertia',m.body_inertia[i], 'pos',m.body_pos[i], 'joint?', m.body_jntadr[i],m.body_jntnum[i])\r\nprint('eq',[(m.eq_type[i],m.eq_obj1id[i],m.eq_obj2id[i],m.eq_data[i]) for i in range(m.neq)])\r\n# initial settle states\r\nfor t in [0, .1, .5,"]
[81.287868, "o", " 1,2]:\r\n d=mujoco.MjData(m); d.qpos += np.random.default_rng(1).normal(0,.01,size=d.qpos.shape); mujoco.mj_forward(m,d)\r\n for _ in range(int(t/m.opt.timestep)): mujoco.mj_step(m,d)\r\n print('t',t,'qpos nz',np.max(np.abs(d.qpos)), 'qvel max',np.max(np.abs(d.qvel)), 'ctrl',d.ctrl, 'qfrc',np.max(np.abs(d.qfrc_constraint)), \r\n'qacc',np.max(np.abs(d.qacc)))\r\n np.save(f'/tmp/state_{t}.npy', np.concatenate([d.qpos,d.qvel,d.act]))\r\nPY\r\n```\r\n\u001b[32m⠏\u001b[0m Waiting for the LM to respond...\r\u001b[2K\u001b[32m⠏\u001b[0m Waiting for the LM to respond...\r\n\u001b[?25h\r\u001b[1A\u001b[2K"]
