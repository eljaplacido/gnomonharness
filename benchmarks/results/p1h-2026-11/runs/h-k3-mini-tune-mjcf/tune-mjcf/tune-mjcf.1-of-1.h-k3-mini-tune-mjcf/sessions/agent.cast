[170.052055, "o", "\r\u001b[2K```\r\ncd /app && cat > /tmp/sweep.py <<'PY'\r\nimport mujoco, numpy as np, time\r\nref=mujoco.MjModel.from_xml_path('model_ref.xml')\r\nseeds=[1,2,3,4]\r\n\r\ndef sim(m,seed):\r\n d=mujoco.MjData(m); rng=np.random.default_rng(seed); d.qpos += rng.normal(0,.01,size=d.qpos.shape); mujoco.mj_forward(m,d)\r\n for _ in range(int(2.0/m.opt.timestep)): mujoco.mj_step(m,d)\r\n s=np.zeros(mujoco.mj_stateSize(m,mujoco.mjtState.mjSTATE_FULLPHYSICS)); mujoco.mj_getState(m,d,s,mujoco.mjtState.mjSTATE_FULLPHYSICS); return s\r\nrefs=[sim(ref,s) for s in seeds]\r\nconfigs=[(2,100,1e-8),(2,50,1e-8),(2,20,1e-8),(2,10,1e-8),(2,5,1e-8),(2,3,1e-8),(2,2,1e-8),(2,1,1e-8),(0,100,1e-8),(1,100,1e-8),(1,10,1e-8),(0,10,1e-8)]\r\nfor solver,it,tol in configs:\r\n m=mujoco.MjModel.from_xml_path('model_ref.xml'); m.opt.solver=solver; m.opt.iterations=it; m.opt.tolerance=tol\r\n t=time.perf_counter(); states=[sim(m,s) for s in seeds]; dt=time.perf_counter()-t\r\n errs=[np.max(np.abs(a-b)) for a,b in zip(states,refs)]\r\n print(f'solver={solver} it={it} tol={tol} max"]
[170.052062, "o", "err={max(errs):.4g} errs={[f\"{e:.1e}\" for e in errs]} time={dt:.3f}')\r\nPY\r\npython /tmp/sweep.py\r\n```\r\n\u001b[32m⠋\u001b[0m Waiting for the LM to respond..."]
