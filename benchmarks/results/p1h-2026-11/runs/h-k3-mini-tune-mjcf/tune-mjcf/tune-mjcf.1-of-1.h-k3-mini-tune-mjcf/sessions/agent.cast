[94.594253, "o", "\r\u001b[2K```\r\ncd /app && python - <<'PY'\r\nimport mujoco, numpy as np\r\nm=mujoco.MjModel.from_xml_path('model_ref.xml')\r\nd=mujoco.MjData(m)\r\nprint('version',mujoco.__version__)\r\nfor a in ['nq','nv','njnt','nbody','ngeom','neq','nu','nsite','nmesh','nhfield','nmat','ntex','npair','nlight','nuser','nM','nD','nkey']:\r\n print(a,getattr(m,a,'NA'))\r\nfor field in \r\n['timestep','integrator','solver','iterations','tolerance','ls_tolerance','noslip_iterations','ccd_iterations','disableflags','enableflags','gravity','cone','ja\r\ncobian','solver_type']:\r\n    try: print(field, getattr(m.opt,field))\r\n    except Exception as e: print(field,'ERR',e)\r\nfor i in range(min(45,m.nbody)):\r\n    print(i,repr(m.body(i).name), 'mass',m.body_mass[i], 'inertia',m.body_inertia[i], 'pos',m.body_pos[i], 'jnt', m.body_jntadr[i],m.body_jntnum[i])\r\nprint('eq',[(m.eq_type[i],m.eq_obj1id[i],m.eq_obj2id[i],m.eq_data[i].tolist()) for i in range(m.neq)])\r\nprint('joints:')\r\nfor i in range(m.njnt): print(i, m.joint(i).name, m.jnt_type[i], m.jnt_qposadr[i],"]
[94.594276, "o", "m.jnt_dofadr[i], m.jnt_bodyid[i], m.jnt_range[i], m.jnt_stiffness[i], \r\nm.dof_damping[m.jnt_dofadr[i]])\r\nfor t in [0, .1, .5, 1,2]:\r\n d=mujoco.MjData(m); d.qpos += np.random.default_rng(1).normal(0,.01,size=d.qpos.shape); mujoco.mj_forward(m,d)\r\n for _ in range(int(round(t/m.opt.timestep))): mujoco.mj_step(m,d)\r\n print('t',t,'qpos absmax',np.max(np.abs(d.qpos)), 'qvel max',np.max(np.abs(d.qvel)), 'qfrc_constraint',np.max(np.abs(d.qfrc_constraint)), \r\n'qacc',np.max(np.abs(d.qacc)), 'warn',d.warning)\r\n np.save(f'/tmp/state_{t}.npy', np.concatenate([d.qpos,d.qvel]))\r\nPY\r\n```\r\n\u001b[32m⠹\u001b[0m Waiting for the LM to respond..."]
