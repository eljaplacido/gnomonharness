[131.914047, "o", "\r\u001b[2K```\r\ncd /app && cat > /tmp/sweep.py <<'PY'\r\nimport mujoco, numpy as np, time\r\nref=mujoco.MjModel.from_xml_path('model_ref.xml')\r\nseeds=[np.random.randint(0,10000) for _ in range(20)]\r\n\r\ndef sim(m,seed,full=True):\r\n d=mujoco.MjData(m)\r\n rng=np.random.default_rng(seed)\r\n d.qpos += rng.normal(0,.01,size=d.qpos.shape)\r\n mujoco.mj_forward(m,d)\r\n n=int(2.0/m.opt.timestep)\r\n for _ in range(n): mujoco.mj_step(m,d)\r\n s=np.zeros(mujoco.mj_stateSize(m,mujoco.mjtState.mjSTATE_FULLPHYSICS))\r\n mujoco.mj_getState(m,d,s,mujoco.mjtState.mjSTATE_FULLPHYSICS)\r\n return s\r\n\r\nrefs=[sim(ref,s) for s in seeds]\r\n# timing ref\r\nt=time.perf_counter()\r\nfor s in seeds: sim(ref,s)\r\nprint('ref time',time.perf_counter()-t)\r\nconfigs=[]\r\nfor solver in [0,1,2]:\r\n for it in [100,50,30,20,10,5,3,2,1]:\r\n  for tol in ([1e-8] if it!=100 else [1e-8,1e-6,1e-4]):\r\n   configs.append((solver,it,tol))\r\nfor solver,it,tol in configs:\r\n m=mujoco.MjModel.from_xml_path('model_ref.xml')\r\n m.opt.solver=solver; m.opt.iterations=it; m.opt.tolerance=tol\r\n try:"]
[131.914114, "o", "\r\n  states=[sim(m,s) for s in seeds]\r\n  errs=[np.linalg.norm(a-b,ord=np.inf) for a,b in zip(states,refs)]\r\n  maxerr=max(errs)\r\n  # time second pass\r\n  t=time.perf_counter()\r\n  for s in seeds: sim(m,s)\r\n  dt=time.perf_counter()-t\r\n  print(f'solver={solver} it={it} tol={tol} maxerr={maxerr:.3g} meanerr={np.mean(errs):.3g} time={dt:.4f} ratio={dt/(time.perf_counter()-t+dt):.3f}')\r\n except Exception as e:\r\n  print('ERR',solver,it,tol,repr(e))\r\nPY\r\npython /tmp/sweep.py\r\n```\r\n\u001b[32m⠏\u001b[0m Waiting for the LM to respond..."]
