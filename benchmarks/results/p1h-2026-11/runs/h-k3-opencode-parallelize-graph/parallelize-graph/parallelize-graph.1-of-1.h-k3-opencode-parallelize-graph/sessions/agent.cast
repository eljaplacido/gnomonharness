[206.418311, "o", "\u001b[0m$ \u001b[0mcd /app && python3 - <<'EOF'\r\nimport re\r\np='pgen.upc'\r\ns=open(p).read()\r\ns=s.replace('#include <upc.h>\\n#include <upc_lock.h>\\n','#include <upc.h>\\n')\r\ns=s.replace('#define KMAX 128\\n','#define KMAX 128\\n#define NLOCKS 4096     /* striped locks protecting hash buckets */\\n')\r\ns=s.replace('static shared upc_lock_t *g_locks;   /* one lock per bucket               */\\n','static upc_lock_t *my_locks[NLOCKS]; /* striped hash-table locks          */\\n')\r\ns=s.replace('        upc_lock(&g_locks[b]);','        upc_lock(my_locks[b % NLOCKS]);')\r\ns=s.replace('        upc_unlock(&g_locks[b]);','        upc_unlock(my_locks[b % NLOCKS]);')\r\ns=s.replace('''    g_locks = (shared upc_lock_t *) upc_all_alloc((size_t)nbuckets,\r\n                                                  sizeof(upc_lock_t));\r\n    if (!g_kmer || !g_left || !g_right || !g_nodes || !g_bhead || !g_locks) {''','''    for (i = 0; i < NLOCKS; i++)\r\n        my_locks[i] = upc_all_lock_alloc();   /* collective on all threads */\r\n    if (!g_kmer || !g_left || !g_right || !g_nodes || !g_bhead) {''')\r\ns=s.replace('''        for (i = 0; i < nbuckets; i++) {\r\n            g_bhead[i] = -1;\r\n            upc_lock_init(&g_locks[i]);\r\n        }''','''        for (i = 0; i < nbuckets; i++)\r\n            g_bhead[i] = -1;''')\r\ns=s.replace('''    upc_all_free(g_bhead);\r\n    upc_all_free(g_locks);\r\n    upc_barrier;''','''    upc_all_free(g_bhead);\r\n    for (i = 0; i < NLOCKS; i++)\r\n        upc_all_lock_free(my_locks[i]);\r\n    upc_barrier;''')\r\nopen(p,'w').write(s)\r\nprint(\"patched\")\r\nEOF\r\ngrep -n \"my_locks\\|g_locks\\|NLOCKS\\|upc_lock\" pgen.upc\r\npatched\r\n14: *     Bucket insertion is protected by a shared upc_lock_t, because a\r\n39:#define NLOCKS 4096     /* striped locks protecting hash buckets */\r\n55:static upc_lock_t *my_locks[NLOCKS]; /* striped hash-table locks          */\r\n210:        upc_lock(my_locks[b % NLOCKS]);\r\n226:        upc_unlock(my_locks[b % NLOCKS]);\r\n351:    for (i = 0; i < NLOCKS; i++)\r\n352:        my_locks[i] = upc_all_lock_alloc();   /* collective on all threads */\r\n426:    for (i = 0; i < NLOCKS; i++)\r\n427:        upc_all_lock_free(my_locks[i]);\r\n"]
