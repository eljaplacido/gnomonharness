[193.269347, "o", "\u001b[0m$ \u001b[0mgrep -n \"upc_lock_t\\|upc_lock_init\\|include\" /usr/local/dbg/include/upcr_preinclude/upc.h | head -30\r\n28:/* Spec 1.3 requires upc_types.h to be included every time */\r\n29:#include <upc_types.h>\r\n35:#error This file should only be included during initial preprocess\r\n39:#include <stddef.h>\r\n41:#include <upcr_preinclude/upc_bits.h>\r\n68:#include <stdlib.h> /* real exit def must precede redefinition to avoid warnings */\r\n82:typedef shared void upc_lock_t;\r\n84:extern void upc_lock_init (upc_lock_t *);\r\n85:extern upc_lock_t *upc_global_lock_alloc (void);\r\n86:extern upc_lock_t *upc_all_lock_alloc (void);\r\n87:extern void upc_lock_free(upc_lock_t *);\r\n88:extern void upc_all_lock_free(upc_lock_t *);\r\n89:extern void upc_lock (upc_lock_t *);\r\n90:extern int upc_lock_attempt (upc_lock_t *);\r\n91:extern void upc_unlock (upc_lock_t *);\r\n102:#include <bupc_extensions.h>\r\n"]
