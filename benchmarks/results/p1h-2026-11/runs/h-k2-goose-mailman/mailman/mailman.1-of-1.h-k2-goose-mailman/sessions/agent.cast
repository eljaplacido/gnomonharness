[835.200281, "o", "    \u001b[2m        \"\"\"Sleep until a signal is received.\"\"\"\u001b[0m\r\n    \u001b[2m        # Sleep until a signal is received.  This prevents the master from\u001b[0m\r\n    \u001b[2m        # exiting immediately even if there are no runners (as happens in the\u001b[0m\r\n    \u001b[2m        # test suite).\u001b[0m\r\n    \u001b[2m        signal.pause()\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2m    def loop(self):\u001b[0m\r\n    \u001b[2m        \"\"\"Main loop.\u001b[0m\r\n"]
