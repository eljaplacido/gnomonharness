[627.042769, "o", "    \u001b[2m276:        # SIGHUP tells the runners to close and reopen their log files.\u001b[0m\r\n    \u001b[2m277:        def sighup_handler(signum, frame):                        # noqa: E306\u001b[0m\r\n    \u001b[2m278-            reopen()\u001b[0m\r\n    \u001b[2m279-            for pid in self._kids:\u001b[0m\r\n    \u001b[2m280:                os.kill(pid, signal.SIGHUP)\u001b[0m\r\n    \u001b[2m281:            log.info('Master watcher caught SIGHUP.  Re-opening log files.')\u001b[0m\r\n    \u001b[2m282:        signal.signal(signal.SIGHUP, sighup_handler)\u001b[0m\r\n    \u001b[2m283-        # SIGUSR1 is used by 'mailman restart'.\u001b[0m\r\n    \u001b[2m284-        def sigusr1_handler(signum, frame):                       # noqa: E306\u001b[0m\r\n    \u001b[2m285-            for pid in self._kids:\u001b[0m\r\n    \u001b[2m\u001b[3m... (20 lines hidden, /toggle to show all)\u001b[0m\r\n    \u001b[2m516-    envvar='MAILMAN_CONFIG_FILE',\u001b[0m\r\n    \u001b[2m517-    type=click.Path(exists=True, dir_okay=False, resolve_path=True),\u001b[0m\r\n    \u001b[2m518-    help=_(\"\"\"\\\u001b[0m\r\n    \u001b[2m519-    Configuration file to use.  If not given, the environment variable\u001b[0m\r\n    \u001b[2m--\u001b[0m\r\n    \u001b[2m563:    The runners respond to SIGINT, SIGTERM, SIGUSR1 and SIGHUP.  SIGINT,\u001b[0m\r\n    \u001b[2m564-    SIGTERM and SIGUSR1 all cause a runner to exit cleanly.  The master\u001b[0m\r\n    \u001b[2m565-    will restart runners that have exited due to a SIGUSR1 or some kind\u001b[0m\r\n    \u001b[2m566-    of other exit condition (say because of an uncaught exception).\u001b[0m\r\n    \u001b[2m567:    SIGHUP causes the master and the runners to close their log files,\u001b[0m\r\n"]
[637.053362, "o", "\r\n  \u001b[2m────────────────────────────────────────\u001b[0m\r\n  \u001b[2m▸\u001b[0m \u001b[2medit\u001b[0m\r\n    \u001b[2mpath\u001b[0m \u001b[2m/usr/local/bin/mail-services.sh\u001b[0m\r\n    \u001b[2mnew_text\u001b[0m: \u001b[32mif ! mailman_ok; then\r\n    chown -R list:list /var/lib/mailman3 /var/log/mailman3 2>/dev/null\r\n    if pgrep -u list -f -- '[m]ailman3/bin/master'...\u001b[0m\r\n    \u001b[2mold_text\u001b[0m: \u001b[32mif ! mailman_ok; then\r\n    chown -R list:list /var/lib/mailman3 /var/log/mailman3 2>/dev/null\r\n    # --force clears a stale lock file left behind...\u001b[0m\r\n\r\n"]
