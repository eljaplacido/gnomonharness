[19.289845, "o", "\r\n  \u001b[2m────────────────────────────────────────\u001b[0m\r\n  \u001b[2m▸\u001b[0m \u001b[2mshell\u001b[0m\r\n"]
[19.289957, "o", "    \u001b[2mcommand\u001b[0m: \u001b[32mls -la /app; echo ---; cat /app/eval.py\u001b[0m\r\n\r\n\r\n  \u001b[2m────────────────────────────────────────\u001b[0m\r\n  \u001b[2m▸\u001b[0m \u001b[2mshell\u001b[0m\r\n    \u001b[2mcommand\u001b[0m: \u001b[32mwhich postfix mailman postmap newaliases; echo ---; ls /etc/mailman3/ 2>&1; echo ---; cat /etc/mailman3/mailman.cfg 2>&1\u001b[0m\r\n\r\n"]
[19.308954, "o", "    \u001b[2m/usr/sbin/postfix\u001b[0m\r\n    \u001b[2m/usr/bin/mailman\u001b[0m\r\n    \u001b[2m/usr/sbin/postmap\u001b[0m\r\n    \u001b[2m/usr/bin/newaliases\u001b[0m\r\n    \u001b[2m---\u001b[0m\r\n    \u001b[2mmailman.cfg\u001b[0m\r\n    \u001b[2m---\u001b[0m\r\n    \u001b[2m# Copyright (C) 2008-2017 by the Free Software Foundation, Inc.\u001b[0m\r\n    \u001b[2m#\u001b[0m\r\n    \u001b[2m# This file is part of GNU Mailman.\u001b[0m\r\n    \u001b[2m\u001b[3m... (258 lines hidden, /toggle to show all)\u001b[0m\r\n    \u001b[2mlmtp_port: 8024\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2m# Where can we find the mail server specific configuration file?  The path can\u001b[0m\r\n    \u001b[2m# be either a file system path or a Python import path.  If the value starts\u001b[0m\r\n    \u001b[2m# with python: then it is a Python import path, otherwise it is a file system\u001b[0m\r\n    \u001b[2m# path.  File system paths must be absolute since no guarantees are made about\u001b[0m\r\n    \u001b[2m# the current working directory.  Python paths should not include the trailing\u001b[0m\r\n    \u001b[2m# .cfg, which the file must end with.\u001b[0m\r\n    \u001b[2m#configuration: python:mailman.config.exim4\u001b[0m\r\n    \u001b[2mconfiguration: python:mailman.config.postfix\u001b[0m\r\n    \u001b[2mtotal 16\u001b[0m\r\n    \u001b[2mdrwxr-xr-x 1 root root 4096 Nov  1 03:58 .\u001b[0m\r\n    \u001b[2mdrwxr-xr-x 1 root root 4096 Nov  1 03:58 ..\u001b[0m\r\n    \u001b[2m-rw-rw-r-- 1 root root 6099 Oct 31 09:48 eval.py\u001b[0m\r\n    \u001b[2m---\u001b[0m\r\n    \u001b[2mimport mailbox\u001b[0m\r\n    \u001b[2mimport os\u001b[0m\r\n    \u001b[2mimport smtplib\u001b[0m\r\n    \u001b[2mimport subprocess\u001b[0m\r\n    \u001b[2mfrom email.mime.text import MIMEText\u001b[0m\r\n    \u001b[2m\u001b[3m... (190 lines hidden, /toggle to show all)\u001b[0m\r\n    \u001b[2m    retry(_assert_mailbox_exists)\u001b[0m\r\n    \u001b[2m    retry(bind(confirm_last_reply, user, \"join\"))\u001b[0m\r\n    \u001b[2m    retry(_assert_member)\u001b[0m\r\n    \u001b[2m    print(f\"{user} has confirmed their subscription\")\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2mif __name__ == \"__main__\":\u001b[0m\r\n    \u001b[2m    test_simple_local_delivery()\u001b[0m\r\n    \u001b[2m    test_mlist_exists()\u001b[0m\r\n    \u001b[2m    test_join_flow()\u001b[0m\r\n"]
[23.499035, "o", "\r\n  \u001b[2m────────────────────────────────────────\u001b[0m\r\n  \u001b[2m▸\u001b[0m \u001b[2mshell\u001b[0m\r\n    \u001b[2mcommand\u001b[0m: \u001b[32mhostname; cat /etc/hostname; echo ---; postconf -n; echo ---; cat /etc/postfix/main.cf | head -60\u001b[0m\r\n\r\n\r\n  \u001b[2m────────────────────────────────────────\u001b[0m\r\n  \u001b[2m▸\u001b[0m \u001b[2mshell\u001b[0m\r\n    \u001b[2mcommand\u001b[0m: \u001b[32mmailman version 2>&1; echo ---; dpkg -l | grep -i -E \"mailman|postfix\"; echo ---; ls /usr/lib/mailman3/bin | head -40; echo ---; ls /etc/postfix/\u001b[0m\r\n\r\n"]
[24.241772, "o", "    \u001b[2m218f49a825dd\u001b[0m\r\n    \u001b[2m218f49a825dd\u001b[0m\r\n    \u001b[2m---\u001b[0m\r\n    \u001b[2malias_database = hash:/etc/aliases\u001b[0m\r\n    \u001b[2malias_maps = hash:/etc/aliases\u001b[0m\r\n    \u001b[2mappend_dot_mydomain = no\u001b[0m\r\n    \u001b[2mbiff = no\u001b[0m\r\n    \u001b[2mcompatibility_level = 3.6\u001b[0m\r\n    \u001b[2minet_interfaces = all\u001b[0m\r\n    \u001b[2minet_protocols = all\u001b[0m\r\n    \u001b[2m\u001b[3m... (52 lines hidden, /toggle to show all)\u001b[0m\r\n    \u001b[2mmyhostname = localhost.tailf09230.ts.net\u001b[0m\r\n    \u001b[2malias_maps = hash:/etc/aliases\u001b[0m\r\n    \u001b[2malias_database = hash:/etc/aliases\u001b[0m\r\n    \u001b[2mmydestination = $myhostname, localhost, localhost.localdomain, , localhost\u001b[0m\r\n    \u001b[2mrelayhost = \u001b[0m\r\n    \u001b[2mmynetworks = 127.0.0.0/8 [::ffff:127.0.0.0]/104 [::1]/128\u001b[0m\r\n    \u001b[2mmailbox_size_limit = 0\u001b[0m\r\n    \u001b[2mrecipient_delimiter = +\u001b[0m\r\n    \u001b[2minet_interfaces = all\u001b[0m\r\n    \u001b[2minet_protocols = all\u001b[0m\r\n    \u001b[2mUsage: mailman [OPTIONS] COMMAND [ARGS]...\u001b[0m\r\n    \u001b[2mTry 'mailman -h' for help.\u001b[0m"]
[24.24201, "o", "\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2mError: If you are sure you want to run as root, specify --run-as-root.\u001b[0m\r\n    \u001b[2m---\u001b[0m\r\n    \u001b[2mii  mailman3                      3.3.8-3.1ubuntu0.1                all          Mailing list management system\u001b[0m\r\n    \u001b[2mii  postfix                       3.8.6-1ubuntu0.1                  arm64        High-performance mail transport agent\u001b[0m\r\n    \u001b[2m---\u001b[0m\r\n    \u001b[2mmailman\u001b[0m\r\n    \u001b[2mmaster\u001b[0m\r\n    \u001b[2m\u001b[3m... (4 lines hidden, /toggle to show all)\u001b[0m\r\n    \u001b[2mmain.cf\u001b[0m\r\n    \u001b[2mmain.cf.proto\u001b[0m\r\n    \u001b[2mmakedefs.out\u001b[0m\r\n    \u001b[2mmaster.cf\u001b[0m\r\n    \u001b[2mmaster.cf.proto\u001b[0m\r\n    \u001b[2mpost-install\u001b[0m\r\n    \u001b[2mpostfix-files\u001b[0m\r\n    \u001b[2mpostfix-files.d\u001b[0m\r\n    \u001b[2mpostfix-script\u001b[0m\r\n    \u001b[2msasl\u001b[0m\r\n"]
