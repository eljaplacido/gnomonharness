[568.253297, "o", "    \u001b[2m-rw-r----- 1 root list 4110 Nov  1 04:00 /etc/mailman3/mailman.cfg\u001b[0m\r\n    \u001b[2m# GNU Mailman 3 configuration for the local.edu reading group server.\u001b[0m\r\n    \u001b[2m#\u001b[0m\r\n    \u001b[2m# This is an ini-style file (lazr.config regime).  See\u001b[0m\r\n    \u001b[2m# <https://docs.mailman3.org/en/latest/config-core.html> for the full list of\u001b[0m\r\n    \u001b[2m# settings.\u001b[0m\r\n    \u001b[2m#\u001b[0m\r\n    \u001b[2m# MTA integration: Postfix hands mail for Mailman addresses to the Mailman\u001b[0m\r\n    \u001b[2m# LMTP server (127.0.0.1:8024).  Mailman hands outgoing mail back to Postfix\u001b[0m\r\n    \u001b[2m# on 127.0.0.1:25, which in turn delivers user mail into /var/mail/<user>.\u001b[0m\r\n    \u001b[2m\u001b[3m... (37 lines hidden, /toggle to show all)\u001b[0m\r\n    \u001b[2m43:layout: debian\u001b[0m\r\n    \u001b[2m98:url: sqlite:///$DATA_DIR/mailman.db\u001b[0m\r\n    \u001b[2m122:[mta]\u001b[0m\r\n    \u001b[2m127:incoming: mailman.mta.postfix.LMTP\u001b[0m\r\n    \u001b[2m129:# Callable implementing delivery to the outgoing MTA.\u001b[0m\r\n    \u001b[2m130:outgoing: mailman.mta.deliver.deliver\u001b[0m\r\n    \u001b[2m133:smtp_host: localhost\u001b[0m\r\n    \u001b[2m140:lmtp_host: 127.0.0.1\u001b[0m\r\n    \u001b[2m141:lmtp_port: 8024\u001b[0m\r\n    \u001b[2m144:configuration: python:mailman.config.postfix\u001b[0m\r\n    \u001b[2mappend_dot_mydomain = no\u001b[0m\r\n    \u001b[2mlocal_recipient_maps = proxy:unix:passwd.byname $alias_maps hash:/var/lib/mailman3/data/postfix_lmtp\u001b[0m\r\n    \u001b[2mmaillog_file = /var/log/postfix.log\u001b[0m\r\n    \u001b[2mmydestination = $myhostname, localhost, localhost.localdomain, localhost, local.edu\u001b[0m\r\n    \u001b[2mmydomain = local.edu\u001b[0m\r\n    \u001b[2mmyorigin = local.edu\u001b[0m\r\n    \u001b[2mrecipient_delimiter = +\u001b[0m\r\n    \u001b[2mtransport_maps = hash:/var/lib/mailman3/data/postfix_lmtp\u001b[0m\r\n    \u001b[2m===\u001b[0m\r\n    \u001b[2mtotal 296\u001b[0m\r\n    \u001b[2m-rw-rw---- 1 list list 270336 Nov  1 04:07 mailman.db\u001b[0m\r\n    \u001b[2m-rw-rw---- 1 list list    335 Nov  1 04:04 postfix_domains\u001b[0m\r\n    \u001b[2m-rw-r----- 1 list list  12288 Nov  1 04:04 postfix_domains.db\u001b[0m\r\n    \u001b[2m-rw-rw---- 1 list list    990 Nov  1 04:04 postfix_lmtp\u001b[0m\r\n    \u001b[2m-rw-r----- 1 list list  12288 Nov  1 04:04 postfix_lmtp.db\u001b[0m\r\n    \u001b[2m===\u001b[0m\r\n    \u001b[2mlmtp:[127.0.0.1]:8024\u001b[0m\r\n    \u001b[2mlmtp:[127.0.0.1]:8024\u001b[0m\r\n    \u001b[2mlmtp:[127.0.0.1]:8024\u001b[0m\r\n"]
