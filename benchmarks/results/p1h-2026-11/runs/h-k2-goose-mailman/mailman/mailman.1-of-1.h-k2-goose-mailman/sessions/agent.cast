[384.276919, "o", "    \u001b[2m1215 bash -c cat > /usr/local/bin/mail-watchdog-start.sh <<'EOF' #!/bin/bash # Start the mail watchdog in the background if it is not already running. if ! pgrep -f '[m]ail-watchdog.sh' >/dev/null 2>&1; then     setsid nohup /usr/local/bin/mail-watchdog.sh >/dev/null 2>&1 & fi EOF chmod +x /usr/local/bin/mail-watchdog-start.sh  cat > /etc/rc.local <<'EOF' #!/bin/sh -e # Start the local.edu mail stack at boot. /usr/local/bin/mail-services.sh || true /usr/local/bin/mail-watchdog-start.sh || true exit 0 EOF chmod +x /etc/rc.local  cat > /etc/profile.d/local-mail.sh <<'EOF' # Make sure the local.edu Postfix + Mailman stack is up in this container. if [ -x /usr/local/bin/mail-services.sh ] && [ -z \"${LOCAL_MAIL_CHECKED:-}\" ]; then     export LOCAL_MAIL_CHECKED=1     /usr/local/bin/mail-services.sh >/dev/null 2>&1 || true     /usr/local/bin/mail-watchdog-start.sh >/dev/null 2>&1 || true fi EOF  /usr/local/bin/mail-watchdog-start.sh; sleep 1; pgrep -af '[m]ail-watchdog.sh'; echo ---; tail -5 /var/log/mail-services.log\u001b[0m\r\n    \u001b[2m---\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2mError: GNU Mailman is already running\u001b[0m\r\n    \u001b[2mStarting Mailman's master runner\u001b[0m\r\n    \u001b[2mGenerating MTA alias maps\u001b[0m\r\n    \u001b[2m2026-11-01T04:04:30+00:00 mailman (re)started\u001b[0m\r\n"]
