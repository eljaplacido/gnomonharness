[102.755931, "o", "    \u001b[2m    help=_(\"\"\"\\\u001b[0m\r\n    \u001b[2m    Specify a list owner email address.  If the address is not currently\u001b[0m\r\n    \u001b[2m    registered with Mailman, the address is registered and linked to a user.\u001b[0m\r\n    \u001b[2m    Mailman will send a confirmation message to the address, but it will also\u001b[0m\r\n    \u001b[2m    send a list creation notice to the address.  More than one owner can be\u001b[0m\r\n    \u001b[2m    specified.\"\"\"))\u001b[0m\r\n    \u001b[2m@click.option(\u001b[0m\r\n    \u001b[2m    '--notify/-no-notify', '-n/-N',\u001b[0m\r\n    \u001b[2m    default=False,\u001b[0m\r\n    \u001b[2m    help=_(\"\"\"\\\u001b[0m\r\n    \u001b[2m\u001b[3m... (56 lines hidden, /toggle to show all)\u001b[0m\r\n    \u001b[2m        text = wrap(expand(template, mlist, dict(\u001b[0m\r\n    \u001b[2m            # For backward compatibility.\u001b[0m\r\n    \u001b[2m            requestaddr=mlist.request_address,\u001b[0m\r\n    \u001b[2m            siteowner=mlist.no_reply_address,\u001b[0m\r\n    \u001b[2m            )))\u001b[0m\r\n    \u001b[2m        # Set the I18N language to the list's preferred language so the header\u001b[0m\r\n    \u001b[2m        # will match the template language.  Stashing and restoring the old\u001b[0m\r\n    \u001b[2m        # translation context is just (healthy? :) paranoia.\u001b[0m\r\n    \u001b[2m        with _.using(mlist.preferred_language.code):\u001b[0m\r\n    \u001b[2m            msg = UserNotification(\u001b[0m\r\n"]
