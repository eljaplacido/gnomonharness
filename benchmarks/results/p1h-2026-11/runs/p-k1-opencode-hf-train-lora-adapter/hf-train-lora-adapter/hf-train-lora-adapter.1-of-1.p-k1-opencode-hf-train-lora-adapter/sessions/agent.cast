[963.693864, "o", "\u001b[0m$ \u001b[0mcat > /tmp/exp.py <<'PY'\r\nimport json, os, sys, math, random, argparse, time\r\nimport torch\r\nfrom torch.utils.data import DataLoader\r\nfrom transformers import AutoTokenizer, AutoModelForCausalLM, get_linear_schedule_with_warmup\r\nfrom peft import LoraConfig, get_peft_model\r\ntorch.set_num_threads(20)\r\nBASE='openai-community/gpt2'\r\nletters=['A','B','C','D']\r\n\r\ndef make_prompt(s, t):\r\n    q=s['question']; opts=s['options']\r\n    if t=='canon':\r\n        return f\"Question: {q}\\n\"+\"\\n\".join(opts)+\"\\nAnswer:\"\r\n    if t=='options':\r\n        return f\"Question: {q}\\nOptions:\\n\"+\"\\n\".join(opts)+\"\\nAnswer:\"\r\n    if t=='plain':\r\n        return f\"{q}\\n\"+\"\\n\".join(opts)+\"\\nAnswer:\"\r\n    if t=='theanswer':\r\n        return f\"Question: {q}\\n\"+\"\\n\".join(opts)+\"\\nThe answer is\"\r\n    if t=='canon_sp':\r\n        return f\"Question: {q}\\n\"+\"\\n\".join(opts)+\"\\nAnswer: \"\r\n    if t=='q_only':\r\n        return f\"Question: {q}\\nAnswer:\"\r\n    raise ValueError(t)\r\n\r\nclass DS(torch.utils.data.Dataset):\r\n    def __init__(self, data, temp"]
[963.703863, "o", "lates, add_eos=False):\r\n        self.items=[]\r\n        for s in data:\r\n            for t in templates:\r\n                p=make_prompt(s,t)\r\n                a=(' '+s['answer']) if not p.endswith(' ') else s['answer']\r\n                self.items.append((p,a,add_eos))\r\n    def __len__(self): return len(self.items)\r\n    def __getitem__(self,i): return self.items[i]\r\n\r\ndef collate(batch, tok, maxlen=256):\r\n    texts=[p+a+((tok.eos_token or '') if e else '') for p,a,e in batch]\r\n    prompts=[p for p,a,e in batch]\r\n    ans=[a for p,a,e in batch]\r\n    enc=tok(texts, return_tensors='pt', padding=True, truncation=True, max_length=maxlen)\r\n    labels=torch.full_like(enc.input_ids, -100)\r\n    for i,(p,a,e) in enumerate(batch):\r\n        pl=len(tok(p, add_special_tokens=False).input_ids)\r\n        # with special tokens, gpt2 adds none; assume pl valid\r\n        labels[i,pl]=tok(a, add_special_tokens=False).input_ids[0]\r\n        if e and pl+1<labels.shape[1]:\r\n            labels[i,pl+1]=tok.eos_token_id\r\n    return enc, label"]
[963.703887, "o", "s\r\n\r\ndef eval_acc(model, tok, data, template='canon', bs=50, include_sp=True):\r\n    model.eval(); correct=0\r\n    for i in range(0,len(data),bs):\r\n        chunk=data[i:i+bs]\r\n        texts=[make_prompt(s,template) for s in chunk]\r\n        enc=tok(texts, return_tensors='pt', padding=True)\r\n        with torch.no_grad(): logits=model(**enc).logits\r\n        lens=enc.attention_mask.sum(1)-1\r\n        for j,s in enumerate(chunk):\r\n            lg=logits[j,lens[j]]\r\n            scores=[]\r\n            for L in letters:\r\n                sc=lg[tok.encode(' '+L, add_special_tokens=False)[0]].item()\r\n                if include_sp:\r\n                    sc=max(sc,lg[tok.encode(L, add_special_tokens=False)[0]].item())\r\n                scores.append(sc)\r\n            pred=letters[max(range(4),key=lambda k:scores[k])]\r\n            correct+=pred==s['answer']\r\n    model.train()\r\n    return correct/len(data)\r\n\r\ndef main():\r\n    ap=argparse.ArgumentParser()\r\n    ap.add_argument('--templates', default='canon')\r\n    ap.add_argument('--"]
[963.703898, "o", "epochs', type=int, default=10)\r\n    ap.add_argument('--lr', type=float, default=5e-4)\r\n    ap.add_argument('--bs', type=int, default=16)\r\n    ap.add_argument('--dropout', type=float, default=0.05)\r\n    ap.add_argument('--add_eos', action='store_true')\r\n    ap.add_argument('--seed', type=int, default=42)\r\n    ap.add_argument('--out', default='/tmp/expout')\r\n    args=ap.parse_args()\r\n    random.seed(args.seed); torch.manual_seed(args.seed)\r\n    train=json.load(open('/app/data/train.json')); val=json.load(open('/app/data/val.json'))\r\n    templates=args.templates.split(',')\r\n    tok=AutoTokenizer.from_pretrained(BASE); tok.pad_token=tok.eos_token\r\n    model=AutoModelForCausalLM.from_pretrained(BASE)\r\n    model.config.pad_token_id=tok.pad_token_id\r\n    lc=LoraConfig(r=8,lora_alpha=16,target_modules=['c_attn'],lora_dropout=args.dropout,bias='none',task_type='CAUSAL_LM')\r\n    model=get_peft_model(model,lc)\r\n    model.print_trainable_parameters()\r\n    ds=DS(train,templates,args.add_eos)\r\n    dl=DataLoader(ds,batch_si"]
[963.703913, "o", "ze=args.bs,shuffle=True,collate_fn=lambda b:collate(b,tok))\r\n    opt=torch.optim.AdamW([p for p in model.parameters() if p.requires_grad],lr=args.lr,weight_decay=0.01)\r\n    total=len(dl)*args.epochs\r\n    sched=get_linear_schedule_with_warmup(opt,int(total*0.05),total)\r\n    print('examples',len(ds),'steps',total,flush=True)\r\n    for ep in range(1,args.epochs+1):\r\n        t0=time.time(); model.train(); losses=[]\r\n        for enc,labels in dl:\r\n            out=model(**enc,labels=labels)\r\n            loss=out.loss\r\n            loss.backward(); torch.nn.utils.clip_grad_norm_([p for p in model.parameters() if p.requires_grad],1.0)\r\n            opt.step(); sched.step(); opt.zero_grad()\r\n            losses.append(loss.item())\r\n        print(f\"ep {ep} loss {sum(losses)/len(losses):.4f} time {time.time()-t0:.1f}\",flush=True)\r\n        for t in ['canon','options','plain','theanswer','canon_sp']:\r\n            print(' ',t,eval_acc(model,tok,val,t),flush=True)\r\n        os.makedirs(args.out,exist_ok=True)\r\n        model.save"]
