[903.332124, "o", "\u001b[0m$ \u001b[0mcat > /tmp/eval_baseline.py <<'PY'\r\nimport json, torch\r\nfrom transformers import AutoTokenizer, AutoModelForCausalLM\r\ntorch.set_num_threads(20)\r\nname='openai-community/gpt2'\r\ntok=AutoTokenizer.from_pretrained(name); tok.pad_token=tok.eos_token\r\nmodel=AutoModelForCausalLM.from_pretrained(name).eval()\r\nval=json.load(open('/app/data/val.json'))\r\nletters=['A','B','C','D']\r\ntemplates={\r\n 'q_opts_ans': lambda s: f\"Question: {s['question']}\\n\"+\"\\n\".join(s['options'])+\"\\nAnswer:\",\r\n 'q_opts_sp_ans': lambda s: f\"Question: {s['question']}\\n\"+\"\\n\".join(s['options'])+\"\\nAnswer: \",\r\n 'q_options_ans': lambda s: f\"Question: {s['question']}\\nOptions:\\n\"+\"\\n\".join(s['options'])+\"\\nAnswer:\",\r\n 'q_options_sp_ans': lambda s: f\"Question: {s['question']}\\nOptions:\\n\"+\"\\n\".join(s['options'])+\"\\nAnswer: \",\r\n 'only_opts_ans': lambda s: f\"{s['question']}\\n\"+\"\\n\".join(s['options'])+\"\\nAnswer:\",\r\n 'only_opts_sp_ans': lambda s: f\"{s['question']}\\n\"+\"\\n\".join(s['options'])+\"\\nAnswer: \",\r\n 'q_opts_the_answer': lambda s: f\"Questio"]
[903.341782, "o", "n: {s['question']}\\n\"+\"\\n\".join(s['options'])+\"\\nThe answer is\",\r\n 'q_opts_the_answer_sp': lambda s: f\"Question: {s['question']}\\n\"+\"\\n\".join(s['options'])+\"\\nThe answer is \",\r\n}\r\ndef eval_template(fn, bs=50):\r\n correct=0\r\n for i in range(0,len(val),bs):\r\n  chunk=val[i:i+bs]\r\n  texts=[fn(s) for s in chunk]\r\n  enc=tok(texts, return_tensors='pt', padding=True)\r\n  with torch.no_grad(): logits=model(**enc).logits\r\n  lens=enc.attention_mask.sum(1)-1\r\n  for j,s in enumerate(chunk):\r\n   lg=logits[j,lens[j]]\r\n   scores=[]\r\n   for L in letters:\r\n    t1=tok.encode(' '+L)[0]; t2=tok.encode(L)[0]\r\n    scores.append(max(lg[t1].item(),lg[t2].item()))\r\n   pred=letters[max(range(4),key=lambda k:scores[k])]\r\n   correct+=pred==s['answer']\r\n return correct/len(val)\r\nfor tn,fn in templates.items():\r\n print(tn, eval_template(fn), flush=True)\r\nPY\r\npython -u /tmp/eval_baseline.py\r\nq_opts_ans 0.21\r\nq_opts_sp_ans 0.22\r\nq_options_ans 0.22\r\nq_options_sp_ans 0.22\r\nonly_opts_ans 0.21\r\nonly_opts_sp_ans 0.22\r\nq_opts_the_answer 0.21\r\nq_opts"]
