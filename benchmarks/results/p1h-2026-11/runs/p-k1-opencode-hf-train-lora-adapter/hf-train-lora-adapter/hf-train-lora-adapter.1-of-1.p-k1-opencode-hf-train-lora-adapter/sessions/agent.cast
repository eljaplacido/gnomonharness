[68.936893, "o", "\u001b[0m$ \u001b[0mpython - <<'PY'\r\nfrom transformers import AutoTokenizer, AutoModelForCausalLM\r\nimport torch\r\nname='openai-community/gpt2'\r\ntok=AutoTokenizer.from_pretrained(name)\r\nmodel=AutoModelForCausalLM.from_pretrained(name)\r\nprint(tok.pad_token, tok.eos_token)\r\nfor s in [\"Question: What is X?\\nA) one\\nB) two\\nC) three\\nD) four\\nAnswer:\", \"Question: What is X?\\nA. one\\nB. two\\nC. three\\nD. four\\nAnswer:\"]:\r\n    print(repr(s), len(tok(s).input_ids))\r\nprint(tok.encode(\" A\"), tok.encode(\"A\"), tok.encode(\" A)\"), tok.encode(\" A.\"))\r\nPY\r\nNone <|endoftext|>\r\n'Question: What is X?\\nA) one\\nB) two\\nC) three\\nD) four\\nAnswer:' 25\r\n'Question: What is X?\\nA. one\\nB. two\\nC. three\\nD. four\\nAnswer:' 25\r\n[317] [32] [317, 8] [317, 13]\r\n"]
