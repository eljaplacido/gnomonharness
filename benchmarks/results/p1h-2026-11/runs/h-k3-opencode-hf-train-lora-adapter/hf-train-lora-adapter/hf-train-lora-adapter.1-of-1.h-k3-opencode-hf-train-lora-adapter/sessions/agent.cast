[76.476361, "o", "\u001b[0m$ \u001b[0mcd /tmp && python3 -c \"\r\nimport torch\r\nfrom transformers import AutoModelForCausalLM, AutoTokenizer\r\nfrom peft import LoraConfig, get_peft_model\r\nm = AutoModelForCausalLM.from_pretrained('openai-community/gpt2')\r\nt = AutoTokenizer.from_pretrained('openai-community/gpt2')\r\nprint('loaded', m.config.n_layer, m.config.n_embd)\r\ncfg = LoraConfig(r=8, lora_alpha=16, target_modules=['c_attn'], task_type='CAUSAL_LM', lora_dropout=0.05)\r\np = get_peft_model(m, cfg)\r\np.print_trainable_parameters()\r\nout = p(input_ids=torch.tensor([[1,2,3]]), labels=torch.tensor([[1,2,3]]))\r\nprint(out.logits.shape, out.loss.item())\r\n\" 2>&1 | tail -20\r\nWarning: You are sending unauthenticated requests to the HF Hub. Please set a HF_TOKEN to enable higher rate limits and faster downloads.\r\n\rLoading weights:   0%|          | 0/148 [00:00<?, ?it/s]\rLoading weights: 100%|██████████| 148/148 [00:00<00:00, 9532.95it/s]\r\n/usr/local/lib/python3.13/site-packages/peft/tuners/lora/layer.py:1768: UserWarning: fan_in_fan_ou"]
[76.476388, "o", "t is set to False but the target module is `Conv1D`. Setting fan_in_fan_out to True.\r\n  warnings.warn(\r\n[transformers] `loss_type=None` was set in the config but it is unrecognized. Using the default loss: `ForCausalLMLoss`.\r\nloaded 12 768\r\ntrainable params: 294,912 || all params: 124,734,720 || trainable%: 0.2364\r\ntorch.Size([1, 3, 50257]) 7.34159517288208\r\n"]
[77.697742, "o", "> build · deepseek-v4.1-flash\r\n"]
[87.161277, "o", "\u001b[0m$ \u001b[0mcd /app && python3 -c \"\r\nimport json, collections\r\ntr=json.load(open('data/train.json')); va=json.load(open('data/val.json'))\r\nprint(len(tr), len(va))\r\nprint(collections.Counter(x['answer'] for x in tr))\r\nprint(collections.Counter(x['answer'] for x in va))\r\nprint(max(len(x['question']) for x in tr))\r\nfrom transformers import AutoTokenizer\r\nt=AutoTokenizer.from_pretrained('openai-community/gpt2')\r\nprint({c:(t.encode(' '+c), t.encode(c)) for c in 'ABCD'})\r\nprint('eos', t.eos_token, t.eos_token_id)\r\n\"\r\n300 100\r\nCounter({'C': 100, 'B': 91, 'A': 59, 'D': 50})\r\nCounter({'C': 35, 'B': 32, 'A': 22, 'D': 11})\r\n243\r\n{'A': ([317], [32]), 'B': ([347], [33]), 'C': ([327], [34]), 'D': ([360], [35])}\r\neos <|endoftext|> 50256\r\n"]
