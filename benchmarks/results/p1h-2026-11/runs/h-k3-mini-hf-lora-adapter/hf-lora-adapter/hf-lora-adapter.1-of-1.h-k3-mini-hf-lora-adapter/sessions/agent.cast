[416.869938, "o", "\r\u001b[2KI’ll implement the full pipeline as a script: save a 20-label base model and tokenizer, attach the adapter, verify the adapter’s classifier weights were loaded,\r\nmerge, reload the merged model, and generate argmax-based predictions.\r\n\r\n```\r\ncat > /app/setup_and_test.py <<'PY'\r\nimport json\r\nimport os\r\nimport shutil\r\nimport time\r\n\r\nimport torch\r\nfrom peft import PeftConfig, PeftModel\r\nfrom transformers import AutoConfig, AutoModelForSequenceClassification, AutoTokenizer\r\n\r\nBASE_SRC = '/app/base_model_download'\r\nADAPTER_SRC = '/app/adapter_download'\r\nMODEL_CACHE = '/app/model_cache/xlm-roberta-base'\r\nMERGED_DIR = '/app/merged_model'\r\nRESULTS_PATH = '/app/detection_results.json'\r\n\r\nTEST_SAMPLES = [\r\n    \"Bonjour, comment allez-vous aujourd'hui?\",\r\n    \"Hola, ¿cómo estás hoy?\",\r\n    \"Guten Tag, wie geht es Ihnen?\",\r\n    \"Ciao, come stai oggi?\",\r\n    \"Olá, como você está?\",\r\n    \"Привет, как дела?\",\r\n    \"こんにちは、お元気ですか？\",\r\n    \"你好，你好吗？\",\r\n    \"مر"]
[416.869972, "o", "حبا، كيف حالك؟\",\r\n    \"Hello, how are you?\",\r\n]\r\n\r\nprint('Loading adapter config...', flush=True)\r\npeft_config = PeftConfig.from_pretrained(ADAPTER_SRC)\r\nprint(peft_config, flush=True)\r\n\r\nprint('Loading tokenizer...', flush=True)\r\ntokenizer = AutoTokenizer.from_pretrained(BASE_SRC)\r\n\r\nprint('Configuring base model with 20 classes...', flush=True)\r\nconfig = AutoConfig.from_pretrained(BASE_SRC)\r\n# The adapter repo's config metadata identifies the 20-class label ordering.\r\nlabel_config = AutoConfig.from_pretrained(ADAPTER_SRC)\r\nid2label = {int(k): v for k, v in label_config.id2label.items()}\r\nlabel2id = {v: int(k) for k, v in id2label.items()}\r\nconfig.num_labels = 20\r\nconfig.id2label = id2label\r\nconfig.label2id = label2id\r\nconfig.problem_type = 'single_label_classification'\r\nconfig.use_cache = False\r\n\r\nprint('Loading base model from local checkpoint with 20 labels...', flush=True)\r\nbase_model = AutoModelForSequenceClassification.from_pretrained(\r\n    BASE_SRC,\r\n    config=config,\r\n    ignore_mismatche"]
[416.869979, "o", "d_sizes=True,\r\n)\r\nprint('Base classifier:', base_model.classifier, flush=True)\r\n\r\nos.makedirs(MODEL_CACHE, exist_ok=True)\r\nprint('Saving configured base model and tokenizer to', MODEL_CACHE, flush=True)\r\nbase_model.save_pretrained(MODEL_CACHE)\r\ntokenizer.save_pretrained(MODEL_CACHE)\r\n\r\n# Reload from the required saved location, then apply the adapter to that model.\r\nprint('Reloading configured base model from model cache...', flush=True)\r\nbase_model = AutoModelForSequenceClassification.from_pretrained(MODEL_CACHE)\r\nassert base_model.config.num_labels == 20\r\nassert base_model.classifier.out_proj.out_features == 20\r\nprint('Applying LoRA adapter...', flush=True)\r\npeft_model = PeftModel.from_pretrained(base_model, ADAPTER_SRC)\r\npeft_model.eval()\r\n\r\n# Verify that the adapter's modules_to_save classifier was loaded, not left random.\r\nfrom safetensors.torch import load_file\r\n# adapter is .bin; use torch.load for this verification\r\nadapter_sd = torch.load(os.path.join(ADAPTER_SRC, 'adapter_model.bin'), map_location='"]
[416.870154, "o", "cpu', weights_only=True)\r\nloaded_classifier_out = peft_model.base_model.model.classifier.out_proj.weight.detach()\r\nexpected_classifier_out = adapter_sd['base_model.model.classifier.out_proj.weight']\r\nmax_cls_diff = (loaded_classifier_out - expected_classifier_out).abs().max().item()\r\nprint('Classifier out_proj max diff from adapter:', max_cls_diff, flush=True)\r\nassert max_cls_diff < 1e-6, 'Adapter classifier was not loaded correctly'\r\n\r\nprint('Merging LoRA adapter into base model...', flush=True)\r\nmerged_model = peft_model.merge_and_unload()\r\nmerged_model.eval()\r\n\r\nos.makedirs(MERGED_DIR, exist_ok=True)\r\nprint('Saving merged model to', MERGED_DIR, flush=True)\r\nmerged_model.save_pretrained(MERGED_DIR)\r\ntokenizer.save_pretrained(MERGED_DIR)\r\n\r\n# Verify the merged checkpoint stands alone and predict from it.\r\nprint('Reloading merged model for inference...', flush=True)\r\nmerged_model = AutoModelForSequenceClassification.from_pretrained(MERGED_DIR)\r\nmerged_model.eval()\r\nassert merged_model.config.num_labels == 20\r"]
[416.870198, "o", "\nassert merged_model.classifier.out_proj.out_features == 20\r\n\r\n\r\ndef predict(text: str):\r\n    inputs = tokenizer(text, return_tensors='pt', truncation=True, max_length=512)\r\n    with torch.no_grad():\r\n        logits = merged_model(**inputs).logits\r\n    probs = torch.softmax(logits, dim=-1)\r\n    class_id = int(torch.argmax(logits, dim=-1).item())\r\n    confidence = float(probs[0, class_id].item())\r\n    return class_id, confidence\r\n\r\n\r\nresults = []\r\nprint('\\nLanguage detection results:', flush=True)\r\nfor text in TEST_SAMPLES:\r\n    class_id, confidence = predict(text)\r\n    results.append({\r\n        'text': text,\r\n        'predicted_class_id': class_id,\r\n        'confidence': confidence,\r\n    })\r\n    print(f'{class_id:2d} {id2label.get(class_id, \"?\"):>3s} {confidence:.6f}  {text}', flush=True)\r\n\r\nwith open(RESULTS_PATH, 'w', encoding='utf-8') as f:\r\n    json.dump(results, f, ensure_ascii=False, indent=2)\r\n\r\nprint('\\nSaved results to', RESULTS_PATH, flush=True)\r\nprint(json.dumps(results, ensure_ascii=False, indent="]
[416.870229, "o", "2), flush=True)\r\nprint('PIPELINE_COMPLETE', flush=True)\r\nPY\r\ncd /app && nohup python /app/setup_and_test.py > /app/setup_and_test.log 2>&1 & echo $! > /app/setup_and_test.pid; sleep 5; tail -20 /app/setup_and_test.log\r\n```\r\n\u001b[32m⠇\u001b[0m Waiting for the LM to respond...\r\u001b[2K\u001b[32m⠇\u001b[0m Waiting for the LM to respond...\r\n\u001b[?25h\r\u001b[1A\u001b[2K"]
