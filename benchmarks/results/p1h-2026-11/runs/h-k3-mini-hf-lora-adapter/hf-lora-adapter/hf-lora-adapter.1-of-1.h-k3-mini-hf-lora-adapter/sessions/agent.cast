[483.435508, "o", "\r\u001b[2K\r\n\u001b[1;31mmini-swe-agent\u001b[0m\u001b[31m (step \u001b[0m\u001b[1;31m23\u001b[0m\u001b[31m, \u001b[0m\u001b[1;31m$0.00\u001b[0m\u001b[31m):\u001b[0m\r\n\u001b[32m⠸\u001b[0m Waiting for the LM to respond..."]
[483.436984, "o", "\r\u001b[2K```\r\ncat > /app/evaluate_langid.py <<'PY'\r\nimport csv, json, random, time\r\nfrom collections import defaultdict\r\nimport torch\r\nfrom transformers import AutoModelForSequenceClassification, AutoTokenizer\r\n\r\nrandom.seed(42)\r\nrows=list(csv.DictReader(open('/app/langid_data/test.csv',encoding='utf-8')))\r\nby_lang=defaultdict(list)\r\nfor r in rows:\r\n    by_lang[r['labels']].append(r['text'])\r\n# Use a fixed stratified sample for a quick sanity check\r\nper_lang=int(__import__('os').environ.get('PER_LANG','25'))\r\nsamples=[]\r\nfor lang, texts in sorted(by_lang.items()):\r\n    for t in random.sample(texts, min(per_lang,len(texts))):\r\n        samples.append((lang,t))\r\nprint('samples',len(samples), flush=True)\r\n\r\ntok=AutoTokenizer.from_pretrained('/app/merged_model')\r\nmodel=AutoModelForSequenceClassification.from_pretrained('/app/merged_model')\r\nmodel.eval()\r\nlabel2id=model.config.label2id\r\ncorrect=defaultdict(int); total=defaultdict(int)\r\nbs=32\r\nt0=time.time()\r\nwith torch.no_grad():\r\n    for i in range(0,len(samples),bs):"]
[483.437009, "o", "\r\n        batch=samples[i:i+bs]\r\n        texts=[x[1] for x in batch]\r\n        enc=tok(texts,return_tensors='pt',padding=True,truncation=True,max_length=128)\r\n        logits=model(**enc).logits\r\n        preds=logits.argmax(dim=-1).tolist()\r\n        for (gold,_),pred in zip(batch,preds):\r\n            total[gold]+=1\r\n            correct[gold]+=int(label2id[gold]==pred)\r\n        if (i//bs)%10==0:\r\n            print('batch',i//bs,'of',(len(samples)+bs-1)//bs, flush=True)\r\nmetrics={l:{'correct':correct[l],'total':total[l],'accuracy':correct[l]/total[l]} for l in sorted(total)}\r\noverall=sum(correct.values())/sum(total.values())\r\nprint(json.dumps({'overall_accuracy':overall,'per_language':metrics,'elapsed_sec':time.time()-t0},indent=2),flush=True)\r\nPY\r\ncd /app && PER_LANG=25 nohup python /app/evaluate_langid.py > /app/evaluate_langid.log 2>&1 & echo $! > /app/evaluate_langid.pid; sleep 8; tail -20 \r\n/app/evaluate_langid.log\r\n```\r\n\u001b[32m⠸\u001b[0m Waiting for the LM to respond..."]
