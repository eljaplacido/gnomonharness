[441.587584, "o", "\r\u001b[2KThe pipeline completed and all 10 samples were predicted with the expected class IDs. I’ll now verify the saved artifacts, JSON schema, standalone merged \r\nreload, and broader per-language accuracy using the adapter’s original public test dataset if available.\r\n\r\n```\r\necho '--- /app/model_cache/xlm-roberta-base ---'; find /app/model_cache/xlm-roberta-base -maxdepth 1 -type f -printf '%f %s\\n' | sort; echo '--- \r\n/app/merged_model ---'; find /app/merged_model -maxdepth 1 -type f -printf '%f %s\\n' | sort; echo '--- detection_results.json ---'; python -m json.tool \r\n/app/detection_results.json; echo '--- config checks ---'; python - <<'PY'\r\nimport json\r\nfor p in ['/app/model_cache/xlm-roberta-base/config.json','/app/merged_model/config.json']:\r\n    c=json.load(open(p))\r\n    print(p, 'num_labels=',c.get('num_labels'), 'id2label entries=',len(c.get('id2label',{})), 'architectures=',c.get('architectures'))\r\nPY\r\n```\r\n\u001b[32m⠦\u001b[0m Waiting for the LM to respond..."]
[441.587827, "o", "\r\u001b[2K\u001b[32m⠦\u001b[0m Waiting for the LM to respond...\r\n\u001b[?25h\r\u001b[1A\u001b[2K"]
[441.641081, "o", "\r\n\u001b[1;32mTool\u001b[0m:\r\n"]
[441.641721, "o", "<returncode>\r\n0\r\n<output>\r\n--- /app/model_cache/xlm-roberta-base ---\r\nconfig.json 1432\r\nmodel.safetensors 1112260376\r\ntokenizer.json 17098086\r\ntokenizer_config.json 342\r\n--- /app/merged_model ---\r\nconfig.json 1432\r\nmodel.safetensors 1112260376\r\ntokenizer.json 17098086\r\ntokenizer_config.json 342\r\n--- detection_results.json ---\r\n[\r\n    {\r\n        \"text\": \"Bonjour, comment allez-vous aujourd'hui?\",\r\n        \"predicted_class_id\": 6,\r\n        \"confidence\": 0.9752840995788574\r\n    },\r\n    {\r\n        \"text\": \"Hola, \\u00bfc\\u00f3mo est\\u00e1s hoy?\",\r\n        \"predicted_class_id\": 5,\r\n        \"confidence\": 0.9890168905258179\r\n    },\r\n    {\r\n        \"text\": \"Guten Tag, wie geht es Ihnen?\",\r\n        \"predicted_class_id\": 2,\r\n        \"confidence\": 0.9972988963127136\r\n    },\r\n    {\r\n        \"text\": \"Ciao, come stai oggi?\",\r\n        \"predicted_class_id\": 8,\r\n        \"confidence\": 0.988788902759552\r\n    },\r\n    {\r\n        \"text\": \"Ol\\u00e1, como voc\\u00ea est\\u00e1?\",\r\n        \"predicted_class_id\": 12,\r\n        \"confidence\""]
[441.64173, "o", ": 0.9895841479301453\r\n    },\r\n    {\r\n        \"text\": \"\\u041f\\u0440\\u0438\\u0432\\u0435\\u0442, \\u043a\\u0430\\u043a \\u0434\\u0435\\u043b\\u0430?\",\r\n        \"predicted_class_id\": 13,\r\n        \"confidence\": 0.9855579733848572\r\n    },\r\n    {\r\n        \"text\": \"\\u3053\\u3093\\u306b\\u3061\\u306f\\u3001\\u304a\\u5143\\u6c17\\u3067\\u3059\\u304b\\uff1f\",\r\n        \"predicted_class_id\": 9,\r\n        \"confidence\": 0.9649397134780884\r\n    },\r\n    {\r\n        \"text\": \"\\u4f60\\u597d\\uff0c\\u4f60\\u597d\\u5417\\uff1f\",\r\n        \"predicted_class_id\": 19,\r\n        \"confidence\": 0.935988187789917\r\n    },\r\n    {\r\n        \"text\": \"\\u0645\\u0631\\u062d\\u0628\\u0627\\u060c \\u0643\\u064a\\u0641 \\u062d\\u0627\\u0644\\u0643\\u061f\",\r\n        \"predicted_class_id\": 0,\r\n        \"confidence\": 0.9880263805389404\r\n    },\r\n    {\r\n        \"text\": \"Hello, how are you?\",\r\n        \"predicted_class_id\": 4,\r\n        \"confidence\": 0.9737093448638916\r\n    }\r\n]\r\n--- config checks ---\r\n/app/model_cache/xlm-roberta-base/config.json num_labels= None id2label entries= 20 architectures= ['"]
