cat > /app/setup_and_test.py <<'PY'
import json
import os
import shutil
import time

import torch
from peft import PeftConfig, PeftModel
from transformers import AutoConfig, AutoModelForSequenceClassification, AutoTokenizer

BASE_SRC = '/app/base_model_download'
ADAPTER_SRC = '/app/adapter_download'
MODEL_CACHE = '/app/model_cache/xlm-roberta-base'
MERGED_DIR = '/app/merged_model'
RESULTS_PATH = '/app/detection_results.json'

TEST_SAMPLES = [
    "Bonjour, comment allez-vous aujourd'hui?",
    "Hola, ¿cómo estás hoy?",
    "Guten Tag, wie geht es Ihnen?",
    "Ciao, come stai oggi?",
    "Olá, como você está?",
    "Привет, как дела?",
    "こんにちは、お元気ですか？",
    "你好，你好吗？",
    "مرحبا، كيف حالك؟",
    "Hello, how are you?",
]

print('Loading adapter config...', flush=True)
peft_config = PeftConfig.from_pretrained(ADAPTER_SRC)
print(peft_config, flush=True)

print('Loading tokenizer...', flush=True)
tokenizer = AutoTokenizer.from_pretrained(BASE_SRC)

print('Configuring base model with 20 classes...', flush=True)
config = AutoConfig.from_pretrained(BASE_SRC)
# The adapter repo's config metadata identifies the 20-class label ordering.
label_config = AutoConfig.from_pretrained(ADAPTER_SRC)
id2label = {int(k): v for k, v in label_config.id2label.items()}
label2id = {v: int(k) for k, v in id2label.items()}
config.num_labels = 20
config.id2label = id2label
config.label2id = label2id
config.problem_type = 'single_label_classification'
config.use_cache = False

print('Loading base model from local checkpoint with 20 labels...', flush=True)
base_model = AutoModelForSequenceClassification.from_pretrained(
    BASE_SRC,
    config=config,
    ignore_mismatched_sizes=True,
)
print('Base classifier:', base_model.classifier, flush=True)

os.makedirs(MODEL_CACHE, exist_ok=True)
print('Saving configured base model and tokenizer to', MODEL_CACHE, flush=True)
base_model.save_pretrained(MODEL_CACHE)
tokenizer.save_pretrained(MODEL_CACHE)

# Reload from the required saved location, then apply the adapter to that model.
print('Reloading configured base model from model cache...', flush=True)
base_model = AutoModelForSequenceClassification.from_pretrained(MODEL_CACHE)
assert base_model.config.num_labels == 20
assert base_model.classifier.out_proj.out_features == 20
print('Applying LoRA adapter...', flush=True)
peft_model = PeftModel.from_pretrained(base_model, ADAPTER_SRC)
peft_model.eval()

# Verify that the adapter's modules_to_save classifier was loaded, not left random.
from safetensors.torch import load_file
# adapter is .bin; use torch.load for this verification
adapter_sd = torch.load(os.path.join(ADAPTER_SRC, 'adapter_model.bin'), map_location='cpu', weights_only=True)
loaded_classifier_out = peft_model.base_model.model.classifier.out_proj.weight.detach()
expected_classifier_out = adapter_sd['base_model.model.classifier.out_proj.weight']
max_cls_diff = (loaded_classifier_out - expected_classifier_out).abs().max().item()
print('Classifier out_proj max diff from adapter:', max_cls_diff, flush=True)
assert max_cls_diff < 1e-6, 'Adapter classifier was not loaded correctly'

print('Merging LoRA adapter into base model...', flush=True)
merged_model = peft_model.merge_and_unload()
merged_model.eval()

os.makedirs(MERGED_DIR, exist_ok=True)
print('Saving merged model to', MERGED_DIR, flush=True)
merged_model.save_pretrained(MERGED_DIR)
tokenizer.save_pretrained(MERGED_DIR)

# Verify the merged checkpoint stands alone and predict from it.
print('Reloading merged model for inference...', flush=True)
merged_model = AutoModelForSequenceClassification.from_pretrained(MERGED_DIR)
merged_model.eval()
assert merged_model.config.num_labels == 20
assert merged_model.classifier.out_proj.out_features == 20


def predict(text: str):
    inputs = tokenizer(text, return_tensors='pt', truncation=True, max_length=512)
    with torch.no_grad():
        logits = merged_model(**inputs).logits
    probs = torch.softmax(logits, dim=-1)
    class_id = int(torch.argmax(logits, dim=-1).item())
    confidence = float(probs[0, class_id].item())
    return class_id, confidence


results = []
print('\nLanguage detection results:', flush=True)
for text in TEST_SAMPLES:
    class_id, confidence = predict(text)
    results.append({
        'text': text,
        'predicted_class_id': class_id,
        'confidence': confidence,
    })
    print(f'{class_id:2d} {id2label.get(class_id, "?"):>3s} {confidence:.6f}  {text}', flush=True)

with open(RESULTS_PATH, 'w', encoding='utf-8') as f:
    json.dump(results, f, ensure_ascii=False, indent=2)

print('\nSaved results to', RESULTS_PATH, flush=True)
print(json.dumps(results, ensure_ascii=False, indent=2), flush=True)
print('PIPELINE_COMPLETE', flush=True)
PY
cd /app && nohup python /app/setup_and_test.py > /app/setup_and_test.log 2>&1 & echo $! > /app/setup_and_test.pid; sleep 5; tail -20 /app/setup_and_test.log
