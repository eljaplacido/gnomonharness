cd /app && python - <<'PY'
import torch
from safetensors.torch import load_file
base=load_file('/app/model_cache/xlm-roberta-base/model.safetensors')
merged=load_file('/app/merged_model/model.safetensors')
adapter=torch.load('/app/adapter_download/adapter_model.bin',map_location='cpu',weights_only=True)
for layer in [0,5,11]:
    for proj in ['query','value']:
        k=f'roberta.encoder.layer.{layer}.attention.self.{proj}.weight'
        a=adapter[f'base_model.model.roberta.encoder.layer.{layer}.attention.self.{proj}.lora_A.weight']
        b=adapter[f'base_model.model.roberta.encoder.layer.{layer}.attention.self.{proj}.lora_B.weight']
        expected=base[k] + 2.0*(b@a)
        diff=(merged[k]-expected).abs().max().item()
        print(k,'max_diff=',diff)
        assert diff < 1e-5
# Confirm classifier weights match the adapter's saved 20-class head
for name in ['dense.weight','dense.bias','out_proj.weight','out_proj.bias']:
    got=merged[f'classifier.{name}']
    exp=adapter[f'base_model.model.classifier.{name}']
    diff=(got-exp).abs().max().item()
    print('classifier.'+name,'max_diff=',diff)
    assert diff < 1e-6
print('WEIGHT_MERGE_VERIFIED')
PY
