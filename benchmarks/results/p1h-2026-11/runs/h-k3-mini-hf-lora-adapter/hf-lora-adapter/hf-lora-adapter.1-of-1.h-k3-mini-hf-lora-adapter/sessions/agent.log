cat > /app/evaluate_langid.py <<'PY'
import csv, json, random, time
from collections import defaultdict
import torch
from transformers import AutoModelForSequenceClassification, AutoTokenizer

random.seed(42)
rows=list(csv.DictReader(open('/app/langid_data/test.csv',encoding='utf-8')))
by_lang=defaultdict(list)
for r in rows:
    by_lang[r['labels']].append(r['text'])
# Use a fixed stratified sample for a quick sanity check
per_lang=int(__import__('os').environ.get('PER_LANG','25'))
samples=[]
for lang, texts in sorted(by_lang.items()):
    for t in random.sample(texts, min(per_lang,len(texts))):
        samples.append((lang,t))
print('samples',len(samples), flush=True)

tok=AutoTokenizer.from_pretrained('/app/merged_model')
model=AutoModelForSequenceClassification.from_pretrained('/app/merged_model')
model.eval()
label2id=model.config.label2id
correct=defaultdict(int); total=defaultdict(int)
bs=32
t0=time.time()
with torch.no_grad():
    for i in range(0,len(samples),bs):
        batch=samples[i:i+bs]
        texts=[x[1] for x in batch]
        enc=tok(texts,return_tensors='pt',padding=True,truncation=True,max_length=128)
        logits=model(**enc).logits
        preds=logits.argmax(dim=-1).tolist()
        for (gold,_),pred in zip(batch,preds):
            total[gold]+=1
            correct[gold]+=int(label2id[gold]==pred)
        if (i//bs)%10==0:
            print('batch',i//bs,'of',(len(samples)+bs-1)//bs, flush=True)
metrics={l:{'correct':correct[l],'total':total[l],'accuracy':correct[l]/total[l]} for l in sorted(total)}
overall=sum(correct.values())/sum(total.values())
print(json.dumps({'overall_accuracy':overall,'per_language':metrics,'elapsed_sec':time.time()-t0},indent=2),flush=True)
PY
cd /app && PER_LANG=25 nohup python /app/evaluate_langid.py > /app/evaluate_langid.log 2>&1 & echo $! > /app/evaluate_langid.pid; sleep 8; tail -20 
/app/evaluate_langid.log
