print('Downloading adapter...', flush=True)
t=time.time()
p=snapshot_download(
    repo_id='dominguesm/xlm-roberta-base-lora-language-detection',
    local_dir='/app/adapter_download',
    allow_patterns=['adapter_config.json','adapter_model.bin','config.json','README.md'],
)
print('adapter done', p, time.time()-t, flush=True)
PY
