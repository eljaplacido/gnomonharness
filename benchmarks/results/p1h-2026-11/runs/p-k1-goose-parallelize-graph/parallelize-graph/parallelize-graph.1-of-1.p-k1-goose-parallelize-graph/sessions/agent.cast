[349.720133, "o", "\r\n  \u001b[2m────────────────────────────────────────\u001b[0m\r\n  \u001b[2m▸\u001b[0m \u001b[2mshell\u001b[0m\r\n    \u001b[2mcommand\u001b[0m: \u001b[32mcd /app && sed -i '7s|.*| *      block-cyclically distributed (block size 1), so bucket b lives on\\n *      thread b % THREADS.  Because|' pgen....\u001b[0m\r\n\r\n"]
[351.167735, "o", "    \u001b[2m/*\u001b[0m\r\n    \u001b[2m * pgen.upc -- Parallel (UPC) de Bruijn graph construction and traversal.\u001b[0m\r\n    \u001b[2m *\u001b[0m\r\n    \u001b[2m * Parallelisation strategy (see Georganas et al., SC'14):\u001b[0m\r\n    \u001b[2m *\u001b[0m\r\n    \u001b[2m *   1. Distributed hash table with separate chaining.  The bucket array is\u001b[0m\r\n    \u001b[2m *      block-cyclically distributed (block size 1), so bucket b lives on\u001b[0m\r\n    \u001b[2m *      thread b % THREADS.  Because\u001b[0m\r\n    \u001b[2m *      the hash of a k-mer determines its bucket, and a bucket is owned by\u001b[0m\r\n    \u001b[2m *      exactly one thread, every thread can insert its own share of the\u001b[0m\r\n    \u001b[2m\u001b[3m... (2 lines hidden, /toggle to show all)\u001b[0m\r\n    \u001b[2m *      the chain nodes a thread creates are local to it.\u001b[0m\r\n    \u001b[2m *\u001b[0m\r\n    \u001b[2m *   2. In-degree computation is embarrassingly parallel and lock free: the\u001b[0m\r\n    \u001b[2m *      in-degree of node y = c0 c1 ... c(k-1) is the number of k-mers\u001b[0m\r\n    \u001b[2m *      x = ? c0 ... c(k-2) in the table (there are only four candidates)\u001b[0m\r\n    \u001b[2m *      whose right extension equals c(k-1).  Each thread computes the\u001b[0m\r\n    \u001b[2m *      in-degree of the nodes it owns, using only lookups.\u001b[0m\r\n    \u001b[2m *\u001b[0m\r\n    \u001b[2mupcc -network=smp -O -o pgen pgen.upc\u001b[0m\r\n    \u001b[2mpgen.upc:79: warning: control reaches the end of non-VOID function\u001b[0m\r\n"]
[354.371238, "o", "\r\n  \u001b[2m────────────────────────────────────────\u001b[0m\r\n  \u001b[2m▸\u001b[0m \u001b[2mshell\u001b[0m\r\n    \u001b[2mcommand\u001b[0m: \u001b[32mcd /app && sed -n '70,85p' pgen.upc\u001b[0m\r\n\r\n\r\n  \u001b[2m────────────────────────────────────────\u001b[0m\r\n  \u001b[2m▸\u001b[0m \u001b[2mshell\u001b[0m\r\n    \u001b[2mcommand\u001b[0m: \u001b[32mcd /app && ls -l pgen && ./serial test /app/serial.out && upcrun -n 4 -shared-heap 256MB ./pgen /app/test 2>&1 | tail -15\u001b[0m\r\n\r\n"]
[355.611375, "o", "    \u001b[2mstatic inline int base_val(int c)\u001b[0m\r\n    \u001b[2m{\u001b[0m\r\n    \u001b[2m    switch (c) {\u001b[0m\r\n    \u001b[2m        case 'A': case 'a': return 0;\u001b[0m\r\n    \u001b[2m        case 'C': case 'c': return 1;\u001b[0m\r\n    \u001b[2m        case 'G': case 'g': return 2;\u001b[0m\r\n    \u001b[2m        case 'T': case 't': return 3;\u001b[0m\r\n    \u001b[2m        default:            return -1;\u001b[0m\r\n    \u001b[2m    }\u001b[0m\r\n    \u001b[2m}\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2mstatic inline char val_base(int v)\u001b[0m\r\n    \u001b[2m{\u001b[0m\r\n    \u001b[2m    static const char b[4] = {'A', 'C', 'G', 'T'};\u001b[0m\r\n    \u001b[2m    return b[v & 3];\u001b[0m\r\n    \u001b[2m}\u001b[0m\r\n"]
[355.611507, "o", "    \u001b[2m-rwxr-xr-x 1 root root 853640 Oct 31 21:48 pgen\u001b[0m\r\n    \u001b[2m[serial] k=19  unique k-mers=10000  contigs...\u001b[0m\r\n    \u001b[2m[serial] contigs=6  -> /app/serial.out\u001b[0m\r\n    \u001b[2mUPCR: UPC thread 0 of 4 on db3bc4ad969d (pshm node 0 of 1, process 0 of 4, pid=28680)\u001b[0m\r\n    \u001b[2mUPCR: UPC thread 2 of 4 on db3bc4ad969d (pshm node 0 of 1, process 2 of 4, pid=28700)\u001b[0m\r\n    \u001b[2mUPCR: UPC thread 3 of 4 on db3bc4ad969d (pshm node 0 of 1, process 3 of 4, pid=28701)\u001b[0m\r\n    \u001b[2mUPCR: UPC thread 1 of 4 on db3bc4ad969d (pshm node 0 of 1, process 1 of 4, pid=28699)\u001b[0m\r\n    \u001b[2mUPC Runtime warning: Requested shared memory (256 MB) > available (9 MB) on node 0 (db3bc4ad969d): using 9 MB per thread instead\u001b[0m\r\n    \u001b[2m[pgen] thread 1/4: k=19, k-mers=10000, my nodes=2497, contigs=2 -> /app/pgen_1.out\u001b[0m\r\n    \u001b[2m[pgen] thread 3/4: k=19, k-mers=10000, my nodes=2490, contigs=1 -> /app/pgen_3.out\u001b[0m\r\n    \u001b[2m[pgen] thread 2/4: k=19, k-mers=10000, my nodes=2473, contigs=2 -> /app/pgen_2.out\u001b[0m\r\n    \u001b[2m[pgen] thread 0/4: k=19, k-mers=10000, my nodes=2540, contigs=1 -> /app/pgen_0.out\u001b[0m\r\n"]
