[15.596852, "o", "\r\n  \u001b[2m────────────────────────────────────────\u001b[0m\r\n  \u001b[2m▸\u001b[0m \u001b[2mshell\u001b[0m\r\n"]
[15.596967, "o", "    \u001b[2mcommand\u001b[0m: \u001b[32mpwd; ls -la /app; echo \"---\"; cat /app/test 2>/dev/null | head -20; echo \"---\"; wc -l /app/test 2>/dev/null\u001b[0m\r\n\r\n\r\n  \u001b[2m────────────────────────────────────────\u001b[0m\r\n  \u001b[2m▸\u001b[0m \u001b[2mshell\u001b[0m\r\n    \u001b[2mcommand\u001b[0m: \u001b[32mwhich upcrun upcc gcc make; echo \"---\"; ls /usr/local/bin 2>/dev/null | head -30; echo \"---\"; nproc; cat /etc/os-release | head -5\u001b[0m\r\n\r\n"]
[15.618827, "o", "    \u001b[2m/app\u001b[0m\r\n    \u001b[2mtotal 236\u001b[0m\r\n    \u001b[2mdrwxr-xr-x 1 root root   4096 Oct 31 21:42 .\u001b[0m\r\n    \u001b[2mdrwxr-xr-x 1 root root   4096 Oct 31 21:42 ..\u001b[0m\r\n    \u001b[2m-rw-rw-r-- 1 root root 230000 Oct 31 09:48 test\u001b[0m\r\n    \u001b[2m---\u001b[0m\r\n    \u001b[2mATAGCCAGTGCCTGATACT\tFG\u001b[0m\r\n    \u001b[2mTAGCCAGTGCCTGATACTG\tAG\u001b[0m\r\n    \u001b[2mAGCCAGTGCCTGATACTGG\tTC\u001b[0m\r\n    \u001b[2mGCCAGTGCCTGATACTGGC\tAT\u001b[0m\r\n    \u001b[2m\u001b[3m... (8 lines hidden, /toggle to show all)\u001b[0m\r\n    \u001b[2mTGATACTGGCTGGAGAAGA\tCG\u001b[0m\r\n    \u001b[2mGATACTGGCTGGAGAAGAG\tTA\u001b[0m\r\n    \u001b[2mATACTGGCTGGAGAAGAGA\tGT\u001b[0m\r\n    \u001b[2mTACTGGCTGGAGAAGAGAT\tAA\u001b[0m\r\n    \u001b[2mACTGGCTGGAGAAGAGATA\tTA\u001b[0m\r\n    \u001b[2mCTGGCTGGAGAAGAGATAA\tAT\u001b[0m\r\n    \u001b[2mTGGCTGGAGAAGAGATAAT\tCG\u001b[0m\r\n    \u001b[2mGGCTGGAGAAGAGATAATG\tTA\u001b[0m\r\n    \u001b[2m---\u001b[0m\r\n    \u001b[2m10000 /app/test\u001b[0m\r\n    \u001b[2m/usr/bin/gcc\u001b[0m\r\n    \u001b[2m/usr/bin/make\u001b[0m\r\n    \u001b[2m---\u001b[0m\r\n    \u001b[2m---\u001b[0m\r\n    \u001b[2m20\u001b[0m\r\n    \u001b[2mPRETTY_NAME=\"Ubuntu 24.04.2 LTS\"\u001b[0m\r\n    \u001b[2mNAME=\"Ubuntu\"\u001b[0m\r\n    \u001b[2mVERSION_ID=\"24.04\"\u001b[0m\r\n    \u001b[2mVERSION=\"24.04.2 LTS (Noble Numbat)\"\u001b[0m\r\n    \u001b[2mVERSION_CODENAME=noble\u001b[0m\r\n"]
