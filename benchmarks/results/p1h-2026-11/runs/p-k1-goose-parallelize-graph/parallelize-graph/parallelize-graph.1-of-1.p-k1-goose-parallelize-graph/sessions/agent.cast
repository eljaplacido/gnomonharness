[57.559563, "o", "\r\n  \u001b[2m────────────────────────────────────────\u001b[0m\r\n  \u001b[2m▸\u001b[0m \u001b[2mshell\u001b[0m\r\n    \u001b[2mcommand\u001b[0m: \u001b[32mcd /tmp && (nohup bash -c 'curl -sSL -o bu.tar.gz https://upc.lbl.gov/download/release/berkeley_upc-2022.10.0.tar.gz && echo DOWNLOAD_OK && ls -...\u001b[0m\r\n\r\n\r\n  \u001b[2m────────────────────────────────────────\u001b[0m\r\n  \u001b[2m▸\u001b[0m \u001b[2mshell\u001b[0m\r\n    \u001b[2mcommand\u001b[0m: \u001b[32mcd /app && head -3 test && awk -F'\\t' '{print length($1), length($2)}' test | sort | uniq -c && echo \"--- unique kmers:\" && cut -f1 test | sort ...\u001b[0m\r\n\r\n"]
[77.587083, "o", "    \u001b[2mATAGCCAGTGCCTGATACT\tFG\u001b[0m\r\n    \u001b[2mTAGCCAGTGCCTGATACTG\tAG\u001b[0m\r\n    \u001b[2mAGCCAGTGCCTGATACTGG\tTC\u001b[0m\r\n    \u001b[2m  10000 19 2\u001b[0m\r\n    \u001b[2m--- unique kmers:\u001b[0m\r\n    \u001b[2m10000\u001b[0m\r\n    \u001b[2m--- sample tails:\u001b[0m\r\n    \u001b[2mCCACTGACCGGAACAGCGT\tGT\u001b[0m\r\n    \u001b[2mCACTGACCGGAACAGCGTT\tCT\u001b[0m\r\n    \u001b[2mACTGACCGGAACAGCGTTT\tCA\u001b[0m\r\n    \u001b[2mDOWNLOAD_OK\u001b[0m\r\n    \u001b[2m-rw-r--r-- 1 root root 5980624 Oct 31 21:43 bu.tar.gz\u001b[0m\r\n    \u001b[2m-rw-r--r-- 1 root root 5980624 Oct 31 21:43 /tmp/bu.tar.gz\u001b[0m\r\n"]
[79.646079, "o", "\u001b[37mDownload\u001b[0m"]
