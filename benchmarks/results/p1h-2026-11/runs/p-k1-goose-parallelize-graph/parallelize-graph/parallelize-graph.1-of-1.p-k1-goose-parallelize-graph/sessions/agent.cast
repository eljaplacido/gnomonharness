[83.274739, "o", "\r\n  \u001b[2m────────────────────────────────────────\u001b[0m\r\n  \u001b[2m▸\u001b[0m \u001b[2mshell\u001b[0m\r\n    \u001b[2mcommand\u001b[0m: \u001b[32mcd /tmp && tar xzf bu.tar.gz && ls -d berkeley_upc-2022.10.0 && nohup bash -c 'cd /tmp/berkeley_upc-2022.10.0 && ./configure --prefix=/usr/local...\u001b[0m\r\n\r\n\r\n  \u001b[2m────────────────────────────────────────\u001b[0m\r\n  \u001b[2m▸\u001b[0m \u001b[2mshell\u001b[0m\r\n    \u001b[2mcommand\u001b[0m: \u001b[32mcd /app && python3 - <<'EOF'\r\nlines=[l.rstrip('\\n').split('\\t') for l in open('test') if l.strip()]\r\nkm={l[0]:(l[1][0],l[1][1]) for l in lines}\r\nk=...\u001b[0m\r\n\r\n"]
