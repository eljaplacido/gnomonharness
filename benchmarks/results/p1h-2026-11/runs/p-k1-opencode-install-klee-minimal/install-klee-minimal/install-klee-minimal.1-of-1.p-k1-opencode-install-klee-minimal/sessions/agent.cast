[169.127017, "o", "\u001b[0m$ \u001b[0mpython3 - <<'PY'\r\np='/root/.bashrc'\r\ns=open(p).read()\r\nblock='''# KLEE environment configuration (must be before the non-interactive early return)\r\ncase \":$PATH:\" in\r\n  *\":/usr/local/bin:\"*) ;;\r\n  *) export PATH=\"/usr/local/bin:$PATH\" ;;\r\nesac\r\ncase \":$CPATH:\" in\r\n  *\":/usr/local/include:\"*) ;;\r\n  *) export CPATH=\"/usr/local/include${CPATH:+:$CPATH}\" ;;\r\nesac\r\ncase \":$LIBRARY_PATH:\" in\r\n  *\":/usr/local/lib:\"*) ;;\r\n  *) export LIBRARY_PATH=\"/usr/local/lib${LIBRARY_PATH:+:$LIBRARY_PATH}\" ;;\r\nesac\r\ncase \":$LD_LIBRARY_PATH:\" in\r\n  *\":/usr/local/lib:\"*) ;;\r\n  *) export LD_LIBRARY_PATH=\"/usr/local/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}\" ;;\r\nesac\r\n\r\n'''\r\nmarker='# ~/.bashrc: executed by bash(1) for non-login shells.'\r\nif 'KLEE environment configuration' not in s:\r\n    s=s.replace(marker, marker+'\\n'+block, 1)\r\n    open(p,'w').write(s)\r\nPY\r\necho \"--- top of bashrc ---\"; sed -n '1,35p' /root/.bashrc\r\n--- top of bashrc ---\r\n# ~/.bashrc: executed by bash(1) for non-login shells.\r\n# KLEE environment configuration (must be before the non-interactive early return)\r\ncase \":$PATH:\" in\r\n  *\":/usr/local/bin:\"*) ;;\r\n  *) export PATH=\"/usr/local/bin:$PATH\" ;;\r\nesac\r\ncase \":$CPATH:\" in\r\n  *\":/usr/local/include:\"*) ;;\r\n  *) export CPATH=\"/usr/local/include${CPATH:+:$CPATH}\" ;;\r\nesac\r\ncase \":$LIBRARY_PATH:\" in\r\n  *\":/usr/local/lib:\"*) ;;\r\n  *) export LIBRARY_PATH=\"/usr/local/lib${LIBRARY_PATH:+:$LIBRARY_PATH}\" ;;\r\nesac\r\ncase \":$LD_LIBRARY_PATH:\" in\r\n  *\":/usr/local/lib:\"*) ;;\r\n  *) export LD_LIBRARY_PATH=\"/usr/local/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}\" ;;\r\nesac\r\n\r\n\r\n# see /usr/share/doc/bash/examples/startup-files (in the package bash-doc)\r\n# for examples\r\n\r\n# If not running interactively, don't do anything\r\n[ -z \"$PS1\" ] && return\r\n\r\n# don't put duplicate lines in the history. See bash(1) for more options\r\n# ... or force ignoredups and ignorespace\r\nHISTCONTROL=ignoredups:ignorespace\r\n\r\n# append to the history file, don't overwrite it\r\nshopt -s histappend\r\n\r\n# for setting history length see HISTSIZE and HISTFILESIZE in bash(1)\r\nHISTSIZE=1000\r\n"]
