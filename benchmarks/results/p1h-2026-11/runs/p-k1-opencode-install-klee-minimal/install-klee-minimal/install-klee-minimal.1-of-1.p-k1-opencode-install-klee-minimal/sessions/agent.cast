[122.243052, "o", "\u001b[0m$ \u001b[0mcd /tmp/opencode/src/klee && grep -rniE 'uclibc' CMakeLists.txt cmake | head -40\r\nCMakeLists.txt:480:# KLEE uclibc support\r\nCMakeLists.txt:482:set(KLEE_UCLIBC_PATH \"\" CACHE PATH \"Path to klee-uclibc root directory\")\r\nCMakeLists.txt:483:set(KLEE_UCLIBC_BCA_NAME \"klee-uclibc.bca\")\r\nCMakeLists.txt:484:if (NOT KLEE_UCLIBC_PATH STREQUAL \"\")\r\nCMakeLists.txt:486:  set(KLEE_UCLIBC_C_BCA \"${KLEE_UCLIBC_PATH}/lib/libc.a\")\r\nCMakeLists.txt:487:  if (NOT EXISTS \"${KLEE_UCLIBC_C_BCA}\")\r\nCMakeLists.txt:489:      \"klee-uclibc library not found at \\\"${KLEE_UCLIBC_C_BCA}\\\". Set KLEE_UCLIBC_PATH to klee-uclibc root directory or empty string.\")\r\nCMakeLists.txt:491:  message(STATUS \"Found klee-uclibc library: \\\"${KLEE_UCLIBC_C_BCA}\\\"\")\r\nCMakeLists.txt:492:  # Copy KLEE_UCLIBC_C_BCA so KLEE can find it where it is expected.\r\nCMakeLists.txt:494:    \"${KLEE_UCLIBC_C_BCA}\"\r\nCMakeLists.txt:495:    \"${KLEE_RUNTIME_DIRECTORY}/${KLEE_UCLIBC_BCA_NAME}\"\r\nCMakeLists.txt:498:  message(STATUS \"Skipping copying of klee-uclibc runtime\")\r\n"]
