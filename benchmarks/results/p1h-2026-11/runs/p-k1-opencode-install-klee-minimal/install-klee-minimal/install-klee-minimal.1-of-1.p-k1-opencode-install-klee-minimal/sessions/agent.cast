[68.961131, "o", "\u001b[0m$ \u001b[0mmkdir -p /tmp/opencode/src && cd /tmp/opencode/src && rm -rf stp klee && git clone --depth 1 --branch 2.3.3 https://github.com/stp/stp.git stp 2>&1 | tail -3 && sed -n '1,200p' stp/README.md 2>/dev/null | grep -iE 'cmake|minisat|crypto|build|depend' | head -40\r\nTurn off this advice by setting config variable advice.detachedHead to false\r\n"]
