[62.591054, "o", "\u001b[0m$ \u001b[0mapt-cache search '^python3-lit$|^lit$|python3.*lit' | head; echo ---; apt-get install -y -qq git cmake ninja-build build-essential bison flex libboost-all-dev libgtest-dev libgoogle-perftools-dev zlib1g-dev libsqlite3-dev libzstd-dev libedit-dev libncurses-dev libssl-dev python3-minimal python3-tabulate python3-pip pkg-config 2>&1 | tail -20; echo EXIT=${PIPESTATUS[0]}\r\npython3-apparmor - AppArmor Python3 utility library\r\npython3-aiosqlite - sqlite library for Python 3 using asyncio\r\npython3-array-api-compat - Python3 array API compatibility library\r\npython3-bel-resources - Python3 utilities for BEL resource files\r\npython3-biotools - Python3 bioinformatics utilities for high-throughput genomic sequencing\r\npython3-bottle-sqlite - SQLite3 integration for Bottle - Python 3.x\r\npython3-coreschema - Python3 utilities to describe an abstract data schema to coreapi\r\npython3-django-split-settings - Organize Django settings into multiple files and directories (Python3 version)\r\npython3-flit-scm - PEP 518 build backend that uses setuptools_scm and flit\r\npython3-htseq - Python3 high-throughput genome sequencing read analysis utilities\r\n---\r\nupdate-alternatives: warning: skip creation of /usr/share/man/man1/f95.1.gz because associated file /usr/share/man/man1/gfortran.1.gz (of link group f95) doesn't exist\r\r\nupdate-alternatives: using /usr/bin/gfortran to provide /usr/bin/f77 (f77) in auto mode\r\r\nupdate-alternatives: warning: skip creation of /usr/share/man/man1/f77.1.gz because associated file /usr/share/man/man1/gfortran.1.gz (of link group f77) doesn't exist\r\r\nSetting up libboost-python-dev (1.83.0.1ubuntu2) ...\r\r\nSetting up libcaf-openmpi-3t64:arm64 (2.10.2+ds-2.1build2) ...\r\r\nSetting up libopenmpi-dev:arm64 (4.1.6-7ubuntu2) ...\r\r\nupdate-alternatives: using /usr/lib/aarch64-linux-gnu/openmpi/include to provide /usr/include/aarch64-linux-gnu/mpi (mpi-aarch64-linux-gnu) in auto mode\r\r\nSetting up libboost-graph-parallel1.83-dev (1.83.0-2.1ubuntu3.2) ...\r\r\nSetting up libboost-mpi-python1.83.0 (1.83.0-2.1ubuntu3.2) ...\r\r\nSetting up libcoarrays-openmpi-dev:arm64 (2.10.2+ds-2.1build2) ...\r\r\nupdate-alternatives: using /usr/lib/aarch64-linux-gnu/open-coarrays/openmpi/bin/caf to provide /usr/bin/caf.openmpi (caf-openmpi) in auto mode\r\r\nupdate-alternatives: using /usr/bin/caf.openmpi to provide /usr/bin/caf (caf) in auto mode\r\r\nSetting up libboost-graph-parallel-dev (1.83.0.1ubuntu2) ...\r\r\nSetting up mpi-default-dev (1.15build1) ...\r\r\nSetting up libboost-mpi1.83-dev (1.83.0-2.1ubuntu3.2) ...\r\r\nSetting up libboost-mpi-dev (1.83.0.1ubuntu2) ...\r\r\nSetting up libboost-mpi-python1.83-dev (1.83.0-2.1ubuntu3.2) ...\r\r\nSetting up libboost-mpi-python-dev (1.83.0.1ubuntu2) ...\r\r\nSetting up libboost-all-dev (1.83.0.1ubuntu2) ...\r\r\nProcessing triggers for libc-bin (2.39-0ubuntu8.9) ...\r\r\nEXIT=0\r\n"]
