[164.310202, "o", "\u001b[0m$ \u001b[0mmkdir -p /tmp/opencode/kleetest && cd /tmp/opencode/kleetest && cat > test.c <<'EOF'\r\n#include <klee/klee.h>\r\n#include <assert.h>\r\nint main(void) {\r\n  int x;\r\n  klee_make_symbolic(&x, sizeof(x), \"x\");\r\n  if (x == 42) {\r\n    assert(0 && \"found 42\");\r\n  }\r\n  return 0;\r\n}\r\nEOF\r\nclang-16 -I/usr/local/include -emit-llvm -c -g -O0 test.c -o test.bc && rm -rf klee-out-0 && klee --output-dir=klee-out-0 test.bc 2>&1 | tail -30; echo KLEE_EXIT=${PIPESTATUS[0]}; ls klee-out-0 | head; grep -l 'found 42' klee-out-0/*.err 2>/dev/null | head\r\nKLEE: output directory is \"/tmp/opencode/kleetest/klee-out-0\"\r\nKLEE: Using STP solver backend\r\nKLEE: SAT solver: MiniSat\r\nKLEE: Deterministic allocator: Using quarantine queue size 8\r\nKLEE: Deterministic allocator: globals (start-address=0xffb258600000 size=10 GiB)\r\nKLEE: Deterministic allocator: constants (start-address=0xffafd8600000 size=10 GiB)\r\nKLEE: Deterministic allocator: heap (start-address=0xfeafd8600000 size=1024 GiB)\r\nKLEE: Deterministic allocator: stack (start-address=0xfe8fd8600000 size=128 GiB)\r\nKLEE: ERROR: test.c:7: ASSERTION FAIL: 0 && \"found 42\"\r\nKLEE: NOTE: now ignoring this error at this location\r\n\r\nKLEE: done: total instructions = 10\r\nKLEE: done: completed paths = 1\r\nKLEE: done: partially completed paths = 1\r\nKLEE: done: generated tests = 2\r\nKLEE_EXIT=0\r\nassembly.ll\r\ninfo\r\nmessages.txt\r\nrun.istats\r\nrun.stats\r\ntest000001.assert.err\r\ntest000001.kquery\r\ntest000001.ktest\r\ntest000002.ktest\r\nwarnings.txt\r\nklee-out-0/test000001.assert.err\r\n"]
