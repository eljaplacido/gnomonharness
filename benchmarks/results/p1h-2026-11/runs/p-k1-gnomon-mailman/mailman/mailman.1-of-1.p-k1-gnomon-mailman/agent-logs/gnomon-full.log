cat > /tmp/setup_list.py <<'EOF'
from mailman.core.initialize import initialize
from mailman.database.transaction import transaction
from mailman.interfaces.action import Action
from mailman.interfaces.listmanager import IListManager
from mailman.interfaces.subscriptions import SubscriptionPolicy
from zope.component import getUtility

initialize('/etc/mailman3/mailman.cfg')
mlist = getUtility(IListManager).get('reading-group@local.edu')
assert mlist is not None, 'list missing'
with transaction():
    # No owner approval for joins: subscribe as soon as the user confirms
    # their (initially unverified) address.
    mlist.subscription_policy = SubscriptionPolicy.open
    # Leaving still requires the user to reply to a confirmation message.
    mlist.unsubscription_policy = SubscriptionPolicy.confirm
    # Members may post announcements without moderator approval.
    mlist.default_member_action = Action.accept
    mlist.default_nonmember_action = Action.hold
    mlist.emergency = False
print('subscription_policy  :', mlist.subscription_policy)
print('unsubscription_policy:', mlist.unsubscription_policy)
print('default_member_action:', mlist.default_member_action)
print('default_nonmember_action:', mlist.default_nonmember_action)
print('posting_address:', mlist.posting_address)
print('join_address:', mlist.join_address)
print('leave_address:', mlist.leave_address)
print('confirm_address:', mlist.confirm_address('TOKEN'))
EOF
