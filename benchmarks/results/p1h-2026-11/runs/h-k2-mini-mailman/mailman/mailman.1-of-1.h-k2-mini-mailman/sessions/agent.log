cat > /tmp/mailman_setup_list.py <<'EOF'
from mailman.interfaces.mailinglist import SubscriptionPolicy
from mailman.interfaces.action import Action


def configure(mlist):
    mlist.subscription_policy = SubscriptionPolicy.open
    # Keep the user confirmation step for leaving the list.
    mlist.unsubscription_policy = SubscriptionPolicy.confirm
    # Member announcements are accepted directly; no owner moderation.
    mlist.default_member_action = Action.accept
    print('subscribing:', mlist.subscription_policy)
    print('unsubscribing:', mlist.unsubscription_policy)
    print('member action:', mlist.default_member_action)
EOF
cd /tmp && mailman --run-as-root -C /etc/mailman3/mailman.cfg withlist -l reading-group@local.edu -r mailman_setup_list.configure 2>&1
echo '---verify---'
cat > /tmp/mailman_show_list.py <<'EOF'
def show(mlist):
    print('posting:', mlist.posting_address)
    print('subscription_policy:', mlist.subscription_policy)
    print('unsubscription_policy:', mlist.unsubscription_policy)
    print('default_member_action:', mlist.default_member_action)
    print('default_nonmember_action:', mlist.default_nonmember_action)
EOF
cd /tmp && mailman --run-as-root -C /etc/mailman3/mailman.cfg withlist -l reading-group@local.edu -r mailman_show_list.show 2>&1
