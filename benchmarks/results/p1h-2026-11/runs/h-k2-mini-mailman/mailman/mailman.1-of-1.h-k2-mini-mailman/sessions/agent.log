sed -i 's/^site_owner:.*/site_owner: root@local.edu/' /etc/mailman3/mailman.cfg
# Ensure Mailman logs are writable by the list service account
chown -R list:list /var/log/mailman3 /var/lib/mailman3 /run/mailman3
# Postfix locals and LMTP transport map
postconf -e 'myhostname = local.edu'
postconf -e 'mydomain = local.edu'
postconf -e 'myorigin = $mydomain'
postconf -e 'mydestination = $myhostname, localhost, localhost.localdomain, local.edu'
postconf -e 'transport_maps = hash:/var/lib/mailman3/data/postfix_lmtp'
postconf -e 'local_recipient_maps = proxy:unix:passwd.byname $alias_maps'
postconf -e 'mail_spool_directory = /var/mail'
postconf -e 'inet_interfaces = loopback-only'
postconf -n | grep -E 'myhostname|mydomain|myorigin|mydestination|transport_maps|local_recipient_maps|mail_spool|inet_interfaces'
# Create list as root but under the proper service account privileges
mailman --run-as-root -C /etc/mailman3/mailman.cfg create -o root@local.edu --notify reading-group@local.edu
# Generate aliases and inspect result
mailman --run-as-root -C /etc/mailman3/mailman.cfg aliases
echo '--- lmtp map ---'
cat /var/lib/mailman3/data/postfix_lmtp
ls -la /var/lib/mailman3/data
```
