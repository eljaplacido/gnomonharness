[89.99241, "o", "<returncode>\r\n0\r\n<output>\r\nGNU Mailman 3.3.8 (Tom Sawyer)\r\nPython 3.12.3 (main, Aug 31 2026, 10:18:26) [GCC 13.3.0]\r\nconfig file: /etc/mailman3/mailman.cfg\r\ndb url: sqlite:////var/lib/mailman3/data/mailman.db\r\ndevmode: DISABLED\r\nREST root url: http://localhost:8001/3.1/\r\nREST credentials: restadmin:HtjrFZfKuq+XKKF6748Ay9BISs+63E8zkTuDVPKo35GibShq\r\n---\r\nNo matching mailing lists found\r\n---\r\n/var/lib/mailman3/data:\r\ntotal 284\r\ndrwxrwx--- 1 list list   4096 Nov  1 03:44 .\r\ndrwxr-xr-x 1 list list   4096 Nov  1 03:44 ..\r\n-rw-rw---- 1 list list 270336 Nov  1 03:44 mailman.db\r\n\r\n/var/log/mailman3:\r\ntotal 12\r\ndrwxr-xr-x 1 list list 4096 Nov  1 03:44 .\r\ndrwxr-xr-x 1 root root 4096 Oct 31 12:15 ..\r\n-rw-rw---- 1 root root    0 Nov  1 03:44 bounce.log\r\n-rw-rw---- 1 root root    0 Nov  1 03:44 debug.log\r\n-rw-rw---- 1 root root    0 Nov  1 03:44 mailman.log\r\n-rw-rw---- 1 root root    0 Nov  1 03:44 plugins.log\r\n-rw-rw---- 1 root root    0 Nov  1 03:44 smtp.log\r\n---postmap---\r\n/usr/sbin/postmap\r\n/usr/bin/newaliases\r\n9:smtpd_banner = $myhostname ESMTP $mail_name (Ubuntu)\r\n37:myhostname = localhost.tailf09230.ts.net\r\n38:alias_maps = hash:/etc/aliases\r\n39:alias_database = hash:/etc/aliases\r\n40:mydestination = $myhostname, localhost, localhost.localdomain, , localhost\r\n\r\n"]
