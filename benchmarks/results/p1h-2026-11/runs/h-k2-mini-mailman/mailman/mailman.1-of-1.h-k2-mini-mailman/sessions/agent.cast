[130.91926, "o", "\r\u001b[2K```\r\nchown list:list /var/lib/mailman3/data/postfix_lmtp* /var/lib/mailman3/data/postfix_domains*; chmod 644 /var/lib/mailman3/data/postfix_lmtp* \r\n/var/lib/mailman3/data/postfix_domains*; mailman --run-as-root -C /etc/mailman3/mailman.cfg withlist --help 2>&1; echo '---'; mailman --run-as-root -C \r\n/etc/mailman3/mailman.cfg shell --help 2>&1 | head -80; echo '---list info through REST?---'; su -s /bin/sh list -c \"mailman -C /etc/mailman3/mailman.cfg lists\"\r\n2>&1\r\n```\r\n\u001b[32m⠧\u001b[0m Waiting for the LM to respond..."]
