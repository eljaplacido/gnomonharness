[162.547952, "o", "\r\u001b[2K```\r\ncat > /tmp/mailman_setup_list.py <<'EOF'\r\nfrom mailman.interfaces.mailinglist import SubscriptionPolicy\r\nfrom mailman.interfaces.action import Action\r\n\r\n\r\ndef configure(mlist):\r\n    mlist.subscription_policy = SubscriptionPolicy.open\r\n    # Keep the user confirmation step for leaving the list.\r\n    mlist.unsubscription_policy = SubscriptionPolicy.confirm\r\n    # Member announcements are accepted directly; no owner moderation.\r\n    mlist.default_member_action = Action.accept\r\n    print('subscribing:', mlist.subscription_policy)\r\n    print('unsubscribing:', mlist.unsubscription_policy)\r\n    print('member action:', mlist.default_member_action)\r\nEOF\r\ncd /tmp && mailman --run-as-root -C /etc/mailman3/mailman.cfg withlist -l reading-group@local.edu -r mailman_setup_list.configure 2>&1\r\necho '---verify---'\r\ncat > /tmp/mailman_show_list.py <<'EOF'\r\ndef show(mlist):\r\n    print('posting:', mlist.posting_address)\r\n    print('subscription_policy:', mlist.subscription_policy)\r\n    print('unsubscription_policy:', mlist.unsubscription_policy)\r\n    print('default_member_action:', mlist.default_member_action)\r\n    print('default_nonmember_action:', mlist.default_nonmember_action)\r\nEOF\r\ncd /tmp && mailman --run-as-root -C /etc/mailman3/mailman.cfg withlist -l reading-group@local.edu -r mailman_show_list.show 2>&1\r\n```\r\n\u001b[32m⠹\u001b[0m Waiting for the LM to respond..."]
