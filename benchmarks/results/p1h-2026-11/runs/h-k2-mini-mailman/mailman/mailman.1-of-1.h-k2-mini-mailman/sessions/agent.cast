[73.408841, "o", "<returncode>\r\n0\r\n<output>\r\n23:[mailman]\r\n28:site_owner: changeme@example.com\r\n37:default_language: en\r\n66:layout: debian\r\n86:[shell]\r\n108:[paths.debian]\r\n122:var_dir: /var/lib/mailman3\r\n124:queue_dir: $var_dir/queue\r\n128:bin_dir: /usr/lib/mailman3/bin\r\n130:list_data_dir: $var_dir/lists\r\n132:log_dir: /var/log/mailman3\r\n134:lock_dir: $var_dir/locks\r\n136:data_dir: $var_dir/data\r\n140:etc_dir: /etc/mailman3\r\n142:ext_dir: $var_dir/ext\r\n149:template_dir: $var_dir/templates\r\n155:pid_file: /run/mailman3/master.pid\r\n160:[database]\r\n178:[logging.debian]\r\n218:[webservice]\r\n220:hostname: localhost\r\n223:port: 8001\r\n236:admin_user: restadmin\r\n239:admin_pass: HtjrFZfKuq+XKKF6748Ay9BISs+63E8zkTuDVPKo35GibShq\r\n241:[mta]\r\n244:incoming: mailman.mta.postfix.LMTP\r\n253:smtp_host: localhost\r\n254:smtp_port: 25\r\n255:smtp_user:\r\n256:smtp_pass:\r\n261:lmtp_host: 127.0.0.1\r\n262:lmtp_port: 8024\r\n---files---\r\n/etc/mailman3\r\n/etc/mailman3/mailman.cfg\r\n/var/lib/mailman3\r\n/var/lib/mailman3/data\r\n/var/lib/mailman3/data/mailman.db\r\n/var/run/mailman3\r\n---mailman help---\r\nUsage: mailman [OPTIONS] COMMAND [ARGS]...\r\n\r\n  The GNU Mailman mailing list management system Copyright 1998-2018 by the\r\n  Free Software Foundation, Inc. http://www.list.org\r\n\r\nOptions:\r\n  --version          Show the version and exit.\r\n  --run-as-root      Running mailman commands as root is not recommended and\r\n                     mailman will refuse to run as root unless this option is\r\n                     specified.\r\n  -C, --config FILE  Configuration file to use.  If not given, the environment\r\n                     variable MAILMAN_CONFIG_FILE is consulted and used if\r\n                     set.  If neither are given, a default configuration file\r\n                     is loaded.\r\n  -h, --help         Show this message and exit.\r\n\r\nCommands:\r\n  addmembers     Add all member addresses in FILENAME with delivery mode...\r\n  aliases        Regenerate the aliases appropriate for your MTA.\r\n  changeaddress  Change a user's email address from old_address to...\r\n  conf           Print the Mailman configuration.\r\n  create         Create a mailing list.\r\n  delmembers     Delete members from a mailing list.\r\n  digests        Operate on digests.\r\n  findmember     Display all memberships for a user or users with address...\r\n  gatenews       Poll the NNTP server for messages to be gatewayed to...\r\n  help           Show this help message and exit.\r\n  import21       Import Mailman 2.1 list data.\r\n  info           Information about this Mailman instance.\r\n  inject         Inject a message from a file into a mailing list's queue.\r\n  lists          List all mailing lists.\r\n  members        Display a mailing list's members.\r\n  notify         Notify list owners/moderators of pending requests.\r\n"]
[73.408904, "o", "  qfile          Get information out of a queue file.\r\n  remove         Remove a mailing list.\r\n  reopen         Signal the Mailman processes to re-open their log files.\r\n  restart        Stop and restart the Mailman runner subprocesses.\r\n  shell          Operate on a mailing list.\r\n  start          Start the Mailman master and runner processes.\r\n  status         Show the current running status of the Mailman system.\r\n  stop           Stop the Mailman master and runner processes.\r\n  syncmembers    Add and delete members as necessary to syncronize a...\r\n  unshunt        Unshunt messages.\r\n  version        Display Mailman's version.\r\n  withlist       Operate on a mailing list.\r\n---postfix status---\r\npostfix/postlog: the Postfix mail system is not running\r\n---master---\r\ntotal 72\r\ndrwxr-xr-x 18 root    root     4096 Oct 31 12:15 .\r\ndrwxr-xr-x  1 root    root     4096 Oct 31 12:15 ..\r\ndrwx------  2 postfix root     4096 Oct 31 12:15 active\r\ndrwx------  2 postfix root     4096 Oct 31 12:15 bounce\r\ndrwx------  2 postfix root     4096 Oct 31 12:15 corrupt\r\ndrwx------  2 postfix root     4096 Oct 31 12:15 defer\r\ndrwx------  2 postfix root     4096 Oct 31 12:15 deferred\r\ndrwxr-xr-x  2 root    root     4096 May  5 15:47 dev\r\ndrwxr-xr-x  2 root    root     4096 May  5 15:47 etc\r\ndrwx------  2 postfix root     4096 Oct 31 12:15 flush\r\ndrwx------  2 postfix root     4096 Oct 31 12:15 incoming\r\ndrwxr-xr-x  2 root    root     4096 May  5 15:47 lib\r\ndrwx-wx--T  2 postfix postdrop 4096 Oct 31 12:15 maildrop\r\ndrwxr-xr-x  2 root    root     4096 Oct 31 12:15 pid\r\ndrwx------  2 postfix root     4096 Oct 31 12:15 private\r\ndrwx--s---  2 postfix postdrop 4096 Oct 31 12:15 public\r\n-rw-r--r--  1 root    root        0 Oct 31 12:15 restart\r\ndrwx------  2 postfix root     4096 Oct 31 12:15 saved\r\ndrwxr-xr-x  3 root    root     4096 Oct 31 12:15 usr\r\nsmtp      inet  n       -       y       -       -       smtpd\r\npickup    unix  n       -       y       60      1       pickup\r\ncleanup   unix  n       -       y       -       0       cleanup\r\nqmgr      unix  n       -       n       300     1       qmgr\r\ntlsmgr    unix  -       -       y       1000?   1       tlsmgr\r\nrewrite   unix  -       -       y       -       -       trivial-rewrite\r\nbounce    unix  -       -       y       -       0       bounce\r\ndefer     unix  -       -       y       -       0       bounce\r\ntrace     unix  -       -       y       -       0       bounce\r\nverify    unix  -       -       y       -       1       verify\r\nflush     unix  n       -       y       1000?   0       flush\r\nproxymap  unix  -       -       n       -       -       proxymap\r\nproxywrite unix -       -       n       -       1       proxymap\r\nsmtp      unix  -       -       y       -       -       smtp\r\nrelay     unix  -       -       y       -       -       smtp\r\n        -o syslog_name=postfix/$service_name\r\nshowq     unix  n       -       y       -       -       showq\r\nerror     unix  -       -       y       -       -       error\r\nretry     unix  -       -       y       -       -       error\r\ndiscard   unix  -       -       y       -       -       discard\r\nlocal     unix  -       n       n       -       -       local\r\nvirtual   unix  -       n       n       -       -       virtual\r\nlmtp      unix  -       -       y       -       -       lmtp\r\nanvil     unix  -       -       y       -       1       anvil\r\nscache    unix  -       -       y       -       1       scache\r\npostlog   unix-dgram n  -       n       -       1       postlogd\r\nuucp      unix  -       n       n       -       -       pipe\r\n  flags=Fqhu user=uucp argv=uux -r -n -z -a$sender - $nexthop!rmail ($recipient)\r\n\r\n"]
