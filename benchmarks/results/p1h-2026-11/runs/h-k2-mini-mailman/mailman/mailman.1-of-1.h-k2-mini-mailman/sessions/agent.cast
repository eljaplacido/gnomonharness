s/test_lmtp.py:252:Subject: This will be recognized as a post to the join list.\r\n/usr/lib/python3/dist-packages/mailman/runners/tests/test_lmtp.py:262:            create_list('-join@example.com')\r\n/usr/lib/python3/dist-packages/mailman/runners/tests/test_lmtp.py:264:                            ['-join@example.com'], \"\"\"\\\r\n/usr/lib/python3/dist-packages/mailman/runners/tests/test_lmtp.py:266:To: -join@example.com\r\n/usr/lib/python3/dist-packages/mailman/runners/tests/test_lmtp.py:268:Subject: This will be recognized as a post to the -join list.\r\n/usr/lib/python3/dist-packages/mailman/runners/digest.py:250:                value = '\\n\\t'.join(value.split('\\n'))\r\n/usr/lib/python3/dist-packages/mailman/runners/nntp.py:64:        mailman = os.path.join(config.BIN_DIR, 'mailman')\r\n/usr/lib/python3/dist-packages/mailman/runners/nntp.py:179:            msg['Newsgroups'] = COMMASPACE.join(newsgroups)\r\n/usr/lib/python3/dist-packages/mailman/runners/lmtp.py:68:    join='join',\r\n/usr/lib/python3/dist-packages/mailman/runners/lmtp.py:72:    subscribe='join',\r\n/usr/lib/python3/dist-packages/mailman/runners/lmtp.py:81:    join='command',\r\n/usr/lib/python3/dist-packages/mailman/runners/lmtp.py:189:            return CRLF.join(ERR_451 for to in envelope.rcpt_tos)\r\n/usr/lib/python3/dist-packages/mailman/runners/lmtp.py:273:        return CRLF.join(status)\r\n/usr/lib/python3/dist-packages/mailman/commands/eml_help.py:69:            printable_arguments = SPACE.join(arguments)           # noqa: F841\r\n/usr/lib/python3/dist-packages/mailman/commands/eml_membership.py:18:\"\"\"The email commands 'join' and 'subscribe'.\"\"\"\r\n/usr/lib/python3/dist-packages/mailman/commands/eml_membership.py:64:    \"\"\"The email 'join' command.\"\"\"\r\n/usr/lib/python3/dist-packages/mailman/commands/eml_membership.py:66:    name = 'join'\r\n/usr/lib/python3/dist-packages/mailman/commands/eml_membership.py:107:        # Have we already seen one join request from this user