[94.244723, "o", "<returncode>\r\n0\r\n<output>\r\nUsage: mailman create [OPTIONS] LISTNAME\r\n\r\n  Create a mailing list.\r\n\r\n  The 'fully qualified list name', i.e. the posting address of the mailing\r\n  list is required.  It must be a valid email address and the domain must be\r\n  registered with Mailman.  List names are forced to lower case.\r\n\r\nOptions:\r\n  --language CODE                 Set the list's preferred language to CODE,\r\n                                  which must be a registered two letter\r\n                                  language code.\r\n  -o, --owner OWNER               Specify a list owner email address.  If the\r\n                                  address is not currently registered with\r\n                                  Mailman, the address is registered and\r\n                                  linked to a user. Mailman will send a\r\n                                  confirmation message to the address, but it\r\n                                  will also send a list creation notice to the\r\n                                  address.  More than one owner can be\r\n                                  specified.\r\n  -n, --notify / -no-notify, -N   Notify the list owner by email that their\r\n                                  mailing list has been created.\r\n  -q, --quiet                     Print less output.\r\n  -d, --domain / -D, --no-domain  Register the mailing list's domain if not\r\n                                  yet registered.  This is the default\r\n                                  behavior, but these options are provided for\r\n                                  backward compatibility.  With -D do not\r\n                                  register the mailing list's domain.\r\n  -h, --help                      Show this message and exit.\r\n---aliases help---\r\nUsage: mailman aliases [OPTIONS]\r\n\r\n  Regenerate the aliases appropriate for your MTA.\r\n\r\nOptions:\r\n  -d, --directory DIRECTORY  An alternative directory to output the various\r\n                             MTA files to.\r\n  -h, --help                 Show this message and exit.\r\n---postfix config package docs---\r\nchangelog.Debian.gz\r\ncopyright\r\n/usr/lib/python3/dist-packages/mailman/mta/tests/test_aliases.py:144:                         ['postfix_domains', 'postfix_lmtp'])\r\n/usr/lib/python3/dist-packages/mailman/mta/tests/test_aliases.py:153:        with open(os.path.join(self.tempdir, 'postfix_lmtp')) as fp:\r\n/usr/lib/python3/dist-packages/mailman/mta/tests/test_aliases.py:175:                         ['postfix_domains', 'postfix_lmtp'])\r\n/usr/lib/python3/dist-packages/mailman/mta/tests/test_aliases.py:184:        with open(os.path.join(self.tempdir, 'postfix_lmtp')) as fp:\r\n/usr/lib/python3/dist-packages/mailman/mta/tests/test_aliases.py:211:        # show up in the postfix_lmtp file, and both domains will show up in\r\n/usr/lib/python3/dist-packages/mailman/mta/tests/test_aliases.py:218:                         ['postfix_domains', 'postfix_lmtp'])\r\n/usr/lib/python3/dist-packages/mailman/mta/tests/test_aliases.py:228:        with open(os.path.join(self.tempdir, 'postfix_lmtp')) as fp:\r\n/usr/lib/python3/dist-packages/mailman/mta/tests/test_aliases.py:267:                         ['postfix_domains', 'postfix_lmtp'])\r\n/usr/lib/python3/dist-packages/mailman/mta/tests/test_aliases.py:281:        with open(os.path.join(self.tempdir, 'postfix_lmtp')) as fp:\r\n/usr/lib/python3/dist-packages/mailman/mta/tests/test_aliases.py:306:        with open(os.path.join(self.tempdir, 'postfix_lmtp')) as fp:\r\n/usr/lib/python3/dist-packages/mailman/mta/tests/test_aliases.py:342:        # show up in the postfix_lmtp file, and both domains will show up in\r\n/usr/lib/python3/dist-packages/mailman/mta/tests/test_aliases.py:355:                         ['postfix_domains', 'postfix_lmtp', 'postfix_vmap'])\r\n/usr/lib/python3/dist-packages/mailman/mta/tests/test_aliases.py:366:        with open(os.path.join(self.tempdir, 'postfix_lmtp')) as fp:\r\n/usr/lib/python3/dist-packages/mailman/mta/tests/test_aliases.py:428:                         ['postfix_domains', 'postfix_lmtp', 'postfix_vmap'])\r\n/usr/lib/python3/dist-packages/"]
[94.244924, "o", "mailman/mta/tests/test_aliases.py:438:        with open(os.path.join(self.tempdir, 'postfix_lmtp')) as fp:\r\n/usr/lib/python3/dist-packages/mailman/mta/tests/test_aliases.py:487:                         ['postfix_domains', 'postfix_lmtp', 'postfix_vmap'])\r\n/usr/lib/python3/dist-packages/mailman/mta/postfix.py:106:            lmtp_path = os.path.join(directory, 'postfix_lmtp')\r\n\r\n"]
