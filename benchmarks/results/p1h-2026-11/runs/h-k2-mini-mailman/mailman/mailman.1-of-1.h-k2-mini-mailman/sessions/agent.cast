[88.819908, "o", "\r\u001b[2K```\r\nmailman --run-as-root -C /etc/mailman3/mailman.cfg info 2>&1; echo '---'; mailman --run-as-root -C /etc/mailman3/mailman.cfg lists 2>&1; echo '---'; ls -la \r\n/var/lib/mailman3/data /var/log/mailman3; echo '---postmap---'; which postmap newaliases; cat /etc/postfix/main.cf | grep -nE \r\n'mydestination|local_recipient|transport|alias_maps|alias_database|virtual|home_mailbox|mailbox_command|myhostname'\r\n```\r\n\u001b[32m⠧\u001b[0m Waiting for the LM to respond..."]
