[21.047719, "o", "    \u001b[2mbash: line 1: file: command not found\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2m=== pip shebang ===\u001b[0m\r\n    \u001b[2m#!/usr/local/bin/python3.13\u001b[0m\r\n    \u001b[2m# -*- coding: utf-8 -*-\u001b[0m\r\n    \u001b[2mimport re\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2m=== pip runs? ===\u001b[0m\r\n    \u001b[2mTraceback (most recent call last):\u001b[0m\r\n    \u001b[2m  File \"/usr/local/bin/pip\", line 5, in <module>\u001b[0m\r\n    \u001b[2m    from pip._internal.cli.main import main\u001b[0m\r\n    \u001b[2mModuleNotFoundError: No module named 'pip'\u001b[0m\r\n    \u001b[2mexit=1\u001b[0m\r\n"]
