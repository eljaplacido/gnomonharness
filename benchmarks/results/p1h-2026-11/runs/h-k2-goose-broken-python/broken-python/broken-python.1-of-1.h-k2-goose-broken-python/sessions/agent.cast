[71.542137, "o", "\r\n  \u001b[2m────────────────────────────────────────\u001b[0m\r\n  \u001b[2m▸\u001b[0m \u001b[2mshell\u001b[0m\r\n    \u001b[2mcommand\u001b[0m: \u001b[32mecho \"=== pip check ===\"; pip check 2>&1; echo; echo \"=== pip list ===\"; pip list 2>&1; echo; echo \"=== remove test package ===\"; pip uninstall ...\u001b[0m\r\n\r\n\r\n  \u001b[2m────────────────────────────────────────\u001b[0m\r\n  \u001b[2m▸\u001b[0m \u001b[2mshell\u001b[0m\r\n    \u001b[2mcommand\u001b[0m: \u001b[32mecho \"=== Debian /usr/bin/python3 (3.11) ===\"; /usr/bin/python3 -m pip --version 2>&1; echo \"--- externally managed? ---\"; ls /usr/lib/python3.1...\u001b[0m\r\n\r\n"]
[71.963278, "o", "    \u001b[2m=== Debian /usr/bin/python3 (3.11) ===\u001b[0m\r\n    \u001b[2m/usr/bin/python3: No module named pip\u001b[0m\r\n    \u001b[2m--- externally managed? ---\u001b[0m\r\n    \u001b[2m/usr/lib/python3.11/EXTERNALLY-MANAGED\u001b[0m\r\n    \u001b[2m--- apt python3-pip ---\u001b[0m\r\n    \u001b[2m=== pip check ===\u001b[0m\r\n    \u001b[2mNo broken requirements found.\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2m=== pip list ===\u001b[0m\r\n    \u001b[2mPackage Version\u001b[0m\r\n    \u001b[2m------- -------\u001b[0m\r\n    \u001b[2mpip     24.3.1\u001b[0m\r\n    \u001b[2msix     1.17.0\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2m=== remove test package ===\u001b[0m\r\n    \u001b[2m  Successfully uninstalled six-1.17.0\u001b[0m\r\n    \u001b[2mWARNING: Running pip as the 'root' user can result in broken permissions and conflicting behaviour with the system package manager, possibly rendering your system unusable.It is recommended to use a virtual environment instead: https://pip.pypa.io/warnings/venv. Use the --root-user-action option if you know what you are doing and want to suppress this warning.\u001b[0m\r\n"]
[75.605711, "o", "\r\n  \u001b[2m────────────────────────────────────────\u001b[0m\r\n  \u001b[2m▸\u001b[0m \u001b[2mshell\u001b[0m\r\n    \u001b[2mcommand\u001b[0m: \u001b[32mecho \"=== FINAL VERIFICATION ===\"; python3 -m pip --version && pip --version && echo && pip list && echo && pip check && echo && echo \"site-pack...\u001b[0m\r\n\r\n"]
[76.014713, "o", "    \u001b[2m=== FINAL VERIFICATION ===\u001b[0m\r\n    \u001b[2mpip 24.3.1 from /usr/local/lib/python3.13/site-packages/pip (python 3.13)\u001b[0m\r\n    \u001b[2mpip 24.3.1 from /usr/local/lib/python3.13/site-packages/pip (python 3.13)\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2mPackage Version\u001b[0m\r\n    \u001b[2m------- -------\u001b[0m\r\n    \u001b[2mpip     24.3.1\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2mNo broken requirements found.\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2msite-packages:\u001b[0m\r\n    \u001b[2mREADME.txt\u001b[0m\r\n    \u001b[2mpip\u001b[0m\r\n    \u001b[2mpip-24.3.1.dist-info\u001b[0m\r\n"]
[78.087815, "o", "\u001b[37mFixed.\u001b[0m"]
[78.103086, "o", "\u001b[37m Your\u001b[0m"]
[78.170759, "o", "\u001b[37m Python\u001b[0m"]
[78.189669, "o", "\u001b[37m 3.13 installation\u001b[0m"]
[78.20646, "o", "\u001b[37m is healthy\u001b[0m"]
[78.221168, "o", "\u001b[37m again and\u001b[0m"]
[78.251782, "o", "\u001b[37m pip install\u001b[0m"]
[78.307958, "o", "\u001b[37ms packages normally\u001b[0m"]
[78.330789, "o", "\u001b[37m.\u001b[0m\r\n\r\n"]
[78.35004, "o", "\u001b[34m##\u001b[0m\u001b[37m \u001b[0m\u001b[34mWhat was actually wrong\u001b[0m\r\n\r\n\u001b[37mThis\u001b[0m"]
[78.35106, "o", "\u001b[37m wasn't a path\u001b[0m"]
[78.382969, "o", "\u001b[37m,\u001b[0m"]
[78.407252, "o", "\u001b[37m permissions, or network\u001b[0m"]
[78.461801, "o", "\u001b[37m problem — it was \u001b[0m"]
[78.557683, "o", "\u001b[1;33m**\u001b[0m\u001b[1;33mpartial deletion of the pip package\u001b[0m\u001b[1;33m**\u001b[0m\u001b[37m.\u001b[0m"]
[78.57249, "o", "\r\n\r\n"]
[78.630021, "o", "\u001b[32m`\u001b[0m\u001b[32m/usr/local/lib/python3.13/site-packages/\u001b[0m\u001b[32m`\u001b[0m\u001b[37m contained:\u001b[0m\r\n\r\n"]
[78.630477, "o", "\u001b[37m```\u001b[0m"]
[78.652146, "o", "\r\n\u001b[37mpip-24\u001b[0m"]
[78.677166, "o", "\u001b[37m.3.1.dist\u001b[0m"]
[78.705408, "o", "\u001b[37m-info/\u001b[0m\u001b[37m   \u001b[0m"]
[78.714625, "o", "\u001b[37m ← metadata\u001b[0m"]
[78.750648, "o", "\u001b[37m:\u001b[0m"]
[78.815506, "o", "\u001b[37m present\u001b[0m\r\n\u001b[37mpip\u001b[0m"]
[78.850546, "o", "\u001b[37m/\u001b[0m\u001b[37m                    \u001b[0m"]
[78.888074, "o", "\u001b[37m ← actual\u001b[0m"]
[78.93321, "o", "\u001b[37m code: DEL\u001b[0m"]
[78.952044, "o", "\u001b[37mETED (all\u001b[0m"]
[78.979213, "o", "\u001b[37m 841 files gone\u001b[0m"]
[79.030544, "o", "\u001b[37m)\u001b[0m\r\n"]
[79.328852, "o", "\u001b[37m```\u001b[0m\r\n\r\n\u001b[37mThe `pip`, `pip3`, and `pip3.13` launcher scripts in `/usr/local/bin/` still existed and were valid — they just crashed on the import:\u001b[0m\r\n\r\n"]
[79.577175, "o", "\u001b[37m```\u001b[0m\r\n\u001b[37mFile \"/usr/local/bin/pip\", line 5, in <module>\u001b[0m\r\n\u001b[37m    from pip._internal.cli.main import main\u001b[0m\r\n\u001b[37mModuleNotFoundError: No module named 'pip'\u001b[0m\r\n"]
[79.577237, "o", "\u001b[37m```\u001b[0m\r\n\r\n"]
[79.603468, "o", "\u001b[1;33m**\u001b[0m\u001b[1;33mThe nasty part:\u001b[0m\u001b[1;33m**\u001b[0m\u001b[37m the leftover\u001b[0m"]
[79.671003, "o", "\u001b[37m `dist-info` made\u001b[0m"]
[79.699974, "o", "\u001b[37m Python believe pip\u001b[0m"]
[79.744706, "o", "\u001b[37m 24.3.1\u001b[0m"]
[79.75936, "o", "\u001b[37m was fully\u001b[0m"]
[79.777939, "o", "\u001b[37m installed.\u001b[0m"]
[79.858182, "o", "\u001b[37m So\u001b[0m"]
[79.86055, "o", "\u001b[37m the\u001b[0m"]
[79.885078, "o", "\u001b[37m obvious fix silently\u001b[0m"]
[79.907752, "o", "\u001b[37m did\u001b[0m"]
[79.976861, "o", "\u001b[37m nothing:\u001b[0m\r\n\r\n\u001b[37m```\u001b[0m"]
[80.019661, "o", "\r\n"]
[80.01998, "o", "\u001b[37m$ python\u001b[0m"]
[80.048045, "o", "\u001b[37m3 -m ensurepip --\u001b[0m"]
[80.069612, "o", "\u001b[37mupgrade --default-pip\u001b[0m"]
[80.120405, "o", "\r\n\u001b[37mRequirement already\u001b[0m"]
[80.188619, "o", "\u001b[37m satisfied: pip in\u001b[0m"]
[80.221401, "o", "\u001b[37m .../\u001b[0m"]
[80.246108, "o", "\u001b[37msite-packages (24.\u001b[0m"]
[80.31534, "o", "\u001b[37m3.1)\u001b[0m"]
[80.317598, "o", "\u001b[37m   ←\u001b[0m"]
[80.368717, "o", "\u001b[37m lied\u001b[0m"]
[80.402092, "o", "\u001b[37m, installed\u001b[0m"]
[80.428185, "o", "\u001b[37m nothing\u001b[0m\r\n"]
[83.41977, "o", "\u001b[37m```\u001b[0m\r\n\r\n\u001b[37mThis is why pip can be genuinely painful to repair — the \"already satisfied\" check reads metadata, not the actual files.\u001b[0m\r\n\r\n\u001b[37m## What I did\u001b[0m\r\n\r\n\u001b[37m1. **Confirmed the diagnosis** — verified all 841 files listed in `pip`'s `RECORD` were missing, and ruled out the usual suspects (no `PIP_*`/`PYTHONPATH` env vars, no `pip.conf`, no `EXTERNALLY-MANAGED` marker).\u001b[0m\r\n\u001b[37m2. **Backed up then removed the orphaned `dist-info`** so the \"already satisfied\" check could no longer misfire → `/tmp/pip-orphan-dist-info-backup.tar.gz`.\u001b[0m\r\n\u001b[37m3. **Reinstalled from the bundled wheel** with `python3 -m ensurepip --upgrade --default-pip` — this succeeded offline, no PyPI needed.\u001b[0m\r\n\r\n\u001b[37m## Verified\u001b[0m\r\n\r\n\u001b[37m| Check | Result |\u001b[0m\r\n\u001b[37m|---|---|\u001b[0m\r\n\u001b[37m| `python3 -m pip --version` | ✅ pip 24.3.1 (python 3.13) |\u001b[0m\r\n\u001b[37m| `pip` / `pip3` / `pip3.13` | ✅ all working |\u001b[0m\r\n\u001b[37m| `import pip` | ✅ |\u001b[0m\r\n\u001b[37m| Live install (`pip install six`) | ✅ installed + imported"]
[83.419801, "o", " |\u001b[0m\r\n\u001b[37m| `pip check` | ✅ No broken requirements |\u001b[0m\r\n\r\n\u001b[37mI uninstalled the `six` test package afterward, so you're back to a clean state.\u001b[0m\r\n\r\n\u001b[37m## Two things worth flagging\u001b[0m\r\n\r\n\u001b[37m**1. A separate `python3` also lacks pip.** `/usr/bin/python3` is Debian's **3.11.2**, not the same interpreter. It has no pip either, but it's intentionally minimal and flagged `EXTERNALLY-MANAGED` (PEP 668), so apt is meant to manage it:\u001b[0m\r\n\u001b[37m```\u001b[0m"]
[83.458261, "o", "\u001b[37mbash\u001b[0m\r\n\u001b[37mapt\u001b[0m"]
[83.487895, "o", "\u001b[37m-get\u001b[0m"]
[83.506962, "o", "\u001b[37m install -\u001b[0m"]
[83.613562, "o", "\u001b[37my python3-pip\u001b[0m"]
[83.662298, "o", "\r\n"]
[83.662379, "o", "\u001b[37m```\u001b[0m\r\n\u001b[37mIt's \u001b[0m"]
[83.68227, "o", "\u001b[35m*\u001b[0m\u001b[35mnot\u001b[0m\u001b[35m*\u001b[0m\u001b[37m the\u001b[0m"]
[83.690821, "o", "\u001b[37m default\u001b[0m"]
[83.70302, "o", "\u001b[37m `python3` in your\u001b[0m"]
[83.712353, "o", "\u001b[37m PATH (\u001b[0m"]
[83.775456, "o", "\u001b[32m`\u001b[0m\u001b[32m/usr/local/bin\u001b[0m\u001b[32m`\u001b[0m\u001b[37m wins\u001b[0m"]
[83.787541, "o", "\u001b[37m), so ignore\u001b[0m"]
[83.78865, "o", "\u001b[37m this unless something\u001b[0m"]
[83.863873, "o", "\u001b[37m specifically inv\u001b[0m"]
[83.902687, "o", "\u001b[37mokes \u001b[0m"]
[83.943538, "o", "\u001b[32m`\u001b[0m\u001b[32m/usr/bin/python3\u001b[0m\u001b[32m`\u001b[0m\u001b[37m.\u001b[0m\r\n\r\n"]
[84.027992, "o", "\u001b[1;33m**\u001b[0m\u001b[1;33m2. You're running pip as root into the system interpreter.\u001b[0m\u001b[1;33m**\u001b[0m\u001b[37m pip\u001b[0m"]
[84.068905, "o", "\u001b[37m now\u001b[0m"]
[84.096126, "o", "\u001b[37m prints\u001b[0m"]
[84.183673, "o", "\u001b[37m a warning about\u001b[0m"]
[84.217719, "o", "\u001b[37m exactly that, and it's\u001b[0m"]
[84.242906, "o", "\u001b[37m likely\u001b[0m"]
[84.254292, "o", "\u001b[37m how the files got\u001b[0m"]
[84.28126, "o", "\u001b[37m deleted in the first place\u001b[0m"]
[84.335907, "o", "\u001b[37m — a stale/\u001b[0m"]
[84.34309, "o", "\u001b[37mab\u001b[0m"]
[84.387513, "o", "\u001b[37morted install or\u001b[0m"]
[84.399152, "o", "\u001b[37m an over\u001b[0m"]
[84.424714, "o", "\u001b[37mzealous cleanup\u001b[0m"]
[84.484231, "o", "\u001b[37m. For real\u001b[0m"]
[84.521615, "o", "\u001b[37m work, use a venv\u001b[0m"]
[84.521916, "o", "\u001b[37m to\u001b[0m"]
[84.58093, "o", "\u001b[37m avoid\u001b[0m"]
[84.594435, "o", "\u001b[37m re\u001b[0m"]
[84.618564, "o", "\u001b[37m-breaking\u001b[0m"]
[84.638903, "o", "\u001b[37m the system Python\u001b[0m"]
[84.67724, "o", "\u001b[37m:\u001b[0m\r\n"]
[84.792247, "o", "\u001b[37m```\u001b[0m\u001b[38;5;9mbash\u001b[0m\r\n"]
[84.793568, "o", "\u001b[37mpython3\u001b[0m\u001b[37m -\u001b[0m\u001b[37mm\u001b[0m\u001b[37m venv /app/.venv\u001b[0m\u001b[37m \u001b[0m\u001b[37m&&\u001b[0m\u001b[37m \u001b[0m\u001b[36msource\u001b[0m\u001b[37m /app/.venv/bin/activate\u001b[0m\r\n\u001b[37m```\u001b[0m"]
[84.820676, "o", "\r\n"]
