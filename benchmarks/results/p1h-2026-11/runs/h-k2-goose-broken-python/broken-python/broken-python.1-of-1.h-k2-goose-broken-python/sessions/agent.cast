[16.857292, "o", "    \u001b[2mcommand\u001b[0m: \u001b[32mwhich -a python3 python pip pip3 2>&1; echo \"---\"; python3 --version 2>&1; echo \"---\"; python3 -m pip --version 2>&1\u001b[0m\r\n\r\n\r\n  \u001b[2m────────────────────────────────────────\u001b[0m\r\n  \u001b[2m▸\u001b[0m \u001b[2mshell\u001b[0m\r\n    \u001b[2mcommand\u001b[0m: \u001b[32mecho \"== OS ==\"; cat /etc/os-release 2>&1 | head -20; echo \"== USER ==\"; id; echo \"== CWD ==\"; pwd; ls -la\u001b[0m\r\n\r\n"]
[16.904269, "o", "    \u001b[2m== OS ==\u001b[0m\r\n    \u001b[2mPRETTY_NAME=\"Debian GNU/Linux 12 (bookworm)\"\u001b[0m\r\n    \u001b[2mNAME=\"Debian GNU/Linux\"\u001b[0m\r\n    \u001b[2mVERSION_ID=\"12\"\u001b[0m\r\n    \u001b[2mVERSION=\"12 (bookworm)\"\u001b[0m\r\n    \u001b[2mVERSION_CODENAME=bookworm\u001b[0m\r\n    \u001b[2mID=debian\u001b[0m\r\n    \u001b[2mHOME_URL=\"https://www.debian.org/\"\u001b[0m\r\n    \u001b[2mSUPPORT_URL=\"https://www.debian.org/support\"\u001b[0m\r\n    \u001b[2mBUG_REPORT_URL=\"https://bugs.debian.org/\"\u001b[0m\r\n    \u001b[2m== USER ==\u001b[0m\r\n    \u001b[2muid=0(root) gid=0(root) groups=0(root)\u001b[0m\r\n    \u001b[2m== CWD ==\u001b[0m\r\n    \u001b[2m/app\u001b[0m\r\n    \u001b[2mtotal 8\u001b[0m\r\n    \u001b[2mdrwxr-xr-x 1 root root 4096 Nov  1 06:53 .\u001b[0m\r\n    \u001b[2mdrwxr-xr-x 1 root root 4096 Nov  1 06:53 ..\u001b[0m\r\n    \u001b[2m/usr/local/bin/python3\u001b[0m\r\n    \u001b[2m/usr/bin/python3\u001b[0m\r\n    \u001b[2m/bin/python3\u001b[0m\r\n    \u001b[2m/usr/local/bin/python\u001b[0m\r\n    \u001b[2m/usr/local/bin/pip\u001b[0m\r\n    \u001b[2m/usr/local/bin/pip3\u001b[0m\r\n    \u001b[2m---\u001b[0m\r\n    \u001b[2mPython 3.13.1\u001b[0m\r\n    \u001b[2m---\u001b[0m\r\n    \u001b[2m/usr/local/bin/python3: No module named pip\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2mCommand exited with code 1\u001b[0m\r\n"]
