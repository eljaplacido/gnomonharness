[23.279249, "o", "\u001b[0m$ \u001b[0mcd /app && jq --indent 2 '. | map(select(.status == \"active\") | {user_id: .id, username: .username, email: .email, last_login: (.last_login | .[0:10]), role_count: (.roles | length), primary_role: (if (.roles | length) > 0 then .roles[0] else null end)}) | sort_by(.username)' /app/users.json > /app/active_users_report.json && jq 'length' /app/active_users_report.json && head -30 /app/active_users_report.json && jq '[.[] | select(.primary_role == null)] | length' /app/active_users_report.json\r\n346\r\n[\r\n  {\r\n    \"user_id\": 443,\r\n    \"username\": \"acosta\",\r\n    \"email\": \"ybell@yahoo.com\",\r\n    \"last_login\": \"2026-04-05\",\r\n    \"role_count\": 1,\r\n    \"primary_role\": \"admin\"\r\n  },\r\n  {\r\n    \"user_id\": 273,\r\n    \"username\": \"alexisrogers\",\r\n    \"email\": \"gregorychase@yahoo.com\",\r\n    \"last_login\": \"2026-04-06\",\r\n    \"role_count\": 1,\r\n    \"primary_role\": \"user\"\r\n  },\r\n  {\r\n    \"user_id\": 292,\r\n    \"username\": \"allencarlos\",\r\n    \"email\": \"griffinemily@hotmail.com\",\r\n    \"last_login\": \"2026-04-09\",\r\n    \"role_c"]
