[12.838284, "o", "> "]
[12.838349, "o", "The input JSON file '\"'\"'/app/users.json'\"'\"' is an array of user objects with the following structure:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[12.838364, "o", "[\r\n\u001b[?2004l\r\u001b[?2004h> "]
[12.838402, "o", "  {\r\n\u001b[?2004l\r"]
[12.838461, "o", "\u001b[?2004h> "]
[12.838496, "o", "    \"id\": 1,                  # Unique numeric identifier for the user\r\n\u001b[?2004l\r\u001b[?2004h> "]
[12.83854, "o", "    \"username\": \"john_doe\",   # User'\"'\"'s unique username (string)\r\n\u001b[?2004l\r"]
[12.838586, "o", "\u001b[?2004h>     \"email\": \"john@example.com\",  # User'\"'\"'s email address (string)\r\n\u001b[?2004l\r"]
[12.838608, "o", "\u001b[?2004h> "]
[12.838688, "o", "    \"status\": \"active\",       # User status: '\"'\"'active'\"'\"' or '\"'\"'inactive'\"'\"'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[12.838773, "o", "    \"last_login\": \"2024-10-02T20:59:10.109812Z\",  # ISO 8601 timestamp (UTC) of the last login\r\n\u001b[?2004l\r\u001b[?2004h> "]
[12.838851, "o", "    \"roles\": [\"admin\", \"editor\"]  # Array of roles assigned to the user (may be empty)\r\n\u001b[?2004l\r\u001b[?2004h"]
[12.83888, "o", ">   },\r\n\u001b[?2004l\r"]
[12.838924, "o", "\u001b[?2004h>   ...\r\n\u001b[?2004l\r\u001b[?2004h> ]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
