[16.280407, "o", "   - Owned by group \"research\" \r\n\u001b[?2004l\r\u001b[?2004h>    - Set the setgid bit so new files inherit the group\r\n\u001b[?2004l\r\u001b[?2004h> "]
[16.280459, "o", "   - Base permissions: 2770 (rwxrws---)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[16.280508, "o", "\u001b[?2004h> 2. Configure ACLs on /srv/shared:\r\n\u001b[?2004l\r"]
[16.280545, "o", "\u001b[?2004h> "]
[16.280586, "o", "   - Group \"research\": full rwx permissions (both current and default)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[16.280672, "o", "   - Users \"alice\" and \"bob\": full rwx permissions (both current and default)  \r\n\u001b[?2004l\r\u001b[?2004h"]
[16.280752, "o", ">    - Others: no permissions (both current and default)\r\n\u001b[?2004l\r"]
[16.280812, "o", "\u001b[?2004h> "]
[16.280851, "o", "   - Set proper mask to allow full permissions\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[16.281, "o", "3. The ACL configuration must ensure that:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[16.281052, "o", "   - Any file created by alice or bob in /srv/shared is accessible by both users\r\n\u001b[?2004l\r\u001b[?2004h> "]
[16.281112, "o", "   - The permissions are inherited by subdirectories and files\r\n\u001b[?2004l\r\u001b[?2004h> "]
[16.281161, "o", "   - Users outside the research group cannot access the directory or its contents\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
