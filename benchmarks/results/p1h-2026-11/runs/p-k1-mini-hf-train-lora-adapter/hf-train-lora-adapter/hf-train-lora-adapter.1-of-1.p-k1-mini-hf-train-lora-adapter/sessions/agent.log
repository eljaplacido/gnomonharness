from transformers import AutoTokenizer
import json
tok=AutoTokenizer.from_pretrained('openai-community/gpt2')
for split in ['train','val']:
 d=json.load(open(f'/app/data/{split}.json'))
 lens=[]
 for x in d:
  p='Question: '+x['question']+'\n'+'\n'.join(x['options'])+'\nAnswer: '+x['answer']
  lens.append(len(tok(p, add_special_tokens=False)['input_ids']))
 print(split, max(lens), sum(lens)/len(lens), sum(l>256 for l in lens), sum(l>192 for l in lens))
EOF
