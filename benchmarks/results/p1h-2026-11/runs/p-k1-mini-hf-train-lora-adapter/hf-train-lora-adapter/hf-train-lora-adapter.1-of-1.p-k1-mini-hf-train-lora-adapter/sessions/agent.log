mkdir -p /app/experiments && cat > /app/train_lora.py <<'EOF'
#!/usr/bin/env python3
"""
LoRA fine-tuning of GPT-2 for biomedical multiple-choice question answering.

The model is trained as a causal language model to emit the correct answer
letter (A/B/C/D) after a standardized multiple-choice prompt.  The LoRA
adapter is saved in PEFT format so it can be loaded with
`PeftModel.from_pretrained(base_model, adapter_dir)`.
"""

import json
import math
import os
import random
import time
from dataclasses import dataclass
from typing import Dict, List

import torch
from torch.utils.data import Dataset, DataLoader
from transformers import AutoModelForCausalLM, AutoTokenizer, get_cosine_schedule_with_warmup
from peft import LoraConfig, get_peft_model, TaskType

MODEL_NAME = "openai-community/gpt2"
TRAIN_PATH = "/app/data/train.json"
VAL_PATH = "/app/data/val.json"
OUTPUT_DIR = "/app/experiments/lora_adapter"
RESULTS_PATH = "/app/lora_results.json"

# Required LoRA hyperparameters
LORA_R = 8
LORA_ALPHA = 16
LORA_DROPOUT = 0.05
TARGET_MODULES = ["c_attn"]

# Training hyperparameters
NUM_EPOCHS = 12
BATCH_SIZE = 8
LEARNING_RATE = 5e-4
WEIGHT_DECAY = 0.01
MAX_LENGTH = 256
SEED = 42

ANSWER_TOKEN_IDS = None  # populated after tokenizer is loaded


def build_prompt(example: Dict) -> str:
    """Build the multiple-choice prompt.  Training uses exactly this format."""
    options = "\n".join(example["options"])
    return (
        f"Question: {example['question']}\n"
        f"Options:\n{options}\n"
        f"Answer:"
    )


def set_seed(seed: int) -> None:
    random.seed(seed)
    torch.manual_seed(seed)
    if torch.cuda.is_available():
        torch.cuda.manual_seed_all(seed)


class MCQADataset(Dataset):
    def __init__(self, examples: List[Dict], tokenizer, max_length: int = MAX_LENGTH):
        self.rows = []
        self.tokenizer = tokenizer
        self.max_length = max_length
        self.pad_token_id = tokenizer.pad_token_id

        for ex in examples:
            prompt = build_prompt(ex)
            prompt_ids = tokenizer(prompt, add_special_tokens=False)["input_ids"]
            # Leading-space token for the answer letter is a single GPT-2 token.
            answer_ids = tokenizer(" " + ex["answer"].strip().upper(), add_special_tokens=False)["input_ids"]
            if not answer_ids:
                raise ValueError(f"Could not tokenize answer for example: {ex}")

            # Keep the answer and the end of the prompt if truncation is needed.
            if len(prompt_ids) + len(answer_ids) > max_length:
                prompt_ids = prompt_ids[-(max_length - len(answer_ids)):]
            input_ids = prompt_ids + answer_ids
            labels = [-100] * len(prompt_ids) + list(answer_ids)
            self.rows.append(
                {
                    "input_ids": input_ids,
                    "labels": labels,
                    "prompt_len": len(prompt_ids),
                    "answer": ex["answer"].strip().upper(),
                }
            )

    def __len__(self):
        return len(self.rows)

    def __getitem__(self, idx):
        return self.rows[idx]


@dataclass
class Collator:
    pad_token_id: int

    def __call__(self, features):
        max_len = max(len(f["input_ids"]) for f in features)
        input_ids, labels, attn = [], [], []
        for f in features:
            n_pad = max_len - len(f["input_ids"])
            input_ids.append(f["input_ids"] + [self.pad_token_id] * n_pad)
            labels.append(f["labels"] + [-100] * n_pad)
            attn.append([1] * len(f["input_ids"]) + [0] * n_pad)
        return {
            "input_ids": torch.tensor(input_ids, dtype=torch.long),
            "labels": torch.tensor(labels, dtype=torch.long),
            "attention_mask": torch.tensor(attn, dtype=torch.long),
        }


@torch.no_grad()
def evaluate(model, tokenizer, examples, device):
    """Return (accuracy, predictions) by scoring the four answer tokens."""
    model.eval()
    correct = 0
    predictions = []
    for ex in examples:
        prompt = build_prompt(ex)
        ids = tokenizer(prompt, add_special_tokens=False, return_tensors="pt").to(device)
        logits = model(**ids).logits[0, -1, :]
        option_logits = torch.tensor([logits[t] for t in ANSWER_TOKEN_IDS], device=device)
        pred_idx = int(torch.argmax(option_logits).item())
        pred = "ABCD"[pred_idx]
        predictions.append(pred)
        correct += int(pred == ex["answer"].strip().upper())
    return correct / max(1, len(examples)), predictions


def main():
    global ANSWER_TOKEN_IDS
    set_seed(SEED)
    torch.set_num_threads(min(16, os.cpu_count() or 4))

    with open(TRAIN_PATH, "r", encoding="utf-8") as f:
        train_examples = json.load(f)
    with open(VAL_PATH, "r", encoding="utf-8") as f:
        val_examples = json.load(f)

    print(f"Loaded {len(train_examples)} training and {len(val_examples)} validation samples.")

    tokenizer = AutoTokenizer.from_pretrained(MODEL_NAME)
    if tokenizer.pad_token is None:
        tokenizer.pad_token = tokenizer.eos_token
    tokenizer.padding_side = "right"

    ANSWER_TOKEN_IDS = [
        tokenizer(" " + letter, add_special_tokens=False)["input_ids"][0]
        for letter in "ABCD"
    ]
    print("Answer token ids:", dict(zip("ABCD", ANSWER_TOKEN_IDS)))

    model = AutoModelForCausalLM.from_pretrained(MODEL_NAME)
    model.config.pad_token_id = tokenizer.pad_token_id

    lora_config = LoraConfig(
        r=LORA_R,
        lora_alpha=LORA_ALPHA,
        target_modules=TARGET_MODULES,
        lora_dropout=LORA_DROPOUT,
        bias="none",
        task_type=TaskType.CAUSAL_LM,
+        inference_mode=False,
    )
    model = get_peft_model(model, lora_config)
    model.print_trainable_parameters()
    model.to("cpu")

    train_ds = MCQADataset(train_examples, tokenizer, MAX_LENGTH)
    train_loader = DataLoader(
        train_ds,
        batch_size=BATCH_SIZE,
        shuffle=True,
        collate_fn=Collator(tokenizer.pad_token_id),
        num_workers=0,
    )

    optimizer = torch.optim.AdamW(
        [p for p in model.parameters() if p.requires_grad],
        lr=LEARNING_RATE,
        weight_decay=WEIGHT_DECAY,
    )
    total_steps = max(1, len(train_loader) * NUM_EPOCHS)
    warmup_steps = max(1, int(0.05 * total_steps))
    scheduler = get_cosine_schedule_with_warmup(optimizer, warmup_steps, total_steps)

    best_val = -1.0
    best_state = None
    for epoch in range(1, NUM_EPOCHS + 1):
        model.train()
        running_loss = 0.0
        start = time.time()
        for batch in train_loader:
            batch = {k: v.to("cpu") for k, v in batch.items()}
            optimizer.zero_grad(set_to_none=True)
            out = model(**batch)
            loss = out.loss
            loss.backward()
            torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)
            optimizer.step()
            scheduler.step()
            running_loss += loss.item()
        avg_loss = running_loss / max(1, len(train_loader))
        val_acc, _ = evaluate(model, tokenizer, val_examples, "cpu")
        elapsed = time.time() - start
        print(
            f"Epoch {epoch}/{NUM_EPOCHS} | loss={avg_loss:.4f} | "
            f"val_acc={val_acc:.4f} | {elapsed:.1f}s"
        )
        if val_acc > best_val:
            best_val = val_acc
            best_state = {
                k: v.detach().clone() for k, v in model.state_dict().items()
                if "lora_" in k
            }

    if best_state is not None:
        model.load_state_dict(best_state, strict=False)
    final_val_acc, preds = evaluate(model, tokenizer, val_examples, "cpu")
    print(f"Best validation accuracy: {best_val:.4f}; restored-model val accuracy: {final_val_acc:.4f}")

    os.makedirs(OUTPUT_DIR, exist_ok=True)
    model.save_pretrained(OUTPUT_DIR, safe_serialization=True)
    tokenizer.save_pretrained(OUTPUT_DIR)
    # Some tooling expects an explicit tokenizer_config.json (saved above); verify.
    assert os.path.exists(os.path.join(OUTPUT_DIR, "adapter_config.json"))
    assert os.path.exists(os.path.join(OUTPUT_DIR, "adapter_model.safetensors"))
    assert os.path.exists(os.path.join(OUTPUT_DIR, "tokenizer_config.json"))

    results = {
        "model": MODEL_NAME,
        "lora_config": {
            "r": LORA_R,
            "alpha": LORA_ALPHA,
            "epochs": NUM_EPOCHS,
        },
        "training_samples": len(train_examples),
        "validation_samples": len(val_examples),
    }
    with open(RESULTS_PATH, "w", encoding="utf-8") as f:
        json.dump(results, f, indent=2)
    print("Saved adapter to", OUTPUT_DIR)
    print("Saved results to", RESULTS_PATH)
    print(json.dumps(results, indent=2))


if __name__ == "__main__":
    main()
