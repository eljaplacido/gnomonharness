[206.348811, "o", "\r\u001b[2K```\r\ncd /app && python - <<'EOF'\r\nfrom transformers import AutoTokenizer\r\nimport json\r\ntok=AutoTokenizer.from_pretrained('openai-community/gpt2')\r\nfor split in ['train','val']:\r\n d=json.load(open(f'/app/data/{split}.json'))\r\n lens=[]\r\n for x in d:\r\n  p='Question: '+x['question']+'\\n'+'\\n'.join(x['options'])+'\\nAnswer: '+x['answer']\r\n  lens.append(len(tok(p, add_special_tokens=False)['input_ids']))\r\n print(split, max(lens), sum(lens)/len(lens), sum(l>256 for l in lens), sum(l>192 for l in lens))\r\nEOF\r\n```\r\n\u001b[32m⠏\u001b[0m Waiting for the LM to respond..."]
[206.349328, "o", "\r\u001b[2K\u001b[32m⠏\u001b[0m Waiting for the LM to respond...\r\n\u001b[?25h\r\u001b[1A\u001b[2K"]
