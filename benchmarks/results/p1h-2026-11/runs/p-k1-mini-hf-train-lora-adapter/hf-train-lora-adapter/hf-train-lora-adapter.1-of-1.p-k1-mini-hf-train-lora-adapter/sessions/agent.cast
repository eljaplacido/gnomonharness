[241.914147, "o", "\r\u001b[2K\r\n\u001b[1;31mmini-swe-agent\u001b[0m\u001b[31m (step \u001b[0m\u001b[1;31m15\u001b[0m\u001b[31m, \u001b[0m\u001b[1;31m$0.00\u001b[0m\u001b[31m):\u001b[0m\r\n\u001b[32m⠏\u001b[0m Waiting for the LM to respond..."]
[241.920895, "o", "\r\u001b[2KNow I'll create the LoRA training script with answer-only supervision and validation using answer-token likelihood.\r\n\r\n```\r\nmkdir -p /app/experiments && cat > /app/train_lora.py <<'EOF'\r\n#!/usr/bin/env python3\r\n\"\"\"\r\nLoRA fine-tuning of GPT-2 for biomedical multiple-choice question answering.\r\n\r\nThe model is trained as a causal language model to emit the correct answer\r\nletter (A/B/C/D) after a standardized multiple-choice prompt.  The LoRA\r\nadapter is saved in PEFT format so it can be loaded with\r\n`PeftModel.from_pretrained(base_model, adapter_dir)`.\r\n\"\"\"\r\n\r\nimport json\r\nimport math\r\nimport os\r\nimport random\r\nimport time\r\nfrom dataclasses import dataclass\r\nfrom typing import Dict, List\r\n\r\nimport torch\r\nfrom torch.utils.data import Dataset, DataLoader\r\nfrom transformers import AutoModelForCausalLM, AutoTokenizer, get_cosine_schedule_with_warmup\r\nfrom peft import LoraConfig, get_peft_model, TaskType\r\n\r\nMODEL_NAME = \"openai-community/gpt2\"\r\nTRAIN_PATH = \"/app/data/train.json\"\r\nVAL_PATH = \"/app/data/val.json"]
[241.920924, "o", "\"\r\nOUTPUT_DIR = \"/app/experiments/lora_adapter\"\r\nRESULTS_PATH = \"/app/lora_results.json\"\r\n\r\n# Required LoRA hyperparameters\r\nLORA_R = 8\r\nLORA_ALPHA = 16\r\nLORA_DROPOUT = 0.05\r\nTARGET_MODULES = [\"c_attn\"]\r\n\r\n# Training hyperparameters\r\nNUM_EPOCHS = 12\r\nBATCH_SIZE = 8\r\nLEARNING_RATE = 5e-4\r\nWEIGHT_DECAY = 0.01\r\nMAX_LENGTH = 256\r\nSEED = 42\r\n\r\nANSWER_TOKEN_IDS = None  # populated after tokenizer is loaded\r\n\r\n\r\ndef build_prompt(example: Dict) -> str:\r\n    \"\"\"Build the multiple-choice prompt.  Training uses exactly this format.\"\"\"\r\n    options = \"\\n\".join(example[\"options\"])\r\n    return (\r\n        f\"Question: {example['question']}\\n\"\r\n        f\"Options:\\n{options}\\n\"\r\n        f\"Answer:\"\r\n    )\r\n\r\n\r\ndef set_seed(seed: int) -> None:\r\n    random.seed(seed)\r\n    torch.manual_seed(seed)\r\n    if torch.cuda.is_available():\r\n        torch.cuda.manual_seed_all(seed)\r\n\r\n\r\nclass MCQADataset(Dataset):\r\n    def __init__(self, examples: List[Dict], tokenizer, max_length: int = MAX_LENGTH):\r\n        self.rows = []\r\n        self.to"]
[241.920929, "o", "kenizer = tokenizer\r\n        self.max_length = max_length\r\n        self.pad_token_id = tokenizer.pad_token_id\r\n\r\n        for ex in examples:\r\n            prompt = build_prompt(ex)\r\n            prompt_ids = tokenizer(prompt, add_special_tokens=False)[\"input_ids\"]\r\n            # Leading-space token for the answer letter is a single GPT-2 token.\r\n            answer_ids = tokenizer(\" \" + ex[\"answer\"].strip().upper(), add_special_tokens=False)[\"input_ids\"]\r\n            if not answer_ids:\r\n                raise ValueError(f\"Could not tokenize answer for example: {ex}\")\r\n\r\n            # Keep the answer and the end of the prompt if truncation is needed.\r\n            if len(prompt_ids) + len(answer_ids) > max_length:\r\n                prompt_ids = prompt_ids[-(max_length - len(answer_ids)):]\r\n            input_ids = prompt_ids + answer_ids\r\n            labels = [-100] * len(prompt_ids) + list(answer_ids)\r\n            self.rows.append(\r\n                {\r\n                    \"input_ids\": input_ids,\r\n                    "]
[241.920944, "o", "\"labels\": labels,\r\n                    \"prompt_len\": len(prompt_ids),\r\n                    \"answer\": ex[\"answer\"].strip().upper(),\r\n                }\r\n            )\r\n\r\n    def __len__(self):\r\n        return len(self.rows)\r\n\r\n    def __getitem__(self, idx):\r\n        return self.rows[idx]\r\n\r\n\r\n@dataclass\r\nclass Collator:\r\n    pad_token_id: int\r\n\r\n    def __call__(self, features):\r\n        max_len = max(len(f[\"input_ids\"]) for f in features)\r\n        input_ids, labels, attn = [], [], []\r\n        for f in features:\r\n            n_pad = max_len - len(f[\"input_ids\"])\r\n            input_ids.append(f[\"input_ids\"] + [self.pad_token_id] * n_pad)\r\n            labels.append(f[\"labels\"] + [-100] * n_pad)\r\n            attn.append([1] * len(f[\"input_ids\"]) + [0] * n_pad)\r\n        return {\r\n            \"input_ids\": torch.tensor(input_ids, dtype=torch.long),\r\n            \"labels\": torch.tensor(labels, dtype=torch.long),\r\n            \"attention_mask\": torch.tensor(attn, dtype=torch.long),\r\n        }\r\n\r\n\r\n@torch.no_grad()\r\ndef"]
[241.920984, "o", " evaluate(model, tokenizer, examples, device):\r\n    \"\"\"Return (accuracy, predictions) by scoring the four answer tokens.\"\"\"\r\n    model.eval()\r\n    correct = 0\r\n    predictions = []\r\n    for ex in examples:\r\n        prompt = build_prompt(ex)\r\n        ids = tokenizer(prompt, add_special_tokens=False, return_tensors=\"pt\").to(device)\r\n        logits = model(**ids).logits[0, -1, :]\r\n        option_logits = torch.tensor([logits[t] for t in ANSWER_TOKEN_IDS], device=device)\r\n        pred_idx = int(torch.argmax(option_logits).item())\r\n        pred = \"ABCD\"[pred_idx]\r\n        predictions.append(pred)\r\n        correct += int(pred == ex[\"answer\"].strip().upper())\r\n    return correct / max(1, len(examples)), predictions\r\n\r\n\r\ndef main():\r\n    global ANSWER_TOKEN_IDS\r\n    set_seed(SEED)\r\n    torch.set_num_threads(min(16, os.cpu_count() or 4))\r\n\r\n    with open(TRAIN_PATH, \"r\", encoding=\"utf-8\") as f:\r\n        train_examples = json.load(f)\r\n    with open(VAL_PATH, \"r\", encoding=\"utf-8\") as f:\r\n        val_examples = json.loa"]
[241.920987, "o", "d(f)\r\n\r\n    print(f\"Loaded {len(train_examples)} training and {len(val_examples)} validation samples.\")\r\n\r\n    tokenizer = AutoTokenizer.from_pretrained(MODEL_NAME)\r\n    if tokenizer.pad_token is None:\r\n        tokenizer.pad_token = tokenizer.eos_token\r\n    tokenizer.padding_side = \"right\"\r\n\r\n    ANSWER_TOKEN_IDS = [\r\n        tokenizer(\" \" + letter, add_special_tokens=False)[\"input_ids\"][0]\r\n        for letter in \"ABCD\"\r\n    ]\r\n    print(\"Answer token ids:\", dict(zip(\"ABCD\", ANSWER_TOKEN_IDS)))\r\n\r\n    model = AutoModelForCausalLM.from_pretrained(MODEL_NAME)\r\n    model.config.pad_token_id = tokenizer.pad_token_id\r\n\r\n    lora_config = LoraConfig(\r\n        r=LORA_R,\r\n        lora_alpha=LORA_ALPHA,\r\n        target_modules=TARGET_MODULES,\r\n        lora_dropout=LORA_DROPOUT,\r\n        bias=\"none\",\r\n        task_type=TaskType.CAUSAL_LM,\r\n+        inference_mode=False,\r\n    )\r\n    model = get_peft_model(model, lora_config)\r\n    model.print_trainable_parameters()\r\n    model.to(\"cpu\")\r\n\r\n    train_ds = MCQADataset(train"]
[241.92099, "o", "_examples, tokenizer, MAX_LENGTH)\r\n    train_loader = DataLoader(\r\n        train_ds,\r\n        batch_size=BATCH_SIZE,\r\n        shuffle=True,\r\n        collate_fn=Collator(tokenizer.pad_token_id),\r\n        num_workers=0,\r\n    )\r\n\r\n    optimizer = torch.optim.AdamW(\r\n        [p for p in model.parameters() if p.requires_grad],\r\n        lr=LEARNING_RATE,\r\n        weight_decay=WEIGHT_DECAY,\r\n    )\r\n    total_steps = max(1, len(train_loader) * NUM_EPOCHS)\r\n    warmup_steps = max(1, int(0.05 * total_steps))\r\n    scheduler = get_cosine_schedule_with_warmup(optimizer, warmup_steps, total_steps)\r\n\r\n    best_val = -1.0\r\n    best_state = None\r\n    for epoch in range(1, NUM_EPOCHS + 1):\r\n        model.train()\r\n        running_loss = 0.0\r\n        start = time.time()\r\n        for batch in train_loader:\r\n            batch = {k: v.to(\"cpu\") for k, v in batch.items()}\r\n            optimizer.zero_grad(set_to_none=True)\r\n            out = model(**batch)\r\n            loss = out.loss\r\n            loss.backward()\r\n            torch.n"]
[241.920994, "o", "n.utils.clip_grad_norm_(model.parameters(), 1.0)\r\n            optimizer.step()\r\n            scheduler.step()\r\n            running_loss += loss.item()\r\n        avg_loss = running_loss / max(1, len(train_loader))\r\n        val_acc, _ = evaluate(model, tokenizer, val_examples, \"cpu\")\r\n        elapsed = time.time() - start\r\n        print(\r\n            f\"Epoch {epoch}/{NUM_EPOCHS} | loss={avg_loss:.4f} | \"\r\n            f\"val_acc={val_acc:.4f} | {elapsed:.1f}s\"\r\n        )\r\n        if val_acc > best_val:\r\n            best_val = val_acc\r\n            best_state = {\r\n                k: v.detach().clone() for k, v in model.state_dict().items()\r\n                if \"lora_\" in k\r\n            }\r\n\r\n    if best_state is not None:\r\n        model.load_state_dict(best_state, strict=False)\r\n    final_val_acc, preds = evaluate(model, tokenizer, val_examples, \"cpu\")\r\n    print(f\"Best validation accuracy: {best_val:.4f}; restored-model val accuracy: {final_val_acc:.4f}\")\r\n\r\n    os.makedirs(OUTPUT_DIR, exist_ok=True)\r\n    model.save_"]
[241.921003, "o", "pretrained(OUTPUT_DIR, safe_serialization=True)\r\n    tokenizer.save_pretrained(OUTPUT_DIR)\r\n    # Some tooling expects an explicit tokenizer_config.json (saved above); verify.\r\n    assert os.path.exists(os.path.join(OUTPUT_DIR, \"adapter_config.json\"))\r\n    assert os.path.exists(os.path.join(OUTPUT_DIR, \"adapter_model.safetensors\"))\r\n    assert os.path.exists(os.path.join(OUTPUT_DIR, \"tokenizer_config.json\"))\r\n\r\n    results = {\r\n        \"model\": MODEL_NAME,\r\n        \"lora_config\": {\r\n            \"r\": LORA_R,\r\n            \"alpha\": LORA_ALPHA,\r\n            \"epochs\": NUM_EPOCHS,\r\n        },\r\n        \"training_samples\": len(train_examples),\r\n        \"validation_samples\": len(val_examples),\r\n    }\r\n    with open(RESULTS_PATH, \"w\", encoding=\"utf-8\") as f:\r\n        json.dump(results, f, indent=2)\r\n    print(\"Saved adapter to\", OUTPUT_DIR)\r\n    print(\"Saved results to\", RESULTS_PATH)\r\n    print(json.dumps(results, indent=2))\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\nEOF\r\npython -m py_compile /app/train_lora.py && e"]
