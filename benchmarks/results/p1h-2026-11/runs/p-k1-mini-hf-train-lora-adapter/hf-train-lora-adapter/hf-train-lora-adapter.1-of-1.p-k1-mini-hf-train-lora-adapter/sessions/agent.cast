[882.643545, "o", "<returncode>\r\n0\r\n<output>\r\npatched\r\n41:NUM_EPOCHS = 12\r\n43:LEARNING_RATE = 1e-3\r\n104:        position_ids = attention_mask_t.long().cumsum(-1) - 1\r\n105:        position_ids.masked_fill_(attention_mask_t == 0, 0)\r\n109:            \"position_ids\": position_ids,\r\n194:                position_ids=batch[\"position_ids\"],\r\n\r\n"]
