[101.801894, "o", "\u001b[0m$ \u001b[0mcd /tmp/klee && for t in v3.0 v3.1 v3.2; do echo \"== $t\"; git show $t:.github/workflows/build.yaml 2>/dev/null | grep -i 'llvm' | head -20; git show $t:.github/workflows/ci.yaml 2>/dev/null | grep -i 'llvm' | head -20; done\r\n== v3.0\r\n  LLVM_VERSION: 11\r\n          \"LLVM 14\",\r\n          \"LLVM 13\",\r\n          \"LLVM 12\",\r\n          \"LLVM 11, Doxygen\",\r\n          \"LLVM 10\",\r\n          \"LLVM 9\",\r\n          - name: \"LLVM 14\"\r\n              LLVM_VERSION: 14\r\n          - name: \"LLVM 13\"\r\n              LLVM_VERSION: 13\r\n          - name: \"LLVM 12\"\r\n              LLVM_VERSION: 12\r\n          - name: \"LLVM 11, Doxygen\"\r\n              LLVM_VERSION: 11\r\n          - name: \"LLVM 10\"\r\n              LLVM_VERSION: 10\r\n          - name: \"LLVM 9\"\r\n              LLVM_VERSION: 9\r\n              SANITIZER_LLVM_VERSION: 12\r\n== v3.1\r\n  LLVM_VERSION: 11\r\n          \"LLVM 16\",\r\n          \"LLVM 15\",\r\n          \"LLVM 14\",\r\n          \"LLVM 13\",\r\n          \"LLVM 12\",\r\n          \"LLVM 11, Doxygen\",\r\n          - name: \"LLVM 16\"\r\n              LLVM_VERSION: 16\r\n          - name: \"LLVM 15\"\r\n              LLVM_VERSION: 15\r\n          - name: \"LLVM 14\"\r\n              LLVM_VERSION: 14\r\n          - name: \"LLVM 13\"\r\n              LLVM_VERSION: 13\r\n          - name: \"LLVM 12\"\r\n              LLVM_VERSION: 12\r\n          - name: \"LLVM 11, Doxygen\"\r\n              LLVM_VERSION: 11\r\n              SANITIZER_LLVM_VERSION: 12\r\n== v3.2\r\n  LLVM_VERSION: 13\r\n          \"LLVM 16\",\r\n          \"LLVM 15\",\r\n          \"LLVM 14\",\r\n          \"LLVM 13, Doxygen\",\r\n          - name: \"LLVM 16\"\r\n              LLVM_VERSION: 16\r\n          - name: \"LLVM 15\"\r\n              LLVM_VERSION: 15\r\n          - name: \"LLVM 14\"\r\n              LLVM_VERSION: 14\r\n          - name: \"LLVM 13, Doxygen\"\r\n              LLVM_VERSION: 13\r\n              SANITIZER_LLVM_VERSION: 13\r\n              SANITIZER_LLVM_VERSION: 13\r\n      LLVM_VERSION: 14\r\n"]
