[74.802914, "o", "\u001b[0m$ \u001b[0mcd /tmp/minisat && grep -n -i 'static\\|BUILD_SHARED\\|add_library' CMakeLists.txt | head -30; grep -n -i 'Minisat_USE_STATIC_LIBS\\|STATIC' minisatConfig.cmake.in cmake_uninstall.cmake.in 2>/dev/null | head\r\n8:option(STATIC_BINARIES \"Link binaries statically.\" ON)\r\n48:option(STATICCOMPILE \"Compile static library and executable\" OFF)\r\n50:option(BUILD_SHARED_LIBS \"Build the shared library\" ON)\r\n51:if (STATICCOMPILE)\r\n52:    set(BUILD_SHARED_LIBS OFF)\r\n55:if (NOT BUILD_SHARED_LIBS)\r\n57:        set(CMAKE_EXE_LINKER_FLAGS \"${CMAKE_EXE_LINKER_FLAGS} -static -Wl,--whole-archive -lpthread -Wl,--no-whole-archive -static \")\r\n127:    if (NOT BUILD_SHARED_LIBS)\r\n128:        # We statically link to reduce dependencies\r\n145:        # Creates a multithreaded executable (static) file using LIBCMT.lib.\r\n202:add_library(minisat ${MINISAT_LIB_SOURCES})\r\n"]
