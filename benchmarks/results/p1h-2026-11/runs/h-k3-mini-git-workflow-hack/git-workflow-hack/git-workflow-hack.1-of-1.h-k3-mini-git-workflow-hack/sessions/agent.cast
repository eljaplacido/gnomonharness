[301.487708, "o", "<returncode>\r\n0\r\n<output>\r\n   565          ),\r\n   566          \"about.html\": page(\r\n   567              title=\"About Me\",\r\n   568              description=\"Learn about Dr. Lydia Moreno's research, education, projects, teaching, and computational neuroscience toolkit.\",\r\n   569              body=about_body(),\r\n   570              active=\"index.html\",\r\n   571              canonical=\"index.html\",\r\n   572          ),\r\n   573          \"blog.html\": page(\r\n   574              title=\"Blog\",\r\n   575              description=\"Notes by Lydia Moreno on interpretable machine learning, neural computation, single-cell genomics, and connectomics.\",\r\n   576              body=blog_body(),\r\n   577              active=\"blog.html\",\r\n   578          ),\r\n   579          \"publications.html\": page(\r\n   580              title=\"Publications\",\r\n   581              description=\"Peer-reviewed publications by Dr. Lydia Moreno on neural decoding, connectomics, single-cell genomics, and explainable AI.\",\r\n   582              body=publications_body(),\r\n   583              active=\"publications.html\",\r\n   584          ),\r\n   585      }\r\n   586  \r\n   587      for filename, content in pages.items():\r\n   588          (ROOT / filename).write_text(content, encoding=\"utf-8\")\r\n   589  \r\n   590      (ROOT / \"blog\").mkdir(exist_ok=True)\r\n   591      for post in BLOG_POSTS:\r\n   592          content = page(\r\n   593              title=post[\"title\"],\r\n   594              description=post[\"excerpt\"],\r\n   595              body=article_body(post),\r\n   596              active=\"blog.html\",\r\n   597              root=\"../\",\r\n   598          )\r\n   599          (ROOT / \"blog\" / f\"{post['slug']}.html\").write_text(content, encoding=\"utf-8\")\r\n   600  \r\n   601  \r\n   602  if __name__ == \"__main__\":\r\n   603      write_outputs()\r\n   604      print(\"Generated index.html, about.html, blog.html, publications.html, and blog posts.\")\r\n\r\n"]
