[196.794237, "o", "  color: var(--accent-dark);\r\n  font-weight: 700;\r\n  text-decoration: none;\r\n}\r\n\r\n.blog-card-footer a:hover {\r\n  text-decoration: underline;\r\n}\r\n\r\n.article-shell {\r\n  max-width: 760px;\r\n  margin-inline: auto;\r\n}\r\n\r\n.article-header {\r\n  padding: 4.5rem 0 2.2rem;\r\n}\r\n\r\n.article-header h1 {\r\n  max-width: none;\r\n  font-size: clamp(2.4rem, 6vw, 4.2rem);\r\n}\r\n\r\n.article-meta {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 0.5rem 1rem;\r\n  margin: 1.3rem 0 0;\r\n  color: var(--muted);\r\n  font-size: 0.84rem;\r\n}\r\n\r\n.article-body {\r\n  padding-bottom: 5rem;\r\n  color: #34474d;\r\n  font-size: 1.06rem;\r\n}\r\n\r\n.article-body h2 {\r\n  margin-top: 2.2rem;\r\n  font-size: 1.8rem;\r\n}\r\n\r\n.article-body p {\r\n  margin: 0 0 1.2rem;\r\n}\r\n\r\n.article-body blockquote {\r\n  margin: 1.8rem 0;\r\n  padding: 1rem 0 1rem 1.3rem;\r\n  border-left: 3px solid var(--accent);\r\n  color: var(--ink);\r\n  font-family: var(--serif);\r\n  font-size: 1.2rem;\r\n}\r\n\r\n.back-link {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 0.4rem;\r\n  margin-bottom: 1.5rem;\r\n  color: var(--muted);\r\n  font-size: 0.84rem;\r\n  font-weight: 650;\r\n  text-decoration: none;\r\n}\r\n\r\n.back-link:hover {\r\n  color: var(--accent-dark);\r\n}\r\n\r\n.site-footer {\r\n  padding: 2.6rem 0;\r\n  border-top: 1px solid var(--line);\r\n}\r\n\r\n.footer-inner {\r\n  display: grid;\r\n  grid-template-columns: minmax(0, 1fr) auto;\r\n  align-items: start;\r\n  gap: 2rem;\r\n}\r\n\r\n.footer-brand {\r\n  margin: 0 0 0.3rem;\r\n  font-family: var(--serif);\r\n  font-size: 1.25rem;\r\n}\r\n\r\n.footer-note {\r\n  max-width: 28rem;\r\n  margin: 0;\r\n  color: var(--muted);\r\n  font-size: 0.82rem;\r\n}\r\n\r\n.footer-links {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 1rem;\r\n  margin: 0;\r\n  padding: 0;\r\n  list-style: none;\r\n}\r\n\r\n.footer-links a {\r\n  color: var(--muted);\r\n  font-size: 0.82rem;\r\n  font-weight: 650;\r\n  text-decoration: none;\r\n}\r\n\r\n.footer-links a:hover {\r\n  color: var(--accent-dark);\r\n  text-decoration: underline;\r\n}\r\n\r\n.footer-meta {\r\n  grid-column: 1 / -1;\r\n  margin: 0.7rem 0 0;\r\n  padding-top: 1.2rem;\r\n  border-top: 1px solid var(--line);\r\n  color: var(--faint);\r\n  font-size: 0.75rem;\r\n}\r\n\r\n@media (max-width: 900px) {\r\n  .hero-grid,\r\n  .two-col {\r\n    grid-template-columns: 1fr;\r\n  }\r\n\r\n  .hero {\r\n    padding-top: 3.5rem;\r\n  }\r\n\r\n  .profile-card {\r\n    max-width: 32rem;\r\n  }\r\n\r\n  .blog-grid {\r\n    grid-template-columns: repeat(2, minmax(0, 1fr));\r\n  }\r\n}\r\n\r\n@media (max-width: 720px) {\r\n  .container {\r\n    width: min(100% - 2rem, 1120px);\r\n  }\r\n\r\n  .header-inner {\r\n    min-height: 4.5rem;\r\n  }\r\n\r\n  .nav-toggle {\r\n    display: inline-flex;\r\n  }\r\n\r\n  .site-nav {\r\n    position: fixed;\r\n    inset: 4.5rem 0 auto;\r\n    display: none;\r\n    padding: 1rem;\r\n    background: var(--paper);\r\n    border-bottom: 1px solid var(--line);\r\n    box-shadow: var(--shadow);\r\n  }\r\n\r\n  .site-nav.is-open {\r\n    display: block;\r\n  }\r\n\r\n  .nav-list {\r\n    display: grid;\r\n    gap: 0.35rem;\r\n  }\r\n\r\n  .nav-list a {\r\n    padding: 0.85rem 1rem;\r\n  }\r\n\r\n  .section-heading {\r\n    display: block;\r\n  }\r\n\r\n  .section-heading p:not(.eyebrow) {\r\n    margin-top: 0.75rem;\r\n  }\r\n\r\n  .card-grid,\r\n  .split-grid,\r\n  .blog-grid {\r\n    grid-template-columns: 1fr;\r\n  }\r\n\r\n  .project-card {\r\n    grid-template-columns: 1fr;\r\n    gap: 1rem;\r\n  }\r\n\r\n  .contact-banner,\r\n  .footer-inner {\r\n    display: block;\r\n  }\r\n\r\n  .contact-banner .button {\r\n    margin-top: 1.3rem;\r\n  }\r\n\r\n  .footer-links {\r\n    margin-top: 1rem;\r\n  }\r\n\r\n  .publication-card {\r\n    grid-template-columns: 1fr;\r\n    gap: 0.35rem;\r\n  }\r\n}\r\n\r\n@media (prefers-reduced-motion: reduce) {\r\n  *,\r\n  *::before,\r\n  *::after {\r\n    scroll-behavior: auto !important;\r\n    transition-duration: 0.01ms !important;\r\n    animation-duration: 0.01ms !important;\r\n    animation-iteration-count: 1 !important;\r\n  }\r\n}\r\nEOF\r\ncat > assets/main.js <<'EOF'\r\n(() => {\r\n  const navToggle = document.querySelector(\".nav-toggle\");\r\n  const nav = document.querySelector(\".site-nav\");\r\n\r\n  if (navToggle && nav) {\r\n    navToggle.addEventListener(\"click\", () => {\r\n      const isOpen = nav.classList.toggle(\"is-open\");\r\n      navToggle.setAttribute(\"aria-expanded\", String(isOpen));\r\n  "]
[196.794302, "o", "    document.body.classList.toggle(\"nav-open\", isOpen);\r\n    });\r\n\r\n    nav.addEventListener(\"click\", (event) => {\r\n      if (event.target.closest(\"a\")) {\r\n        nav.classList.remove(\"is-open\");\r\n        navToggle.setAttribute(\"aria-expanded\", \"false\");\r\n        document.body.classList.remove(\"nav-open\");\r\n      }\r\n    });\r\n\r\n    document.addEventListener(\"keydown\", (event) => {\r\n      if (event.key === \"Escape\" && nav.classList.contains(\"is-open\")) {\r\n        nav.classList.remove(\"is-open\");\r\n        navToggle.setAttribute(\"aria-expanded\", \"false\");\r\n        document.body.classList.remove(\"nav-open\");\r\n        navToggle.focus();\r\n      }\r\n    });\r\n  }\r\n\r\n  document.querySelectorAll(\"[data-current-year]\").forEach((node) => {\r\n    node.textContent = String(new Date().getFullYear());\r\n  });\r\n\r\n  const publicationList = document.querySelector(\"[data-publication-list]\");\r\n  if (publicationList) {\r\n    const filterButtons = [...document.querySelectorAll(\"[data-filter]\")];\r\n    const search = document.querySelector(\"[data-publication-search]\");\r\n    const emptyState = document.querySelector(\"[data-publication-empty]\");\r\n    let activeYear = \"all\";\r\n\r\n    const applyFilters = () => {\r\n      const query = (search?.value || \"\").trim().toLowerCase();\r\n      let visible = 0;\r\n\r\n      publicationList.querySelectorAll(\"[data-publication]\").forEach((card) => {\r\n        const matchesYear = activeYear === \"all\" || card.dataset.year === activeYear;\r\n        const matchesQuery = !query || card.textContent.toLowerCase().includes(query);\r\n        const show = matchesYear && matchesQuery;\r\n        card.hidden = !show;\r\n        if (show) visible += 1;\r\n      });\r\n\r\n      if (emptyState) emptyState.hidden = visible !== 0;\r\n    };\r\n\r\n    filterButtons.forEach((button) => {\r\n      button.addEventListener(\"click\", () => {\r\n        activeYear = button.dataset.filter;\r\n        filterButtons.forEach((item) => item.setAttribute(\"aria-pressed\", String(item === button)));\r\n        applyFilters();\r\n      });\r\n    });\r\n\r\n    search?.addEventListener(\"input\", applyFilters);\r\n  }\r\n\r\n  document.querySelectorAll(\"[data-copy-citation]\").forEach((button) => {\r\n    button.addEventListener(\"click\", async () => {\r\n      const status = button.parentElement?.querySelector(\".copy-status\");\r\n      try {\r\n        await navigator.clipboard.writeText(button.dataset.copyCitation || \"\");\r\n        if (status) status.textContent = \"Citation copied\";\r\n      } catch {\r\n        if (status) status.textContent = \"Copy unavailable\";\r\n      }\r\n      window.setTimeout(() => {\r\n        if (status) status.textContent = \"\";\r\n      }, 2200);\r\n    });\r\n  });\r\n})();\r\nEOF\r\ncat > assets/favicon.svg <<'EOF'\r\n<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 64 64\">\r\n  <rect width=\"64\" height=\"64\" rx=\"16\" fill=\"#0d6b62\"/>\r\n  <path d=\"M18 17h7v25h20v6H18V17Zm26 0h7v16h-7V17Z\" fill=\"#fffdf8\"/>\r\n</svg>\r\nEOF\r\nls -la assets\r\n```\r\n\u001b[32m⠏\u001b[0m Waiting for the LM to respond...\r\u001b[2K\u001b[32m⠏\u001b[0m Waiting for the LM to respond...\r\n\u001b[?25h\r\u001b[1A\u001b[2K"]
