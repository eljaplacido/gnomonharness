[299.986305, "o", "<returncode>\r\n0\r\n<output>\r\n108:    },\r\n116:    },\r\n124:    },\r\n132:    },\r\n156:    },\r\n176:    },\r\n196:    },\r\n220:        (\"publications.html\", \"Publications\"),\r\n324:            <a class=\"button button-primary\" href=\"publications.html\">Explore publications {icon('<path d=\"M5 12h14M13 6l6 6-6 6\"/>')}</a>\r\n579:        \"publications.html\": page(\r\n583:            active=\"publications.html\",\r\n585:    }\r\n604:    print(\"Generated index.html, about.html, blog.html, publications.html, and blog posts.\")\r\n   470    </main>\r\n   471  \"\"\"\r\n   472  \r\n   473  \r\n   474  def publications_body() -> str:\r\n   475      cards = []\r\n   476      for publication in PUBLICATIONS:\r\n   477          citation = (\r\n   478              f\"{publication['authors']} ({publication['year']}). \"\r\n   479              f\"“{publication['title']}.” {publication['journal']}, \"\r\n   480              f\"{publication['volume']}, {publication['pages']}.\"\r\n   481          )\r\n   482          cards.append(\r\n   483              f\"\"\"<article class=\"publication-card\" data-publication data-year=\"{publication['year']}\">\r\n"]
[299.986339, "o", "   484                <div class=\"publication-year\">{publication['year']}</div>\r\n   485                <div>\r\n   486                  <div class=\"publication-meta\"><span>Peer-reviewed article</span><span>{escape(publication['journal'])}</span></div>\r\n   487                  <h2>{escape(publication['title'])}</h2>\r\n   488                  <p class=\"publication-authors\">{escape(publication['authors'])}</p>\r\n   489                  <p class=\"publication-venue\"><em>{escape(publication['journal'])}</em>, {escape(publication['volume'])}, \r\n{escape(publication['pages'])}.</p>\r\n   490                  <div class=\"pub-footer\">\r\n   491                    <button class=\"copy-button\" type=\"button\" data-copy-citation=\"{escape(citation)}\">Copy citation</button>\r\n   492                    <span class=\"copy-status\" role=\"status\" aria-live=\"polite\"></span>\r\n   493                  </div>\r\n   494                </div>\r\n   495              </article>\"\"\"\r\n   496          )\r\n   497      years = sorted({publication[\"year\"] for publication in PUBLICATIONS}, reverse=True)\r\n   498      filters = \"\".join(\r\n   499          f'<button class=\"filter-button\" type=\"button\" data-filter=\"{year}\" aria-pressed=\"false\">{year}</button>'\r\n   500          for year in years\r\n   501      )\r\n   502      return f\"\"\"\r\n   503    <main id=\"main\">\r\n   504      <section class=\"page-hero\">\r\n   505        <div class=\"container\">\r\n   506          <p class=\"eyebrow\">Scholarship</p>\r\n   507          <h1>Publications</h1>\r\n   508          <p class=\"lede\">Peer-reviewed work on neural decoding, connectomics, single-cell genomics, and explainable AI. Filter by year or search titles, \r\nauthors, and journals.</p>\r\n   509        </div>\r\n   510      </section>\r\n   511      <section class=\"page-body\">\r\n   512        <div class=\"container\">"]
[299.986375, "o", "\r\n   513          <div class=\"filter-bar\">\r\n   514            <div class=\"filter-group\" aria-label=\"Filter publications by year\">\r\n   515              <button class=\"filter-button\" type=\"button\" data-filter=\"all\" aria-pressed=\"true\">All</button>\r\n   516              {filters}\r\n   517            </div>\r\n   518            <label class=\"search-field\">Search publications\r\n   519              <input type=\"search\" data-publication-search placeholder=\"Title, author, or journal\">\r\n   520            </label>\r\n\r\n"]
