[340.80656, "o", "<returncode>\r\n0\r\n<output>\r\n--- index head/nav/hero ---\r\n<!doctype html>\r\n<html lang=\"en\">\r\n<head>\r\n  <meta charset=\"utf-8\">\r\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\r\n  <meta name=\"description\" content=\"Dr. Lydia Moreno is an associate professor of Computational Neuroscience at Riverbend University, working at the \r\nintersection of machine learning, systems neuroscience, and bioinformatics.\">\r\n  <meta name=\"theme-color\" content=\"#0d6b62\">\r\n  <meta property=\"og:title\" content=\"About Me\">\r\n  <meta property=\"og:description\" content=\"Dr. Lydia Moreno is an associate professor of Computational Neuroscience at Riverbend University, working at the \r\nintersection of machine learning, systems neuroscience, and bioinformatics.\">\r\n  <meta property=\"og:type\" content=\"website\">\r\n  <title>About Me | Lydia Moreno</title>\r\n  <link rel=\"icon\" href=\"assets/favicon.svg\" type=\"image/svg+xml\">\r\n  <link rel=\"stylesheet\" href=\"assets/styles.css\">\r\n  <script src=\"assets/main.js\" defer></script>\r\n</head>\r\n<body>\r\n  <a class=\"skip-link\" href=\"#main\">Skip to content</a>\r\n  <header class=\"site-header\">\r\n    <div class=\"container header-inner\">\r\n      <a class=\"brand\" href=\"index.html\" aria-label=\"Lydia Moreno — home\">\r\n        <span class=\"brand-mark\" aria-hidden=\"true\">LM</span>\r\n        <span class=\"brand-text\"><strong>Lydia Moreno</strong><span>Computational Neuroscience</span></span>\r\n      </a>\r\n      <button class=\"nav-toggle\" type=\"button\" aria-expanded=\"false\" aria-controls=\"site-nav\">Menu</button>\r\n      <nav class=\"site-nav\" id=\"site-nav\" aria-label=\"Primary navigation\">\r\n        <ul class=\"nav-list\">\r\n          <li><a href=\"index.html\" aria-current=\"page\">About Me</a></li>\r\n<li><a href=\"blog.html\">Blog</a></li>\r\n<li><a href=\"publications.html\">Publications</a></li>\r\n        </ul>\r\n      </nav>\r\n    </div>\r\n  </header>\r\n  \r\n  <main id=\"main\">\r\n    <section class=\"hero\">\r\n      <div class=\"container hero-grid\">\r\n        <div class=\"hero-copy\">\r\n          <p class=\"eyebrow\">Research Profile</p>\r\n          <h1>Lydia Moreno, <span>PhD</span></h1>\r\n          <p class=\"hero-role\">Associate Professor of Computational Neuroscience</p>\r\n          <p class=\"hero-affiliation\">Riverbend University · School of Biological Sciences</p>\r\n          <p class=\"hero-lede\">I build interpretable machine learning methods that help reveal how neural circuits encode, process, and transform complex \r\nsensory information.</p>\r\n          <div class=\"hero-actions\">\r\n            <a class=\"button button-primary\" href=\"publications.html\">Explore publications <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" fill=\"none\" \r\nstroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></a>\r\n            <a class=\"button button-secondary\" href=\"mailto:lydia.moreno@riverbend.edu\">Get in touch</a>\r\n          </div>\r\n          <ul class=\"hero-facts\" aria-label=\"Profile highlights\">\r\n            <li><strong>PhD</strong> Computational Biology</li>\r\n            <li><strong>8</strong> Ph.D. students supervised</li>\r\n            <li><strong>12</strong> Master’s theses mentored</li>\r\n          </ul>\r\n        </div>\r\n        <aside class=\"profile-card\" aria-label=\"Profile summary\">\r\n          <div class=\"monogram\" aria-hidden=\"true\">LM</div>\r\n          <p class=\"profile-kicker\">Research focus</p>\r\n          <h2>Neural computation, made interpretable.</h2>\r\n          <ul class=\"tag-list\" aria-label=\"Research areas\">\r\n            <li>Neural decoding</li>\r\n            <li>Biomedical imaging</li>\r\n            <li>Single-cell omics</li>\r\n            <li>Explainable AI</li>\r\n          </ul>\r\n          <ul class=\"contact-list\">\r\n            <li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" \r\nstroke-linejoin=\"round\"><path d=\"M4 6h16v12H4z\"/><path d=\"m4 7 8 6 8-6\"/></svg><a href=\"mailto:lydia.moreno@riverbend.edu\">lydia.moreno@riverbend.edu</a></li>\r\n            <li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" fill=\"none\" stroke"]
[340.806762, "o", "=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" \r\nstroke-linejoin=\"round\"><path d=\"M12 21s7-5.3 7-12a7 7 0 1 0-14 0c0 6.7 7 12 7 12Z\"/><circle cx=\"12\" cy=\"9\" r=\"2.5\"/></svg><span>Blakely Hall, Room \r\n312<br>Riverbend University</span></li>\r\n            <li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" \r\nstroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M8.5 9.5c.4-1 1.6-1.4 2.5-1.1 1.2.4 1.2 1.8.9 2.6-.3.9-1.5 1.4-1.5 2.4 0 .7.5 1.3 1.2 1.4M12 \r\n17.2v.1\"/></svg> <a href=\"https://twitter.com/LydiaNeuroLab\" rel=\"me\">@LydiaNeuroLab</a></li>\r\n            <li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" \r\nstroke-linejoin=\"round\"><path d=\"M9 19c-4.3 1.3-4.3-2.1-6-2.5M15 21v-3.4c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.3 5.5-6a4.7 4.7 0 0 0-1.3-3.3c.1-.4.6-1.6-.1-3.2 0 \r\n0-1-.3-3.3 1.2a11.2 11.2 0 0 0-6 0C7 2.8 6 3.1 6 3.1c-.7 1.6-.2 2.8-.1 3.2A4.7 4.7 0 0 0 4.5 9.6c0 4.7 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21\"/></svg><a \r\nhref=\"https://github.com/lydia-moreno\" rel=\"me\">github.com/lydia-moreno</a></li>\r\n          </ul>\r\n        </aside>\r\n      </div>\r\n    </section>\r\n\r\n    <section class=\"section section-tight\" id=\"about\">\r\n      <div class=\"container two-col\">\r\n        <div>\r\n          <p class=\"eyebrow\">About Me</p>\r\n          <h2>Questions first, then models.</h2>\r\n        </div>\r\n        <div class=\"prose\">\r\n          <p>Dr. Lydia Moreno is an associate professor of Computational Neuroscience at Riverbend University’s School of Biological Sciences. Her work sits at \r\nthe intersection of machine learning, systems neuroscience, and bioinformatics, aiming to unravel how neural circuits encode and process complex sensory \r\ninformation.</p>\r\n          <p>She received her Ph.D. in Computational Biology from Baywood Institute of Technology and completed postdoctoral training in high-throughput imaging\r\nanalysis at Northborough Research Center. Her research combines theory-driven modeling with open, reproducible computational pipelines.</p>\r\n        </div>\r\n      </div>\r\n    </section>\r\n\r\n    <section class=\"section surface-band\" aria-labelledby=\"interests-heading\">\r\n      <div class=\"container\">\r\n        <div class=\"section-heading\">\r\n          <div>\r\n            <p class=\"eyebrow\">Research Interests</p>\r\n            <h2 id=\"interests-heading\">Where the work lives</h2>\r\n          </div>\r\n          <p>Methods and questions that connect neural measurements to interpretable computational accounts.</p>\r\n        </div>\r\n--- publications semantics ---\r\n47:            <button class=\"filter-button\" type=\"button\" data-filter=\"all\" aria-pressed=\"true\">All</button>\r\n48:            <button class=\"filter-button\" type=\"button\" data-filter=\"2024\" aria-pressed=\"false\">2024</button><button class=\"filter-button\" type=\"button\" \r\ndata-filter=\"2023\" aria-pressed=\"false\">2023</button><button class=\"filter-button\" type=\"button\" data-filter=\"2022\" aria-pressed=\"false\">2022</button><button \r\nclass=\"filter-button\" type=\"button\" data-filter=\"2021\" aria-pressed=\"false\">2021</button>\r\n50:          <label class=\"search-field\">Search publications\r\n55:          <article class=\"publication-card\" data-publication data-year=\"2024\">\r\n63:                  <button class=\"copy-button\" type=\"button\" data-copy-citation=\"Moreno, L., &amp; Patel, A. (2024). “Temporal Convolutional Networks Decode \r\nVisual Stimuli from Two-Photon Signals.” Journal of Computational Neuroscience, 45(2), 123–137.\">Copy citation</button>\r\n67:            </article><article class=\"publication-card\" data-publication data-year=\"2023\">\r\n75:                  <button class=\"copy-button\" type=\"button\" data-copy-citation=\"Moreno, L., Zhang, W., &amp; Singh, R. (2023). “Graph Embedding Techniques \r\nReveal Synaptic Motifs in EM Datasets.” Neuroinformatics, 21(4), 299–312.\">Copy citation</button>\r\n79:            </article><article class=\"publication-card\" data-publication data-year=\"2022\">\r\n87:                  <button class=\"copy-button\""]
[340.806783, "o", " type=\"button\" data-copy-citation=\"Moreno, L., et al. (2022). “Integrative Single-Cell Atlas of Human Cerebral \r\nOrganoids.” Cell Systems, 9(1), 67–82.\">Copy citation</button>\r\n91:            </article><article class=\"publication-card\" data-publication data-year=\"2021\">\r\n99:                  <button class=\"copy-button\" type=\"button\" data-copy-citation=\"Chen, J., Moreno, L., &amp; Russo, M. (2021). “Explainable AI Techniques in \r\nNeural Decoding.” Frontiers in Neuroscience, 15, 756843.\">Copy citation</button>\r\n--- blog post nav paths ---\r\n13:  <link rel=\"stylesheet\" href=\"../assets/styles.css\">\r\n14:  <script src=\"../assets/main.js\" defer></script>\r\n20:      <a class=\"brand\" href=\"../index.html\" aria-label=\"Lydia Moreno — home\">\r\n21:        <span class=\"brand-mark\" aria-hidden=\"true\">LM</span>\r\n22:        <span class=\"brand-text\"><strong>Lydia Moreno</strong><span>Computational Neuroscience</span></span>\r\n26:        <ul class=\"nav-list\">\r\n38:        <a class=\"back-link\" href=\"../blog.html\">← All notes</a>\r\n52:        <p class=\"footer-brand\">Lydia Moreno, PhD</p>\r\n\r\n"]
