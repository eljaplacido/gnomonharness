def blog_body() -> str:
    cards = "\n".join(
        f"""<article class="blog-card">
          <div class="blog-card-body">
            <p class="blog-date">{escape(post['date'])} · {escape(post['category'])}</p>
            <h3><a href="blog/{post['slug']}.html">{escape(post['title'])}</a></h3>
            <p class="blog-excerpt">{escape(post['excerpt'])}</p>
            <div class="blog-card-footer">
              <span>{escape(post['read_time'])}</span>
              <a href="blog/{post['slug']}.html" aria-label="Read {escape(post['title'])}">Read note →</a>
            </div>
          </div>
        </article>"""
        for post in BLOG_POSTS
    )
    return f"""
  <main id="main">
    <section class="page-hero">
      <div class="container">
        <p class="eyebrow">Notes &amp; Ideas</p>
        <h1>Blog</h1>
