python3 - <<'PY'
from html.parser import HTMLParser
from pathlib import Path
from urllib.parse import urlparse
import re

class Checker(HTMLParser):
    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.ids = set()
        self.links = []
        self.images = []
        self.title = ''
        self.h1s = []
        self._in_title = False
        self._in_h1 = False
    def handle_starttag(self, tag, attrs):
        attrs = dict(attrs)
        if 'id' in attrs:
            self.ids.add(attrs['id'])
        if tag == 'a' and 'href' in attrs:
            self.links.append(attrs['href'])
        if tag == 'img':
            self.images.append(attrs)
        if tag == 'title':
            self._in_title = True
        if tag == 'h1':
            self._in_h1 = True
    def handle_endtag(self, tag):
        if tag == 'title':
            self._in_title = False
        if tag == 'h1':
            self._in_h1 = False
    def handle_data(self, data):
        if self._in_title:
            self.title += data
        if self._in_h1:
            self.h1s.append(data.strip())

site = Path('public')
pages = sorted(site.rglob('*.html'))
errors = []
for p in pages:
    parser = Checker()
    parser.feed(p.read_text(encoding='utf-8'))
    rel = p.relative_to(site)
    if not parser.title.strip():
        errors.append(f'{rel}: missing title')
    if not parser.h1s:
        errors.append(f'{rel}: missing h1')
    for link in parser.links:
        if link.startswith(('mailto:', 'http://', 'https://', '#')):
            continue
        target = (p.parent / link.split('#')[0]).resolve()
        if not target.exists():
            errors.append(f'{rel}: broken link {link}')
    for img in parser.images:
        if 'alt' not in img:
            errors.append(f'{rel}: img without alt')
print(f'Checked {len(pages)} HTML pages')
if errors:
    print('\n'.join(errors))
    raise SystemExit(1)
print('HTML checks passed: titles, h1s, internal links, and image alt text')
