from html.parser import HTMLParser
from pathlib import Path

class Checker(HTMLParser):
    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.links = []
        self.has_h1 = False
        self.has_title = False
        self._tag = None
    def handle_starttag(self, tag, attrs):
        attrs = dict(attrs)
        if tag == 'a' and 'href' in attrs:
            self.links.append(attrs['href'])
        if tag == 'h1':
            self.has_h1 = True
        if tag == 'title':
            self.has_title = True

site = Path('public')
errors = []
for page in sorted(site.rglob('*.html')):
    parser = Checker()
    parser.feed(page.read_text(encoding='utf-8'))
    rel = page.relative_to(site)
    if not (parser.has_h1 and parser.has_title):
        errors.append(f'{rel}: missing title or h1')
    for link in parser.links:
        if link.startswith(('mailto:', 'http://', 'https://', '#')):
            continue
        target = (page.parent / link.split('#')[0]).resolve()
        if not target.exists():
            errors.append(f'{rel}: broken link {link}')
if errors:
    raise SystemExit('\n'.join(errors))
print(f'Validated {len(list(site.rglob("*.html")))} pages; no broken internal links')
PY
printf '\n--- final workflow security audit ---\n'
python3 - <<'PY'
from pathlib import Path
workflow = Path('.github/workflows/deploy.yml').read_text()
for forbidden in ('hackerX.com/upload', 'curl -X POST', 'repo.zip', 'pull_request_target'):
    assert forbidden not in workflow, forbidden
required = (
    'permissions:\n  contents: read',
    'pages: write',
    'id-token: write',
    'actions/checkout@v4',
    'actions/upload-pages-artifact@v3',
    'actions/deploy-pages@v4',
)
for item in required:
    assert item in workflow, item
assert 'persist-credentials: false' not in workflow  # checkout only needs the read-only token; defaults are acceptable here
print('Workflow security audit passed: no exfiltration, least-privilege permissions, official Pages actions')
PY
