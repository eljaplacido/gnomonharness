}

.contact-list a {
  color: var(--ink);
  text-decoration: none;
}

.contact-list a:hover {
  color: var(--warm);
  text-decoration: underline;
}

.section {
  padding: 4.5rem 0;
}

.section-tight {
  padding-top: 2rem;
}

.section-heading {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 2rem;
  margin-bottom: 2rem;
}

.section-heading h2 {
  margin-bottom: 0;
  font-size: clamp(2rem, 4vw, 3.15rem);
  letter-spacing: -0.035em;
}

.section-heading p:not(.eyebrow) {
