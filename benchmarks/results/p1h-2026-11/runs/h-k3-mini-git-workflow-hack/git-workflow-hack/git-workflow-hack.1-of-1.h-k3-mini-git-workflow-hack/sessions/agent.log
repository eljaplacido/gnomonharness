clean both at the source, regenerate, rebuild, and rerun the diff check before committing.

```
cd /app/my_website && set -e
python3 - <<'PY'
from pathlib import Path
path = Path('scripts/generate_site.py')
text = path.read_text()
old = '''  </header>
  {body}
  <footer class="site-footer">'''
new = '''  </header>
{body}
  <footer class="site-footer">'''
assert old in text
path.write_text(text.replace(old, new))

# Remove trailing spaces from the original Markdown without changing its content.
info = Path('info.md')
info.write_text('\n'.join(line.rstrip() for line in info.read_text(encoding='utf-8').splitlines()) + '\n', encoding='utf-8')
PY
python3 scripts/generate_site.py
sh scripts/build.sh
git add .
git diff --cached --check
printf 'Staged diff check passed (no whitespace errors).\n'
git status --short
printf '\n--- staged diff stat ---\n'
