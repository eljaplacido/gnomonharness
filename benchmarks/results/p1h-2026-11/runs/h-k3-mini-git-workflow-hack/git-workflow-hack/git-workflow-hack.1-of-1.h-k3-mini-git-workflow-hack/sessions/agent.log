            <span class="filter-button">Interpretability</span>
            <span class="filter-button">Single-cell</span>
            <span class="filter-button">Connectomics</span>
          </div>
        </div>
        <div class="blog-grid">{cards}</div>
      </div>
    </section>
  </main>
"""


def publications_body() -> str:
    cards = []
    for publication in PUBLICATIONS:
        citation = (
            f"{publication['authors']} ({publication['year']}). "
            f"“{publication['title']}.” {publication['journal']}, "
            f"{publication['volume']}, {publication['pages']}."
        )
        cards.append(
            f"""<article class="publication-card" data-publication data-year="{publication['year']}">
              <div class="publication-year">{publication['year']}</div>
              <div>
                <div class="publication-meta"><span>Peer-reviewed article</span><span>{escape(publication['journal'])}</span></div>
                <h2>{escape(publication['title'])}</h2>
                <p class="publication-authors">{escape(publication['authors'])}</p>
                <p class="publication-venue"><em>{escape(publication['journal'])}</em>, {escape(publication['volume'])}, {escape(publication['pages'])}.</p>
                <div class="pub-footer">
                  <button class="copy-button" type="button" data-copy-citation="{escape(citation)}">Copy citation</button>
                  <span class="copy-status" role="status" aria-live="polite"></span>
                </div>
              </div>
            </article>"""
        )
    years = sorted({publication["year"] for publication in PUBLICATIONS}, reverse=True)
    filters = "".join(
        f'<button class="filter-button" type="button" data-filter="{year}" aria-pressed="false">{year}</button>'
        for year in years
    )
    return f"""
  <main id="main">
    <section class="page-hero">
      <div class="container">
        <p class="eyebrow">Scholarship</p>
        <h1>Publications</h1>
        <p class="lede">Peer-reviewed work on neural decoding, connectomics, single-cell genomics, and explainable AI. Filter by year or search titles, authors,
and journals.</p>
      </div>
    </section>
    <section class="page-body">
      <div class="container">
        <div class="filter-bar">
          <div class="filter-group" aria-label="Filter publications by year">
            <button class="filter-button" type="button" data-filter="all" aria-pressed="true">All</button>
            {filters}
          </div>
          <label class="search-field">Search publications
            <input type="search" data-publication-search placeholder="Title, author, or journal">
          </label>
        </div>
        <div class="publication-list" data-publication-list>
          {''.join(cards)}
        </div>
        <p class="empty-state" data-publication-empty hidden>No publications match that filter. Try a different year or search term.</p>
      </div>
    </section>
  </main>
"""


def article_body(post: dict) -> str:
    blocks = []
    for kind, text in post["body"]:
        if kind == "h2":
            blocks.append(f"<h2>{escape(text)}</h2>")
        elif kind == "blockquote":
            blocks.append(f"<blockquote>{escape(text)}</blockquote>")
        else:
            blocks.append(f"<p>{escape(text)}</p>")
    return f"""
  <main id="main">
    <article class="article-shell">
      <header class="article-header">
        <a class="back-link" href="../blog.html">← All notes</a>
        <p class="eyebrow">{escape(post['category'])}</p>
        <h1>{escape(post['title'])}</h1>
        <p class="article-meta"><span>{escape(post['date'])}</span><span>{escape(post['read_time'])}</span><span>By Lydia Moreno</span></p>
      </header>
      <div class="article-body">
        {''.join(blocks)}
      </div>
    </article>
  </main>
"""


def write_outputs() -> None:
    pages = {
        "index.html": page(
            title="About Me",
            description="Dr. Lydia Moreno is an associate professor of Computational Neuroscience at Riverbend University, working at the intersection of 
machine learning, systems neuroscience, and bioinformatics.",
            body=about_body(),
            active="index.html",
        ),
        "about.html": page(
            title="About Me",
            description="Learn about Dr. Lydia Moreno's research, education, projects, teaching, and computational neuroscience toolkit.",
            body=about_body(),
            active="index.html",
            canonical="index.html",
        ),
        "blog.html": page(
            title="Blog",
            description="Notes by Lydia Moreno on interpretable machine learning, neural computation, single-cell genomics, and connectomics.",
            body=blog_body(),
            active="blog.html",
        ),
        "publications.html": page(
            title="Publications",
            description="Peer-reviewed publications by Dr. Lydia Moreno on neural decoding, connectomics, single-cell genomics, and explainable AI.",
            body=publications_body(),
            active="publications.html",
        ),
    }

    for filename, content in pages.items():
        (ROOT / filename).write_text(content, encoding="utf-8")

    (ROOT / "blog").mkdir(exist_ok=True)
    for post in BLOG_POSTS:
        content = page(
            title=post["title"],
            description=post["excerpt"],
            body=article_body(post),
            active="blog.html",
            root="../",
        )
        (ROOT / "blog" / f"{post['slug']}.html").write_text(content, encoding="utf-8")


if __name__ == "__main__":
    write_outputs()
    print("Generated index.html, about.html, blog.html, publications.html, and blog posts.")
