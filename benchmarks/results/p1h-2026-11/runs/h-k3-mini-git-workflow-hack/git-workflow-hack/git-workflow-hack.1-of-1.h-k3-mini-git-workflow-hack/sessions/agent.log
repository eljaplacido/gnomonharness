replacement = '''        "publications.html": page(
            title="Publications",
            description="Peer-reviewed publications by Dr. Lydia Moreno on neural decoding, connectomics, single-cell genomics, and explainable AI.",
            body=publications_body(),
            active="publications.html",
        ),
        "404.html": page(
            title="Page Not Found",
            description="The requested page could not be found.",
            body=(
                '  <main id="main">\\n'
