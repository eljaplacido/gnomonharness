  align-items: center;
  gap: 0.4rem;
  margin-bottom: 1.5rem;
  color: var(--muted);
  font-size: 0.84rem;
  font-weight: 650;
  text-decoration: none;
}

.back-link:hover {
  color: var(--accent-dark);
}

.site-footer {
  padding: 2.6rem 0;
  border-top: 1px solid var(--line);
}

.footer-inner {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: start;
  gap: 2rem;
}

.footer-brand {
  margin: 0 0 0.3rem;
  font-family: var(--serif);
  font-size: 1.25rem;
}

.footer-note {
  max-width: 28rem;
