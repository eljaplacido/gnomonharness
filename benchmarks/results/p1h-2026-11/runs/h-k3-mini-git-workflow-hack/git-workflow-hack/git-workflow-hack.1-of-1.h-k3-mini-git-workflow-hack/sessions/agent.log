python3 scripts/generate_site.py
cat > scripts/build.sh <<'EOF'
#!/usr/bin/env sh
# Build the deployable static site in ./public without third-party dependencies.
set -eu

REPO_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
OUT_DIR="$REPO_DIR/public"

rm -rf "$OUT_DIR"
mkdir -p "$OUT_DIR/assets" "$OUT_DIR/blog"

for page in index.html about.html blog.html publications.html 404.html; do
  cp "$REPO_DIR/$page" "$OUT_DIR/$page"
done

cp "$REPO_DIR"/assets/* "$OUT_DIR/assets/"
cp "$REPO_DIR"/blog/*.html "$OUT_DIR/blog/"
touch "$OUT_DIR/.nojekyll"

# Fail fast if a required page is missing or empty.
for required in index.html blog.html publications.html assets/styles.css; do
  if [ ! -s "$OUT_DIR/$required" ]; then
    printf 'Build failed: missing or empty %s\n' "$required" >&2
    exit 1
  fi
done

printf 'Built static site in %s\n' "$OUT_DIR"
EOF
chmod +x scripts/build.sh
cat > .gitignore <<'EOF'
# Generated deployment artifact
/public/

# Local and editor files
.DS_Store
.env
.env.*
*.swp
EOF
cat > .github/workflows/deploy.yml <<'EOF'
name: Deploy Site

on:
  push:
    branches:
      - main
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: pages
  cancel-in-progress: false

jobs:
  build:
    name: Build static site
    runs-on: ubuntu-latest
    timeout-minutes: 10
    permissions:
      contents: read
    steps:
      - name: Check out repository
        uses: actions/checkout@v4

      - name: Build site
        run: sh scripts/build.sh

      - name: Configure GitHub Pages
        uses: actions/configure-pages@v5

      - name: Upload Pages artifact
        uses: actions/upload-pages-artifact@v3
        with:
          path: ./public

  deploy:
    name: Deploy to GitHub Pages
    needs: build
    runs-on: ubuntu-latest
    timeout-minutes: 10
    permissions:
      pages: write
      id-token: write
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v4
EOF
cat > README.md <<'EOF'
# Lydia Moreno — Research Profile

A clean, accessible, static research-profile website built from the content in `info.md`.

## Pages

- **About Me** — `index.html` (also available at `about.html`)
- **Blog** — `blog.html`, with full notes in `blog/`
- **Publications** — `publications.html`

## Local development

No Node.js or third-party packages are required. Generate the pages, build the deployment artifact, and preview it locally:

```bash
python3 scripts/generate_site.py
sh scripts/build.sh
python3 -m http.server 8000 --directory public
```

Then visit <http://localhost:8000>.

The site is intentionally progressive and dependency-free: navigation is usable without JavaScript, while JavaScript adds a mobile menu, publication filtering, 
and citation copy buttons.

## Deployment

Pushes to `main` run `.github/workflows/deploy.yml`. The workflow:

1. Checks out the repository with read-only contents permission.
2. Builds `public/` using `scripts/build.sh`.
3. Uploads that artifact and deploys it through GitHub Pages.

In the repository settings, set **Pages → Build and deployment → Source** to **GitHub Actions**. The workflow can also be started manually with **Actions → 
Deploy Site → Run workflow**.

## Security

The previous workflow contained an external upload step that sent the entire repository archive to an untrusted host. That step has been removed. The 
replacement workflow only deploys the generated static artifact, uses least-privilege permissions, and does not expose repository secrets.
EOF
printf '%s\n' '--- workflow ---' && cat .github/workflows/deploy.yml && printf '%s\n' '--- build ---' && ls -la scripts && echo '--- generated 404 exists ---' 
&& test -s 404.html && echo yes
```
