  text-decoration: underline;
}

.footer-meta {
  grid-column: 1 / -1;
  margin: 0.7rem 0 0;
  padding-top: 1.2rem;
  border-top: 1px solid var(--line);
  color: var(--faint);
  font-size: 0.75rem;
}

@media (max-width: 900px) {
  .hero-grid,
  .two-col {
    grid-template-columns: 1fr;
  }

  .hero {
    padding-top: 3.5rem;
  }

  .profile-card {
    max-width: 32rem;
  }

  .blog-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 720px) {
  .container {
    width: min(100% - 2rem, 1120px);
  }

  .header-inner {
    min-height: 4.5rem;
  }

  .nav-toggle {
    display: inline-flex;
  }

  .site-nav {
    position: fixed;
    inset: 4.5rem 0 auto;
    display: none;
    padding: 1rem;
    background: var(--paper);
    border-bottom: 1px solid var(--line);
    box-shadow: var(--shadow);
  }

  .site-nav.is-open {
    display: block;
  }

  .nav-list {
    display: grid;
    gap: 0.35rem;
  }

  .nav-list a {
    padding: 0.85rem 1rem;
  }

  .section-heading {
    display: block;
  }

  .section-heading p:not(.eyebrow) {
    margin-top: 0.75rem;
  }

  .card-grid,
  .split-grid,
  .blog-grid {
    grid-template-columns: 1fr;
  }

  .project-card {
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .contact-banner,
  .footer-inner {
    display: block;
  }

  .contact-banner .button {
    margin-top: 1.3rem;
  }

  .footer-links {
    margin-top: 1rem;
  }

  .publication-card {
    grid-template-columns: 1fr;
    gap: 0.35rem;
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    transition-duration: 0.01ms !important;
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
  }
}
