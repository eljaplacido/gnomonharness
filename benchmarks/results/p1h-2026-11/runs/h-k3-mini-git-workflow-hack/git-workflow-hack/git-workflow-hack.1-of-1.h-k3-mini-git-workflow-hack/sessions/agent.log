def icon(paths: str) -> str:
    return (
        '<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" '
        'stroke="currentColor" stroke-width="1.7" stroke-linecap="round" '
        f'stroke-linejoin="round">{paths}</svg>'
    )


def page(
    *,
    title: str,
    description: str,
    body: str,
    active: str,
    root: str = "",
    canonical: str | None = None,
) -> str:
    nav_items = [
        ("index.html", "About Me"),
        ("blog.html", "Blog"),
        ("publications.html", "Publications"),
    ]
    nav = "\n".join(
        f'<li><a href="{root}{href}"'
        f'{" aria-current=\"page\"" if href == active else ""}>{label}</a></li>'
        for href, label in nav_items
    )
    canonical_tag = f'\n  <link rel="canonical" href="{escape(canonical)}">' if canonical else ""
    return f"""<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="{escape(description)}">
  <meta name="theme-color" content="#0d6b62">
  <meta property="og:title" content="{escape(title)}">
  <meta property="og:description" content="{escape(description)}">
  <meta property="og:type" content="website">
  <title>{escape(title)} | Lydia Moreno</title>{canonical_tag}
  <link rel="icon" href="{root}assets/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="{root}assets/styles.css">
  <script src="{root}assets/main.js" defer></script>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href="{root}index.html" aria-label="Lydia Moreno — home">
        <span class="brand-mark" aria-hidden="true">LM</span>
        <span class="brand-text"><strong>Lydia Moreno</strong><span>Computational Neuroscience</span></span>
      </a>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">Menu</button>
      <nav class="site-nav" id="site-nav" aria-label="Primary navigation">
        <ul class="nav-list">
          {nav}
        </ul>
      </nav>
    </div>
  </header>
  {body}
  <footer class="site-footer">
    <div class="container footer-inner">
      <div>
        <p class="footer-brand">Lydia Moreno, PhD</p>
        <p class="footer-note">Computational neuroscience, interpretable machine learning, and single-cell data.</p>
      </div>
      <ul class="footer-links">
        <li><a href="mailto:{EMAIL}">Email</a></li>
        <li><a href="{GITHUB}" rel="me">GitHub</a></li>
        <li><a href="{TWITTER}" rel="me">Twitter</a></li>
      </ul>
      <p class="footer-meta">© <span data-current-year>2026</span> Lydia Moreno. Research profile built as a static, accessible website.</p>
    </div>
  </footer>
</body>
</html>
"""


