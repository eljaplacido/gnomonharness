[29.997532, "o", "\u001b[0m$ \u001b[0mcd /app && nohup python3 -m pypiserver run -p 8080 -a . -P . --disable-fallback /app/dist > /app/pypiserver.log 2>&1 & echo \"started pid $!\"; sleep 2; cat /app/pypiserver.log\r\nstarted pid 5168\r\nBottle v0.12.25 server starting up (using AutoServer(handler_class=<class '__main__.WsgiHandler'>))...\r\nListening on http://0.0.0.0:8080/\r\nHit Ctrl-C to quit.\r\n"]
