'default-posting-chain'\r\n/usr/lib/python3/dist-packages/mailman/styles/base.py:180:        # The default pipeline to send accepted messages through to the\r\n/usr/lib/python3/dist-packages/mailman/styles/base.py:182:        mlist.posting_pipeline = 'default-posting-pipeline'\r\n/usr/lib/python3/dist-packages/mailman/styles/base.py:185:        mlist.owner_chain = 'default-owner-chain'\r\n/usr/lib/python3/dist-packages/mailman/styles/base.py:186:        # The default pipeline to send -owner email through.\r\n/usr/lib/python3/dist-packages/mailman/styles/base.py:187:        mlist.owner_pipeline = 'default-owner-pipeline'\r\n/usr/lib/python3/dist-packages/mailman/styles/default.py:38:class LegacyDefaultStyle(\r\n/usr/lib/python3/dist-packages/mailman/styles/default.py:41:    \"\"\"The legacy default style.\"\"\"\r\n/usr/lib/python3/dist-packages/mailman/styles/default.py:43:    name = 'legacy-default'\r\n/usr/lib/python3/dist-packages/mailman/styles/default.py:61:    \"\"\"Similar to the legacy-default style, but for announce-only lists.\"\"\"\r\n/usr/lib/python3/dist-packages/mailman/styles/default.py:63:    name = 'legacy-announce'\r\n/usr/lib/python3/dist-packages/mailman/styles/default.py:78:class PrivateDefaultStyle(\r\n/usr/lib/python3/dist-packages/mailman/styles/default.py:83:    name = 'private-default'\r\n/usr/lib/python3/dist-packages/mailman/styles/manager.py:35:class StyleManager:\r\n"]
