[140.909282, "o", "\u001b[0m$ \u001b[0mpython3 - <<'PY'\r\nfrom pathlib import Path\r\np=Path('/etc/postfix/main.cf')\r\ns=p.read_text()\r\ns=s.replace('smtpd_relay_restrictions = permit_mynetworks permit_sasl_authenticated defer_unauth_destination\\nmyhostname = localhost.tailf09230.ts.net\\nalias_maps = hash:/etc/aliases\\nalias_database = hash:/etc/aliases\\nmydestination = $myhostname, localhost, localhost.localdomain, , localhost\\n','smtpd_relay_restrictions = permit_mynetworks permit_sasl_authenticated defer_unauth_destination\\nalias_maps = hash:/etc/aliases\\nalias_database = hash:/etc/aliases\\n')\r\np.write_text(s)\r\nPY\r\npostfix check 2>&1; postconf -n | grep -E 'myhostname|mydomain|myorigin|mydestination|transport_maps|local_recipient_maps|mail_spool'\r\nappend_dot_mydomain = no\r\nlocal_recipient_maps = proxy:unix:passwd.byname $alias_maps hash:/var/lib/mailman3/data/postfix_lmtp\r\nmail_spool_directory = /var/mail\r\nmydestination = $myhostname, localhost, localhost.localdomain, local.edu\r\nmydomain = local.edu\r\nmyhostname = local.edu\r\nmyorigin = local.edu\r\nsmtpd_banner = $myhostname ESMTP $mail_name (Ubuntu)\r\ntransport_maps = hash:/var/lib/mailman3/data/postfix_lmtp\r\n"]
