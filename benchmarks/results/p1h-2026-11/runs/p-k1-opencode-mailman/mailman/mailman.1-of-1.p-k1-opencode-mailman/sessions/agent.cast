[90.911796, "o", "\u001b[0m$ \u001b[0mpostconf -d mailbox_command home_mailbox mail_spool_directory local_recipient_maps transport_maps relay_domains mydestination myorigin myhostname mydomain 2>&1; echo '--- users homes ---'; getent passwd nobody root | cut -d: -f1,6\r\nmailbox_command =\r\nhome_mailbox =\r\nmail_spool_directory = /var/mail\r\nlocal_recipient_maps = proxy:unix:passwd.byname $alias_maps\r\ntransport_maps =\r\nrelay_domains = ${{$compatibility_level} <level {2} ? {$mydestination} : {}}\r\nmydestination = $myhostname, localhost.$mydomain, localhost\r\nmyorigin = $myhostname\r\nmyhostname = 524e0b88447d.localdomain\r\nmydomain = localdomain\r\n--- users homes ---\r\nnobody:/nonexistent\r\nroot:/root\r\n"]
