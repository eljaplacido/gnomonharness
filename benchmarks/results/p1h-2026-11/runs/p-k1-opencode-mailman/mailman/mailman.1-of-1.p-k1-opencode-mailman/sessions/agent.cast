[126.393751, "o", "\u001b[0m$ \u001b[0mcat /var/lib/mailman3/data/postfix_lmtp; echo '--- domains ---'; cat /var/lib/mailman3/data/postfix_domains; echo '--- list policies ---'; su -s /bin/bash list -c 'mailman -C /etc/mailman3/mailman.cfg shell -l reading-group@local.edu --run mailman.commands.cli_withlist.shell' 2>&1 | head -5\r\n# AUTOMATICALLY GENERATED BY MAILMAN ON 2026-11-01 00:25:08\r\n#\r\n# This file is generated by Mailman, and is kept in sync with the binary hash\r\n# file.  YOU SHOULD NOT MANUALLY EDIT THIS FILE unless you know what you're\r\n# doing, and can keep the two files properly in sync.  If you screw it up,\r\n# you're on your own.\r\n    \r\n# Aliases which are visible only in the @local.edu domain.\r\nreading-group@local.edu                       lmtp:[127.0.0.1]:8024\r\nreading-group-bounces@local.edu               lmtp:[127.0.0.1]:8024\r\nreading-group-confirm@local.edu               lmtp:[127.0.0.1]:8024\r\nreading-group-join@local.edu                  lmtp:[127.0.0.1]:8024\r\nreading-group-leave@local.edu                 lmtp:[127.0.0.1]:8024\r\nreading-group-owner@local.edu                 lmtp:[127.0.0.1]:8024\r\nreading-group-request@local.edu               lmtp:[127.0.0.1]:8024\r\nreading-group-subscribe@local.edu             lmtp:[127.0.0.1]:8024\r\nreading-group-unsubscribe@local.edu           lmtp:[127.0.0.1]:8024\r\n\r\n--- domains ---\r\n# AUTOMATICALLY GENERATED BY MAILMAN ON 2026-11-01 00:25:08\r\n#\r\n# This file is generated by Mailman, and is kept in sync with the binary hash\r\n# file.  YOU SHOULD NOT MANUALLY EDIT THIS FILE unless you know what you're\r\n# doing, and can keep the two files properly in sync.  If you screw it up,\r\n# you're on your own.\r\n\r\nlocal.edu local.edu\r\n\r\n--- list policies ---\r\nTraceback (most recent call last):\r\n  File \"/usr/bin/mailman\", line 33, in <module>\r\n    sys.exit(load_entry_point('mailman==3.3.8', 'console_scripts', 'mailman')())\r\n             ^^^^^^^^^^^^^^^^^^^^^^^^^^^^