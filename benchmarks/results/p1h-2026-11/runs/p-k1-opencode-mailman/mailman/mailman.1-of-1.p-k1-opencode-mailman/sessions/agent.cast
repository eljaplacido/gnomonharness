[119.750904, "o", "\u001b[0m$ \u001b[0mcat >> /etc/postfix/main.cf <<'EOF'\r\n\r\n# --- Mailman 3 / local.edu configuration ---\r\nmyhostname = local.edu\r\nmydomain = local.edu\r\nmyorigin = local.edu\r\nmydestination = $myhostname, localhost, localhost.localdomain, local.edu\r\n# Route list robot addresses to Mailman's LMTP server.\r\ntransport_maps = hash:/var/lib/mailman3/data/postfix_lmtp\r\n# Accept local Unix users plus the Mailman robot addresses.\r\nlocal_recipient_maps = proxy:unix:passwd.byname $alias_maps hash:/var/lib/mailman3/data/postfix_lmtp\r\n# Mailboxes live in /var/mail/<username> (mbox format).\r\nmail_spool_directory = /var/mail\r\nEOF\r\npostconf -n | grep -E 'myhostname|mydomain|myorigin|mydestination|transport_maps|local_recipient_maps|mail_spool'\r\npostconf: warning: /etc/postfix/main.cf, line 49: overriding earlier entry: myhostname=localhost.tailf09230.ts.net\r\npostconf: warning: /etc/postfix/main.cf, line 52: overriding earlier entry: mydestination=$myhostname, localhost, localhost.localdomain, , localhost\r\npostconf: warning: /etc/postfix/main.cf, line 49: overriding earlier entry: myhostname=localhost.tailf09230.ts.net\r\npostconf: warning: /etc/postfix/main.cf, line 52: overriding earlier entry: mydestination=$myhostname, localhost, localhost.localdomain, , localhost\r\npostconf: warning: /etc/postfix/main.cf, line 49: overriding earlier entry: myhostname=localhost.tailf09230.ts.net\r\npostconf: warning: /etc/postfix/main.cf, line 52: overriding earlier entry: mydestination=$myhostname, localhost, localhost.localdomain, , localhost\r\npostconf: warning: /etc/postfix/main.cf, line 49: overriding earlier entry: myhostname=localhost.tailf09230.ts.net\r\npostconf: warning: /etc/postfix/main.cf, line 52: overriding earlier entry: mydestination=$myhostname, localhost, localhost.localdomain, , localhost\r\npostconf: warning: /etc/postfix/main.cf, line 49: overriding earlier entry: myhostname=localhost.tailf09230.ts.net\r\npostconf: warning: /etc/postfix/main.cf, line 52: overriding earlier entry: mydestination=$myhostname, localhost, localhost.localdomain, , localhost\r\npostconf: warning: /etc/postfix/main.cf, line 49: overriding earlier entry: myhostname=localhost.tailf09230.ts.net\r\npostconf: warning: /etc/postfix/main.cf, line 52: overriding earlier entry: mydestination=$myhostname, localhost, localhost.localdomain, , localhost\r\npostconf: warning: /etc/postfix/main.cf, line 49: overriding earlier entry: myhostname=localhost.tailf09230.ts.net\r\npostconf: warning: /etc/postfix/main.cf, line 52: overriding earlier entry: mydestination=$myhostname, localhost, localhost.localdomain, , localhost\r\nappend_dot_mydomain = no\r\nlocal_recipient_maps = proxy:unix:passwd.byname $alias_maps hash:/var/lib/mailman3/data/postfix_lmtp\r\nmail_spool_directory = /var/mail\r\nmydestination = $myhostname, localhost, localhost.localdomain, local.edu\r\nmydomain = local.edu\r\nmyhostname = local.edu\r\nmyorigin = local.edu\r\nsmtpd_banner = $myhostname ESMTP $mail_name (Ubuntu)\r\ntransport_maps = hash:/var/lib/mailman3/data/postfix_lmtp\r\n"]
