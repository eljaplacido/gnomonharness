[123.349842, "o", "\u001b[0m$ \u001b[0msu -s /bin/bash list -c 'mailman -C /etc/mailman3/mailman.cfg create --quiet reading-group@local.edu' 2>&1; echo EXIT:$?; ls -la /var/lib/mailman3/data; su -s /bin/bash list -c 'mailman -C /etc/mailman3/mailman.cfg lists' 2>&1\r\npostmap: warning: /etc/postfix/main.cf, line 49: overriding earlier entry: myhostname=localhost.tailf09230.ts.net\r\npostmap: warning: /etc/postfix/main.cf, line 52: overriding earlier entry: mydestination=$myhostname, localhost, localhost.localdomain, , localhost\r\npostmap: warning: /etc/postfix/main.cf, line 49: overriding earlier entry: myhostname=localhost.tailf09230.ts.net\r\npostmap: warning: /etc/postfix/main.cf, line 52: overriding earlier entry: mydestination=$myhostname, localhost, localhost.localdomain, , localhost\r\nEXIT:0\r\ntotal 312\r\ndrwxr-x--- 1 list list   4096 Nov  1 00:25 .\r\ndrwxr-xr-x 1 list list   4096 Nov  1 00:24 ..\r\n-rw-rw---- 1 list list 270336 Nov  1 00:25 mailman.db\r\n-rw-rw---- 1 list list    335 Nov  1 00:25 postfix_domains\r\n-rw-r----- 1 list list  12288 Nov  1 00:25 postfix_domains.db\r\n-rw-rw---- 1 list list    990 Nov  1 00:25 postfix_lmtp\r\n-rw-r----- 1 list list  12288 Nov  1 00:25 postfix_lmtp.db\r\n1 matching mailing lists found:\r\nreading-group@local.edu\r\n"]
