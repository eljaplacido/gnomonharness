[104.238189, "o", "\u001b[0m$ \u001b[0mgrep -n \"verp_confirm_regexp\" -A 20 -B 5 /usr/lib/python3/dist-packages/mailman/config/schema.cfg; grep -R \"verp_confirm_regexp\" -n /usr/lib/python3/dist-packages/mailman | grep -v pyc | head -30\r\n880-# into\r\n881-#\r\n882-# To: \"local_part\" <local_part@host>\r\n883-#\r\n884-# when replying, so we skip everything up to '<' if any.\r\n885:verp_confirm_regexp: ^(.*<)?(?P<addr>[^+]+?)\\+(?P<cookie>[^@]+)@.*$\r\n886-\r\n887-# Set this to 'no' to disable user friendly confirmations and avoid encoding\r\n888-# the confirmation cookie in the reply address.\r\n889-verp_confirmations: yes\r\n890-\r\n891-# Another good opportunity is when regular delivery is personalized.  Here\r\n892-# again, we're already incurring the performance hit for addressing each\r\n893-# individual recipient.  Set this to 'yes' to enable VERPs on all personalized\r\n894-# regular deliveries (personalized digests aren't supported yet).\r\n895-verp_personalized_deliveries: no\r\n896-\r\n897-# And finally, we can VERP normal, non-personalized deliveries.  However,\r\n898-# because it can be a significant performance hit, we allow you to decide how\r\n899-# often to VERP regular deliveries.  This is the interval, in number of\r\n900-# messages, to do a VERP recipient address.  The same variable controls both\r\n901-# regular and digest deliveries.  Set to 0 to disable occasional VERPs, set to\r\n902-# 1 to VERP every delivery, or to some number > 1 for only occasional VERPs.\r\n903-verp_delivery_interval: 0\r\n904-\r\n905-# VERP format and regexp for probe messages.\r\ngrep: /usr/lib/python3/dist-packages/mailman/runners/__pycache__/command.cpython-312.pyc: binary file matches\r\n/usr/lib/python3/dist-packages/mailman/runners/command.py:73:            mo = re.match(config.mta.verp_confirm_regexp,\r\n/usr/lib/python3/dist-packages/mailman/config/schema.cfg:885:verp_confirm_regexp: ^(.*<)?(?P<addr>[^+]+?)\\+(?P<cookie>[^@]+)@.*$\r\n"]
[104.25831, "o", "\u001b[0m$ \u001b[0mgrep -R \"SubscriptionConfirmationNeededEvent\\|UnsubscriptionConfirmationNeededEvent\\|confirm_address\" -n /usr/lib/python3/dist-packages/mailman | grep -v pyc | head -60\r\ngrep: /usr/lib/python3/dist-packages/mailman/model/__pycache__/mailinglist.cpython-312.pyc: binary file matches\r\ngrep: /usr/lib/python3/dist-packages/mailman/app/__pycache__/subscriptions.cpython-312.pyc: binary file matches\r\ngrep: /usr/lib/python3/dist-packages/mailman/app/__pycache__/events.cpython-312.pyc: binary file matches\r\ngrep: /usr/lib/python3/dist-packages/mailman/interfaces/__pycache__/mailinglist.cpython-312.pyc: binary file matches\r\ngrep: /usr/lib/python3/dist-packages/mailman/interfaces/__pycache__/subscriptions.cpython-312.pyc: binary file matches\r\n/usr/lib/python3/dist-packages/mailman/model/mailinglist.py:332:    def confirm_address(self, cookie):\r\n/usr/lib/python3/dist-packages/mailman/app/subscriptions.py:47:    SubscriptionConfirmationNeededEvent,\r\n/usr/lib/python3/dist-packages/mailman/app/subscriptions.py:51:    UnsubscriptionConfirmationNeededEvent,\r\n/usr/lib/python3/dist-packages/mailman/app/subscriptions.py:379:        notify(SubscriptionConfirmationNeededEvent(\r\n/usr/lib/python3/dist-packages/mailman/app/subscriptions.py:474:        notify(UnsubscriptionConfirmationNeededEvent(\r\n/usr/lib/python3/dist-packages/mailman/app/subscriptions.py:638:    confirm_address = event.mlist.confirm_address(event.token)\r\n/usr/lib/python3/dist-packages/mailman/app/subscriptions.py:645:        confirm_email=confirm_address,\r\n/usr/lib/python3/dist-packages/mailman/app/subscriptions.py:648:        confirm_address=confirm_address,\r\n/usr/lib/python3/dist-packages/mailman/app/subscriptions.py:656:        confirm_address = event.mlist.request_address\r\n/usr/lib/python3/dist-packages/mailman/app/subscriptions.py:658:        email_address, confirm_address, subject, text,\r\n/usr/lib/python3/dist-packages/mailman/app/subscriptions.py:666:def handle_SubscriptionConfirmationNeededEvent(event):\r\n/usr/lib/python3/dist-packages/mailman/app/subscriptions.py:667:    if not isinstance(event, SubscriptionConfirmationNeededEvent):\r\n/usr/lib/python3/dist-packages/mailman/app/subscriptions.py:680:def handle_UnsubscriptionConfirmationNeededEvent(event):\r\n/usr/lib/python3/dist-packages/mailman/app/subscriptions.py:681:    if not isinstance(event, UnsubscriptionConfirmationNeededEvent):\r\n/usr/lib/python3/dist-packages/mailman/app/events.py:41:        subscriptions.handle_SubscriptionConfirmationNeededEvent,\r\n/usr/lib/python3/dist-packages/mailman/app/events.py:43:        subscriptions.handle_UnsubscriptionConfirmationNeededEvent,\r\n/usr/lib/python3/dist-packages/mailman/interfaces/subscriptions.py:82:class SubscriptionConfirmationNeededEvent:\r\n/usr/lib/python3/dist-packages/mailman/interfaces/subscriptions.py:109:class UnsubscriptionConfirmationNeededEvent:\r\n/usr/lib/python3/dist-packages/mailman/interfaces/mailinglist.py:257:    def confirm_address(cookie=''):\r\n"]
