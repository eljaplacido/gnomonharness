[49.737537, "o", "\u001b[0m$ \u001b[0mls -la /usr/lib/mailman3/bin; grep -R \"create\" -n /usr/lib/python3/dist-packages/mailman/bin | head -60\r\ntotal 20\r\ndrwxr-xr-x 2 root root 4096 Oct 31 12:15 .\r\ndrwxr-xr-x 3 root root 4096 Oct 31 12:15 ..\r\n-rwxr-xr-x 1 root root  958 Aug 25  2024 mailman\r\n-rwxr-xr-x 1 root root  956 Aug 25  2024 master\r\n-rwxr-xr-x 1 root root  956 Aug 25  2024 runner\r\ngrep: /usr/lib/python3/dist-packages/mailman/bin/tests/__pycache__/test_mailman.cpython-312.pyc: binary file matches\r\n/usr/lib/python3/dist-packages/mailman/bin/tests/test_mailman.py:25:from mailman.app.lifecycle import create_list\r\n/usr/lib/python3/dist-packages/mailman/bin/tests/test_mailman.py:98:            mlist = create_list('ant@example.com')\r\n/usr/lib/python3/dist-packages/mailman/bin/tests/test_mailman.py:113:            mlist = create_list('ant@example.com')\r\n/usr/lib/python3/dist-packages/mailman/bin/tests/test_master.py:135:            # We created a non-restartable loop.\r\n/usr/lib/python3/dist-packages/mailman/bin/mailman.py:75:    # To handle `mailman <subcommand> --help` we create a custom click.Command\r\n"]
