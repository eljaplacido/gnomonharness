[126.572357, "o", "\u001b[0m$ \u001b[0msu -s /bin/bash list -c 'python3 - <<\"PY\"\r\nfrom mailman.core.initialize import initialize\r\ninitialize(\"/etc/mailman3/mailman.cfg\")\r\nfrom mailman.interfaces.listmanager import IListManager\r\nfrom zope.component import getUtility\r\nm=getUtility(IListManager).get(\"reading-group@local.edu\")\r\nprint(\"fqdn\", m.fqdn_listname)\r\nprint(\"subscription_policy\", m.subscription_policy)\r\nprint(\"unsubscription_policy\", m.unsubscription_policy)\r\nprint(\"default_member_action\", m.default_member_action)\r\nprint(\"default_nonmember_action\", m.default_nonmember_action)\r\nprint(\"allow_list_posts\", m.allow_list_posts)\r\nprint(\"posting_address\", m.posting_address)\r\nprint(\"join\", m.join_address)\r\nprint(\"leave\", m.leave_address)\r\nprint(\"confirm\", m.confirm_address(\"TOKEN\"))\r\nPY' 2>&1 | tail -30\r\nfqdn reading-group@local.edu\r\nsubscription_policy SubscriptionPolicy.confirm\r\nunsubscription_policy SubscriptionPolicy.confirm\r\ndefault_member_action Action.defer\r\ndefault_nonmember_action Action.hold\r\nallow_list_posts True\r\nposting_address reading-group@local.edu\r\njoin reading-group-join@local.edu\r\nleave reading-group-leave@local.edu\r\nconfirm reading-group-confirm+TOKEN@local.edu\r\n"]
