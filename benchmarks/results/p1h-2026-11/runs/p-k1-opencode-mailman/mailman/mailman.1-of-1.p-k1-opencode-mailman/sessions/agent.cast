[49.778857, "o", "\u001b[0m$ \u001b[0mcat /usr/lib/python3/dist-packages/mailman-3.3.8.egg-info/entry_points.txt; grep -R \"class Create\\|name =.*create\\|def create\" -n /usr/lib/python3/dist-packages/mailman/commands /usr/lib/python3/dist-packages/mailman/bin | head -40; ls /usr/lib/python3/dist-packages/mailman/bin; sed -n '985,1010p' /usr/lib/python3/dist-packages/mailman/config/schema.cfg\r\n[console_scripts]\r\nmailman = mailman.bin.mailman:main\r\nmaster = mailman.bin.master:main\r\nrunner = mailman.bin.runner:main\r\n/usr/lib/python3/dist-packages/mailman/commands/cli_lists.py:165:def create(ctx, language, owners, notify, quiet, create_domain, fqdn_listname):\r\n/usr/lib/python3/dist-packages/mailman/commands/cli_lists.py:224:class Create:\r\n/usr/lib/python3/dist-packages/mailman/commands/cli_lists.py:225:    name = 'create'\r\n__init__.py\r\n__pycache__\r\nmailman.py\r\nmaster.py\r\nrunner.py\r\ntests\r\nclass: mailman.archiving.mailarchive.MailArchive\r\nconfiguration: python:mailman.config.mail_archive\r\n\r\n[archiver.prototype]\r\n# This is a prototypical sample archiver.\r\nclass: mailman.archiving.prototype.Prototype\r\n\r\n\r\n[styles]\r\n# The default style to apply if nothing else was requested.  The value is the\r\n# name of an existing style.  If no such style exists, no style will be\r\n# applied.\r\ndefault: legacy-default\r\n\r\n\r\n[digests]\r\n# Headers which should be kept in both RFC 1153 (plain) and MIME digests.  RFC\r\n# 1153 also specifies these headers in this exact order, so order matters.\r\n# These are space separated and case insensitive.\r\nmime_digest_keep_headers:\r\n    Date From To Cc Subject Message-ID Keywords\r\n    In-Reply-To References Content-Type MIME-Version\r\n    Content-Transfer-Encoding Precedence Reply-To\r\n    Message List-Post\r\n\r\nplain_digest_keep_headers:\r\n"]
