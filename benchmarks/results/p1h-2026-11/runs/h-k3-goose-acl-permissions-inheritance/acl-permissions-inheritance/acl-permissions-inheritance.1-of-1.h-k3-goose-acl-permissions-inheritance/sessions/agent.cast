[22.601373, "o", "\r\n  \u001b[2m────────────────────────────────────────\u001b[0m\r\n  \u001b[2m▸\u001b[0m \u001b[2mshell\u001b[0m\r\n    \u001b[2mcommand\u001b[0m: \u001b[32mset -e\r\nmkdir -p /srv/shared\r\nchown root:research /srv/shared\r\nchmod 2770 /srv/shared\r\n\r\n# Access ACLs\r\nsetfacl -m \"g:research:rwx\" /srv/shared\r\nsetfac...\u001b[0m\r\n\r\n"]
[22.630509, "o", "    \u001b[2m=== stat ===\u001b[0m\r\n    \u001b[2mdrwxrws--- 2770 root:research /srv/shared\u001b[0m\r\n    \u001b[2m=== getfacl ===\u001b[0m\r\n    \u001b[2m# file: /srv/shared\u001b[0m\r\n    \u001b[2m# owner: root\u001b[0m\r\n    \u001b[2m# group: research\u001b[0m\r\n    \u001b[2m# flags: -s-\u001b[0m\r\n    \u001b[2muser::rwx\u001b[0m\r\n    \u001b[2muser:alice:rwx\u001b[0m\r\n    \u001b[2muser:bob:rwx\u001b[0m\r\n    \u001b[2m\u001b[3m... (1 lines hidden, /toggle to show all)\u001b[0m\r\n    \u001b[2mgroup:research:rwx\u001b[0m\r\n    \u001b[2mmask::rwx\u001b[0m\r\n    \u001b[2mother::---\u001b[0m\r\n    \u001b[2mdefault:user::rwx\u001b[0m\r\n    \u001b[2mdefault:user:alice:rwx\u001b[0m\r\n    \u001b[2mdefault:user:bob:rwx\u001b[0m\r\n    \u001b[2mdefault:group::rwx\u001b[0m\r\n    \u001b[2mdefault:group:research:rwx\u001b[0m\r\n    \u001b[2mdefault:mask::rwx\u001b[0m\r\n    \u001b[2mdefault:other::---\u001b[0m\r\n"]
