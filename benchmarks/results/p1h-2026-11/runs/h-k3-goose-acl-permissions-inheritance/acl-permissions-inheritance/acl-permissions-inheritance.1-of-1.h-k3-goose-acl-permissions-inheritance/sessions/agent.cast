[26.40008, "o", "\r\n  \u001b[2m────────────────────────────────────────\u001b[0m\r\n  \u001b[2m▸\u001b[0m \u001b[2mshell\u001b[0m\r\n    \u001b[2mcommand\u001b[0m: \u001b[32mset -e\r\n# Mirror the exact configuration in a throwaway dir\r\nrm -rf /tmp/acltest; mkdir -p /tmp/acltest/d\r\nchown root:research /tmp/acltest/d\r\nchmod...\u001b[0m\r\n\r\n"]
[26.445542, "o", "    \u001b[2m=== alice creates file + subdir, sets umask 077 to prove ACL wins ===\u001b[0m\r\n    \u001b[2m-rw-rw---- 660 alice:research /tmp/acltest/d/alice.txt\u001b[0m\r\n    \u001b[2mdrwxrws--- 2770 alice:research /tmp/acltest/d/sub\u001b[0m\r\n    \u001b[2m--- inherited ACL on file ---\u001b[0m\r\n    \u001b[2m# file: /tmp/acltest/d/alice.txt\u001b[0m\r\n    \u001b[2m# owner: alice\u001b[0m\r\n    \u001b[2m# group: research\u001b[0m\r\n    \u001b[2muser::rw-\u001b[0m\r\n    \u001b[2muser:alice:rwx\t#effective:rw-\u001b[0m\r\n    \u001b[2muser:bob:rwx\t#effective:rw-\u001b[0m\r\n    \u001b[2m\u001b[3m... (22 lines hidden, /toggle to show all)\u001b[0m\r\n    \u001b[2mdefault:mask::rwx\u001b[0m\r\n    \u001b[2mdefault:other::---\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2m=== bob reads/writes alice's file ===\u001b[0m\r\n    \u001b[2mhello\u001b[0m\r\n    \u001b[2mOK-bob\u001b[0m\r\n    \u001b[2m=== outsider (nobody) denied ===\u001b[0m\r\n    \u001b[2mls: cannot open directory '/tmp/acltest/d': Permission denied\u001b[0m\r\n    \u001b[2mcat: /tmp/acltest/d/alice.txt: Permission denied\u001b[0m\r\n    \u001b[2mcleaned up\u001b[0m\r\n"]
[30.395859, "o", "\r\n  \u001b[2m────────────────────────────────────────\u001b[0m\r\n  \u001b[2m▸\u001b[0m \u001b[2mshell\u001b[0m\r\n    \u001b[2mcommand\u001b[0m: \u001b[32mecho \"=== final state ===\"; stat -c 'mode=%a (%A)  owner=%U  group=%G  path=%n' /srv/shared\r\necho; echo \"=== contents (must be empty) ===\"; ls -A...\u001b[0m\r\n\r\n"]
[30.422952, "o", "    \u001b[2m=== final state ===\u001b[0m\r\n    \u001b[2mmode=2770 (drwxrws---)  owner=root  group=research  path=/srv/shared\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2m=== contents (must be empty) ===\u001b[0m\r\n    \u001b[2m0\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2m=== getfacl ===\u001b[0m\r\n    \u001b[2m# file: /srv/shared\u001b[0m\r\n    \u001b[2m# owner: root\u001b[0m\r\n    \u001b[2m# group: research\u001b[0m\r\n    \u001b[2m\u001b[3m... (10 lines hidden, /toggle to show all)\u001b[0m\r\n    \u001b[2mdefault:user:bob:rwx\u001b[0m\r\n    \u001b[2mdefault:group::rwx\u001b[0m\r\n    \u001b[2mdefault:group:research:rwx\u001b[0m\r\n    \u001b[2mdefault:mask::rwx\u001b[0m\r\n    \u001b[2mdefault:other::---\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2m\u001b[0m\r\n    \u001b[2m=== sanity: alice can traverse, outsider cannot (no files created) ===\u001b[0m\r\n    \u001b[2malice: access OK\u001b[0m\r\n    \u001b[2moutsider: denied\u001b[0m\r\n"]
