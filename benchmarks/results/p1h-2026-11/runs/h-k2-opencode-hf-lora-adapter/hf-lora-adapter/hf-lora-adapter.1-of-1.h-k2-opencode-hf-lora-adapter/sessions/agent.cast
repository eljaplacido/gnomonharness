[154.526799, "o", "\u001b[0m$ \u001b[0mcd /app && python - <<'PY'\r\nimport torch\r\nfrom transformers import AutoModelForSequenceClassification, AutoTokenizer\r\nfrom peft import PeftModel\r\nbase = AutoModelForSequenceClassification.from_pretrained('/app/model_cache/xlm-roberta-base').eval()\r\npeft = PeftModel.from_pretrained(base, '/app/adapter_download').eval()\r\nmerged = AutoModelForSequenceClassification.from_pretrained('/app/merged_model').eval()\r\ntok = AutoTokenizer.from_pretrained('/app/merged_model')\r\ntexts = [\"Bonjour, comment allez-vous aujourd'hui?\", \"Привет, как дела?\", \"こんにちは、お元気ですか？\", \"你好，你好吗？\", \"مرحبا، كيف حالك؟\"]\r\nwith torch.no_grad():\r\n    inp = tok(texts, return_tensors='pt', padding=True, truncation=True)\r\n    a = peft(**inp).logits\r\n    b = merged(**inp).logits\r\nprint('max logit diff:', (a-b).abs().max().item())\r\nprint('argmax equal:', torch.equal(a.argmax(-1), b.argmax(-1)))\r\nprint('peft argmax:', a.argmax(-1).tolist())\r\nprint('merged argmax:', b.argmax(-1).t"]
