[123.593147, "o", "\u001b[0m$ \u001b[0mcd /app && python - <<'PY'\r\nimport torch\r\nsd = torch.load('/app/adapter_download/adapter_model.bin', map_location='cpu', weights_only=False)\r\nprint(type(sd), len(sd))\r\nfor k in list(sd.keys())[:12]: print(k, tuple(sd[k].shape))\r\nprint('...')\r\nfor k in sd:\r\n    if 'classifier' in k: print(k, tuple(sd[k].shape))\r\nPY\r\n<class 'dict'> 52\r\nbase_model.model.roberta.encoder.layer.0.attention.self.query.lora_A.weight (8, 768)\r\nbase_model.model.roberta.encoder.layer.0.attention.self.query.lora_B.weight (768, 8)\r\nbase_model.model.roberta.encoder.layer.0.attention.self.value.lora_A.weight (8, 768)\r\nbase_model.model.roberta.encoder.layer.0.attention.self.value.lora_B.weight (768, 8)\r\nbase_model.model.roberta.encoder.layer.1.attention.self.query.lora_A.weight (8, 768)\r\nbase_model.model.roberta.encoder.layer.1.attention.self.query.lora_B.weight (768, 8)\r\nbase_model.model.roberta.encoder.layer.1.attention.self.value.lora_A.weight (8, 768)\r\nbase_model.model.roberta.encoder.layer.1.attention.self.value.lora_B.weight "]
