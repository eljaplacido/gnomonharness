[114.990341, "o", "\u001b[0m$ \u001b[0mcd /app && python - <<'PY'\r\nfrom huggingface_hub import snapshot_download\r\nfor repo, local in [\r\n (\"FacebookAI/xlm-roberta-base\", \"/app/model_cache/xlm-roberta-base\"),\r\n (\"dominguesm/xlm-roberta-base-lora-language-detection\", \"/app/adapter_download\"),\r\n]:\r\n    print(\"Downloading\", repo)\r\n    p = snapshot_download(repo_id=repo, local_dir=local)\r\n    print(\"->\", p)\r\nPY\r\nDownloading FacebookAI/xlm-roberta-base\r\n\rFetching 11 files:   0%|          | 0/11 [00:00<?, ?it/s]Warning: You are sending unauthenticated requests to the HF Hub. Please set a HF_TOKEN to enable higher rate limits and faster downloads.\r\n\rFetching 11 files:   9%|▉         | 1/11 [00:00<00:02,  4.20it/s]\rFetching 11 files:  18%|█▊        | 2/11 [00:00<00:02,  3.85it/s]\rFetching 11 files:  27%|██▋       | 3/11 [00:00<00:01,  4.12it/s]\rFetching 11 files:  36%|███▋      | 4/11 [00:01<00:02,  3.36it/s]\rFetching 11 files:  55%|█████▍    | 6/11 [00:01<00:00,  5.89it/s]\rFetching 11 files:  64%|██████"]
[114.990546, "o", "▎   | 7/11 [00:53<00:58, 14.58s/it]\rFetching 11 files:  73%|███████▎  | 8/11 [00:59<00:35, 11.92s/it]\rFetching 11 files:  82%|████████▏ | 9/11 [01:01<00:18,  9.09s/it]\rFetching 11 files:  91%|█████████ | 10/11 [01:04<00:07,  7.30s/it]\rFetching 11 files: 100%|██████████| 11/11 [01:09<00:00,  6.86s/it]\rFetching 11 files: 100%|██████████| 11/11 [01:09<00:00,  6.35s/it]\r\n-> /app/model_cache/xlm-roberta-base\r\nDownloading dominguesm/xlm-roberta-base-lora-language-detection\r\n\rFetching 8 files:   0%|          | 0/8 [00:00<?, ?it/s]\rFetching 8 files:  12%|█▎        | 1/8 [00:00<00:01,  6.65it/s]\rFetching 8 files:  62%|██████▎   | 5/8 [00:00<00:00, 22.47it/s]\rFetching 8 files: 100%|██████████| 8/8 [00:01<00:00,  5.18it/s]\rFetching 8 files: 100%|██████████| 8/8 [00:01<00:00,  6.04it/s]\r\n-> /app/adapter_download\r\n"]
