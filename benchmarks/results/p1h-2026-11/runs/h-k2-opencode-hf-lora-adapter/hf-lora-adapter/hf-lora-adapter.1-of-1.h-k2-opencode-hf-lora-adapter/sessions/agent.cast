[136.961346, "o", "\u001b[0m$ \u001b[0mcd /app && cat > /app/setup_language_detection.py <<'PY'\r\nimport json\r\nimport os\r\nimport torch\r\nfrom transformers import AutoConfig, AutoModelForSequenceClassification, AutoTokenizer\r\nfrom peft import PeftModel\r\n\r\nBASE_DIR = \"/app/model_cache/xlm-roberta-base\"\r\nADAPTER_DIR = \"/app/adapter_download\"\r\nMERGED_DIR = \"/app/merged_model\"\r\n\r\n# 1/2: Models are downloaded; load the adapter's model config for the 20-class label mapping.\r\nadapter_cfg = AutoConfig.from_pretrained(ADAPTER_DIR)\r\nid2label = {int(k): v for k, v in adapter_cfg.id2label.items()}\r\nlabel2id = {v: int(k) for k, v in id2label.items()}\r\n\r\n# 3: Configure the base model for 20-way sequence classification.\r\nconfig = AutoConfig.from_pretrained(BASE_DIR)\r\nconfig.architectures = [\"XLMRobertaForSequenceClassification\"]\r\nconfig.num_labels = 20\r\nconfig.id2label = id2label\r\nconfig.label2id = label2id\r\nconfig.problem_type = \"single_label_classification\"\r\n\r\nmodel = AutoModelForSequenceClassification.from_pretrained(\r\n    BASE_DIR, config=config, igno"]
[136.961533, "o", "re_mismatched_sizes=True\r\n)\r\ntokenizer = AutoTokenizer.from_pretrained(BASE_DIR)\r\n\r\n# 4: Save configured base model + tokenizer.\r\nmodel.save_pretrained(BASE_DIR, safe_serialization=True)\r\ntokenizer.save_pretrained(BASE_DIR)\r\nprint(\"Saved configured base model to\", BASE_DIR)\r\n\r\n# 5: Apply LoRA adapter.\r\nmodel = PeftModel.from_pretrained(model, ADAPTER_DIR, is_trainable=False)\r\nprint(\"Loaded LoRA adapter from\", ADAPTER_DIR)\r\n\r\n# 6: Merge LoRA into base weights and save.\r\nmodel = model.merge_and_unload()\r\nmodel.save_pretrained(MERGED_DIR, safe_serialization=True)\r\ntokenizer.save_pretrained(MERGED_DIR)\r\nprint(\"Saved merged model to\", MERGED_DIR)\r\n\r\n# 7: Test language detection using argmax of logits.\r\nsamples = [\r\n    \"Bonjour, comment allez-vous aujourd'hui?\",\r\n    \"Hola, ¿cómo estás hoy?\",\r\n    \"Guten Tag, wie geht es Ihnen?\",\r\n    \"Ciao, come stai oggi?\",\r\n    \"Olá, como você está?\",\r\n    \"Привет, как дела?\",\r\n    \"こんにちは、お元気ですか？\",\r\n    \"你好，你好吗？\",\r\n    "]
[136.961606, "o", "\"مرحبا، كيف حالك؟\",\r\n    \"Hello, how are you?\",\r\n]\r\n\r\n# Load the final saved merged model to verify the saved artifact works.\r\nmerged = AutoModelForSequenceClassification.from_pretrained(MERGED_DIR)\r\nmerged.eval()\r\n\r\nresults = []\r\nwith torch.no_grad():\r\n    for text in samples:\r\n        inputs = tokenizer(text, return_tensors=\"pt\", truncation=True, padding=True)\r\n        logits = merged(**inputs).logits\r\n        probs = torch.softmax(logits, dim=-1)\r\n        class_id = int(torch.argmax(logits, dim=-1).item())\r\n        confidence = float(probs[0, class_id].item())\r\n        results.append({\r\n            \"text\": text,\r\n            \"predicted_class_id\": class_id,\r\n            \"confidence\": confidence,\r\n        })\r\n        print(f\"{text!r} -> id={class_id} label={id2label.get(class_id)} conf={confidence:.4f}\")\r\n\r\nwith open(\"/app/detection_results.json\", \"w\", encoding=\"utf-8\") as f:\r\n    json.dump(results, f, ensure_ascii=False, indent=2)\r\nprint(\"Saved results to /app/detection_results.json\")\r\nPY\r\npyt"]
