[18.485445, "o", "\u001b[0m$ \u001b[0mhead -5 /usr/local/bin/pip; echo \"---PY-M-PIP---\"; python3 -m pip --version 2>&1; echo \"---ENSUREPIP---\"; python3 -m ensurepip --version 2>&1; echo \"---SITEDIRS---\"; python3 -c \"import site,sys; print('prefix:',sys.prefix); print('base:',sys.base_prefix); print('path:'); [print(' ',p) for p in sys.path]; print('usersite:',site.getusersitepackages())\" 2>&1\r\n#!/usr/local/bin/python3.13\r\n# -*- coding: utf-8 -*-\r\nimport re\r\nimport sys\r\nfrom pip._internal.cli.main import main\r\n---PY-M-PIP---\r\n/usr/local/bin/python3: No module named pip\r\n---ENSUREPIP---\r\npip 24.3.1\r\n---SITEDIRS---\r\nprefix: /usr/local\r\nbase: /usr/local\r\npath:\r\n  \r\n  /usr/local/lib/python313.zip\r\n  /usr/local/lib/python3.13\r\n  /usr/local/lib/python3.13/lib-dynload\r\n  /usr/local/lib/python3.13/site-packages\r\nusersite: /root/.local/lib/python3.13/site-packages\r\n"]
