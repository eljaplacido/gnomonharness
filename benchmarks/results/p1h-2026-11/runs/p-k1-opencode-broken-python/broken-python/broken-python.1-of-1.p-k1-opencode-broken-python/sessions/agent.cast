[15.057188, "o", "\u001b[0m$ \u001b[0menv | grep -iE 'python|pip|virtual|conda' 2>&1; echo \"---PIPCONF---\"; ls -la ~/.config/pip 2>&1; echo \"---USERCONF---\"; cat ~/.config/pip/pip.conf 2>&1; echo \"---LEGACY---\"; cat ~/.pip/pip.conf 2>&1; echo \"---GLOBAL---\"; cat /etc/pip.conf 2>&1\r\nPYTHON_SHA256=9cf9427bee9e2242e3877dd0f6b641c1853ca461f39d6503ce260a59c80bf0d9\r\nPYTHON_VERSION=3.13.1\r\n---PIPCONF---\r\nls: cannot access '/root/.config/pip': No such file or directory\r\n---USERCONF---\r\ncat: /root/.config/pip/pip.conf: No such file or directory\r\n---LEGACY---\r\ncat: /root/.pip/pip.conf: No such file or directory\r\n---GLOBAL---\r\ncat: /etc/pip.conf: No such file or directory\r\n"]
[15.161797, "o", "\u001b[0m$ \u001b[0mwhich -a python python3 pip pip3 2>&1; echo \"---VERSIONS---\"; python3 --version 2>&1; python --version 2>&1; echo \"---PIP---\"; pip3 --version 2>&1; pip --version 2>&1\r\n/usr/local/bin/python\r\n/usr/local/bin/python3\r\n/usr/bin/python3\r\n/bin/python3\r\n/usr/local/bin/pip\r\n/usr/local/bin/pip3\r\n---VERSIONS---\r\nPython 3.13.1\r\nPython 3.13.1\r\n---PIP---\r\nTraceback (most recent call last):\r\n  File \"/usr/local/bin/pip3\", line 5, in <module>\r\n    from pip._internal.cli.main import main\r\nModuleNotFoundError: No module named 'pip'\r\nTraceback (most recent call last):\r\n  File \"/usr/local/bin/pip\", line 5, in <module>\r\n    from pip._internal.cli.main import main\r\nModuleNotFoundError: No module named 'pip'\r\n"]
