[13.32069, "o", "\u001b[0m⚙ \u001b[0mexecute {\"code\":\"const r = await tools.shell({command: \\\"which -a python python3 pip pip3 2>&1; echo; python3 --version 2>&1; python --version 2>&1; echo; pip3 --version 2>&1; pip --version 2>&1\\\"});\\nreturn r;\\n\"} \r\n\u001b[0m⚙ \u001b[0mexecute {\"code\":\"const r = await tools.shell({command: \\\"env | grep -iE 'python|pip|virtual|conda' 2>&1; echo '--- ENV DONE ---'; ls -la ~/.config/pip 2>&1; echo '--- ---'; cat ~/.config/pip/pip.conf 2>&1; echo '--- ---'; cat ~/.pip/pip.conf 2>&1; echo '--- ---'; cat /etc/pip.conf 2>&1\\\"});\\nreturn r;\\n\"} \r\n"]
