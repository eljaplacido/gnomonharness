+def test_restock_adds_and_returns_new_level():
+    # Spec (before reading the body): restock(sku, qty) adds qty units and
+    # returns the resulting level.
+    #   Preconditions: qty > 0. The sku may or may not already be stocked.
+    #   Postconditions: the returned value equals the new level for sku, and
+    #     that level is the old level plus qty.
+    #   Undefined: nothing here asserts on types, on ordering of skus, or on
+    #     what a failed restock leaves behind (see the test below for the
+    #     one part of "qty must be positive" that is stated).
+    s = Stock()
+    assert s.restock("widget", 4) == 4          # sku not previously seen
+    assert s.restock("widget", 6) == 10         # sku already stocked
+    assert s.level("widget") == 10
+
+
+@pytest.mark.parametrize("qty", [0, -1])
+def test_restock_rejects_non_positive(qty):
+    # The task states qty "must be positive". The failure mode is not stated
+    # there, so this follows the contract the sibling method add() documents:
+    # ValueError. The level must be unchanged afterwards.
+    s = Stock()
+    s.add("gadget", 3)
+    with pytest.raises(ValueError):
+        s.restock("gadget", qty)
+    assert s.level("gadget") == 3
+
+
