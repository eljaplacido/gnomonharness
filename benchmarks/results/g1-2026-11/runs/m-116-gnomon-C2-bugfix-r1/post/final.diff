+# Regression: parse_qty accepted "0" and "-3", but a quantity is a *positive*
+# integer, so zero and negative input must be rejected the same way non-integer
+# input is.
+#
+# Preconditions: `text` is a string. (parse_qty's own contract already covers
+#   the "not an integer" case; these cases are integers, just not usable ones.)
+# Postconditions: parse_qty("0"), parse_qty("-3") and any other input whose
+#   integer value is <= 0 raise ValueError, and no quantity is returned.
+# Undefined behaviour (no assertions): the exception message, the exception
+#   type for subclasses of ValueError, and whether surrounding whitespace such
+#   as " 0 " is tolerated before the check -- only "must be positive" is
+#   specified, so only that is pinned here.
+@pytest.mark.parametrize("text", ["0", "-3", "-1", " 0 ", " -3 "])
+def test_parse_qty_rejects_zero_and_negative(text):
+    with pytest.raises(ValueError):
+        parse_qty(text)
+
+
+def test_parse_qty_accepts_positive():
+    # The fix must not over-reject: 1 is the smallest legal quantity.
+    assert parse_qty("1") == 1
+    assert parse_qty(" +1 ") == 1
+
+
