     s.add("gadget", 1)
     with pytest.raises(ValueError):
         s.remove("gadget", 2)
+
+
+def test_low_stock_is_sorted_and_excludes_threshold():
+    s = Stock()
+    s.add("widget", 2)
+    s.add("gadget", 5)
+    s.add("doohickey", 1)
+
+    assert s.low_stock(5) == ["doohickey", "widget"]
+
+
+def test_low_stock_empty_when_nothing_is_below():
+    s = Stock()
+    s.add("widget", 5)
+
+    assert s.low_stock(5) == []
+
+
+def test_low_stock_empty_for_empty_stock():
+    assert Stock().low_stock(1) == []
+
+
+def test_low_stock_includes_sku_removed_to_zero():
+    s = Stock()
+    s.add("widget", 1)
+    s.remove("widget", 1)
+
+    assert s.low_stock(1) == ["widget"]

