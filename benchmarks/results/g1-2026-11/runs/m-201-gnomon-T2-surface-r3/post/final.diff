diff --git a/src/inventory/report.py b/src/inventory/report.py
index 08f9f53..491ef4f 100644
--- a/src/inventory/report.py
+++ b/src/inventory/report.py
@@ -5,7 +5,10 @@ from .pricing import unit_price
 
 def render_report(stock):
     lines = ["sku       qty   value"]
-    for sku in stock.skus():
+    skus = stock.skus()
+    if not skus:
+        lines.append("(no items)")
+    for sku in skus:
         qty = stock.level(sku)
         lines.append(f"{sku:<9}{qty:>4}{unit_price(sku) * qty:>8.2f}")
     total = sum(unit_price(s) * stock.level(s) for s in stock.skus())
