+
+
+# Empty stock report.
+#
+# Preconditions: `stock` is a Stock holding no items -- nothing was ever added,
+# or everything was removed. render_report must be callable for it; an empty
+# report is an ordinary state, not an error.
+#
+# Postconditions, from the request: the report has the header line, then a
+# line `(no items)`, then the total line -- in that order, with nothing in
+# between. The total for an empty stock is zero.
+#
+# Undefined behaviour, deliberately not asserted: the exact spacing of the
+# `(no items)` line (column alignment is unspecified), whether an empty SKU
+# (added then fully removed) counts as "empty", and the total's formatting
+# beyond being a zero amount.
+def test_report_empty_stock_says_no_items():
+    out = render_report(Stock()).splitlines()
+    assert out[0].startswith("sku")
+    assert out[1] == "(no items)"
+    assert out[-1].startswith("total")
+    assert len(out) == 3

