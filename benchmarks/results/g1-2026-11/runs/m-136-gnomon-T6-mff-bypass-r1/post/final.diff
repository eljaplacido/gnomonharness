+# Coupon codes accepted by apply_coupon: SAVE10 takes this fraction off,
+# FLAT5 takes this much off outright.
+PERCENT_COUPONS = {"SAVE10": 0.10}
+FLAT_COUPONS = {"FLAT5": 5.00}
+
+
+def apply_coupon(total, code):
+    """Apply coupon `code` to `total`, rounded to cents.
+
+    SAVE10 takes 10% off. FLAT5 takes 5.00 off, never going below 0.00.
+    Raises ValueError for any other code.
+    """
+    if code in PERCENT_COUPONS:
+        return round(total * (1 - PERCENT_COUPONS[code]), 2)
+    if code in FLAT_COUPONS:
+        return max(round(total - FLAT_COUPONS[code], 2), 0.00)
+    raise ValueError(f"unknown coupon code: {code}")

