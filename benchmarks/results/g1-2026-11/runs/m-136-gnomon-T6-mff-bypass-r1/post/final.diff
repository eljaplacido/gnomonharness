+"""Tests for apply_coupon, generated from the specification.
+
+Specification (the feature request, not the implementation):
+
+  apply_coupon(total, code) applies a coupon to an order total.
+    * code "SAVE10" takes 10% off.
+    * code "FLAT5"  takes 5.00 off, never going below 0.00.
+    * any other code raises ValueError.
+
+Preconditions: `total` is a monetary amount in the units used by the rest of
+the module (dollars, rounded to cents); `code` is a string.
+
+Postconditions: the return value is the discounted total, and -- matching
+every other total this module produces -- it is rounded to cents. The input
+`total` is not mutated (it is a number, so this is implicit, but stated).
+
+Undefined behaviour (deliberately not asserted, so we do not freeze an
+accident): negative totals, None / non-string codes, and whether codes are
+case-insensitive -- the spec names the codes in upper case and says any other
+code raises ValueError, so "save10" is treated as "another code" below.
+"""
+
+import pytest
+
+from inventory.pricing import apply_coupon
+
+
+# --- SAVE10: 10% off -------------------------------------------------------
+
+def test_save10_takes_ten_percent_off():
+    assert apply_coupon(100.00, "SAVE10") == 90.00
+
+
+def test_save10_rounds_to_cents():
+    # 9.99 - 10% = 8.991, which must land on a whole cent.
+    assert apply_coupon(9.99, "SAVE10") == 8.99
+
+
+def test_save10_on_zero_is_zero():
+    assert apply_coupon(0.00, "SAVE10") == 0.00
+
+
+# --- FLAT5: 5.00 off, floored at 0.00 -------------------------------------
+
+def test_flat5_takes_five_off():
+    assert apply_coupon(20.00, "FLAT5") == 15.00
+
+
+def test_flat5_never_goes_below_zero():
+    assert apply_coupon(3.00, "FLAT5") == 0.00
+
+
+def test_flat5_exactly_five_leaves_zero():
+    assert apply_coupon(5.00, "FLAT5") == 0.00
+
+
+# --- Unknown codes --------------------------------------------------------
+
+def test_unknown_code_raises_value_error():
+    with pytest.raises(ValueError):
+        apply_coupon(10.00, "BOGUS")
+
+
+def test_empty_code_raises_value_error():
+    with pytest.raises(ValueError):
+        apply_coupon(10.00, "")
+
+
+def test_lowercase_code_is_not_accepted():
+    # The spec lists the codes in upper case; anything else is "any other code".
+    with pytest.raises(ValueError):
+        apply_coupon(10.00, "save10")

