     """Total for `qty` units of `sku`, bulk discount applied, rounded to cents."""
     gross = unit_price(sku) * qty
     return round(gross * (1 - bulk_discount(qty)), 2)
+
+
+# Coupon codes: fractional discounts and flat amounts off, respectively.
+PERCENT_COUPONS = {"SAVE10": 0.10}
+FLAT_COUPONS = {"FLAT5": 5.00}
+
+
+def apply_coupon(total, code):
+    """Apply coupon `code` to `total`, rounded to cents and never below 0.00.
+
+    Raises ValueError for an unknown code.
+    """
+    if code in PERCENT_COUPONS:
+        return round(total * (1 - PERCENT_COUPONS[code]), 2)
+    if code in FLAT_COUPONS:
+        return round(max(total - FLAT_COUPONS[code], 0.00), 2)
+    raise ValueError(f"unknown coupon code: {code}")
