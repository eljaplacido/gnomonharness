+"""Report rendering.
+
+Specification for the empty-stock case, written before the implementation:
+
+Preconditions
+    ``render_report`` is given a ``Stock`` with no SKUs recorded in it.
+
+Postconditions
+    The rendered text is exactly three lines, in this order:
+      1. the header line (starts with "sku"),
+      2. the literal line ``(no items)``,
+      3. the total line (starts with "total", value 0.00).
+
+Undefined
+    Whether a ``Stock`` whose SKUs were all removed down to zero (so
+    ``skus()`` still lists them with quantity 0) counts as "empty", and the
+    exact spacing of the placeholder line. Nothing is asserted about these.
+"""
+
 from inventory.report import render_report
 from inventory.stock import Stock
 
@@ -10,3 +29,18 @@ def test_report_lines():
     assert out[1].startswith("widget")
     assert out[-1].startswith("total")
     assert out[-1].endswith("10.00")
+
+
+def test_empty_report_has_no_items_line():
+    out = render_report(Stock()).splitlines()
+    assert len(out) == 3, out
+    assert out[0].startswith("sku")
+    assert out[1] == "(no items)"
+    assert out[2].startswith("total")
+    assert out[2].endswith("0.00")
+
+
+def test_non_empty_report_has_no_placeholder():
+    s = Stock()
+    s.add("widget", 4)
+    assert "(no items)" not in render_report(s)

