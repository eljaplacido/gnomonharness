+
+# Specification for line_total(sku, qty), taken from the docstring and the
+# requested behaviour -- not from the body of the function under test.
+#
+# Preconditions:
+#   - `sku` is a known SKU (unknown SKUs are a separate contract: KeyError).
+#   - `qty` is a number of units.
+# Postconditions:
+#   - qty < 1 raises ValueError: an order of zero or negative units is not a
+#     sale, and must not return 0 or a negative total.
+#   - qty >= 1 returns unit_price(sku) * qty with the bulk discount applied,
+#     rounded to cents (covered by the tests above).
+# Undefined behaviour (no assertions written for it):
+#   - non-integer qty (e.g. 2.5, "3", None).
+#   - an unknown sku passed together with qty < 1: the spec does not say
+#     whether KeyError or ValueError takes precedence.
+@pytest.mark.parametrize("qty", [0, -1, -10])
+def test_line_total_rejects_non_positive_qty(qty):
+    with pytest.raises(ValueError):
+        line_total("widget", qty)

