@@ -24,3 +24,21 @@ def line_total(sku, qty):
     """Total for `qty` units of `sku`, bulk discount applied, rounded to cents."""
     gross = unit_price(sku) * qty
     return round(gross * (1 - bulk_discount(qty)), 2)
+
+
+# Coupon codes accepted by apply_coupon.
+SAVE10_RATE = 0.10
+FLAT5_AMOUNT = 5.00
+
+
+def apply_coupon(total, code):
+    """Apply coupon `code` to `total`, rounded to cents.
+
+    "SAVE10" takes 10% off. "FLAT5" takes 5.00 off, never below 0.00.
+    Raises ValueError for any other code.
+    """
+    if code == "SAVE10":
+        return round(total * (1 - SAVE10_RATE), 2)
+    if code == "FLAT5":
+        return round(max(total - FLAT5_AMOUNT, 0.0), 2)
+    raise ValueError(f"unknown coupon code: {code}")
