+# line_total(sku, qty) -- specification for non-positive quantities.
+#
+# Preconditions: `sku` is a SKU in PRICES; `qty` is a number.
+# Postconditions: for qty == 0 and for every qty < 0, line_total raises
+#     ValueError -- a zero or negative order is not a valid order, so no total
+#     is produced and no price lookup result is returned.
+# Undefined: the exception message; the result for a non-integer qty; which
+#     error wins when the SKU is unknown *and* the qty is non-positive. Nothing
+#     below asserts on these.
+
+@pytest.mark.parametrize("qty", [0, -1, -7, -100])
+def test_line_total_rejects_zero_and_negative_qty(qty):
+    with pytest.raises(ValueError):
+        line_total("widget", qty)

