+def test_total_units_sums_all_levels():
+    # Precondition: several SKUs at different levels.
+    # Postcondition: total_units is the sum of every individual level.
+    s = Stock()
+    s.add("widget", 5)
+    s.add("gadget", 3)
+    s.remove("widget", 2)
+    assert s.total_units() == 6
+
+
+def test_total_units_of_empty_stock_is_zero():
+    # Precondition: no stock has been added.
+    # Postcondition: the sum over an empty set of levels is 0.
+    assert Stock().total_units() == 0

