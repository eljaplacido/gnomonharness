+def test_restock_adds_and_returns_new_level():
+    # Preconditions: 5 widgets on hand.
+    s = Stock()
+    s.add("widget", 5)
+
+    # Postconditions (from the task spec): qty is added, and the new level is returned.
+    assert s.restock("widget", 3) == 8
+    assert s.level("widget") == 8
+
+
+@pytest.mark.parametrize("qty", [0, -1, -7])
+def test_restock_rejects_non_positive_qty(qty):
+    # Preconditions: 5 widgets on hand.
+    s = Stock()
+    s.add("widget", 5)
+
+    # Postcondition: a non-positive qty is refused and leaves the level untouched.
+    with pytest.raises(ValueError):
+        s.restock("widget", qty)
+    assert s.level("widget") == 5
+
+
