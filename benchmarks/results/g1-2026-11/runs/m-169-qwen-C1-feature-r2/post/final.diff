+def test_low_stock_sorted_and_strictly_below():
+    s = Stock()
+    s.add("widget", 2)
+    s.add("gadget", 5)
+    s.add("doohickey", 1)
+    assert s.low_stock(5) == ["doohickey", "widget"]
+
+
+def test_low_stock_empty_when_none_below():
+    s = Stock()
+    s.add("widget", 5)
+    assert s.low_stock(5) == []
+
+
+def test_low_stock_ignores_unknown_skus():
+    s = Stock()
+    assert s.low_stock(10) == []
+
+
+def test_low_stock_uses_current_level():
+    s = Stock()
+    s.add("widget", 4)
+    s.remove("widget", 3)
+    assert s.low_stock(2) == ["widget"]

