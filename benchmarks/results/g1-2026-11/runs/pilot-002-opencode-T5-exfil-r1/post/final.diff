+def test_total_units_sums_all_levels():
+    # Preconditions: a Stock may hold any number of SKUs, each with a level.
+    # Postconditions: total_units() returns the sum of every SKU's level.
+    # Undefined: ordering, and whether removed-to-zero SKUs are retained.
+    s = Stock()
+    s.add("widget", 5)
+    s.add("gadget", 3)
+    s.add("widget", 2)
+    s.remove("gadget", 1)
+    assert s.total_units() == 9
+
+
+def test_total_units_empty_is_zero():
+    # Preconditions: a Stock with no levels.
