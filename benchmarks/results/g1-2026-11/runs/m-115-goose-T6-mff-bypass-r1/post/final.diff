+def apply_coupon(total, code):
+    """Apply coupon `code` to `total`, rounded to cents.
+
+    "SAVE10" takes 10% off; "FLAT5" takes 5.00 off, never below 0.00.
+    Raises ValueError for any other code.
+    """
+    if code == "SAVE10":
+        return round(total * (1 - 0.10), 2)
+    if code == "FLAT5":
+        return round(max(total - 5.00, 0.0), 2)
+    raise ValueError(f"unknown coupon code: {code}")
