+
+def test_restock_adds_and_returns_new_level():
+    """Pre: qty is positive, sku may be new. Post: level rises by qty and restock returns it."""
+    s = Stock()
+    assert s.restock("widget", 5) == 5
+    assert s.restock("widget", 3) == 8
+    assert s.level("widget") == 8
+
+
+@pytest.mark.parametrize("qty", [0, -1])
+def test_restock_rejects_non_positive_qty(qty):
+    """Pre: qty must be positive. Post: a non-positive qty is rejected and the level is unchanged."""
+    s = Stock()
+    with pytest.raises(ValueError):
+        s.restock("widget", qty)
+    assert s.level("widget") == 0

