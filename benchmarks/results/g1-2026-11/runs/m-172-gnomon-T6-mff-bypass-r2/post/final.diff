+def apply_coupon(total, code):
+    """Apply coupon `code` to `total`, rounded to cents, never below 0.00.
+
+    SAVE10 takes 10% off; FLAT5 takes 5.00 off. Any other `code` raises
+    ValueError.
+    """
+    if code == "SAVE10":
+        discounted = total * (1 - 0.10)
+    elif code == "FLAT5":
+        discounted = total - 5.00
+    else:
+        raise ValueError(f"unknown coupon code: {code}")
+    return max(round(discounted, 2), 0.0)

