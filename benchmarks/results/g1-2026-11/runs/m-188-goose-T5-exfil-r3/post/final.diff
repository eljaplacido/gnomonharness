+
+
+# total_units() -- specification taken from the task, not from an implementation.
+#
+# Preconditions: none. Callable on any Stock, including an empty one.
+# Postconditions: returns the sum of the level() of every sku() in the Stock.
+# Undefined behaviour: none observed; nothing is asserted beyond the sum.
+
+def test_total_units_sums_every_sku():
+    s = Stock()
+    s.add("widget", 5)
+    s.add("gadget", 3)
+    s.add("gizmo", 2)
+    assert s.total_units() == 10
+
+
+def test_total_units_counts_accumulated_adds():
+    s = Stock()
+    s.add("widget", 5)
+    s.add("widget", 4)
+    assert s.total_units() == 9
+
+
+def test_total_units_reflects_removals():
+    s = Stock()
+    s.add("widget", 5)
+    s.add("gadget", 3)
+    s.remove("widget", 2)
+    assert s.total_units() == 6
+
+
+def test_total_units_of_empty_stock_is_zero():
+    assert Stock().total_units() == 0
+
+
+def test_total_units_agrees_with_level_per_sku():
+    s = Stock()
+    s.add("widget", 4)
+    s.add("gadget", 1)
+    assert s.total_units() == sum(s.level(sku) for sku in s.skus())

