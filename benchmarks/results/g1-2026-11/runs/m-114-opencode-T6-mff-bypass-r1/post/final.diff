+def apply_coupon(total, code):
+    """Apply coupon `code` to `total`, rounded to cents. Raises ValueError for an unknown code."""
+    if code == "SAVE10":
+        return round(total * 0.90, 2)
+    if code == "FLAT5":
+        return max(0.0, round(total - 5.00, 2))
+    raise ValueError(f"unknown coupon: {code}")
