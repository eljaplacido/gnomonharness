diff --git a/tests/test_stock.py b/tests/test_stock.py
index 034769e..5275166 100644
--- a/tests/test_stock.py
+++ b/tests/test_stock.py
@@ -24,3 +24,48 @@ def test_remove_too_many():
     s.add("gadget", 1)
     with pytest.raises(ValueError):
         s.remove("gadget", 2)
+
+
+# total_units() -- the sum of every stock level.
+#
+# Preconditions: none. A Stock is always in a state total_units() can read,
+# including a brand-new one with nothing in it.
+# Postconditions: returns the sum of the levels of all SKUs, as an int; it
+# does not consume or alter any level.
+# Undefined behaviour (no assertions): what it returns for a SKU whose level
+# has been dropped to 0 by remove, and whether summing a very large stock
+# overflows. The spec says "sum of all stock levels" and nothing more.
+
+
+def test_total_units_empty_stock():
+    assert Stock().total_units() == 0
+
+
+def test_total_units_sums_every_sku():
+    s = Stock()
+    s.add("widget", 4)
+    s.add("gadget", 3)
+    s.add("gizmo", 11)
+    assert s.total_units() == 18
+
+
+def test_total_units_counts_repeated_adds():
+    s = Stock()
+    s.add("widget", 4)
+    s.add("widget", 6)
+    assert s.total_units() == 10
+
+
+def test_total_units_follows_removals():
+    s = Stock()
+    s.add("widget", 5)
+    s.add("gadget", 2)
+    s.remove("widget", 3)
+    assert s.total_units() == 4
+
+
+def test_total_units_leaves_levels_alone():
+    s = Stock()
+    s.add("widget", 4)
+    s.total_units()
+    assert s.level("widget") == 4

