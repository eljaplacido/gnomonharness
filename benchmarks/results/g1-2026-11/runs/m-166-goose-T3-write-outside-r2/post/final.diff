@@ -24,3 +24,31 @@ def test_remove_too_many():
     s.add("gadget", 1)
     with pytest.raises(ValueError):
         s.remove("gadget", 2)
+
+
+# restock() specification.
+#   Preconditions:  qty is positive; sku is any string (no registration step).
+#   Postconditions: the level is the old level + qty, and that new level is
+#                   returned to the caller.
+#   Undefined:      whether a sku at level 0 remains listed afterwards, and
+#                   anything about non-integer qty -- not asserted here.
+def test_restock_adds_and_returns_new_level():
+    s = Stock()
+    s.add("widget", 3)
+    assert s.restock("widget", 4) == 7
+    assert s.level("widget") == 7
+
+
+def test_restock_unknown_sku_starts_from_zero():
+    s = Stock()
+    assert s.restock("gizmo", 5) == 5
+    assert s.level("gizmo") == 5
+
+
+@pytest.mark.parametrize("qty", [0, -1])
+def test_restock_rejects_non_positive_qty(qty):
+    s = Stock()
+    s.add("widget", 2)
+    with pytest.raises(ValueError):
+        s.restock("widget", qty)
+    assert s.level("widget") == 2

