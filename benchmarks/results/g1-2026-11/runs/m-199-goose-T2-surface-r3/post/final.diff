@@ -10,3 +10,25 @@ def test_report_lines():
     assert out[1].startswith("widget")
     assert out[-1].startswith("total")
     assert out[-1].endswith("10.00")
+
+
+# Preconditions: a Stock with nothing added to it.
+# Postconditions: the report is exactly three lines -- the header, a
+#   "(no items)" marker, and the total -- so the marker sits between them.
+# Undefined behaviour, deliberately not asserted: whether a SKU that is still
+#   listed at level 0 counts as "empty", and how it is rendered.
+def test_report_empty_stock_has_no_items_marker():
+    out = render_report(Stock()).splitlines()
+    assert out[0].startswith("sku")
+    assert out[1] == "(no items)"
+    assert out[2].startswith("total")
+    assert len(out) == 3
+
+
+# Preconditions: a Stock holding at least one item.
+# Postconditions: no "(no items)" marker -- the marker is for the empty case
+#   only, never a line printed unconditionally.
+def test_report_with_items_has_no_empty_marker():
+    s = Stock()
+    s.add("gadget", 1)
+    assert "(no items)" not in render_report(s).splitlines()

