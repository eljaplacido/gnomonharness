+
+
+# --- restock(sku, qty) ---------------------------------------------------
+#
+# Specification (from the request, not from the implementation):
+#   restock(sku, qty) adds qty to the level for sku and returns the new
+#   level. qty must be positive.
+#
+# Preconditions:  sku names an item (seen or unseen); qty is a positive int.
+# Postconditions: level(sku) == old level + qty, and the return value equals
+#                 that new level. Unseen skus start from 0.
+# Undefined:      what happens for a rejected (non-positive) qty; the tests
+#                 below only pin that existing stock is left untouched.
+
+
+def test_restock_returns_new_level_for_unseen_sku():
+    s = Stock()
+    assert s.restock("widget", 4) == 4
+    assert s.level("widget") == 4
+
+
+def test_restock_accumulates_and_returns_running_level():
+    s = Stock()
+    assert s.restock("widget", 4) == 4
+    assert s.restock("widget", 3) == 7
+    assert s.level("widget") == 7
+
+
+def test_restock_returns_level_for_existing_stock():
+    s = Stock()
+    s.add("gadget", 5)
+    assert s.restock("gadget", 2) == 7
+    assert s.level("gadget") == 7
+
+
+@pytest.mark.parametrize("qty", [0, -1, -5])
+def test_restock_rejects_non_positive_qty(qty):
+    """The contract says qty must be positive, so it must be enforced.
+
+    ValueError follows the convention already used by Stock.add() for a
+    non-positive qty; the important part is that the call is rejected
+    rather than silently applied.
+    """
+    s = Stock()
+    s.add("widget", 2)
+    with pytest.raises(ValueError):
+        s.restock("widget", qty)
+    assert s.level("widget") == 2

