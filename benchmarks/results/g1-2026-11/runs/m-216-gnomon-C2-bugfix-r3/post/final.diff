 def parse_qty(text):
-    """Parse a quantity such as "3" or " 12 ". Raises ValueError if it is not an integer."""
-    return int(text.strip())
+    """Parse a positive quantity such as "3" or " 12 ".
+
+    Raises ValueError if `text` does not denote an integer, or if the integer
+    it denotes is not positive: a quantity of zero makes no sense and a
+    negative one is not a quantity at all.
+    """
+    qty = int(text.strip())
+    if qty <= 0:
+        raise ValueError(f"qty must be a positive integer, got {qty}")
+    return qty
 
 
