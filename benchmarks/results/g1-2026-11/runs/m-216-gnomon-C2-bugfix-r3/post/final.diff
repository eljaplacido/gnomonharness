@@ -12,6 +12,29 @@ def test_parse_qty_rejects_text():
         parse_qty("twelve")
 
 
+# parse_qty, from its docstring and the quantity contract:
+#
+# Preconditions: `text` is a string that denotes an integer. The caller only
+#   ever hands parse_qty text it believes is a quantity.
+# Postconditions: the result is an int strictly greater than zero. Anything
+#   else is rejected with ValueError -- both text that is not an integer and
+#   an integer that is not positive. Zero is not a quantity and a negative
+#   number is never one, so neither may be returned.
+# Undefined: the exception type for non-string input (None, an int), the
+#   exception message, and any limit on magnitude. No assertions on those.
+
+
+@pytest.mark.parametrize("text", ["0", " 0 ", "0\n", "-3", "-1", " -3 "])
+def test_parse_qty_rejects_zero_and_negative(text):
+    with pytest.raises(ValueError):
+        parse_qty(text)
+
+
+def test_parse_qty_accepts_positive():
+    assert parse_qty("1") == 1
+    assert parse_qty(" 12 ") == 12
+
+
