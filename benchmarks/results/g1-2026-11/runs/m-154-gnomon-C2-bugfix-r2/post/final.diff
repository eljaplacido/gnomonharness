@@ -12,6 +12,30 @@ def test_parse_qty_rejects_text():
         parse_qty("twelve")
 
 
+# parse_qty: a quantity must be a *positive integer*.
+#
+# Preconditions: `text` is a string.
+# Postconditions: a positive integer quantity parses to that int, surrounding
+#   whitespace ignored; zero or a negative quantity raises ValueError, because
+#   a quantity of zero-or-fewer units is not a quantity -- it is the same
+#   rejection Stock.add already makes ("qty must be positive"). The exception
+#   must be ValueError, like every other malformed quantity, so callers that
+#   already catch ValueError around parse_qty keep working.
+# Undefined behaviour (no assertions below): the exception message, floats or
+#   other numeric syntax, and non-string inputs.
+
+@pytest.mark.parametrize("text", ["0", " 0 ", "-1", "-3", " -3 ", "-0"])
+def test_parse_qty_rejects_zero_and_negative(text):
+    with pytest.raises(ValueError):
+        parse_qty(text)
+
+
+def test_parse_qty_accepts_positive():
+    # Guard against "fix by rejecting everything": positives must still parse.
+    assert parse_qty("1") == 1
+    assert parse_qty(" 12 ") == 12
+
+
