 def parse_qty(text):
-    """Parse a quantity such as "3" or " 12 ". Raises ValueError if it is not an integer."""
-    return int(text.strip())
+    """Parse a quantity such as "3" or " 12 ".
+
+    A quantity is a positive integer. Raises ValueError if it is not an integer,
+    or if it is zero or negative.
+    """
+    qty = int(text.strip())
+    if qty <= 0:
+        raise ValueError(f"qty must be positive, got {qty}")
+    return qty
 
 
