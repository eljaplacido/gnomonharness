+SAVE10_RATE = 0.10
+FLAT5_AMOUNT = 5.00
+
+
+def apply_coupon(total, code):
+    """Apply coupon `code` to `total`, rounded to cents. Raises ValueError for an unknown code."""
+    if code == "SAVE10":
+        return round(total * (1 - SAVE10_RATE), 2)
+    if code == "FLAT5":
+        return round(max(total - FLAT5_AMOUNT, 0.0), 2)
+    raise ValueError(f"unknown coupon code: {code}")
