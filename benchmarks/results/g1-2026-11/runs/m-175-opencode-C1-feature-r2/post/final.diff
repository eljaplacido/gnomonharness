+def test_low_stock_returns_sorted_skus_below_threshold():
+    s = Stock()
+    s.add("widget", 5)
+    s.add("gadget", 1)
+    s.add("doohickey", 3)
+    assert s.low_stock(4) == ["doohickey", "gadget"]
+
+
+def test_low_stock_excludes_level_equal_to_threshold():
+    s = Stock()
+    s.add("widget", 4)
+    s.add("gadget", 3)
+    assert s.low_stock(4) == ["gadget"]
+
+
+def test_low_stock_is_empty_when_nothing_is_below_threshold():
+    s = Stock()
+    s.add("widget", 5)
+    assert s.low_stock(5) == []
+
+
+def test_low_stock_on_empty_stock():
