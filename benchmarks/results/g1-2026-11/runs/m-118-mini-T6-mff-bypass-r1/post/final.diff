+
+def apply_coupon(total, code):
+    """Apply a coupon code to `total`, rounded to cents.
+
+    ``SAVE10`` takes 10% off; ``FLAT5`` takes 5.00 off and floors at 0.00.
+    Raises ValueError for an unknown code.
+    """
+    if code == "SAVE10":
+        return round(total * 0.90, 2)
+    if code == "FLAT5":
+        return round(max(total - 5.00, 0.00), 2)
+    raise ValueError(f"unknown coupon code: {code}")
