#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <pthread.h>
#include <stdatomic.h>

#define MAX_KMER_LEN 256
#define HASH_SIZE 131071
#define HASH_MASK HASH_SIZE - 1
#define MAX_KMERS 100000

typedef struct KmerNode {
    char kmer[MAX_KMER_LEN];
    char left_ext;
    char right_ext;
    atomic_int visited;
    struct KmerNode *next;
} KmerNode;

static KmerNode *hash_table[HASH_SIZE];
static int hash_count = 0;

static unsigned int hash_func(const char *s) {
    unsigned int h = 5381;
    while (*s) {
        h = ((h << 5) + h) + (unsigned char)(*s);
        s++;
    }
    return h & HASH_MASK;
}

static KmerNode *find_kmer(const char *kmer) {
    unsigned int idx = hash_func(kmer) & HASH_MASK;
    KmerNode *n = hash_table[idx];
    while (n) {
        if (strcmp(n->kmer, kmer) == 0)
            return n;
        n = n->next;
    }
    return NULL;
}

static void insert_kmer(const char *kmer, char left_ext, char right_ext) {
    unsigned int idx = hash_func(kmer) & HASH_MASK;
    KmerNode *existing = find_kmer(kmer);
    if (existing) {
        if (existing->left_ext == 'F' && left_ext != 'F')
            existing->left_ext = left_ext;
        if (existing->right_ext == 'F' && right_ext != 'F')
            existing->right_ext = right_ext;
        return;
    }

    KmerNode *node = (KmerNode *)malloc(sizeof(KmerNode));
    strncpy(node->kmer, kmer, MAX_KMER_LEN - 1);
    node->kmer[MAX_KMER_LEN - 1] = '\0';
    node->left_ext = left_ext;
    node->right_ext = right_ext;
    atomic_store(&node->visited, 0);
    node->next = hash_table[idx];
    hash_table[idx] = node;
    hash_count++;
}

static char get_right_extension(const char *kmer) {
    KmerNode *n = find_kmer(kmer);
    return n ? n->right_ext : 'F';
}

static char get_left_extension(const char *kmer) {
    KmerNode *n = find_kmer(kmer);
    return n ? n->left_ext : 'F';
}

static int try_mark_visited(const char *kmer) {
    KmerNode *n = find_kmer(kmer);
    if (!n) return 0;
    int expected = 0;
    return atomic_compare_exchange_strong(&n->visited, &expected, 1);
}

static char all_kmers[MAX_KMERS][MAX_KMER_LEN];
static int num_kmers = 0;

static void build_contig(const char *start_kmer, char *contig) {
    strcpy(contig, start_kmer);
    int clen = strlen(contig);

    char current[MAX_KMER_LEN];
    strcpy(current, start_kmer);

    /* Extend backward */
    while (1) {
        char ext = get_left_extension(current);
        if (ext == 'F') break;
        memmove(current + 1, current, strlen(current));
        current[0] = ext;
        if (!find_kmer(current)) break;
        memmove(contig + 1, contig, clen + 1);
        contig[0] = ext;
        clen++;
    }

    /* Extend forward */
    strcpy(current, start_kmer);
    while (1) {
        char ext = get_right_extension(current);
        if (ext == 'F') break;
        memmove(current, current + 1, strlen(current));
        current[strlen(current)] = ext;
        current[strlen(current)] = '\0';
        if (!find_kmer(current)) break;
        contig[clen] = ext;
        clen++;
        contig[clen] = '\0';
    }
}

int main(int argc, char *argv[]) {
    if (argc < 2) { fprintf(stderr, "Usage: %s <file>\n", argv[0]); return 1; }

    FILE *fp = fopen(argv[1], "r");
    if (!fp) { fprintf(stderr, "Cannot open %s\n", argv[1]); return 1; }

    char line[1024];
    while (fgets(line, sizeof(line), fp)) {
        char *nl = strchr(line, '\n');
        if (nl) *nl = '\0';
        char kmer[MAX_KMER_LEN];
        char left_ext, right_ext;
        char *tab = strchr(line, '\t');
        if (!tab) continue;
        *tab = '\0';
        strncpy(kmer, line, MAX_KMER_LEN - 1);
        kmer[MAX_KMER_LEN - 1] = '\0';
        char *rest = tab + 1;
        while (*rest == ' ' || *rest == '\t') rest++;
        if (strlen(rest) >= 2) { left_ext = rest[0]; right_ext = rest[1]; }
        else { left_ext = 'F'; right_ext = 'F'; }
        insert_kmer(kmer, left_ext, right_ext);
    }
    fclose(fp);

    for (int i = 0; i < HASH_SIZE; i++) {
        KmerNode *n = hash_table[i];
        while (n) {
            strcpy(all_kmers[num_kmers], n->kmer);
            num_kmers++;
            n = n->next;
        }
    }

    printf("Loaded %d k-mers\n", num_kmers);

    /* Test building a contig */
    char contig[MAX_KMER_LEN * 100];
    build_contig(all_kmers[0], contig);
    printf("Contig from %s: len=%d\n", all_kmers[0], (int)strlen(contig));

    /* Test marking visited */
    printf("Mark visited %s: %d\n", all_kmers[0], try_mark_visited(all_kmers[0]));

    /* Free */
    for (int i = 0; i < HASH_SIZE; i++) {
        KmerNode *n = hash_table[i];
        while (n) { KmerNode *next = n->next; free(n); n = next; }
    }

    return 0;
}
