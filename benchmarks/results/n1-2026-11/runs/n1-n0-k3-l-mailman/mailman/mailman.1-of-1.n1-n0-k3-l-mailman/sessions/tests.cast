[9.472593, "o", "    \u001b[0m\u001b[94mraise\u001b[39;49;00m exceptions[\u001b[94m0\u001b[39;49;00m]\u001b[90m\u001b[39;49;00m\r\n_ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ \r\n\r\n"]
[9.472617, "o", "address = ('localhost', 25), timeout = <object object at 0xe1cfebdc1200>, source_address = None\r\n\r\n"]
[9.473134, "o", "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mcreate_connection\u001b[39;49;00m(address, timeout=_GLOBAL_DEFAULT_TIMEOUT,\u001b[90m\u001b[39;49;00m\r\n                          source_address=\u001b[94mNone\u001b[39;49;00m, *, all_errors=\u001b[94mFalse\u001b[39;49;00m):\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"Connect to *address* and return the socket object.\u001b[39;49;00m\r\n    \u001b[33m\u001b[39;49;00m\r\n"]
[9.473145, "o", "    \u001b[33m    Convenience function.  Connect to *address* (a 2-tuple ``(host,\u001b[39;49;00m\r\n    \u001b[33m    port)``) and return the socket object.  Passing the optional\u001b[39;49;00m\r\n    \u001b[33m    *timeout* parameter will set the timeout on the socket instance\u001b[39;49;00m\r\n    \u001b[33m    before attempting to connect.  If no *timeout* is supplied, the\u001b[39;49;00m\r\n    \u001b[33m    global default timeout setting returned by :func:`getdefaulttimeout`\u001b[39;49;00m\r\n"]
[9.473166, "o", "    \u001b[33m    is used.  If *source_address* is set it must be a tuple of (host, port)\u001b[39;49;00m\r\n    \u001b[33m    for the socket to bind as a source address before making the connection.\u001b[39;49;00m\r\n    \u001b[33m    A host of '' or port 0 tells the OS to use the default. When a connection\u001b[39;49;00m\r\n    \u001b[33m    cannot be created, raises the last error if *all_errors* is False,\u001b[39;49;00m\r\n    \u001b[33m    and an ExceptionGroup of all errors if *all_errors* is True.\u001b[39;49;00m\r\n    \u001b[33m    \"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m"]
[9.473177, "o", "\r\n    \u001b[90m\u001b[39;49;00m\r\n        host, port = address\u001b[90m\u001b[39;49;00m\r\n        exceptions = []\u001b[90m\u001b[39;49;00m\r\n        \u001b[94mfor\u001b[39;49;00m res \u001b[95min\u001b[39;49;00m getaddrinfo(host, port, \u001b[94m0\u001b[39;49;00m, SOCK_STREAM):\u001b[90m\u001b[39;49;00m\r\n            af, socktype, proto, canonname, sa = res\u001b[90m\u001b[39;49;00m\r\n            sock = \u001b[94mNone\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n            \u001b[94mtry\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\r\n"]
[9.473189, "o", "                sock = socket(af, socktype, proto)\u001b[90m\u001b[39;49;00m\r\n                \u001b[94mif\u001b[39;49;00m timeout \u001b[95mis\u001b[39;49;00m \u001b[95mnot\u001b[39;49;00m _GLOBAL_DEFAULT_TIMEOUT:\u001b[90m\u001b[39;49;00m\r\n                    sock.settimeout(timeout)\u001b[90m\u001b[39;49;00m\r\n                \u001b[94mif\u001b[39;49;00m source_address:\u001b[90m\u001b[39;49;00m\r\n                    sock.bind(source_address)\u001b[90m\u001b[39;49;00m\r\n"]
