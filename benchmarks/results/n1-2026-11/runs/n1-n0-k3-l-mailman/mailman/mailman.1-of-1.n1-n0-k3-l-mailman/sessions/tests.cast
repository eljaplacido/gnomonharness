[9.456944, "o", "\u001b[31m\u001b[1m__________________________________________________________________ test_simple_local_delivery __________________________________________________________________\u001b[0m\r\n\r\n"]
[9.46935, "o", "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mtest_simple_local_delivery\u001b[39;49;00m():\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"Test that postfix can deliver mail to local users\u001b[39;49;00m\r\n    \u001b[33m    and that the email content is accessible in their local mailboxes.\u001b[39;49;00m\r\n    \u001b[33m    \"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        user = \u001b[33m\"\u001b[39;49;00m\u001b[33mbobgreen\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        add_user(user)\u001b[90m\u001b[39;49;00m\r\n        mbox_path = \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m/var/mail/\u001b[39;49;00m\u001b[33m{\u001b[39;49;00muser\u001b[33m}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        subject = \u001b[33m\"\u001b[39;49;00m\u001b[33mDirect Message\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n>       send_email(\u001b[90m\u001b[39;49;00m\r\n            from_addr=\u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m{\u001b[39;49;00muser\u001b[33m}\u001b[39;49;00m\u001b[33m@\u001b[39;49;00m\u001b[33m{\u001b[39;49;00mDOMAIN_NAME\u001b[33m}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\r\n            to_addr=\u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m{\u001b[39;49;00muser\u001b[33m}\u001b[39;49;00m\u001b[33m@\u001b[39;49;00m\u001b[33m{\u001b[39;49;00mDOMAIN_NAME\u001b[33m}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\r\n            subject=subject,\u001b[90m\u001b[39;49;00m\r\n"]
[9.469391, "o", "            body=\u001b[33m\"\u001b[39;49;00m\u001b[33mDirect test message\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\r\n        )\u001b[90m\u001b[39;49;00m\r\n\r\n\u001b[1m\u001b[31m/tests/test_outputs.py\u001b[0m:144: \r\n_ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ \r\n\u001b[1m\u001b[31m/tests/test_outputs.py\u001b[0m:89: in send_email\r\n"]
[9.469577, "o", "    \u001b[0m\u001b[94mwith\u001b[39;49;00m smtplib.SMTP(\u001b[33m\"\u001b[39;49;00m\u001b[33mlocalhost\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[94m25\u001b[39;49;00m) \u001b[94mas\u001b[39;49;00m server:\u001b[90m\u001b[39;49;00m\r\n         ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\u001b[90m\u001b[39;49;00m\r\n"]
[9.469589, "o", "\u001b[1m\u001b[31m/usr/lib/python3.12/smtplib.py\u001b[0m:255: in __init__\r\n"]
[9.469765, "o", "    \u001b[0m(code, msg) = \u001b[96mself\u001b[39;49;00m.connect(host, port)\u001b[90m\u001b[39;49;00m\r\n                  ^^^^^^^^^^^^^^^^^^^^^^^^\u001b[90m\u001b[39;49;00m\r\n\u001b[1m\u001b[31m/usr/lib/python3.12/smtplib.py\u001b[0m:341: in connect\r\n"]
[9.470004, "o", "    \u001b[0m\u001b[96mself\u001b[39;49;00m.sock = \u001b[96mself\u001b[39;49;00m._get_socket(host, port, \u001b[96mself\u001b[39;49;00m.timeout)\u001b[90m\u001b[39;49;00m\r\n                ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\u001b[90m\u001b[39;49;00m\r\n\u001b[1m\u001b[31m/usr/lib/python3.12/smtplib.py\u001b[0m:312: in _get_socket\r\n"]
[9.470086, "o", "    \u001b[0m\u001b[94mreturn\u001b[39;49;00m socket.create_connection((host, port), timeout,\u001b[90m\u001b[39;49;00m\r\n\u001b[1m\u001b[31m/usr/lib/python3.12/socket.py\u001b[0m:852: in create_connection\r\n"]
[9.470125, "o", "    \u001b[0m\u001b[94mraise\u001b[39;49;00m exceptions[\u001b[94m0\u001b[39;49;00m]\u001b[90m\u001b[39;49;00m\r\n_ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ \r\n\r\n"]
[9.470165, "o", "address = ('localhost', 25), timeout = <object object at 0xe1cfebdc1200>, source_address = None\r\n\r\n"]
[9.470687, "o", "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mcreate_connection\u001b[39;49;00m(address, timeout=_GLOBAL_DEFAULT_TIMEOUT,\u001b[90m\u001b[39;49;00m\r\n                          source_address=\u001b[94mNone\u001b[39;49;00m, *, all_errors=\u001b[94mFalse\u001b[39;49;00m):\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"Connect to *address* and return the socket object.\u001b[39;49;00m\r\n    \u001b[33m\u001b[39;49;00m\r\n    \u001b[33m    Convenience function.  Connect to *address* (a 2-tuple ``(host,\u001b[39;49;00m\r\n"]
[9.470708, "o", "    \u001b[33m    port)``) and return the socket object.  Passing the optional\u001b[39;49;00m\r\n    \u001b[33m    *timeout* parameter will set the timeout on the socket instance\u001b[39;49;00m\r\n    \u001b[33m    before attempting to connect.  If no *timeout* is supplied, the\u001b[39;49;00m\r\n    \u001b[33m    global default timeout setting returned by :func:`getdefaulttimeout`\u001b[39;49;00m\r\n    \u001b[33m    is used.  If *source_address* is set it must be a tuple of (host, port)\u001b[39;49;00m\r\n    \u001b[33m    for the socket to bind as a source address before making the connection.\u001b[39;49;00m\r\n"]
[9.47073, "o", "    \u001b[33m    A host of '' or port 0 tells the OS to use the default. When a connection\u001b[39;49;00m\r\n    \u001b[33m    cannot be created, raises the last error if *all_errors* is False,\u001b[39;49;00m\r\n    \u001b[33m    and an ExceptionGroup of all errors if *all_errors* is True.\u001b[39;49;00m\r\n    \u001b[33m    \"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        host, port = address\u001b[90m\u001b[39;49;00m\r\n        exceptions = []\u001b[90m\u001b[39;49;00m\r\n        \u001b[94mfor\u001b[39;49;00m res \u001b[95min\u001b[39;49;00m getaddrinfo(host, port, \u001b[94m0\u001b[39;49;00m, SOCK_STREAM):\u001b[90m\u001b[39;49;00m\r\n"]
