[11.640075, "o", "\u001b[?2004h"]
[11.640119, "o", "> "]
[11.640158, "o", "   '\"'\"'/app/jq_args.yaml'\"'\"' Example format:\r\n\u001b[?2004l\r\u001b[?2004h"]
[11.640167, "o", "> "]
[11.640219, "o", "   ```\r\n\u001b[?2004l\r\u001b[?2004h> "]
