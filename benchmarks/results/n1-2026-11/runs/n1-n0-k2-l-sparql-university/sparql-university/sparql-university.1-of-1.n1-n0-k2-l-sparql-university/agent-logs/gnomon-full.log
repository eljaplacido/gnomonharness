from rdflib import Graph, Namespace, URIRef
from datetime import date

g = Graph()
g.parse("/app/university_graph.ttl", format="turtle")
uni = Namespace("http://university.org/ontology/")

# Check STS101 enrollments for Aristotle Tympas
sts101 = URIRef("http://university.org/ontology/STS101")
count = 0
for s, _, _ in g.triples((None, uni.isEnrolledIn, sts101)):
    name = None
    for _, _, n in g.triples((s, uni.hasName, None)):
        name = str(n)
    enroll_date = None
    grad_date = None
    for _, _, ed in g.triples((s, uni.hasEnrollmentDate, None)):
        enroll_date = str(ed)
    for _, _, gd in g.triples((s, uni.hasGraduationDate, None)):
        grad_date = str(gd)
    ref = date(2025, 8, 16)
    enrolled = False
    if enroll_date:
        ed = date.fromisoformat(enroll_date)
        if ed < ref:
            if grad_date is None:
                enrolled = True
            else:
                gd = date.fromisoformat(grad_date)
                if gd >= ref:
                    enrolled = True
    if enrolled:
        count += 1
        print(f"  {name}: enrolled")
    else:
        print(f"  {name}: NOT enrolled (enroll={enroll_date}, grad={grad_date})")
print(f"Total STS101 currently enrolled: {count}")

# Now let's check what the SPARQL subquery counts for Aristotle
print("\n=== SPARQL count for Aristotle ===")
subquery = """
PREFIX uni: <http://university.org/ontology/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema/>

SELECT ?student (COUNT(DISTINCT ?student) AS ?cnt)
WHERE {
  uni:Aristotle_Tympas uni:worksIn ?dept .
  ?course uni:isTaughtIn ?dept .
  ?student uni:isEnrolledIn ?course ;
           uni:hasEnrollmentDate ?enrollDate .
  FILTER(?enrollDate < "2025-08-16"^^xsd:date)
  OPTIONAL { ?student uni:hasGraduationDate ?gradDate }
  FILTER(!BOUND(?gradDate) || ?gradDate >= "2025-08-16"^^xsd:date)
}
GROUP BY ?student
"""
for row in g.query(subquery):
    print(f"  Student: {row.student}, Count: {row.cnt}")

# Total count
total = 0
for row in g.query(subquery):
    total += 1
print(f"Total distinct students: {total}")
