from rdflib import Graph, Namespace, URIRef

g = Graph()
g.parse("/app/university_graph.ttl", format="turtle")
uni = Namespace("http://university.org/ontology/")

# Try a different approach: use a subquery that returns professor URIs
# who have at least one department with >10 students
print("=== Subquery returning professor URIs ===")
q = """
PREFIX uni: <http://university.org/ontology/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema/>

SELECT ?professor
WHERE {
  ?professor a uni:Person .
  FILTER EXISTS {
    SELECT ?p WHERE {
      ?p uni:worksIn ?dept .
      ?course uni:isTaughtIn ?dept .
      ?student uni:isEnrolledIn ?course .
      ?student uni:hasEnrollmentDate ?enrollDate .
      FILTER(?enrollDate < "2025-08-16"^^xsd:date)
      OPTIONAL { ?student uni:hasGraduationDate ?gradDate }
      FILTER(IF(BOUND(?gradDate), ?gradDate >= "2025-08-16"^^xsd:date, true))
    }
    GROUP BY ?p
    HAVING (COUNT(DISTINCT ?student) > 10)
  }
}
"""
try:
    results = list(g.query(q))
    print(f"  Results: {len(results)}")
    for row in results:
        print(f"  Professor: {row.professor}")
except Exception as e:
