[13.034032, "o", "\u001b[?2004h"]
[13.034053, "o", ">    \r\n\u001b[?2004l\r"]
[13.034085, "o", "\u001b[?2004h> "]
[13.03424, "o", "   '\"'\"'/app/jq_args.yaml'\"'\"' will be used to construct and execute a single jq command as follows:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[13.034453, "o", "   `jq $(yq -r '\"'\"'.args[]'\"'\"' /app/jq_args.yaml) \"$(yq -r '\"'\"'.filter'\"'\"' /app/jq_args.yaml)\" /app/users.json > /app/active_users_report.json`\r\n\u001b[?2004l\r\u001b[?2004h> "]
[13.034501, "o", "   \r\n\u001b[?2004l\r\u001b[?2004h> "]
