[13.034755, "o", "   `jq --unbuffered --argjson min_count 5 --tab '\"'\"'group_by(.address.city)'\"'\"' /app/users.json > /app/active_users_report.json`\r\n\u001b[?2004l\r"]
[13.034781, "o", "\u001b[?2004h> \r\n"]
