[13.039687, "o", "\u001b[?2004h> "]
[13.039961, "o", "- The jq command used to generate the output(along with the output redirection) must be saved to '\"'\"'/app/cmd.sh'\"'\"'. This file will be used to verify the correctness of your solution.\r\n\u001b[?2004l\r"]
[13.039991, "o", "\u001b[?2004h> "]
