[13.036252, "o", "   - Do not include the jq command itself, the filter expression, or file paths in the args list\r\n\u001b[?2004l\r"]
[13.036272, "o", "\u001b[?2004h> "]
[13.036438, "o", "   - File paths other than the required input file '\"'\"'/app/users.json'\"'\"' and output redirections should not appear in the args\r\n\u001b[?2004l\r"]
[13.036495, "o", "\u001b[?2004h> "]
[13.036589, "o", "   - The filter should be a single string containing the complete jq filter expression\r\n\u001b[?2004l\r\u001b[?2004h"]
[13.036619, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[13.036641, "o", "> "]
[13.036981, "o", "**Note on examples below**: In the following Data Schema sections, all content following the '\"'\"'#'\"'\"' symbol is just explanatory commentary and will NOT appear in the actual JSON files. These comments are only provided to clarify the structure and requirements.\r\n\u001b[?2004l\r\u001b[?2004h"]
[13.037019, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[13.037043, "o", "**Input Data Schema**:\r\n\u001b[?2004l\r"]
[13.037066, "o", "\u001b[?2004h> "]
[13.037199, "o", "The input JSON file '\"'\"'/app/users.json'\"'\"' is an array of user objects with the following structure:\r\n\u001b[?2004l\r"]
[13.037227, "o", "\u001b[?2004h> [\r\n\u001b[?2004l\r\u001b[?2004h"]
[13.037251, "o", ">   {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[13.037354, "o", "    \"id\": 1,                  # Unique numeric identifier for the user\r\n\u001b[?2004l\r"]
[13.03738, "o", "\u001b[?2004h> "]
[13.037466, "o", "    \"username\": \"john_doe\",   # User'\"'\"'s unique username (string)\r\n\u001b[?2004l\r"]
[13.03749, "o", "\u001b[?2004h> "]
[13.037578, "o", "    \"email\": \"john@example.com\",  # User'\"'\"'s email address (string)\r\n\u001b[?2004l\r"]
[13.037596, "o", "\u001b[?2004h> "]
[13.037709, "o", "    \"status\": \"active\",       # User status: '\"'\"'active'\"'\"' or '\"'\"'inactive'\"'\"'\r\n\u001b[?2004l\r"]
[13.037734, "o", "\u001b[?2004h> "]
[13.037853, "o", "    \"last_login\": \"2024-10-02T20:59:10.109812Z\",  # ISO 8601 timestamp (UTC) of the last login\r\n\u001b[?2004l\r"]
[13.037877, "o", "\u001b[?2004h> "]
[13.037993, "o", "    \"roles\": [\"admin\", \"editor\"]  # Array of roles assigned to the user (may be empty)\r\n\u001b[?2004l\r"]
[13.038016, "o", "\u001b[?2004h>   },\r\n\u001b[?2004l\r"]
[13.038036, "o", "\u001b[?2004h> "]
[13.038063, "o", "  ...\r\n\u001b[?2004l\r\u001b[?2004h> "]
[13.038086, "o", "]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[13.03811, "o", "\u001b[?2004h> "]
[13.038137, "o", "**Output Data Schema**:\r\n\u001b[?2004l\r"]
[13.038162, "o", "\u001b[?2004h> "]
[13.038322, "o", "The output JSON file '\"'\"'/app/active_users_report.json'\"'\"' must be an array of objects with the following structure:\r\n\u001b[?2004l\r\u001b[?2004h"]
[13.038373, "o", "> [\r\n\u001b[?2004l\r\u001b[?2004h"]
[13.038393, "o", ">   {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[13.038473, "o", "    \"user_id\": 1,                 # Derived from '\"'\"'id'\"'\"' in input \r\n\u001b[?2004l\r"]
[13.038489, "o", "\u001b[?2004h"]
[13.038504, "o", "> "]
[13.038567, "o", "    \"username\": \"john_doe\",       # Retained from input \r\n\u001b[?2004l\r"]
[13.038584, "o", "\u001b[?2004h"]
[13.038598, "o", "> "]
[13.038681, "o", "    \"email\": \"john@example.com\",  # Retained from input \r\n\u001b[?2004l\r\u001b[?2004h> "]
[13.038796, "o", "    \"last_login\": \"2024-10-02\",   # Formatted from '\"'\"'last_login'\"'\"' in input\r\n\u001b[?2004l\r\u001b[?2004h"]
[13.038827, "o", "> "]
[13.038939, "o", "    \"role_count\": 2,              # Count of '\"'\"'roles'\"'\"' from input\r\n\u001b[?2004l\r\u001b[?2004h> "]
[13.039081, "o", "    \"primary_role\": \"admin\"       # If '\"'\"'roles'\"'\"' is empty, this must be null (JSON null, not \"null\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[13.039116, "o", ">   },\r\n\u001b[?2004l\r\u001b[?2004h>   ...\r\n\u001b[?2004l\r"]
[13.039142, "o", "\u001b[?2004h> ]\r\n\u001b[?2004l\r"]
[13.039168, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[13.039191, "o", "> "]
[13.039219, "o", "**Requirements**:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[13.039394, "o", "- You must use jq to perform this transformation. Using other programming languages (e.g., Python, Ruby) is strictly prohibited.\r\n\u001b[?2004l\r"]
[13.039405, "o", "\u001b[?2004h> "]
