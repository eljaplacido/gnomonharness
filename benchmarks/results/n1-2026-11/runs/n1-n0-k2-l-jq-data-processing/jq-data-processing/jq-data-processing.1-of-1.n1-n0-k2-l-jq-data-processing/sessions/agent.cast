[13.035427, "o", "\u001b[?2004h>    \r\n\u001b[?2004l\r"]
[13.035449, "o", "\u001b[?2004h> "]
[13.035489, "o", "   Requirements for the YAML file:\r\n\u001b[?2004l\r"]
[13.035516, "o", "\u001b[?2004h> "]
[13.035655, "o", "   - The '\"'\"'args'\"'\"' list should contain complete jq arguments, with both flags and their values (if any)\r\n\u001b[?2004l\r"]
[13.035678, "o", "\u001b[?2004h> "]
[13.035756, "o", "   - Each argument should be a separate string in the list\r\n\u001b[?2004l\r"]
[13.035779, "o", "\u001b[?2004h> "]
[13.035907, "o", "   - For flag-only arguments, include just the flag (e.g., '\"'\"'--unbuffered'\"'\"', '\"'\"'--tab'\"'\"')\r\n\u001b[?2004l\r"]
[13.035937, "o", "\u001b[?2004h> "]
[13.036109, "o", "   - For arguments with values, include both the flag and value as a single string (e.g., '\"'\"'--argjson min_count 5'\"'\"')\r\n\u001b[?2004l\r\u001b[?2004h"]
