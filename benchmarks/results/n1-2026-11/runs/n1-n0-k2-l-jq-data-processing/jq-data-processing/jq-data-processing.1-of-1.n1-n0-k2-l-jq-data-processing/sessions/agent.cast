[13.031265, "o", "> "]
[13.031339, "o", "   - Extract '\"'\"'id'\"'\"' as '\"'\"'user_id'\"'\"'.\r\n\u001b[?2004l\r\u001b[?2004h"]
[13.031362, "o", "> "]
[13.031417, "o", "   - Extract '\"'\"'username'\"'\"'.\r\n\u001b[?2004l\r"]
[13.031425, "o", "\u001b[?2004h"]
[13.031461, "o", "> "]
[13.031497, "o", "   - Extract '\"'\"'email'\"'\"'.\r\n\u001b[?2004l\r"]
[13.031516, "o", "\u001b[?2004h> "]
