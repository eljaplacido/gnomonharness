[393.68314, "o", "e\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\r\n        )\u001b[90m\u001b[39;49;00m\r\n        tokenizer = AutoTokenizer.from_pretrained(base_model_name, trust_remote_code=\u001b[94mTrue\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n        model = PeftModel.from_pretrained(base_model, adapter_path)\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[94mif\u001b[39;49;00m tokenizer.pad_token \u001b[95mis\u001b[39;49;00m \u001b[94mNone\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\r\n            tokenizer.pad_token = tokenizer.eos_token\u001b[90m\u001b[39;49;00m\r\n        model.eval()\u001b[90m\u001b[39;49;00m\r\n        correct = \u001b[94m0\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        total = \u001b[96mlen\u001b[39;49;00m(test_data)\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[94mfor\u001b[39;49;00m sample \u001b[95min\u001b[39;49;00m test_data:\u001b[90m\u001b[39;49;00m\r\n            question = sample[\u001b[33m\"\u001b[39;49;00m\u001b[33mquestion\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m]\u001b[90m\u001b[39;49;00m\r\n            options = sample[\u001b[33m\"\u001b[39;49;00m\u001b[33moptions\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m]\u001b[90m\u001b[39;49;00m\r\n            correct_answer = sample[\u001b[33m\"\u001b[39;49;00m\u001b[33manswer\u001b[39;49;00m\u001b[33m\"\u001b[39;49"]
[393.683154, "o", ";00m]\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n            options_text = \u001b[33m\"\u001b[39;49;00m\u001b[33m \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m.join(options)\u001b[90m\u001b[39;49;00m\r\n            prompt = \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mQuestion: \u001b[39;49;00m\u001b[33m{\u001b[39;49;00mquestion\u001b[33m}\u001b[39;49;00m\u001b[33m Options: \u001b[39;49;00m\u001b[33m{\u001b[39;49;00moptions_text\u001b[33m}\u001b[39;49;00m\u001b[33m Answer:\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n            inputs = tokenizer(prompt, return_tensors=\u001b[33m\"\u001b[39;49;00m\u001b[33mpt\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, truncation=\u001b[94mTrue\u001b[39;49;00m, max_length=\u001b[94m128\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n            \u001b[94mwith\u001b[39;49;00m torch.no_grad():\u001b[90m\u001b[39;49;00m\r\n                outputs = model.generate(\u001b[90m\u001b[39;49;00m\r\n                    **inputs,\u001b[90m\u001b[39;49;00m\r\n                    max_new_tokens=\u001b[94m5\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\r\n                    do_sample=\u001b[94mFalse\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\r\n                    temperature=\u001b[94m0.0\u001b[39;49;00m,\u001b[90m\u001b[39;49;00"]
