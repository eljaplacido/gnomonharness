#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>

#define MAX_KMER_LEN 256
#define HASH_SIZE 131071  /* prime */

/* Each k-mer node: key (kmer string), left extension char, right extension char */
typedef struct Node {
    char kmer[MAX_KMER_LEN];
    char left_ext;
    char right_ext;
    struct Node *next;
} Node;

static Node *hash_table[HASH_SIZE];

/* Simple hash function for k-mer string */
static uint32_t hash_kmer(const char *kmer) {
    uint32_t h = 5381;
    int len = strlen(kmer);
    for (int i = 0; i < len; i++) {
        h = ((h << 5) + h) + kmer[i];
    }
    return h % HASH_SIZE;
}

/* Insert or update a k-mer in the hash table */
static void insert_kmer(const char *kmer, char left_ext, char right_ext) {
    uint32_t idx = hash_kmer(kmer);
    Node *node = hash_table[idx];
    while (node != NULL) {
        if (strcmp(node->kmer, kmer) == 0) {
            /* Update extensions */
            node->left_ext = left_ext;
            node->right_ext = right_ext;
            return;
        }
        node = node->next;
    }
    /* New node */
    Node *new_node = (Node *)malloc(sizeof(Node));
    strncpy(new_node->kmer, kmer, MAX_KMER_LEN - 1);
    new_node->kmer[MAX_KMER_LEN - 1] = '\0';
    new_node->left_ext = left_ext;
    new_node->right_ext = right_ext;
    new_node->next = hash_table[idx];
    hash_table[idx] = new_node;
}

/* Find a k-mer in the hash table */
static Node *find_kmer(const char *kmer) {
    uint32_t idx = hash_kmer(kmer);
    Node *node = hash_table[idx];
    while (node != NULL) {
        if (strcmp(node->kmer, kmer) == 0) {
            return node;
        }
        node = node->next;
    }
    return NULL;
}

/* Get the right extension of a k-mer */
static char get_right_ext(const char *kmer) {
    Node *node = find_kmer(kmer);
    if (node == NULL) return 'F';
    return node->right_ext;
}

/* Get the left extension of a k-mer */
static char get_left_ext(const char *kmer) {
    Node *node = find_kmer(kmer);
    if (node == NULL) return 'F';
    return node->left_ext;
}

/* Build the next k-mer by shifting left and adding a character */
static void build_next_kmer(const char *kmer, char next_char, char *next_kmer) {
    int len = strlen(kmer);
    for (int i = 0; i < len - 1; i++) {
        next_kmer[i] = kmer[i + 1];
    }
    next_kmer[len - 1] = next_char;
    next_kmer[len] = '\0';
}

/* Build the previous k-mer by removing last char and adding to front */
static void build_prev_kmer(const char *kmer, char prev_char, char *prev_kmer) {
    int len = strlen(kmer);
    prev_kmer[0] = prev_char;
    for (int i = 0; i < len - 1; i++) {
        prev_kmer[i + 1] = kmer[i];
    }
    prev_kmer[len] = '\0';
}

/* Traverse the graph to build contigs */
static void build_contigs(FILE *out) {
    /* First pass: find all k-mers that are starting points of contigs */
    /* A k-mer is a start if:
     *   - it has no left extension (left_ext == 'F'), OR
     *   - its left extension is not in the hash table (dead end)
     */
    /* We need to track which k-mers have been visited */
    /* Use a simple approach: iterate all hash table entries */
    
    /* First, collect all k-mers */
    int total_nodes = 0;
    for (int i = 0; i < HASH_SIZE; i++) {
        Node *node = hash_table[i];
        while (node != NULL) {
            total_nodes++;
            node = node->next;
        }
    }
    
    /* Allocate visited array */
    char *visited = (char *)calloc(total_nodes, sizeof(char));
    if (!visited) {
        fprintf(stderr, "Memory allocation failed\n");
        return;
    }
    
    /* Collect all k-mers into an array */
    char **kmer_list = (char **)malloc(total_nodes * sizeof(char *));
    if (!kmer_list) {
        fprintf(stderr, "Memory allocation failed\n");
        free(visited);
        return;
    }
    
    int idx = 0;
    for (int i = 0; i < HASH_SIZE; i++) {
        Node *node = hash_table[i];
        while (node != NULL) {
            kmer_list[idx] = (char *)malloc(MAX_KMER_LEN);
            strncpy(kmer_list[idx], node->kmer, MAX_KMER_LEN);
            idx++;
            node = node->next;
        }
    }
    
    /* Now traverse from each unvisited start node */
    for (int i = 0; i < total_nodes; i++) {
        if (visited[i]) continue;
        
        Node *node = find_kmer(kmer_list[i]);
        if (node == NULL) continue;
        
        /* Check if this is a start node: left extension is 'F' or not in table */
        if (node->left_ext != 'F') {
            char prev_kmer[MAX_KMER_LEN];
            build_prev_kmer(kmer_list[i], node->left_ext, prev_kmer);
            if (find_kmer(prev_kmer) != NULL) {
                /* Not a start node, skip */
                continue;
            }
        }
        
        /* Build contig forward from this node */
        char contig[MAX_KMER_LEN * 1000];  /* generous size */
        strcpy(contig, kmer_list[i]);
        visited[i] = 1;
        
        char current_kmer[MAX_KMER_LEN];
        strcpy(current_kmer, kmer_list[i]);
        
        while (1) {
            char right = get_right_ext(current_kmer);
            if (right == 'F') break;
            
            char next_kmer[MAX_KMER_LEN];
            build_next_kmer(current_kmer, right, next_kmer);
            
            Node *next_node = find_kmer(next_kmer);
            if (next_node == NULL) break;
            
            /* Find the index of next_kmer in kmer_list */
            for (int j = 0; j < total_nodes; j++) {
                if (strcmp(kmer_list[j], next_kmer) == 0) {
                    visited[j] = 1;
                    break;
                }
            }
            
            /* Append the last character of the new k-mer */
            strcat(contig, next_kmer + strlen(next_kmer) - 1);
            strcpy(current_kmer, next_kmer);
        }
        
        fprintf(out, "%s\n", contig);
    }
    
    /* Free memory */
    for (int i = 0; i < total_nodes; i++) {
        free(kmer_list[i]);
    }
    free(kmer_list);
    free(visited);
}

int main(int argc, char *argv[]) {
    if (argc < 2) {
        fprintf(stderr, "Usage: %s <input_file>\n", argv[0]);
        return 1;
    }
    
    /* Initialize hash table */
    memset(hash_table, 0, sizeof(hash_table));
    
    FILE *in = fopen(argv[1], "r");
    if (!in) {
        fprintf(stderr, "Cannot open input file: %s\n", argv[1]);
        return 1;
    }
    
    char line[1024];
    while (fgets(line, sizeof(line), in)) {
        /* Remove newline */
        line[strcspn(line, "\n")] = '\0';
        
        /* Parse: kmer\tleft_ext right_ext */
        char *tab = strchr(line, '\t');
        if (!tab) continue;
        
        *tab = '\0';
        char *kmer = line;
        char *exts = tab + 1;
        
        /* Skip whitespace */
        while (*exts == ' ') exts++;
        
        char left_ext = exts[0];
        char right_ext = exts[1];
        
        insert_kmer(kmer, left_ext, right_ext);
    }
    
    fclose(in);
    
    /* Build contigs and write to output */
    FILE *out = fopen("/app/serial.out", "w");
    if (!out) {
        fprintf(stderr, "Cannot open output file: /app/serial.out\n");
        return 1;
    }
    
    build_contigs(out);
    fclose(out);
    
    /* Free hash table */
    for (int i = 0; i < HASH_SIZE; i++) {
        Node *node = hash_table[i];
        while (node != NULL) {
            Node *next = node->next;
            free(node);
            node = next;
        }
    }
    
    return 0;
}
SERIAL_EOF
echo "serial.c written"
</parameter>
