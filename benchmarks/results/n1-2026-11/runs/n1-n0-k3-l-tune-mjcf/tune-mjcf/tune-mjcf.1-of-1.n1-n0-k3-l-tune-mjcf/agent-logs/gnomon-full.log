import mujoco, numpy as np

model = mujoco.MjModel.from_xml_path('model_ref.xml')
data = mujoco.MjData(model)

# Check solver info
print('Solver:', model.opt.solver)
print('Timestep:', model.opt.timestep)
print('Iterations:', model.opt.iterations)
print('Impulse iterations:', model.opt.impulse_iterations)
print('Constraint iterations:', model.opt.con_iterations)
print('Margin:', model.opt.margin)
print('Elasticity:', model.opt.impratio)
print('Gravity:', model.opt.gravity)
print()

# Check contacts
print('nconmax:', model.nconmax)
print('njmax:', model.njmax)
print('ngeom:', model.ngeom)
print('nbody:', model.nbody)
print('nq:', model.nq)
print('nv:', model.nv)
print('nuser_jnt:', model.nuser_jnt)
print('nuser_geom:', model.nuser_geom)
print('nuser_tendon:', model.nuser_tendon)
print('nuser_actuator:', model.nuser_actuator)
print('nuser_sensor:', model.nuser_sensor)
print('nuser_val:', model.nuser_val)
print()

# Check constraints
mujoco.mj_forward(model, data)
print('ncon:', data.ncon)
print('njnt:', data.njnt)
print('nefc:', data.nefc)
print('nactuator:', model.nactuator)
print('ntendon:', model.ntendon)
print('ngeompair:', model.ngeompair)
print('nexclude:', model.nexclude)
print('nuserdata:', model.nuserdata)
print()

# Check for contacts
if data.ncon > 0:
    print('Contact geom pairs:', data.contact.geom)
    print('Contact pos:', data.contact.pos)
    print('Contact frame:', data.contact.frame)
