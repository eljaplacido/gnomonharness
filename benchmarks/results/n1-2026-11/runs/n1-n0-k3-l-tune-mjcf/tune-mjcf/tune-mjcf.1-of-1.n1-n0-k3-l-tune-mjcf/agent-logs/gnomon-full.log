    ref_state = np.zeros(mujoco.mj_stateSize(ref_model, full_physics))
    mujoco.mj_getState(ref_model, ref_data, ref_state, full_physics)
    
    diff = np.linalg.norm(state - ref_state)
    print(f'{name}: time={end-start:.4f}s, diff={diff:.8f}, ok={diff < 1e-5}')

# Test different solver settings
