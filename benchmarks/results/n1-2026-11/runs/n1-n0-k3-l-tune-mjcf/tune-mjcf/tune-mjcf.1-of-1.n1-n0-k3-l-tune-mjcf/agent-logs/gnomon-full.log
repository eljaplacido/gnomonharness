import mujoco, numpy as np

# The issue is that the eval.py script creates two separate model objects
# and applies the same random perturbation. Let me check if the models
# are truly identical by loading from the same file twice.

model = mujoco.MjModel.from_xml_path('model_ref.xml')
model_ref = mujoco.MjModel.from_xml_path('model_ref.xml')

# Check all model attributes
attrs = ['nq', 'nv', 'nu', 'nbody', 'njnt', 'ngeom', 'nsite', 'nactuator', 'nconstraint', 'ntendon']
for attr in attrs:
    v1 = getattr(model, attr)
    v2 = getattr(model_ref, attr)
    print(f'{attr}: {v1} == {v2}: {v1 == v2}')

# Check qpos0, qvel0, etc.
for attr in ['qpos0', 'qvel0', 'act0', 'qpos0.shape', 'qvel0.shape']:
    v1 = getattr(model, attr.split('.')[0])
    v2 = getattr(model_ref, attr.split('.')[0])
    match = np.allclose(v1, v2) if hasattr(v1, 'shape') else v1 == v2
    print(f'{attr}: match={match}')
