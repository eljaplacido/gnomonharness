import mujoco, numpy as np, time

def test_disable(disable_flags, name):
    model = mujoco.MjModel.from_xml_path('model_ref.xml')
    model.opt.disableflags = disable_flags
    
    data = mujoco.MjData(model)
    rng = np.random.default_rng(42)
    data.qpos += rng.normal(0, 0.01, size=data.qpos.shape)
    mujoco.mj_forward(model, data)
    
    start = time.perf_counter()
    nstep = int(2.0 / model.opt.timestep)
    for _ in range(nstep):
        mujoco.mj_step(model, data)
    end = time.perf_counter()
    
    full_physics = mujoco.mjtState.mjSTATE_FULLPHYSICS
    state = np.zeros(mujoco.mj_stateSize(model, full_physics))
    mujoco.mj_getState(model, data, state, full_physics)
    
    ref_model = mujoco.MjModel.from_xml_path('model_ref.xml')
    ref_data = mujoco.MjData(ref_model)
    rng2 = np.random.default_rng(42)
    ref_data.qpos += rng2.normal(0, 0.01, size=ref_data.qpos.shape)
    mujoco.mj_forward(ref_model, ref_data)
    for _ in range(int(2.0 / ref_model.opt.timestep)):
        mujoco.mj_step(ref_model, ref_data)
    
    ref_state = np.zeros(mujoco.mj_stateSize(ref_model, full_physics))
    mujoco.mj_getState(ref_model, ref_data, ref_state, full_physics)
    
    diff = np.linalg.norm(state - ref_state)
    print(f'{name}: time={end-start:.4f}s, diff={diff:.8f}, ok={diff < 1e-5}')

# Test individual flags
test_disable(0, 'none')
test_disable(mujoco.mjtDisableBit.mjDSBL_FRICTIONLOSS, 'FRICTIONLOSS')
test_disable(mujoco.mjtDisableBit.mjDSBL_LIMIT, 'LIMIT')
test_disable(mujoco.mjtDisableBit.mjDSBL_CONTACT, 'CONTACT')
test_disable(mujoco.mjtDisableBit.mjDSBL_CONSTRAINT, 'CONSTRAINT')
test_disable(mujoco.mjtDisableBit.mjDSBL_EQUALITY, 'EQUALITY')

