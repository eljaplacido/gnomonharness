{"seq":57,"ts":"2026-11-05T09:36:33.279Z","kind":"approval","prev":"5deb70ffa959bce0b5e643fa0e6b06fe2246a23294636e53640597c788c64f64","tool":"bash","summary":"bash: cd /app && python3 -c \"\nimport json\nimport torch\nfrom transformers import AutoTokenizer, AutoModelForSequenceClassification\n\n# Load merged model from disk\nmodel = AutoModelForSequenceClassification.from_pretrained('/app/merged_model/')\ntokenizer = AutoTokenizer.from_pretrained('/app/merged_model/')\nmodel.eval()\n\ntest_samples = [\n    'Bonjour, comment allez-vous aujourd'hui?',\n    'Hola, ¿cómo estás hoy?',\n    'Guten Tag, wie geht es Ihnen?',\n    'Ciao, come stai oggi?',\n    'Olá, como você está?',\n    'Привет, как дела?',\n    'こんにちは、お元気ですか？',\n    '你好，你好吗？',\n    'مرحبا، كيف حالك؟',\n    'Hello, how are you?',\n]\n\nwith open('/app/detection_results.json') as f:\n    expected = json.load(f)\n\nprint(f'Model num_labels: {model.config.num_labels}')\nprint()\n\nall_correct = True\nwith torch.no_grad():\n    for i, text in enumerate(test_samples):\n        inputs = tokenizer(text, return_tensors='pt', truncation=True, max_length=512)\n        outputs = model(**inputs)\n        probs = torch.softmax(outputs.logits, dim=-1)\n        conf, pred = torch.max(probs, dim=-1)\n        match = pred.item() == expected[i]['predicted_class_id']\n        status = '✓' if match else '✗'\n        if not match:\n            all_correct = False\n        print(f'{status} \\\"{text}\\\" -> class {pred.item()} (conf: {conf.item():.4f}) expected: {expected[i][\\\"predicted_class_id\\\"]}')\n\nprint(f'\\nAll correct: {all_correct}')\n\" 2>&1","decision":"approved","by":"flag:--yes","interactive":false,"hash":"62c527e6fee134c17b7b0f9ff64f3bf930a045db708ca5e4f9492cc1eb1b337e"}
