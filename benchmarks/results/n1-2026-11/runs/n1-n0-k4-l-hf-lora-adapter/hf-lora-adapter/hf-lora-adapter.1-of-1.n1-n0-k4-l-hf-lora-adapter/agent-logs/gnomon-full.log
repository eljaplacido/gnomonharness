import json
import torch
from transformers import AutoTokenizer, AutoModelForSequenceClassification

# Load merged model from disk
model = AutoModelForSequenceClassification.from_pretrained('/app/merged_model/')
tokenizer = AutoTokenizer.from_pretrained('/app/merged_model/')
model.eval()

test_samples = [
    'Bonjour, comment allez-vous aujourd'hui?',
    'Hola, ¿cómo estás hoy?',
    'Guten Tag, wie geht es Ihnen?',
    'Ciao, come stai oggi?',
    'Olá, como você está?',
    'Привет, как дела?',
    'こんにちは、お元気ですか？',
    '你好，你好吗？',
    'مرحبا، كيف حالك؟',
    'Hello, how are you?',
]

with open('/app/detection_results.json') as f:
    expected = json.load(f)

print(f'Model num_labels: {model.config.num_labels}')
print()

all_correct = True
with torch.no_grad():
    for i, text in enumerate(test_samples):
        inputs = tokenizer(text, return_tensors='pt', truncation=True, max_length=512)
        outputs = model(**inputs)
        probs = torch.softmax(outputs.logits, dim=-1)
        conf, pred = torch.max(probs, dim=-1)
        match = pred.item() == expected[i]['predicted_class_id']
        status = '✓' if match else '✗'
        if not match:
            all_correct = False
        print(f'{status} \"{text}\" -> class {pred.item()} (conf: {conf.item():.4f}) expected: {expected[i][\"predicted_class_id\"]}')

print(f'\nAll correct: {all_correct}')
