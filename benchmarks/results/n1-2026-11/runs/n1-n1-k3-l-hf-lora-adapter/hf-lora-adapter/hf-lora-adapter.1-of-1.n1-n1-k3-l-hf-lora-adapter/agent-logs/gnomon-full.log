    lang = langs[i]
    exp = expected[lang]
    match = r['predicted_class_id'] == exp
    if match:
        correct += 1
    print(f'{lang}: predicted={r[\"predicted_class_id\"]}, expected={exp}, match={match}, conf={r[\"confidence\"]}')

