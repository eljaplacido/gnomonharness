import mujoco
import numpy as np
import time
import re

def simulate_and_time(model, seed):
    data = mujoco.MjData(model)
    nstep = int(2.0 / model.opt.timestep)
    rng = np.random.default_rng(seed)
    data.qpos += rng.normal(0, 0.01, size=data.qpos.shape)
    mujoco.mj_forward(model, data)
    t0 = time.perf_counter()
    for _ in range(nstep):
        mujoco.mj_step(model, data)
    t1 = time.perf_counter()
    return t1 - t0

def simulate_and_state(model, seed):
    data = mujoco.MjData(model)
    nstep = int(2.0 / model.opt.timestep)
    rng = np.random.default_rng(seed)
    data.qpos += rng.normal(0, 0.01, size=data.qpos.shape)
    mujoco.mj_forward(model, data)
    for _ in range(nstep):
        mujoco.mj_step(model, data)
    full_physics = mujoco.mjtState.mjSTATE_FULLPHYSICS
    state = np.zeros(mujoco.mj_stateSize(model, full_physics))
    mujoco.mj_getState(model, data, state, full_physics)
    return state

ref_model = mujoco.MjModel.from_xml_path('model_ref.xml')
ref_state = simulate_and_state(ref_model, 42)
ref_time = simulate_and_time(ref_model, 42)
print(f'Reference time: {ref_time:.4f}s')

# Try changing twist and bend
for twist in [1e7, 1e8, 1e9, 1e10]:
    for bend in [4e6, 4e7, 4e8, 4e9]:
        xml = open('model_ref.xml').read()
        xml = re.sub(r'key=\"twist\" value=\"[^\"]*\"', f'key=\"twist\" value=\"{twist}\"', xml)
        xml = re.sub(r'key=\"bend\" value=\"[^\"]*\"', f'key=\"bend\" value=\"{bend}\"', xml)
        with open('/tmp/test_model.xml', 'w') as f:
            f.write(xml)
        try:
            m = mujoco.MjModel.from_xml_path('/tmp/test_model.xml')
            d = mujoco.MjData(m)
            mujoco.mj_forward(m, d)
            t = simulate_and_time(m, 42)
            state = simulate_and_state(m, 42)
            diff = np.linalg.norm(state - ref_state)
            if diff > 0:
                print(f'twist={twist}, bend={bend}: time={t:.4f}s ({t/ref_time*100:.1f}%), diff={diff:.6e}')
        except Exception as e:
            print(f'twist={twist}, bend={bend}: ERROR {e}')
