import mujoco
import numpy as np

def simulate(model, seed):
    data = mujoco.MjData(model)
    nstep = int(2.0 / model.opt.timestep)
    rng = np.random.default_rng(seed)
    data.qpos += rng.normal(0, 0.01, size=data.qpos.shape)
    mujoco.mj_forward(model, data)
    for _ in range(nstep):
        mujoco.mj_step(model, data)
    full_physics = mujoco.mjtState.mjSTATE_FULLPHYSICS
    state = np.zeros(mujoco.mj_stateSize(model, full_physics))
    mujoco.mj_getState(model, data, state, full_physics)
    return state

# Get reference state
ref_model = mujoco.MjModel.from_xml_path('model_ref.xml')
ref_state = simulate(ref_model, 42)

# Test different timesteps
for ts in [0.004, 0.005, 0.008, 0.01, 0.02]:
    m = mujoco.MjModel.from_xml_path('model_ref.xml')
    m.opt.timestep = ts
    d = mujoco.MjData(m)
    mujoco.mj_forward(m, d)
    state = simulate(m, 42)
    diff = np.linalg.norm(state - ref_state)
    maxdiff = np.max(np.abs(state - ref_state))
    print(f'ts={ts}: diff={diff:.6e}, maxdiff={maxdiff:.6e}')
"
