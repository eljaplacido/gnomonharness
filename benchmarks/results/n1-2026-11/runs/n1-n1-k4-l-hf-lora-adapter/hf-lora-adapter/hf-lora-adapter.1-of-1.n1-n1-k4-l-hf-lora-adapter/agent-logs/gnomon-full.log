[approval] bash: cd /app && python3 -c "
import json, torch
from transformers import AutoTokenizer, AutoModelForSequenceClassification

# Load merged model from disk
model = AutoModelForSequenceClassification.from_pretrained('/app/merged_model/')
tokenizer = AutoTokenizer.from_pretrained('/app/merged_model/')
model.eval()

test_samples = [
    'Bonjour, comment allez-vous aujourd'hui?',
    'Hola, ¿cómo estás hoy?',
    'Guten Tag, wie geht es Ihnen?',
    'Ciao, come stai oggi?',
    'Olá, como você está?',
    'Привет, как дела?',
    'こんにちは、お元気ですか？',
    '你好，你好吗？',
    'مرحبا، كيف حالك؟',
    'Hello, how are you?',
]

with open('/app/detection_results.json') as f:
    expected = json.load(f)

all_match = True
with torch.no_grad():
    for i, text in enumerate(test_samples):
        inputs = tokenizer(text, return_tensors='pt', truncation=True, max_length=512)
        outputs = model(**inputs)
        probs = torch.softmax(outputs.logits, dim=-1)
        confidence, pred_id = torch.max(probs, dim=-1)
        pred_id = pred_id.item()
        conf = round(confidence.item(), 6)
        exp = expected[i]
        match = pred_id == exp['predicted_class_id'] and abs(conf - exp['confidence']) < 0.001
        status = '✓' if match else '✗'
        if not match:
            all_match = False
        print(f'{status} [{pred_id}] conf={conf:.4f}  {text}')

print(f'\nAll results match: {all_match}')
