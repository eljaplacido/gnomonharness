[5.941618, "o", "\r\n\r\n=========================================================================== FAILURES ===========================================================================\r\n\u001b[31m\u001b[1m___________________________________________________________________________ test_api ___________________________________________________________________________\u001b[0m\r\n\r\n"]
[5.952731, "o", "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mtest_api\u001b[39;49;00m():\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"Test the vectorops package API functionality.\u001b[39;49;00m\r\n    \u001b[33m\u001b[39;49;00m\r\n    \u001b[33m    This function imports the vectorops package and tests its dotproduct function\u001b[39;49;00m\r\n    \u001b[33m    with various input vectors to ensure it calculates dot products correctly.\u001b[39;49;00m\r\n    \u001b[33m\u001b[39;49;00m\r\n    \u001b[33m    Tests include:\u001b[39;49;00m\r\n    \u001b[33m    - 2D vectors: [1,1] · [0,1] = 1\u001b[39;49;00m\r\n    \u001b[33m    - 3D vectors: [1,1,0] · [1,1,0] = 2\u001b[39;49;00m\r\n    \u001b[33m    - 4D vectors with zeros: [1,1,0,0] · [1,0,0,21.2] = 1\u001b[39;49;00m\r\n    \u001b[33m    - 4D vectors with negative and decimal values: [1,-1,0,0.01] · [0,0,10,0] = 0\u001b[39;49;00m\r\n    \u001b[33m\u001b[39;49;00m\r\n    \u001b[33m    Raises:\u001b[39;49;00m\r\n    \u001b[33m        AssertionError: If any dot product calculation doesn't match expected result.\u001b[39;49;00m\r\n    \u001b[33m        ImportError: If vectorops package cannot be imported.\u001b[39;49;00m\r\n    \u001b[33m"]
[5.952756, "o", "    \"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        install()\u001b[90m\u001b[39;49;00m\r\n>       \u001b[94mimport\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[04m\u001b[96mvectorops\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[94mas\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[04m\u001b[96mv\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n\u001b[1m\u001b[31mE       ModuleNotFoundError: No module named 'vectorops'\u001b[0m\r\n\r\n\u001b[1m\u001b[31m/tests/test_outputs.py\u001b[0m:83: ModuleNotFoundError\r\n--------------------------------------------------------------------- Captured stdout call ---------------------------------------------------------------------\r\nUninstalling any existing vectorops package...\r\nSuccessfully uninstalled existing vectorops package\r\nUninstall output: \r\nInstalling vectorops==0.1.0 from local PyPI server...\r\nSuccessfully installed vectorops from local PyPI server\r\nInstall output: Looking in indexes: http://localhost:8080/simple\r\nCollecting vectorops==0.1.0\r\n  Downloading http://localhost:8080/packages/vectorops-0.1.0-py3-none-any.whl (1.0 kB)\r\nInstalling collected packages: vectorops\r\nSuccessfully installed vectoro"]
