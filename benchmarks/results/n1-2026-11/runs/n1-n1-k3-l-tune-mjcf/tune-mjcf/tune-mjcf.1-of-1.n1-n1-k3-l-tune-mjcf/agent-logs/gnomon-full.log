import mujoco
import numpy as np

# Test with higher vmax
xml = '''<mujoco model=\"Cable\">
  <extension>
    <plugin plugin=\"mujoco.elasticity.cable\"/>
  </extension>
  <statistic center=\"0 0 .3\" extent=\"1\"/>
  <visual>
    <global elevation=\"-30\"/>
  </visual>
  <compiler autolimits=\"true\"/>
  <size memory=\"2M\"/>
  <worldbody>
    <composite type=\"cable\" curve=\"s\" count=\"41 1 1\" size=\"1\" offset=\"-.3 0 .6\" initial=\"none\">
      <plugin plugin=\"mujoco.elasticity.cable\">
        <config key=\"twist\" value=\"1e7\"/>
        <config key=\"bend\" value=\"4e6\"/>
        <config key=\"vmax\" value=\"0.5\"/>
      </plugin>
      <joint kind=\"main\" damping=\".015\"/>
      <geom type=\"capsule\" size=\".005\" rgba=\".8 .2 .1 1\" condim=\"1\"/>
    </composite>
    <body name=\"slider\" pos=\".7 0 .6\">
      <joint type=\"slide\" axis=\"1 0 0\" damping=\".1\"/>
      <geom size=\".01\"/>
    </body>
  </worldbody>
  <equality>
    <connect name=\"right_boundary\" body1=\"B_last\" body2=\"slider\" anchor=\".025 0 0\"/>
  </equality>
  <contact>
    <exclude body1=\"B_last\" body2=\"slider\"/>
  </contact>
  <actuator>
    <motor site=\"S_last\" gear=\"0 0 0 1 0 0\" ctrlrange=\"-.03 .03\"/>
  </actuator>
</mujoco>'''

import tempfile, os
with tempfile.NamedTemporaryFile(mode='w', suffix='.xml', delete=False) as f:
    f.write(xml)
    f.flush()
    tmp = f.name

m = mujoco.MjModel.from_xml_path(tmp)
print('timestep:', m.opt.timestep)
print('npluginstate:', m.npluginstate)
print('npluginattr:', m.npluginattr)
print('nplugindatadr:', m.nplugindatadr)
print('nplugindatalsize:', m.nplugindatalsize)
print('state size:', mujoco.mj_stateSize(m, mujoco.mjtState.mjSTATE_FULLPHYSICS))

# Test simulation
data = mujoco.MjData(m)
seed = 42
rng = np.random.default_rng(seed)
data.qpos += rng.normal(0, 0.01, size=data.qpos.shape)
mujoco.mj_forward(m, data)

nstep = int(2.0 / m.opt.timestep)
import time
t0 = time.perf_counter()
for _ in range(nstep):
    mujoco.mj_step(m, data)
t1 = time.perf_counter()
print(f'Time: {t1-t0:.4f}s for {nstep} steps')

state = np.zeros(mujoco.mj_stateSize(m, mujoco.mjtState.mjSTATE_FULLPHYSICS))
mujoco.mj_getState(m, data, state, mujoco.mjtState.mjSTATE_FULLPHYSICS)
print('State has NaN:', np.isnan(state).any())
print('State has Inf:', np.isinf(state).any())

os.unlink(tmp)
