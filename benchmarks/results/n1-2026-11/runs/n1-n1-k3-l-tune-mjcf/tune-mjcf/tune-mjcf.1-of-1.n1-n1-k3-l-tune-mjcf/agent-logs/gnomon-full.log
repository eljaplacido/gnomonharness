import tempfile, os, time

# The key insight: the elasticity cable plugin uses vmax to control internal sub-stepping.
# If vmax is small, the plugin takes many small sub-steps internally.
# If vmax is large, it takes fewer larger sub-steps.
# But the final state must match within atol=1e-5.

