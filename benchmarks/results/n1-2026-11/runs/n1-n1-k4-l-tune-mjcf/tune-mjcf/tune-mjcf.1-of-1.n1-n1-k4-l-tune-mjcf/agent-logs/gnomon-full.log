import mujoco, numpy as np, time

# Run baseline timing
model = mujoco.MjModel.from_xml_path('model_ref.xml')
data = mujoco.MjData(model)

# Time a single simulation
times = []
for run in range(5):
    seed = np.random.randint(0, 10000)
    t0 = time.perf_counter()
    data2 = mujoco.MjData(model)
    rng = np.random.default_rng(seed)
    data2.qpos += rng.normal(0, 0.01, size=data2.qpos.shape)
    mujoco.mj_forward(model, data2)
    nstep = int(2.0 / model.opt.timestep)
    for _ in range(nstep):
        mujoco.mj_step(model, data2)
    t1 = time.perf_counter()
    times.append(t1 - t0)
    print(f'Run {run}: {times[-1]:.4f}s')

print(f'Average: {np.mean(times):.4f}s')
