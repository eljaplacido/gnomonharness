import mujoco, numpy as np, time

# Let me measure the actual wall-clock time for the reference model
model_ref = mujoco.MjModel.from_xml_path('model_ref.xml')
times = []
for run in range(10):
    seed = np.random.randint(0, 10000)
    t0 = time.perf_counter()
    d = mujoco.MjData(model_ref)
    rng = np.random.default_rng(seed)
    d.qpos += rng.normal(0, 0.01, size=d.qpos.shape)
    mujoco.mj_forward(model_ref, d)
    nstep = int(2.0 / model_ref.opt.timestep)
    for _ in range(nstep):
        mujoco.mj_step(model_ref, d)
    t1 = time.perf_counter()
    times.append(t1 - t0)

print(f'Avg ref time: {np.mean(times):.4f}s')
target = np.mean(times) * 0.6
print(f'Target (60%): {target:.4f}s')
