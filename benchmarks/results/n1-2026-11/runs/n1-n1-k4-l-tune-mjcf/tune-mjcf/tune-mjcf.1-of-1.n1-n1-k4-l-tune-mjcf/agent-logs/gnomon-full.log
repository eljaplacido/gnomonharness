import mujoco, numpy as np, time

# 'implicit' works! integrator=2 is IMPLICIT.
# Let me test if IMPLICIT integration gives the same result as Euler
# with the same timestep.

model_ref = mujoco.MjModel.from_xml_path('model_ref.xml')

for integ_name in ['euler', 'implicit', 'implicitfast']:
    xml = f'''<mujoco model=\"Cable\">
  <extension>
    <plugin plugin=\"mujoco.elasticity.cable\"/>
  </extension>
  <statistic center=\"0 0 .3\" extent=\"1\"/>
  <visual>
    <global elevation=\"-30\"/>
  </visual>
  <compiler autolimits=\"true\"/>
  <size memory=\"2M\"/>
  <option timestep=\"0.002\" integrator=\"{integ_name}\"/>
  <worldbody>
    <composite type=\"cable\" curve=\"s\" count=\"41 1 1\" size=\"1\" offset=\"-.3 0 .6\" initial=\"none\">
      <plugin plugin=\"mujoco.elasticity.cable\">
        <config key=\"twist\" value=\"1e7\"/>
        <config key=\"bend\" value=\"4e6\"/>
        <config key=\"vmax\" value=\"0.05\"/>
      </plugin>
      <joint kind=\"main\" damping=\".015\"/>
      <geom type=\"capsule\" size=\".005\" rgba=\".8 .2 .1 1\" condim=\"1\"/>
    </composite>
    <body name=\"slider\" pos=\".7 0 .6\">
      <joint type=\"slide\" axis=\"1 0 0\" damping=\".1\"/>
      <geom size=\".01\"/>
    </body>
  </worldbody>
  <equality>
    <connect name=\"right_boundary\" body1=\"B_last\" body2=\"slider\" anchor=\".025 0 0\"/>
  </equality>
  <contact>
    <exclude body1=\"B_last\" body2=\"slider\"/>
  </contact>
  <actuator>
    <motor site=\"S_last\" gear=\"0 0 0 1 0 0\" ctrlrange=\"-.03 .03\"/>
  </actuator>
</mujoco>'''
    with open('/tmp/test_model.xml', 'w') as f:
        f.write(xml)
    
    m = mujoco.MjModel.from_xml_path('/tmp/test_model.xml')
    
    def simulate(model, seed):
        data = mujoco.MjData(model)
        rng = np.random.default_rng(seed)
        data.qpos += rng.normal(0, 0.01, size=data.qpos.shape)
        mujoco.mj_forward(model, data)
        nstep = int(2.0 / model.opt.timestep)
        for _ in range(nstep):
            mujoco.mj_step(model, data)
        full_state_size = mujoco.mj_stateSize(model, mujoco.mjtState.mjSTATE_FULLPHYSICS)
        state = np.zeros(full_state_size)
        mujoco.mj_getState(model, data, state, mujoco.mjtState.mjSTATE_FULLPHYSICS)
        return state
    
    state1 = simulate(m, 42)
    state2 = simulate(model_ref, 42)
    
    diff = np.linalg.norm(state1 - state2)
    within_tol = np.allclose(state1, state2, atol=1e-5)
    has_nan = np.isnan(state1).any()
    has_inf = np.isinf(state1).any()
    status = 'PASS' if within_tol else 'FAIL'
    print(f'{status}: integrator={integ_name}: diff={diff:.8f}, NaN={has_nan}, Inf={has_inf}')
