import mujoco, numpy as np, time

# Test: increase timestep and reduce solver iterations/tolerance
# The key is: fewer steps = faster, but we need same final state

# Strategy: increase timestep proportionally, reduce solver iterations
# But we need to keep the same physics state...
# Actually, the correct approach is to increase timestep and reduce solver iterations
# The state comparison is atol=1e-5, so some tolerance is allowed

# Let's try: larger timestep, fewer solver iterations
# With 41 cable elements, the stiffness is high (twist=1e7, bend=4e6)
# So we need a small timestep for stability

# Let's try increasing timestep to 0.004 (half the steps)
# and see if it still converges

for dt in [0.002, 0.004, 0.005, 0.008, 0.01]:
    xml = f'''<mujoco model=\"Cable\">
  <extension>
    <plugin plugin=\"mujoco.elasticity.cable\"/>
  </extension>
  <statistic center=\"0 0 .3\" extent=\"1\"/>
  <visual>
    <global elevation=\"-30\"/>
  </visual>
  <compiler autolimits=\"true\"/>
  <size memory=\"2M\"/>
  <option timestep=\"{dt}\" iterations=\"100\" ls_iterations=\"50\" tolerance=\"1e-8\" solver=\"2\"/>
  <worldbody>
    <composite type=\"cable\" curve=\"s\" count=\"41 1 1\" size=\"1\" offset=\"-.3 0 .6\" initial=\"none\">
      <plugin plugin=\"mujoco.elasticity.cable\">
        <config key=\"twist\" value=\"1e7\"/>
        <config key=\"bend\" value=\"4e6\"/>
        <config key=\"vmax\" value=\"0.05\"/>
      </plugin>
      <joint kind=\"main\" damping=\".015\"/>
      <geom type=\"capsule\" size=\".005\" rgba=\".8 .2 .1 1\" condim=\"1\"/>
    </composite>
    <body name=\"slider\" pos=\".7 0 .6\">
      <joint type=\"slide\" axis=\"1 0 0\" damping=\".1\"/>
      <geom size=\".01\"/>
    </body>
  </worldbody>
  <equality>
    <connect name=\"right_boundary\" body1=\"B_last\" body2=\"slider\" anchor=\".025 0 0\"/>
  </equality>
  <contact>
    <exclude body1=\"B_last\" body2=\"slider\"/>
  </contact>
  <actuator>
    <motor site=\"S_last\" gear=\"0 0 0 1 0 0\" ctrlrange=\"-.03 .03\"/>
  </actuator>
</mujoco>'''
    with open('/tmp/test_model.xml', 'w') as f:
        f.write(xml)
    
    try:
        m = mujoco.MjModel.from_xml_path('/tmp/test_model.xml')
        d = mujoco.MjData(m)
        rng = np.random.default_rng(42)
        d.qpos += rng.normal(0, 0.01, size=d.qpos.shape)
        mujoco.mj_forward(m, d)
        nstep = int(2.0 / m.opt.timestep)
        for _ in range(nstep):
            mujoco.mj_step(m, d)
        
        full_state_size = mujoco.mj_stateSize(m, mujoco.mjtState.mjSTATE_FULLPHYSICS)
        state = np.zeros(full_state_size)
        mujoco.mj_getState(m, d, state, mujoco.mjtState.mjSTATE_FULLPHYSICS)
        has_nan = np.isnan(state).any()
        has_inf = np.isinf(state).any()
        print(f'dt={dt}: nstep={nstep}, NaN={has_nan}, Inf={has_inf}')
    except Exception as e:
        print(f'dt={dt}: ERROR: {e}')
