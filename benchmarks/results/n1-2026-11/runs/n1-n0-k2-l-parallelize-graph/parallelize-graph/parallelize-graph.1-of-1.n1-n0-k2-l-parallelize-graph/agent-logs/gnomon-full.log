#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>

#define KMER_LEN 19
#define HASH_SIZE 65536

typedef struct Node {
    char kmer[KMER_LEN + 1];
    char left_ext;
    char right_ext;
    int visited;
    struct Node *next;
} Node;

static Node *hash_table[HASH_SIZE];

static uint32_t hash_kmer(const char *kmer) {
    uint32_t h = 5381;
    for (int i = 0; kmer[i]; i++) {
        h = ((h << 5) + h) + kmer[i];
    }
    return h % HASH_SIZE;
}

static Node *find_kmer(const char *kmer) {
    uint32_t idx = hash_kmer(kmer);
    Node *n = hash_table[idx];
    while (n) {
        if (strcmp(n->kmer, kmer) == 0) return n;
        n = n->next;
    }
    return NULL;
}

static void insert_kmer(const char *kmer, char left_ext, char right_ext) {
    uint32_t idx = hash_kmer(kmer);
    Node *existing = find_kmer(kmer);
    if (existing) return;
    Node *n = (Node *)malloc(sizeof(Node));
    strncpy(n->kmer, kmer, KMER_LEN);
    n->kmer[KMER_LEN] = '\0';
    n->left_ext = left_ext;
    n->right_ext = right_ext;
    n->visited = 0;
    n->next = hash_table[idx];
    hash_table[idx] = n;
}

static char get_right_ext(const char *kmer) {
    Node *n = find_kmer(kmer);
    return n ? n->right_ext : 'F';
}

static void extend_right(const char *kmer, char ext, char *next_kmer) {
    memcpy(next_kmer, kmer + 1, KMER_LEN - 1);
    next_kmer[KMER_LEN - 1] = ext;
    next_kmer[KMER_LEN] = '\0';
}

static void mark_visited(const char *kmer) {
    Node *n = find_kmer(kmer);
    if (n) n->visited = 1;
}

static void build_contig(const char *start_kmer, char *contig) {
    strcpy(contig, start_kmer);
    char current[KMER_LEN + 1];
    strcpy(current, start_kmer);
    while (1) {
        char ext = get_right_ext(current);
        if (ext == 'F') break;
        char next_kmer[KMER_LEN + 1];
        extend_right(current, ext, next_kmer);
        mark_visited(current);
        contig[strlen(contig)] = ext;
        strcpy(current, next_kmer);
    }
    mark_visited(current);
}

int main(int argc, char *argv[]) {
    memset(hash_table, 0, sizeof(hash_table));
    
    FILE *fp = fopen(argv[1], "r");
    char line[256];
    while (fgets(line, sizeof(line), fp)) {
        line[strcspn(line, "\r\n")] = '\0';
        char *tab = strchr(line, '\t');
        if (!tab) continue;
        *tab = '\0';
        insert_kmer(line, tab[1], tab[2]);
    }
    fclose(fp);
    
    int total = 0;
    for (int i = 0; i < HASH_SIZE; i++) {
        Node *n = hash_table[i];
        while (n) { total++; n = n->next; }
    }
    printf("Total k-mers: %d\n", total);
    
    /* First pass */
    int first_pass = 0;
    for (int i = 0; i < HASH_SIZE; i++) {
        Node *n = hash_table[i];
        while (n) {
            if (n->left_ext == 'F' && !n->visited) {
                char contig[65536];
                build_contig(n->kmer, contig);
                first_pass++;
            }
            n = n->next;
        }
    }
    printf("First pass contigs: %d\n", first_pass);
    
    /* Count visited after first pass */
    int visited_after_first = 0;
    for (int i = 0; i < HASH_SIZE; i++) {
        Node *n = hash_table[i];
        while (n) { if (n->visited) visited_after_first++; n = n->next; }
    }
    printf("Visited after first pass: %d\n", visited_after_first);
    
    /* Second pass */
    int second_pass = 0;
    for (int i = 0; i < HASH_SIZE; i++) {
        Node *n = hash_table[i];
        while (n) {
            if (!n->visited) {
                char contig[65536];
                build_contig(n->kmer, contig);
                second_pass++;
            }
            n = n->next;
        }
    }
    printf("Second pass contigs: %d\n", second_pass);
    
    int visited_after_second = 0;
    for (int i = 0; i < HASH_SIZE; i++) {
        Node *n = hash_table[i];
        while (n) { if (n->visited) visited_after_second++; n = n->next; }
    }
    printf("Visited after second pass: %d\n", visited_after_second);
    
    return 0;
}
