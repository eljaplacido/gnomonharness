#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>
#include <pthread.h>

#define KMER_LEN 19
#define HASH_SIZE 65536
#define MAX_KMERS 20000

typedef struct Node {
    char kmer[KMER_LEN + 1];
    char left_ext;
    char right_ext;
    int visited;
    struct Node *next;
} Node;

static Node *hash_table[HASH_SIZE];
static int num_kmers = 0;
static pthread_mutex_t hash_mutex = PTHREAD_MUTEX_INITIALIZER;

typedef struct {
    int thread_id;
    char **lines;
    int num_lines;
    int num_threads;
} ThreadData;

static uint32_t hash_kmer(const char *kmer) {
    uint32_t h = 5381;
    for (int i = 0; kmer[i]; i++) {
        h = ((h << 5) + h) + kmer[i];
    }
    return h % HASH_SIZE;
}

static Node *find_kmer_in_table(Node **ht, const char *kmer) {
    uint32_t idx = hash_kmer(kmer);
    Node *n = ht[idx];
    while (n) {
        if (strcmp(n->kmer, kmer) == 0) return n;
        n = n->next;
    }
    return NULL;
}

static void insert_kmer_in_table(Node **ht, const char *kmer, char left_ext, char right_ext) {
    uint32_t idx = hash_kmer(kmer);
    Node *existing = find_kmer_in_table(ht, kmer);
    if (existing) {
        existing->left_ext = left_ext;
        existing->right_ext = right_ext;
        return;
    }
    Node *n = (Node *)malloc(sizeof(Node));
    strncpy(n->kmer, kmer, KMER_LEN);
    n->kmer[KMER_LEN] = '\0';
    n->left_ext = left_ext;
    n->right_ext = right_ext;
    n->visited = 0;
    n->next = ht[idx];
    ht[idx] = n;
}

static void free_hash_table(Node **ht) {
    for (int i = 0; i < HASH_SIZE; i++) {
        Node *n = ht[i];
        while (n) {
            Node *next = n->next;
            free(n);
            n = next;
        }
        ht[i] = NULL;
    }
}

static void merge_into_global(Node **local_ht) {
    pthread_mutex_lock(&hash_mutex);
    for (int i = 0; i < HASH_SIZE; i++) {
        Node *n = local_ht[i];
        while (n) {
            Node *next = n->next;
            uint32_t idx = hash_kmer(n->kmer);
            Node *existing = hash_table[idx];
            int found = 0;
            while (existing) {
                if (strcmp(existing->kmer, n->kmer) == 0) {
                    found = 1;
                    break;
                }
                existing = existing->next;
            }
            if (!found) {
                n->next = hash_table[idx];
                hash_table[idx] = n;
                num_kmers++;
            } else {
                free(n);
            }
            n = next;
        }
        local_ht[i] = NULL;
    }
    pthread_mutex_unlock(&hash_mutex);
}

static void *thread_worker(void *arg) {
    ThreadData *td = (ThreadData *)arg;
    Node **local_ht = (Node **)calloc(HASH_SIZE, sizeof(Node *));
    
    for (int i = 0; i < td->num_lines; i++) {
        char *line = td->lines[i];
        if (!line) continue;
        char *tab = strchr(line, '\t');
        if (!tab) continue;
        *tab = '\0';
        char *kmer = line;
        char *ext_str = tab + 1;
        if (strlen(kmer) != KMER_LEN) continue;
        if (strlen(ext_str) != 2) continue;
        insert_kmer_in_table(local_ht, kmer, ext_str[0], ext_str[1]);
    }
    
    merge_into_global(local_ht);
    free_hash_table(local_ht);
    free(local_ht);
    
    for (int i = 0; i < td->num_lines; i++) {
        free(td->lines[i]);
    }
    free(td->lines);
    return NULL;
}

int main(int argc, char *argv[]) {
    if (argc < 2) return 1;
    
    FILE *fp = fopen(argv[1], "r");
    if (!fp) return 1;
    
    char **all_lines = (char **)malloc(MAX_KMERS * sizeof(char *));
    int total_lines = 0;
    char line[256];
    while (fgets(line, sizeof(line), fp)) {
        line[strcspn(line, "\r\n")] = '\0';
        if (strlen(line) == 0) continue;
        all_lines[total_lines] = strdup(line);
        total_lines++;
    }
    fclose(fp);
    
    memset(hash_table, 0, sizeof(hash_table));
    
    int num_threads = 4;
    ThreadData *thread_data = (ThreadData *)malloc(num_threads * sizeof(ThreadData));
    pthread_t *threads = (pthread_t *)malloc(num_threads * sizeof(pthread_t));
    
    int lines_per_thread = total_lines / num_threads;
    int remainder = total_lines % num_threads;
    int line_idx = 0;
    for (int t = 0; t < num_threads; t++) {
        int n = lines_per_thread + (t < remainder ? 1 : 0);
        thread_data[t].thread_id = t;
        thread_data[t].lines = (char **)malloc(n * sizeof(char *));
        thread_data[t].num_lines = n;
        thread_data[t].num_threads = num_threads;
        for (int i = 0; i < n; i++) {
            thread_data[t].lines[i] = all_lines[line_idx++];
        }
    }
    free(all_lines);
    
    for (int t = 0; t < num_threads; t++) {
        pthread_create(&threads[t], NULL, thread_worker, &thread_data[t]);
    }
    for (int t = 0; t < num_threads; t++) {
        pthread_join(threads[t], NULL);
    }
    
    printf("Total k-mers in global table: %d\n", num_kmers);
    
    /* Count visited */
    int visited_count = 0;
    for (int i = 0; i < HASH_SIZE; i++) {
        Node *n = hash_table[i];
        while (n) {
            if (n->visited) visited_count++;
            n = n->next;
        }
    }
    printf("Visited k-mers: %d\n", visited_count);
    
    /* Count start points (left_ext == F) */
    int start_count = 0;
    for (int i = 0; i < HASH_SIZE; i++) {
        Node *n = hash_table[i];
        while (n) {
            if (n->left_ext == 'F') start_count++;
            n = n->next;
        }
    }
    printf("Start points (left_ext == F): %d\n", start_count);
    
    /* Cleanup */
    for (int i = 0; i < HASH_SIZE; i++) {
        Node *n = hash_table[i];
        while (n) {
            Node *next = n->next;
            free(n);
            n = next;
        }
    }
    free(thread_data);
    free(threads);
    
    return 0;
}
