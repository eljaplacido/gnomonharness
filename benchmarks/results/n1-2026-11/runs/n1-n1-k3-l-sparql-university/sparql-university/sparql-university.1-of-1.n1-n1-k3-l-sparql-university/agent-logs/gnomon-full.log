from rdflib import Graph, Namespace

g = Graph()
g.parse("/app/university_graph.ttl", format="turtle")

# Check full professors
print("=== Full Professors ===")
q1 = """
PREFIX uni: <http://university.org/ontology/>
SELECT ?professor ?name ?role
WHERE {
  ?professor a uni:Person ;
             uni:hasName ?name ;
             uni:role ?role .
  FILTER(CONTAINS(?role, "Professor") && !CONTAINS(?role, "Assistant"))
}
"""
for row in g.query(q1):
    print(f"  {row.name} ({row.role})")

# Check departments and countries
print("\n=== Departments and Countries ===")
q2 = """
PREFIX uni: <http://university.org/ontology/>
SELECT ?dept ?uni ?country
WHERE {
  ?dept a uni:Department ;
        uni:belongsTo ?uni .
  ?uni uni:locatedInCountry ?country .
}
"""
for row in g.query(q2):
    print(f"  {row.dept} -> {row.country}")

# Check courses and departments
print("\n=== Courses and Departments ===")
q3 = """
PREFIX uni: <http://university.org/ontology/>
SELECT ?course ?dept
WHERE {
  ?course a uni:Course ;
          uni:isTaughtIn ?dept .
}
"""
for row in g.query(q3):
    print(f"  {row.course} -> {row.dept}")
