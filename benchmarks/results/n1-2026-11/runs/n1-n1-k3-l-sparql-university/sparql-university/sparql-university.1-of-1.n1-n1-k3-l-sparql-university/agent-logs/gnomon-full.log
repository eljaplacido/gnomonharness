from rdflib import Graph, Namespace, Literal
from datetime import date

g = Graph()
g.parse("/app/university_graph.ttl", format="turtle")

# Check active student counts per department
print("=== Active students per department ===")
q = """
PREFIX uni: <http://university.org/ontology/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema/>
SELECT ?dept (COUNT(DISTINCT ?student) AS ?studentCount)
WHERE {
  ?student a uni:Person ;
           uni:isEnrolledIn ?course .
  ?course uni:isTaughtIn ?dept .
  OPTIONAL { ?student uni:hasGraduationDate ?gradDate }
  FILTER(
    (!BOUND(?gradDate) || ?gradDate > "2025-08-16"^^xsd:date)
  )
}
GROUP BY ?dept
"""
for row in g.query(q):
    print(f"  {row.dept}: {row.studentCount}")

# Check which departments have >10
print("\n=== Departments with >10 active students ===")
q2 = """
PREFIX uni: <http://university.org/ontology/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema/>
SELECT ?dept (COUNT(DISTINCT ?student) AS ?studentCount)
WHERE {
  ?student a uni:Person ;
           uni:isEnrolledIn ?course .
  ?course uni:isTaughtIn ?dept .
  OPTIONAL { ?student uni:hasGraduationDate ?gradDate }
  FILTER(
    (!BOUND(?gradDate) || ?gradDate > "2025-08-16"^^xsd:date)
  )
}
GROUP BY ?dept
HAVING (COUNT(DISTINCT ?student) > 10)
"""
for row in g.query(q2):
    print(f"  {row.dept}: {row.studentCount}")
