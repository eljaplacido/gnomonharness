import json, torch
from transformers import AutoTokenizer, AutoModelForSequenceClassification

# Load merged model from disk
model = AutoModelForSequenceClassification.from_pretrained('/app/merged_model/')
tokenizer = AutoTokenizer.from_pretrained('/app/merged_model/')
print(f'Model loaded. num_labels={model.config.num_labels}')

test_samples = [
    'Bonjour, comment allez-vous aujourd\\'hui?',
    'Hola, \\u00bfc\\u00f3mo est\\u00e1s hoy?',
    'Guten Tag, wie geht es Ihnen?',
    'Ciao, come stai oggi?',
    'Ol\\u00e1, como voc\\u00ea est\\u00e1?',
    '\\u041f\\u0440\\u0438\\u0432\\u0435\\u0442, \\u043a\\u0430\\u043a \\u0434\\u0435\\u043b\\u0430?',
    '\\u3053\\u3093\\u306b\\u3061\\u306f\\u3001\\u304a\\u5143\\u6c17\\u3067\\u3059\\u304b\\uff1f',
    '\\u4f60\\u597d\\uff0c\\u4f60\\u597d\\u5417\\uff1f',
    '\\u0645\\u0631\\u062d\\u0628\\u0627\\u060c \\u0643\\u064a\\u0641 \\u062d\\u0627\\u0644\\u0643\\u061f',
    'Hello, how are you?',
]

model.eval()
with torch.no_grad():
    for text in test_samples:
        inputs = tokenizer(text, return_tensors='pt', truncation=True, max_length=512)
        outputs = model(**inputs)
        probs = torch.softmax(outputs.logits, dim=-1)
        pred = torch.argmax(probs, dim=-1).item()
        conf = probs[0][pred].item()
        print(f'  {text[:40]:<40s} -> class {pred} (conf: {conf:.4f})')

# Verify results file matches
with open('/app/detection_results.json') as f:
    results = json.load(f)
print(f'\\nResults file has {len(results)} entries')
print('All checks passed!')
