[12.551061, "o", "> [\r\n\u001b[?2004l\r\u001b[?2004h>   {\r\n\u001b[?2004l\r"]
[12.551083, "o", "\u001b[?2004h> "]
[12.55114, "o", "    \"id\": 1,                  # Unique numeric identifier for the user\r\n\u001b[?2004l\r\u001b[?2004h> "]
[12.551204, "o", "    \"username\": \"john_doe\",   # User'\"'\"'s unique username (string)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[12.551268, "o", "    \"email\": \"john@example.com\",  # User'\"'\"'s email address (string)\r\n\u001b[?2004l\r\u001b[?2004h"]
[12.551289, "o", "> "]
