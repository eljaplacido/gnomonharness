[12.552093, "o", "\u001b[?2004h> "]
[12.55218, "o", "    \"primary_role\": \"admin\"       # If '\"'\"'roles'\"'\"' is empty, this must be null (JSON null, not \"null\")\r\n\u001b[?2004l\r"]
