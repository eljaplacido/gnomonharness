[12.548889, "o", "   '\"'\"'/app/jq_args.yaml'\"'\"' Example format:\r\n\u001b[?2004l\r\u001b[?2004h"]
[12.548914, "o", ">    ```\r\n\u001b[?2004l\r\u001b[?2004h> "]
