# Check plugin_attr - these are likely the config key-value pairs
# 49 101 55 = 'twist' in ASCII
# 52 101 54 = 'bend' in ASCII
# 48 46 48 53 = '0.05' in ASCII
print('plugin_attr as text:')
for i in range(0, len(model.plugin_attr), 2):
    key_bytes = model.plugin_attr[i:i+3]
    val_bytes = model.plugin_attr[i+4:i+8]
    try:
        key = bytes(key_bytes).decode('ascii')
    except:
        key = str(key_bytes)
    try:
        val = bytes(val_bytes).decode('ascii')
    except:
        val = str(val_bytes)
    print(f'  {key} = {val}')
print()
# Check the plugin config key-value pairs
print('Plugin config:')
for i in range(model.plugin[0]):
    pc = model.plugin_config[i]
    print(f'  key={pc.key}, value={pc.value}')
print()
