# reading-group-join@local.edu SHOULD work because the transport map
# has that entry. But Postfix is checking local recipient table first.
#
# Let me try setting local_recipient_maps to empty, so Postfix doesn't
# check local recipient table for local.edu addresses.

cat > /etc/postfix/main.cf << 'POSTFIXCF'
smtpd_banner = $myhostname ESMTP $mail_name (Ubuntu)
biff = no
append_dot_mydomain = no
readme_directory = no
compatibility_level = 3.6

smtpd_tls_cert_file=/etc/ssl/certs/ssl-cert-snakeoil.pem
smtpd_tls_key_file=/etc/ssl/private/ssl-cert-snakeoil.key
smtpd_tls_security_level=may
smtp_tls_CApath=/etc/ssl/certs
smtp_tls_security_level=may
smtp_tls_session_cache_database = btree:${data_directory}/smtp_scache

smtpd_relay_restrictions = permit_mynetworks permit_sasl_authenticated defer_unauth_destination
myhostname = localhost
alias_maps = hash:/etc/aliases
alias_database = hash:/etc/aliases
mydestination = localhost, localhost.localdomain, local.edu
relayhost =
mynetworks = 127.0.0.0/8 [::ffff:127.0.0.0]/104 [::1]/128
mailbox_size_limit = 0
recipient_delimiter = +
inet_interfaces = all
inet_protocols = all

# Transport maps: route list addresses to LMTP
transport_maps = hash:/var/lib/mailman3/data/postfix_lmtp
# Virtual alias maps: redirect user@local.edu to local delivery
virtual_alias_maps = hash:/etc/postfix/virtual
# Don't check local recipient table
local_recipient_maps =
POSTFIXCF

# Redirect user@local.edu to local delivery via virtual_alias_maps
# This ensures user mail is delivered locally
cat > /etc/postfix/virtual << 'VIRTUALES'
reading-group-join@local.edu      reading-group@local.edu
reading-group-leave@local.edu     reading-group@local.edu
VIRTUALES

postmap /etc/postfix/virtual
postfix reload 2>&1
echo "=== reload exit: $?"
sleep 2

cd /app && python3 eval.py 2>&1 — approved
