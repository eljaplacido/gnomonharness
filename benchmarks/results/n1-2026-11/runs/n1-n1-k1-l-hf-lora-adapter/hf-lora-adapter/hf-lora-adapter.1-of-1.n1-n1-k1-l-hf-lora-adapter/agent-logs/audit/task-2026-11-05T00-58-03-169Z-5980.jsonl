{"seq":32,"ts":"2026-11-05T01:00:30.931Z","kind":"approval","prev":"32842a8ff46f35c8a3cfb719b8818b7a90487d35abfcdc4071fcf1900d7d11d6","tool":"bash","summary":"bash: cd /app && python3 -c \"\nfrom transformers import AutoModelForSequenceClassification\nfrom peft import PeftModel\nimport torch\n\n# Load base model from the adapter's config which already has 20 labels\nprint('Loading base model from adapter config...')\nbase_model = AutoModelForSequenceClassification.from_pretrained(\n    'dominguesm/xlm-roberta-base-lora-language-detection',\n    num_labels=20,\n    problem_type='single_label_classification',\n)\nprint('Base model classifier:', base_model.classifier)\n\n# Now apply LoRA\nprint('Applying LoRA...')\nmodel_with_lora = PeftModel.from_pretrained(base_model, 'dominguesm/xlm-roberta-base-lora-language-detection')\nprint('LoRA applied.')\n\n# Merge\nprint('Merging...')\nmerged = model_with_lora.merge_and_unload()\n\n# Test\ntokenizer = __import__('transformers').AutoTokenizer.from_pretrained('FacebookAI/xlm-roberta-base')\nmerged.eval()\nwith torch.no_grad():\n    text = 'Hello, how are you?'\n    inputs = tokenizer(text, return_tensors='pt', truncation=True, max_length=512)\n    outputs = merged(**inputs)\n    probs = torch.softmax(outputs.logits, dim=-1)\n    pred = torch.argmax(probs, dim=-1).item()\n    conf = probs[0][pred].item()\n    print(f'Prediction: class {pred}, confidence: {conf:.4f}')\n    print('All probs:', probs[0].tolist())\n\" 2>&1","decision":"approved","by":"flag:--yes","interactive":false,"hash":"e5415c35889575e1177f3058d98f8d02e574566dc0badbbfdd12615bf9962e8a"}
