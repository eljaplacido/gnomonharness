#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define K 19
#define MAX_KMER_LEN 20
#define HASH_SIZE 131071  /* prime, power-of-2 minus 1 for masking */
#define MAX_NODES 200000

/* Each k-mer node: left extension char, right extension char, next pointer */
typedef struct Node {
    char left;
    char right;
    int next;  /* index of next node in chain, -1 if none */
} Node;

Node hash_table[HASH_SIZE];
int node_count = 0;

/* Map char to int: A=0, C=1, G=2, T=3 */
int char_to_int(char c) {
    switch(c) {
        case 'A': return 0;
        case 'C': return 1;
        case 'G': return 2;
        case 'T': return 3;
        default: return -1;
    }
}

/* Map int to char */
char int_to_char(int i) {
    switch(i) {
        case 0: return 'A';
        case 1: return 'C';
        case 2: return 'G';
        case 3: return 'T';
        default: return 'F';
    }
}

/* Hash function for k-mer string */
unsigned int hash_kmer(const char *kmer) {
    unsigned int h = 0;
    for (int i = 0; i < K; i++) {
        h = h * 4 + char_to_int(kmer[i]);
    }
    return h & HASH_MASK;
}

#define HASH_MASK HASH_SIZE - 1

/* Find or insert a k-mer in the hash table */
int find_or_insert(const char *kmer, char left, char right) {
    unsigned int idx = hash_kmer(kmer);
    int cur = hash_table[idx].next;
    
    while (cur != -1) {
        /* We need to store the k-mer to compare - but we don't have it stored */
        /* We'll use a different approach: store k-mer in a separate array */
        cur = hash_table[cur].next;
    }
    
    /* Not found, insert */
    int new_node = node_count++;
    hash_table[new_node].left = left;
    hash_table[new_node].right = right;
    hash_table[new_node].next = hash_table[idx].next;
    hash_table[idx].next = new_node;
    return new_node;
}

/* We need to store k-mers for lookup. Let's restructure. */
char kmer_store[MAX_NODES][MAX_KMER_LEN];

int find_kmer(const char *kmer) {
    unsigned int idx = hash_kmer(kmer);
    int cur = hash_table[idx].next;
    
    while (cur != -1) {
        if (strcmp(kmer_store[cur], kmer) == 0) {
            return cur;
        }
        cur = hash_table[cur].next;
    }
    return -1;
}

int find_or_insert2(const char *kmer, char left, char right) {
    int existing = find_kmer(kmer);
    if (existing != -1) {
        return existing;
    }
    
    unsigned int idx = hash_kmer(kmer);
    int new_node = node_count++;
    strcpy(kmer_store[new_node], kmer);
    kmer_store[new_node][K] = '\0';
    hash_table[new_node].left = left;
    hash_table[new_node].right = right;
    hash_table[new_node].next = hash_table[idx].next;
    hash_table[idx].next = new_node;
    return new_node;
}

/* Traverse from a node to build a contig */
void build_contig(int start, char *contig, int *contig_len) {
    /* Start with the first k-mer */
    memcpy(contig, kmer_store[start], K);
    *contig_len = K;
    
    int cur = start;
    while (hash_table[cur].right != 'F') {
        /* Find the node that has left extension matching the suffix of current contig */
        char next_left = hash_table[cur].right;
        char next_right;
        
        /* Build the expected next k-mer: last K-1 chars of current + next_right */
        /* We need to find the node whose left extension is the right extension of current */
        /* Actually, the right extension IS the next character */
        next_right = hash_table[cur].right;
        
        /* The next k-mer starts at position 1 of current k-mer + next_right */
        /* But we need to look it up in the hash table */
        /* The next k-mer = kmer_store[cur][1..K-1] + next_right */
        
        char next_kmer[MAX_KMER_LEN];
        memcpy(next_kmer, kmer_store[cur] + 1, K - 1);
        next_kmer[K - 1] = next_right;
        next_kmer[K] = '\0';
        
        int next_node = find_kmer(next_kmer);
        if (next_node == -1) break;
        
        contig[*contig_len] = next_right;
        (*contig_len)++;
        cur = next_node;
    }
    contig[*contig_len] = '\0';
}

int main(int argc, char *argv[]) {
    if (argc < 2) {
        fprintf(stderr, "Usage: %s <input_file>\n", argv[0]);
        return 1;
    }
    
    FILE *fp = fopen(argv[1], "r");
    if (!fp) {
        fprintf(stderr, "Cannot open file %s\n", argv[1]);
        return 1;
    }
    
    /* Initialize hash table */
    memset(hash_table, 0, sizeof(hash_table));
    for (int i = 0; i < HASH_SIZE; i++) {
        hash_table[i].next = -1;
    }
    
    char line[256];
    while (fgets(line, sizeof(line), fp)) {
        /* Remove newline */
        line[strcspn(line, "\n")] = '\0';
        
        /* Parse: kmer\tleft_right */
        char *tab = strchr(line, '\t');
        if (!tab) continue;
        
        *tab = '\0';
        char *kmer = line;
        char left = tab[1];
        char right = tab[2];
        
        find_or_insert2(kmer, left, right);
    }
    fclose(fp);
    
    /* Find starting nodes (left extension == 'F') and traverse */
    FILE *out = fopen("/app/serial.out", "w");
    if (!out) {
        fprintf(stderr, "Cannot open output file\n");
        return 1;
    }
    
    char contig[100000];
    int contig_len;
    
    /* Collect all start nodes */
    int starts[MAX_NODES];
    int start_count = 0;
    
    for (int i = 0; i < node_count; i++) {
        if (hash_table[i].left == 'F') {
            starts[start_count++] = i;
        }
    }
    
    /* Sort starts by k-mer for deterministic output */
    for (int i = 0; i < start_count - 1; i++) {
        for (int j = i + 1; j < start_count; j++) {
            if (strcmp(kmer_store[starts[i]], kmer_store[starts[j]]) > 0) {
                int tmp = starts[i];
                starts[i] = starts[j];
                starts[j] = tmp;
            }
        }
    }
    
    for (int i = 0; i < start_count; i++) {
        build_contig(starts[i], contig, &contig_len);
        fprintf(out, "%s\n", contig);
    }
    
    fclose(out);
    return 0;
}
