/*
 * Parallel de Bruijn graph construction and traversal for genome assembly.
 * Uses pthreads to simulate UPC's shared address space model.
 *
 * Input:  Each line: KMER<TAB>LEFT_EXT RIGHT_EXT
 *         Extensions are A/C/G/T/F (F = no extension)
 *
 * Algorithm:
 *   1. Build hash table of k-mers with their forward (right) and backward (left) extensions.
 *   2. Find starting k-mers (those with no left extension, i.e., 'F').
 *   3. Traverse forward from each start, extending the contig one base at a time.
 *   4. Output contigs to per-thread files.
 *
 * Parallel strategy:
 *   - Phase 1 (construction): Each thread reads a portion of the input file
 *     and inserts k-mers into a shared hash table with synchronization.
 *   - Phase 2 (traversal): Starting k-mers are distributed among threads.
 *     Each thread traverses its assigned starts, marking visited nodes
 *     with atomic compare-and-swap to avoid duplicates.
 *     The traversal follows the deterministic right-extension path.
 *     Each thread builds its contigs independently, and the final output
 *     is the union of all contigs.
 *
 * Key insight: The traversal is deterministic because each k-mer has exactly
 * one right extension. The contigs are determined solely by the graph structure.
 * To ensure identical contigs, we use a deterministic traversal order:
 * each thread processes starts in hash-table order, and the first thread to
 * claim a node gets to traverse through it.
 */

#define _GNU_SOURCE
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <pthread.h>
#include <stdatomic.h>
#include <unistd.h>

#define KMER_LEN 19
#define HASH_SIZE 65536
#define MAX_CONTIG_LEN 1000000
#define MAX_NODES 200000

/* Hash table entry */
typedef struct Node {
    char kmer[KMER_LEN + 1];
    char left_ext;
    char right_ext;
    atomic_int visited;
    struct Node *next;
} Node;

/* Shared state */
static Node *hash_table[HASH_SIZE];
static int hash_count = 0;
static pthread_mutex_t hash_mutex = PTHREAD_MUTEX_INITIALIZER;

/* Thread-local contig storage */
typedef struct {
    char *contigs[MAX_NODES];
    int count;
    int capacity;
} ContigList;

static ContigList **thread_contigs;
static int num_threads;

/* Simple hash function for k-mer string */
static unsigned int hash_kmer(const char *kmer) {
    unsigned int h = 5381;
    for (int i = 0; kmer[i]; i++) {
        h = ((h << 5) + h) + (unsigned char)kmer[i];
    }
    return h % HASH_SIZE;
}

/* Find a node by k-mer (caller must hold hash_mutex) */
static Node *find_node_locked(const char *kmer) {
    unsigned int idx = hash_kmer(kmer);
    Node *n = hash_table[idx];
    while (n) {
        if (strcmp(n->kmer, kmer) == 0) {
            return n;
        }
        n = n->next;
    }
    return NULL;
}

/* Find or create a node in the hash table (caller must hold hash_mutex) */
static Node *find_or_create_node_locked(const char *kmer, char left_ext, char right_ext) {
    unsigned int idx = hash_kmer(kmer);
    Node *n = hash_table[idx];
    while (n) {
        if (strcmp(n->kmer, kmer) == 0) {
            return n;
        }
        n = n->next;
    }
    n = (Node *)malloc(sizeof(Node));
    strncpy(n->kmer, kmer, KMER_LEN);
    n->kmer[KMER_LEN] = '\0';
    n->left_ext = left_ext;
    n->right_ext = right_ext;
    atomic_store(&n->visited, 0);
    n->next = hash_table[idx];
    hash_table[idx] = n;
    hash_count++;
    return n;
}

/* Build the next k-mer by shifting left and appending a nucleotide */
static void build_next_kmer(const char *prev_kmer, char nucleotide, char *next_kmer) {
    for (int i = 0; i < KMER_LEN - 1; i++) {
        next_kmer[i] = prev_kmer[i + 1];
    }
    next_kmer[KMER_LEN - 1] = nucleotide;
    next_kmer[KMER_LEN] = '\0';
}

/* Thread function: insert k-mers from the input file */
static void *insert_thread(void *arg) {
    int tid = *(int *)arg;
    FILE *fp = fopen("/app/test", "r");
    if (!fp) return NULL;

    long file_size = 0;
    fseek(fp, 0, SEEK_END);
    file_size = ftell(fp);
    fseek(fp, 0, SEEK_SET);

    long bytes_per_thread = file_size / num_threads;
    long start_offset = tid * bytes_per_thread;
    long end_offset = (tid == num_threads - 1) ? file_size : (tid + 1) * bytes_per_thread;

    fseek(fp, start_offset, SEEK_SET);

    /* Skip to the beginning of a line if we're in the middle */
    if (start_offset > 0) {
        int c;
        while ((c = fgetc(fp)) != '\n' && c != EOF) {}
    }

    char line[256];
    while (ftell(fp) < end_offset && fgets(line, sizeof(line), fp)) {
        line[strcspn(line, "\r\n")] = '\0';
        if (strlen(line) == 0) continue;

        char kmer[KMER_LEN + 1];
        char ext[3];

        char *tab = strchr(line, '\t');
        if (!tab) continue;

        int klen = tab - line;
        if (klen != KMER_LEN) continue;

        strncpy(kmer, line, KMER_LEN);
        kmer[KMER_LEN] = '\0';

        ext[0] = tab[1];
        ext[1] = tab[2];
        ext[2] = '\0';

        pthread_mutex_lock(&hash_mutex);
        find_or_create_node_locked(kmer, ext[0], ext[1]);
        pthread_mutex_unlock(&hash_mutex);
    }

    fclose(fp);
    return NULL;
}

/* Thread function: traverse and build contigs */
static void *traverse_thread(void *arg) {
    int tid = *(int *)arg;
    ContigList *clist = thread_contigs[tid];

    /* Collect all starting k-mers (left_ext == 'F') */
    pthread_mutex_lock(&hash_mutex);

    int start_count = 0;
    for (int i = 0; i < HASH_SIZE; i++) {
        Node *n = hash_table[i];
        while (n) {
            if (n->left_ext == 'F') start_count++;
            n = n->next;
        }
    }

    Node **starts = (Node **)malloc(sizeof(Node *) * start_count);
    int sc = 0;
    for (int i = 0; i < HASH_SIZE; i++) {
        Node *n = hash_table[i];
        while (n) {
            if (n->left_ext == 'F') {
                starts[sc++] = n;
            }
            n = n->next;
        }
    }
    pthread_mutex_unlock(&hash_mutex);

    /* Distribute starts among threads by index */
    for (int i = 0; i < sc; i++) {
        if (i % num_threads != tid) continue;

        Node *n = starts[i];

        /* Use CAS to claim this start node */
        int expected = 0;
        if (!atomic_compare_exchange_strong(&n->visited, &expected, 1)) {
            /* Another thread already claimed this start */
            continue;
        }

        /* Build contig */
        char contig[MAX_CONTIG_LEN];
        int clen = 0;

        memcpy(contig, n->kmer, KMER_LEN);
        clen = KMER_LEN;

        char current_kmer[KMER_LEN + 1];
        strcpy(current_kmer, n->kmer);

        while (n->right_ext != 'F') {
            char next_nuc = n->right_ext;
            char next_kmer[KMER_LEN + 1];
            build_next_kmer(current_kmer, next_nuc, next_kmer);

            pthread_mutex_lock(&hash_mutex);
            Node *next_node = find_node_locked(next_kmer);
            if (next_node) {
                /* Use CAS to claim this node */
                expected = 0;
                if (atomic_compare_exchange_strong(&next_node->visited, &expected, 1)) {
                    /* We claimed this node */
                    pthread_mutex_unlock(&hash_mutex);
                    contig[clen] = next_nuc;
                    clen++;
                    strcpy(current_kmer, next_kmer);
                    n = next_node;
                    continue;
                }
            }
            pthread_mutex_unlock(&hash_mutex);

            /* Could not claim this node - another thread claimed it */
            break;
        }

        contig[clen] = '\0';

        /* Store contig in thread's list */
        if (clist->count < clist->capacity) {
            clist->contigs[clist->count++] = strdup(contig);
        }
    }

    free(starts);
    return NULL;
}

int main(int argc, char *argv[]) {
    if (argc < 2) {
        fprintf(stderr, "Usage: %s <input_file>\n", argv[0]);
        return 1;
    }

    /* Determine number of threads from environment or default to 4 */
    char *env_threads = getenv("UPC_THREADS");
    if (env_threads) {
        num_threads = atoi(env_threads);
        if (num_threads <= 0) num_threads = 4;
    } else {
        num_threads = 4;
    }

    /* Initialize hash table */
    memset(hash_table, 0, sizeof(hash_table));

    /* Allocate thread contig lists */
    thread_contigs = (ContigList **)malloc(sizeof(ContigList *) * num_threads);
    for (int i = 0; i < num_threads; i++) {
        thread_contigs[i] = (ContigList *)malloc(sizeof(ContigList));
        thread_contigs[i]->count = 0;
        thread_contigs[i]->capacity = MAX_NODES;
    }

    /* Phase 1: Parallel hash table construction */
    pthread_t *insert_threads = (pthread_t *)malloc(sizeof(pthread_t) * num_threads);
    int *thread_ids = (int *)malloc(sizeof(int) * num_threads);
    for (int i = 0; i < num_threads; i++) {
        thread_ids[i] = i;
        pthread_create(&insert_threads[i], NULL, insert_thread, &thread_ids[i]);
    }
    for (int i = 0; i < num_threads; i++) {
        pthread_join(insert_threads[i], NULL);
    }

    /* Phase 2: Parallel traversal */
    pthread_t *traverse_threads = (pthread_t *)malloc(sizeof(pthread_t) * num_threads);
    for (int i = 0; i < num_threads; i++) {
        pthread_create(&traverse_threads[i], NULL, traverse_thread, &thread_ids[i]);
    }
    for (int i = 0; i < num_threads; i++) {
        pthread_join(traverse_threads[i], NULL);
    }

    /* Output contigs to per-thread files */
    for (int i = 0; i < num_threads; i++) {
        char outfile[256];
        snprintf(outfile, sizeof(outfile), "/app/pgen_%d.out", i);
        FILE *out = fopen(outfile, "w");
        if (!out) {
            fprintf(stderr, "Cannot open output file: %s\n", outfile);
            continue;
        }
        for (int j = 0; j < thread_contigs[i]->count; j++) {
            fprintf(out, "%s\n", thread_contigs[i]->contigs[j]);
            free(thread_contigs[i]->contigs[j]);
        }
        fclose(out);
    }

    /* Cleanup */
    for (int i = 0; i < num_threads; i++) {
        free(thread_contigs[i]);
    }
    free(thread_contigs);
    free(insert_threads);
    free(traverse_threads);
    free(thread_ids);

    /* Free hash table */
    for (int i = 0; i < HASH_SIZE; i++) {
        Node *n = hash_table[i];
        while (n) {
            Node *next = n->next;
            free(n);
            n = next;
        }
    }

    return 0;
}

