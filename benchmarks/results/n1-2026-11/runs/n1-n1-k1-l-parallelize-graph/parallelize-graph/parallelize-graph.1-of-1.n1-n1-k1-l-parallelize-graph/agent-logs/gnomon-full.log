/*
 * Serial de Bruijn graph construction and traversal for genome assembly.
 *
 * Input:  Each line: KMER<TAB>LEFT_EXT RIGHT_EXT
 *         Extensions are A/C/G/T/F (F = no extension)
 *
 * Algorithm:
 *   1. Build hash table of k-mers with their forward (right) and backward (left) extensions.
 *   2. Find starting k-mers (those with no left extension, i.e., 'F').
 *   3. Traverse forward from each start, extending the contig one base at a time.
 *   4. Output contigs.
 */

#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define KMER_LEN 19
#define HASH_SIZE 65536
#define MAX_CONTIG_LEN 1000000

/* Hash table entry */
typedef struct Node {
    char kmer[KMER_LEN + 1];   /* k-mer string */
    char left_ext;             /* left extension (A/C/G/T/F) */
    char right_ext;            /* right extension (A/C/G/T/F) */
    int visited;               /* whether this k-mer has been visited */
    struct Node *next;         /* next entry for separate chaining */
} Node;

static Node *hash_table[HASH_SIZE];
static int hash_count = 0;

/* Simple hash function for k-mer string */
static unsigned int hash_kmer(const char *kmer) {
    unsigned int h = 5381;
    for (int i = 0; kmer[i]; i++) {
        h = ((h << 5) + h) + (unsigned char)kmer[i];
    }
    return h % HASH_SIZE;
}

/* Find or create a node in the hash table */
static Node *find_or_create_node(const char *kmer, char left_ext, char right_ext) {
    unsigned int idx = hash_kmer(kmer);
    Node *n = hash_table[idx];
    while (n) {
        if (strcmp(n->kmer, kmer) == 0) {
            return n;
        }
        n = n->next;
    }
    /* Create new node */
    n = (Node *)malloc(sizeof(Node));
    strncpy(n->kmer, kmer, KMER_LEN);
    n->kmer[KMER_LEN] = '\0';
    n->left_ext = left_ext;
    n->right_ext = right_ext;
    n->visited = 0;
    n->next = hash_table[idx];
    hash_table[idx] = n;
    hash_count++;
    return n;
}

/* Find a node by k-mer */
static Node *find_node(const char *kmer) {
    unsigned int idx = hash_kmer(kmer);
    Node *n = hash_table[idx];
    while (n) {
        if (strcmp(n->kmer, kmer) == 0) {
            return n;
        }
        n = n->next;
    }
    return NULL;
}

/* Build the next k-mer by shifting left and appending a nucleotide */
static void build_next_kmer(const char *prev_kmer, char nucleotide, char *next_kmer) {
    for (int i = 0; i < KMER_LEN - 1; i++) {
        next_kmer[i] = prev_kmer[i + 1];
    }
    next_kmer[KMER_LEN - 1] = nucleotide;
    next_kmer[KMER_LEN] = '\0';
}

int main(int argc, char *argv[]) {
    if (argc < 2) {
        fprintf(stderr, "Usage: %s <input_file>\n", argv[0]);
        return 1;
    }

    FILE *fp = fopen(argv[1], "r");
    if (!fp) {
        fprintf(stderr, "Cannot open file: %s\n", argv[1]);
        return 1;
    }

    /* Initialize hash table */
    memset(hash_table, 0, sizeof(hash_table));

    /* Read input and build hash table */
    char line[256];
    while (fgets(line, sizeof(line), fp)) {
        line[strcspn(line, "\r\n")] = '\0';
        if (strlen(line) == 0) continue;

        char kmer[KMER_LEN + 1];
        char ext[3];

        char *tab = strchr(line, '\t');
        if (!tab) continue;

        int klen = tab - line;
        if (klen != KMER_LEN) continue;

        strncpy(kmer, line, KMER_LEN);
        kmer[KMER_LEN] = '\0';

        ext[0] = tab[1];
        ext[1] = tab[2];
        ext[2] = '\0';

        find_or_create_node(kmer, ext[0], ext[1]);
    }
    fclose(fp);

    /* Output file */
    FILE *out = fopen("/app/serial.out", "w");
    if (!out) {
        fprintf(stderr, "Cannot open output file\n");
        return 1;
    }

    /* Find all starting k-mers (left extension is 'F') */
    for (int i = 0; i < HASH_SIZE; i++) {
        Node *n = hash_table[i];
        while (n) {
            if (n->left_ext == 'F' && !n->visited) {
                /* Start a contig from this node */
                char contig[MAX_CONTIG_LEN];
                int clen = 0;

                /* Write the full k-mer */
                memcpy(contig, n->kmer, KMER_LEN);
                clen = KMER_LEN;
                n->visited = 1;

                /* Traverse forward */
                char current_kmer[KMER_LEN + 1];
                strcpy(current_kmer, n->kmer);

                while (n->right_ext != 'F') {
                    char next_nuc = n->right_ext;
                    char next_kmer[KMER_LEN + 1];
                    build_next_kmer(current_kmer, next_nuc, next_kmer);

                    Node *next_node = find_node(next_kmer);
                    if (!next_node || next_node->visited) {
                        break;
                    }

                    next_node->visited = 1;
                    contig[clen] = next_nuc;
                    clen++;
                    strcpy(current_kmer, next_kmer);
                    n = next_node;
                }

                contig[clen] = '\0';
                fprintf(out, "%s\n", contig);
            }
            n = n->next;
        }
    }

    fclose(out);

    /* Free hash table */
    for (int i = 0; i < HASH_SIZE; i++) {
        Node *n = hash_table[i];
        while (n) {
            Node *next = n->next;
            free(n);
            n = next;
        }
    }

    return 0;
}
