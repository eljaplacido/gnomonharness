[14.094965, "o", "- train.json: 300 training samples\r\n\u001b[?2004l\r"]
[14.094985, "o", "\u001b[?2004h> "]
[14.095034, "o", "- val.json: 100 validation samples\r\n\u001b[?2004l\r"]
[14.095051, "o", "\u001b[?2004h> \r\n"]
[14.095068, "o", "\u001b[?2004l\r\u001b[?2004h"]
[14.09509, "o", "> "]
[14.095209, "o", "NOTE: The test set is NOT available in the data folder during training to prevent overfitting. \r\n\u001b[?2004l\r\u001b[?2004h"]
[14.095243, "o", "> "]
[14.09532, "o", "It is stored separately and only accessible during the evaluation phase.\r\n\u001b[?2004l\r"]
[14.095336, "o", "\u001b[?2004h> \r\n"]
[14.095351, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[14.095407, "o", "Each sample has the following structure:\r\n\u001b[?2004l\r"]
[14.095421, "o", "\u001b[?2004h> "]
[14.095433, "o", "{\r\n\u001b[?2004l\r"]
[14.095447, "o", "\u001b[?2004h> "]
[14.095529, "o", "  \"question\": \"What is the primary function of hemoglobin?\",\r\n\u001b[?2004l\r"]
[14.095546, "o", "\u001b[?2004h> "]
[14.095724, "o", "  \"options\": [\"A) Transport oxygen\", \"B) Fight infections\", \"C) Clot blood\", \"D) Digest food\"],  // Exactly 4 options (A, B, C, D)\r\n\u001b[?2004l\r"]
[14.095738, "o", "\u001b[?2004h> "]
[14.095768, "o", "  \"answer\": \"A\"\r\n\u001b[?2004l\r"]
[14.095799, "o", "\u001b[?2004h"]
[14.09581, "o", "> "]
