{
  "name": "gnomon-natives",
  "version": "0.1.0",
  "private": true,
  "description": "Typed access to the gnomon Rust binaries. Shells out to gnomon-surface and gnomon-enums; no native addon is built or loaded.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
