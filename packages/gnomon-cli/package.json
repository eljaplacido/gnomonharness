{
  "name": "gnomon-cli",
  "version": "0.1.0",
  "description": "Thin shell over gnomon-core. CLI entry point.",
  "type": "module",
  "bin": {
    "gnomon": "./gnomon.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "gnomon-core": "workspace:*",
    "gnomon-natives": "workspace:*",
    "gnomon-tui": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "author": "Elja Placido <digicisu@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/eljaplacido/gnomonharness"
  }
}
