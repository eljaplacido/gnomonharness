{
  "name": "gnomon-harness",
  "version": "0.2.3",
  "description": "Deterministic, capability-gated terminal coding agent. Behaviour is fixed by a content-hashed .gnomon/ directory in your repository, not by your machine.",
  "type": "module",
  "bin": {
    "gnomon": "./gnomon.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "gnomon-core": "workspace:*",
    "gnomon-natives": "workspace:*",
    "gnomon-tui": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "author": "Elja Placido <digicisu@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/eljaplacido/gnomonharness"
  },
  "keywords": [
    "ai",
    "agent",
    "coding-agent",
    "cli",
    "terminal",
    "llm",
    "ollama",
    "openai",
    "deterministic",
    "sandbox",
    "harness",
    "tui"
  ],
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "bin": {
      "gnomon": "./bin/gnomon.mjs"
    }
  }
}
