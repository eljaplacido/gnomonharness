#!/usr/bin/env node
// gnomon CLI launcher — single command: ./gnomon <args>
// Usage:
//   cd /path/to/gnomon && ./gnomon <cmd>
//   ./gnomon tui
//   ./gnomon prompt
//   ./gnomon session "echo hello"
const { spawnSync } = require("child_process");
const { join, resolve } = require("path");
const { existsSync } = require("fs");

// __dirname resolves to where this script lives (the repo root)
const projectRoot = resolve(__dirname);

// Find tsx — it's a shell script, not a JS file
const tsxBin = join(projectRoot, "node_modules", ".bin", "tsx");
const tsxBinWin = join(projectRoot, "node_modules", ".bin", "tsx.cmd");
const entry = join(projectRoot, "packages", "gnomon-cli", "src", "index.ts");

// Prefer tsx.cmd on Windows, tsx on Unix
const bin = existsSync(tsxBinWin) ? tsxBinWin : tsxBin;

const result = spawnSync(bin, [entry, ...process.argv.slice(2)], {
  stdio: "inherit",
  shell: true,
  cwd: projectRoot,
});

process.exit(result.status ?? 1);
