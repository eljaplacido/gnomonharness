#!/usr/bin/env node
// gnomon repo-root convenience shim.
//
// Deliberately thin: it re-executes the real launcher at
// packages/gnomon-cli/gnomon.js rather than re-implementing it. There used to
// be two launchers with two policies, and the one the README told people to
// use was the one that still pinned cwd to the checkout and passed argv
// through a shell — so `./gnomon task "fix the bug & ship it"` arrived as
// five arguments and ran against the wrong repository.
//
// CommonJS: the root package.json declares no "type", unlike gnomon-cli's.
const { spawnSync } = require("node:child_process");
const { join } = require("node:path");

const launcher = join(__dirname, "packages", "gnomon-cli", "gnomon.js");
const r = spawnSync(process.execPath, [launcher, ...process.argv.slice(2)], {
  stdio: "inherit",
});
if (r.error) {
  console.error("gnomon: " + r.error.message);
  process.exit(1);
}
process.exit(r.status ?? 1);
