#!/usr/bin/env node
// gnomon repo-root convenience shim.
//
// Deliberately thin: it runs the real launcher at
// packages/gnomon-cli/gnomon.js rather than re-implementing it. There used to
// be two launchers with two policies, and the one the README told people to
// use was the one that still pinned cwd to the checkout and passed argv
// through a shell — so `./gnomon task "fix the bug & ship it"` arrived as
// five arguments and ran against the wrong repository.
//
// In this process, not as a child. A child left this process waiting with the
// whole task text in its own /proc cmdline, so a model's `pkill -f anon.py`
// still killed the process the caller waits on (exit 143, the run lost) after
// the CLI had retitled itself "gnomon task" (gnomon-cli's proc_title.ts).
// Imported, the CLI's title is this process's title. argv[1] is set to the
// launcher, the argv the launcher had as a child, so the CLI's own uses of it
// (the dashboard's CLI entry, the trust check's list of gnomon's own code)
// read what they read before.
//
// CommonJS: the root package.json declares no "type", unlike gnomon-cli's.
const { join } = require("node:path");
const { pathToFileURL } = require("node:url");

const launcher = join(__dirname, "packages", "gnomon-cli", "gnomon.js");
process.argv[1] = launcher;
// No .catch: a failure surfaces exactly as it does from gnomon.js itself.
import(pathToFileURL(launcher).href);
