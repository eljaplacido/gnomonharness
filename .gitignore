# Dependencies
node_modules/
target/

# pnpm-lock.yaml is deliberately tracked: `pnpm install --frozen-lockfile`
# needs it, and a harness whose whole claim is reproducibility cannot ignore
# the file that pins its dependencies.

# Build artifacts
*.node
dist/

# pnpm store
.pnpm-store/

# Runtime
sessions/
*.log
*.jsonl

# OS
.DS_Store
Thumbs.db

# Session snapshots and audit trails are machine-local and hold
# conversation text. They must never enter the repository.
.gnomon-sessions/
.gnomon-audit/

# Local API key drop — never commit. Keys belong in the machine-local
# credential store (`gnomon key set`), never in the repo.
api.txt
*.key
.env
.gnomon-loops/

# Transient scratch the write-path unit tests drop at the config root.
# They are test output, never source; the tests assert on the write outcome,
# not the file's persistence.
/x.txt
/y.txt

# Python bytecode (benchmarks/ is Python).
__pycache__/
*.pyc
.pytest_cache/

# Root-level research scratch (working notes, not repo content — move to docs/ to keep).
/Common Denominators of Top-Performing AI Agent Harnesses.md
/Gnomon Harness Benchmark Post-Mortem Review and Path to SOTA.md
