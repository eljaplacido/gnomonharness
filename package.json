{
  "name": "gnomon",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic coding agent harness — repo-scoped config, content-hashed surface",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "overrides": {
      "gnomon-core": "workspace:*",
      "gnomon-natives": "workspace:*"
    }
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "test:core": "pnpm --filter gnomon-core test",
    "test:natives": "pnpm --filter gnomon-natives test",
    "test:cli": "pnpm --filter gnomon-cli test",
    "lint": "pnpm -r run lint",
    "conformance:exit-codes": "node packages/gnomon-cli/conformance/exit_codes.js",
    "conformance:enumerations": "node packages/gnomon-cli/conformance/enumerations.js",
    "conformance:session": "node packages/gnomon-cli/conformance/session.js"
  },
  "devDependencies": {
    "tsx": "^4.23.12"
  }
}
