{
  "name": "gnomon",
  "version": "0.2.2",
  "private": true,
  "description": "Deterministic coding agent harness — repo-scoped config, content-hashed surface",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/eljaplacido/gnomonharness.git"
  },
  "homepage": "https://github.com/eljaplacido/gnomonharness#readme",
  "bugs": {
    "url": "https://github.com/eljaplacido/gnomonharness/issues"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "overrides": {
      "gnomon-core": "workspace:*",
      "gnomon-natives": "workspace:*"
    }
  },
  "scripts": {
    "build": "pnpm -r run build",
    "setup": "pnpm install && pnpm run build:native && pnpm run build && pnpm run link:global",
    "build:native": "node scripts/build-native.mjs",
    "test": "pnpm -r run test",
    "gnomon": "tsx packages/gnomon-cli/src/index.ts",
    "gnomon:tui": "tsx packages/gnomon-cli/src/index.ts tui",
    "test:core": "pnpm --filter gnomon-core test",
    "test:natives": "pnpm --filter gnomon-natives test",
    "test:cli": "pnpm --filter gnomon-cli test",
    "test:tui": "pnpm --filter gnomon-tui test",
    "typecheck": "pnpm -r run build",
    "lint": "cargo clippy --all -- -D warnings",
    "link:global": "node scripts/link-global.mjs",
    "unlink:global": "cd packages/gnomon-cli && pnpm unlink --global",
    "coverage": "pnpm --filter gnomon-core exec vitest run --coverage.enabled --coverage.provider=v8 --coverage.reporter=text-summary"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.0",
    "tsx": "^4.23.13",
    "vite": "^7.0.0"
  },
  "author": "Elja Placido <digicisu@gmail.com>"
}
