{
  "name": "gnomon",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic coding agent harness \u2014 repo-scoped config, content-hashed surface",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/eljaplacido/gnomonharness.git"
  },
  "homepage": "https://github.com/eljaplacido/gnomonharness#readme",
  "bugs": {
    "url": "https://github.com/eljaplacido/gnomonharness/issues"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "overrides": {
      "gnomon-core": "workspace:*",
      "gnomon-natives": "workspace:*"
    }
  },
  "scripts": {
    "build": "pnpm -r run build",
    "setup": "pnpm install && pnpm run build:native && pnpm run link:global",
    "build:native": "cargo build --release --bin gnomon-surface --bin gnomon-enums",
    "test": "pnpm -r run test",
    "gnomon": "tsx packages/gnomon-cli/src/index.ts",
    "gnomon:tui": "tsx packages/gnomon-cli/src/index.ts tui",
    "test:core": "pnpm --filter gnomon-core test",
    "test:natives": "pnpm --filter gnomon-natives test",
    "test:cli": "pnpm --filter gnomon-cli test",
    "test:tui": "pnpm --filter gnomon-tui test",
    "lint": "pnpm -r run lint",
    "conformance:exit-codes": "node packages/gnomon-cli/conformance/exit_codes.js",
    "conformance:enumerations": "node packages/gnomon-cli/conformance/enumerations.js",
    "conformance:session": "node packages/gnomon-cli/conformance/session.js",
    "link:global": "cd packages/gnomon-cli && pnpm link --global",
    "unlink:global": "cd packages/gnomon-cli && pnpm unlink --global"
  },
  "devDependencies": {
    "tsx": "^4.23.12"
  }
}
