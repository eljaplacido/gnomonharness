{
  "schema": "gnomon.improve/1",
  "section": "CONTRACTS.md section 59",
  "exit_codes": {"ok": 0, "usage": 1, "refused": 3, "could_not_run": 10},
  "mine_families": ["skill", "retire", "memory", "harness"],
  "candidate_kinds": ["skill", "retire", "memory", "harness", "composed"],
  "probe_statuses": ["probed", "unprobed", "failed", "skipped"],
  "lint_rules": ["secret", "narration", "negative_claim", "loosens_policy", "name", "description", "length", "no_why", "format", "harness_removes", "harness_empty"],
  "policy_keys": ["auto_accept", "min_probe_runs", "min_pass_delta", "max_token_increase", "role", "k", "budget_usd", "usd_per_mtok_in", "usd_per_mtok_out", "scheduled"],
  "policy_defaults": {"min_probe_runs": 3, "min_pass_delta": 0, "max_token_increase": 0},
  "policy_rule": "improve.auto_accept",
  "never_by_policy": ["policy.toml", "roles.toml", "tools.toml", "config.toml", "trials/", "loops/", "extensions/", "profiles/"],
  "limits": {"candidates_per_run": 6, "skill_body": 1500, "skill_description": 160, "memory_body": 600, "harness_added": 700},
  "runs_dir": ".gnomon-proposals/improve",
  "report_keys": ["schema", "mode", "run", "mined", "role", "probe", "candidates", "proposals", "policy", "budget", "inbox", "problems"],
  "audit": {"kind": "proposal_decision", "added_optional_fields": ["policy_rule", "policy_evidence"]}
}
