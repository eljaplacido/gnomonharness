{
  "v": 1,
  "_comment": [
    "docs/CONTRACTS.md section 40: [sandbox] profile = \"container\", opt-in, for runs inside a disposable container that is already the sandbox.",
    "packages/gnomon-core/src/sandbox_profile.test.ts asserts the code equals this file."
  ],
  "key": "policy.toml [sandbox] profile",
  "values": [
    "default",
    "container"
  ],
  "default": "default",
  "relaxes": [
    "network",
    "file_tools_scratch",
    "shell_bash",
    "soft_shell",
    "timeout_rerun_refusal",
    "command_env"
  ],
  "keeps": [
    "surface",
    "record",
    "git_hooks",
    "host_hooks",
    "secret_path",
    "ci_path",
    "outside_root",
    "bash_deny",
    "sudo",
    "approval",
    "timeout_kill_process_group"
  ],
  "env": {
    "PAGER": "cat",
    "TQDM_DISABLE": "1",
    "PIP_PROGRESS_BAR": "off"
  },
  "shell": {
    "preferred": "/bin/bash",
    "fallback": "/bin/sh"
  },
  "session_start": {
    "key": "resolved.sandbox_profile",
    "keys": [
      "name",
      "relaxed",
      "kept",
      "shell"
    ]
  },
  "pin": "turned on mid-session is a loosening and is not applied"
}
