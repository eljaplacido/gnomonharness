{
  "version": "0.1.0",
  "_comment": [
    "The `gnomon compliance --json` document, schema gnomon.compliance/1 (docs/CONTRACTS.md §46).",
    "",
    "A mapping of gnomon evidence to framework controls from the dated catalog",
    "packages/gnomon-cli/catalog/controls.toml; never an assessment, never 'compliant'.",
    "A status, scope, probe or framework id added, a key renamed or an exit moved",
    "is a contract change: packages/gnomon-cli/src/compliance.test.ts asserts the",
    "lists here equal the code's and checks real reports against the keys."
  ],
  "schema": "gnomon.compliance/1",
  "exit_codes": {
    "0": "every control gnomon can evidence has its evidence",
    "2": "a control is partial or a gap: a probe that does not hold names the setting that would",
    "10": "compliance could not run (no .gnomon/, a catalog that does not parse, an unknown framework)"
  },
  "frameworks": [
    "eu-ai-act",
    "gdpr",
    "owasp-llm",
    "iso-42001",
    "nist-ai-rmf",
    "iso-27001",
    "soc2",
    "cra",
    "dora"
  ],
  "statuses": [
    "evidence",
    "partial",
    "gap",
    "harness",
    "organisational"
  ],
  "scopes": [
    "gnomon",
    "shared",
    "organisation"
  ],
  "probes": [
    "audit_on",
    "audit_intact",
    "audit_anchored",
    "audit_metadata_only",
    "approval_gate",
    "trust_settled",
    "commands_contained",
    "judges_read_only",
    "hooks_intact",
    "verify_declared",
    "must_fail_first",
    "secrets_protected",
    "endpoints_local"
  ],
  "report_keys": {
    "required": [
      "schema",
      "project",
      "surface_hash",
      "catalog",
      "disclaimer",
      "frameworks",
      "controls",
      "exit"
    ],
    "optional": []
  },
  "framework_keys": {
    "required": [
      "id",
      "name",
      "source",
      "counts"
    ],
    "optional": [
      "note"
    ]
  },
  "control_keys": {
    "required": [
      "framework",
      "id",
      "title",
      "scope",
      "status",
      "probes",
      "facts"
    ],
    "optional": [
      "note"
    ]
  },
  "probe_keys": {
    "required": [
      "id",
      "holds",
      "meaning"
    ],
    "optional": [
      "fix"
    ]
  },
  "error_keys": {
    "required": [
      "schema",
      "error",
      "exit"
    ],
    "optional": []
  }
}
