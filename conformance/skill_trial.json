{
  "contract": "skill trials — docs/CONTRACTS.md section 13",
  "schema": "gnomon.trial/1",
  "meets_thresholds": [true, false, "undetermined"],
  "statuses": ["complete", "budget_exhausted", "apparatus_failure"],
  "exit_codes": { "true": 0, "false": 2, "undetermined": 10, "could_not_start": 10 },
  "cell_buckets": ["result", "refusal", "apparatus_failure"],
  "order": ["interleaved"],
  "report_keys": ["schema", "skill", "content_sha256", "spec", "harness", "role", "profile", "model", "endpoint", "arms", "pairs", "cells", "endpoints", "mde", "thresholds", "budget", "trust", "leftovers", "status", "meets_thresholds", "reasons"],
  "endpoint_keys": ["pass", "output_tokens", "requests", "wall_ms"],
  "audit_kind": "skill_trial",
  "audit_keys": ["schema", "skill", "content_sha256", "report", "report_sha256", "spec", "surface_hash_base", "surface_hash_skill", "role", "model", "endpoint", "pairs", "cells", "endpoints", "status", "meets_thresholds"],
  "trail": ["session_start", "skill_trial", "session_end"],
  "session_start_mode": "trial",
  "threshold_defaults": { "max_pass_drop": 0, "min_output_token_gain": 0.1, "min_pass_gain": 1, "alpha": 0.05 },
  "attempts_default": 3,
  "spec_hashed": true,
  "spec_identity": "the surface hash (trials/ is hashed), and spec.sha256 on the report and the skill_trial record",
  "spec_bounds": { "alpha": "(0, 0.2]", "max_pass_drop": ">= 0", "min_pass_gain": ">= 0", "min_output_token_gain": "[0, 1]", "at_least_one_gain_above_zero": true },
  "trust_settled_on": "this checkout under the spec's model_profile",
  "cell_checkout": "a private clone (git clone --shared, no remote) at the commit HEAD named when the trial began",
  "budget_checked": "before every cell; only max_requests is enforced",
  "token_gain_requires": "aggregate gain >= min_output_token_gain AND skill_lower > skill_higher AND sign p < alpha",
  "exit_bucket_convention": "0 result, 2 refusal (the skill is declined), 10 apparatus_failure, as gnomon task (section 1)"
}
