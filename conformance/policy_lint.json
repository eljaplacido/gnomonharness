        "wide": {
          "tools": [
            "bash"
          ],
          "bash_allow": [
            ".*",
            "ls"
          ]
        }
      },
      "expected": [
        {
          "kind": "shadowed",
          "role": "dev",
          "rule": "bash_allow",
