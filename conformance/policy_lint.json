{
  "version": "0.1.0",
  "_comment": [
    "Policy lint (docs/CONTRACTS.md section 6): surfaces -> the findings packages/gnomon-core/src/policy_lint.ts reports.",
    "`expected` is compared as a multiset of {kind, role?, rule, pattern?}; the message is prose and not part of the contract.",
    "`kinds` is the published enumeration."
  ],
  "schema": "gnomon.policy_lint/1",
  "kinds": [
    "contradiction",
    "shadowed",
    "never_matches",
    "unreachable",
    "always_denied",
    "uncovered"
  ],
  "finding_keys": {
    "required": [
      "kind",
      "where",
      "rule",
      "message"
    ],
    "optional": [
      "role",
      "pattern"
    ]
  },
  "summary_keys": {
    "required": [
      "schema",
      "count",
      "by_kind",
      "findings"
    ],
    "optional": []
  },
  "cases": [
    {
      "name": "clean surface: nothing to say",
      "policy": {
        "sandbox": {
          "network": false
        },
        "governance": {
          "level": "prevent"
        }
      },
      "roles": {
        "dev": {
          "tools": [
            "read",
            "write",
            "bash"
          ],
          "bash_deny": [
            "\\bgit\\s+push\\b"
          ],
          "write_allow": [
            "src/**",
            "docs/*.md"
          ]
        }
      },
      "expected": []
    },
    {
      "name": "same pattern allowed and denied; allow entry refused by a deny",
      "policy": {
        "governance": {
          "level": "prevent"
        }
      },
      "roles": {
        "dev": {
          "tools": [
            "bash"
          ],
          "bash_allow": [
            "git status",
            "npm test"
          ],
          "bash_deny": [
            "git status",
            "npm test"
          ]
        },
        "ops": {
          "tools": [
            "bash"
          ],
          "bash_allow": [
            "git push origin dev"
          ],
          "bash_deny": [
            "\\bgit\\s+push\\b"
          ]
        }
      },
      "expected": [
        {
          "kind": "contradiction",
          "role": "dev",
          "rule": "bash_allow",
          "pattern": "git status"
        },
        {
          "kind": "contradiction",
          "role": "dev",
          "rule": "bash_allow",
          "pattern": "npm test"
        },
        {
          "kind": "contradiction",
          "role": "ops",
          "rule": "bash_allow",
          "pattern": "git push origin dev"
        }
      ]
    },
    {
