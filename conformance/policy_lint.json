        },
        {
          "kind": "shadowed",
          "role": "dev",
          "rule": "write_allow",
          "pattern": "src/a/b.ts"
        },
        {
          "kind": "shadowed",
          "role": "dev",
          "rule": "write_allow",
          "pattern": "src/**"
        },
        {
          "kind": "shadowed",
