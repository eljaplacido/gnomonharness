          "role": "dev",
          "rule": "bash_allow",
          "pattern": "ls$ -la"
        },
        {
          "kind": "never_matches",
          "role": "dev",
          "rule": "bash_allow",
          "pattern": "a^b"
        },
        {
          "kind": "never_matches",
          "role": "dev",
          "rule": "write_allow",
          "pattern": "src/"
        },
        {
          "kind": "never_matches",
          "role": "dev",
          "rule": "write_allow",
          "pattern": "{a,b}/*.ts"
        },
        {
          "kind": "never_matches",
          "role": "dev",
          "rule": "write_allow",
          "pattern": "docs/../src/*"
        },
        {
          "kind": "never_matches",
          "role": "dev",
          "rule": "tools",
          "pattern": "mcp__nope"
        },
        {
          "kind": "never_matches",
          "role": "dev",
          "rule": "task_allow",
          "pattern": "ghost"
        },
        {
          "kind": "always_denied",
          "role": "dev",
          "rule": "bash_allow"
        }
