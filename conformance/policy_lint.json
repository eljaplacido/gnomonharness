          "rule": "bash_allow",
          "pattern": ".*"
        },
        {
          "kind": "shadowed",
          "role": "wide",
          "rule": "bash_allow",
          "pattern": "ls"
        }
      ]
    },
    {
      "name": "patterns that can never match",
      "policy": {
        "governance": {
          "level": "prevent"
        }
      },
      "roles": {
        "dev": {
          "tools": [
            "bash",
            "write",
            "task",
