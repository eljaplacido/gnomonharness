{
  "contract": "layer-tagged failure attribution — docs/CONTRACTS.md section 60",
  "_comment": [
    "`gnomon eval` (cells[].attribution, report.attribution) and `gnomon audit attribute` name ONE primary cause for a failed turn, tagged with its ETCLOVG layer.",
    "The first matching rule in `precedence` wins; every other match is listed in `secondary`, in precedence order. An `advisory` match is a weaker signal of the same tag: it is listed as secondary and never becomes the primary cause.",
    "Every case is synthetic: a turn's own fields (stop_reason, bucket, code, tool_log, counters) and, where a trail is involved, its model_call and verify records. Nothing here is copied from a real run.",
    "A tag, a layer, a rule or a threshold added, renamed or moved is a contract change: packages/gnomon-core/src/failure_attribution.test.ts asserts this file against the code, case by case.",
    "A tag names where to look, not what a model did: `wrong_result` is the catch-all for a run that finished, changed something, ran commands, and still failed the check."
  ],
  "schema": "gnomon.attribution/1",
  "layers": ["execution", "tools", "context", "lifecycle", "observability", "verification", "governance"],
  "precedence": [
    { "tag": "record_tamper", "layer": "governance", "rule": "stop_reason tamper, or a record_tamper record" },
    { "tag": "launch_failure", "layer": "lifecycle", "rule": "stop_reason apparatus" },
    { "tag": "context_overflow", "layer": "context", "rule": "endpoint_error with code 13, or the last model_call code 13" },
    { "tag": "endpoint_error", "layer": "execution", "rule": "endpoint_error with another code, or the last model_call code 10, 11 or 12; advisory: any other failed model_call" },
    { "tag": "budget_exhausted", "layer": "lifecycle", "rule": "stop_reason deadline, step_wall or killed, or a tool call cut by the deadline" },
    { "tag": "tool_call_malformed", "layer": "tools", "rule": "stop_reason malformed; stop_reason truncated with stop_detail.repeats > 0; or 3 malformed calls (advisory below 3)" },
    { "tag": "output_truncated", "layer": "context", "rule": "stop_reason truncated without repeats" },
    { "tag": "loop_stall", "layer": "execution", "rule": "stop_reason stall; advisory: any stall signal counter above 0" },
    { "tag": "policy_refusal", "layer": "governance", "rule": "a refused write or edit outside the OS temp directory, or 2 calls refused outside the root or sandbox; advisory: any other refusal" },
    { "tag": "edit_failed", "layer": "tools", "rule": "the last write or edit failed, or 3 failed; advisory: any failed" },
    { "tag": "tool_timeout", "layer": "tools", "rule": "the last acting call timed out, or 5 timeouts; advisory: any timeout" },
    { "tag": "tool_error", "layer": "tools", "rule": "3 rejected compute/glob/grep/read calls; advisory: any" },
    { "tag": "verify_misled", "layer": "verification", "rule": "the declared [verify] check passed and the external check failed" },
    { "tag": "verify_failed", "layer": "verification", "rule": "the declared [verify] check failed at the end" },
    { "tag": "wrong_thing_verified", "layer": "verification", "rule": "a failing command, then an edit of a test or check file, then a passing command, with no other file changed in between" },
    { "tag": "context_loss", "layer": "context", "rule": "counters.model_calls.trims.overflow > 0" },
    { "tag": "no_deliverable", "layer": "execution", "rule": "finished with no write, no edit and no change to the tree" },
    { "tag": "unverified_finish", "layer": "verification", "rule": "finished and no command ran after the last write to a non-document file" },
    { "tag": "wrong_result", "layer": "execution", "rule": "finished after a change and the check still failed" },
    { "tag": "unknown", "layer": null, "rule": "nothing recorded says why" }
  ],
  "thresholds": { "path_refusals": 2, "malformed_calls": 3, "tool_timeouts": 5, "tool_errors": 3, "edit_failures": 3 },
  "failed_when": "the caller's check failed; with no check, the turn shows a failure signal (stop_reason other than answered or empty, a bucket other than result, or a verify that failed). A passed check is never a failure.",
  "cases": [
    { "name": "tamper stop", "input": { "turn": { "stop_reason": "tamper", "bucket": "refusal", "code": 3 } }, "expect": { "tag": "record_tamper", "layer": "governance" } },
    { "name": "tamper record in the trail", "input": { "turn": { "stop_reason": "answered", "bucket": "result", "code": 0 }, "records": [{ "kind": "record_tamper" }], "check": { "passed": false } }, "expect": { "tag": "record_tamper", "layer": "governance", "secondary": ["no_deliverable"] } },
    { "name": "could not start", "input": { "turn": { "stop_reason": "apparatus", "bucket": "apparatus_failure", "code": 10 } }, "expect": { "tag": "launch_failure", "layer": "lifecycle" } },
    { "name": "context could not be fitted", "input": { "turn": { "stop_reason": "endpoint_error", "bucket": "apparatus_failure", "code": 13 } }, "expect": { "tag": "context_overflow", "layer": "context" } },
    { "name": "provider erroring past the grace", "input": { "turn": { "stop_reason": "endpoint_error", "bucket": "apparatus_failure", "code": 12 } }, "expect": { "tag": "endpoint_error", "layer": "execution" } },
    { "name": "last model call timed out, run answered", "input": { "turn": { "stop_reason": "answered", "bucket": "result", "code": 0 }, "records": [{ "kind": "model_call", "code": 0 }, { "kind": "model_call", "code": 11 }], "check": { "passed": false } }, "expect": { "tag": "endpoint_error", "layer": "execution", "secondary": ["no_deliverable"] } },
    { "name": "deadline", "input": { "turn": { "stop_reason": "deadline", "bucket": "refusal", "code": 4 } }, "expect": { "tag": "budget_exhausted", "layer": "lifecycle" } },
    { "name": "step cap", "input": { "turn": { "stop_reason": "step_wall", "bucket": "refusal", "code": 3 } }, "expect": { "tag": "budget_exhausted", "layer": "lifecycle" } },
    { "name": "a tool call cut by the deadline", "input": { "turn": { "stop_reason": "answered", "bucket": "result", "code": 0, "tool_log": ["bash — timeout (deadline)"] }, "check": { "passed": false } }, "expect": { "tag": "budget_exhausted", "layer": "lifecycle", "secondary": ["tool_timeout","no_deliverable"] } },
    { "name": "tool calls cut at the output limit", "input": { "turn": { "stop_reason": "truncated", "bucket": "refusal", "code": 4, "stop_detail": { "repeats": 3 } } }, "expect": { "tag": "tool_call_malformed", "layer": "tools" } },
    { "name": "malformed stop", "input": { "turn": { "stop_reason": "malformed", "bucket": "refusal", "code": 4 } }, "expect": { "tag": "tool_call_malformed", "layer": "tools" } },
    { "name": "three malformed calls", "input": { "turn": { "stop_reason": "answered", "bucket": "result", "code": 0, "counters": { "malformed_tool_calls": 3 } }, "check": { "passed": false } }, "expect": { "tag": "tool_call_malformed", "layer": "tools", "secondary": ["no_deliverable"] } },
    { "name": "one malformed call is only a secondary", "input": { "turn": { "stop_reason": "answered", "bucket": "result", "code": 0, "tool_log": ["edit /app/a.py (+1 −1)", "bash — exit 0"], "counters": { "writes": 1, "malformed_tool_calls": 1 } }, "check": { "passed": false } }, "expect": { "tag": "wrong_result", "layer": "execution", "secondary": ["tool_call_malformed"] } },
    { "name": "reply cut at the output limit", "input": { "turn": { "stop_reason": "truncated", "bucket": "result", "code": 0 } }, "expect": { "tag": "output_truncated", "layer": "context" } },
    { "name": "stall stop", "input": { "turn": { "stop_reason": "stall", "bucket": "refusal", "code": 4 } }, "expect": { "tag": "loop_stall", "layer": "execution" } },
    { "name": "a stall signal alone is not the cause", "input": { "turn": { "stop_reason": "answered", "bucket": "result", "code": 0, "tool_log": ["edit /app/a.py (+1 −1)", "bash — exit 0"], "counters": { "writes": 1, "stall_signals": { "no_progress": { "count": 2 } } } }, "check": { "passed": false } }, "expect": { "tag": "wrong_result", "layer": "execution", "secondary": ["loop_stall"] } },
    { "name": "write to the required location refused", "input": { "turn": { "stop_reason": "answered", "bucket": "refusal", "code": 2, "tool_log": ["bash — exit 0", "write /results/out.csv — refused (outside sandbox)"] }, "check": { "passed": false } }, "expect": { "tag": "policy_refusal", "layer": "governance", "secondary": ["no_deliverable"] } },
    { "name": "two path refusals", "input": { "turn": { "stop_reason": "answered", "bucket": "refusal", "code": 2, "tool_log": ["bash /out — refused (outside the root)", "bash /out/a — refused (outside the root)"] }, "check": { "passed": false } }, "expect": { "tag": "policy_refusal", "layer": "governance", "secondary": ["no_deliverable"] } },
    { "name": "a refused write into the OS temp directory is scratch", "input": { "turn": { "stop_reason": "answered", "bucket": "refusal", "code": 2, "tool_log": ["write /app/a.py (+3 −0)", "write /tmp/check.py — refused (outside sandbox)", "bash — exit 0"], "counters": { "writes": 1 } }, "check": { "passed": false } }, "expect": { "tag": "wrong_result", "layer": "execution", "secondary": ["policy_refusal"] } },
    { "name": "one incidental refusal (secret path, network) is not the cause", "input": { "turn": { "stop_reason": "answered", "bucket": "refusal", "code": 2, "tool_log": ["bash env — refused (secret path)", "edit /app/a.py (+1 −1)", "bash — exit 0"], "counters": { "writes": 1 } }, "check": { "passed": false } }, "expect": { "tag": "wrong_result", "layer": "execution", "secondary": ["policy_refusal"] } },
    { "name": "the last edit did not match", "input": { "turn": { "stop_reason": "answered", "bucket": "result", "code": 0, "tool_log": ["edit /app/a.py (+1 −1)", "edit /app/a.py — no match"], "counters": { "writes": 1 } }, "check": { "passed": false } }, "expect": { "tag": "edit_failed", "layer": "tools", "secondary": ["unverified_finish"] } },
    { "name": "the last call timed out", "input": { "turn": { "stop_reason": "answered", "bucket": "result", "code": 0, "tool_log": ["edit /app/a.py (+1 −1)", "bash — timeout"], "counters": { "writes": 1 } }, "check": { "passed": false } }, "expect": { "tag": "tool_timeout", "layer": "tools", "secondary": ["unverified_finish"] } },
    { "name": "three rejected compute calls", "input": { "turn": { "stop_reason": "answered", "bucket": "result", "code": 0, "tool_log": ["compute — unknown name \"exp\" — available: abs", "compute — unknown name \"cos\" — available: abs", "compute — unexpected \"*\"", "bash — exit 0"], "counters": { "writes": 0, "worktree_moves": 1 } }, "check": { "passed": false } }, "expect": { "tag": "tool_error", "layer": "tools" } },
    { "name": "the declared check passed, the external one failed", "input": { "turn": { "stop_reason": "answered", "bucket": "result", "code": 0, "verify": "passed", "tool_log": ["edit /app/a.py (+1 −1)", "verify — bash — exit 0"], "counters": { "writes": 1 } }, "check": { "passed": false } }, "expect": { "tag": "verify_misled", "layer": "verification" } },
    { "name": "the declared check failed at the end (trail record)", "input": { "turn": { "stop_reason": "answered", "bucket": "result", "code": 0, "tool_log": ["edit /app/a.py (+1 −1)"], "counters": { "writes": 1 } }, "records": [{ "kind": "verify", "ok": false, "exit": 1 }] }, "expect": { "tag": "verify_failed", "layer": "verification", "secondary": ["unverified_finish"] } },
    { "name": "a check edited until it passed", "input": { "turn": { "stop_reason": "answered", "bucket": "result", "code": 0, "tool_log": ["write /app/a.py (+9 −0)", "bash — exit 1", "edit tests/test_a.py (+1 −1)", "bash — exit 0"], "counters": { "writes": 2 } }, "check": { "passed": false } }, "expect": { "tag": "wrong_thing_verified", "layer": "verification" } },
    { "name": "source edited between: not the test-edit pattern", "input": { "turn": { "stop_reason": "answered", "bucket": "result", "code": 0, "tool_log": ["bash — exit 1", "edit tests/test_a.py (+1 −1)", "edit /app/a.py (+1 −1)", "bash — exit 0"], "counters": { "writes": 2 } }, "check": { "passed": false } }, "expect": { "tag": "wrong_result", "layer": "execution" } },
    { "name": "the context was halved to fit", "input": { "turn": { "stop_reason": "answered", "bucket": "result", "code": 0, "tool_log": ["edit /app/a.py (+1 −1)", "bash — exit 0"], "counters": { "writes": 1, "model_calls": { "trims": { "leg": 0, "overflow": 2, "dropped": 24 } } } }, "check": { "passed": false } }, "expect": { "tag": "context_loss", "layer": "context" } },
    { "name": "answered with nothing changed", "input": { "turn": { "stop_reason": "answered", "bucket": "result", "code": 0, "tool_log": ["bash — exit 0", "read /app/a.py — 3 lines"], "counters": { "writes": 0, "worktree_moves": 0 } }, "check": { "passed": false } }, "expect": { "tag": "no_deliverable", "layer": "execution" } },
    { "name": "nothing ran after the last write", "input": { "turn": { "stop_reason": "answered", "bucket": "result", "code": 0, "tool_log": ["bash — exit 0", "edit /app/a.py (+1 −1)"], "counters": { "writes": 1 } }, "check": { "passed": false } }, "expect": { "tag": "unverified_finish", "layer": "verification" } },
    { "name": "a note written after the last check is not an unverified change", "input": { "turn": { "stop_reason": "answered", "bucket": "result", "code": 0, "tool_log": ["edit /app/a.py (+1 −1)", "bash — exit 0", "write /app/NOTES.md (+9 −0)"], "counters": { "writes": 2 } }, "check": { "passed": false } }, "expect": { "tag": "wrong_result", "layer": "execution" } },
    { "name": "changed, ran commands, still failed", "input": { "turn": { "stop_reason": "answered", "bucket": "result", "code": 0, "tool_log": ["edit /app/a.py (+1 −1)", "bash — exit 0"], "counters": { "writes": 1 } }, "check": { "passed": false } }, "expect": { "tag": "wrong_result", "layer": "execution" } },
    { "name": "precedence: a deadline outranks timeouts and a refused write", "input": { "turn": { "stop_reason": "deadline", "bucket": "refusal", "code": 4, "tool_log": ["write /results/a — refused (outside sandbox)", "bash — timeout", "bash — timeout", "bash — timeout", "bash — timeout", "bash — timeout"] }, "check": { "passed": false } }, "expect": { "tag": "budget_exhausted", "layer": "lifecycle", "secondary": ["policy_refusal", "tool_timeout"] } },
    { "name": "no record at all", "input": { "turn": {}, "check": { "passed": false } }, "expect": { "tag": "unknown", "layer": null } },
    { "name": "a passed check is not a failure", "input": { "turn": { "stop_reason": "deadline", "bucket": "refusal", "code": 4 }, "check": { "passed": true } }, "expect": null },
    { "name": "no check and no failure signal", "input": { "turn": { "stop_reason": "answered", "bucket": "result", "code": 0, "tool_log": ["edit /app/a.py (+1 −1)", "bash — exit 0"], "counters": { "writes": 1 } } }, "expect": null }
  ]
}
