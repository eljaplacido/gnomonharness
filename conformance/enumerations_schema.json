{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["edit_format", "sandbox", "approval", "role_profile", "governance_level", "governance_family"],
  "additionalProperties": false,
  "properties": {
    "edit_format": {
      "type": "array",
      "items": { "enum": ["ast", "hashline", "str_replace"] },
      "minItems": 3,
      "maxItems": 3
    },
    "sandbox": {
      "type": "array",
      "items": { "enum": ["off", "confined", "strict"] },
      "minItems": 3,
      "maxItems": 3
    },
    "approval": {
      "type": "array",
      "items": { "enum": ["never", "on_write", "always"] },
      "minItems": 3,
      "maxItems": 3
    },
    "role_profile": {
      "type": "array",
      "items": { "enum": ["local_first", "frontier_plan", "all_remote"] },
      "minItems": 3,
      "maxItems": 3
    },
    "governance_level": {
      "type": "array",
      "items": { "enum": ["observe", "advise", "prevent", "enforce"] },
      "minItems": 4,
      "maxItems": 4
    },
    "governance_family": {
      "type": "array",
      "items": { "enum": ["write", "bash", "network", "secrets", "rules", "ci"] },
      "minItems": 6,
      "maxItems": 6
    }
  }
}
