{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["edit_format", "sandbox", "approval", "role_profile"],
  "additionalProperties": false,
  "properties": {
    "edit_format": {
      "type": "array",
      "items": { "enum": ["ast", "hashline", "str_replace"] },
      "minItems": 3,
      "maxItems": 3
    },
    "sandbox": {
      "type": "array",
      "items": { "enum": ["off", "confined", "strict"] },
      "minItems": 3,
      "maxItems": 3
    },
    "approval": {
      "type": "array",
      "items": { "enum": ["never", "on_write", "always"] },
      "minItems": 3,
      "maxItems": 3
    },
    "role_profile": {
      "type": "array",
      "items": { "enum": ["local_first", "frontier_plan", "all_remote"] },
      "minItems": 3,
      "maxItems": 3
    }
  }
}
