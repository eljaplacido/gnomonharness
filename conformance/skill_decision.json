{
  "contract": "skill decisions — docs/CONTRACTS.md section 11",
  "version": 1,
  "audit_kinds": ["skill_accept", "skill_reject"],
  "trail": ["session_start", "<kind>", "session_end"],
  "session_start_mode": "skill",
  "written_when_audit_disabled": true,
  "audit_keys": {
    "skill_accept": ["skill", "name", "path", "content_sha256", "surface_hash_before", "surface_hash_after", "evidence", "by", "user", "host", "interactive"],
    "skill_reject": ["skill", "name", "path", "content_sha256", "surface_hash_before", "surface_hash_after", "reason", "by", "user", "host", "interactive"]
  },
  "optional_keys": ["reason"],
  "order": "write-ahead: session_start and the decision are written before the file moves; session_end after",
  "session_end_keys": { "applied": ["applied", "surface_hash_after"], "not_applied": ["applied", "error"] },
  "session_end_keys_reject": { "applied": ["applied"], "not_applied": ["applied", "error"] },
  "id_rule": "skillId(id) === id: lower-case letters, digits and dashes, at most 60",
  "evidence_without_report": "none",
  "by_from_cli": "human"
}
