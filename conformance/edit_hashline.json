{
  "version": "1",
  "_comment": [
    "The hashline edit format (edit_format = \"hashline\"; docs/CONTRACTS.md section 3, docs/GUIDE.md).",
    "hash = FNV-1a 32 over the UTF-8 bytes of the line text (no trailing CR), xor-folded to 8 bits ((h ^ h>>8 ^ h>>16 ^ h>>24) & 0xff), two lowercase hex digits. A tag is LINE:HASH, LINE 1-based.",
    "Lines split on LF; a trailing CR is a line ending, not text; the empty piece after a final LF is not a line.",
    "Every anchor in a call is checked against the file as it is; one stale anchor refuses the whole call and writes nothing.",
    "packages/gnomon-core/src/edit_hashline.test.ts runs every vector through the implementation. Idea: Can Boluk, The Harness Problem, 2026-02-12."
  ],
  "ops": [
    "replace",
    "delete",
    "insert_before",
    "insert_after"
  ],
  "hash_vectors": [
    {
      "text": "",
      "hash": "c5"
    },
    {
      "text": "}",
      "hash": "14"
    },
    {
      "text": "function hello() {",
      "hash": "77"
    },
    {
      "text": "  return \"world\";",
      "hash": "03"
    },
    {
      "text": "    ",
      "hash": "7a"
    },
    {
      "text": "café ☕",
      "hash": "a9"
    },
    {
      "text": "a\tb",
      "hash": "76"
    }
  ],
  "edit_vectors": [
    {
      "name": "replace one line",
      "before": "alpha\nbeta\ngamma\n",
      "edits": [
        {
          "op": "replace",
          "anchor": "2:0d",
          "text": "BETA"
        }
      ],
      "after": "alpha\nBETA\ngamma\n"
    },
    {
      "name": "replace a range with fewer lines",
      "before": "alpha\nbeta\ngamma\n",
      "edits": [
        {
          "op": "replace",
          "anchor": "1:10",
          "end": "2:0d",
          "text": "ab"
        }
      ],
      "after": "ab\ngamma\n"
    },
    {
      "name": "delete a range",
      "before": "alpha\nbeta\ngamma\n",
      "edits": [
        {
          "op": "delete",
          "anchor": "2:0d",
          "end": "3:e7"
        }
      ],
      "after": "alpha\n"
    },
    {
      "name": "insert before the first and after the last",
      "before": "alpha\nbeta\ngamma\n",
      "edits": [
        {
          "op": "insert_before",
          "anchor": "1:10",
          "text": "top"
        },
        {
          "op": "insert_after",
          "anchor": "3:e7",
          "text": "x\ny\n"
        }
      ],
      "after": "top\nalpha\nbeta\ngamma\nx\ny\n"
    },
    {
      "name": "several edits in one call, in any order",
      "before": "alpha\nbeta\ngamma\n",
      "edits": [
        {
          "op": "replace",
          "anchor": "3:e7",
          "text": "G"
        },
        {
          "op": "delete",
          "anchor": "1:10"
        }
      ],
      "after": "beta\nG\n"
    },
    {
      "name": "an insert and a replace at one point",
      "before": "alpha\nbeta\ngamma\n",
      "edits": [
        {
          "op": "replace",
          "anchor": "2:0d",
          "text": "B"
        },
        {
          "op": "insert_after",
          "anchor": "1:10",
          "text": "new"
        }
      ],
      "after": "alpha\nnew\nB\ngamma\n"
    },
    {
      "name": "CRLF is kept, new lines get CRLF",
      "before": "alpha\r\nbeta\r\ngamma\r\n",
      "edits": [
        {
          "op": "replace",
          "anchor": "2:0d",
          "text": "b1\nb2"
        }
      ],
      "after": "alpha\r\nb1\r\nb2\r\ngamma\r\n"
    },
    {
      "name": "no final newline stays absent",
      "before": "alpha\nbeta",
      "edits": [
        {
          "op": "replace",
          "anchor": "2:0d",
          "text": "B"
        }
      ],
      "after": "alpha\nB"
    },
    {
      "name": "duplicate lines are told apart by number",
