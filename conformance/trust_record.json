{
  "contract": "workspace trust — docs/CONTRACTS.md section 8",
  "version": 1,
  "audit_kind": "trust",
  "audit_keys": ["decision", "by", "surface_hash", "grants", "root"],
  "task_record_field": "trust",
  "task_record_keys": ["decision", "by", "surface_hash", "grants"],
  "optional_keys": {
    "tools_changed": "clamped only: [{server, pinned, now}] for MCP tools changed since pinned",
    "floor_held": "trusted only: sorted grant keys (exec:<role>:off, exec:<role>:image) the declared surface asked for and this machine's exec floor held back"
  },
  "decisions": ["trusted", "granted", "clamped", "revoked"],
  "by": [
    "store",
    "store:covered",
    "flag:--trust",
    "env:GNOMON_TRUST",
    "human",
    "human:declined",
    "default:no-operator",
    "command:trust"
  ],
  "store": {
    "file": "trust.json",
    "dir": "$XDG_DATA_HOME/gnomon, else %APPDATA%\\gnomon on Windows, else ~/.local/share/gnomon",
    "v": 1,
    "entry_keys": ["root", "surface_hash", "grants", "at", "by"]
  },
  "quit_exit_code": 3
}
