{
  "contract": "workspace trust — docs/CONTRACTS.md section 8",
  "version": 1,
  "audit_kind": "trust",
  "audit_keys": ["decision", "by", "surface_hash", "grants", "root"],
  "task_record_field": "trust",
  "task_record_keys": ["decision", "by", "surface_hash", "grants"],
  "decisions": ["trusted", "granted", "clamped", "revoked"],
  "by": [
    "store",
    "store:covered",
    "flag:--trust",
    "env:GNOMON_TRUST",
    "human",
    "human:declined",
    "default:no-operator",
    "command:trust"
  ],
  "store": {
    "file": "trust.json",
    "dir": "$XDG_DATA_HOME/gnomon, else %APPDATA%\\gnomon on Windows, else ~/.local/share/gnomon",
    "v": 1,
    "entry_keys": ["root", "surface_hash", "grants", "at", "by"]
  },
  "quit_exit_code": 3
}
